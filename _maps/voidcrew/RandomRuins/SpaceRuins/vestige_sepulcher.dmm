"RE" = (
/obj/structure/table/wood/fancy/black,
/obj/item/paper{
	name = "unsigned vow";
	default_raw_text = "We were promised an ending. We built it a house and rowed the house into the dark. We fed it what we had, and when that ran out we fed it what we were. It has not come. Sister Havel says it drinks slowly because it savors us. Keep the wicks trimmed. Keep the vigil. It is enough. It is enough.";
	pixel_y = 5
	},
