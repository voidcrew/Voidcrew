"aV" = (
/obj/structure/table/wood/fancy/black,
/obj/item/paper{
	name = "match record";
	default_raw_text = "Bouts on the lower floor are scored by the machine and countersigned by the master. Three clean strikes ends it. The machine does not concede and has never been asked to. Last countersigned entry: two hundred and six wins, no losses. Under that, in a different hand: 207, 208, 209. The column runs off the bottom of the page and carries on up the wall.";
	pixel_y = 4
