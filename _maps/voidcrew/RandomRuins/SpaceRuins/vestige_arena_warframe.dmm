"FT" = (
/obj/structure/table/wood/fancy/black,
/obj/item/paper{
	name = "lower floor rules";
	default_raw_text = "LOWER HALL - ARENA ENTRY\n\n1. Leave this waiting room through the door on the EAST (right). Cross the equipment room and leave through its east door.\n2. Follow the corridor NORTH (up), then take the east door into the generator room with the power storage units.\n3. Find the HALL GATE LEVER on the generator room's EAST wall. Click it with an empty hand. It opens both arena gates immediately.\n4. Head NORTH through the gate at the back of the generator room. The Warframe waits on the mats. The other gate is at the north end of the equipment room.\n\nThe gates do not open by themselves. You must defeat the Warframe to leave; dying here costs your body and everything you carry. Bring your own weapons and medical supplies.\n\nDuring the fight, the separate HALL BREAKER on the arena's WEST wall briefly staggers the Warframe and shuts off its Live Floor attack for 25 seconds. It resets after one minute.";
	pixel_y = 3
	},
/obj/item/flashlight/flare/candle/infinite{
	pixel_x = -6;
	pixel_y = -2
	},
/turf/open/floor/wood,
/area/ruin/space/has_grav/vestige/arena/warframe)
