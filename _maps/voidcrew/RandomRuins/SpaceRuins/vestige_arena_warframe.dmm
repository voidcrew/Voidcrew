"jv" = (
/obj/structure/table/wood/fancy/black,
/obj/item/paper{
	name = "floor circuit log";
	default_raw_text = "Floor circuit log. The mat plates draw more every year and nobody can find where it is going. The hall gate lever on the EAST wall of this generator room opens both arena gates. Click it with an empty hand, then head NORTH through the gate at the back of this room. The separate hall breaker on the WEST wall inside the arena briefly staggers the Warframe and disables its Live Floor attack for 25 seconds. The breaker resets after one minute.";
	pixel_y = 3
	},
/obj/item/pen{
