/obj/structure/bed,
/obj/item/bedsheet/black,
/obj/item/paper{
	name = "unsent letter";
	default_raw_text = "Mother. The master says a letter begun in anger must be finished in patience, so this one has taken two years. I am eating well. I am sleeping on time. I have stopped counting my footsteps, because I no longer make any sound worth counting. When the clan moves on I will be permitted to write where. The clan is moving on soon. I do not think where is the right question anymore.";
	pixel_y = 6
	},
