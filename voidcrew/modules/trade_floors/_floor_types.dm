/**
 * # Outpost floors: the shared types
 *
 * Owner: P0, frozen. Packages do not edit this file; they fill the stubs in their own.
 *
 * A crew leases a floor above a trader outpost and reaches it by the outpost's lift. A floor is two things:
 * a /datum/outpost_floor on the trader outpost (the lift, the lock, what the police ask) and a host object,
 * /obj/structure/overmap/dynamic/player_outpost/floor, that is never on the overmap and carries everything a player
 * outpost has (treasury, rooms, consoles, residents, services). The floor's ground is one turf reservation.
 *
 * Why this module is voidcrew/modules/trade_floors and not outpost_floors: this directory sorts after overmap,
 * player_outposts, stealth_police and trade, so nothing here is ever written before the proc it overrides. A
 * redefinition on the same type placed before the proc's declaration is dead code (the compiler only warns
 * override_before_def). A subtype's override is not: the seam tests measured that. Being last costs nothing and
 * leaves no case to think about.
 *
 * Two lookups, and never a z-level test:
 * - get_trader_outpost_for_turf() is the law: it finds a floor only while the floor is public ground or under warrant.
 * - get_outpost_floor_for_turf() is the floor, always.
 * is_trader_outpost_protected() (blasts, the singularity, bag rifts) never answers for a floor.
 */

/// A floor of a trader outpost
/datum/outpost_floor
	/// 1 to the outpost's floor_count; its place in outpost.floors
	var/number = 0
	/// The trader outpost this floor is part of
	var/obj/structure/overmap/trader_outpost/outpost
	/// OUTPOST_FLOOR_STATE_*
	var/state = OUTPOST_FLOOR_STATE_TENANT
	/// The ground, from the floor's first sale to the end of the round. Never released and reserved again.
	var/datum/turf_reservation/reservation
	/// list(min_x, min_y, max_x, max_y, z) of the whole floor, hull included. Null with no ground. Set by take_ground() only.
	var/list/bounds
	/// The same for the landing: the lift alcove and the foyer. Outpost ground, never built on.
	var/list/landing_bounds
	/// The lift alcove's turfs, in block() order
	var/list/turf/alcove_turfs = list()
	/// Where ordered crates arrive: the goods lift's tiles. Outpost ground, never built on.
	var/list/turf/goods_turfs = list()
	/// The floor's lift panel
	var/obj/machinery/outpost_elevator/panel
	/// The player outpost object holding the treasury, rooms, residents and services. Never on the overmap.
	var/obj/structure/overmap/dynamic/player_outpost/floor/host
	/// The NPC business let this floor while nobody has bought it (the board shows it; the lift never does)
	var/tenant_name
	/// The floor's own name, 24 characters at most, cleaned where it is typed
	var/floor_name
	/// The crew's line on the directory board, 60 characters at most, cleaned where it is typed
	var/board_line = ""
	/// An OUTPOST_FLOOR_ACCENT_* id
	var/accent = OUTPOST_FLOOR_ACCENT_AMBER
	/// OUTPOST_FLOOR_ENTRY_*: who the lift takes up
	var/entry_policy = OUTPOST_FLOOR_ENTRY_CREW
	/// The guest list: minds and ships (/obj/structure/overmap/ship), OUTPOST_FLOOR_LIST_MAX at most
	var/list/guests = list()
	/// Minds and ships the lift never takes up
	var/list/barred = list()
	/// Hired hands: minds, OUTPOST_FLOOR_HANDS_MAX at most. Not the floor's people.
	var/list/datum/mind/hands = list()
	/// A 3+ star suspect is here and the squad is in. Written by the police only (police_floors.dm).
	var/warrant_in_force = FALSE
	/// The outpost's law covers this floor: it is Open, or was and has not emptied yet. Written by the police only.
	var/public_ground = FALSE

/// Whether `checked` is on this floor: its rectangle, hull and landing included
/datum/outpost_floor/proc/contains_turf(turf/checked)
	if(!checked || length(bounds) < 5 || checked.z != bounds[5])
		return FALSE
	return checked.x >= bounds[1] && checked.y >= bounds[2] && checked.x <= bounds[3] && checked.y <= bounds[4]

/// Whether `checked` is in this floor's landing
/datum/outpost_floor/proc/in_landing(turf/checked)
	if(!checked || length(landing_bounds) < 5 || checked.z != landing_bounds[5])
		return FALSE
	return checked.x >= landing_bounds[1] && checked.y >= landing_bounds[2] && checked.x <= landing_bounds[3] && checked.y <= landing_bounds[4]

/// Whether a crew may build on `checked`: the deck, less the hull ring, the landing and the goods lift
/datum/outpost_floor/proc/is_buildable(turf/checked)
	if(!contains_turf(checked))
		return FALSE
	if(checked.x == bounds[1] || checked.y == bounds[2] || checked.x == bounds[3] || checked.y == bounds[4])
		return FALSE
	return !in_landing(checked) && !(checked in goods_turfs)

/// This floor's id on the lift
/datum/outpost_floor/proc/lift_id()
	return OUTPOST_FLOOR_ID_BASE + number

/// Every floor that has ground. take_ground() adds a floor and its Destroy() takes it off; nothing else writes this.
/// While it is empty, which is every round until a floor is sold, each lookup below is one list read.
GLOBAL_LIST_EMPTY(outpost_floors_on_ground)

/**
 * Gives the floor its ground: `ground`'s block is the whole floor, hull included. The only way `bounds` is set,
 * because it is also what puts the floor where get_outpost_floor_for_turf() looks.
 */
/datum/outpost_floor/proc/take_ground(datum/turf_reservation/ground)
	if(!ground || !length(ground.bottom_left_turfs) || !length(ground.top_right_turfs))
		return FALSE
	var/turf/bottom_left = ground.bottom_left_turfs[1]
	var/turf/top_right = ground.top_right_turfs[1]
	reservation = ground
	bounds = list(bottom_left.x, bottom_left.y, top_right.x, top_right.y, bottom_left.z)
	GLOB.outpost_floors_on_ground |= src
	return TRUE

/// The floor `checked` is on, whatever its setting, or null
/proc/get_outpost_floor_for_turf(turf/checked)
	if(!checked || !length(GLOB.outpost_floors_on_ground))
		return null
	for(var/datum/outpost_floor/floor in GLOB.outpost_floors_on_ground)
		if(floor.contains_turf(checked))
			return floor
	return null

/**
 * Whether a blast whose epicentre is on `blast_floor` (null: on no floor) must leave `blasted` alone. A blast never
 * crosses the edge of a leased floor, in either direction (abuse A3). Reservations are ringed by cordon, which
 * stops a blast only while the REACTIONARY_EXPLOSIONS config flag is on; this holds either way.
 * Called for every turf of every explosion (code/controllers/subsystem/explosions.dm): keep it this cheap.
 */
/proc/outpost_floor_blast_excludes(datum/outpost_floor/blast_floor, turf/blasted)
	if(blast_floor)
		return !blast_floor.contains_turf(blasted)
	return length(GLOB.outpost_floors_on_ground) && !isnull(get_outpost_floor_for_turf(blasted))

/// Which of this outpost's floors `checked` is on, or null
/obj/structure/overmap/trader_outpost/proc/floor_at(turf/checked)
	for(var/datum/outpost_floor/floor in floors)
		if(floor.contains_turf(checked))
			return floor
	return null

/// The floor with this lift id, or null
/obj/structure/overmap/trader_outpost/proc/floor_by_id(floor_id)
	var/slot = floor_id - OUTPOST_FLOOR_ID_BASE
	if(!isnum(slot) || slot < 1 || slot > length(floors))
		return null
	return floors[slot]

/// Whether `checked` is anywhere in the building: the outpost's own ground, or any of its floors whatever their setting.
/// Riding up is never leaving the outpost (the warrant's away clock asks this).
/obj/structure/overmap/trader_outpost/proc/holds_turf(turf/checked)
	if(!checked)
		return FALSE
	return get_trader_outpost_for_turf(checked) == src || !!floor_at(checked)

/**
 * The client mobs that count as present with `where`. On a floor that is whoever is on that floor: its level is
 * shared with the concourse, the berths and every other floor, so a z-level test would count a shopper downstairs as
 * home and wake every prison wing on the level (abuse A1). Anywhere else it is the level's clients, as before.
 * Read only: off a floor this is SSmobs' own list.
 */
/proc/outpost_site_clients(turf/where)
	where = get_turf(where)
	if(!where || !islist(SSmobs.clients_by_zlevel) || where.z > length(SSmobs.clients_by_zlevel))
		return list()
	var/list/on_level = SSmobs.clients_by_zlevel[where.z]
	var/datum/outpost_floor/floor = get_outpost_floor_for_turf(where)
	if(!floor)
		return on_level
	var/list/here = list()
	for(var/mob/person in on_level)
		if(floor.contains_turf(get_turf(person)))
			here += person
	return here

// ===== THE HOST =====

/// A floor's player outpost object. Made in nullspace and never moved onto the overmap: it has no mapzone, no
/// footprint and no overmap coordinates, and everything that asks "is this turf mine" is answered by its floor.
/obj/structure/overmap/dynamic/player_outpost/floor
	/// The floor this host serves
	var/datum/outpost_floor/floor

/// The deck, less the landing and the goods lift (A5). The construction console, room placement and door access ask this.
/obj/structure/overmap/dynamic/player_outpost/floor/is_turf_buildable(turf/target)
	return !!floor?.is_buildable(target)

/// The whole floor, landing and hull included: this is what makes every service on a floor find its floor (A60)
/obj/structure/overmap/dynamic/player_outpost/floor/contains_service_turf(turf/location)
	return !!floor?.contains_turf(location)
