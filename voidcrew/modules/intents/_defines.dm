// Intent system defines
// Classic SS13 intents as an alternative to combat mode toggle

#define INTENT_HELP    "help"
#define INTENT_DISARM  "disarm"
#define INTENT_GRAB    "grab"
#define INTENT_HARM    "harm"

// Default intent order for cycling
#define INTENT_CYCLE_ORDER list(INTENT_HELP, INTENT_DISARM, INTENT_GRAB, INTENT_HARM)

// Keybind signals
#define COMSIG_KB_LIVING_INTENT_HELP "keybinding_living_intent_help"
#define COMSIG_KB_LIVING_INTENT_DISARM "keybinding_living_intent_disarm"
#define COMSIG_KB_LIVING_INTENT_GRAB "keybinding_living_intent_grab"
#define COMSIG_KB_LIVING_INTENT_HARM "keybinding_living_intent_harm"
