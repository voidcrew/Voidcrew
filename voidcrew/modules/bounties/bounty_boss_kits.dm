/// The knife it holds, if it has one in hand
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/proc/boss_knife()
	for(var/obj/item/knife/blade in held_items)
		return blade
	return null

/**
 * Stabs `victim` with the knife it holds, as a player would: the knife in its active hand, a body
 * zone picked, and a click through controller.ai_interact(). Damage, armour, wounds and bleeding are
 * the knife's and tg's (CB-9). Returns TRUE if it swung.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/proc/boss_knife_attack(atom/victim)
	var/obj/item/knife/blade = boss_knife()
	if(isnull(blade) || isnull(ai_controller) || next_move > world.time || !human_npc_ready_item(src, blade))
		return FALSE
	victim.visible_message(span_danger("[src] darts in and slashes [victim]!"), span_userdanger("[src] darts in and slashes you!"))
	playsound(victim, 'sound/items/weapons/bladeslice.ogg', 70, TRUE)
	zone_selected = human_npc_pick_aim_zone()
	return ai_controller.ai_interact(target = victim, combat_mode = TRUE)

// Every knife blow it lands counts toward its hit and run: after a couple, it breaks off for a while.
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss_landed_blow(mob/living/victim, obj/item/weapon)
	if(!istype(weapon, /obj/item/knife))
		return
	boss_cuts++
	if(boss_cuts >= BOUNTY_GHOST_CUTS_BEFORE_BREAKOFF)
		boss_cuts = 0
		boss_breakoff_until = world.time + BOUNTY_GHOST_BREAKOFF_TIME

/// Breaking off: it backs away from its target for a while
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss_engage_plan(datum/ai_controller/controller, atom/target)
	if(world.time >= boss_breakoff_until || !(isliving(target) || ismecha(target)) || get_dist(src, target) > 4)
		return FALSE
	controller.queue_behavior(/datum/ai_behavior/bounty_boss_back_off, BB_BASIC_MOB_CURRENT_TARGET)
	return TRUE

/// Fires its Cascade lattice (the chrome's own action), if it is ready. Returns TRUE if it fired.
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/proc/boss_surge()
	for(var/obj/item/organ/cyberimp/cyberware/cascade/lattice in organs)
		for(var/datum/action/cooldown/cyberware/cascade_surge/surge in lattice.actions)
			if(surge.IsAvailable())
				return surge.Trigger()
	return FALSE

/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss_took_damage(damage, damagetype)
	if(boss_cloaked)
		boss_uncloak("A hit breaks the shimmer around [src].")

/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss_flashed(mob/living/user)
	if(boss_cloaked)
		boss_uncloak("The flash burns away the shimmer around [src]!")

/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss_on_interrupted()
	if(boss_cloaked)
		boss_uncloak()

/// Fades to a faint shimmer for BOUNTY_GHOST_CLOAK_TIME: a look only, nothing misses it for it (CB-12)
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/proc/boss_cloak()
	if(stat != CONSCIOUS)
		return FALSE
	boss_cloaked = TRUE
	animate(src, alpha = BOUNTY_GHOST_CLOAK_ALPHA, time = 0.3 SECONDS)
	add_filter("bounty_ghost_shimmer", 2, list("type" = "blur", "size" = 1))
	deltimer(boss_cloak_timer)
	boss_cloak_timer = addtimer(CALLBACK(src, PROC_REF(boss_uncloak), "The shimmer around [src] fades."), BOUNTY_GHOST_CLOAK_TIME, TIMER_STOPPABLE | TIMER_DELETE_ME)
	return TRUE

/// Plain to see again, with `message` if something broke the shimmer
/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/proc/boss_uncloak(message)
	if(!boss_cloaked)
		return FALSE
	boss_cloaked = FALSE
	deltimer(boss_cloak_timer)
	boss_cloak_timer = null
	animate(src, alpha = 255, time = 0.3 SECONDS)
	remove_filter("bounty_ghost_shimmer")
	if(message)
		visible_message(span_warning(message))
	return TRUE

/**
 * Dash: it crouches and a blurred line shows on the floor to its target, then it darts down it with
 * its Cascade lattice firing, leaving after-images, and stabs at the end with the knife it holds.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/dash
	name = "Dash"
	desc = "Dart in along a line and cut whoever is at the end of it."
	cooldown_time = BOUNTY_GHOST_DASH_COOLDOWN
	windup = BOUNTY_GHOST_DASH_WINDUP
	effect_time = BOUNTY_GHOST_DASH_RANGE
	/// The tiles it will dart over, from the telegraph
	var/list/path
	var/step_index = 0
	/// Who it is dashing at
	var/datum/weakref/dash_target

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/Destroy()
	path = null
	dash_target = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/worth_using(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss = owner
	if(!aimable(target) || !istype(boss) || isnull(boss.boss_knife()))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_GHOST_DASH_RANGE + 1 && bounty_boss_clear_line(get_turf(owner), get_turf(target))

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/telegraph(atom/target)
	path = list()
	var/turf/origin = get_turf(owner)
	var/turf/aim = get_turf(target)
	if(origin && aim)
		for(var/turf/spot as anything in get_line(origin, aim))
			if(spot == origin || spot == aim)
				continue
			path += spot
			if(length(path) >= BOUNTY_GHOST_DASH_RANGE)
				break
	owner.visible_message(span_boldwarning("[owner] crouches low, knife held out."))
	playsound(owner, 'sound/effects/podwoosh.ogg', 40, TRUE)
	mark_turfs(path, "#9a9ab8")

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/effect(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss = owner
	if(!istype(boss))
		return
	dash_target = aimable(target) ? WEAKREF(target) : null
	step_index = 0
	// The lattice fires as it goes (the OC-6 ruling): real chrome, with its own crash after.
	boss.boss_surge()
	if(!length(path))
		cut_at_end(target)
		return
	var/serial = boss.boss_set_busy("dash", effect_time + 1 SECONDS, immobile = FALSE)
	boss.set_glide_size(DELAY_TO_GLIDE_SIZE(1))
	dash_step(serial)

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/dash_step(serial)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !boss.boss_still("dash", serial))
		end_dash(serial, FALSE)
		return
	step_index++
	if(step_index > length(path))
		end_dash(serial, TRUE)
		return
	var/turf/next = path[step_index]
	if(!boss.leash_ok(next) || isgroundlessturf(next) || islava(next) || ischasm(next))
		end_dash(serial, TRUE)
		return
	var/turf/was = get_turf(boss)
	if(!boss.Move(next, get_dir(boss, next)))
		end_dash(serial, TRUE)
		return
	new /obj/effect/temp_visual/decoy/fading/halfsecond(was, boss)
	addtimer(CALLBACK(src, PROC_REF(dash_step), serial), 1, TIMER_DELETE_ME)

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/end_dash(serial, cut)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	path = null
	var/atom/victim = dash_target?.resolve()
	dash_target = null
	if(istype(boss) && boss.boss_busy == "dash" && boss.boss_busy_serial == serial)
		boss.boss_clear_busy(serial)
	if(cut)
		cut_at_end(victim)

/**
 * The cut at the end of the dash: a real knife attack on whoever it dashed at, if they are within
 * reach, standing or not (CB-11). Returns TRUE if it swung.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/cut_at_end(atom/victim)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss = owner
	if(!istype(boss) || !boss.boss_can_act() || !aimable(victim) || !boss.Adjacent(victim) || !boss.boss_effect_hits(victim))
		return FALSE
	return boss.boss_knife_attack(victim)

/// Cloak: the air around it shimmers, then it fades to a faint distortion. A look only (CB-12).
/datum/action/cooldown/mob_cooldown/bounty_boss/cloak
	name = "Cloak"
	desc = "Fade into a shimmer."
	cooldown_time = BOUNTY_GHOST_CLOAK_COOLDOWN
	windup = BOUNTY_GHOST_CLOAK_WINDUP

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/worth_using(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss = owner
	return aimable(target) && istype(boss) && !boss.boss_cloaked

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/telegraph(atom/target)
	owner.visible_message(span_boldwarning("The air around [owner] starts to shimmer."))
	playsound(owner, 'sound/effects/magic/smoke.ogg', 40, TRUE)
	animate(owner, alpha = 150, time = windup / 2, flags = ANIMATION_PARALLEL)
	animate(alpha = 255, time = windup / 2)

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/effect(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/boss = owner
	if(istype(boss) && boss.boss_cloak())
		boss.visible_message(span_warning("[boss] fades into a faint shimmer!"))

