/**
 * # Bounty hunting: the five mini-boss kits
 *
 * Owner: P4 bosses. Do not edit this file outside P4.
 *
 * What it owns: the Juggernaut, Pyromaniac, Demolitionist, Ghost and Heavy
 * (/mob/living/carbon/human/npc/bounty_criminal/boss/<kit>, BOUNTY_KIT_*): what each wears and carries,
 * and its two abilities (spec section 5, 12.3 C8). Every kit is a real human in real gear, locked to its
 * body (D3): its armour protects by tg's rules and its weapon is a real item it fights with. Its
 * stimulants and bruise pack are packed by boss_supplies(). Nothing it carries is ever loot.
 *
 * - Juggernaut: riot armour and a body grown huge (tg's gigantism gene). Charges in a line, smashing
 *   tables, chairs and plain windows and tearing through an interior wall; running into anything else
 *   hurts it and knocks it down, as running into a wall does anyone (CB-6). Slams the floor around it
 *   when someone is close. Fights with its fists.
 * - Pyromaniac: a real firefighter suit and helmet (tg's thermal protection, CB-7) and a lit torch.
 *   Sweeps a cone of fire and throws molotovs that leave a burning patch; whoever it catches burns with
 *   tg's fire stacks (CB-8).
 * - Demolitionist: a hard hat, a hi-vis vest, a bandolier and a crowbar in its bag. Keeps its distance
 *   and lobs grenades with a visible fuse, and blows a hole through an interior wall or door to get at
 *   someone behind cover. Whoever a blast catches takes tg's light explosion (CB-10).
 * - Ghost: a dark hood, a real combat knife and real chrome (Slipwire, Cascade; the OC-6 ruling).
 *   Dashes in along a line with its Cascade lattice firing and stabs at the end of it (CB-9); fades
 *   into a shimmer that is only a look, broken by a hit or a flash (CB-12); backs off after a couple of
 *   cuts.
 * - Heavy: SWAT armour and a real L6 with a spare box. A laser sight and a spin-up, then a burst of
 *   real rounds into a cone (a hit while it aims spoils the shot); throws real barrier grenades for
 *   cover (CB-26); changes its own belts. Slow.
 *
 * Where the air would kill it, each kit seals up in its own space suit, in the armour class of what it
 * wears in good air (bounty_sealed_gear(), bounty_suits.dm): the Juggernaut and the Heavy in armoured
 * ones, the Pyromaniac, the Demolitionist and the Ghost in soft ones.
 *
 * Behind something it can't walk through, a hunter is out of reach unless the kit gets through it
 * (boss_goes_through(), bounty_boss.dm): the Juggernaut's charge, the Demolitionist's grenades and
 * breaching charge, the Pyromaniac's molotovs, the Heavy's rounds, and real Gorilla Arms on any kit.
 * The Ghost has nothing for it, and takes cover instead. It walks up to the barrier only while that
 * ability is off cooldown (boss_breaks_through_now()), or when there is no way round; otherwise it goes
 * round on foot.
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P4 uses goes here
 * with a `boss_` prefix, or on the /boss subtypes.
 */

// ===== JUGGERNAUT =====

/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut
	name = "armoured criminal"
	desc = "A huge criminal in riot plates, built like a door."
	boss_kit = BOUNTY_KIT_JUGGERNAUT
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/charge,
		/datum/action/cooldown/mob_cooldown/bounty_boss/slam,
	)

/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/Initialize(mapload, datum/human_npc_order/order)
	. = ..()
	// Its size is a real gene (CB-21, PI-21): mutadone shrinks it back like anyone else.
	dna?.add_mutation(/datum/mutation/gigantism, MUTATION_SOURCE_ACTIVATED)

/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/bounty_build_outfit(zone)
	return boss_supplies(bounty_outfit_instance(/datum/outfit/bounty_boss/juggernaut))

/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss_gear_text()
	if(istype(wear_suit, /obj/item/clothing/suit/armor/riot))
		return "Riot plates cover [p_them()] from neck to boots."
	return "[p_They()] [p_are()] built like a door."

// Out where the air kills: a black and red space suit, as heavy as its riot plates
/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/bounty_sealed_gear()
	return list(/obj/item/clothing/suit/space/syndicate/black/red, /obj/item/clothing/head/helmet/space/syndicate/black/red)

// Its charge goes straight through a table, a chair, a plain window or a grille
/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss_goes_through(atom/barrier)
	if(..())
		return TRUE
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/charge = locate() in boss_abilities
	return isobj(barrier) && charge?.smashes(barrier) && boss_may_break(barrier)

// With its charge ready
/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss_breaks_through_now(atom/barrier)
	if(..())
		return TRUE
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/charge = boss_ability_off_cooldown(/datum/action/cooldown/mob_cooldown/bounty_boss/charge)
	return isobj(barrier) && charge?.smashes(barrier) && boss_may_break(barrier)

/datum/outfit/bounty_boss/juggernaut
	name = "Bounty mini-boss: Juggernaut"
	uniform = /obj/item/clothing/under/syndicate/combat
	suit = /obj/item/clothing/suit/armor/riot
	head = /obj/item/clothing/head/helmet/toggleable/riot
	gloves = /obj/item/clothing/gloves/combat
	shoes = /obj/item/clothing/shoes/jackboots

/**
 * Charge: a roar, a stamp and a line on the floor, then a run down that line. The first person in
 * the way is slammed and knocked down (anyone else in the way only BOUNTY_JUGGERNAUT_CHARGE_BYSTANDER
 * percent of the time). Tables, chairs, plain windows and grilles on the line are smashed. With
 * nobody caught, it tears through an interior wall at the end of the line if its budget allows;
 * anything else stops it dead, hurt and on the floor (bounce()).
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/charge
	name = "Charge"
	desc = "Lower your head and run through whatever is in the way."
	cooldown_time = BOUNTY_JUGGERNAUT_CHARGE_COOLDOWN
	windup = BOUNTY_JUGGERNAUT_CHARGE_WINDUP
	effect_time = BOUNTY_JUGGERNAUT_CHARGE_RANGE * BOUNTY_JUGGERNAUT_CHARGE_STEP
	/// The tiles it will run over, from the telegraph
	var/list/path
	/// How far along the path it is
	var/step_index = 0
	/// Caught someone this charge
	var/caught = FALSE
	/// Who it is charging at
	var/datum/weakref/charge_target

/datum/action/cooldown/mob_cooldown/bounty_boss/charge/Destroy()
	path = null
	charge_target = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/charge/worth_using(atom/target)
	if(!aimable(target))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_JUGGERNAUT_CHARGE_RANGE && can_see(owner, target, BOUNTY_JUGGERNAUT_CHARGE_RANGE)

/// The line from the boss toward `target`, BOUNTY_JUGGERNAUT_CHARGE_RANGE tiles long, ending at the first wall
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/charge_path(atom/target)
	. = list()
	var/turf/origin = get_turf(owner)
	var/turf/aim = get_turf(target)
	if(!origin || !aim || origin == aim)
		return
	var/angle = get_angle(origin, aim)
	var/turf/far = locate(
		clamp(origin.x + round(BOUNTY_JUGGERNAUT_CHARGE_RANGE * sin(angle)), 1, world.maxx),
		clamp(origin.y + round(BOUNTY_JUGGERNAUT_CHARGE_RANGE * cos(angle)), 1, world.maxy),
		origin.z,
	)
	for(var/turf/spot as anything in get_line(origin, far))
		if(spot == origin)
			continue
		. += spot
		if(length(.) >= BOUNTY_JUGGERNAUT_CHARGE_RANGE || isclosedturf(spot))
			break

/datum/action/cooldown/mob_cooldown/bounty_boss/charge/telegraph(atom/target)
	path = charge_path(target)
	owner.visible_message(span_boldwarning("[owner] roars and stamps, lowering [owner.p_their()] head!"))
	playsound(owner, 'sound/mobs/non-humanoids/gorilla/gorilla.ogg', 80, TRUE)
	owner.Shake(1, 0, windup)
	mark_turfs(path, "#c8a060")

/datum/action/cooldown/mob_cooldown/bounty_boss/charge/effect(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !length(path))
		path = null
		return
	caught = FALSE
	step_index = 0
	charge_target = aimable(target) ? WEAKREF(target) : null
	var/serial = boss.boss_set_busy("charge", effect_time + 1 SECONDS, immobile = FALSE)
	boss.set_glide_size(DELAY_TO_GLIDE_SIZE(BOUNTY_JUGGERNAUT_CHARGE_STEP))
	playsound(boss, 'sound/effects/meteorimpact.ogg', 50, TRUE)
	charge_step(serial)

/// One tile of the charge
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/charge_step(serial)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !boss.boss_still("charge", serial))
		end_charge(serial)
		return
	step_index++
	if(step_index > length(path))
		end_charge(serial)
		return
	var/turf/next = path[step_index]
	// Never off its site, and never over a drop, lava or space.
	if(!boss.leash_ok(next) || isspaceturf(next) || isgroundlessturf(next) || islava(next) || ischasm(next))
		end_charge(serial)
		return
	// Someone in the way: a person, or a mech with one in it, is slammed rather than bounced off (H2).
	for(var/atom/movable/thing as anything in next)
		if(!thing.density || !(isliving(thing) || ismecha(thing)) || !boss.boss_effect_hits(thing))
			continue
		if(thing == charge_target?.resolve() || prob(BOUNTY_JUGGERNAUT_CHARGE_BYSTANDER))
			slam_into(thing)
		else
			boss.visible_message(span_warning("[boss] pulls up short of [thing]."))
		caught = TRUE
		end_charge(serial)
		return
	if(isclosedturf(next))
		if(!caught && break_thing(next))
			boss.visible_message(span_danger("[boss] smashes through the wall!"))
			end_charge(serial)
			return
		bounce(next, serial)
		return
	// Gathered first: a smashed window drops shards onto the tile being walked.
	var/list/blockers = list()
	for(var/obj/thing in next)
		if(thing.density)
			blockers += thing
	for(var/obj/thing as anything in blockers)
		if(QDELETED(thing) || !thing.density)
			continue
		if(smash(thing))
			continue
		bounce(thing, serial)
		return
	if(!try_step(boss, next))
		bounce(next, serial)
		return
	var/list/chairs = list()
	for(var/obj/structure/chair/chair in next)
		chairs += chair
	for(var/obj/structure/chair/chair as anything in chairs)
		break_thing(chair)
	addtimer(CALLBACK(src, PROC_REF(charge_step), serial), BOUNTY_JUGGERNAUT_CHARGE_STEP, TIMER_DELETE_ME)

/// What a charge goes straight through: tables, chairs, plain windows and grilles
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/smashes(obj/thing)
	if(istype(thing, /obj/structure/window))
		var/obj/structure/window/window = thing
		return !window.reinf && !istype(window, /obj/structure/window/plasma)
	return istype(thing, /obj/structure/table) || istype(thing, /obj/structure/chair) || istype(thing, /obj/structure/grille)

/// Smashes `thing` out of its path if it is something it goes through and may break here (it breaks outright, M1). Returns TRUE if it is gone.
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/smash(obj/thing)
	if(!smashes(thing))
		return FALSE
	var/turf/spot = get_turf(thing)
	var/is_window = istype(thing, /obj/structure/window)
	if(!break_thing(thing))
		return FALSE
	owner.do_attack_animation(spot, ATTACK_EFFECT_SMASH)
	playsound(spot, is_window ? 'sound/effects/glass/glassbr1.ogg' : 'sound/effects/woodhit.ogg', 70, TRUE)
	return QDELETED(thing) || !thing.density

/// Steps onto `next` (its leash checked by charge_step()); a plain directional window on its own tile facing that way is smashed first. Returns TRUE if it moved.
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/try_step(mob/living/carbon/human/npc/bounty_criminal/boss/boss, turf/next)
	var/direction = get_dir(boss, next)
	if(boss.Move(next, direction))
		return TRUE
	var/list/in_the_way = list()
	for(var/obj/structure/window/window in get_turf(boss))
		if(window.density && !window.fulltile && (window.dir & direction))
			in_the_way += window
	if(!length(in_the_way))
		return FALSE
	for(var/obj/structure/window/window as anything in in_the_way)
		if(!smash(window))
			return FALSE
	return boss.Move(next, direction)

/// Slams into `victim`, a person or a mech: brute through armour, and a person is knocked down (CB-25)
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/slam_into(atom/victim)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	victim.visible_message(span_danger("[boss] slams into [victim]!"), span_userdanger("[boss] slams into you!"))
	playsound(victim, 'sound/effects/meteorimpact.ogg', 70, TRUE)
	boss.boss_hit(victim, BOUNTY_JUGGERNAUT_CHARGE_DAMAGE, BRUTE, MELEE, BOUNTY_JUGGERNAUT_CHARGE_KNOCKDOWN, BOUNTY_JUGGERNAUT_CHARGE_AP)

/**
 * Ran into something it can't break: stopped dead, and it hurts, the way running into a wall at full
 * tilt hurts anyone (tg's tackle splat, CB-6): brute to its head through its helmet, a blow to its
 * stamina, a moment's paralysis and a knockdown, all tg's. No damage multiplier: on the floor it is
 * simply easier to hit, and to cuff.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/bounce(atom/obstacle, serial)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	end_charge(serial)
	if(!istype(boss) || boss.stat != CONSCIOUS)
		return
	boss.visible_message(span_danger("[boss] slams into [obstacle] and reels!"))
	playsound(boss, 'sound/effects/bang.ogg', 80, TRUE)
	boss.Shake(2, 1, BOUNTY_JUGGERNAUT_WALL_KNOCKDOWN)
	boss.apply_damage(BOUNTY_JUGGERNAUT_WALL_BRUTE, BRUTE, BODY_ZONE_HEAD, boss.run_armor_check(BODY_ZONE_HEAD, MELEE, silent = TRUE))
	boss.apply_damage(BOUNTY_JUGGERNAUT_WALL_STAMINA, STAMINA)
	boss.Paralyze(BOUNTY_JUGGERNAUT_WALL_PARALYZE)
	boss.Knockdown(BOUNTY_JUGGERNAUT_WALL_KNOCKDOWN)

/datum/action/cooldown/mob_cooldown/bounty_boss/charge/proc/end_charge(serial)
	path = null
	charge_target = null
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(istype(boss) && boss.boss_busy == "charge" && boss.boss_busy_serial == serial)
		boss.boss_clear_busy(serial)

/**
 * Slam: both fists up and a red ring on the floor around it, then down. Everyone it catches in the
 * ring, standing or not, takes brute through armour and is knocked down; a mech takes it on its hull.
 * Only when someone is next to it.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/slam
	name = "Ground Slam"
	desc = "Bring both fists down on the floor and knock everyone around you off their feet."
	cooldown_time = BOUNTY_JUGGERNAUT_SLAM_COOLDOWN
	windup = BOUNTY_JUGGERNAUT_SLAM_WINDUP

/datum/action/cooldown/mob_cooldown/bounty_boss/slam/worth_using(atom/target)
	return aimable(target) && get_dist(owner, target) <= 1

/datum/action/cooldown/mob_cooldown/bounty_boss/slam/telegraph(atom/target)
	owner.visible_message(span_boldwarning("[owner] raises both fists high over [owner.p_their()] head!"))
	playsound(owner, 'sound/effects/magic/tail_swing.ogg', 60, TRUE)
	mark_turfs(RANGE_TURFS(1, owner), COLOR_RED)
	var/matrix/rest = matrix(owner.transform)
	var/matrix/raised = matrix(owner.transform)
	raised.Scale(1.05, 1.1)
	animate(owner, transform = raised, time = windup * 0.8, easing = SINE_EASING, flags = ANIMATION_PARALLEL)
	animate(transform = rest, time = 0.2 SECONDS)

/datum/action/cooldown/mob_cooldown/bounty_boss/slam/effect(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	boss.visible_message(span_danger("[boss] brings both fists down on the floor!"))
	playsound(boss, 'sound/effects/meteorimpact.ogg', 80, TRUE)
	for(var/atom/victim as anything in boss.boss_victims_on(RANGE_TURFS(1, boss)))
		boss.boss_hit(victim, BOUNTY_JUGGERNAUT_SLAM_DAMAGE, BRUTE, MELEE, BOUNTY_JUGGERNAUT_SLAM_KNOCKDOWN)
		if(isliving(victim))
			to_chat(victim, span_userdanger("The floor jumps under you and throws you down!"))

// ===== PYROMANIAC =====

/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac
	name = "scorched criminal"
	desc = "A criminal in a blackened fire suit, with a lit torch in hand."
	boss_kit = BOUNTY_KIT_PYROMANIAC
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/flamer,
		/datum/action/cooldown/mob_cooldown/bounty_boss/molotov,
	)

/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/bounty_build_outfit(zone)
	return boss_supplies(bounty_outfit_instance(/datum/outfit/bounty_boss/pyromaniac))

/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/boss_gear_text()
	if(istype(wear_suit, /obj/item/clothing/suit/utility/fire))
		return "[p_Their()] fire suit is scorched black."
	return "[p_They()] reek[p_s()] of fuel."

// Out where the air kills: an EVA suit, as light as its fire suit. Nothing burns in vacuum.
/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/bounty_sealed_gear()
	return list(/obj/item/clothing/suit/space/eva, /obj/item/clothing/head/helmet/space/eva)

// A molotov goes over anything it can see across
/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/boss_goes_through(atom/barrier)
	return ..() || !barrier.opacity

// With a molotov ready
/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/boss_breaks_through_now(atom/barrier)
	return ..() || (!barrier.opacity && !isnull(boss_ability_off_cooldown(/datum/action/cooldown/mob_cooldown/bounty_boss/molotov)))

// The firefighter suit and helmet are what keep its own fire off it (tg's thermal protection, CB-7). The torch
// doesn't holster, so it is in hand from the start.
/datum/outfit/bounty_boss/pyromaniac
	name = "Bounty mini-boss: Pyromaniac"
	uniform = /obj/item/clothing/under/color/black
	suit = /obj/item/clothing/suit/utility/fire/firefighter
	head = /obj/item/clothing/head/utility/hardhat/red
	gloves = /obj/item/clothing/gloves/color/black
	shoes = /obj/item/clothing/shoes/workboots
	r_hand = BOUNTY_PYROMANIAC_TORCH

/**
 * Flamer: the pilot light hisses and an orange cone shows on the floor, then a jet of fire sweeps
 * it. Everyone it catches in the cone takes BOUNTY_PYROMANIAC_FLAMER_DAMAGE burn and catches fire
 * (tg's fire stacks); the floor burns on for BOUNTY_PYROMANIAC_FLAMER_FLOOR.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/flamer
	name = "Flamer"
	desc = "Sweep a cone of fire in front of you."
	cooldown_time = BOUNTY_PYROMANIAC_FLAMER_COOLDOWN
	windup = BOUNTY_PYROMANIAC_FLAMER_WINDUP
	/// The tiles it will cover, from the telegraph
	var/list/cone

/datum/action/cooldown/mob_cooldown/bounty_boss/flamer/Destroy()
	cone = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/flamer/worth_using(atom/target)
	return aimable(target) && get_dist(owner, target) <= BOUNTY_PYROMANIAC_FLAMER_RANGE && can_see(owner, target, BOUNTY_PYROMANIAC_FLAMER_RANGE) && landing_ok(target)

/datum/action/cooldown/mob_cooldown/bounty_boss/flamer/telegraph(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	cone = list()
	// Only where its fire may reach: never off its site or into a ship (M2).
	for(var/turf/spot as anything in cone_turfs(target, BOUNTY_PYROMANIAC_FLAMER_RANGE, BOUNTY_PYROMANIAC_FLAMER_ARC))
		if(boss.boss_reach_ok(spot))
			cone += spot
	owner.visible_message(span_boldwarning("[owner] opens the valve on [owner.p_their()] flamer. The pilot light hisses."))
	playsound(owner, 'sound/effects/spray.ogg', 50, TRUE)
	mark_turfs(cone, "#ff8a1f")

/datum/action/cooldown/mob_cooldown/bounty_boss/flamer/effect(atom/target)
	var/list/fire_turfs = cone
	cone = null
	if(!length(fire_turfs))
		return
	owner.visible_message(span_danger("[owner] sweeps a jet of fire across the floor!"))
	playsound(owner, 'sound/items/weapons/fwoosh.ogg', 80, TRUE)
	new /obj/effect/bounty_boss_fire_pool(get_turf(owner), fire_turfs, BOUNTY_PYROMANIAC_FLAMER_FLOOR, owner, BOUNTY_PYROMANIAC_FLAMER_DAMAGE, BOUNTY_PYROMANIAC_FLAMER_STACKS)

/**
 * Molotov: it lights the rag on a bottle and a ring shows where it will land, then it throws. The
 * bottle breaks into a 3x3 patch of fire (not through walls) for BOUNTY_PYROMANIAC_MOLOTOV_POOL:
 * BOUNTY_PYROMANIAC_MOLOTOV_DAMAGE burn to anyone it catches there, and they catch fire.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/molotov
	name = "Molotov"
	desc = "Throw a lit bottle that bursts into a patch of fire."
	cooldown_time = BOUNTY_PYROMANIAC_MOLOTOV_COOLDOWN
	windup = BOUNTY_PYROMANIAC_MOLOTOV_WINDUP
	/// Where it will land, from the telegraph
	var/turf/landing

/datum/action/cooldown/mob_cooldown/bounty_boss/molotov/Destroy()
	landing = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/molotov/worth_using(atom/target)
	if(!aimable(target))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_PYROMANIAC_MOLOTOV_RANGE && can_see(owner, target, BOUNTY_PYROMANIAC_MOLOTOV_RANGE) && landing_ok(target)

/datum/action/cooldown/mob_cooldown/bounty_boss/molotov/telegraph(atom/target)
	landing = get_turf(target)
