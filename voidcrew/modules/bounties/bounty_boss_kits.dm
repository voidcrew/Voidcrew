// ===== DEMOLITIONIST =====

/mob/living/basic/bounty_criminal/boss/demolitionist
	name = "criminal in a hard hat"
	desc = "A criminal in a hard hat and a hi-vis vest, with a bandolier of grenades across their chest."
	maxHealth = BOUNTY_DEMOLITIONIST_HEALTH_1
	health = BOUNTY_DEMOLITIONIST_HEALTH_1
	speed = BOUNTY_DEMOLITIONIST_SPEED
	damage_coeff = list(BRUTE = BOUNTY_DEMOLITIONIST_BRUTE_MOD, BURN = BOUNTY_DEMOLITIONIST_BURN_MOD, TOX = 1, STAMINA = BOUNTY_BOSS_STAMINA_FRESH * 100 / BOUNTY_BOSS_STAMINA, OXY = 1)
	melee_attack_cooldown = BOUNTY_DEMOLITIONIST_MELEE_COOLDOWN
	attack_vis_effect = ATTACK_EFFECT_SMASH
	boss_kit = BOUNTY_KIT_DEMOLITIONIST
	boss_weapon = BOUNTY_DEMOLITIONIST_CROWBAR
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/grenade,
		/datum/action/cooldown/mob_cooldown/bounty_boss/breach,
	)

/mob/living/basic/bounty_criminal/boss/demolitionist/boss_health_table()
	return list(BOUNTY_DEMOLITIONIST_HEALTH_1, BOUNTY_DEMOLITIONIST_HEALTH_2, BOUNTY_DEMOLITIONIST_HEALTH_3, BOUNTY_DEMOLITIONIST_HEALTH_4)

/mob/living/basic/bounty_criminal/boss/demolitionist/boss_kit_outfit()
	return /datum/outfit/bounty_boss/demolitionist

/mob/living/basic/bounty_criminal/boss/demolitionist/boss_gear_text()
	return "A bandolier of grenades is slung across [p_their()] chest."

/**
 * It keeps BOUNTY_DEMOLITIONIST_KEEP_MIN to _MAX tiles from its target while it has something it
 * could throw from there. It fights hand to hand when someone is right on it, or when nothing is
 * ready for this target (out of its sight with no breach possible, or the strict rotation ruling
 * out the grenade), rather than standing idle.
 */
/mob/living/basic/bounty_criminal/boss/demolitionist/boss_engage_plan(datum/ai_controller/controller, atom/target)
	if(!isliving(target) && !ismecha(target))
		return FALSE
	var/distance = get_dist(src, target)
	if(distance <= 1 || !boss_has_next_throw(target))
		return FALSE
	if(distance < BOUNTY_DEMOLITIONIST_KEEP_MIN)
		controller.queue_behavior(/datum/ai_behavior/step_away, BB_BASIC_MOB_CURRENT_TARGET)
		return TRUE
	if(distance > BOUNTY_DEMOLITIONIST_KEEP_MAX)
		controller.queue_behavior(/datum/ai_behavior/pursue_to_range, BB_BASIC_MOB_CURRENT_TARGET, BOUNTY_DEMOLITIONIST_KEEP_MAX)
		return TRUE
	// In its band: it waits for the next throw.
	return TRUE

/**
 * Whether the rotation leaves it an ability it could use on `target` from its band. Cooldowns are
 * ignored on purpose, so it holds its range between grenades instead of stepping in and out.
 */
/mob/living/basic/bounty_criminal/boss/demolitionist/proc/boss_has_next_throw(atom/target)
	for(var/datum/action/cooldown/mob_cooldown/bounty_boss/ability as anything in boss_abilities)
		if(QDELETED(ability) || (boss_strict_rotation && ability.type == boss_last_ability))
			continue
		// A grenade needs the target in sight; its range is checked by the band itself. A breach only when one is possible now.
		if(istype(ability, /datum/action/cooldown/mob_cooldown/bounty_boss/grenade))
			if(can_see(src, target, get_dist(src, target)))
				return TRUE
			continue
		if(ability.worth_using(target))
			return TRUE
	return FALSE

/datum/outfit/bounty_boss/demolitionist
	name = "Bounty mini-boss: Demolitionist"
	uniform = /obj/item/clothing/under/misc/overalls
	suit = /obj/item/clothing/suit/hazardvest
	belt = /obj/item/storage/belt/bandolier
	head = /obj/item/clothing/head/utility/hardhat
	glasses = /obj/item/clothing/glasses/welding
	gloves = /obj/item/clothing/gloves/color/black
	shoes = /obj/item/clothing/shoes/workboots
	r_hand = BOUNTY_DEMOLITIONIST_CROWBAR

/**
 * Grenade: it pulls the pin and a mark shows where it is aiming, then it throws. The grenade lands
 * and burns a BOUNTY_DEMOLITIONIST_GRENADE_FUSE fuse with a blinking red ring before it goes off
 * (/obj/effect/bounty_boss_explosive). BOUNTY_DEMOLITIONIST_SECOND_GRENADE percent of the time a
 * second one follows near the first.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/grenade
	name = "Grenade"
	desc = "Throw a grenade on a short fuse."
	cooldown_time = BOUNTY_DEMOLITIONIST_GRENADE_COOLDOWN
	windup = BOUNTY_DEMOLITIONIST_GRENADE_WINDUP
	/// Where it will land, from the telegraph
	var/turf/landing

/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/Destroy()
	landing = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/worth_using(atom/target)
	if(!aimable(target))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_DEMOLITIONIST_GRENADE_RANGE && can_see(owner, target, BOUNTY_DEMOLITIONIST_GRENADE_RANGE) && landing_ok(target)

/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/telegraph(atom/target)
	landing = get_turf(target)
	owner.visible_message(span_boldwarning("[owner] pulls the pin on a grenade!"))
	playsound(owner, 'sound/items/weapons/armbomb.ogg', 60, TRUE)
	// The mark stays until the grenade lands and shows its own ring (L3).
	mark_turfs(list(landing), COLOR_RED, "target_circle", /obj/effect/temp_visual/bounty_boss_thrown::duration)

/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/effect(atom/target)
	var/turf/spot = landing
	landing = null
	if(!spot)
		return
	throw_grenade(spot)
	if(!prob(BOUNTY_DEMOLITIONIST_SECOND_GRENADE))
		return
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	var/list/near = list()
	for(var/turf/other as anything in RANGE_TURFS(2, spot))
		if(other != spot && !isclosedturf(other) && boss.boss_reach_ok(other) && bounty_boss_clear_line(get_turf(owner), other))
			near += other
	if(length(near))
		addtimer(CALLBACK(src, PROC_REF(throw_grenade), pick(near)), 0.5 SECONDS, TIMER_DELETE_ME)

/// Throws one grenade at `spot`: it flies, lands and starts its fuse
/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/proc/throw_grenade(turf/spot)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	// The second grenade comes half a second later: not if it was downed, cuffed or stunned meanwhile.
	if(!istype(boss) || !boss.boss_can_act() || !spot)
		return
	boss.visible_message(span_danger("[boss] throws a grenade!"))
	new /obj/effect/temp_visual/bounty_boss_thrown(get_turf(boss), spot)
	new /obj/effect/temp_visual/bounty_boss_mark(spot, /obj/effect/temp_visual/bounty_boss_thrown::duration, COLOR_RED, "target_circle")
	addtimer(CALLBACK(src, PROC_REF(land), spot), /obj/effect/temp_visual/bounty_boss_thrown::duration, TIMER_DELETE_ME)

/datum/action/cooldown/mob_cooldown/bounty_boss/grenade/proc/land(turf/spot)
	if(QDELETED(owner))
		return
	new /obj/effect/bounty_boss_explosive(spot, owner)

/**
 * Breaching charge: only toward a target it can't reach in a straight line (someone behind cover),
 * when an interior wall or door beside it leads their way and its wall budget allows. It kneels and
 * presses a charge on, then steps back; the charge beeps for BOUNTY_DEMOLITIONIST_BREACH_FUSE and
 * blows the wall (leaving a girder) or the door.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/breach
	name = "Breaching Charge"
	desc = "Blow a hole through a wall or door to get at someone behind it."
	cooldown_time = BOUNTY_DEMOLITIONIST_BREACH_COOLDOWN
	windup = BOUNTY_DEMOLITIONIST_BREACH_WINDUP
	/// The wall or door it is charging, from the telegraph
	var/datum/weakref/breach_ref

/datum/action/cooldown/mob_cooldown/bounty_boss/breach/Destroy()
	breach_ref = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/breach/worth_using(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!aimable(target) || !istype(boss) || boss.boss_walls_left <= 0)
		return FALSE
	if(get_dist(boss, target) > BOUNTY_DEMOLITIONIST_BREACH_RANGE)
		return FALSE
	// Only when something solid stands between them.
	if(bounty_boss_clear_line(get_turf(boss), get_turf(target)))
		return FALSE
	return !isnull(breach_spot(target))

/// The interior wall or door beside it that leads toward `target`, if it may break one
/datum/action/cooldown/mob_cooldown/bounty_boss/breach/proc/breach_spot(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	var/toward = get_dir(boss, target)
	for(var/direction in list(toward, turn(toward, 45), turn(toward, -45)))
		var/turf/spot = get_step(boss, direction)
		if(!spot)
			continue
		if(iswallturf(spot) && boss.boss_may_break(spot))
			return spot
		for(var/obj/machinery/door/door in spot)
			if(door.density && boss.boss_may_break(door))
				return door
	return null

/datum/action/cooldown/mob_cooldown/bounty_boss/breach/telegraph(atom/target)
	var/atom/spot = breach_spot(target)
	breach_ref = spot ? WEAKREF(spot) : null
	if(!spot)
		return
	owner.visible_message(span_boldwarning("[owner] kneels and presses a charge against [spot]!"))
	playsound(owner, 'sound/machines/click.ogg', 60, TRUE)
	mark_turfs(list(get_turf(spot)), COLOR_RED)

/datum/action/cooldown/mob_cooldown/bounty_boss/breach/effect(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	var/atom/spot = breach_ref?.resolve()
	breach_ref = null
	if(!istype(boss) || QDELETED(spot) || !boss.boss_may_break(spot))
		return
	new /obj/effect/bounty_boss_explosive/breach(get_turf(spot), boss, spot)
	boss.visible_message(span_danger("The charge on [spot] starts beeping!"))

/**
 * A boss's grenade or breaching charge: a fuse with a blinking red ring and beeping, then a
 * scripted blast. No explosion(), no fire: brute against bomb armour and a knockdown to everyone
 * the boss may hurt within `radius` (not through walls), and damage to structures within
 * `object_radius` through the boss's rules (boss_damage_structure()). Capped at
 * BOUNTY_BOSS_EXPLOSIVE_CAP server-wide. With its boss gone, it still goes off but breaks nothing.
 */
/obj/effect/bounty_boss_explosive
	name = "grenade"
	desc = "It's about to go off."
	icon = 'icons/obj/weapons/grenade.dmi'
	icon_state = "frag_active"
	anchored = TRUE
	layer = ABOVE_OBJ_LAYER
	/// The boss who threw it
	var/datum/weakref/boss_ref
	var/fuse = BOUNTY_DEMOLITIONIST_GRENADE_FUSE
	/// Who it catches, and how hard
	var/radius = BOUNTY_DEMOLITIONIST_GRENADE_RADIUS
	var/damage = BOUNTY_DEMOLITIONIST_GRENADE_DAMAGE
	var/knockdown = BOUNTY_DEMOLITIONIST_GRENADE_KNOCKDOWN
	/// What it breaks, and how hard
	var/object_radius = BOUNTY_DEMOLITIONIST_GRENADE_OBJECT_RADIUS
	var/object_damage = BOUNTY_DEMOLITIONIST_GRENADE_OBJECT_DAMAGE
	/// Structures it may still damage: a one-item list
	var/list/structure_tally
	/// Its ring
	var/obj/effect/temp_visual/bounty_boss_mark/ring

/obj/effect/bounty_boss_explosive/Initialize(mapload, mob/living/basic/bounty_criminal/boss/boss)
	. = ..()
	if(length(GLOB.bounty_boss_explosives) >= BOUNTY_BOSS_EXPLOSIVE_CAP)
		return INITIALIZE_HINT_QDEL
	GLOB.bounty_boss_explosives += src
	boss_ref = boss ? WEAKREF(boss) : null
	structure_tally = list(BOUNTY_BOSS_ABILITY_STRUCTURE_CAP)
	ring = new(get_turf(src), fuse, COLOR_RED, "target_circle")
	ring.transform = matrix() * (radius * 2 + 1)
	ring.blink()
	playsound(src, 'sound/machines/beep/beep.ogg', 40, TRUE)
	addtimer(CALLBACK(src, PROC_REF(beep)), 0.5 SECONDS, TIMER_LOOP | TIMER_DELETE_ME)
	addtimer(CALLBACK(src, PROC_REF(detonate)), fuse, TIMER_DELETE_ME)

/obj/effect/bounty_boss_explosive/Destroy()
	GLOB.bounty_boss_explosives -= src
	boss_ref = null
	structure_tally = null
	if(!QDELETED(ring))
		qdel(ring)
	ring = null
	return ..()

/obj/effect/bounty_boss_explosive/proc/beep()
	playsound(src, 'sound/machines/beep/beep.ogg', 30, TRUE)

/// Whether the blast may hurt `victim`: its boss's rules, or with the boss gone, awake hunters and their mechs
/obj/effect/bounty_boss_explosive/proc/may_hit(atom/victim, mob/living/basic/bounty_criminal/boss/boss)
	if(!QDELETED(boss))
		return boss.boss_can_hurt(victim)
	return bounty_boss_orphan_victim(victim)

/obj/effect/bounty_boss_explosive/proc/detonate()
	var/turf/here = get_turf(src)
	if(!here)
		qdel(src)
		return
	var/mob/living/basic/bounty_criminal/boss/boss = boss_ref?.resolve()
	if(QDELETED(boss))
		boss = null
	blast_structures(boss, here)
	new /obj/effect/temp_visual/explosion/fast(here)
	playsound(here, 'sound/effects/explosion/explosion1.ogg', 70, TRUE)
	for(var/atom/movable/victim in range(radius, here))
		if(!(isliving(victim) || ismecha(victim)) || !may_hit(victim, boss) || !bounty_boss_clear_line(here, get_turf(victim)))
			continue
		if(boss)
			boss.boss_hit(victim, damage, BRUTE, BOMB, knockdown)
		else if(ismecha(victim))
			victim.take_damage(damage, BRUTE, BOMB, FALSE)
		else
			var/mob/living/person = victim
			person.apply_damage(damage, BRUTE, BODY_ZONE_CHEST, person.run_armor_check(BODY_ZONE_CHEST, BOMB, silent = TRUE))
			if(knockdown)
				person.Knockdown(knockdown)
	qdel(src)

/// Structures in reach take the blast, through the boss's rules
/obj/effect/bounty_boss_explosive/proc/blast_structures(mob/living/basic/bounty_criminal/boss/boss, turf/here)
	if(!boss || object_damage <= 0)
		return
	for(var/obj/thing in range(object_radius, here))
		if(thing == src || thing.invisibility >= INVISIBILITY_ABSTRACT)
			continue
		boss.boss_damage_structure(thing, object_damage, structure_tally, BOMB)

/// A breaching charge on an interior wall or door
/obj/effect/bounty_boss_explosive/breach
	name = "breaching charge"
	desc = "A charge stuck to the wall, beeping."
	icon_state = "plastic-explosive0_active"
	fuse = BOUNTY_DEMOLITIONIST_BREACH_FUSE
	radius = 1
	damage = BOUNTY_DEMOLITIONIST_BREACH_DAMAGE
	knockdown = 0
	object_radius = 0
	object_damage = 0
	/// The wall or door it is on
	var/datum/weakref/breach_ref

/obj/effect/bounty_boss_explosive/breach/Initialize(mapload, mob/living/basic/bounty_criminal/boss/boss, atom/breach_target)
	. = ..()
	breach_ref = breach_target ? WEAKREF(breach_target) : null

/obj/effect/bounty_boss_explosive/breach/Destroy()
	breach_ref = null
	return ..()

/obj/effect/bounty_boss_explosive/breach/beep()
	playsound(src, 'sound/machines/beep/beep.ogg', 60, TRUE)

/obj/effect/bounty_boss_explosive/breach/blast_structures(mob/living/basic/bounty_criminal/boss/boss, turf/here)
	var/atom/target = breach_ref?.resolve()
	if(!boss || QDELETED(target))
		return
	boss.boss_damage_structure(target, null, structure_tally, BOMB)

// ===== GHOST =====

/mob/living/basic/bounty_criminal/boss/ghost
	name = "hooded criminal"
	desc = "A lean criminal in a dark hooded cloak, holding a long knife low."
	maxHealth = BOUNTY_GHOST_HEALTH_1
	health = BOUNTY_GHOST_HEALTH_1
	speed = BOUNTY_GHOST_SPEED
	damage_coeff = list(BRUTE = BOUNTY_GHOST_BRUTE_MOD, BURN = BOUNTY_GHOST_BURN_MOD, TOX = 1, STAMINA = BOUNTY_BOSS_STAMINA_FRESH * 100 / BOUNTY_BOSS_STAMINA, OXY = 1)
	melee_attack_cooldown = BOUNTY_GHOST_MELEE_COOLDOWN
	attack_vis_effect = ATTACK_EFFECT_SLASH
	boss_kit = BOUNTY_KIT_GHOST
	boss_weapon = BOUNTY_GHOST_KNIFE
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/dash,
		/datum/action/cooldown/mob_cooldown/bounty_boss/cloak,
	)
	/// Cloaked: faint, and hard to hit, until a flash, a hit or the time runs out
	var/boss_cloaked = FALSE
	var/boss_cloak_timer
	/// world.time of its last step, for dodging while moving
	var/boss_last_moved = 0
	/// Cuts since it last broke off, and when it may close in again
	var/boss_cuts = 0
	var/boss_breakoff_until = 0
	/// Its dodge and miss messages show at most every BOUNTY_BOSS_MESSAGE_COOLDOWN (L5)
	COOLDOWN_DECLARE(boss_message_cooldown)

/mob/living/basic/bounty_criminal/boss/ghost/Destroy()
	deltimer(boss_cloak_timer)
	boss_cloak_timer = null
	return ..()

/mob/living/basic/bounty_criminal/boss/ghost/boss_health_table()
	return list(BOUNTY_GHOST_HEALTH_1, BOUNTY_GHOST_HEALTH_2, BOUNTY_GHOST_HEALTH_3, BOUNTY_GHOST_HEALTH_4)

/mob/living/basic/bounty_criminal/boss/ghost/boss_kit_outfit()
	return /datum/outfit/bounty_boss/ghost

/mob/living/basic/bounty_criminal/boss/ghost/boss_gear_text()
	return "[p_They()] move[p_s()] quick and light, and the knife is never still."

/datum/outfit/bounty_boss/ghost
	name = "Bounty mini-boss: Ghost"
	uniform = /obj/item/clothing/under/color/black
	suit = /obj/item/clothing/suit/hooded/chaplain_hoodie
	mask = /obj/item/clothing/mask/bandana/black
	gloves = /obj/item/clothing/gloves/color/black
	shoes = /obj/item/clothing/shoes/sneakers/black
	r_hand = BOUNTY_GHOST_KNIFE

/// Its cuts bleed, and after a couple of them it breaks off for a while
/mob/living/basic/bounty_criminal/boss/ghost/melee_attack(atom/target, list/modifiers, ignore_cooldown = FALSE)
	. = ..()
	if(!. || !isliving(target))
		return
	boss_cut(target)

/// A cut on `victim`: it bleeds, and the hit-and-run count goes up
/mob/living/basic/bounty_criminal/boss/ghost/proc/boss_cut(mob/living/victim)
	if(QDELETED(victim) || victim.stat == DEAD)
		return
	victim.apply_status_effect(/datum/status_effect/bounty_boss_bleed)
	boss_cuts++
	if(boss_cuts >= BOUNTY_GHOST_CUTS_BEFORE_BREAKOFF)
		boss_cuts = 0
		boss_breakoff_until = world.time + BOUNTY_GHOST_BREAKOFF_TIME

/// Breaking off: it backs away from its target for a while
/mob/living/basic/bounty_criminal/boss/ghost/boss_engage_plan(datum/ai_controller/controller, atom/target)
	if(world.time >= boss_breakoff_until || !(isliving(target) || ismecha(target)) || get_dist(src, target) > 4)
		return FALSE
	controller.queue_behavior(/datum/ai_behavior/step_away, BB_BASIC_MOB_CURRENT_TARGET)
	return TRUE

/mob/living/basic/bounty_criminal/boss/ghost/boss_moved()
	boss_last_moved = world.time

/// Whether it is on the move, for dodging
/mob/living/basic/bounty_criminal/boss/ghost/proc/boss_moving()
	return world.time <= boss_last_moved + BOUNTY_GHOST_MOVING_WINDOW && boss_can_act()

/// It dodges some shots while moving, and cloaked, half of them miss
/mob/living/basic/bounty_criminal/boss/ghost/boss_projectile_prehit(obj/projectile/shot)
	if(shot.firer == src || stat != CONSCIOUS)
		return NONE
	var/hit_chance = 100
	if(boss_moving())
		hit_chance *= (100 - BOUNTY_GHOST_DODGE) / 100
	if(boss_cloaked)
		hit_chance *= (100 - BOUNTY_GHOST_CLOAK_MISS) / 100
	if(prob(hit_chance))
		return NONE
	boss_miss_message(span_warning("[src] slips aside from [shot]!"))
	return PROJECTILE_INTERRUPT_HIT_PHASE

/// A dodge or miss message, at most every BOUNTY_BOSS_MESSAGE_COOLDOWN so automatic fire doesn't flood chat (L5)
/mob/living/basic/bounty_criminal/boss/ghost/proc/boss_miss_message(message)
	if(!COOLDOWN_FINISHED(src, boss_message_cooldown))
		return
	COOLDOWN_START(src, boss_message_cooldown, BOUNTY_BOSS_MESSAGE_COOLDOWN)
	visible_message(message)

/// Cloaked, half the blows find nothing
/mob/living/basic/bounty_criminal/boss/ghost/boss_check_block(atom/hit_by, attack_text, attack_type)
	if(!boss_cloaked || stat != CONSCIOUS || !prob(BOUNTY_GHOST_CLOAK_MISS))
		return NONE
	boss_miss_message(span_warning("[attack_text] swings through the shimmer where [src] was!"))
	return SUCCESSFUL_BLOCK

/mob/living/basic/bounty_criminal/boss/ghost/boss_took_damage(damage, damagetype)
	if(boss_cloaked)
		boss_uncloak("A hit breaks the shimmer around [src].")

/mob/living/basic/bounty_criminal/boss/ghost/boss_flashed(mob/living/user)
	if(boss_cloaked)
		boss_uncloak("The flash burns away the shimmer around [src]!")

/mob/living/basic/bounty_criminal/boss/ghost/boss_on_interrupted()
	if(boss_cloaked)
		boss_uncloak()

/// Fades to a faint shimmer for BOUNTY_GHOST_CLOAK_TIME
/mob/living/basic/bounty_criminal/boss/ghost/proc/boss_cloak()
	if(stat != CONSCIOUS)
		return FALSE
	boss_cloaked = TRUE
	animate(src, alpha = BOUNTY_GHOST_CLOAK_ALPHA, time = 0.3 SECONDS)
	add_filter("bounty_ghost_shimmer", 2, list("type" = "blur", "size" = 1))
	deltimer(boss_cloak_timer)
	boss_cloak_timer = addtimer(CALLBACK(src, PROC_REF(boss_uncloak), "The shimmer around [src] fades."), BOUNTY_GHOST_CLOAK_TIME, TIMER_STOPPABLE | TIMER_DELETE_ME)
	return TRUE

/// Plain to see again, with `message` if something broke the cloak
/mob/living/basic/bounty_criminal/boss/ghost/proc/boss_uncloak(message)
	if(!boss_cloaked)
		return FALSE
	boss_cloaked = FALSE
	deltimer(boss_cloak_timer)
	boss_cloak_timer = null
	animate(src, alpha = 255, time = 0.3 SECONDS)
	remove_filter("bounty_ghost_shimmer")
	if(message)
		visible_message(span_warning(message))
	return TRUE

/**
 * Dash: it crouches and a blurred line shows on the floor to its target, then it darts down it,
 * leaving after-images, and cuts at the end: BOUNTY_GHOST_DASH_DAMAGE and a bleed.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/dash
	name = "Dash"
	desc = "Dart in along a line and cut whoever is at the end of it."
	cooldown_time = BOUNTY_GHOST_DASH_COOLDOWN
	windup = BOUNTY_GHOST_DASH_WINDUP
	effect_time = BOUNTY_GHOST_DASH_RANGE
	/// The tiles it will dart over, from the telegraph
	var/list/path
	var/step_index = 0
	/// Who it is dashing at
	var/datum/weakref/dash_target

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/Destroy()
	path = null
	dash_target = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/worth_using(atom/target)
	if(!aimable(target))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_GHOST_DASH_RANGE + 1 && bounty_boss_clear_line(get_turf(owner), get_turf(target))

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/telegraph(atom/target)
	path = list()
	var/turf/origin = get_turf(owner)
	var/turf/aim = get_turf(target)
	if(origin && aim)
		for(var/turf/spot as anything in get_line(origin, aim))
			if(spot == origin || spot == aim)
				continue
			path += spot
			if(length(path) >= BOUNTY_GHOST_DASH_RANGE)
				break
	owner.visible_message(span_boldwarning("[owner] crouches low, knife held out."))
	playsound(owner, 'sound/effects/podwoosh.ogg', 40, TRUE)
	mark_turfs(path, "#9a9ab8")

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/effect(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss))
		return
	dash_target = aimable(target) ? WEAKREF(target) : null
	step_index = 0
	if(!length(path))
		cut_at_end(target)
		return
	var/serial = boss.boss_set_busy("dash", effect_time + 1 SECONDS, immobile = FALSE)
	boss.set_glide_size(DELAY_TO_GLIDE_SIZE(1))
	dash_step(serial)

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/dash_step(serial)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !boss.boss_still("dash", serial))
		end_dash(serial, FALSE)
		return
	step_index++
	if(step_index > length(path))
		end_dash(serial, TRUE)
		return
	var/turf/next = path[step_index]
	if(!boss.leash_ok(next) || isgroundlessturf(next) || islava(next) || ischasm(next))
		end_dash(serial, TRUE)
		return
	var/turf/was = get_turf(boss)
	if(!boss.Move(next, get_dir(boss, next)))
		end_dash(serial, TRUE)
		return
	new /obj/effect/temp_visual/decoy/fading/halfsecond(was, boss)
	addtimer(CALLBACK(src, PROC_REF(dash_step), serial), 1, TIMER_DELETE_ME)

/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/end_dash(serial, cut)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	path = null
	var/atom/victim = dash_target?.resolve()
	dash_target = null
	if(istype(boss) && boss.boss_busy == "dash" && boss.boss_busy_serial == serial)
		boss.boss_clear_busy(serial)
	if(cut)
		cut_at_end(victim)

/// The cut at the end of the dash, if its target (a hunter, or a mech) is within reach
/datum/action/cooldown/mob_cooldown/bounty_boss/dash/proc/cut_at_end(atom/victim)
	var/mob/living/basic/bounty_criminal/boss/ghost/boss = owner
	if(!istype(boss) || !boss.boss_can_act() || !aimable(victim) || !boss.Adjacent(victim) || !boss.boss_can_hurt(victim))
		return
	boss.do_attack_animation(victim, ATTACK_EFFECT_SLASH)
	playsound(victim, 'sound/items/weapons/bladeslice.ogg', 70, TRUE)
	victim.visible_message(span_danger("[boss] darts in and slashes [victim]!"), span_userdanger("[boss] darts in and slashes you!"))
	if(ismecha(victim))
		boss.boss_hit(victim, BOUNTY_GHOST_DASH_DAMAGE, BRUTE, MELEE, 0, BOUNTY_GHOST_DASH_AP)
		return
	var/mob/living/person = victim
	person.apply_damage(BOUNTY_GHOST_DASH_DAMAGE, BRUTE, BODY_ZONE_CHEST, person.run_armor_check(BODY_ZONE_CHEST, MELEE, armour_penetration = BOUNTY_GHOST_DASH_AP, silent = TRUE), sharpness = SHARP_EDGED)
	boss.boss_cut(person)

/// Cloak: the air around it shimmers, then it fades to a faint distortion that half of all hits miss
/datum/action/cooldown/mob_cooldown/bounty_boss/cloak
	name = "Cloak"
	desc = "Fade into a shimmer that is hard to hit."
	cooldown_time = BOUNTY_GHOST_CLOAK_COOLDOWN
	windup = BOUNTY_GHOST_CLOAK_WINDUP

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/worth_using(atom/target)
	var/mob/living/basic/bounty_criminal/boss/ghost/boss = owner
	return aimable(target) && istype(boss) && !boss.boss_cloaked

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/telegraph(atom/target)
	owner.visible_message(span_boldwarning("The air around [owner] starts to shimmer."))
	playsound(owner, 'sound/effects/magic/smoke.ogg', 40, TRUE)
	animate(owner, alpha = 150, time = windup / 2, flags = ANIMATION_PARALLEL)
	animate(alpha = 255, time = windup / 2)

/datum/action/cooldown/mob_cooldown/bounty_boss/cloak/effect(atom/target)
	var/mob/living/basic/bounty_criminal/boss/ghost/boss = owner
	if(istype(boss) && boss.boss_cloak())
		boss.visible_message(span_warning("[boss] fades into a faint shimmer!"))

/**
 * The Ghost's cuts: BOUNTY_GHOST_BLEED_PER_CUT brute a second for each cut, up to
 * BOUNTY_GHOST_BLEED_CAP, for BOUNTY_GHOST_BLEED_TIME after the last one, with the blood to show it.
 * It stops once they are down (C4, M3).
 */
/datum/status_effect/bounty_boss_bleed
	id = "bounty_boss_bleed"
	duration = BOUNTY_GHOST_BLEED_TIME
	tick_interval = 1 SECONDS
	status_type = STATUS_EFFECT_REFRESH
	alert_type = null
	/// Cuts bleeding
	var/cuts = 1

/datum/status_effect/bounty_boss_bleed/on_apply()
	return owner.stat == CONSCIOUS

/datum/status_effect/bounty_boss_bleed/refresh(effect, ...)
	. = ..()
	cuts++

/datum/status_effect/bounty_boss_bleed/tick(seconds_between_ticks)
	if(owner.stat != CONSCIOUS)
		qdel(src)
		return
	var/rate = min(cuts * BOUNTY_GHOST_BLEED_PER_CUT, BOUNTY_GHOST_BLEED_CAP)
	owner.apply_damage(rate, BRUTE, spread_damage = TRUE)
	owner.bleed(rate)

// ===== HEAVY =====

/mob/living/basic/bounty_criminal/boss/heavy
	name = "heavily armed criminal"
	desc = "A big criminal in heavy armour, carrying a belt-fed gun."
	maxHealth = BOUNTY_HEAVY_HEALTH_1
	health = BOUNTY_HEAVY_HEALTH_1
	mob_size = MOB_SIZE_LARGE
	speed = BOUNTY_HEAVY_SPEED
	damage_coeff = list(BRUTE = BOUNTY_HEAVY_BRUTE_MOD, BURN = BOUNTY_HEAVY_BURN_MOD, TOX = 1, STAMINA = BOUNTY_HEAVY_STAMINA_FRESH * 100 / BOUNTY_HEAVY_STAMINA, OXY = 1)
	melee_attack_cooldown = BOUNTY_HEAVY_MELEE_COOLDOWN
	attack_vis_effect = ATTACK_EFFECT_SMASH
	boss_kit = BOUNTY_KIT_HEAVY
	boss_weapon = BOUNTY_HEAVY_GUN
	boss_stamina_pool = BOUNTY_HEAVY_STAMINA
	boss_stamina_fresh = BOUNTY_HEAVY_STAMINA_FRESH
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/burst,
		/datum/action/cooldown/mob_cooldown/bounty_boss/barricade,
	)

/mob/living/basic/bounty_criminal/boss/heavy/boss_health_table()
	return list(BOUNTY_HEAVY_HEALTH_1, BOUNTY_HEAVY_HEALTH_2, BOUNTY_HEAVY_HEALTH_3, BOUNTY_HEAVY_HEALTH_4)

/mob/living/basic/bounty_criminal/boss/heavy/boss_kit_outfit()
	return /datum/outfit/bounty_boss/heavy

/mob/living/basic/bounty_criminal/boss/heavy/boss_gear_text()
	return "[p_They()] [p_are()] in heavy armour."

/datum/outfit/bounty_boss/heavy
	name = "Bounty mini-boss: Heavy"
	uniform = /obj/item/clothing/under/syndicate/combat
	suit = /obj/item/clothing/suit/armor/swat
	head = /obj/item/clothing/head/helmet/swat
	gloves = /obj/item/clothing/gloves/combat
	shoes = /obj/item/clothing/shoes/jackboots
	r_hand = BOUNTY_HEAVY_GUN

/**
 * Suppressive burst: the gun spins up with a whirr, a red laser sight settles on the target's tile
 * and a red cone shows on the floor, staying there until the last round (L3). Then
 * BOUNTY_HEAVY_BURST_SHOTS rounds go into that cone over BOUNTY_HEAVY_BURST_TIME, where it aimed, not
 * where the target went, and no further than the cone is marked. The rounds damage only windows,
 * grilles, tables and barricades the boss may break (interior, on its site), at
 * BOUNTY_HEAVY_BURST_DEMOLITION of their damage (M5).
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/burst
	name = "Suppressive Burst"
	desc = "Spin up and hose a cone with rounds."
	cooldown_time = BOUNTY_HEAVY_BURST_COOLDOWN
	windup = BOUNTY_HEAVY_BURST_WINDUP
	effect_time = BOUNTY_HEAVY_BURST_TIME
	/// Where it aimed, from the telegraph
	var/turf/aim_turf
	var/aim_angle = 0
	/// Rounds left in the burst under way
	var/shots_left = 0

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/Destroy()
	aim_turf = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/worth_using(atom/target)
	if(!aimable(target))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_HEAVY_BURST_RANGE && can_see(owner, target, BOUNTY_HEAVY_BURST_RANGE) && landing_ok(target)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/telegraph(atom/target)
	aim_turf = get_turf(target)
	var/turf/origin = get_turf(owner)
	if(!aim_turf || !origin || aim_turf == origin)
		return
	aim_angle = get_angle(origin, aim_turf)
	owner.visible_message(span_boldwarning("[owner] spins up [owner.p_their()] gun, and a red laser dot settles on the floor by [target]!"))
	playsound(owner, 'sound/items/weapons/gun/l6/l6_rack.ogg', 70, TRUE)
	playsound(owner, 'sound/items/weapons/scope.ogg', 50, TRUE)
	add_telegraph(owner.Beam(aim_turf, icon_state = "r_beam", time = windup, maxdistance = BOUNTY_HEAVY_BURST_RANGE + 1))
	mark_turfs(cone_turfs(target, BOUNTY_HEAVY_BURST_RANGE, BOUNTY_HEAVY_BURST_ARC + BOUNTY_HEAVY_BURST_MARK_MARGIN), "#ff2020", linger = BOUNTY_HEAVY_BURST_TIME)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/effect(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !aim_turf)
		return
	shots_left = BOUNTY_HEAVY_BURST_SHOTS
	boss.visible_message(span_danger("[boss] opens fire!"))
	var/serial = boss.boss_set_busy("burst", effect_time + 1 SECONDS)
	fire_round(serial)

/// One round of the burst, and the next after it
/datum/action/cooldown/mob_cooldown/bounty_boss/burst/proc/fire_round(serial)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !boss.boss_still("burst", serial) || shots_left <= 0 || !aim_turf)
		end_burst(serial)
		return
	shots_left--
	var/turf/origin = get_turf(boss)
	var/obj/projectile/bullet/bounty_boss_heavy/bullet = new(origin)
	// Its gun's own rounds, no further than the marked cone
	bounty_real_weapon(BOUNTY_HEAVY_GUN).load(bullet)
	bullet.range = BOUNTY_HEAVY_BURST_RANGE
	bullet.maximum_range = BOUNTY_HEAVY_BURST_RANGE
	bullet.firer = boss
	bullet.fired_from = boss
	bullet.ignored_factions = boss.faction.Copy()
	bullet.aim_projectile(aim_turf, boss)
	if(!QDELETED(bullet))
		bullet.fire(aim_angle + rand(-BOUNTY_HEAVY_BURST_ARC / 2, BOUNTY_HEAVY_BURST_ARC / 2))
	playsound(boss, 'sound/items/weapons/gun/l6/shot.ogg', 60, TRUE)
	if(shots_left <= 0)
		end_burst(serial)
		return
	addtimer(CALLBACK(src, PROC_REF(fire_round), serial), max(1, round(BOUNTY_HEAVY_BURST_TIME / BOUNTY_HEAVY_BURST_SHOTS)), TIMER_DELETE_ME)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/proc/end_burst(serial)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	shots_left = 0
	aim_turf = null
	if(istype(boss) && boss.boss_busy == "burst" && boss.boss_busy_serial == serial)
		boss.boss_clear_busy(serial)

/**
 * The Heavy's rounds: its belt-fed gun's own (BOUNTY_HEAVY_GUN, loaded as they are fired), no
 * further than the marked cone, and hard on structures only where the boss may break them
 */
/obj/projectile/bullet/bounty_boss_heavy
	name = "heavy round"
	range = BOUNTY_HEAVY_BURST_RANGE
	demolition_mod = 0

// Judged at what it hits, not where it was fired from (M5): never a window onto space, never off the site.
// A mech is a target, not a structure: it takes the round in full.
/obj/projectile/bullet/bounty_boss_heavy/get_demolition_modifier(obj/target)
	if(ismecha(target))
		return 1
	var/mob/living/basic/bounty_criminal/boss/boss = firer
	if(!istype(boss) || QDELETED(boss) || !istype(target) || istype(target, /obj/machinery/door))
		return 0
	return boss.boss_may_break(target) ? BOUNTY_HEAVY_BURST_DEMOLITION : 0

/**
 * Barricade: it unslings a folding barrier and drops it on the tile in front of it, toward its
 * target: tg's security barrier (/obj/structure/barricade/security/bounty_boss). It keeps
 * BOUNTY_BOSS_BARRICADES_PER_BOSS standing; each folds away after BOUNTY_BOSS_BARRICADE_LIFE.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade
	name = "Deploy Barricade"
	desc = "Drop a folding barrier in front of you."
	cooldown_time = BOUNTY_HEAVY_BARRICADE_COOLDOWN
	windup = BOUNTY_HEAVY_BARRICADE_WINDUP
	/// Where it will stand, from the telegraph
	var/turf/barricade_spot
	/// Weakrefs to its barriers still standing, oldest first
	var/list/barriers = list()

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/Destroy()
	barricade_spot = null
	barriers = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/worth_using(atom/target)
	if(!aimable(target) || length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 3 && distance <= 9 && !isnull(find_spot(target))

/// The open tile in front of it toward `target`, on its site, with no barrier on it
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/proc/find_spot(atom/target)
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss))
		return null
	var/turf/spot = get_step(boss, get_dir(boss, target))
	if(!isopenturf(spot) || isgroundlessturf(spot) || islava(spot) || ischasm(spot) || spot.is_blocked_turf())
		return null
	if(!boss.boss_environment_allowed(spot) || (locate(/obj/structure/barricade) in spot))
		return null
	return spot

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/telegraph(atom/target)
	barricade_spot = find_spot(target)
	owner.visible_message(span_boldwarning("[owner] unslings a folded barrier."))
	playsound(owner, 'sound/items/deconstruct.ogg', 50, TRUE)
	if(barricade_spot)
		mark_turfs(list(barricade_spot), "#c0c0c0")

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/effect(atom/target)
	var/turf/spot = barricade_spot
	barricade_spot = null
	var/mob/living/basic/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !spot || spot.is_blocked_turf() || (locate(/obj/structure/barricade) in spot) || !boss.boss_environment_allowed(spot))
		return
	if(length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return
	var/obj/structure/barricade/security/bounty_boss/barrier = new(spot)
	if(QDELETED(barrier))
		return
	boss.visible_message(span_warning("[boss] slams a barrier down in front of [boss.p_them()]."))
	playsound(spot, 'sound/effects/bang.ogg', 50, TRUE)
	barriers += WEAKREF(barrier)
	prune_barriers()

/// Forgets barriers that are gone, and folds up the oldest past BOUNTY_BOSS_BARRICADES_PER_BOSS
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/proc/prune_barriers()
	for(var/datum/weakref/ref as anything in barriers.Copy())
		if(QDELETED(ref.resolve()))
			barriers -= ref
	while(length(barriers) > BOUNTY_BOSS_BARRICADES_PER_BOSS)
		var/datum/weakref/oldest = barriers[1]
		barriers.Cut(1, 2)
		var/obj/structure/barricade/security/bounty_boss/barrier = oldest.resolve()
		barrier?.fold_away()

/// The Heavy's folding barrier: tg's security barrier that folds itself away after BOUNTY_BOSS_BARRICADE_LIFE. Drops nothing.
/obj/structure/barricade/security/bounty_boss
	name = "folding barrier"
	desc = "A folding barrier. It will fold itself back up before long."
	proj_pass_rate = BOUNTY_HEAVY_BARRICADE_PASS

/obj/structure/barricade/security/bounty_boss/Initialize(mapload)
	. = ..()
	if(length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return INITIALIZE_HINT_QDEL
	GLOB.bounty_boss_barricades += src
	addtimer(CALLBACK(src, PROC_REF(fold_away)), BOUNTY_BOSS_BARRICADE_LIFE, TIMER_DELETE_ME)

/obj/structure/barricade/security/bounty_boss/Destroy()
	GLOB.bounty_boss_barricades -= src
	return ..()

/obj/structure/barricade/security/bounty_boss/proc/fold_away()
	if(QDELETED(src))
		return
	visible_message(span_notice("[src] folds itself up and falls apart."))
	qdel(src)
