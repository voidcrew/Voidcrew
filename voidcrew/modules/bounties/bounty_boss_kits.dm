/mob/living/carbon/human/npc/bounty_criminal/boss/heavy
	name = "heavily armed criminal"
	desc = "A big criminal in an ablative coat, carrying a belt-fed gun."
	boss_kit = BOUNTY_KIT_HEAVY
	boss_ability_types = list(
		/datum/action/cooldown/mob_cooldown/bounty_boss/burst,
		/datum/action/cooldown/mob_cooldown/bounty_boss/barricade,
	)

/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/bounty_build_outfit(zone)
	return boss_supplies(bounty_outfit_instance(/datum/outfit/bounty_boss/heavy))

/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss_gear_text()
	if(istype(wear_suit, BOUNTY_HEAVY_COAT))
		return "[p_Their()] coat and hood are lined with reflective panels."
	return "[p_They()] [p_are()] in heavy armour."

// Out where the air kills: a black armoured space suit and helmet (its coat and hood hold no pressure)
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/bounty_sealed_gear()
	return list(/obj/item/clothing/suit/space/syndicate/black, /obj/item/clothing/head/helmet/space/syndicate/black)
// Its rounds chip through a window or grille it may break, and fly over a gap
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss_goes_through(atom/barrier)
	if(..())
		return TRUE
	if(isturf(barrier))
		return !barrier.density
	return (istype(barrier, /obj/structure/window) || istype(barrier, /obj/structure/grille)) && boss_may_break(barrier)

// With its burst ready and a belt in its gun
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss_breaks_through_now(atom/barrier)
	if(..())
		return TRUE
	var/obj/item/gun/gun = boss_gun()
	if(!gun?.can_shoot() || isnull(boss_ability_off_cooldown(/datum/action/cooldown/mob_cooldown/bounty_boss/burst)))
		return FALSE
	if(isturf(barrier))
		return !barrier.density
	return (istype(barrier, /obj/structure/window) || istype(barrier, /obj/structure/grille)) && boss_may_break(barrier)

// The L6 has no sling and won't holster, so it is in hand from the start, its other hand free to fire it.
// A spare box rides in the bag; a barrier grenade in each pocket. The coat's hood goes up as it is put on
// (tg's hooded suits do that), so its own reflecting hood covers its head (C8).
/datum/outfit/bounty_boss/heavy
	name = "Bounty mini-boss: Heavy"
	uniform = /obj/item/clothing/under/syndicate/combat
	suit = BOUNTY_HEAVY_COAT
	gloves = /obj/item/clothing/gloves/combat
	shoes = /obj/item/clothing/shoes/jackboots
	r_hand = BOUNTY_HEAVY_GUN
	l_pocket = /obj/item/grenade/barrier/bounty_boss
	r_pocket = /obj/item/grenade/barrier/bounty_boss
	back = /obj/item/storage/backpack
	backpack_contents = list(BOUNTY_HEAVY_SPARE_AMMO = 1)

/// The belt-fed gun it holds, if it holds one
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/proc/boss_gun()
	for(var/obj/item/gun/ballistic/automatic/l6_saw/gun in held_items)
		return gun
	return null

/**
 * Whether `gun` is the only thing in its hands. tg fires a heavy gun only with the other hand empty,
 * whichever hand is active now: the gun may sit in either, and is made the active one to fire.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/proc/boss_hands_free_for(obj/item/gun/gun)
	for(var/obj/item/held in held_items)
		if(held != gun)
			return FALSE
	return !isnull(gun) && is_holding(gun)

/// A barrier grenade it carries, not yet thrown
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/proc/boss_barrier()
	for(var/obj/item/grenade/barrier/bounty_boss/barrier in get_all_contents_type(/obj/item/grenade/barrier/bounty_boss))
		if(!barrier.active && (is_holding(barrier) || human_npc_can_draw(src, barrier)))
			return barrier
	return null

// Its gun's belt runs out: it changes it the way a player does (bounty_heavy_reload), if it has a spare.
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss_gear_plan(datum/ai_controller/controller)
	if(world.time < controller.blackboard[BB_HUMAN_NPC_ARMING_RETRY_AT] || HAS_TRAIT(src, TRAIT_HANDS_BLOCKED))
		return FALSE
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = boss_gun()
	if(isnull(gun) || (gun.can_shoot() && !gun.cover_open))
		return FALSE
	if(!gun.cover_open && isnull(human_npc_find_ammo(src, gun)))
		return FALSE
	controller.queue_behavior(/datum/ai_behavior/bounty_heavy_reload)
	return TRUE

// A hit while it aims spoils the burst (CB-13).
/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss_took_damage(damage, damagetype)
	var/datum/action/cooldown/mob_cooldown/bounty_boss/burst/aiming = boss_winding()
	if(!istype(aiming) || damage < BOUNTY_HEAVY_FUMBLE_DAMAGE)
		return
	visible_message(span_warning("[src] fumbles the shot."))
	boss_interrupt()

/**
 * Changes the belt in its L6 the way a player does, one step per action: open the feed cover, pull
 * the empty box with its free hand and let it fall, take the spare from its bag, click the gun with it,
 * close the cover. tg's own sounds and procs throughout. Gives up after a while and fights on.
 */
/datum/ai_behavior/bounty_heavy_reload
	action_cooldown = 0.8 SECONDS

/datum/ai_behavior/bounty_heavy_reload/setup(datum/ai_controller/controller)
	. = ..()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/heavy = controller.pawn
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = istype(heavy) ? heavy.boss_gun() : null
	if(isnull(gun))
		return FALSE
	controller.set_blackboard_key(BB_BOUNTY_BOSS_RELOAD_UNTIL, world.time + 12 SECONDS)
	if(!gun.cover_open)
		heavy.visible_message(span_notice("[heavy] flips open the feed cover on [gun]."))

/datum/ai_behavior/bounty_heavy_reload/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/heavy = controller.pawn
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = istype(heavy) ? heavy.boss_gun() : null
	if(isnull(gun) || world.time >= controller.blackboard[BB_BOUNTY_BOSS_RELOAD_UNTIL] || HAS_TRAIT(heavy, TRAIT_HANDS_BLOCKED))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	if(heavy.next_move > world.time)
		return AI_BEHAVIOR_DELAY
	var/obj/item/spent = human_npc_spent_ammo_in_hand(heavy, gun)
	if(spent)
		heavy.dropItemToGround(spent, force = TRUE)
		return AI_BEHAVIOR_DELAY
	if(gun.magazine && gun.can_shoot())
		if(gun.cover_open)
			gun.click_alt(heavy)
			return AI_BEHAVIOR_DELAY
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED
	if(!gun.cover_open)
		gun.click_alt(heavy)
		return AI_BEHAVIOR_DELAY
	if(gun.magazine)
		// The empty box comes out into its free hand.
		if(!human_npc_ready_empty_hand(heavy))
			return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
		controller.ai_interact(target = gun, combat_mode = FALSE)
		return AI_BEHAVIOR_DELAY
	var/obj/item/ammo = human_npc_find_ammo(heavy, gun)
	if(isnull(ammo))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	if(!heavy.is_holding(ammo))
		if(!human_npc_take_in_hand(heavy, ammo))
			return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
		return AI_BEHAVIOR_DELAY
	if(!human_npc_ready_item(heavy, ammo))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	controller.ai_interact(target = gun, combat_mode = FALSE)
	return AI_BEHAVIOR_DELAY

/datum/ai_behavior/bounty_heavy_reload/finish_action(datum/ai_controller/controller, succeeded)
	. = ..()
	controller.clear_blackboard_key(BB_BOUNTY_BOSS_RELOAD_UNTIL)
	if(succeeded)
		return
	// A change that got nowhere: the cover goes back down and it fights on with what it has for a while.
	controller.set_blackboard_key(BB_HUMAN_NPC_ARMING_RETRY_AT, world.time + 10 SECONDS)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/heavy = controller.pawn
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = istype(heavy) ? heavy.boss_gun() : null
	if(gun?.cover_open)
		gun.click_alt(heavy)

/**
 * Suppressive burst: the gun spins up with a whirr, a red laser sight settles on the target's tile
 * and a red cone shows on the floor, staying there until the last round (L3). Then it pulls the
 * trigger of the real gun it holds BOUNTY_HEAVY_BURST_SHOTS times over BOUNTY_HEAVY_BURST_TIME, at the
 * far edge of the cone where it aimed, not where the target went (CB-13). Real rounds from its real
 * belt: when the belt runs dry the burst stops and it changes belts. It holds its fire for a round
 * with one of its own side in the way. A hit while it aims spoils the burst (boss_took_damage()).
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/burst
	name = "Suppressive Burst"
	desc = "Spin up and hose a cone with rounds."
	cooldown_time = BOUNTY_HEAVY_BURST_COOLDOWN
	windup = BOUNTY_HEAVY_BURST_WINDUP
	effect_time = BOUNTY_HEAVY_BURST_TIME
	/// Where it aimed, from the telegraph
	var/turf/aim_turf
	var/aim_angle = 0
	/// Rounds left in the burst under way
	var/shots_left = 0

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/Destroy()
	aim_turf = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/worth_using(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss = owner
	if(!aimable(target) || !istype(boss))
		return FALSE
	var/obj/item/gun/gun = boss.boss_gun()
	// Its gun loaded, its other hand free to fire it.
	if(isnull(gun) || !gun.can_shoot() || !boss.boss_hands_free_for(gun))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 2 && distance <= BOUNTY_HEAVY_BURST_RANGE && can_see(owner, target, BOUNTY_HEAVY_BURST_RANGE) && landing_ok(target)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/telegraph(atom/target)
	aim_turf = get_turf(target)
	var/turf/origin = get_turf(owner)
	if(!aim_turf || !origin || aim_turf == origin)
		return
	aim_angle = get_angle(origin, aim_turf)
	owner.visible_message(span_boldwarning("[owner] spins up [owner.p_their()] gun, and a red laser dot settles on the floor by [target]!"))
	playsound(owner, 'sound/items/weapons/gun/l6/l6_rack.ogg', 70, TRUE)
	playsound(owner, 'sound/items/weapons/scope.ogg', 50, TRUE)
	add_telegraph(owner.Beam(aim_turf, icon_state = "r_beam", time = windup, maxdistance = BOUNTY_HEAVY_BURST_RANGE + 1))
	mark_turfs(cone_turfs(target, BOUNTY_HEAVY_BURST_RANGE, BOUNTY_HEAVY_BURST_ARC + BOUNTY_HEAVY_BURST_MARK_MARGIN), "#ff2020", linger = BOUNTY_HEAVY_BURST_TIME)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/effect(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || !aim_turf)
		return
	shots_left = BOUNTY_HEAVY_BURST_SHOTS
	boss.visible_message(span_danger("[boss] opens fire!"))
	var/serial = boss.boss_set_busy("burst", effect_time + 1 SECONDS)
	fire_round(serial)

/// Where one round goes: a tile at the cone's far edge, somewhere within its arc
/datum/action/cooldown/mob_cooldown/bounty_boss/burst/proc/round_spot()
	var/turf/origin = get_turf(owner)
	if(!origin)
		return null
	var/angle = aim_angle + rand(-BOUNTY_HEAVY_BURST_ARC / 2, BOUNTY_HEAVY_BURST_ARC / 2)
	return locate(
		clamp(origin.x + round(BOUNTY_HEAVY_BURST_RANGE * sin(angle)), 1, world.maxx),
		clamp(origin.y + round(BOUNTY_HEAVY_BURST_RANGE * cos(angle)), 1, world.maxy),
		origin.z,
	)

/// One pull of the trigger, and the next after it
/datum/action/cooldown/mob_cooldown/bounty_boss/burst/proc/fire_round(serial)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss = owner
	if(!istype(boss) || !boss.boss_still("burst", serial) || shots_left <= 0 || !aim_turf)
		end_burst(serial)
		return
	var/obj/item/gun/gun = boss.boss_gun()
	if(isnull(gun) || !gun.can_shoot())
		// Out of belt: it changes it on its next plan.
		end_burst(serial)
		return
	shots_left--
	var/turf/spot = round_spot()
	if(spot && !human_npc_ally_in_line(boss, spot) && boss.boss_hands_free_for(gun) && human_npc_ready_item(boss, gun))
		boss.ai_controller?.ai_interact(target = spot, combat_mode = TRUE)
	if(shots_left <= 0)
		end_burst(serial)
		return
	addtimer(CALLBACK(src, PROC_REF(fire_round), serial), max(2, round(BOUNTY_HEAVY_BURST_TIME / BOUNTY_HEAVY_BURST_SHOTS)), TIMER_DELETE_ME)

/datum/action/cooldown/mob_cooldown/bounty_boss/burst/proc/end_burst(serial)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	shots_left = 0
	aim_turf = null
	if(istype(boss) && boss.boss_busy == "burst" && boss.boss_busy_serial == serial)
		boss.boss_clear_busy(serial)

/**
 * Barricade: it unslings a folded barrier, arms a real barrier grenade it carries and tosses it onto
 * the tile in front of it, toward its target (CB-26). The grenade opens into the Heavy's folding barrier
 * (/obj/structure/barricade/security/bounty_boss). It keeps BOUNTY_BOSS_BARRICADES_PER_BOSS standing;
 * each folds away after BOUNTY_BOSS_BARRICADE_LIFE. Two grenades, two barriers: then it has none left.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade
	name = "Deploy Barricade"
	desc = "Toss a barrier grenade in front of you."
	cooldown_time = BOUNTY_HEAVY_BARRICADE_COOLDOWN
	windup = BOUNTY_HEAVY_BARRICADE_WINDUP
	/// Where it will stand, from the telegraph
	var/turf/barricade_spot
	/// Weakrefs to its barriers still standing, oldest first
	var/list/barriers = list()

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/Destroy()
	barricade_spot = null
	barriers = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/worth_using(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss = owner
	if(!aimable(target) || !istype(boss) || length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return FALSE
	if(isnull(boss.boss_barrier()) || !length(boss.get_empty_held_indexes()))
		return FALSE
	var/distance = get_dist(owner, target)
	return distance >= 3 && distance <= 9 && !isnull(find_spot(target))

/// The open tile in front of it toward `target`, on its site, with no barrier on it
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/proc/find_spot(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss))
		return null
	var/turf/spot = get_step(boss, get_dir(boss, target))
	if(!isopenturf(spot) || isgroundlessturf(spot) || islava(spot) || ischasm(spot) || spot.is_blocked_turf())
		return null
	if(!boss.boss_environment_allowed(spot) || (locate(/obj/structure/barricade) in spot))
		return null
	return spot

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/telegraph(atom/target)
	barricade_spot = find_spot(target)
	owner.visible_message(span_boldwarning("[owner] unslings a folded barrier."))
	playsound(owner, 'sound/items/deconstruct.ogg', 50, TRUE)
	if(barricade_spot)
		mark_turfs(list(barricade_spot), "#c0c0c0")

/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/effect(atom/target)
	var/turf/spot = barricade_spot
	barricade_spot = null
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/boss = owner
	if(!istype(boss) || !spot || spot.is_blocked_turf() || (locate(/obj/structure/barricade) in spot) || !boss.boss_environment_allowed(spot))
		return
	if(length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return
	var/obj/item/grenade/barrier/bounty_boss/grenade = boss.boss_barrier()
	if(isnull(grenade) || !human_npc_take_in_hand(boss, grenade) || !human_npc_ready_item(boss, grenade))
		return
	grenade.ability_ref = WEAKREF(src)
	// The player's way: pull the pin in hand, then throw it.
	grenade.attack_self(boss)
	boss.throw_mode_on(THROW_MODE_TOGGLE)
	if(!boss.throw_item(spot))
		boss.throw_mode_off(THROW_MODE_TOGGLE)
		boss.dropItemToGround(grenade)

/// One of its barriers went up: it keeps count of it
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/proc/note_barrier(obj/structure/barricade/security/bounty_boss/barrier)
	if(QDELETED(barrier))
		return
	barriers += WEAKREF(barrier)
	prune_barriers()

/// Forgets barriers that are gone, and folds up the oldest past BOUNTY_BOSS_BARRICADES_PER_BOSS
/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/proc/prune_barriers()
	for(var/datum/weakref/ref as anything in barriers.Copy())
		if(QDELETED(ref.resolve()))
			barriers -= ref
	while(length(barriers) > BOUNTY_BOSS_BARRICADES_PER_BOSS)
		var/datum/weakref/oldest = barriers[1]
		barriers.Cut(1, 2)
		var/obj/structure/barricade/security/bounty_boss/barrier = oldest.resolve()
		barrier?.fold_away()

/**
 * The Heavy's barrier grenades: tg's barrier grenade on a short fuse, that opens into its folding
 * barrier instead of a standing one. Issued as a consumable (it may leave the Heavy's body, thrown, but
 * in anyone else's hands it is gone).
 */
/obj/item/grenade/barrier/bounty_boss
	det_time = BOUNTY_HEAVY_BARRIER_FUSE
	/// The Heavy's barricade ability that threw it, to count the barrier it makes
	var/datum/weakref/ability_ref

/obj/item/grenade/barrier/bounty_boss/Destroy()
	ability_ref = null
	return ..()

// tg's barrier grenade, but what it makes is the folding barrier (and only ever the one).
/obj/item/grenade/barrier/bounty_boss/detonate(mob/living/lanced_by)
	if(dud_flags)
		active = FALSE
		update_appearance()
		return FALSE
	dud_flags |= GRENADE_USED
	SEND_SIGNAL(src, COMSIG_GRENADE_DETONATE, lanced_by)
	var/turf/spot = get_turf(src)
	if(spot && !(locate(/obj/structure/barricade) in spot))
		var/obj/structure/barricade/security/bounty_boss/barrier = new(spot)
		if(!QDELETED(barrier))
			spot.visible_message(span_warning("[src] snaps open into a barrier."))
			playsound(spot, 'sound/effects/bang.ogg', 50, TRUE)
			var/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/ability = ability_ref?.resolve()
			ability?.note_barrier(barrier)
	qdel(src)
	return TRUE

/// The Heavy's folding barrier: tg's security barrier that folds itself away after BOUNTY_BOSS_BARRICADE_LIFE. Drops nothing.
/obj/structure/barricade/security/bounty_boss
	name = "folding barrier"
	desc = "A folding barrier. It will fold itself back up before long."
	proj_pass_rate = BOUNTY_HEAVY_BARRICADE_PASS

/obj/structure/barricade/security/bounty_boss/Initialize(mapload)
	. = ..()
	if(length(GLOB.bounty_boss_barricades) >= BOUNTY_BOSS_BARRICADE_CAP)
		return INITIALIZE_HINT_QDEL
	GLOB.bounty_boss_barricades += src
	addtimer(CALLBACK(src, PROC_REF(fold_away)), BOUNTY_BOSS_BARRICADE_LIFE, TIMER_DELETE_ME)

/obj/structure/barricade/security/bounty_boss/Destroy()
	GLOB.bounty_boss_barricades -= src
	return ..()

/obj/structure/barricade/security/bounty_boss/proc/fold_away()
	if(QDELETED(src))
		return
	visible_message(span_notice("[src] folds itself up and falls apart."))
	qdel(src)
