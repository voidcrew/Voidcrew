/**
 * # Bounty hunting: a criminal's companions
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * What it owns: /mob/living/carbon/human/npc/bounty_companion (its built-in values, its outfit and its
 * AI), bounty_spawn_companion() and spawn_companions(). Companions (0-2, spec C7) keep a criminal
 * company: they sit at the bar with them (a real chair and a real glass), take turns in their talk, sit
 * round their camp, and fight beside them with a style of their own: a real weapon they carry and draw
 * (bounty_styles.dm). They are real human bodies (CR-11): a person's health and stamina, toughness 1,
 * no multipliers. The AI is the trooper's peaceful pattern: retaliation, then calling the rest of the
 * gang in, then the attack, then going to whoever called. Badly hurt, a companion may run; when their
 * criminal goes down, is cuffed or gives up, each may run; up from a real stamina crit with hunters
 * around, it gives up (tg's *surrender) or runs. It gives up the way its criminal does
 * (/datum/human_npc_surrender/bounty).
 *
 * They are not bounties, pay nothing and drop nothing (their kit is locked to them, D3). P5 deletes
 * them when the posting closes; deleting one at any time is safe.
 *
 * Who they are (A1): people of every species criminals come from (GLOB.bounty_species_weights), in rough
 * clothes picked by their criminal's site (bounty_company_clothes()), and dressed for what their criminal
 * was dressed for, so they are sealed up wherever it is (bounty_suits.dm). They are made with their
 * criminal's spawn context (/datum/npc_spawn_context/bounty_company), which is how they know all that
 * before they are dressed.
 *
 * The shared vars are declared in bounty_types.dm and nowhere else (leader_ref); the rest here
 * have an `ai_` prefix.
 */

/mob/living/carbon/human/npc/bounty_companion
	name = "associate"
	faction = list(FACTION_HOSTILE)
	ai_controller = /datum/ai_controller/basic_controller/bounty/companion
	npc_outfit_table = /datum/human_npc_outfit_table/bounty
	npc_surrender = /datum/human_npc_surrender/bounty
	// They stop once their target is down, as their criminal does (spec C4)
	npc_target_stat = HUMAN_NPC_SPARES_DOWNED
	// A person's toughness: no multipliers (CR-11)
	npc_damage_taken = 1
	/// Their fighting style (BOUNTY_STYLE_*), picked when they are dressed
	var/ai_style
	/// Ran off: out of it for good
	var/ai_fled = FALSE
	/// The one roll to run when badly hurt has been made
	var/ai_flee_rolled = FALSE
	/// In the fight now (weapon out, at a run)
	var/ai_in_fight = FALSE
	/// Went into a real stamina crit, and hasn't decided yet what to do about it
	var/ai_stamcritted = FALSE
	/// Their glass at the bar
	var/obj/item/reagent_containers/cup/glass/drinkingglass/ai_drink
	/// Weakref to the seat they sat on
	var/datum/weakref/ai_seat_ref
	/// Sitting on the floor (tg's resting, of their own choosing)
	var/ai_crouching = FALSE
	/// Where they mean to be while nothing is happening, and when that is next thought about
	var/turf/ai_idle_spot
	var/ai_next_idle_think = 0
	/// world.time of their next word in the conversation
	var/ai_next_reply = 0
	/// BOUNTY_PLACEMENT_* of their criminal's site, known as they are made (Initialize()), or null
	var/company_site_kind
	/// The /datum/outfit their rough clothes came from (bounty_site_clothes()), or null for their plain ones
	var/company_clothes

/mob/living/carbon/human/npc/bounty_companion/Initialize(mapload, datum/human_npc_order/order)
	// Before the base dresses them: where their criminal is, and what it was dressed for, so they are too
	var/datum/npc_spawn_context/bounty_company/company = order?.context
	var/mob/living/carbon/human/npc/bounty_criminal/leader = istype(company) ? company.company_leader_ref?.resolve() : null
	if(!QDELETED(leader))
		company_site_kind = leader.posting()?.placement_kind
		npc_always_site |= leader.npc_site
	else
		npc_always_site |= bounty_site_dress_for(order?.context)
	company_site_kind ||= bounty_site_kind_of(order?.context)
	return ..()

/mob/living/carbon/human/npc/bounty_companion/Destroy()
	ai_let_go()
	ai_idle_spot = null
	leader_ref = null
	return ..()

/mob/living/carbon/human/npc/bounty_companion/death(gibbed)
	ai_let_go()
	return ..()

/**
 * What they wear: plain clothes for the zone they are made in, their style's weapon (never a Wanted
 * criminal's heavier one) and its spares, and a bruise pack. The style is picked here, as they are
 * dressed, so the weapon they carry is the one they fight with.
 */
/mob/living/carbon/human/npc/bounty_companion/bounty_build_outfit(zone)
	ai_style ||= pick_weight(list(
		BOUNTY_STYLE_BRAWLER = 3,
		BOUNTY_STYLE_KNIFE = 2,
		BOUNTY_STYLE_CLUB = 2,
		BOUNTY_STYLE_PISTOL = 1,
		BOUNTY_STYLE_BOTTLE = 1,
		BOUNTY_STYLE_SHOTGUN = 1,
		BOUNTY_STYLE_SMG = 1,
		BOUNTY_STYLE_REVOLVER = 1,
	))
	return bounty_fighter_outfit(BOUNTY_ARCHETYPE_NORMAL, zone, BOUNTY_TIER_PETTY, ai_style, FALSE, /obj/item/stack/medical/bruise_pack)

// Someone of any species a criminal can be, with a face from the criminals' own look builder and a name of their species
/mob/living/carbon/human/npc/bounty_companion/npc_apply_random_look()
	var/species = bounty_company_species()
	npc_apply_bounty_look(bounty_roll_look(species, pick(MALE, FEMALE)))
	real_name = generate_random_name_species_based(gender, TRUE, dna.species.type)
	name = real_name

/// A species for a companion, weighted as for criminals (GLOB.bounty_species_weights)
/proc/bounty_company_species()
	return pick_weight(GLOB.bounty_species_weights)

// Their plain clothes give way to rough ones picked by their criminal's site
/mob/living/carbon/human/npc/bounty_companion/bounty_site_clothes(outfit)
	var/list/choices = bounty_company_clothes(company_site_kind)
	if(!length(choices) || isnull(outfit))
		return outfit
	company_clothes = pick_weight(choices)
	return bounty_wear_clothes_of(outfit, company_clothes)

/**
 * Rough clothes for a criminal's company at a site of `site_kind` (BOUNTY_PLACEMENT_*), each a /datum/outfit
 * typepath => weight, so no two crews look alike; null where they keep their plain clothes for the zone.
 * Only the clothes are taken from these (bounty_wear_clothes_of()), never what they carry.
 */
/proc/bounty_company_clothes(site_kind)
	switch(site_kind)
		if(BOUNTY_PLACEMENT_NPC_SHIP)
			return list(
				/datum/outfit/outpost_off_duty_pirate = 1,
				/datum/outfit/bounty_criminal/hauler = 1,
				/datum/outfit/bounty_criminal/tough = 1,
				/datum/outfit/bounty_criminal/drifter = 1,
			)
		if(BOUNTY_PLACEMENT_PLANET, BOUNTY_PLACEMENT_RUIN)
			return list(
				/datum/outfit/hermit/survivor = 2,
				/datum/outfit/bounty_criminal/spacer = 1,
				/datum/outfit/bounty_criminal/hauler = 1,
				/datum/outfit/bounty_criminal/drifter = 1,
				/datum/outfit/bounty_criminal/tough = 1,
			)
	return null

/**
 * `outfit` (a typepath or an instance) in the clothes of `clothes_type`: its uniform, suit, hat, mask,
 * glasses, gloves, shoes and neck, empty where that outfit leaves them empty. Weapons, bags, belts, pockets
 * and anything in hand stay as they were. Returns an instance (one passed in is changed in place).
 */
/proc/bounty_wear_clothes_of(outfit, datum/outfit/clothes_type)
	var/datum/outfit/dressed = ispath(outfit, /datum/outfit) ? new outfit() : outfit
	if(!istype(dressed) || !ispath(clothes_type, /datum/outfit))
		return outfit
	dressed.uniform = initial(clothes_type.uniform)
	dressed.suit = initial(clothes_type.suit)
	dressed.head = initial(clothes_type.head)
	dressed.mask = initial(clothes_type.mask)
	dressed.glasses = initial(clothes_type.glasses)
	dressed.gloves = initial(clothes_type.gloves)
	dressed.shoes = initial(clothes_type.shoes)
	dressed.neck = initial(clothes_type.neck)
	return dressed

/// Their criminal, if still around
/mob/living/carbon/human/npc/bounty_companion/proc/ai_leader()
	var/mob/living/carbon/human/npc/bounty_criminal/leader = leader_ref?.resolve()
	return QDELETED(leader) ? null : leader

/**
 * Whether they can still fight: awake, out of crit, on their feet (a knockdown is a cuff window, H2),
 * free, not giving up and not run off. All read from tg.
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_can_fight()
	if(stat != CONSCIOUS || ai_fled || npc_surrendering || HAS_TRAIT(src, TRAIT_CRITICAL_CONDITION) || HAS_TRAIT(src, TRAIT_RESTRAINED))
		return FALSE
	return !HAS_TRAIT(src, TRAIT_INCAPACITATED) && !HAS_TRAIT(src, TRAIT_FLOORED)

/**
 * Joins `leader`: their faction, the style they were dressed for, and a place on the criminal's and
 * the posting's list of companions (whoever spawned them). Called by bounty_spawn_companion().
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_join(mob/living/carbon/human/npc/bounty_criminal/leader)
	if(QDELETED(leader))
		return FALSE
	leader_ref = WEAKREF(leader)
	faction = leader.faction.Copy()
	ai_controller?.set_blackboard_key(BB_BOUNTY_LEADER, leader)
	bounty_ai_apply_style(src, ai_style || BOUNTY_STYLE_BRAWLER)
	var/datum/weakref/our_ref = WEAKREF(src)
	leader.companions |= our_ref
	var/datum/criminal_bounty/posting = leader.posting()
	if(posting)
		posting.companions |= our_ref
	bounty_ai_set_pace(src, BOUNTY_CALM_SPEED)
	return TRUE

/// Called in by their criminal: `target` is theirs to fight too
/mob/living/carbon/human/npc/bounty_companion/proc/ai_join_fight(mob/living/target)
	if(!ai_can_fight() || !isliving(target) || QDELETED(ai_controller) || bounty_ai_same_gang(src, target))
		return
	ai_mark_enemy(target)
	var/mob/living/carbon/human/npc/bounty_criminal/leader = ai_leader()
	if(leader && get_dist(src, leader) > 4)
		ai_controller.set_blackboard_key(BB_BASIC_MOB_REINFORCEMENT_TARGET, leader)
	ai_enter_fight()

/// Up from their seat, drink down, at a run. The weapon comes out through the arm subtree (bounty_styles.dm).
/mob/living/carbon/human/npc/bounty_companion/proc/ai_enter_fight()
	if(ai_in_fight)
		return
	ai_in_fight = TRUE
	ai_put_drink_away()
	ai_stand_up()
	bounty_ai_set_pace(src, BOUNTY_RUN_SPEED)

/// The fight is over for them: weapon away, at a walk
/mob/living/carbon/human/npc/bounty_companion/proc/ai_leave_fight()
	if(!ai_in_fight)
		return
	ai_in_fight = FALSE
	bounty_ai_set_pace(src, BOUNTY_CALM_SPEED)
	bounty_ai_holster(src)

/// Their criminal is down, cuffed or gave up: half the time they run for it
/mob/living/carbon/human/npc/bounty_companion/proc/ai_lose_heart()
	if(!ai_can_fight() || !prob(50))
		return
	var/mob/living/threat = ai_controller?.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	ai_run_off(isliving(threat) ? threat : null)

/// Runs off, out of the fight for good
/mob/living/carbon/human/npc/bounty_companion/proc/ai_run_off(mob/living/threat)
	if(ai_fled || stat != CONSCIOUS)
		return
	ai_fled = TRUE
	ai_let_go()
	bounty_ai_holster(src)
	bounty_ai_set_pace(src, BOUNTY_RUN_SPEED)
	visible_message(span_notice("[src] backs off and runs for it."))
	if(QDELETED(ai_controller))
		return
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_RETALIATE_LIST)
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_REINFORCEMENT_TARGET)
	if(threat)
		ai_controller.set_blackboard_key(BB_BASIC_MOB_FLEE_TARGET, bounty_ai_target_for(threat))
	ai_controller.CancelActions()

/// They gave up (tg's *surrender, through the human NPC base): the fight dropped
/mob/living/carbon/human/npc/bounty_companion/proc/ai_on_surrendered()
	visible_message(span_notice("[src] puts [p_their()] hands up."))
	ai_let_go()
	if(QDELETED(ai_controller))
		return
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_RETALIATE_LIST)

/**
 * Up from a real stamina crit (CR-11): with hunters around, they give up (tg's *surrender) or run;
 * with nobody about, they get back to it.
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_after_stamcrit()
	ai_stamcritted = FALSE
	if(!ai_can_fight())
		return
	var/datum/human_npc_surrender/rules = npc_surrender_rules()
	var/list/hostiles = rules?.hostiles_near(src)
	if(!length(hostiles))
		return
	if(prob(BOUNTY_COMPANION_GIVE_UP_CHANCE) && npc_surrender())
		return
	ai_run_off(get_closest_atom(/mob/living, hostiles, src))

/**
 * `enemy` is someone to fight: onto their retaliation list, and the mech they sit in with them (H4:
 * the targeting takes the mech while they are in it, and them once they climb out).
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_mark_enemy(mob/living/enemy)
	if(QDELETED(ai_controller) || !isliving(enemy))
		return
	ai_controller.insert_blackboard_key_lazylist(BB_BASIC_MOB_RETALIATE_LIST, enemy)
	var/atom/vehicle = bounty_ai_target_for(enemy)
	if(vehicle != enemy)
		ai_controller.insert_blackboard_key_lazylist(BB_BASIC_MOB_RETALIATE_LIST, vehicle)

/**
 * Attacked: they take the attacker on (their own retaliation, fed by the controller's attack hooks
 * rather than tg's element, so friendly fire can be left out) and their criminal hears of it. A stray
 * blow from their own side of the site with nobody playing it is let go (M1). Knocked down, they
 * still remember who did it, and fight once up.
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_attacked_by(mob/living/attacker)
	if(stat == DEAD || ai_fled || !isliving(attacker) || bounty_ai_same_gang(src, attacker))
		return
	if(bounty_ai_friendly_fire(src, attacker))
		return
	ai_mark_enemy(attacker)
	if(ai_can_fight())
		ai_enter_fight()
	ai_leader()?.ai_ally_attacked(attacker)

/// They took a hit: badly hurt (a person's health, read after the hit), they may run (one roll)
/mob/living/carbon/human/npc/bounty_companion/proc/ai_took_damage(damage, damagetype)
	if(ai_flee_rolled || damage <= 0 || !ai_can_fight() || !(damagetype in list(BRUTE, BURN)))
		return
	if(health > maxHealth * BOUNTY_COMPANION_FLEE_BELOW)
		return
	ai_flee_rolled = TRUE
	if(prob(BOUNTY_COMPANION_FLEE_CHANCE))
		var/mob/living/threat = ai_controller?.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
		INVOKE_ASYNC(src, PROC_REF(ai_run_off), isliving(threat) ? threat : null)

/// Everything down: drink, seat or the floor. What they hold stays held (D3).
/mob/living/carbon/human/npc/bounty_companion/proc/ai_let_go()
	ai_put_drink_away()
	ai_stand_up()

/// Sits on `seat` from its tile: buckled to it, as anyone sitting down is
/mob/living/carbon/human/npc/bounty_companion/proc/ai_sit_on(obj/structure/chair/seat)
	if(QDELETED(seat) || loc != seat.loc || (seat.has_buckled_mobs() && buckled != seat))
		return FALSE
	if(buckled == seat)
		return TRUE
	ai_stand_up()
	if(!seat.buckle_mob(src, force = TRUE))
		return FALSE
	ai_seat_ref = WEAKREF(seat)
	return TRUE

/// Sits down on the ground: tg's resting
/mob/living/carbon/human/npc/bounty_companion/proc/ai_crouch()
	if(ai_crouching || buckled || resting)
		return
	ai_crouching = TRUE
	set_resting(TRUE, silent = TRUE)

/// Up from a seat they sat on themselves, or the floor they lay down on themselves
/mob/living/carbon/human/npc/bounty_companion/proc/ai_stand_up()
	if(ai_crouching)
		ai_crouching = FALSE
		if(resting)
			set_resting(FALSE, silent = TRUE)
	var/obj/structure/chair/seat = ai_seat_ref?.resolve()
	ai_seat_ref = null
	if(seat && buckled == seat)
		seat.unbuckle_mob(src, force = TRUE)

/// A glass of something poured into a free hand
/mob/living/carbon/human/npc/bounty_companion/proc/ai_take_drink()
	if(!QDELETED(ai_drink) && is_holding(ai_drink))
		return ai_drink
	ai_drink = bounty_ai_pour_drink(src)
	return ai_drink

/// The glass goes: on the table beside them if there is one, else it is gone (M4, L7)
/mob/living/carbon/human/npc/bounty_companion/proc/ai_put_drink_away()
	if(QDELETED(ai_drink))
		ai_drink = null
		return
	var/obj/item/glass = ai_drink
	ai_drink = null
	var/obj/structure/table/table = locate() in range(1, src)
	if(stat == CONSCIOUS && bounty_ai_set_glass_down(src, glass, table))
		return
	qdel(glass)

/**
 * Where they mean to be while nothing is happening, thought about every few seconds rather than
 * every plan: beside their criminal when they talk, on a seat near them at the bar, beside the fire
 * at the camp, otherwise within BOUNTY_COMPANION_FOLLOW of them. Null means right where they are.
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_pick_idle_spot(mob/living/carbon/human/npc/bounty_criminal/leader)
	var/datum/bounty_activity/activity = leader.ai_activity
	if(istype(activity, /datum/bounty_activity/chat))
		var/datum/bounty_activity/chat/talk = activity
		if(talk.partner() == src)
			return get_dist(src, leader) <= 1 ? null : ai_free_tile_near(leader, 1)
	if(istype(leader.buckled, /obj/structure/chair))
		var/obj/structure/chair/seat = ai_seat_ref?.resolve()
		if(seat && buckled == seat)
			return null
		for(var/obj/structure/chair/other_seat in range(2, leader))
			if(other_seat == leader.buckled || other_seat.has_buckled_mobs() || !isturf(other_seat.loc) || (locate(/mob/living) in other_seat.loc))
				continue
			return other_seat.loc
	if(istype(activity, /datum/bounty_activity/camp))
		var/atom/fire = leader.ai_camp_fire()
		if(fire)
			return get_dist(src, fire) <= 1 ? null : ai_free_tile_near(fire, 1)
	if(get_dist(src, leader) <= BOUNTY_COMPANION_FOLLOW)
		return null
	return ai_free_tile_near(leader, BOUNTY_COMPANION_FOLLOW)

/// The nearest free tile within `distance` of `thing` (not its own), on their criminal's site
/mob/living/carbon/human/npc/bounty_companion/proc/ai_free_tile_near(atom/thing, distance)
	var/turf/center = get_turf(thing)
	var/mob/living/carbon/human/npc/bounty_criminal/leader = ai_leader()
	if(!center)
		return null
	var/turf/best
	var/best_distance = INFINITY
	for(var/turf/tile as anything in RANGE_TURFS(distance, center))
		if(tile == center || !isopenturf(tile) || isspaceturf(tile) || islava(tile) || ischasm(tile))
			continue
		if(tile != loc && tile.is_blocked_turf(source_atom = src))
			continue
		if(leader && !leader.leash_ok(tile))
			continue
		var/from_us = get_dist(src, tile)
		if(from_us < best_distance)
			best = tile
			best_distance = from_us
	return best

/**
 * Hanging out with their criminal, about once a second: sat down where there is a seat (with a
 * drink at the bar, which they really drink now and then), sat by the fire at the camp, facing them,
 * and now and then a word back.
 */
/mob/living/carbon/human/npc/bounty_companion/proc/ai_hang_out()
	var/mob/living/carbon/human/npc/bounty_criminal/leader = ai_leader()
	if(!leader)
		return
	var/obj/structure/chair/seat = locate() in loc
	if(seat && istype(leader.buckled, /obj/structure/chair) && ai_sit_on(seat))
		if(QDELETED(ai_drink))
			ai_take_drink()
		else if(prob(5))
			bounty_ai_sip(src, ai_drink)
	else if(istype(leader.ai_activity, /datum/bounty_activity/camp))
		ai_crouch()
	if(!buckled && !resting && get_dist(src, leader) <= 3)
		face_atom(leader)
	if(world.time < ai_next_reply || leader.ai_mode != BOUNTY_AI_CALM || get_dist(src, leader) > 3)
		return
	ai_next_reply = world.time + rand(25, 50) SECONDS
	if(prob(50) && !istype(leader.ai_activity, /datum/bounty_activity/chat))
		INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), "companion_reply")

// ===== SPAWNING =====

/**
 * Queues one companion for `leader` at `where` (the human NPC spawn queue: never a room of humans in
 * one tick), who joins them as it is made: their faction, their side, their posting's list. Then
 * `on_spawned` is called with it. If the criminal is gone by then, the companion is not kept.
 * `immediate` builds it now (tests, admin tools). Returns the spawn order (qdel() cancels it). It is
 * made with its criminal's spawn context, so it is dressed for where they are.
 */
/proc/bounty_spawn_companion(mob/living/carbon/human/npc/bounty_criminal/leader, turf/where, datum/callback/on_spawned, immediate = FALSE)
	where = get_turf(where)
	if(QDELETED(leader) || !where)
		return null
	var/datum/npc_spawn_context/bounty_company/company = new(leader, null, "ordinary")
	company.company_leader_ref = WEAKREF(leader)
	return spawn_human_npc(/mob/living/carbon/human/npc/bounty_companion, where, CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(bounty_companion_spawned), WEAKREF(leader), on_spawned), context = company, immediate = immediate)

/**
 * A companion's spawn context: its criminal's own (the site, zone and source it inherits from the
 * criminal it is made from), and which criminal that is, for the companion to read as it is dressed.
 */
/datum/npc_spawn_context/bounty_company
	/// Weakref to the criminal the companion is made for
	var/datum/weakref/company_leader_ref

/datum/npc_spawn_context/bounty_company/Destroy()
	company_leader_ref = null
	return ..()

/**
 * Whether a criminal may hide aboard `npc_ship` (board_pick_npc_ship()): a crew of ordinary people, the
 * grey tide's salvagers, Interdyne's rogue researchers or a crew with no faction. Never a themed crew's
 * (skeletons, geodes, lizard nobles, knights, customs and the like).
 */
/proc/bounty_ship_hides_criminals(obj/structure/overmap/ship/npc/pirate/npc_ship)
	if(!istype(npc_ship))
		return FALSE
	return !npc_ship.pirate_faction || (npc_ship.pirate_faction in list("grey", "interdyne"))

/// A queued companion is made: it joins its criminal, or goes if its criminal is gone
/proc/bounty_companion_spawned(datum/weakref/leader_ref, datum/callback/on_spawned, mob/living/carbon/human/npc/bounty_companion/companion)
	var/mob/living/carbon/human/npc/bounty_criminal/leader = leader_ref?.resolve()
	if(QDELETED(companion))
		return
	if(QDELETED(leader) || !companion.ai_join(leader))
		qdel(companion)
		return
	on_spawned?.Invoke(companion)

// ===== THE CRIMINAL'S SIDE =====

/**
 * Spawns `count` companions (clamped to BOUNTY_COMPANIONS_MIN-BOUNTY_COMPANIONS_MAX) on free tiles
 * beside them, through the human NPC spawn queue (bounty_spawn_companion()). Each joins them, and their
 * posting, as it is made. Returns the companions already made: only with `immediate` (tests, admin
 * tools), otherwise an empty list.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/spawn_companions(count, immediate = FALSE)
	. = list()
	count = clamp(count, BOUNTY_COMPANIONS_MIN, BOUNTY_COMPANIONS_MAX)
	var/turf/home = get_turf(src)
	if(!home || count <= 0)
		return
	var/list/spots = list()
	for(var/turf/tile as anything in RANGE_TURFS(1, home))
		if(tile != home && ai_standable(tile))
			spots += tile
	if(length(spots) < count)
		for(var/turf/tile as anything in RANGE_TURFS(2, home))
			if(get_dist(tile, home) == 2 && ai_standable(tile))
				spots += tile
	for(var/i in 1 to count)
		if(!length(spots))
			break
		var/datum/human_npc_order/order = bounty_spawn_companion(src, pick_n_take(spots), null, immediate)
		var/mob/living/carbon/human/npc/bounty_companion/buddy = order?.spawned_ref?.resolve()
		if(!QDELETED(buddy))
			. += buddy

/**
 * One of their companions was attacked by `attacker`: it goes on their grudge list, and the gang
 * turns on them. Never while blended in (C1), and never over friendly fire (M1).
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_ally_attacked(mob/living/attacker)
	if(blended || !isliving(attacker) || bounty_ai_same_gang(src, attacker) || bounty_ai_friendly_fire(src, attacker))
		return
	ai_add_grudge(attacker)
	if(ai_can_act() && !hidden && ai_mode != BOUNTY_AI_FIGHTING && ai_mode != BOUNTY_AI_FLEEING)
		ai_react(attacker, null)
	ai_rally_companions(attacker)

// ===== AI =====

/**
 * A companion's controller: the trooper's peaceful pattern (retaliate, call the others in, attack by
 * style with the real weapon, go to whoever called), patching themselves up when it is quiet (N6), then
 * hanging out with their criminal. It gives up as its criminal does (human_npc_surrender).
 */
/datum/ai_controller/basic_controller/bounty/companion
	planning_subtrees = list(
		/datum/ai_planning_subtree/human_npc_soft_crit,
		/datum/ai_planning_subtree/bounty_escape_captivity,
		/datum/ai_planning_subtree/human_npc_walk_out,
		/datum/ai_planning_subtree/human_npc_surrender,
		/datum/ai_planning_subtree/bounty_companion_gate,
		/datum/ai_planning_subtree/flee_target/bounty,
		/datum/ai_planning_subtree/target_retaliate/bounty,
		/datum/ai_planning_subtree/call_reinforcements/bounty,
		/datum/ai_planning_subtree/bounty_arm,
		/datum/ai_planning_subtree/bounty_ranged,
		/datum/ai_planning_subtree/bounty_melee,
		/datum/ai_planning_subtree/travel_to_point/and_clear_target/reinforce/bounty,
		/datum/ai_planning_subtree/bounty_treat_self,
		/datum/ai_planning_subtree/bounty_companion_idle,
	)

/**
 * No tg retaliation element: the controller's own attack hooks (items, hands, mobs, mechs, shots,
 * throws) feed the retaliation list through ai_attacked_by(), which leaves friendly fire out (M1) and
 * takes a pilot's mech on with them (H4).
 */
/datum/ai_controller/basic_controller/bounty/companion/TryPossessPawn(atom/new_pawn)
	if(!istype(new_pawn, /mob/living/carbon/human/npc/bounty_companion))
		return AI_CONTROLLER_INCOMPATIBLE
	var/mob/living/carbon/human/npc/bounty_companion/companion = new_pawn
	RegisterSignal(companion, COMSIG_LIVING_ENTER_STAMCRIT, PROC_REF(on_stamcrit))
	RegisterSignal(companion, COMSIG_HUMAN_NPC_RECOVERED, PROC_REF(on_recovered))
	RegisterSignal(companion, COMSIG_HUMAN_NPC_SURRENDERED, PROC_REF(on_surrendered))
	return ..()

/datum/ai_controller/basic_controller/bounty/companion/UnpossessPawn(destroy)
	if(pawn)
		UnregisterSignal(pawn, list(COMSIG_LIVING_ENTER_STAMCRIT, COMSIG_HUMAN_NPC_RECOVERED, COMSIG_HUMAN_NPC_SURRENDERED))
	return ..()

/datum/ai_controller/basic_controller/bounty/companion/may_shoot(atom/target)
	var/mob/living/carbon/human/npc/bounty_companion/companion = pawn
	return istype(companion) && companion.ai_can_fight() && ..()

/datum/ai_controller/basic_controller/bounty/companion/may_strike(atom/target)
	var/mob/living/carbon/human/npc/bounty_companion/companion = pawn
	return istype(companion) && companion.ai_can_fight() && ..()

/datum/ai_controller/basic_controller/bounty/companion/pawn_attacked(mob/living/attacker)
	var/mob/living/carbon/human/npc/bounty_companion/companion = pawn
	if(istype(companion))
		companion.ai_attacked_by(attacker)

/datum/ai_controller/basic_controller/bounty/companion/pawn_damaged(damage, damagetype)
	var/mob/living/carbon/human/npc/bounty_companion/companion = pawn
	if(istype(companion))
		companion.ai_took_damage(damage, damagetype)

/datum/ai_controller/basic_controller/bounty/companion/proc/on_stamcrit(mob/living/carbon/human/npc/bounty_companion/source)
	SIGNAL_HANDLER
	source.ai_stamcritted = TRUE

/// Back up: from a real stamina crit, they decide whether to give up or run
/datum/ai_controller/basic_controller/bounty/companion/proc/on_recovered(mob/living/carbon/human/npc/bounty_companion/source)
	SIGNAL_HANDLER
	if(source.ai_stamcritted && source.stat == CONSCIOUS)
		INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/carbon/human/npc/bounty_companion, ai_after_stamcrit))

/datum/ai_controller/basic_controller/bounty/companion/proc/on_surrendered(mob/living/carbon/human/npc/bounty_companion/source)
	SIGNAL_HANDLER
	INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/carbon/human/npc/bounty_companion, ai_on_surrendered))

/**
 * A companion's own subtrees start here, after soft crit, breaking free and giving up: nothing while
 * it can't act (in crit, cuffed, stunned, giving up); one that ran off only runs, and once clear of
 * whoever it ran from, stays out of it.
 */
/datum/ai_planning_subtree/bounty_companion_gate

/datum/ai_planning_subtree/bounty_companion_gate/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_companion/companion = controller.pawn
	if(!istype(companion) || companion.stat != CONSCIOUS || companion.npc_surrendering || HAS_TRAIT(companion, TRAIT_RESTRAINED))
		return SUBTREE_RETURN_FINISH_PLANNING
	// Knocked down or stunned: nothing at all until they are up (H2)
	if(HAS_TRAIT(companion, TRAIT_FLOORED) || HAS_TRAIT(companion, TRAIT_INCAPACITATED))
		return SUBTREE_RETURN_FINISH_PLANNING
	if(!companion.ai_fled)
		return
	var/atom/threat = controller.blackboard[BB_BASIC_MOB_FLEE_TARGET]
	if(QDELETED(threat) || bounty_ai_dist(companion, threat) >= (controller.blackboard[BB_BASIC_MOB_FLEE_DISTANCE] || BOUNTY_FLEE_DISTANCE))
		return SUBTREE_RETURN_FINISH_PLANNING

/// tg's retaliation, while they can still fight. Its list is filled by the controller's hooks, not tg's element.
/datum/ai_planning_subtree/target_retaliate/bounty
	operational_datums = null

/datum/ai_planning_subtree/target_retaliate/bounty/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	if(!bounty_ai_fighting(controller.pawn))
		return
	return ..()

/// tg's call for reinforcements, straight to their own gang: no view() scan and no shouting
/datum/ai_planning_subtree/call_reinforcements/bounty
	call_type = /datum/ai_behavior/call_reinforcements/bounty

/datum/ai_planning_subtree/call_reinforcements/bounty/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	if(!bounty_ai_fighting(controller.pawn) || !decide_to_call(controller) || controller.blackboard[BB_BASIC_MOB_REINFORCEMENTS_COOLDOWN] > world.time)
		return
	controller.queue_behavior(call_type)

/datum/ai_behavior/call_reinforcements/bounty

/datum/ai_behavior/call_reinforcements/bounty/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	var/mob/living/carbon/human/npc/bounty_criminal/leader = bounty_ai_side_of(controller.pawn)
	if(leader && isliving(target))
		leader.ai_ally_attacked(target)
	controller.set_blackboard_key(BB_BASIC_MOB_REINFORCEMENTS_COOLDOWN, world.time + BOUNTY_REINFORCE_COOLDOWN)
	return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED

/// tg's walk to whoever called them in, stopping beside them
/datum/ai_planning_subtree/travel_to_point/and_clear_target/reinforce/bounty
	travel_behaviour = /datum/ai_behavior/travel_towards/bounty/adjacent/reinforce

/datum/ai_behavior/travel_towards/bounty/adjacent/reinforce
	clear_target = TRUE

/// Last in a companion's tree: with nobody to fight, they keep their criminal company
/datum/ai_planning_subtree/bounty_companion_idle

/datum/ai_planning_subtree/bounty_companion_idle/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_companion/companion = controller.pawn
	if(!companion.ai_can_fight())
		return
	var/mob/living/carbon/human/npc/bounty_criminal/leader = companion.ai_leader()
	if(companion.ai_in_fight && !controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET) && leader?.ai_mode != BOUNTY_AI_FIGHTING)
		companion.ai_leave_fight()
	if(!leader)
		return
	if(world.time >= companion.ai_next_idle_think)
		companion.ai_next_idle_think = world.time + 4 SECONDS
		companion.ai_idle_spot = companion.ai_pick_idle_spot(leader)
	var/turf/spot = companion.ai_idle_spot
	if(spot && companion.loc != spot)
		// Off the seat, the glass stays behind (L7)
		companion.ai_put_drink_away()
		companion.ai_stand_up()
		controller.set_blackboard_key(BB_BOUNTY_DESTINATION, spot)
		controller.queue_behavior(/datum/ai_behavior/travel_towards/bounty, BB_BOUNTY_DESTINATION)
		return SUBTREE_RETURN_FINISH_PLANNING
	controller.queue_behavior(/datum/ai_behavior/bounty_companion_hang_out)
	return SUBTREE_RETURN_FINISH_PLANNING

/datum/ai_behavior/bounty_companion_hang_out
	action_cooldown = 1 SECONDS
	behavior_flags = AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION

/datum/ai_behavior/bounty_companion_hang_out/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/carbon/human/npc/bounty_companion/companion = controller.pawn
	if(!istype(companion) || !companion.ai_can_fight())
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_FAILED
	companion.ai_hang_out()
	return AI_BEHAVIOR_DELAY
