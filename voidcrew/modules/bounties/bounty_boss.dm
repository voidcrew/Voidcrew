/**
 * # Bounty hunting: mini-bosses, shared parts
 *
 * Owner: P4 bosses. Owns this file, bounty_boss_kits.dm, voidcrew/_DEFINES/bounty_bosses.dm and
 * the tests in voidcrew/modules/unit_tests/voidcrew_bounty_bosses.dm. Do not edit this file
 * outside P4.
 *
 * What it owns: /mob/living/carbon/human/npc/bounty_criminal/boss (its body's built-in values, its gear
 * and its AI), the bounty ability base with its wind-up, telegraph and stale-serial guard (a port of
 * the prison horror's pattern), the posse and its reinforcements, the limits on what it may break, its
 * scripted fire and blasts, and on_confronted() for bosses (spec section 5, 12.3 C8).
 *
 * A boss is a real human (the human NPC base, voidcrew/modules/human_npcs/; owner decision D5). Its
 * crit, stamina, stamcrit, stuns, cuffs, wounds, bleeding and death are tg's, exactly as a player's:
 * - Toughness is real armour from its kit (locked to its body, D3) and npc_damage_taken
 *   (BOUNTY_BOSS_DAMAGE_TAKEN), fixed whatever the posse (defaults 1.5, OC-8). Never health.
 * - Resistance to stuns is its armour, its kit's own answer to a disabler (bounty_boss_kits.dm, C8) and
 *   the real stimulant pens it carries, used the way combat sense uses them (human_npc_combat_sense.dm):
 *   when it tires in a fight, never while one is still in its blood (/datum/npc_combat_sense/bounty/boss).
 * - "Worn out" is its AI reading real state (stamina loss over half its pool, or health under 40%): it
 *   says so, takes a pen if it wants one, and falls back (CB-2, CR-4).
 * - It fights with what it holds (real knives, a real torch, a real gun, its fists) through its hands,
 *   the way a player does (controller.ai_interact()).
 * - It never surrenders. Bosses execute nobody this phase (the core's hv_can_execute(), OC-9).
 *
 * How a fight goes:
 * - A boss waits (its activity, if P3 gives it one) until it spots a hunter, is attacked or is
 *   confronted. Then it turns hostile: every player within BOUNTY_BOSS_POSSE_RANGE who can see it
 *   joins its posse, and so does every crew member of a ship hunting it who is playing and at its site
 *   (on it, on its dock strip or aboard a ship landed there), seen or not. Each hunter in the posse
 *   beyond the first brings one more companion in from out of their view, one at a time (OC-8, CB-1),
 *   up to BOUNTY_BOSS_REINFORCEMENTS_MAX. Never health.
 * - Its AI: soft crit and breaking free first (the human NPC base's and the core's); nothing while
 *   busy or disabled; worn out, it falls back; a target; its combat sense (its stimulant, and the kit's
 *   reaction to stun fire, if it has one); its kit's gear; an ability,
 *   never the same one twice in a row; the kit's way of closing in or keeping away; up to and through
 *   whatever is in its way, if its kit can go through it; its melee; patching itself up with nobody
 *   about; with nobody in sight, the hunt for the nearest hunter still on its site that it can get at;
 *   and with nobody it can get at, out of the sight of those shooting at it from where it can't. It
 *   calms down after BOUNTY_BOSS_CALM_TIME with nobody around.
 * - Hurt by someone it can't get at (behind glass it can't break, a shut door, a gap, or off its site),
 *   it doesn't stand there: it stops going after them for BOUNTY_BOSS_SHUN_TIME and gets out of their
 *   sight (boss_find_cover()), however far off they are, with a line as it goes. Someone far off with a
 *   way to them on foot is in reach, and it goes after them. With real Gorilla Arms and an empty hand it
 *   punches through a window, grille, table or door it can break, after a tell (boss_start_smash()); the
 *   punches are the implant's own, and it only starts if it can break everything on the way.
 * - Every ability winds up first, where everyone can see and hear it (telegraph()), and does its
 *   harm only when the wind-up is over (effect()). Downed, restrained, stunned, knocked down or dead
 *   in between (tg's states, CB-24), and nothing happens.
 * - Who it chooses to go after is never someone already down (npc_target_stat, its targeting). What
 *   its fire and blasts catch is whoever stands there, down or not (CB-11, defaults 1.11).
 * - What it breaks is scripted, never a real explosion or atmos fire: tables, chairs, windows and
 *   grilles, and at most BOUNTY_BOSS_WALL_BUDGET walls or doors a fight, only indoors on its own
 *   site, never anything with space, the outdoors or another place on its far side. People its fire
 *   reaches burn with tg's fire stacks; people its blasts reach take tg's light explosion.
 */

/// Trait source for standing still while busy with an ability
#define BOUNTY_BOSS_BUSY_TRAIT "bounty_boss_busy"
/// What boss_busy says while its Gorilla Arms go at a window, grille, table or door
#define BOUNTY_BOSS_BUSY_SMASH "smash"
/// The glow on it while they do
#define BOUNTY_BOSS_SMASH_FILTER "bounty_boss_smash"

/// Fire pools the bosses have burning (/obj/effect/bounty_boss_fire_pool), for the cap
GLOBAL_LIST_EMPTY(bounty_boss_fire_pools)
/// Grenades and breaching charges live (/obj/effect/bounty_boss_explosive), for the cap
GLOBAL_LIST_EMPTY(bounty_boss_explosives)
/// Heavy barricades standing (/obj/structure/barricade/security/bounty_boss), for the cap
GLOBAL_LIST_EMPTY(bounty_boss_barricades)

/// Whether `candidate` is a hunter: a living player (a mob with a mind or a client), not a criminal or one of their friends
/proc/bounty_boss_is_hunter(mob/living/candidate)
	if(!isliving(candidate) || QDELETED(candidate) || candidate.stat == DEAD)
		return FALSE
	if(bounty_is_gang_body(candidate))
		return FALSE
	return !isnull(candidate.mind) || !isnull(candidate.client)

/**
 * Whether a boss's fire or blast catches `thing`, whatever state it is in (CB-11): a person who isn't
 * on the boss's side (`side`, its factions), or a mech with one in it. Never a criminal or a companion,
 * never anyone in godmode. Where it reaches is the caller's business (boss_reach_ok()).
 */
/proc/bounty_boss_effect_victim(atom/thing, list/side)
	if(QDELETED(thing))
		return FALSE
	if(ismecha(thing))
		var/obj/vehicle/sealed/mecha/mech = thing
		for(var/mob/living/pilot in mech.occupants)
			if(bounty_boss_effect_person(pilot, side))
				return TRUE
		return FALSE
	var/mob/living/person = thing
	// A pilot is reached through the mech's hull.
	return isliving(person) && !ismecha(person.loc) && bounty_boss_effect_person(person, side)

/// Whether `person` is someone a boss's fire and blasts catch: anyone not on its side, down, dead or standing
/proc/bounty_boss_effect_person(mob/living/person, list/side)
	if(!isliving(person) || QDELETED(person) || HAS_TRAIT(person, TRAIT_GODMODE) || bounty_is_gang_body(person))
		return FALSE
	return !length(side) || !faction_check(side, person.faction)

// ===== THE BOSS =====

/mob/living/carbon/human/npc/bounty_criminal/boss
	name = "wanted criminal"
	desc = "Someone with a big price on their head, and the gear to keep it."
	ai_controller = /datum/ai_controller/basic_controller/bounty_boss
	// Aimed crits like a player's (D4); executions stay off for every bounty NPC (the core's hv_can_execute()).
	npc_rank = HUMAN_NPC_RANK_BOSS
	// Fixed toughness, whatever its tier or posse (defaults 1.5, OC-8). Its armour does the rest.
	npc_damage_taken = BOUNTY_BOSS_DAMAGE_TAKEN
	body_tier_toughness = FALSE
	// Its stimulant pens, and a kit's answer to stun fire (C8). A kit with its own reaction uses a subtype.
	npc_combat_sense = /datum/npc_combat_sense/bounty/boss
	/// BOUNTY_KIT_*: which kit it is, and the prefix of its dialogue contexts
	var/boss_kit
	/// The ability types it is given
	var/list/boss_ability_types = list()
	/// Its abilities (/datum/action/cooldown/mob_cooldown/bounty_boss), granted at Initialize
	var/list/boss_abilities = list()
	/// Type of the last ability it started: the rotation never picks it again straight away
	var/boss_last_ability
	/// Never the same ability twice in a row even when it is the only one ready (BOUNTY_BOSS_STRICT_ROTATION)
	var/boss_strict_rotation = BOUNTY_BOSS_STRICT_ROTATION
	/// world.time the next ability may start
	var/boss_next_ability_at = 0
	/// What keeps it still with its AI quiet ("windup", "charge", "dash", "burst"), or null
	var/boss_busy
	/// Goes up each time it becomes busy, so a stale timer knows to do nothing
	var/boss_busy_serial = 0
	var/boss_busy_timer
	/// The ability winding up now, whose telegraph goes if it is interrupted
	var/datum/weakref/boss_winding_ref
	/// Turned hostile: it spotted a hunter, or someone attacked or confronted it
	var/boss_hostile = FALSE
	/// REF() of each hunter in its posse -> TRUE
	var/list/boss_engaged = list()
	/// Companions its posse has brought in (OC-8), and how many more are owed and not yet called
	var/boss_reinforcements_sent = 0
	var/boss_reinforcements_owed = 0
	var/boss_reinforce_timer
	/// Weakrefs to the companions that came in for it
	var/list/boss_reinforcement_refs
	/// Walls and doors it may still break this fight
	var/boss_walls_left = BOUNTY_BOSS_WALL_BUDGET
	/// Whoever hurt it last (a person, or the mech they are in), and when
	var/datum/weakref/boss_last_attacker
	var/boss_last_attacked_at = 0
	/// world.time it calms down if it still finds no hunter on its site
	var/boss_calm_at = 0
	/// Worn out (boss_is_worn_out(), read by its AI): said so, and falls back until boss_fallback_until
	var/boss_worn_out = FALSE
	var/boss_fallback_until = 0
	/// Hunters who hurt it from where it couldn't get at them: weakref -> world.time of the last such hit (boss_note_reach())
	var/list/boss_shunned = list()
	/// The tiles it can walk to (boss_walkable()): turf -> steps, the tile it stood on then, and when that was worked out
	var/list/boss_walk_cache
	var/turf/boss_walk_origin
	var/boss_walk_at = 0
	/// world.time it may look for new cover
	var/boss_cover_rethink_at = 0
	/// world.time it may say a line again as it breaks for cover
	var/boss_cover_bark_at = 0
	/// What its Gorilla Arms are going at (boss_start_smash()), the floor mark on it, and the punches thrown so far
	var/datum/weakref/boss_smash_target
	var/datum/weakref/boss_smash_mark
	var/boss_smash_blows = 0
	/// A thrown item of its own, kept out of the world, that its throws are checked with (boss_throw_reaches())
	var/obj/item/bounty_boss_throw_probe/boss_throw_probe

/mob/living/carbon/human/npc/bounty_criminal/boss/Initialize(mapload, datum/human_npc_order/order)
	. = ..()
	for(var/ability_type in boss_ability_types)
		var/datum/action/cooldown/mob_cooldown/bounty_boss/ability = new ability_type(src)
		ability.Grant(src)
		boss_abilities += ability
	AddComponent(/datum/component/bounty_boss_signals)

/mob/living/carbon/human/npc/bounty_criminal/boss/Destroy()
	boss_interrupt()
	QDEL_LIST(boss_abilities)
	deltimer(boss_busy_timer)
	boss_busy_timer = null
	deltimer(boss_reinforce_timer)
	boss_reinforce_timer = null
	boss_reinforcement_refs = null
	boss_winding_ref = null
	boss_last_attacker = null
	boss_shunned = null
	boss_walk_cache = null
	boss_walk_origin = null
	QDEL_NULL(boss_throw_probe)
	return ..()

/mob/living/carbon/human/npc/bounty_criminal/boss/death(gibbed)
	boss_interrupt()
	deltimer(boss_reinforce_timer)
	boss_reinforce_timer = null
	boss_reinforcements_owed = 0
	return ..()

/mob/living/carbon/human/npc/bounty_criminal/boss/examine(mob/user)
	. = ..()
	if(stat == DEAD || hidden)
		return
	var/gear = boss_gear_text()
	if(gear)
		. += span_warning(gear)
	if(boss_worn_out)
		. += span_notice("[p_They()] look[p_s()] worn out.")

/**
 * `user` confronted them: showed the warrant, or accused them. A boss doesn't run or argue. It
 * starts its fight, with `user` first on its list.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/on_confronted(mob/user)
	if(stat != CONSCIOUS || !isliving(user))
		return
	body_add_grudge(user)
	boss_turn_hostile(user)
	var/atom/target = boss_target_for(user)
	if(boss_valid_target(target))
		ai_controller?.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, target)

// ----- its kit -----

// What each kit wears and carries (bounty_boss_kits.dm): real armour, its weapon carried or held, spare
// ammunition, its stimulants and something to patch itself up with. The base adds vacuum and cold layers.
/mob/living/carbon/human/npc/bounty_criminal/boss/bounty_build_outfit(zone)
	return boss_supplies(bounty_outfit_instance(/datum/outfit/bounty_boss))

/**
 * Packs what every boss carries into `outfit`, an instance: BOUNTY_BOSS_STIMULANTS stimulant pens (its
 * combat sense uses them when it tires) and a bruise pack, in a bag on its back (one is added if it wears
 * none). Returns the outfit.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_supplies(datum/outfit/outfit)
	if(!istype(outfit))
		return outfit
	outfit.back ||= /obj/item/storage/backpack
	LAZYINITLIST(outfit.backpack_contents)
	outfit.backpack_contents[BOUNTY_BOSS_STIMULANT] = (outfit.backpack_contents[BOUNTY_BOSS_STIMULANT] || 0) + BOUNTY_BOSS_STIMULANTS
	outfit.backpack_contents[/obj/item/stack/medical/bruise_pack] = (outfit.backpack_contents[/obj/item/stack/medical/bruise_pack] || 0) + 1
	return outfit

/// A line on examine about its gear, if the kit has one
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gear_text()
	return null

/**
 * Says a line for "<kit>_<suffix>", or for "<kit>_<fallback>" if there is none for it. Async, so a
 * signal handler can call it.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_bark(suffix, fallback)
	if(!boss_kit || stat != CONSCIOUS)
		return
	INVOKE_ASYNC(src, PROC_REF(boss_bark_now), suffix, fallback)

/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_bark_now(suffix, fallback)
	if(QDELETED(src) || stat != CONSCIOUS)
		return FALSE
	if(bounty_say("[boss_kit]_[suffix]"))
		return TRUE
	return fallback ? bounty_say("[boss_kit]_[fallback]") : FALSE

// ----- state, all tg's -----

/// Whether it can act at all: alive and awake, not in crit, restrained, stunned, knocked down or in stamina crit
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_can_act()
	if(QDELETED(src) || stat != CONSCIOUS || !isturf(loc))
		return FALSE
	if(is_downed() || is_restrained() || npc_surrendering)
		return FALSE
	return !HAS_TRAIT(src, TRAIT_INCAPACITATED) && !HAS_TRAIT(src, TRAIT_FLOORED)

/// Whether it may start an ability now: able, not busy, not falling back, and past the gap since the last one
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_can_use_ability()
	return boss_can_act() && !boss_busy && world.time >= boss_next_ability_at && world.time >= boss_fallback_until

/**
 * Worn out, read from its body (CB-2): stamina loss over BOUNTY_BOSS_WORN_OUT_STAMINA of its pool, or
 * health under BOUNTY_BOSS_WORN_OUT_HEALTH of its max. tg's own slowdown from both does the rest.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_is_worn_out()
	if(stat == DEAD)
		return FALSE
	return getStaminaLoss() > max_stamina * BOUNTY_BOSS_WORN_OUT_STAMINA || health < maxHealth * BOUNTY_BOSS_WORN_OUT_HEALTH

/// It has just worn out: it says so where the fight is, drops what it was winding up and falls back for a while
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_wear_out()
	boss_worn_out = TRUE
	boss_fallback_until = world.time + BOUNTY_BOSS_FALLBACK_TIME
	boss_interrupt()
	visible_message(span_warning("[src] is breathing hard and slowing down. [p_They()] look[p_s()] worn out."))
	body_alert_hunters("worn out")
	boss_bark("exhausted")

// ----- busy -----

/**
 * Busy with `state`, its AI quiet. `immobile` keeps it standing still (a wind-up, a burst); a charge or
 * dash moves it itself. A wind-up is a telegraph: tg's stuns, knockdowns, stamcrit, crit and cuffs
 * interrupt it (the bounty_boss_signals component, and boss_can_act() when it ends; CB-24). With a
 * `duration` it ends on its own. Returns the serial a timer checks against, so a stale one does nothing.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_set_busy(state, duration, immobile = TRUE)
	boss_busy = state
	boss_busy_serial++
	deltimer(boss_busy_timer)
	boss_busy_timer = null
	if(immobile)
		ADD_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_BOSS_BUSY_TRAIT)
	else
		REMOVE_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_BOSS_BUSY_TRAIT)
	ai_controller?.CancelActions()
	if(duration)
		boss_busy_timer = addtimer(CALLBACK(src, PROC_REF(boss_clear_busy), boss_busy_serial), duration, TIMER_STOPPABLE | TIMER_DELETE_ME)
	return boss_busy_serial

/// Free again, unless `serial` is stale
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_clear_busy(serial)
	if(serial && serial != boss_busy_serial)
		return FALSE
	boss_busy = null
	deltimer(boss_busy_timer)
	boss_busy_timer = null
	REMOVE_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_BOSS_BUSY_TRAIT)
	return TRUE

/// Whether it is still busy with `state` under `serial`: what a charge or burst checks before each step
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_still(state, serial)
	return !QDELETED(src) && boss_busy == state && boss_busy_serial == serial && boss_can_act()

/// Knocked out of whatever it was doing: a wind-up's telegraph goes, and nothing lands
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_interrupt()
	var/datum/action/cooldown/mob_cooldown/bounty_boss/winding = boss_winding_ref?.resolve()
	boss_winding_ref = null
	winding?.cancel_windup()
	boss_end_smash()
	if(boss_busy)
		boss_clear_busy()
	boss_on_interrupted()

/// A kit's own clean-up when it is interrupted, downed or killed
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_on_interrupted()
	return

/// The ability winding up now, if any
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_winding()
	if(boss_busy != "windup")
		return null
	return boss_winding_ref?.resolve()

// ----- abilities -----

/**
 * The ability to use on `target` now, or null: ready and worth it, and not the one it used last
 * while another is ready. With BOUNTY_BOSS_STRICT_ROTATION (boss_strict_rotation) the last one is
 * never picked again straight away, even when it is the only one ready.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_choose_ability(atom/target)
	if(QDELETED(target) || !boss_can_use_ability())
		return null
	var/list/options = list()
	var/datum/action/cooldown/mob_cooldown/bounty_boss/last_one
	for(var/datum/action/cooldown/mob_cooldown/bounty_boss/ability as anything in boss_abilities)
		if(QDELETED(ability) || !ability.IsAvailable() || !ability.worth_using(target))
			continue
		if(ability.type == boss_last_ability)
			last_one = ability
			continue
		options += ability
	if(length(options))
		return pick(options)
	return boss_strict_rotation ? null : last_one

/// Starts `ability`'s wind-up. Returns the serial its timer checks, or 0 if it can't start now.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_begin_ability(datum/action/cooldown/mob_cooldown/bounty_boss/ability)
	if(!boss_can_use_ability())
		return 0
	boss_last_ability = ability.type
	boss_next_ability_at = world.time + ability.windup + ability.effect_time + rand(BOUNTY_BOSS_ABILITY_GAP_MIN, BOUNTY_BOSS_ABILITY_GAP_MAX)
	boss_winding_ref = WEAKREF(ability)
	return boss_set_busy("windup", ability.windup + 1 SECONDS)

/// The kit's way of fighting after abilities: keep range, break off. Returns TRUE if it queued something.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_engage_plan(datum/ai_controller/controller, atom/target)
	return FALSE

/// The kit's own gear to see to before it fights on (a Heavy's belt change). Returns TRUE if it queued something.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gear_plan(datum/ai_controller/controller)
	return FALSE

// ----- the posse and turning hostile -----

/**
 * Turns hostile, with `instigator` (who attacked, confronted or was spotted) in its posse if they
 * count (boss_counts_for_posse()). The first time, everyone who counts within
 * BOUNTY_BOSS_POSSE_RANGE and can see it joins too, mech pilots included, then the rest of every
 * hunting crew at its site (boss_engage_hunting_crews()), and it says its intro line.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_turn_hostile(mob/living/instigator)
	if(stat == DEAD)
		return FALSE
	boss_calm_at = world.time + BOUNTY_BOSS_CALM_TIME
	if(boss_hostile)
		if(instigator)
			boss_engage(instigator)
		return FALSE
	boss_hostile = TRUE
	if(instigator)
		boss_engage(instigator, announce = FALSE)
	for(var/mob/living/watcher in viewers(BOUNTY_BOSS_POSSE_RANGE, src))
		boss_engage(watcher, announce = FALSE)
	for(var/obj/vehicle/sealed/mecha/mech in view(BOUNTY_BOSS_POSSE_RANGE, src))
		for(var/mob/living/pilot in mech.occupants)
			boss_engage(pilot, announce = FALSE)
	boss_engage_hunting_crews()
	boss_bark("intro")
	return TRUE

/**
 * Every crew member of a ship hunting its bounty who is playing (not SSD) and at its site joins its
 * posse, seen or not (boss_crew_at_site()), so each owes a companion like anyone in sight: one hunter
 * can't wake it alone while the rest of the crew wait on the dock strip or aboard their landed ship
 * (review r1). Crew on another site sharing its level, or aboard a ship anywhere else, don't count
 * (review r2).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_engage_hunting_crews()
	var/datum/criminal_bounty/posting = posting()
	if(!posting || !get_turf(src))
		return
	for(var/obj/structure/overmap/ship/ship as anything in posting.hunter_ships())
		for(var/datum/mind/member as anything in ship.ship_team?.members)
			var/mob/living/body = member?.current
			if(isliving(body) && GET_CLIENT(body) && boss_crew_at_site(body, ship))
				boss_engage(body, announce = FALSE)

/**
 * Whether `body`, of the crew of `ship`, is at its site for its posse: on its level, and on the site
 * itself, or anywhere in the site's rectangle, which holds its dock strip and the ships landed on it.
 * For a site with no rectangle (a pirate ship), aboard `ship` close alongside it.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_crew_at_site(mob/living/body, obj/structure/overmap/ship/ship)
	var/turf/here = get_turf(src)
	var/turf/where = get_turf(body)
	if(!here || !where || where.z != here.z)
		return FALSE
	if(body_on_site(where))
		return TRUE
	if(site_bounds)
		return where.z == site_bounds[5] && where.x >= site_bounds[1] && where.x <= site_bounds[3] && where.y >= site_bounds[2] && where.y <= site_bounds[4]
	return ship?.is_aboard(where) && get_dist(here, where) <= BOUNTY_BOSS_HUNT_RANGE

/// With no hunter left on its site, it stops hunting and waits again. Its posse stays.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_calm_down()
	boss_hostile = FALSE
	ai_controller?.clear_blackboard_key(BB_BOUNTY_BOSS_PREY)

/**
 * Whether `hunter` counts toward its posse (M4): a hunter on its grudge list (they attacked,
 * confronted or cuffed it), or one whose ship is hunting its bounty. Being seen or targeted alone
 * doesn't count.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_counts_for_posse(mob/living/hunter)
	if(!bounty_boss_is_hunter(hunter))
		return FALSE
	if(body_has_grudge(hunter))
		return TRUE
	var/datum/criminal_bounty/posting = posting()
	if(!posting || !hunter.mind)
		return FALSE
	for(var/obj/structure/overmap/ship/ship as anything in posting.hunter_ships())
		if(hunter.mind in ship.ship_team?.members)
			return TRUE
	return FALSE

/**
 * Adds `hunter` to its posse if they count. Each hunter beyond the first owes it one more companion
 * (OC-8); with `announce`, it sizes the bigger posse up out loud. Returns TRUE if they are new.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_engage(mob/living/hunter, announce = TRUE)
	if(stat == DEAD || !boss_counts_for_posse(hunter))
		return FALSE
	var/key = REF(hunter)
	if(boss_engaged[key])
		return FALSE
	boss_engaged[key] = TRUE
	var/count = length(boss_engaged)
	boss_owe_reinforcements(count)
	if(announce && count > 1)
		visible_message(span_warning("[src] looks over the [count] of you and squares up."))
		boss_bark("posse", "intro")
	return TRUE

/// A posse of `count` hunters owes one companion for each beyond the first, up to BOUNTY_BOSS_REINFORCEMENTS_MAX, called one at a time
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_owe_reinforcements(count)
	var/wanted = clamp(count - 1, 0, BOUNTY_BOSS_REINFORCEMENTS_MAX)
	var/more = wanted - boss_reinforcements_sent - boss_reinforcements_owed
	if(more <= 0)
		return
	boss_reinforcements_owed += more
	boss_schedule_reinforcement()

/// The next companion comes after BOUNTY_BOSS_REINFORCE_DELAY, never two at once
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_schedule_reinforcement()
	if(boss_reinforce_timer || boss_reinforcements_owed <= 0 || stat == DEAD)
		return
	boss_reinforce_timer = addtimer(CALLBACK(src, PROC_REF(boss_reinforce_tick)), BOUNTY_BOSS_REINFORCE_DELAY, TIMER_STOPPABLE | TIMER_DELETE_ME)

/// Calls the next companion owed, from somewhere no player can see; tries again later if there is nowhere yet
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_reinforce_tick()
	boss_reinforce_timer = null
	if(QDELETED(src) || stat == DEAD || !boss_hostile || boss_reinforcements_owed <= 0)
		return
	var/turf/spot = boss_reinforcement_spot()
	if(spot)
		boss_send_reinforcement(spot)
	boss_schedule_reinforcement()

/**
 * Calls one companion owed in at `where` (the criminal-AI package's bounty_spawn_companion(): a queued,
 * throttled human NPC joined to it). Returns what that returns.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_send_reinforcement(turf/where)
	if(boss_reinforcements_owed <= 0 || !isturf(where))
		return null
	boss_reinforcements_owed--
	boss_reinforcements_sent++
	return bounty_spawn_companion(src, where, CALLBACK(src, PROC_REF(boss_reinforcement_arrived)))

/// A companion it called is here: it goes after whoever the boss is fighting
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_reinforcement_arrived(mob/living/carbon/human/npc/companion)
	if(QDELETED(src) || !ismob(companion) || QDELETED(companion))
		return
	LAZYADD(boss_reinforcement_refs, WEAKREF(companion))
	var/atom/target = ai_controller?.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!QDELETED(target))
		companion.ai_controller?.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, target)

/**
 * A spot for a companion to come in at: open ground on its site, BOUNTY_BOSS_REINFORCE_MIN_DIST to
 * _MAX_DIST tiles off, where no player within BOUNTY_BOSS_REINFORCE_SIGHT can see. Null if there is none.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_reinforcement_spot()
	var/turf/here = get_turf(src)
	if(!here)
		return null
	var/list/watchers = list()
	if(here.z <= length(SSmobs.clients_by_zlevel))
		for(var/mob/living/person as anything in SSmobs.clients_by_zlevel[here.z])
			if(person.stat != DEAD && get_dist(person, here) <= BOUNTY_BOSS_REINFORCE_MAX_DIST + BOUNTY_BOSS_REINFORCE_SIGHT)
				watchers += person
	var/list/candidates = list()
	for(var/turf/open/spot in RANGE_TURFS(BOUNTY_BOSS_REINFORCE_MAX_DIST, here))
		if(get_dist(spot, here) < BOUNTY_BOSS_REINFORCE_MIN_DIST)
			continue
		if(isspaceturf(spot) || isgroundlessturf(spot) || islava(spot) || ischasm(spot) || spot.is_blocked_turf())
			continue
		if(!leash_ok(spot) || !boss_reach_ok(spot))
			continue
		candidates += spot
	shuffle_inplace(candidates)
	var/tries = 0
	for(var/turf/spot as anything in candidates)
		if(++tries > 40)
			break
		var/seen = FALSE
		for(var/mob/living/watcher as anything in watchers)
			if(get_dist(watcher, spot) <= BOUNTY_BOSS_REINFORCE_SIGHT && can_see(watcher, spot, BOUNTY_BOSS_REINFORCE_SIGHT))
				seen = TRUE
				break
		if(!seen)
			return spot
	return null

// ----- targets -----

/// The people behind `thing`: the person, or everyone in the mech
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_people_in(atom/thing)
	. = list()
	if(isliving(thing))
		. += thing
	else if(ismecha(thing))
		var/obj/vehicle/sealed/mecha/mech = thing
		for(var/mob/living/pilot in mech.occupants)
			. += pilot

/// What to go after for `who`: the mech they sit in, or them
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_target_for(atom/who)
	var/mob/living/person = who
	if(isliving(person) && ismecha(person.loc))
		return person.loc
	return who

/**
 * Whether it chooses to go after `target`: one it may go after (boss_can_go_after()), and not one it
 * keeps away from (boss_shuns()).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_valid_target(atom/target)
	return boss_can_go_after(target) && !boss_shuns(target)

/**
 * Whether it may go after `target` (C4, H2, M2, L1): an awake hunter not on its side, or a mech with
 * one in it (a pilot is hurt through the mech); standing on its site, never in a ship, a hangar or an
 * outpost; someone it may attack from where it is (P2's may_attack()). This is its choice of target
 * only: what its fire and blasts catch is boss_effect_hits() (CB-11).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_can_go_after(atom/target)
	if(QDELETED(target) || target == src)
		return FALSE
	if(!boss_reach_ok(get_turf(target)))
		return FALSE
	if(ismecha(target))
		var/obj/vehicle/sealed/mecha/mech = target
		return boss_hunter_aboard(mech) && may_attack(mech)
	var/mob/living/person = target
	if(!isliving(person) || ismecha(person.loc) || !boss_hunter_awake(person))
		return FALSE
	return may_attack(person)

/// An awake hunter not on its side: who it picks to fight. Never used for what its fire and blasts catch.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_hunter_awake(mob/living/person)
	return bounty_boss_is_hunter(person) && person.stat == CONSCIOUS && !HAS_TRAIT(person, TRAIT_GODMODE) && !faction_check_atom(person)

/// Whether an awake hunter not on its side sits in `mech`
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_hunter_aboard(obj/vehicle/sealed/mecha/mech)
	for(var/mob/living/pilot in mech.occupants)
		if(boss_hunter_awake(pilot))
			return TRUE
	return FALSE

/**
 * Whether its fire, blasts, charge or slam catch `victim` where it stands: anywhere its abilities may
 * reach (boss_reach_ok()), anyone not on its side, in whatever state (CB-11: down, cuffed or standing).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_effect_hits(atom/victim)
	if(QDELETED(victim) || victim == src)
		return FALSE
	return boss_reach_ok(get_turf(victim)) && bounty_boss_effect_victim(victim, faction)

/// Everyone on `turfs` its abilities catch: people not on its side, in any state, and mechs with one in them
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_victims_on(list/turfs)
	. = list()
	for(var/turf/spot as anything in turfs)
		for(var/atom/movable/thing as anything in spot)
			if((isliving(thing) || ismecha(thing)) && boss_effect_hits(thing))
				. += thing

/**
 * One scripted hit from an ability (a charge or a slam) on `victim`: `damage` of `damage_type` against
 * `armour_flag` armour on the chest, and a knockdown, both through tg (CB-25). A mech takes it on its
 * hull (H2). `already_scaled` is for the zone-damage helper, which leaves human bosses at a person's.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_hit(atom/victim, damage, damage_type = BRUTE, armour_flag = MELEE, knockdown = 0, armour_penetration = 0, already_scaled = FALSE)
	damage = npc_zone_damage(damage, src, already_scaled)
	if(ismecha(victim))
		var/obj/vehicle/sealed/mecha/mech = victim
		mech.take_damage(damage, damage_type, armour_flag, TRUE, get_dir(mech, src), armour_penetration)
		return TRUE
	var/mob/living/person = victim
	if(!isliving(person))
		return FALSE
	person.apply_damage(damage, damage_type, BODY_ZONE_CHEST, person.run_armor_check(BODY_ZONE_CHEST, armour_flag, armour_penetration = armour_penetration, silent = TRUE))
	if(knockdown)
		person.Knockdown(knockdown)
	shake_camera(person, 3, 2)
	return TRUE

/// Whoever hurt it within BOUNTY_BOSS_REVENGE_TIME (their mech, if they were in one), if it may still go after them
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_revenge_target()
	if(world.time > boss_last_attacked_at + BOUNTY_BOSS_REVENGE_TIME)
		return null
	var/atom/attacker = boss_target_for(boss_last_attacker?.resolve())
	return boss_valid_target(attacker) ? attacker : null

/**
 * `attacker` went for it: a person, or a mech and everyone in it (H2). The hunters behind it go on
 * its grudge list and into its posse, it turns hostile, and it remembers whom to turn on.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_note_attacker(atom/attacker)
	if(stat == DEAD || QDELETED(attacker) || attacker == src)
		return FALSE
	var/list/hunters = list()
	for(var/mob/living/person as anything in boss_people_in(attacker))
		if(bounty_boss_is_hunter(person))
			hunters += person
	if(!length(hunters))
		return FALSE
	boss_last_attacker = WEAKREF(boss_target_for(attacker))
	boss_last_attacked_at = world.time
	for(var/mob/living/hunter as anything in hunters)
		body_add_grudge(hunter)
		boss_turn_hostile(hunter)
		boss_note_reach(hunter)
	return TRUE

/**
 * The nearest hunter (or their mech) still on its site within BOUNTY_BOSS_HUNT_RANGE that it can get
 * at (boss_can_reach()), for the hunt: it never walks back out to stand in front of someone behind
 * glass. Only players with a client count, from SSmobs' list for its level; a test passes its own
 * `candidates`.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_nearest_hunter(list/candidates)
	var/turf/here = get_turf(src)
	if(!here)
		return null
	if(isnull(candidates))
		if(here.z > length(SSmobs.clients_by_zlevel))
			return null
		candidates = SSmobs.clients_by_zlevel[here.z]
	var/atom/best
	var/best_distance = BOUNTY_BOSS_HUNT_RANGE + 1
	for(var/mob/living/person in candidates)
		var/atom/target = boss_target_for(person)
		var/turf/spot = get_turf(target)
		if(!spot || spot.z != here.z)
			continue
		var/distance = get_dist(here, spot)
		// Nearest first: the costly checks only for someone nearer than the best so far
		if(distance >= best_distance || !leash_ok(spot) || !boss_valid_target(target) || !boss_can_reach(target))
			continue
		best = target
		best_distance = distance
	return best

// ----- where it may reach, and what it may break -----

/// Whether an ability's effect may reach `spot` (M2): on its site, and never in a ship (other than the one it is wanted aboard), a hangar or an outpost
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_reach_ok(turf/spot)
	spot = get_turf(spot)
	return !isnull(spot) && body_on_site(spot) && !body_forbidden_turf(spot)

/**
 * Whether its abilities may damage anything on `spot`, or aim at it (H1, M2): on its level, and
 * P2's environment_damage_allowed(): its own site, never a trader outpost, and never within
 * BOUNTY_ENV_SAFE_RANGE tiles of a player ship, a hangar, a player outpost or a planet's dock strip.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_environment_allowed(turf/spot)
	spot = get_turf(spot)
	if(!spot || spot.z != z)
		return FALSE
	return environment_damage_allowed(spot)

/// Whether a thrown or fired ability may be aimed at `spot` (M2): somewhere it could walk itself, and allowed for environment damage
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_landing_ok(turf/spot)
	spot = get_turf(spot)
	return !isnull(spot) && leash_ok(spot) && boss_environment_allowed(spot)

/// The air pressure on `spot`, in kPa
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_turf_pressure(turf/spot)
	var/datum/gas_mixture/air = spot?.return_air()
	return air ? air.return_pressure() : 0

/// Whether `spot` holds an airlock with space, another ship or somewhere off its site on one side: an outer airlock
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_outer_airlock_turf(turf/spot)
	if(!(locate(/obj/machinery/door/airlock) in spot))
		return FALSE
	for(var/direction in GLOB.cardinals)
		var/turf/beside = get_step(spot, direction)
		if(!beside || isspaceturf(beside) || isgroundlessturf(beside) || !boss_reach_ok(beside))
			return TRUE
	return FALSE

/**
 * An indoor tile of its site (H1, L2): solid ground, not outdoors, on its own site or ship and never in
 * another ship, a hangar or an outpost, with air in it. A ship's tile counts only if nothing around
 * it is space, off its site, another ship, or an outer airlock.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_indoor_turf(turf/spot)
	if(!spot || isspaceturf(spot) || isgroundlessturf(spot) || islava(spot) || ischasm(spot))
		return FALSE
	var/area/spot_area = get_area(spot)
	if(!spot_area || spot_area.outdoors || !boss_reach_ok(spot))
		return FALSE
	if(isopenturf(spot) && boss_turf_pressure(spot) < BOUNTY_BOSS_INTERIOR_MIN_PRESSURE)
		return FALSE
	if(istype(spot_area, /area/shuttle))
		for(var/direction in GLOB.alldirs)
			var/turf/beside = get_step(spot, direction)
			if(!beside || isspaceturf(beside) || isgroundlessturf(beside) || !boss_reach_ok(beside) || boss_outer_airlock_turf(beside))
				return FALSE
	return TRUE

/**
 * Whether breaking what is on `spot` (a wall, or the tile a window or door stands on) keeps it
 * indoors: `spot` and every open tile beside it must be indoor tiles of its site (H1), with no more
 * than BOUNTY_BOSS_INTERIOR_MAX_PRESSURE_GAP between their pressures (L2). Never a hull, never an
 * outside wall, never a window onto space, the outdoors, a vacuum or another ship.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_interior_spot(turf/spot)
	if(!spot)
		return FALSE
	var/list/open_sides = list()
	if(isopenturf(spot))
		if(!boss_indoor_turf(spot))
			return FALSE
		open_sides += spot
	for(var/direction in GLOB.cardinals)
		var/turf/beside = get_step(spot, direction)
		if(!beside)
			return FALSE
		if(isclosedturf(beside))
			continue
		if(!boss_indoor_turf(beside))
			return FALSE
		open_sides += beside
	if(length(open_sides) > 1)
		var/lowest = INFINITY
		var/highest = 0
		for(var/turf/side as anything in open_sides)
			var/pressure = boss_turf_pressure(side)
			lowest = min(lowest, pressure)
			highest = max(highest, pressure)
		if(highest - lowest > BOUNTY_BOSS_INTERIOR_MAX_PRESSURE_GAP)
			return FALSE
	return TRUE

/**
 * Whether its abilities may damage `thing`: allowed there (boss_environment_allowed(), and P2's
 * may_attack_scope(), which refuses structures off its site), indoors on both sides, and a kind it
 * breaks (tables, chairs, windows, grilles, barricades; plain walls and doors only while its
 * BOUNTY_BOSS_WALL_BUDGET lasts). Never anything indestructible or outpost property. It is about the
 * place and the thing, not about the boss's own state: a grenade already thrown still lands.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_may_break(atom/thing)
	if(QDELETED(thing))
		return FALSE
	var/turf/spot = get_turf(thing)
	if(!boss_environment_allowed(spot) || !may_attack_scope(thing) || !boss_interior_spot(spot))
		return FALSE
	if(isturf(thing))
		if(!iswallturf(thing) || istype(thing, /turf/closed/wall/r_wall) || isindestructiblewall(thing))
			return FALSE
		return boss_walls_left > 0
	var/obj/object = thing
	if(!istype(object) || (object.resistance_flags & INDESTRUCTIBLE) || HAS_TRAIT(object, TRAIT_OUTPOST_PROPERTY))
		return FALSE
	if(istype(object, /obj/machinery/door))
		return boss_walls_left > 0
	return istype(object, /obj/structure/window) || istype(object, /obj/structure/grille) || istype(object, /obj/structure/table) \
		|| istype(object, /obj/structure/chair) || istype(object, /obj/structure/barricade)

/**
 * Damages `thing` for one use of an ability: `damage` against `damage_flag` armour, or null to break
 * it outright whatever its armour (M1). `tally` is that use's one-item count of structures left
 * (BOUNTY_BOSS_ABILITY_STRUCTURE_CAP). Broken outright, a wall comes down to the floor and a door goes
 * with its frame, so the way through really opens; either spends the fight's wall budget, as does a
 * door that damage alone destroys. Returns TRUE if it did damage.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_damage_structure(atom/thing, damage, list/tally, damage_flag = MELEE)
	if(length(tally) && tally[1] <= 0)
		return FALSE
	if(!boss_may_break(thing))
		return FALSE
	if(length(tally))
		tally[1]--
	if(iswallturf(thing))
		var/turf/closed/wall/wall = thing
		boss_walls_left--
		wall.visible_message(span_danger("[wall] caves in!"))
		playsound(wall, 'sound/effects/meteorimpact.ogg', 70, TRUE)
		wall.dismantle_wall(devastated = TRUE)
		return TRUE
	var/obj/object = thing
	var/turf/spot = get_turf(object)
	var/is_door = istype(object, /obj/machinery/door)
	if(isnull(damage))
		object.take_damage(object.get_integrity(), BRUTE, "", TRUE, get_dir(object, src))
		if(!QDELETED(object))
			qdel(object)
		if(is_door)
			boss_walls_left--
			for(var/obj/structure/door_assembly/frame in spot)
				qdel(frame)
		return TRUE
	object.take_damage(damage, BRUTE, damage_flag, TRUE, get_dir(object, src))
	if(is_door && (QDELETED(object) || object.get_integrity() <= 0))
		boss_walls_left--
	return TRUE

// ===== HURT FROM WHERE IT CAN'T REACH (review r1 F4, r2) =====

/**
 * Whether it can get at `target` (a person, or a mech) from where it stands: it may go after them
 * there, and it is beside them, or nothing on the straight way stops it, or its kit goes through
 * everything that does (boss_gets_through()), or it can walk round to them (boss_walks_to()).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_can_reach(atom/target)
	if(!boss_can_go_after(target))
		return FALSE
	var/turf/here = get_turf(src)
	var/turf/there = get_turf(target)
	if(!here || !there || here.z != there.z)
		return FALSE
	if(Adjacent(target))
		return TRUE
	var/list/blockers = boss_line_blockers(here, there)
	if(!length(blockers) || boss_gets_through(blockers))
		return TRUE
	return boss_walks_to(there)

/**
 * Whether it can walk to `there`, or beside it (someone up on a table or a crate), through nothing it
 * can't open (boss_walkable()). Someone beyond BOUNTY_BOSS_REACH_RANGE is past the walk it works out:
 * they count as reachable if that walk reaches its edge at least half its range closer to them, so a
 * far shooter with open ground between is chased, and one across a gap or behind a wall near it is
 * not (review r2).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_walks_to(turf/there)
	var/turf/here = get_turf(src)
	if(!here || !there || here.z != there.z)
		return FALSE
	var/list/steps = boss_walkable()
	if(!isnull(steps[there]))
		return TRUE
	for(var/direction in GLOB.cardinals)
		var/turf/beside = get_step(there, direction)
		if(beside && !isnull(steps[beside]) && !boss_border_between(beside, there))
			return TRUE
	var/distance = get_dist(here, there)
	if(distance <= BOUNTY_BOSS_REACH_RANGE)
		return FALSE
	var/closer_than = distance - BOUNTY_BOSS_REACH_RANGE / 2
	for(var/turf/spot as anything in steps)
		if(get_dist(here, spot) >= BOUNTY_BOSS_REACH_RANGE && get_dist(spot, there) <= closer_than)
			return TRUE
	return FALSE

/**
 * Whether its kit gets through `barrier` (from boss_line_blockers()) to someone behind it: with real
 * Gorilla Arms and an empty hand to punch with (boss_gorilla_goes_through()). Each kit adds its own
 * (bounty_boss_kits.dm): a charge, a grenade or a molotov thrown over, a breaching charge, rounds that
 * chip through.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_goes_through(atom/barrier)
	return boss_gorilla_goes_through(barrier)

/// All or nothing: whether its kit goes through every one of `blockers` (boss_line_blockers()), so it never breaks a grille only to meet glass it can't
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gets_through(list/blockers)
	if(!length(blockers))
		return TRUE
	for(var/atom/blocker as anything in blockers)
		if(!boss_goes_through(blocker))
			return FALSE
	return TRUE

/**
 * Whether what gets it through `barrier` is ready now, so walking up to it is worth more than going
 * round: Gorilla Arms that aren't already at something. Each kit adds its own ability that breaks or
 * crosses it, off cooldown. With it on cooldown, the boss goes round on foot if it can (the breach
 * planner).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_breaks_through_now(atom/barrier)
	return boss_busy != BOUNTY_BOSS_BUSY_SMASH && boss_gorilla_goes_through(barrier)

/// Its ability of `ability_type`, if it has one off cooldown
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_ability_off_cooldown(ability_type)
	for(var/datum/action/cooldown/mob_cooldown/bounty_boss/ability as anything in boss_abilities)
		if(!QDELETED(ability) && istype(ability, ability_type))
			return ability.next_use_time <= world.time ? ability : null
	return null

/// What it can open on its own feet, for working out a walk: the access its AI's pathing uses
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_pass_info()
	return new /datum/can_pass_info(src, ai_controller ? ai_controller.get_access() : get_access())

/**
 * The first thing on the straight way from `start` to `finish` that stops it walking: a wall, a gap
 * (space, a drop, lava, a chasm), or something solid it can't open or climb (a window, a grille, a
 * shut door, a table). Null if the way is clear. People never count.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_barrier_between(turf/start, turf/finish)
	var/list/blockers = boss_line_blockers(start, finish, TRUE)
	return length(blockers) ? blockers[1] : null

/**
 * Everything on the straight way from `start` to `finish` that stops it walking, in order: walls,
 * gaps, and every solid thing it can't open or climb on each step (a grille and the window on the
 * same tile are both there). With `first_only`, only the first step that is blocked.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_line_blockers(turf/start, turf/finish, first_only = FALSE)
	. = list()
	if(!start || !finish || start.z != finish.z)
		return
	var/datum/can_pass_info/pass_info = boss_pass_info()
	var/turf/previous = start
	for(var/turf/spot as anything in get_line(start, finish))
		if(spot == start)
			continue
		if(spot.density)
			. += spot
		else if(spot != finish && (isspaceturf(spot) || isopenspaceturf(spot) || isgroundlessturf(spot) || islava(spot) || ischasm(spot)))
			. += spot
		else if(previous.LinkBlockedWithAccess(spot, pass_info))
			var/list/on_step = boss_blockers_on_step(previous, spot, pass_info)
			if(length(on_step))
				// A full-tile window blocks the step off its tile as well as the step onto it: once is enough
				. |= on_step
			else
				. += spot
		if(first_only && length(.))
			return
		previous = spot

/**
 * What stops a step from `origin` onto `destination`: windows or doors on the edge between them, a
 * window filling `origin` (tg's pathing counts one as blocking the step off its tile too), and
 * everything solid on `destination`. A diagonal step is checked both ways round, giving what stops the
 * first way.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_blockers_on_step(turf/origin, turf/destination, datum/can_pass_info/pass_info)
	. = list()
	var/direction = get_dir(origin, destination)
	if(origin.x != destination.x && origin.y != destination.y)
		for(var/half in list(direction & (NORTH|SOUTH), direction & (EAST|WEST)))
			var/turf/middle = get_step(origin, half)
			if(!middle)
				continue
			if(middle.density)
				return list(middle)
			var/list/found = boss_blockers_on_step(origin, middle, pass_info) + boss_blockers_on_step(middle, destination, pass_info)
			if(length(found))
				return found
		return
	for(var/obj/border in origin)
		if(border.density && ((border.flags_1 & ON_BORDER_1) || istype(border, /obj/structure/window)) && !border.CanAStarPass(direction, pass_info))
			. += border
	var/reverse = get_dir(destination, origin)
	for(var/obj/thing in destination)
		if(thing.density && !thing.CanAStarPass(reverse, pass_info))
			. += thing

/// Whether a window or door stands on the edge between two tiles side by side
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_border_between(turf/origin, turf/destination)
	var/direction = get_dir(origin, destination)
	for(var/obj/border in origin)
		if(border.density && (border.flags_1 & ON_BORDER_1) && (border.dir & direction))
			return TRUE
	var/reverse = get_dir(destination, origin)
	for(var/obj/border in destination)
		if(border.density && (border.flags_1 & ON_BORDER_1) && (border.dir & reverse))
			return TRUE
	return FALSE

// ----- what a throw gets past -----

/**
 * Something it throws, never in the world: an item with a throw of its own and the boss as its thrower,
 * so tg's own CanPass() rules for a thrown item decide what stops it (windows, windoors, shut doors and
 * grilles do; tables, railings and gaps don't).
 */
/obj/item/bounty_boss_throw_probe
	name = "thrown thing"
	item_flags = ABSTRACT

/obj/item/bounty_boss_throw_probe/Destroy()
	QDEL_NULL(throwing)
	return ..()

/// Its throw probe, made the first time it is needed
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_get_throw_probe()
	if(QDELETED(boss_throw_probe))
		boss_throw_probe = new
	if(QDELETED(boss_throw_probe.throwing))
		boss_throw_probe.throwing = new /datum/thrownthing(boss_throw_probe, src, SOUTH, world.maxx, 1, src)
	return boss_throw_probe

/**
 * Whether something it throws from `start` lands on `finish`: it takes the steps tg's throw takes
 * (throw_at() and /datum/thrownthing/tick()), and each one must be a move tg would let a thrown item
 * make. People and mechs on the way never count.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_throw_reaches(turf/start, turf/finish)
	start = get_turf(start)
	finish = get_turf(finish)
	if(!start || !finish || start.z != finish.z)
		return FALSE
	if(start == finish)
		return TRUE
	var/obj/item/probe = boss_get_throw_probe()
	var/dist_x = abs(finish.x - start.x)
	var/dist_y = abs(finish.y - start.y)
	var/dx = (finish.x > start.x) ? EAST : WEST
	var/dy = (finish.y > start.y) ? NORTH : SOUTH
	var/pure_diagonal = dist_x == dist_y
	if(!pure_diagonal && dist_x <= dist_y)
		var/old_dist = dist_x
		dist_x = dist_y
		dist_y = old_dist
		var/old_dir = dx
		dx = dy
		dy = old_dir
	var/longest = max(dist_x, dist_y)
	var/diagonal_error = dist_x / 2 - dist_y
	var/turf/at = start
	for(var/travelled in 0 to longest)
		if(at == finish)
			return TRUE
		var/turf/step = get_step(at, get_dir(at, finish))
		if(!pure_diagonal)
			if(diagonal_error >= 0 && longest - travelled != 1)
				step = get_step(at, dx)
			diagonal_error += (diagonal_error < 0) ? dist_x / 2 : -dist_y
		if(!step || !bounty_boss_throw_move(at, step, probe))
			return FALSE
		at = step
	return at == finish

/// Whether a thrown thing gets past `barrier` (from boss_line_blockers()), by tg's rules for a thrown item: a gap yes, a wall no
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_throw_passes(atom/barrier)
	if(isturf(barrier))
		return !barrier.density
	var/border_dir = (barrier.flags_1 & ON_BORDER_1) ? barrier.dir : get_dir(barrier, src)
	return barrier.CanPass(boss_get_throw_probe(), border_dir)

/**
 * Whether `probe`, thrown, moves from `origin` onto `destination` beside it. A diagonal goes the way
 * tg's Move() takes one, north or south first; whatever stops that half is bumped, and a bump ends a
 * throw (/atom/movable/Bump()), so it never gets to try east or west first.
 */
/proc/bounty_boss_throw_move(turf/origin, turf/destination, obj/item/probe)
	var/direction = get_dir(origin, destination)
	if(!(direction & (direction - 1)))
		return bounty_boss_throw_step(origin, destination, probe)
	var/turf/first = get_step(origin, direction & (NORTH|SOUTH))
	return first && bounty_boss_throw_step(origin, first, probe) && bounty_boss_throw_step(first, destination, probe)

/// One straight step of a thrown `probe`: nothing on the edge of `origin` it leaves by, and tg's CanPass() of `destination` and all on it but people and mechs
/proc/bounty_boss_throw_step(turf/origin, turf/destination, obj/item/probe)
	var/direction = get_dir(origin, destination)
	for(var/atom/movable/border as anything in origin)
		if(border != probe && (border.flags_1 & ON_BORDER_1) && border.density && (border.dir & direction) && !border.CanPass(probe, direction))
			return FALSE
	var/from_dir = get_dir(destination, origin)
	if(!destination.CanPass(probe, from_dir))
		return FALSE
	for(var/atom/movable/thing as anything in destination)
		if(thing == probe || isliving(thing) || ismecha(thing))
			continue
		if(!thing.CanPass(probe, from_dir))
			return FALSE
	return TRUE

/**
 * Every tile it could walk to from where it stands, within BOUNTY_BOSS_REACH_RANGE and on its leash,
 * through nothing it can't open: turf -> steps, nearest first. Worked out again once it stands on
 * another tile, or after BOUNTY_BOSS_REACH_RETHINK on the same one, so the steps and the range are
 * always counted from where it is (review r2).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_walkable()
	var/turf/here = get_turf(src)
	if(!here)
		return list()
	if(boss_walk_cache && boss_walk_origin == here && world.time < boss_walk_at + BOUNTY_BOSS_REACH_RETHINK)
		return boss_walk_cache
	var/datum/can_pass_info/pass_info = boss_pass_info()
	var/list/steps = list()
	steps[here] = 0
	var/list/queue = list(here)
	var/index = 0
	while(index < length(queue))
		index++
		var/turf/spot = queue[index]
		var/next_steps = steps[spot] + 1
		for(var/direction in GLOB.cardinals)
			var/turf/next = get_step(spot, direction)
			if(!next || next.density || !isnull(steps[next]) || get_dist(here, next) > BOUNTY_BOSS_REACH_RANGE)
				continue
			if(spot.LinkBlockedWithAccess(next, pass_info) || !leash_ok(next))
				continue
			steps[next] = next_steps
			queue += next
	boss_walk_cache = steps
	boss_walk_origin = here
	boss_walk_at = world.time
	return steps

/// `hunter` just hurt it: if it can't get at them where they are, it keeps away from them for BOUNTY_BOSS_SHUN_TIME
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_note_reach(mob/living/hunter)
	if(!boss_can_act() || boss_can_reach(boss_target_for(hunter)))
		return FALSE
	boss_shunned[WEAKREF(hunter)] = world.time
	return TRUE

/// Whether it keeps away from `target` (a person, or a mech): one of them hurt it lately from where it couldn't get at them, and it still can't
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_shuns(atom/target)
	if(!length(boss_shunned))
		return FALSE
	for(var/mob/living/person as anything in boss_people_in(target))
		var/last = person.weak_reference ? boss_shunned[person.weak_reference] : null
		if(last && world.time < last + BOUNTY_BOSS_SHUN_TIME)
			return !boss_can_reach(target)
	return FALSE

/// The hunters it shuns who are still up and still out of its reach (their mechs, for those in one): whose sight it keeps out of. Forgets those it has shunned long enough.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_watchers()
	. = list()
	for(var/datum/weakref/ref as anything in boss_shunned.Copy())
		var/mob/living/person = ref.resolve()
		if(QDELETED(person) || world.time >= boss_shunned[ref] + BOUNTY_BOSS_SHUN_TIME)
			boss_shunned -= ref
			continue
		if(person.stat != CONSCIOUS)
			continue
		var/atom/watcher = boss_target_for(person)
		if(!boss_can_reach(watcher))
			. |= watcher

/**
 * Whether any of `watchers` can see `spot`: a clear line from them on its level. Within
 * BOUNTY_BOSS_COVER_SIGHT, and as far as the line goes past that, so a shooter further off (a scope,
 * the dock strip) never leaves it standing in the open thinking it is hidden (review r2).
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_seen_from(turf/spot, list/watchers)
	spot = get_turf(spot)
	if(!spot)
		return FALSE
	for(var/atom/watcher as anything in watchers)
		var/turf/from = get_turf(watcher)
		if(!from || from.z != spot.z)
			continue
		if(can_see(from, spot, max(BOUNTY_BOSS_COVER_SIGHT, get_dist(from, spot))))
			return TRUE
	return FALSE

/// It breaks for cover from someone it can't get at: a line for it, at most every BOUNTY_BOSS_COVER_BARK_COOLDOWN, so it reads as biding its time, not running
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_cover_bark()
	if(world.time < boss_cover_bark_at)
		return FALSE
	boss_cover_bark_at = world.time + BOUNTY_BOSS_COVER_BARK_COOLDOWN
	boss_bark("cover")
	return TRUE

/// How far `spot` is from the nearest of `watchers`
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_distance_from(turf/spot, list/watchers)
	. = INFINITY
	for(var/atom/watcher as anything in watchers)
		. = min(., get_dist(spot, watcher))

/**
 * Cover from `watchers`: the nearest tile it can walk to within BOUNTY_BOSS_COVER_RANGE steps that
 * none of them can see. With nowhere hidden, the one farthest from the nearest of them. Null if
 * where it stands is as good as any.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_find_cover(list/watchers)
	var/list/steps = boss_walkable()
	var/turf/here = get_turf(src)
	var/turf/far = here
	var/far_distance = boss_distance_from(here, watchers)
	// In order of steps, nearest first
	for(var/turf/spot as anything in steps)
		if(steps[spot] > BOUNTY_BOSS_COVER_RANGE || (spot != here && boss_someone_on(spot)))
			continue
		if(!boss_seen_from(spot, watchers))
			return spot
		var/distance = boss_distance_from(spot, watchers)
		if(distance > far_distance)
			far = spot
			far_distance = distance
	return far == here ? null : far

/// Whether someone else stands on `spot`, so it can't
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_someone_on(turf/spot)
	for(var/mob/living/other in spot)
		if(other != src && other.density)
			return TRUE
	return FALSE

/// The tile it walks to, to go through `barrier` at `target`: the last one before it on the straight way, if it can walk there
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_spot_before(atom/barrier, atom/target)
	var/turf/here = get_turf(src)
	var/turf/barrier_turf = get_turf(barrier)
	if(!here || !barrier_turf)
		return null
	var/turf/before
	for(var/turf/spot as anything in get_line(here, barrier_turf))
		if(spot == barrier_turf)
			break
		before = spot
	if(!before || before == here)
		return null
	var/list/steps = boss_walkable()
	return isnull(steps[before]) ? null : before

// ===== GORILLA ARMS THROUGH GLASS =====

/// Its working Gorilla Arms: the real implant, not EMP'd, browned out or failing
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gorilla_arms()
	. = list()
	for(var/obj/item/organ/cyberimp/cyberware/gorilla_arms/arm in organs)
		var/datum/component/cyberware/ware = arm.GetComponent(/datum/component/cyberware)
		if(ware?.is_running())
			. += arm

/// The hand index of `arm`'s own hand, if that hand is empty (the implant only punches with its own fist), else 0
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gorilla_hand(obj/item/organ/cyberimp/cyberware/gorilla_arms/arm)
	var/obj/item/bodypart/limb = get_bodypart(arm.zone)
	if(!limb?.held_index || !isnull(get_item_for_held_index(limb.held_index)))
		return 0
	return limb.held_index

/// Whether it has a working Gorilla Arm with an empty hand to punch with
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_has_gorilla_fist()
	for(var/obj/item/organ/cyberimp/cyberware/gorilla_arms/arm as anything in boss_gorilla_arms())
		if(boss_gorilla_hand(arm))
			return TRUE
	return FALSE

/// Whether its Gorilla Arms get it through `barrier`: one it may smash (boss_can_smash()), with a fist free to do it. Airlocks are left to the arms' own door forcing.
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_gorilla_goes_through(atom/barrier)
	return boss_has_gorilla_fist() && boss_can_smash(barrier)

/**
 * Whether its Gorilla Arms may go at `barrier`: a window, a grille, a table or a door that isn't an
 * airlock, where it may break things (boss_may_break(): its own site, indoors, never near a ship), and
 * one the implant's punches break in at most BOUNTY_BOSS_SMASH_MOST_BLOWS through its armour.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_can_smash(atom/barrier)
	if(!isobj(barrier) || istype(barrier, /obj/machinery/door/airlock))
		return FALSE
	if(!istype(barrier, /obj/structure/window) && !istype(barrier, /obj/structure/grille) && !istype(barrier, /obj/structure/table) && !istype(barrier, /obj/machinery/door))
		return FALSE
	var/obj/thing = barrier
	if(!thing.uses_integrity || !boss_may_break(thing))
		return FALSE
	var/blow = thing.run_atom_armor(BOUNTY_BOSS_SMASH_BLOW, BRUTE, MELEE, get_dir(thing, src))
	return blow > 0 && thing.get_integrity() <= blow * BOUNTY_BOSS_SMASH_MOST_BLOWS

/**
 * Its Gorilla Arms go at `barrier`, right beside it. The tell first, for BOUNTY_BOSS_SMASH_WINDUP:
 * rooted, an orange glow, the barrier's tile lit and the pistons heard. Then real punches with its
 * empty Gorilla fists (boss_smash_blow()), each the implant's own, until the barrier is down, the
 * punches run out or something stops it. Nobody is hurt by it. Returns TRUE if it started.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_start_smash(atom/barrier)
	if(!boss_can_use_ability() || !ai_controller || !Adjacent(barrier) || !boss_has_gorilla_fist() || !boss_can_smash(barrier))
		return FALSE
	var/smash_time = BOUNTY_BOSS_SMASH_WINDUP + BOUNTY_BOSS_SMASH_MOST_BLOWS * 1 SECONDS
	var/serial = boss_set_busy(BOUNTY_BOSS_BUSY_SMASH, smash_time + 1 SECONDS)
	boss_next_ability_at = max(boss_next_ability_at, world.time + BOUNTY_BOSS_SMASH_WINDUP + BOUNTY_BOSS_SMASH_RECOVER)
	boss_smash_target = WEAKREF(barrier)
	boss_smash_blows = 0
	face_atom(barrier)
	visible_message(span_boldwarning("[src] draws back a piston-driven fist at [barrier]!"), blind_message = span_hear("You hear pistons hiss."))
	playsound(src, 'sound/machines/piston/piston_raise.ogg', 60, TRUE)
	add_filter(BOUNTY_BOSS_SMASH_FILTER, 2, outline_filter(1, BOUNTY_BOSS_SMASH_COLOR))
	boss_smash_mark = WEAKREF(new /obj/effect/temp_visual/bounty_boss_mark(get_turf(barrier), smash_time, BOUNTY_BOSS_SMASH_COLOR))
	addtimer(CALLBACK(src, PROC_REF(boss_smash_blow), serial), BOUNTY_BOSS_SMASH_WINDUP, TIMER_DELETE_ME)
	return TRUE

/**
 * One punch of the smash under `serial` at its barrier: the empty fist of a working Gorilla Arm whose
 * own cooldown is over is made the active hand, and the barrier is clicked with it in combat mode, the
 * way a player punches (controller.ai_interact()). The implant does the damage. The next punch follows
 * when the body and an arm are ready again. Returns TRUE if it threw one.
 */
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_smash_blow(serial)
	if(!boss_still(BOUNTY_BOSS_BUSY_SMASH, serial))
		return FALSE
	var/obj/barrier = boss_smash_target?.resolve()
	if(QDELETED(barrier) || !barrier.density || !Adjacent(barrier) || boss_smash_blows >= BOUNTY_BOSS_SMASH_MOST_BLOWS || !boss_may_break(barrier) || !boss_has_gorilla_fist())
		boss_end_smash(serial)
		return FALSE
	var/threw = FALSE
	if(next_move <= world.time)
		for(var/obj/item/organ/cyberimp/cyberware/gorilla_arms/arm as anything in boss_gorilla_arms())
			var/hand = boss_gorilla_hand(arm)
			if(!hand || !COOLDOWN_FINISHED(arm, slam_cooldown))
				continue
			swap_hand(hand, silent = TRUE)
			if(get_active_held_item())
				continue
			var/is_door = istype(barrier, /obj/machinery/door)
			boss_smash_blows++
			ai_controller.ai_interact(target = barrier, combat_mode = TRUE)
			threw = TRUE
			// A door it punches down spends its wall budget, as one any ability breaks does
			if(is_door && (QDELETED(barrier) || barrier.get_integrity() <= 0))
				boss_walls_left--
			break
	if(QDELETED(barrier) || !barrier.density || boss_smash_blows >= BOUNTY_BOSS_SMASH_MOST_BLOWS)
		boss_end_smash(serial)
		return threw
	addtimer(CALLBACK(src, PROC_REF(boss_smash_blow), serial), boss_smash_wait(), TIMER_DELETE_ME)
	return threw

/// How long until it can throw its next smash punch: its body's click and the soonest arm's own cooldown, at least a tick
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_smash_wait()
	var/soonest = INFINITY
	for(var/obj/item/organ/cyberimp/cyberware/gorilla_arms/arm as anything in boss_gorilla_arms())
		if(boss_gorilla_hand(arm))
			soonest = min(soonest, arm.slam_cooldown)
	if(soonest == INFINITY)
		soonest = world.time
	return max(1, next_move - world.time, soonest - world.time)

/// The smash is over, or never was: the tell goes, and with `serial` (or none) it is no longer busy with it
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_end_smash(serial)
	boss_end_smash_telegraph()
	boss_smash_target = null
	boss_smash_blows = 0
	if(boss_busy == BOUNTY_BOSS_BUSY_SMASH && (!serial || serial == boss_busy_serial))
		boss_clear_busy(serial)

/// The smash's glow and floor mark go
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_end_smash_telegraph()
	remove_filter(BOUNTY_BOSS_SMASH_FILTER)
	var/obj/effect/mark = boss_smash_mark?.resolve()
	boss_smash_mark = null
	if(!QDELETED(mark))
		qdel(mark)

// ===== SIGNALS =====

/**
 * The boss's signal hooks, on a component of their own so they never replace a handler P2 or P3
 * registers on the same mob for the same signal. Each one hands over to a boss proc. Being disabled is
 * read from tg's own state changes: crit, cuffs, stamcrit, stuns and knockdowns (CB-24).
 */
/datum/component/bounty_boss_signals

/datum/component/bounty_boss_signals/Initialize()
	if(!istype(parent, /mob/living/carbon/human/npc/bounty_criminal/boss))
		return COMPONENT_INCOMPATIBLE

/datum/component/bounty_boss_signals/RegisterWithParent()
	RegisterSignal(parent, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(on_attacked))
	RegisterSignal(parent, COMSIG_AI_BLACKBOARD_KEY_SET(BB_BASIC_MOB_CURRENT_TARGET), PROC_REF(on_target))
	RegisterSignals(parent, list(
		SIGNAL_ADDTRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_ADDTRAIT(TRAIT_RESTRAINED),
		SIGNAL_ADDTRAIT(TRAIT_INCAPACITATED),
		SIGNAL_ADDTRAIT(TRAIT_FLOORED),
		COMSIG_LIVING_ENTER_STAMCRIT,
	), PROC_REF(on_disabled))
	RegisterSignal(parent, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_prehit))
	RegisterSignal(parent, COMSIG_MOB_AFTER_APPLY_DAMAGE, PROC_REF(on_damaged))
	RegisterSignal(parent, COMSIG_ATOM_ATTACKBY, PROC_REF(on_attackby))
	RegisterSignal(parent, COMSIG_MOB_FLASHED, PROC_REF(on_flashed))
	RegisterSignal(parent, COMSIG_MOB_ITEM_ATTACK, PROC_REF(on_item_attack))

/datum/component/bounty_boss_signals/UnregisterFromParent()
	UnregisterSignal(parent, list(
		COMSIG_ATOM_WAS_ATTACKED,
		COMSIG_AI_BLACKBOARD_KEY_SET(BB_BASIC_MOB_CURRENT_TARGET),
		SIGNAL_ADDTRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_ADDTRAIT(TRAIT_RESTRAINED),
		SIGNAL_ADDTRAIT(TRAIT_INCAPACITATED),
		SIGNAL_ADDTRAIT(TRAIT_FLOORED),
		COMSIG_LIVING_ENTER_STAMCRIT,
		COMSIG_PROJECTILE_PREHIT,
		COMSIG_MOB_AFTER_APPLY_DAMAGE,
		COMSIG_ATOM_ATTACKBY,
		COMSIG_MOB_FLASHED,
		COMSIG_MOB_ITEM_ATTACK,
	))

// A person or a mech (relay_attackers reports mech melee with the mech as the attacker).
/datum/component/bounty_boss_signals/proc/on_attacked(mob/living/carbon/human/npc/bounty_criminal/boss/source, atom/attacker, attack_flags)
	SIGNAL_HANDLER
	if(!(attack_flags & (ATTACKER_DAMAGING_ATTACK | ATTACKER_STAMINA_ATTACK)))
		return
	source.boss_note_attacker(attacker)

/datum/component/bounty_boss_signals/proc/on_target(mob/living/carbon/human/npc/bounty_criminal/boss/source)
	SIGNAL_HANDLER
	var/atom/target = source.ai_controller?.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	for(var/mob/living/person as anything in source.boss_people_in(target))
		if(bounty_boss_is_hunter(person))
			source.boss_turn_hostile(person)

/datum/component/bounty_boss_signals/proc/on_disabled(mob/living/carbon/human/npc/bounty_criminal/boss/source)
	SIGNAL_HANDLER
	source.boss_interrupt()

/datum/component/bounty_boss_signals/proc/on_prehit(mob/living/carbon/human/npc/bounty_criminal/boss/source, obj/projectile/shot)
	SIGNAL_HANDLER
	// relay_attackers drops shots whose firer isn't a mob, so a mech's gunfire is noted here (H2).
	if(ismecha(shot.firer) && shot.is_hostile_projectile())
		source.boss_note_attacker(shot.firer)
	return NONE

/datum/component/bounty_boss_signals/proc/on_damaged(mob/living/carbon/human/npc/bounty_criminal/boss/source, damage, damagetype)
	SIGNAL_HANDLER
	if(damage > 0)
		source.boss_took_damage(damage, damagetype)

/datum/component/bounty_boss_signals/proc/on_attackby(mob/living/carbon/human/npc/bounty_criminal/boss/source, obj/item/attacking_item, mob/living/user)
	SIGNAL_HANDLER
	var/obj/item/assembly/flash/flash = attacking_item
	if(istype(flash) && !flash.burnt_out && isliving(user))
		source.boss_flashed(user)
	return NONE

/datum/component/bounty_boss_signals/proc/on_flashed(mob/living/carbon/human/npc/bounty_criminal/boss/source)
	SIGNAL_HANDLER
	source.boss_flashed()

/datum/component/bounty_boss_signals/proc/on_item_attack(mob/living/carbon/human/npc/bounty_criminal/boss/source, mob/living/target, mob/living/user)
	SIGNAL_HANDLER
	if(user == source && isliving(target) && target != source)
		source.boss_landed_blow(target, source.get_active_held_item())
	return NONE

// Kit hooks for those signals. None of them may sleep.

/// Damage landed on it
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_took_damage(damage, damagetype)
	SHOULD_NOT_SLEEP(TRUE)
	return

/// Flashed, by a handheld flash (`user`) or a flash going off near it
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_flashed(mob/living/user)
	SHOULD_NOT_SLEEP(TRUE)
	return

/// It swung `weapon` at `victim` with its own hand
/mob/living/carbon/human/npc/bounty_criminal/boss/proc/boss_landed_blow(mob/living/victim, obj/item/weapon)
	SHOULD_NOT_SLEEP(TRUE)
	return

// ===== THE ABILITY BASE =====

/**
 * A boss's ability. Activate() starts a wind-up of `windup`: the boss stands still and telegraph()
 * shows everyone where it will land, with a sound. When the wind-up is over, effect() does the harm,
 * unless the boss was downed, restrained, stunned, knocked down or killed meanwhile (a stale serial,
 * or boss_can_act() failing). Tests call finish_windup(pending_serial) instead of waiting.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss
	name = "Criminal trick"
	desc = "Something a wanted criminal can do."
	button_icon = 'icons/mob/actions/actions_items.dmi'
	button_icon_state = "sniper_zoom"
	cooldown_time = 10 SECONDS
	shared_cooldown = NONE
	melee_cooldown_time = 0
	click_to_activate = TRUE
	/// How long it winds up, telegraphing, before anything lands
	var/windup = 1 SECONDS
	/// How long the effect itself keeps the boss busy after the wind-up (a charge, a burst), so the next ability waits for it
	var/effect_time = 0
	/// The serial of the wind-up under way, checked when it ends; 0 when none
	var/pending_serial = 0
	/// What the wind-up is aimed at
	var/datum/weakref/pending_target
	/// Weakrefs to telegraph visuals and beams still showing, removed when the wind-up ends or is cancelled
	var/list/telegraphs
	/// Weakrefs to marks that stay on past the wind-up until the thing lands (L3), removed only if the wind-up is cancelled
	var/list/lingering
	/// Structures this use may still damage: a one-item list a helper counts down
	var/list/structure_tally

/datum/action/cooldown/mob_cooldown/bounty_boss/Destroy()
	clear_telegraphs(TRUE)
	pending_target = null
	structure_tally = null
	return ..()

/datum/action/cooldown/mob_cooldown/bounty_boss/IsAvailable(feedback = FALSE)
	. = ..()
	if(!.)
		return FALSE
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	return istype(boss) && boss.boss_can_use_ability()

/// Whether it is worth using on `target` now: in range, in sight, and so on
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/worth_using(atom/target)
	return !QDELETED(target)

/// Whether `target` is something its abilities go for: a person, or a mech (H2)
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/aimable(atom/target)
	return !QDELETED(target) && (isliving(target) || ismecha(target))

/// Whether a thrown or fired ability may be aimed at where `target` stands (M2)
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/landing_ok(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	return istype(boss) && boss.boss_landing_ok(get_turf(target))

/// Whether something it throws from where it stands would land where `target` stands, and not stop on glass or a door on the way
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/throw_reaches(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	return istype(boss) && boss.boss_throw_reaches(get_turf(boss), get_turf(target))

/datum/action/cooldown/mob_cooldown/bounty_boss/Activate(atom/target)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || QDELETED(target))
		return FALSE
	var/serial = boss.boss_begin_ability(src)
	if(!serial)
		return FALSE
	StartCooldown(cooldown_time)
	pending_serial = serial
	pending_target = WEAKREF(target)
	// Marks left lingering from the last use look after themselves.
	lingering = null
	boss.face_atom(target)
	boss.boss_bark("ability")
	telegraph(target)
	addtimer(CALLBACK(src, PROC_REF(finish_windup), serial), windup, TIMER_DELETE_ME)
	return TRUE

/**
 * The wind-up under `serial` is over: effect(), if the boss is still winding up under that serial
 * and can act. Returns TRUE if the effect ran.
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/finish_windup(serial)
	if(!serial || serial != pending_serial)
		return FALSE
	var/atom/target = pending_target?.resolve()
	pending_serial = 0
	pending_target = null
	clear_telegraphs()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss) || boss.boss_busy != "windup" || boss.boss_busy_serial != serial || !boss.boss_can_act())
		return FALSE
	boss.boss_winding_ref = null
	boss.boss_clear_busy(serial)
	structure_tally = list(BOUNTY_BOSS_ABILITY_STRUCTURE_CAP)
	effect(target)
	return TRUE

/// The wind-up was cut short: its telegraph goes and nothing lands
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/cancel_windup()
	pending_serial = 0
	pending_target = null
	clear_telegraphs(TRUE)

/// Shows where it will land and how, with a sound, for the wind-up
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/telegraph(atom/target)
	return

/// What it does once the wind-up is over. `target` may be gone by then.
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/effect(atom/target)
	return

/// Keeps track of a telegraph visual or beam: removed when the wind-up ends, or with `linger` only if it is cancelled
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/add_telegraph(datum/thing, linger = FALSE)
	if(thing)
		if(linger)
			LAZYADD(lingering, WEAKREF(thing))
		else
			LAZYADD(telegraphs, WEAKREF(thing))
	return thing

/// Removes the wind-up's telegraph, and with `all` the marks that were to linger past it too
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/clear_telegraphs(all = FALSE)
	var/list/to_clear = telegraphs
	telegraphs = null
	if(all)
		to_clear = (to_clear || list()) + (lingering || list())
		lingering = null
	for(var/datum/weakref/ref as anything in to_clear)
		var/datum/thing = ref.resolve()
		if(!QDELETED(thing))
			qdel(thing)

/**
 * Marks `turfs` for the length of the wind-up, and `linger` longer: a thrown thing's landing stays
 * marked until it lands, a burst's cone until the last round (L3).
 */
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/mark_turfs(list/turfs, mark_color, mark_state = "target_box", linger = 0)
	for(var/turf/spot as anything in turfs)
		add_telegraph(new /obj/effect/temp_visual/bounty_boss_mark(spot, windup + linger, mark_color, mark_state), linger > 0)

/// Damages `thing` as part of this use, within its cap and the fight's wall budget
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/break_thing(atom/thing, damage, damage_flag = MELEE)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = owner
	if(!istype(boss))
		return FALSE
	if(!structure_tally)
		structure_tally = list(BOUNTY_BOSS_ABILITY_STRUCTURE_CAP)
	return boss.boss_damage_structure(thing, damage, structure_tally, damage_flag)

/// Turfs up to `range` from the boss within `arc` degrees (full width) of the direction to `target`, and in a clear line from it
/datum/action/cooldown/mob_cooldown/bounty_boss/proc/cone_turfs(atom/target, range, arc)
	. = list()
	var/turf/origin = get_turf(owner)
	var/turf/aim = get_turf(target)
	if(!origin || !aim || origin == aim)
		return
	var/facing = get_angle(origin, aim)
	for(var/turf/spot in RANGE_TURFS(range, origin))
		if(spot == origin || get_dist(origin, spot) > range)
			continue
		var/difference = abs(get_angle(origin, spot) - facing)
		if(difference > 180)
			difference = 360 - difference
		if(difference > arc / 2)
			continue
		if(bounty_boss_clear_line(origin, spot))
			. += spot

/// Whether nothing solid stands between `start` and `finish`: no walls, and nothing dense but mobs on the tiles between
/proc/bounty_boss_clear_line(turf/start, turf/finish)
	if(!start || !finish || start.z != finish.z)
		return FALSE
	for(var/turf/spot as anything in get_line(start, finish))
		if(spot == start)
			continue
		if(isclosedturf(spot))
			return FALSE
		if(spot != finish && spot.is_blocked_turf(exclude_mobs = TRUE))
			return FALSE
	return TRUE

// ===== TELEGRAPH AND FIRE VISUALS =====

/// A mark on the floor for the length of a wind-up or a fuse
/obj/effect/temp_visual/bounty_boss_mark
	icon = 'icons/mob/telegraphing/telegraph_holographic.dmi'
	icon_state = "target_box"
	layer = BELOW_MOB_LAYER
	plane = GAME_PLANE
	duration = 1 SECONDS

/obj/effect/temp_visual/bounty_boss_mark/Initialize(mapload, new_duration, new_color, new_state)
	if(new_duration)
		duration = new_duration
	if(new_color)
		color = new_color
	if(new_state)
		icon_state = new_state
	return ..()

/// Blinks, for a fuse
/obj/effect/temp_visual/bounty_boss_mark/proc/blink()
	animate(src, alpha = 70, time = 2, loop = -1)
	animate(alpha = 255, time = 2)

/// Flames on the floor, for as long as the fire burns
/obj/effect/temp_visual/bounty_boss_flames
	icon = 'icons/effects/fire.dmi'
	icon_state = "light"
	layer = ABOVE_OPEN_TURF_LAYER
	plane = GAME_PLANE
	duration = 4 SECONDS

/obj/effect/temp_visual/bounty_boss_flames/Initialize(mapload, new_duration)
	if(new_duration)
		duration = new_duration
	icon_state = pick("light", "medium")
	return ..()

// ===== FIRE =====

/**
 * A patch of a boss's fire: flames on `turfs` for `lifetime`, only where its boss's abilities may
 * reach (never off its site or in a ship, hangar or outpost, M2). The patch itself is scripted: it
 * makes no gas and no hotspot and lights nothing, so it never spreads or sets off fire alarms (site
 * safety). Whoever it catches burns for real (CB-8): `landing_damage` burn against fire armour where it
 * first lands, then tg's own fire stacks and ignite_mob() (`new_landing_stacks` on landing,
 * BOUNTY_BOSS_FIRE_TICK_STACKS every second they stand in it), whatever state they are in. From then on
 * it is tg's fire on them: firesuits, stop-drop-and-roll, extinguishers, showers and wet clothes all
 * work. A mech with someone in it takes the burn on its hull. Capped at BOUNTY_BOSS_FIRE_POOL_CAP.
 */
/obj/effect/bounty_boss_fire_pool
	name = "fire"
	anchored = TRUE
	mouse_opacity = MOUSE_OPACITY_TRANSPARENT
	invisibility = INVISIBILITY_ABSTRACT
	light_range = 3
	light_power = 1
	light_color = LIGHT_COLOR_FIRE
	/// The tiles burning
	var/list/turfs
	/// The boss whose fire it is, for who it catches
	var/datum/weakref/boss_ref
	/// Its boss's factions when it was lit: its fire never catches its own side, even with the boss gone
	var/list/side_factions
	/// Its boss's zone damage factor when it was lit (1 for a human boss)
	var/damage_factor = 1
	/// Fire stacks it puts on whoever it catches where it first lands
	var/landing_stacks = BOUNTY_BOSS_FIRE_TICK_STACKS

/obj/effect/bounty_boss_fire_pool/Initialize(mapload, list/fire_turfs, lifetime, mob/living/carbon/human/npc/bounty_criminal/boss/boss, landing_damage = 0, new_landing_stacks)
	. = ..()
	if(length(GLOB.bounty_boss_fire_pools) >= BOUNTY_BOSS_FIRE_POOL_CAP)
		return INITIALIZE_HINT_QDEL
	GLOB.bounty_boss_fire_pools += src
	lifetime = lifetime || 4 SECONDS
	if(!isnull(new_landing_stacks))
		landing_stacks = new_landing_stacks
	turfs = list()
	for(var/turf/spot as anything in fire_turfs)
		if(isturf(spot) && !isclosedturf(spot) && (!boss || boss.boss_reach_ok(spot)))
			turfs += spot
	if(!length(turfs))
		return INITIALIZE_HINT_QDEL
	boss_ref = boss ? WEAKREF(boss) : null
	side_factions = boss ? boss.faction.Copy() : null
	damage_factor = boss ? boss.get_npc_zone_damage_factor() : 1
	// Invisible, but the light comes from here: sit it where the fire is.
	var/turf/middle = turfs[round((length(turfs) + 1) / 2)]
	if(middle != loc)
		forceMove(middle)
	for(var/turf/spot as anything in turfs)
		new /obj/effect/temp_visual/bounty_boss_flames(spot, lifetime)
	scorch(landing_damage, landing_stacks)
	addtimer(CALLBACK(src, PROC_REF(scorch)), 1 SECONDS, TIMER_LOOP | TIMER_DELETE_ME)
	addtimer(CALLBACK(src, PROC_REF(burn_out)), lifetime, TIMER_DELETE_ME)

/obj/effect/bounty_boss_fire_pool/Destroy()
	GLOB.bounty_boss_fire_pools -= src
	turfs = null
	boss_ref = null
	side_factions = null
	return ..()

/// Whether it catches `victim`: its boss's rules, or with the boss gone, anyone not on the boss's side. Never by the victim's state (CB-11).
/obj/effect/bounty_boss_fire_pool/proc/may_burn(atom/victim)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = boss_ref?.resolve()
	if(!QDELETED(boss))
		return boss.boss_effect_hits(victim)
	return bounty_boss_effect_victim(victim, side_factions)

/**
 * Catches everyone in the flames: `damage` burn against fire armour if given (the jet or the bottle
 * landing), then `stacks` of tg's fire stacks and ignite_mob(). Mechs take the burn on the hull.
 */
/obj/effect/bounty_boss_fire_pool/proc/scorch(damage = 0, stacks = BOUNTY_BOSS_FIRE_TICK_STACKS)
	for(var/turf/spot as anything in turfs)
		for(var/atom/movable/thing as anything in spot)
			if(!(isliving(thing) || ismecha(thing)) || !may_burn(thing))
				continue
			if(ismecha(thing))
				var/obj/vehicle/sealed/mecha/mech = thing
				mech.take_damage(npc_zone_damage(max(damage, 3), damage_factor), BURN, FIRE, FALSE)
				continue
			var/mob/living/victim = thing
			if(damage > 0)
				victim.apply_damage(npc_zone_damage(damage, damage_factor), BURN, blocked = victim.run_armor_check(null, FIRE, silent = TRUE), spread_damage = TRUE)
				to_chat(victim, span_userdanger("You're caught in the flames!"))
			if(stacks > 0)
				victim.adjust_fire_stacks(stacks)
				victim.ignite_mob()

/obj/effect/bounty_boss_fire_pool/proc/burn_out()
	qdel(src)

// ===== THE MIND =====

/**
 * Its planning, on a real human body (contract 2.4): soft crit and breaking free first; nothing while
 * it is busy or can't act; worn out, it falls back; its target; its combat sense (a stimulant when it
 * tires, and a kit's own reaction to stun fire); its kit's gear; drawing
 * its weapon once its fight has started; an ability; the kit's way of closing in or keeping away; up to
 * and through whatever is in its way; its melee with what it holds; patching itself up with nobody
 * about; with nobody in sight, the hunt for the nearest hunter still on its site that it can get at;
 * and with nobody it can get at, out of the sight of those shooting at it from where it can't. Bosses
 * never surrender.
 */
/datum/ai_controller/basic_controller/bounty_boss
	blackboard = list(
		BB_TARGETING_STRATEGY = /datum/targeting_strategy/basic/human_npc/bounty_boss,
		BB_TARGET_MINIMUM_STAT = HUMAN_NPC_SPARES_DOWNED,
		BB_AGGRO_RANGE = BOUNTY_BOSS_POSSE_RANGE,
	)
	ai_movement = /datum/ai_movement/jps/bounty
	idle_behavior = null
	planning_subtrees = list(
		/datum/ai_planning_subtree/human_npc_soft_crit,
		/datum/ai_planning_subtree/bounty_escape_captivity,
		/datum/ai_planning_subtree/bounty_boss_busy,
		/datum/ai_planning_subtree/bounty_boss_worn_out,
		/datum/ai_planning_subtree/bounty_boss_target,
		/datum/ai_planning_subtree/simple_find_target,
		/datum/ai_planning_subtree/npc_combat_sense,
		/datum/ai_planning_subtree/bounty_boss_gear,
		/datum/ai_planning_subtree/human_npc_arm/bounty_boss,
		/datum/ai_planning_subtree/bounty_boss_abilities,
		/datum/ai_planning_subtree/bounty_boss_engage,
		/datum/ai_planning_subtree/bounty_boss_breach,
		/datum/ai_planning_subtree/human_npc_melee,
		/datum/ai_planning_subtree/bounty_treat_self,
		/datum/ai_planning_subtree/bounty_boss_hunt,
		/datum/ai_planning_subtree/bounty_boss_cover,
	)

/datum/ai_controller/basic_controller/bounty_boss/TryPossessPawn(atom/new_pawn)
	if(!ishumannpc(new_pawn))
		return AI_CONTROLLER_INCOMPATIBLE
	return ..()

// Cuffs and soft crit don't stop it (the human NPC base's run check), so it can work at its cuffs and crawl.
/datum/ai_controller/basic_controller/bounty_boss/get_able_to_run()
	return human_npc_ai_able_to_run(src)

/datum/ai_controller/basic_controller/bounty_boss/on_stat_changed(mob/living/source, new_stat)
	. = ..()
	human_npc_ai_stat_changed(src, new_stat)

/**
 * Hunters it may go after, and mechs with one in them (H2); never anyone already down (C4,
 * npc_target_stat). tg's own mech branch would test the pilot, whom it only hurts through the mech, so
 * a mech is judged here.
 */
/datum/targeting_strategy/basic/human_npc/bounty_boss

/datum/targeting_strategy/basic/human_npc/bounty_boss/can_attack(mob/living/living_mob, atom/the_target, vision_range)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = living_mob
	if(!istype(boss) || !boss.boss_valid_target(the_target))
		return FALSE
	if(ismecha(the_target))
		var/range = vision_range || BOUNTY_BOSS_POSSE_RANGE
		return isturf(boss.loc) && the_target.z == boss.z && get_dist(boss, the_target) <= range && can_see(boss, the_target, range)
	return ..()

/// Nothing at all while it winds up, charges or bursts, or while it can't act (tg's states)
/datum/ai_planning_subtree/bounty_boss_busy

/datum/ai_planning_subtree/bounty_boss_busy/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || boss.boss_busy || !boss.boss_can_act())
		return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Worn out (boss_is_worn_out(), its body's real state): the first time, it says so and shows it to
 * the hunters (boss_wear_out()). If it wants a stimulant pen now (combat sense's own rule: winded, in a
 * fight, none in its blood) it takes it first; then it falls back from whoever it was fighting for
 * BOUNTY_BOSS_FALLBACK_TIME and fights on. Back above the line (healed, or its stamina back), it is fresh
 * again.
 */
/datum/ai_planning_subtree/bounty_boss_worn_out

/datum/ai_planning_subtree/bounty_boss_worn_out/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	if(!boss.boss_is_worn_out())
		boss.boss_worn_out = FALSE
		boss.boss_fallback_until = 0
		return
	if(!boss.boss_worn_out)
		boss.boss_wear_out()
	var/datum/component/npc_combat_sense/sense = boss.GetComponent(/datum/component/npc_combat_sense)
	if(sense?.rules.can_act(boss, controller) && sense.rules.plan_stim(boss, controller, sense))
		return SUBTREE_RETURN_FINISH_PLANNING
	if(world.time >= boss.boss_fallback_until)
		boss.boss_fallback_until = 0
		return
	var/atom/threat = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET] || boss.boss_revenge_target()
	if(QDELETED(threat))
		return
	controller.set_blackboard_key(BB_BOUNTY_BOSS_FALL_BACK_FROM, threat)
	controller.queue_behavior(/datum/ai_behavior/run_away_from_target, BB_BOUNTY_BOSS_FALL_BACK_FROM)
	return SUBTREE_RETURN_FINISH_PLANNING

/// Drops a target it may no longer go after, and turns on whoever hurt it last when it has none
/datum/ai_planning_subtree/bounty_boss_target

/datum/ai_planning_subtree/bounty_boss_target/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[BB_TARGETING_STRATEGY])
	var/atom/current = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(current && !strategy?.can_attack(boss, current, BOUNTY_BOSS_POSSE_RANGE))
		controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		current = null
	if(current)
		return
	var/mob/living/avenge = boss.boss_revenge_target()
	if(avenge && strategy?.can_attack(boss, avenge, BOUNTY_BOSS_POSSE_RANGE))
		controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, avenge)

/// The kit's own gear, once its fight is on: a Heavy changing the belt in its gun
/datum/ai_planning_subtree/bounty_boss_gear

/datum/ai_planning_subtree/bounty_boss_gear/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	if(boss.boss_gear_plan(controller))
		return SUBTREE_RETURN_FINISH_PLANNING

/// The human NPC base's arming (reload or draw what it carries), only once its fight has started: until then its weapon stays where it carries it
/datum/ai_planning_subtree/human_npc_arm/bounty_boss

/datum/ai_planning_subtree/human_npc_arm/bounty_boss/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	return ..()

/// One ability, if one is ready, worth it, and not the one it used last
/datum/ai_planning_subtree/bounty_boss_abilities

/datum/ai_planning_subtree/bounty_boss_abilities/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(QDELETED(target))
		return
	var/datum/action/cooldown/mob_cooldown/bounty_boss/ability = boss.boss_choose_ability(target)
	if(!ability)
		return
	controller.set_blackboard_key(BB_BOUNTY_BOSS_ABILITY, ability)
	controller.set_blackboard_key(BB_BOUNTY_BOSS_ABILITY_TARGET, target)
	controller.queue_behavior(/datum/ai_behavior/bounty_boss_ability, BB_BOUNTY_BOSS_ABILITY, BB_BOUNTY_BOSS_ABILITY_TARGET)
	return SUBTREE_RETURN_FINISH_PLANNING

/datum/ai_behavior/bounty_boss_ability

/datum/ai_behavior/bounty_boss_ability/perform(seconds_per_tick, datum/ai_controller/controller, ability_key, target_key)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/datum/action/cooldown/mob_cooldown/bounty_boss/ability = controller.blackboard[ability_key]
	var/atom/target = controller.blackboard[target_key]
	if(QDELETED(ability) || QDELETED(target))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	boss.face_atom(target)
	return ability.Trigger(target = target) ? (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED) : (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED)

/datum/ai_behavior/bounty_boss_ability/finish_action(datum/ai_controller/controller, succeeded, ability_key, target_key)
	. = ..()
	controller.clear_blackboard_key(ability_key)
	controller.clear_blackboard_key(target_key)

/// The kit's own way of fighting: keeping its distance, breaking off
/datum/ai_planning_subtree/bounty_boss_engage

/datum/ai_planning_subtree/bounty_boss_engage/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(QDELETED(target))
		return
	if(boss.boss_engage_plan(controller, target))
		return SUBTREE_RETURN_FINISH_PLANNING

/**
 * One real step away from `target_key`'s target, onto ground its leash allows (P2's
 * body_step_away_from()): tg's step_away walks on a movement that knows nothing of the leash.
 */
/datum/ai_behavior/bounty_boss_back_off
	action_cooldown = 0.3 SECONDS
	behavior_flags = AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION

// No quicker than its body walks: armour, wounds and stamina slow it as they slow anyone.
/datum/ai_behavior/bounty_boss_back_off/get_cooldown(datum/ai_controller/cooldown_for)
	var/mob/living/pawn = cooldown_for?.pawn
	return max(action_cooldown, pawn?.cached_multiplicative_slowdown || 0)

/datum/ai_behavior/bounty_boss_back_off/perform(seconds_per_tick, datum/ai_controller/controller, target_key)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[target_key]
	if(!istype(boss) || QDELETED(target) || !boss.boss_can_act())
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	boss.face_atom(target)
	return boss.body_step_away_from(target) ? (AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED) : (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED)

/**
 * Nobody in sight while hostile: it goes after the nearest hunter still on its site, looking again
 * every BOUNTY_BOSS_HUNT_INTERVAL. With nobody on the site for BOUNTY_BOSS_CALM_TIME it calms down.
 */
/datum/ai_planning_subtree/bounty_boss_hunt

/datum/ai_planning_subtree/bounty_boss_hunt/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!boss.boss_hostile || controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/atom/prey = controller.blackboard[BB_BOUNTY_BOSS_PREY]
	if(world.time >= controller.blackboard[BB_BOUNTY_BOSS_HUNT_AT] || QDELETED(prey) || !boss.boss_valid_target(prey))
		controller.set_blackboard_key(BB_BOUNTY_BOSS_HUNT_AT, world.time + BOUNTY_BOSS_HUNT_INTERVAL)
		prey = boss.boss_nearest_hunter()
		if(prey)
			controller.set_blackboard_key(BB_BOUNTY_BOSS_PREY, prey)
			boss.boss_calm_at = world.time + BOUNTY_BOSS_CALM_TIME
		else
			controller.clear_blackboard_key(BB_BOUNTY_BOSS_PREY)
			if(world.time >= boss.boss_calm_at)
				boss.boss_calm_down()
	if(QDELETED(prey))
		return
	controller.queue_behavior(/datum/ai_behavior/travel_towards/adjacent, BB_BOUNTY_BOSS_PREY)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Its target stands behind things its kit goes through, every one of them (boss_gets_through()): it
 * walks up to the first, and with Gorilla Arms right beside it, smashes it. A kit's own ability (a
 * charge, a grenade, a breaching charge) has had its turn already. It only does this while what breaks
 * through is ready (boss_breaks_through_now()), or when there is no way round on foot; otherwise it
 * leaves the walk round to the melee planner rather than wait at the glass (review r2).
 */
/datum/ai_planning_subtree/bounty_boss_breach

/datum/ai_planning_subtree/bounty_boss_breach/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!istype(boss) || QDELETED(target) || boss.Adjacent(target))
		return
	var/turf/here = get_turf(boss)
	var/turf/there = get_turf(target)
	var/list/blockers = boss.boss_line_blockers(here, there)
	if(!length(blockers) || !boss.boss_gets_through(blockers))
		return
	var/atom/barrier = blockers[1]
	if(!boss.boss_breaks_through_now(barrier) && boss.boss_walks_to(there))
		return
	if(get_dist(here, barrier) <= 1)
		if(boss.boss_start_smash(barrier))
			return SUBTREE_RETURN_FINISH_PLANNING
		return
	var/turf/spot = boss.boss_spot_before(barrier, target)
	if(!spot)
		return
	if(controller.blackboard[BB_BOUNTY_BOSS_SPOT] != spot)
		controller.CancelActions()
		controller.set_blackboard_key(BB_BOUNTY_BOSS_SPOT, spot)
	controller.queue_behavior(/datum/ai_behavior/travel_towards, BB_BOUNTY_BOSS_SPOT)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Hurt lately by someone it can't get at (boss_shuns()), and nobody it can reach in sight or on the
 * hunt: it gets out of their sight (boss_find_cover()) and waits there, rather than stand in the open
 * for them, with a line as it goes (boss_cover_bark()). With nowhere hidden in reach it backs off as
 * far from them as it can, and keeps going until it gets there. Anyone it can reach brings it out.
 */
/datum/ai_planning_subtree/bounty_boss_cover

/datum/ai_planning_subtree/bounty_boss_cover/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !length(boss.boss_shunned) || controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/list/watchers = boss.boss_watchers()
	if(!length(watchers))
		return
	var/turf/here = get_turf(boss)
	if(!boss.boss_seen_from(here, watchers))
		controller.clear_blackboard_key(BB_BOUNTY_BOSS_COVER)
		return SUBTREE_RETURN_FINISH_PLANNING
	var/turf/spot = controller.blackboard[BB_BOUNTY_BOSS_COVER]
	// On its way: it keeps walking (every plan, or the walk it queued last time is dropped) until it
	// gets there, unless someone took the spot, or it may look again and finds the spot in their sight.
	if(spot && spot != here && !boss.boss_someone_on(spot) && (world.time < boss.boss_cover_rethink_at || !boss.boss_seen_from(spot, watchers)))
		controller.queue_behavior(/datum/ai_behavior/travel_towards, BB_BOUNTY_BOSS_COVER)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(world.time < boss.boss_cover_rethink_at)
		return SUBTREE_RETURN_FINISH_PLANNING
	boss.boss_cover_rethink_at = world.time + BOUNTY_BOSS_REACH_RETHINK
	spot = boss.boss_find_cover(watchers)
	if(!spot)
		controller.clear_blackboard_key(BB_BOUNTY_BOSS_COVER)
		return
	if(controller.blackboard[BB_BOUNTY_BOSS_COVER] != spot)
		controller.CancelActions()
		controller.set_blackboard_key(BB_BOUNTY_BOSS_COVER, spot)
	boss.boss_cover_bark()
	controller.queue_behavior(/datum/ai_behavior/travel_towards, BB_BOUNTY_BOSS_COVER)
	return SUBTREE_RETURN_FINISH_PLANNING

// ===== COMBAT SENSE: ITS STIMULANT, AND A KIT'S ANSWER TO STUN FIRE (C8) =====

/**
 * A boss's combat sense (voidcrew/modules/human_npcs/human_npc_combat_sense.dm): the bounty family's leash
 * and gang rules, and the stimulant pens it carries (boss_supplies()), taken when it tires in a fight and
 * never while one is still in its blood. Nothing else injects them: its worn-out fall back asks this for
 * the pen too (bounty_boss_worn_out). By default stun fire changes nothing else about how it fights; a
 * kit with its own reaction sets it on a subtype (bounty_boss_kits.dm), and a ready ability always goes
 * first, its wind-up being the kit's own answer.
 */
/datum/npc_combat_sense/bounty/boss
	react_to_stun_fire = FALSE

/datum/npc_combat_sense/bounty/boss/can_act(mob/living/carbon/human/npc, datum/ai_controller/controller)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = npc
	return istype(boss) && boss.boss_hostile && !boss.boss_busy && ..()

/datum/npc_combat_sense/bounty/boss/in_fight(mob/living/carbon/human/npc, datum/ai_controller/controller, datum/component/npc_combat_sense/sense)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = npc
	return istype(boss) && boss.boss_hostile && (controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET) || sense.under_fire())

/datum/npc_combat_sense/bounty/boss/plan(mob/living/carbon/human/npc, datum/ai_controller/controller, datum/component/npc_combat_sense/sense)
	if(!can_act(npc, controller))
		sense.stand_down(controller)
		return
	var/under_fire = sense.under_fire()
	if(!under_fire && sense.hits)
		sense.end_exchange(controller)
	if(plan_stim(npc, controller, sense))
		return SUBTREE_RETURN_FINISH_PLANNING
	if(!under_fire || !react_to_stun_fire || !may_move(npc, controller))
		return
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = npc
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!QDELETED(target) && boss.boss_choose_ability(target))
		return
	if(close_in_reach && reach(npc, controller) <= close_in_reach)
		return plan_close_in(npc, controller, sense)
	return plan_cover(npc, controller, sense)

// The second pen of a fight comes with its "recover" line ("Round two."), as its second wind always did.
/datum/npc_combat_sense/bounty/boss/telegraph(mob/living/carbon/human/npc, kind, atom/about, obj/item/used)
	. = ..()
	if(kind != HUMAN_NPC_BARK_STIMULANT)
		return
	var/datum/component/npc_combat_sense/sense = npc.GetComponent(/datum/component/npc_combat_sense)
	if(sense?.stims_used)
		INVOKE_ASYNC(npc, TYPE_PROC_REF(/mob/living, bounty_say), "recover", null, TRUE)

