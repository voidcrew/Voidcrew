// ===== FIRE =====

/**
 * A patch of a boss's fire: flames on `turfs` for `lifetime`, only where its boss's abilities may
 * reach (never off its site or in a ship, hangar or outpost, M2). The patch itself is scripted: it
 * makes no gas and no hotspot and lights nothing, so it never spreads or sets off fire alarms (site
 * safety). Whoever it catches burns for real (CB-8): `landing_damage` burn against fire armour where it
 * first lands, then tg's own fire stacks and ignite_mob() (`new_landing_stacks` on landing,
 * BOUNTY_BOSS_FIRE_TICK_STACKS every second they stand in it), whatever state they are in. From then on
 * it is tg's fire on them: firesuits, stop-drop-and-roll, extinguishers, showers and wet clothes all
 * work. A mech with someone in it takes the burn on its hull. Capped at BOUNTY_BOSS_FIRE_POOL_CAP.
 */
/obj/effect/bounty_boss_fire_pool
	name = "fire"
	anchored = TRUE
	mouse_opacity = MOUSE_OPACITY_TRANSPARENT
	invisibility = INVISIBILITY_ABSTRACT
	light_range = 3
	light_power = 1
	light_color = LIGHT_COLOR_FIRE
	/// The tiles burning
	var/list/turfs
	/// The boss whose fire it is, for who it catches
	var/datum/weakref/boss_ref
	/// Its boss's factions when it was lit: its fire never catches its own side, even with the boss gone
	var/list/side_factions
	/// Its boss's zone damage factor when it was lit (1 for a human boss)
	var/damage_factor = 1
	/// Fire stacks it puts on whoever it catches where it first lands
	var/landing_stacks = BOUNTY_BOSS_FIRE_TICK_STACKS

/obj/effect/bounty_boss_fire_pool/Initialize(mapload, list/fire_turfs, lifetime, mob/living/carbon/human/npc/bounty_criminal/boss/boss, landing_damage = 0, new_landing_stacks)
	. = ..()
	if(length(GLOB.bounty_boss_fire_pools) >= BOUNTY_BOSS_FIRE_POOL_CAP)
		return INITIALIZE_HINT_QDEL
	GLOB.bounty_boss_fire_pools += src
	lifetime = lifetime || 4 SECONDS
	if(!isnull(new_landing_stacks))
		landing_stacks = new_landing_stacks
	turfs = list()
	for(var/turf/spot as anything in fire_turfs)
		if(isturf(spot) && !isclosedturf(spot) && (!boss || boss.boss_reach_ok(spot)))
			turfs += spot
	if(!length(turfs))
		return INITIALIZE_HINT_QDEL
	boss_ref = boss ? WEAKREF(boss) : null
	side_factions = boss ? boss.faction.Copy() : null
	damage_factor = boss ? boss.get_npc_zone_damage_factor() : 1
	// Invisible, but the light comes from here: sit it where the fire is.
	var/turf/middle = turfs[round((length(turfs) + 1) / 2)]
	if(middle != loc)
		forceMove(middle)
	for(var/turf/spot as anything in turfs)
		new /obj/effect/temp_visual/bounty_boss_flames(spot, lifetime)
	scorch(landing_damage, landing_stacks)
	addtimer(CALLBACK(src, PROC_REF(scorch)), 1 SECONDS, TIMER_LOOP | TIMER_DELETE_ME)
	addtimer(CALLBACK(src, PROC_REF(burn_out)), lifetime, TIMER_DELETE_ME)

/obj/effect/bounty_boss_fire_pool/Destroy()
	GLOB.bounty_boss_fire_pools -= src
	turfs = null
	boss_ref = null
	side_factions = null
	return ..()

/// Whether it catches `victim`: its boss's rules, or with the boss gone, anyone not on the boss's side. Never by the victim's state (CB-11).
/obj/effect/bounty_boss_fire_pool/proc/may_burn(atom/victim)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = boss_ref?.resolve()
	if(!QDELETED(boss))
		return boss.boss_effect_hits(victim)
	return bounty_boss_effect_victim(victim, side_factions)

/**
 * Catches everyone in the flames: `damage` burn against fire armour if given (the jet or the bottle
 * landing), then `stacks` of tg's fire stacks and ignite_mob(). Mechs take the burn on the hull.
 */
/obj/effect/bounty_boss_fire_pool/proc/scorch(damage = 0, stacks = BOUNTY_BOSS_FIRE_TICK_STACKS)
	for(var/turf/spot as anything in turfs)
		for(var/atom/movable/thing as anything in spot)
			if(!(isliving(thing) || ismecha(thing)) || !may_burn(thing))
				continue
			if(ismecha(thing))
				var/obj/vehicle/sealed/mecha/mech = thing
				mech.take_damage(npc_zone_damage(max(damage, 3), damage_factor), BURN, FIRE, FALSE)
				continue
			var/mob/living/victim = thing
			if(damage > 0)
				victim.apply_damage(npc_zone_damage(damage, damage_factor), BURN, blocked = victim.run_armor_check(null, FIRE, silent = TRUE), spread_damage = TRUE)
				to_chat(victim, span_userdanger("You're caught in the flames!"))
			if(stacks > 0)
				victim.adjust_fire_stacks(stacks)
				victim.ignite_mob()

/obj/effect/bounty_boss_fire_pool/proc/burn_out()
	qdel(src)

// ===== THE MIND =====

/**
 * Its planning, on a real human body (contract 2.4): soft crit and breaking free first; nothing while
 * it is busy or can't act; worn out, it falls back; its stimulant; its target; its kit's gear; drawing
 * its weapon once its fight has started; an ability; the kit's way of closing in or keeping away; its
 * melee with what it holds; patching itself up with nobody about; and with nobody in sight, the hunt
 * for the nearest hunter still on its site. Bosses never surrender.
 */
/datum/ai_controller/basic_controller/bounty_boss
	blackboard = list(
		BB_TARGETING_STRATEGY = /datum/targeting_strategy/basic/human_npc/bounty_boss,
		BB_TARGET_MINIMUM_STAT = HUMAN_NPC_SPARES_DOWNED,
		BB_AGGRO_RANGE = BOUNTY_BOSS_POSSE_RANGE,
	)
	ai_movement = /datum/ai_movement/jps/bounty
	idle_behavior = null
	planning_subtrees = list(
		/datum/ai_planning_subtree/human_npc_soft_crit,
		/datum/ai_planning_subtree/bounty_escape_captivity,
		/datum/ai_planning_subtree/bounty_boss_busy,
		/datum/ai_planning_subtree/bounty_boss_worn_out,
		/datum/ai_planning_subtree/bounty_boss_stimulant,
		/datum/ai_planning_subtree/bounty_boss_target,
		/datum/ai_planning_subtree/simple_find_target,
		/datum/ai_planning_subtree/bounty_boss_gear,
		/datum/ai_planning_subtree/human_npc_arm/bounty_boss,
		/datum/ai_planning_subtree/bounty_boss_abilities,
		/datum/ai_planning_subtree/bounty_boss_engage,
		/datum/ai_planning_subtree/human_npc_melee,
		/datum/ai_planning_subtree/bounty_treat_self,
		/datum/ai_planning_subtree/bounty_boss_hunt,
	)

/datum/ai_controller/basic_controller/bounty_boss/TryPossessPawn(atom/new_pawn)
	if(!ishumannpc(new_pawn))
		return AI_CONTROLLER_INCOMPATIBLE
	return ..()

// Cuffs and soft crit don't stop it (the human NPC base's run check), so it can work at its cuffs and crawl.
/datum/ai_controller/basic_controller/bounty_boss/get_able_to_run()
	return human_npc_ai_able_to_run(src)

/datum/ai_controller/basic_controller/bounty_boss/on_stat_changed(mob/living/source, new_stat)
	. = ..()
	human_npc_ai_stat_changed(src, new_stat)

/**
 * Hunters it may go after, and mechs with one in them (H2); never anyone already down (C4,
 * npc_target_stat). tg's own mech branch would test the pilot, whom it only hurts through the mech, so
 * a mech is judged here.
 */
/datum/targeting_strategy/basic/human_npc/bounty_boss

/datum/targeting_strategy/basic/human_npc/bounty_boss/can_attack(mob/living/living_mob, atom/the_target, vision_range)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = living_mob
	if(!istype(boss) || !boss.boss_valid_target(the_target))
		return FALSE
	if(ismecha(the_target))
		var/range = vision_range || BOUNTY_BOSS_POSSE_RANGE
		return isturf(boss.loc) && the_target.z == boss.z && get_dist(boss, the_target) <= range && can_see(boss, the_target, range)
	return ..()

/// Nothing at all while it winds up, charges or bursts, or while it can't act (tg's states)
/datum/ai_planning_subtree/bounty_boss_busy

/datum/ai_planning_subtree/bounty_boss_busy/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || boss.boss_busy || !boss.boss_can_act())
		return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Worn out (boss_is_worn_out(), its body's real state): the first time, it says so and shows it to
 * the hunters (boss_wear_out()); then it falls back from whoever it was fighting for
 * BOUNTY_BOSS_FALLBACK_TIME, and after that its second wind is due (bounty_boss_stimulant). Back above
 * the line (healed, or its stamina back), it is fresh again.
 */
/datum/ai_planning_subtree/bounty_boss_worn_out

/datum/ai_planning_subtree/bounty_boss_worn_out/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	if(!boss.boss_is_worn_out())
		boss.boss_worn_out = FALSE
		boss.boss_fallback_until = 0
		return
	if(!boss.boss_worn_out)
		boss.boss_wear_out()
	if(world.time >= boss.boss_fallback_until)
		if(boss.boss_fallback_until && boss.boss_stimulants_used < BOUNTY_BOSS_STIMULANTS)
			boss.boss_second_wind_due = TRUE
		boss.boss_fallback_until = 0
		return
	var/atom/threat = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET] || boss.boss_revenge_target()
	if(QDELETED(threat))
		return
	controller.set_blackboard_key(BB_BOUNTY_BOSS_FALL_BACK_FROM, threat)
	controller.queue_behavior(/datum/ai_behavior/run_away_from_target, BB_BOUNTY_BOSS_FALL_BACK_FROM)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Its combat stimulant (defaults 1.6, CR-4): the first pen as its fight starts, the second for its
 * second wind once a fall back is over, each a real pen it carries, used on itself the player's way
 * through the core's bounty_ai_use_injector() (a visible emote first). The second comes with its
 * "recover" line ("Round two."). While a pen is going in, it keeps at it.
 */
/datum/ai_planning_subtree/bounty_boss_stimulant

/datum/ai_planning_subtree/bounty_boss_stimulant/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	var/obj/item/reagent_containers/hypospray/medipen/using = controller.blackboard[BB_HUMAN_NPC_TREAT_ITEM]
	if(istype(using) && !QDELETED(using) && !using.used_up && bounty_ai_is_stimulant(using))
		controller.queue_behavior(/datum/ai_behavior/human_npc_treat_self, BB_HUMAN_NPC_TREAT_ITEM)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(!boss.boss_wants_stimulant())
		return
	var/obj/item/reagent_containers/hypospray/medipen/pen = bounty_ai_find_injector(boss, BOUNTY_BOSS_STIMULANT)
	if(isnull(pen))
		// Nothing left to take: it fights on as it is.
		boss.boss_stimulants_used = BOUNTY_BOSS_STIMULANTS
		boss.boss_second_wind_due = FALSE
		return
	if(!bounty_ai_use_injector(controller, pen))
		return
	boss.boss_stimulants_used++
	if(boss.boss_second_wind_due)
		boss.boss_second_wind_due = FALSE
		INVOKE_ASYNC(boss, TYPE_PROC_REF(/mob/living, bounty_say), "recover", null, TRUE)
	return SUBTREE_RETURN_FINISH_PLANNING

/// Drops a target it may no longer go after, and turns on whoever hurt it last when it has none
/datum/ai_planning_subtree/bounty_boss_target

/datum/ai_planning_subtree/bounty_boss_target/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[BB_TARGETING_STRATEGY])
	var/atom/current = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(current && !strategy?.can_attack(boss, current, BOUNTY_BOSS_POSSE_RANGE))
		controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		current = null
	if(current)
		return
	var/mob/living/avenge = boss.boss_revenge_target()
	if(avenge && strategy?.can_attack(boss, avenge, BOUNTY_BOSS_POSSE_RANGE))
		controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, avenge)

/// The kit's own gear, once its fight is on: a Heavy changing the belt in its gun
/datum/ai_planning_subtree/bounty_boss_gear

/datum/ai_planning_subtree/bounty_boss_gear/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	if(boss.boss_gear_plan(controller))
		return SUBTREE_RETURN_FINISH_PLANNING

/// The human NPC base's arming (reload or draw what it carries), only once its fight has started: until then its weapon stays where it carries it
/datum/ai_planning_subtree/human_npc_arm/bounty_boss

/datum/ai_planning_subtree/human_npc_arm/bounty_boss/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!istype(boss) || !boss.boss_hostile)
		return
	return ..()

/// One ability, if one is ready, worth it, and not the one it used last
/datum/ai_planning_subtree/bounty_boss_abilities

/datum/ai_planning_subtree/bounty_boss_abilities/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(QDELETED(target))
		return
	var/datum/action/cooldown/mob_cooldown/bounty_boss/ability = boss.boss_choose_ability(target)
	if(!ability)
		return
	controller.set_blackboard_key(BB_BOUNTY_BOSS_ABILITY, ability)
	controller.set_blackboard_key(BB_BOUNTY_BOSS_ABILITY_TARGET, target)
	controller.queue_behavior(/datum/ai_behavior/bounty_boss_ability, BB_BOUNTY_BOSS_ABILITY, BB_BOUNTY_BOSS_ABILITY_TARGET)
	return SUBTREE_RETURN_FINISH_PLANNING

/datum/ai_behavior/bounty_boss_ability

/datum/ai_behavior/bounty_boss_ability/perform(seconds_per_tick, datum/ai_controller/controller, ability_key, target_key)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/datum/action/cooldown/mob_cooldown/bounty_boss/ability = controller.blackboard[ability_key]
	var/atom/target = controller.blackboard[target_key]
	if(QDELETED(ability) || QDELETED(target))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	boss.face_atom(target)
	return ability.Trigger(target = target) ? (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED) : (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED)

/datum/ai_behavior/bounty_boss_ability/finish_action(datum/ai_controller/controller, succeeded, ability_key, target_key)
	. = ..()
	controller.clear_blackboard_key(ability_key)
	controller.clear_blackboard_key(target_key)

/// The kit's own way of fighting: keeping its distance, breaking off
/datum/ai_planning_subtree/bounty_boss_engage

/datum/ai_planning_subtree/bounty_boss_engage/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(QDELETED(target))
		return
	if(boss.boss_engage_plan(controller, target))
		return SUBTREE_RETURN_FINISH_PLANNING

/**
 * One real step away from `target_key`'s target, onto ground its leash allows (P2's
 * body_step_away_from()): tg's step_away walks on a movement that knows nothing of the leash.
 */
/datum/ai_behavior/bounty_boss_back_off
	action_cooldown = 0.3 SECONDS
	behavior_flags = AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION

// No quicker than its body walks: armour, wounds and stamina slow it as they slow anyone.
/datum/ai_behavior/bounty_boss_back_off/get_cooldown(datum/ai_controller/cooldown_for)
	var/mob/living/pawn = cooldown_for?.pawn
	return max(action_cooldown, pawn?.cached_multiplicative_slowdown || 0)

/datum/ai_behavior/bounty_boss_back_off/perform(seconds_per_tick, datum/ai_controller/controller, target_key)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	var/atom/target = controller.blackboard[target_key]
	if(!istype(boss) || QDELETED(target) || !boss.boss_can_act())
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	boss.face_atom(target)
	return boss.body_step_away_from(target) ? (AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED) : (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED)

/**
 * Nobody in sight while hostile: it goes after the nearest hunter still on its site, looking again
 * every BOUNTY_BOSS_HUNT_INTERVAL. With nobody on the site for BOUNTY_BOSS_CALM_TIME it calms down.
 */
/datum/ai_planning_subtree/bounty_boss_hunt

/datum/ai_planning_subtree/bounty_boss_hunt/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = controller.pawn
	if(!boss.boss_hostile || controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/atom/prey = controller.blackboard[BB_BOUNTY_BOSS_PREY]
	if(world.time >= controller.blackboard[BB_BOUNTY_BOSS_HUNT_AT] || QDELETED(prey) || !boss.boss_valid_target(prey))
		controller.set_blackboard_key(BB_BOUNTY_BOSS_HUNT_AT, world.time + BOUNTY_BOSS_HUNT_INTERVAL)
		prey = boss.boss_nearest_hunter()
		if(prey)
			controller.set_blackboard_key(BB_BOUNTY_BOSS_PREY, prey)
			boss.boss_calm_at = world.time + BOUNTY_BOSS_CALM_TIME
		else
			controller.clear_blackboard_key(BB_BOUNTY_BOSS_PREY)
			if(world.time >= boss.boss_calm_at)
				boss.boss_calm_down()
	if(QDELETED(prey))
		return
	controller.queue_behavior(/datum/ai_behavior/travel_towards/adjacent, BB_BOUNTY_BOSS_PREY)
	return SUBTREE_RETURN_FINISH_PLANNING

