/// Pulling at a hider finds them (CR-8: the pull itself is tg's and goes ahead)
/datum/ai_controller/basic_controller/bounty/criminal/proc/on_pull_check(mob/living/carbon/human/npc/bounty_criminal/source, mob/living/user)
	SIGNAL_HANDLER
	if(source.hidden && isliving(user))
		INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/carbon/human/npc/bounty_criminal, ai_reveal), user, "pulled")
	return NONE

