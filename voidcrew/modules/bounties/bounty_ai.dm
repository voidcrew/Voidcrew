/// A shot passes through a blended patron (the fugitive or a decoy) it was not aimed at (AR-C7)
/datum/ai_controller/basic_controller/bounty/criminal/proc/on_prehit(mob/living/basic/bounty_criminal/source, obj/projectile/shot)
	SIGNAL_HANDLER
	if(source.blended && shot.original != source)
		return PROJECTILE_INTERRUPT_HIT_PHASE
	return NONE

/**
 * Pulling at a hider finds them (P2 sends the signal before its own refusal, L1). Who may pull a
 * blended patron is P2's rule (body_can_be_dragged(): a downed one can be dragged, AR-C7) and P6's
 * act, never decided here.
 */
/datum/ai_controller/basic_controller/bounty/criminal/proc/on_pull_check(mob/living/basic/bounty_criminal/source, mob/living/user)
	SIGNAL_HANDLER
	if(source.hidden)
		if(isliving(user))
			INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/basic/bounty_criminal, ai_reveal), user, "pulled")
		return COMSIG_ATOM_CANT_PULL
	return NONE

/datum/ai_controller/basic_controller/bounty/criminal/proc/on_bumped(mob/living/basic/bounty_criminal/source, atom/movable/bumper)
	SIGNAL_HANDLER
	if(source.hidden && isliving(bumper))
		INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/basic/bounty_criminal, ai_bumped_by), bumper)

/datum/ai_controller/basic_controller/bounty/criminal/proc/on_downed(mob/living/basic/bounty_criminal/source)
	SIGNAL_HANDLER
	INVOKE_ASYNC(source, TYPE_PROC_REF(/mob/living/basic/bounty_criminal, ai_on_downed))

