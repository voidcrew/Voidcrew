/**
 * # Bounty hunting: criminal AI, shared parts
 *
 * Owner: P3 AI. Owns this file, bounty_ai_meek.dm, bounty_ai_normal.dm, bounty_activities.dm,
 * bounty_companions.dm, voidcrew/_DEFINES/bounty_ai.dm and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_ai.dm. Do not edit this file outside P3.
 *
 * What it owns: the criminal AI's own system (decision 11: never the prison AI). This file holds
 * what meek, normal, decoys and companions share:
 * - the controller base, which hooks the mob's signals from the controller (a separate datum, so
 *   nothing here collides with the body's own registrations in bounty_criminal.dm);
 * - who they may fight (/datum/targeting_strategy/basic/bounty: the body's may_attack(), never
 *   their own gang, never a downed hunter), and movement that stays on their site (leash_ok());
 * - the planning gate: nothing is planned while dead, downed, restrained or surrendered, and a
 *   hidden criminal only keeps still;
 * - noticing hunters (a spatial grid lookup of player mobs, once a second, never view());
 * - being attacked, confronted, downed, getting up, cuffed and uncuffed;
 * - what they hold in their hand and over their head (drawn in vis_contents, so a look rebuilt
 *   over their overlays never wipes it), and their pace.
 * P4 overrides on_confronted() for bosses in its own files, on the /boss subtype.
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P3 uses has an
 * `ai_` prefix.
 */

// ===== STATE ON THE CRIMINAL =====

/mob/living/basic/bounty_criminal
	ai_controller = /datum/ai_controller/basic_controller/bounty/criminal
	/// BOUNTY_AI_CALM, _AWARE, _FLEEING, _FIGHTING or _RETREATING
	var/ai_mode = BOUNTY_AI_CALM
	/// Weakref to who they are wary of, running from or fighting
	var/datum/weakref/ai_threat_ref
	/// world.time they last saw that threat
	var/ai_threat_seen_at = 0
	/// world.time the next look around for hunters is due
	var/ai_next_notice = 0
	/// How far off each person was at the last look around, by REF(), to spot someone running at them
	var/list/ai_seen_distances
	/// The speed they move at now; see ai_set_pace()
	var/ai_pace
	/// What they hold in their hand, drawn in their vis_contents
	var/obj/effect/abstract/bounty_held/ai_hand
	/// What shows over their head (hands up), drawn in their vis_contents
	var/obj/effect/abstract/bounty_held/ai_over_head
	/// A walk that keeps failing: how many times, so they give up on it
	var/ai_travel_failures = 0

// ===== WHO THEY FIGHT FOR =====

/// The criminal a mob fights for: the criminal itself, or a companion's criminal. Null for anyone else.
/proc/bounty_ai_side_of(atom/movable/thing)
	if(istype(thing, /mob/living/basic/bounty_criminal))
		return thing
	if(istype(thing, /mob/living/basic/bounty_companion))
		var/mob/living/basic/bounty_companion/companion = thing
		return companion.ai_leader()
	return null

/// Whether two mobs are on the same side: a criminal and its companions
/proc/bounty_ai_same_gang(atom/movable/first, atom/movable/second)
	if(first == second)
		return TRUE
	var/mob/living/basic/bounty_criminal/side = bounty_ai_side_of(first)
	return !isnull(side) && side == bounty_ai_side_of(second)

/// Whether `person` counts as a hunter: someone played, awake, and not a criminal or one of their friends
/proc/bounty_ai_is_hunter(mob/living/person)
	if(!istype(person) || QDELETED(person) || person.stat != CONSCIOUS)
		return FALSE
	if(!person.mind && !person.client)
		return FALSE
	if(istype(person, /mob/living/basic/bounty_criminal) || istype(person, /mob/living/basic/bounty_companion))
		return FALSE
	return TRUE

/**
 * Whether `fighter` (a criminal, or a companion) may hit `target`. A criminal goes by the body's
 * may_attack(), its own state included. A companion goes by its criminal's may_attack_scope() alone
 * (who is fair game on their side), so it fights on when its criminal is down, cuffed, dead or has
 * given up (H3). Never their own gang.
 */
/proc/bounty_ai_may_hit(atom/movable/fighter, atom/target)
	if(QDELETED(target) || bounty_ai_same_gang(fighter, target))
		return FALSE
	if(istype(fighter, /mob/living/basic/bounty_criminal))
		var/mob/living/basic/bounty_criminal/criminal = fighter
		return criminal.may_attack(target)
	var/mob/living/basic/bounty_criminal/leader = bounty_ai_side_of(fighter)
	return !leader || leader.may_attack_scope(target)

/// Tiles between `first` and `second` by the turfs they stand on, so a pilot counts as where their mech is (H4); INFINITY across z-levels
/proc/bounty_ai_dist(atom/first, atom/second)
	var/turf/first_turf = get_turf(first)
	var/turf/second_turf = get_turf(second)
	if(!first_turf || !second_turf || first_turf.z != second_turf.z)
		return INFINITY
	return get_dist(first_turf, second_turf)

/// Whether `viewer` can see `seen` within `range`, by the turfs they are on (a pilot through their mech's)
/proc/bounty_ai_can_see(atom/viewer, atom/seen, range)
	var/turf/seen_turf = get_turf(seen)
	return !isnull(seen_turf) && bounty_ai_dist(viewer, seen_turf) <= range && can_see(get_turf(viewer), seen_turf, range)

/// What to go after for `who`: the mech they sit in, or them (H4, as P4 does for bosses)
/proc/bounty_ai_target_for(atom/who)
	var/mob/living/person = who
	if(isliving(person) && ismecha(person.loc))
		return person.loc
	return who

/// The pilot of `mech` who counts as the attacker: the first one in it, or null
/proc/bounty_ai_pilot_of(obj/vehicle/sealed/mecha/mech)
	for(var/mob/living/pilot in mech.occupants)
		return pilot
	return null

/**
 * Whether a blow from `attacker` is only friendly fire (M1): someone on `victim`'s side of the site
 * (its own faction: the pirates it is aboard with, the site's fauna) with nobody playing them.
 */
/proc/bounty_ai_friendly_fire(mob/living/victim, atom/attacker)
	var/mob/living/fellow = attacker
	return isliving(fellow) && !bounty_player_behind(fellow) && victim.faction_check_atom(fellow)

/**
 * Whether `person` holds something a criminal takes as a threat: a gun, a blade, a baton or
 * anything heavy, or sits in a mech; and, unless `weapons_only`, cuffs or a printed warrant.
 */
/proc/bounty_ai_is_armed(mob/living/person, weapons_only = FALSE)
	if(ismecha(person.loc))
		return TRUE
	for(var/obj/item/held in person.held_items)
		if(istype(held, /obj/item/gun) || istype(held, /obj/item/melee) || istype(held, /obj/item/knife))
			return TRUE
		if(held.force >= BOUNTY_WEAPON_FORCE)
			return TRUE
		if(!weapons_only && (istype(held, /obj/item/restraints) || istype(held, /obj/item/paper/bounty_warrant)))
			return TRUE
	return FALSE

/// How many hunters stand within `range` of `center` and can see it: a spatial grid lookup, never view()
/proc/bounty_ai_hunters_near(atom/center, range)
	. = 0
	var/turf/here = get_turf(center)
	if(!here)
		return
	for(var/mob/living/person in SSspatial_grid.orthogonal_range_search(here, SPATIAL_GRID_CONTENTS_TYPE_CLIENTS, range))
		if(!bounty_ai_is_hunter(person) || get_dist(here, person) > range || !can_see(person, here, range))
			continue
		.++

// ===== HELD THINGS =====

/**
 * Something drawn in a mob's hand or over its head. It lives in the mob's vis_contents rather than
 * its overlays: the look builder replaces the overlays wholesale, and would wipe it.
 */
/obj/effect/abstract/bounty_held
	name = ""
	mouse_opacity = MOUSE_OPACITY_TRANSPARENT
	appearance_flags = KEEP_APART | RESET_COLOR | RESET_TRANSFORM | PIXEL_SCALE
	vis_flags = VIS_INHERIT_PLANE
	layer = ABOVE_MOB_LAYER
	/// Over the head rather than in the hand
	var/over_head = FALSE
	/// Drawn with the item's own in-hand sprite, which turns with the holder, rather than its item icon
	var/inhand = FALSE

/**
 * Draws `look` in `owner`'s hand (or over their head), reusing `holder`: `look` is an atom, whose
 * appearance is copied, or an atom typepath, whose icon is used. An item with an in-hand sprite is
 * drawn with that instead, the way a player holds it, so it points the way they face. A null `look`
 * takes it away. Returns the holder to keep, or null.
 */
/proc/bounty_ai_update_held(mob/living/owner, obj/effect/abstract/bounty_held/holder, look, over_head = FALSE)
	if(isnull(look) || QDELETED(owner))
		if(holder)
			owner?.vis_contents -= holder
			qdel(holder)
		return null
	if(!holder)
		holder = new(null)
		owner.vis_contents += holder
	var/list/inhand_look = over_head ? null : npc_inhand_look(look)
	if(inhand_look)
		holder.appearance = mutable_appearance(inhand_look[1], inhand_look[2])
	else if(ispath(look, /atom))
		var/atom/look_type = look
		holder.appearance = mutable_appearance(initial(look_type.icon), initial(look_type.icon_state))
	else if(isatom(look))
		var/atom/look_atom = look
		holder.appearance = look_atom.appearance
	holder.name = ""
	holder.over_head = over_head
	holder.inhand = !!inhand_look
	holder.mouse_opacity = MOUSE_OPACITY_TRANSPARENT
	holder.appearance_flags = KEEP_APART | RESET_COLOR | RESET_TRANSFORM | PIXEL_SCALE
	holder.vis_flags = VIS_INHERIT_PLANE
	holder.layer = ABOVE_MOB_LAYER
	holder.alpha = 255
	holder.dir = SOUTH
	holder.pixel_x = 0
	holder.pixel_y = 0
	bounty_ai_place_held(owner, holder)
	return holder

/**
 * The right-hand sprite of `look` (an item or item typepath) as list(file, state), or null when it
 * has none: what a player holding it shows. Drawn on an NPC's body it turns with them, as a player's
 * does. Used by bounty NPCs and the prison's prisoners and guards.
 */
/proc/npc_inhand_look(look)
	var/hand_file
	var/state
	if(ispath(look, /obj/item))
		var/obj/item/item_type = look
		hand_file = initial(item_type.righthand_file)
		state = initial(item_type.inhand_icon_state) || initial(item_type.icon_state)
	else if(isitem(look))
		var/obj/item/item = look
		hand_file = item.righthand_file
		state = item.inhand_icon_state || item.icon_state
	if(!hand_file || !state || !icon_exists(hand_file, state))
		return null
	return list(hand_file, state)

/// Puts a held thing in the hand on the side they face (`facing`, or the way they face now), or over their head
/proc/bounty_ai_place_held(mob/living/owner, obj/effect/abstract/bounty_held/holder, facing)
	if(!holder || !owner)
		return
	// An in-hand sprite is drawn for a whole body: full size, no offset, facing their way
	if(holder.inhand)
		holder.transform = matrix()
		holder.pixel_w = 0
		holder.pixel_z = 0
		holder.dir = facing || owner.dir
		return
	holder.transform = matrix().Scale(0.6)
	if(holder.over_head)
		holder.pixel_w = 0
		holder.pixel_z = 22
		return
	var/facing_dir = facing || owner.dir
	// The same hand whichever way they face: to the right facing south or east, the left facing north or west
	holder.pixel_w = ((facing_dir & WEST) || facing_dir == NORTH) ? -7 : 7
	holder.pixel_z = -4

/// What a fighter holds, by whichever of the two types it is
/proc/bounty_ai_hold(mob/living/basic/fighter, look)
	if(istype(fighter, /mob/living/basic/bounty_criminal))
		var/mob/living/basic/bounty_criminal/criminal = fighter
		criminal.ai_hand = bounty_ai_update_held(criminal, criminal.ai_hand, look)
	else if(istype(fighter, /mob/living/basic/bounty_companion))
		var/mob/living/basic/bounty_companion/companion = fighter
		companion.ai_hand = bounty_ai_update_held(companion, companion.ai_hand, look)

// ===== THE CRIMINAL'S SIDE OF IT =====

/**
 * `user` confronted them: showed the warrant, or accused them. A meek criminal bolts, a normal one
 * fights; a boss starts its fight (P4 overrides this on /boss); P6 decides what a decoy does. This
 * and P6's exposure (which ends its act, then calls this) are the only ways out of blending in:
 * anything else that happens to a blended patron shows nothing (C1).
 */
/mob/living/basic/bounty_criminal/proc/on_confronted(mob/user)
	if(stat != CONSCIOUS || !isliving(user) || QDELETED(user))
		return
	ai_add_grudge(user)
	if(hidden)
		ai_reveal(user, "confronted")
		return
	var/was_blended = blended
	ai_expose()
	ai_react(user, was_blended ? "accused_rightly" : null)

/**
 * What they do about `threat`: a meek criminal runs, a normal one fights, a decoy gets out of the
 * way. `bark` is the dialogue context to use instead of the usual one, or null.
 */
/mob/living/basic/bounty_criminal/proc/ai_react(mob/living/threat, bark)
	return

/// Something about `hunter` made them look twice (armed, cuffs, a warrant, running at them)
/mob/living/basic/bounty_criminal/proc/ai_notice(mob/living/hunter)
	return

/// How far they notice hunters
/mob/living/basic/bounty_criminal/proc/ai_notice_range()
	return BOUNTY_NORMAL_NOTICE_RANGE

/// Their fighting style's key, BOUNTY_STYLE_*, or null for a mob that never fights
/mob/living/basic/bounty_criminal/proc/ai_wanted_style()
	return null

/// Whether they carry their style's heavier weapon: every tier above Petty. A 9mm is a 9mm; the tier only picks the gun.
/mob/living/basic/bounty_criminal/proc/ai_heavy_weapon()
	return record?.tier != BOUNTY_TIER_PETTY

/// Puts their style on them, once the record says which it is. Cheap when nothing changed.
/mob/living/basic/bounty_criminal/proc/ai_update_style()
	var/key = ai_wanted_style()
	if(!key || QDELETED(ai_controller) || ai_controller.blackboard[BB_BOUNTY_STYLE] == key)
		return
	bounty_ai_apply_style(src, key, ai_heavy_weapon())

/**
 * Whether they can do anything at all: alive, on their feet, free and not giving up. Knocked down,
 * stunned or in stamina crit (P2's body_is_stunned()) is the cuff window: no blows, no shots, no
 * climbing into hiding (H2).
 */
/mob/living/basic/bounty_criminal/proc/ai_can_act()
	if(stat != CONSCIOUS || HAS_TRAIT(src, TRAIT_BOUNTY_HELD) || HAS_TRAIT(src, TRAIT_FLOORED) || is_downed() || is_restrained())
		return FALSE
	return !body_is_stunned()

/// Says a line for `context`, never from inside a signal handler's stack. `force` skips the cooldown, for a moment that must be heard.
/mob/living/basic/bounty_criminal/proc/ai_bark(context, force = FALSE)
	INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), context, null, force)

/// Puts `who` on the list of people they may fight, by P2's rules (the cap, never another criminal or a companion)
/mob/living/basic/bounty_criminal/proc/ai_add_grudge(mob/living/who)
	if(!isliving(who) || bounty_ai_same_gang(src, who))
		return
	body_add_grudge(who)

/// Whether `who` is on their grudge list
/mob/living/basic/bounty_criminal/proc/ai_has_grudge(mob/living/who)
	return body_has_grudge(who)

/// The nearest person on their grudge list they can see (a pilot through their mech), or null
/mob/living/basic/bounty_criminal/proc/ai_nearest_grudge(range = BOUNTY_FIGHT_VISION)
	var/mob/living/best
	var/best_distance = INFINITY
	for(var/datum/weakref/ref as anything in grudge)
		var/mob/living/enemy = ref?.resolve()
		var/turf/enemy_turf = get_turf(enemy)
		if(QDELETED(enemy) || enemy.stat != CONSCIOUS || enemy_turf?.z != z)
			continue
		var/distance = bounty_ai_dist(src, enemy)
		if(distance > range || distance >= best_distance || !bounty_ai_can_see(src, enemy, range))
			continue
		best = enemy
		best_distance = distance
	return best

/// Who they are wary of, running from or fighting, if they still exist
/mob/living/basic/bounty_criminal/proc/ai_threat()
	var/mob/living/threat = ai_threat_ref?.resolve()
	return QDELETED(threat) ? null : threat

/mob/living/basic/bounty_criminal/proc/ai_set_threat(mob/living/threat)
	ai_threat_ref = threat ? WEAKREF(threat) : null
	ai_threat_seen_at = world.time

/// Whether they can see their threat now (a pilot through their mech); seeing it restarts the clock on losing it
/mob/living/basic/bounty_criminal/proc/ai_sees_threat(range = BOUNTY_FIGHT_VISION)
	var/mob/living/threat = ai_threat()
	var/turf/threat_turf = get_turf(threat)
	if(!threat || threat_turf?.z != z || !bounty_ai_can_see(src, threat, range))
		return FALSE
	ai_threat_seen_at = world.time
	return TRUE

/mob/living/basic/bounty_criminal/proc/ai_set_mode(new_mode)
	ai_mode = new_mode

/// Moves at `new_speed` from now on. Compared with the speed they have, not a cache: the body sets speed too (L3).
/mob/living/basic/bounty_criminal/proc/ai_set_pace(new_speed)
	ai_pace = new_speed
	if(speed != new_speed)
		set_varspeed(new_speed)

/**
 * Takes them out of blending in: P6's act ends with it, and they never go back to the routine (a
 * P6 exposure has already cleared `blended` by the time on_confronted() runs). Not for decoys, who
 * are always patrons (bounty_activities.dm).
 */
/mob/living/basic/bounty_criminal/proc/ai_expose()
	ai_end_blend()

/**
 * The floor they can walk to within `radius` of where they stand, as turf = TRUE: one flood from
 * their tile that never crosses a wall, a window, a counter or a door they have no access for (the
 * pathfinder's own step check), and never leaves their site. Built once per flight, never per tick
 * (H1). get_path_to() can't be used here: it sleeps, and planning must not.
 */
/mob/living/basic/bounty_criminal/proc/ai_reachable_turfs(radius)
	. = list()
	var/turf/start = get_turf(src)
	if(!start)
		return
	.[start] = TRUE
	var/datum/can_pass_info/pass_info = new(src, ai_controller?.get_access())
	var/list/queue = list(start)
	var/index = 1
	while(index <= length(queue))
		var/turf/current = queue[index++]
		for(var/direction in GLOB.alldirs)
			var/turf/next = get_step(current, direction)
			if(!next || .[next] || next.density || get_dist(start, next) > radius)
				continue
			// Blocked from this side only: another side may still reach it (a railing's open end)
			if(current.LinkBlockedWithAccess(next, pass_info) || !leash_ok(next))
				continue
			.[next] = TRUE
			queue += next

/// Gets out of the way of `threat` without looking for somewhere to hide (a decoy that stopped blending in)
/mob/living/basic/bounty_criminal/proc/ai_flee_from(mob/living/threat)
	if(!isliving(threat) || !ai_flee_event(threat, null, seek_hiding = FALSE, quiet = TRUE))
		return FALSE
	ai_set_pace(BOUNTY_NORMAL_SPEED_MELEE)
	return TRUE

/**
 * Looks around for hunters, once every BOUNTY_NOTICE_INTERVAL: someone played, in view within
 * ai_notice_range(), holding a weapon, cuffs or the warrant, or running straight at them from
 * within BOUNTY_MEEK_RUSH_RANGE. A spatial grid lookup of player mobs, never view(). Nothing while
 * blended in (a fugitive at a trader outpost only reacts to a warrant or a blow), fleeing or
 * fighting. Returns the nearest one found, or null.
 */
/mob/living/basic/bounty_criminal/proc/ai_look_around()
	if(blended || ai_mode == BOUNTY_AI_FLEEING || ai_mode == BOUNTY_AI_FIGHTING)
		return null
	if(world.time < ai_next_notice)
		return null
	ai_next_notice = world.time + BOUNTY_NOTICE_INTERVAL
	var/turf/here = get_turf(src)
	if(!here)
		return null
	var/range = ai_notice_range()
	var/list/seen = list()
	var/mob/living/found
	var/found_distance = INFINITY
	for(var/mob/living/person in SSspatial_grid.orthogonal_range_search(here, SPATIAL_GRID_CONTENTS_TYPE_CLIENTS, range))
		if(!bounty_ai_is_hunter(person))
			continue
		var/distance = bounty_ai_dist(src, person)
		if(distance > range || !bounty_ai_can_see(src, person, range))
			continue
		var/key = REF(person)
		seen[key] = distance
		var/was = ai_seen_distances?[key]
		var/rushing = distance <= BOUNTY_MEEK_RUSH_RANGE && person.move_intent == MOVE_INTENT_RUN && was && (was - distance) >= 2
		if(!rushing && !bounty_ai_is_armed(person))
			continue
		if(distance < found_distance)
			found = person
			found_distance = distance
	ai_seen_distances = length(seen) ? seen : null
	return found

/**
 * Someone attacked them (a mech's pilot for the mech). Never from a signal handler's stack: reveal
 * and react can open closets and move things.
 * - Blended in, nothing shows at all (C1): P6 alone decides which blows expose the fugitive, and
 *   calls on_confronted() for them.
 * - Friendly fire from their own side of the site with nobody playing it (the pirates they are
 *   aboard with, the site's fauna) is let go (M1).
 */
/mob/living/basic/bounty_criminal/proc/ai_attacked_by(mob/living/attacker)
	if(stat == DEAD || blended || !isliving(attacker) || bounty_ai_same_gang(src, attacker))
		return
	if(bounty_ai_friendly_fire(src, attacker))
		return
	ai_add_grudge(attacker)
	if(hidden)
		ai_reveal(attacker, "hit")
		return
	if(!ai_can_act())
		return
	if(ai_mode == BOUNTY_AI_FLEEING || ai_mode == BOUNTY_AI_FIGHTING)
		ai_attacked_again(attacker)
		return
	ai_react(attacker, null)

/// Attacked while already running or fighting
/mob/living/basic/bounty_criminal/proc/ai_attacked_again(mob/living/attacker)
	return

/// Someone touched them without attacking: a hider is found by it
/mob/living/basic/bounty_criminal/proc/ai_touched_by(mob/living/toucher)
	if(hidden && ai_hide_mode != BOUNTY_HIDE_CONTAINER)
		ai_reveal(toucher, "touched")

/// Someone walked into them: a hider is found by it
/mob/living/basic/bounty_criminal/proc/ai_bumped_by(mob/living/bumper)
	if(hidden && ai_hide_mode != BOUNTY_HIDE_CONTAINER && bounty_ai_is_hunter(bumper))
		ai_reveal(bumper, "bumped")

/// They are about to take damage. Inside a signal handler: must not sleep.
/mob/living/basic/bounty_criminal/proc/ai_took_damage(damage, damagetype)
	return

/// Down at the downed line (P2's COMSIG_BOUNTY_CRIMINAL_DOWNED): they drop everything, a shot or a wind-up included. The body says the line (body_go_down()).
/mob/living/basic/bounty_criminal/proc/ai_on_downed()
	ai_let_go()
	if(!QDELETED(ai_controller))
		ai_controller.CancelActions()
	ai_companions_lose_heart()

/**
 * Back up after the recovery time (P2's COMSIG_BOUNTY_CRIMINAL_RECOVERED): they run or fight again.
 * Blended in, they only go back to the blend routine, like any patron (M2).
 */
/mob/living/basic/bounty_criminal/proc/ai_on_recovered()
	if(blended || !ai_can_act())
		return
	ai_react(ai_threat() || ai_nearest_grudge(), "recover")

/// Cuffed (P2's COMSIG_BOUNTY_CRIMINAL_RESTRAINED). The body says the line (body_apply_cuffs()).
/mob/living/basic/bounty_criminal/proc/ai_on_restrained(mob/living/user)
	ai_let_go()
	if(!QDELETED(ai_controller))
		ai_controller.CancelActions()
	ai_add_grudge(user)
	ai_companions_lose_heart()

/// Cuffs off (P2's COMSIG_BOUNTY_CRIMINAL_UNRESTRAINED): if they slipped them, they make a break for it
/mob/living/basic/bounty_criminal/proc/ai_on_unrestrained(mob/living/user)
	if(user)
		return
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SURRENDERED, BOUNTY_TRAIT)
	ai_over_head = bounty_ai_update_held(src, ai_over_head, null)
	if(!blended && ai_can_act())
		ai_react(ai_nearest_grudge(), null)

/// Dead: they let go of everything, and a disguise comes off, so the body looks like them
/mob/living/basic/bounty_criminal/proc/ai_on_death()
	ai_let_go()
	ai_over_head = bounty_ai_update_held(src, ai_over_head, null)

/**
 * Drops everything they are doing: out of hiding (looks restored), no aim, the activity put away
 * (drink down, standing up), nothing in their hand, not sprinting. Safe to call at any time,
 * including while they are being deleted.
 */
/mob/living/basic/bounty_criminal/proc/ai_let_go()
	if(hidden)
		ai_unhide()
	ai_stop_aiming()
	ai_suspend_activity()
	// Off the floor from a retreat's rest too, not only an activity's (L9)
	ai_stand_up()
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	if(!QDELETED(ai_controller))
		ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		ai_controller.clear_blackboard_key(BB_BASIC_MOB_FLEE_TARGET)
		ai_controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)

/// Nothing is after them any more: back to what they were doing, at an easy pace
/mob/living/basic/bounty_criminal/proc/ai_calm_down()
	ai_set_mode(BOUNTY_AI_CALM)
	ai_set_threat(null)
	ai_stop_aiming()
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	ai_set_pace(BOUNTY_CALM_SPEED)
	if(!QDELETED(ai_controller))
		ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		ai_controller.clear_blackboard_key(BB_BASIC_MOB_FLEE_TARGET)
		ai_controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)

/// A walk the AI set up failed; after a few, they give up on it
/mob/living/basic/bounty_criminal/proc/ai_travel_failed()
	if(++ai_travel_failures < BOUNTY_TRAVEL_GIVE_UP)
		return
	ai_travel_failures = 0
	if(QDELETED(ai_controller))
		return
	ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
	if(ai_controller.blackboard[BB_BOUNTY_HIDE_SPOT])
		ai_controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		return
	ai_activity?.spot_unreachable()

/// Their companions, as mobs that still exist
/mob/living/basic/bounty_criminal/proc/ai_companions()
	. = list()
	for(var/datum/weakref/ref as anything in companions)
		var/mob/living/basic/bounty_companion/buddy = ref?.resolve()
		if(!QDELETED(buddy))
			. += buddy

/// Tells every companion to go for `target`: the trooper reinforcement pattern, without a view() scan
/mob/living/basic/bounty_criminal/proc/ai_rally_companions(mob/living/target)
	for(var/mob/living/basic/bounty_companion/buddy as anything in ai_companions())
		buddy.ai_join_fight(target)

/// Their criminal is down, cuffed or gave up: each companion may run for it
/mob/living/basic/bounty_criminal/proc/ai_companions_lose_heart()
	for(var/mob/living/basic/bounty_companion/buddy as anything in ai_companions())
		buddy.ai_lose_heart()

/// Whether they may fire at `target` now. A meek criminal only fires its cornered volley.
/mob/living/basic/bounty_criminal/proc/ai_may_shoot(atom/target)
	return TRUE

// ===== TARGETING AND MOVEMENT =====

/**
 * Who a criminal or a companion may fight: tg's rules (in sight, not in godmode), plus
 * bounty_ai_may_hit() (the body's rules on who is fair game, never their own gang), and never a
 * downed hunter (BB_TARGET_MINIMUM_STAT is CONSCIOUS, spec C4). A pilot is fought through their
 * mech (H4): tg's own mech branch tests the pilot with no sight range and never passes, so a mech
 * is judged here, as P4 does for bosses.
 */
/datum/targeting_strategy/basic/bounty

/datum/targeting_strategy/basic/bounty/can_attack(mob/living/living_mob, atom/the_target, vision_range)
	if(ismecha(the_target))
		return mech_attackable(living_mob, the_target, vision_range)
	. = ..()
	if(!.)
		return FALSE
	var/mob/living/person = the_target
	if(isliving(person) && ismecha(person.loc))
		return FALSE
	return bounty_ai_may_hit(living_mob, the_target)

/// A mech in sight with someone awake aboard who is fair game
/datum/targeting_strategy/basic/bounty/proc/mech_attackable(mob/living/living_mob, obj/vehicle/sealed/mecha/mech, vision_range)
	var/range = vision_range || BOUNTY_FIGHT_VISION
	if(QDELETED(mech) || !isturf(living_mob.loc) || mech.z != living_mob.z || get_dist(living_mob, mech) > range || !can_see(living_mob, mech, range))
		return FALSE
	var/minimum_stat = living_mob.ai_controller?.blackboard[minimum_stat_key]
	for(var/mob/living/pilot in mech.occupants)
		if(pilot.stat <= minimum_stat && !bounty_ai_same_gang(living_mob, pilot))
			return bounty_ai_may_hit(living_mob, mech)
	return FALSE

/**
 * Smart pathing that stays on their site (AR-E1): a step off the leash (P2's leash_ok(): the site's
 * bounds, never a ship, hangar or player outpost) is refused. Paths are bounded by
 * AI_MAX_PATH_LENGTH like any jps mover.
 */
/datum/ai_movement/jps/bounty

/datum/ai_movement/jps/bounty/allowed_to_move(datum/move_loop/has_target/jps/source)
	. = ..()
	if(!.)
		return
	var/list/path = source.movement_path
	if(!length(path))
		return
	var/mob/living/basic/bounty_criminal/leash_holder = bounty_ai_side_of(source.moving)
	if(leash_holder && !leash_holder.leash_ok(path[1]))
		return FALSE

/// Now and then a step in some direction, while nothing else is planned: never off the leash, never while hiding, cuffed or down
/datum/idle_behavior/bounty_wander
	/// Chance a second of a step
	var/walk_chance = 5

/datum/idle_behavior/bounty_wander/perform_idle_behavior(seconds_per_tick, datum/ai_controller/controller)
	. = ..()
	var/mob/living/basic/wanderer = controller.pawn
	if(!istype(wanderer) || !isturf(wanderer.loc) || wanderer.buckled || wanderer.pulledby || LAZYLEN(wanderer.do_afters))
		return
	if(!(wanderer.mobility_flags & MOBILITY_MOVE) || !SPT_PROB(walk_chance, seconds_per_tick))
		return
	if(istype(wanderer, /mob/living/basic/bounty_criminal))
		var/mob/living/basic/bounty_criminal/criminal = wanderer
		if(criminal.hidden || !criminal.ai_can_act() || criminal.ai_activity)
			return
	else if(istype(wanderer, /mob/living/basic/bounty_companion))
		var/mob/living/basic/bounty_companion/companion = wanderer
		if(companion.ai_gave_up)
			return
	var/mob/living/basic/bounty_criminal/side = bounty_ai_side_of(wanderer)
	var/move_dir = pick(GLOB.alldirs)
	var/turf/destination = get_step(wanderer, move_dir)
	if(!destination?.can_cross_safely(wanderer))
		return
	if(side && !side.leash_ok(destination))
		return
	wanderer.Move(destination, move_dir)

// ===== PLANNING =====

/**
 * First in every criminal's tree. Nothing is planned while they are dead, downed, restrained or
 * surrendered; a hidden criminal only keeps still (and checks whether it has been found); one
 * shut in something they can't get out of waits.
 */
/datum/ai_planning_subtree/bounty_gate

/datum/ai_planning_subtree/bounty_gate/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(!istype(criminal))
		return
	if(!criminal.ai_can_act())
		return SUBTREE_RETURN_FINISH_PLANNING
	if(criminal.hidden)
		controller.queue_behavior(/datum/ai_behavior/bounty_stay_hidden)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(!isturf(criminal.loc))
		return SUBTREE_RETURN_FINISH_PLANNING
	criminal.ai_update_style()

/// Looks around for hunters; the archetype decides what noticing one means (ai_notice())
/datum/ai_planning_subtree/bounty_notice

/datum/ai_planning_subtree/bounty_notice/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	var/mob/living/hunter = criminal.ai_look_around()
	if(hunter)
		criminal.ai_notice(hunter)

/// Keeps still while hidden, about once a second: found out yet, restless yet, time to come out yet
/datum/ai_behavior/bounty_stay_hidden
	action_cooldown = 1 SECONDS

/datum/ai_behavior/bounty_stay_hidden/setup(datum/ai_controller/controller)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	return istype(criminal) && criminal.hidden

/datum/ai_behavior/bounty_stay_hidden/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(!criminal.hidden)
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_FAILED
	criminal.ai_hidden_tick()
	return criminal.hidden ? AI_BEHAVIOR_DELAY : (AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED)

/// Stands where they are, facing their threat, so planning carries on every half second
/datum/ai_behavior/bounty_watch
	action_cooldown = 1 SECONDS
	behavior_flags = AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION

/datum/ai_behavior/bounty_watch/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	var/mob/living/threat = istype(criminal) ? criminal.ai_threat() : null
	if(threat && bounty_ai_dist(criminal, threat) <= BOUNTY_FIGHT_VISION)
		criminal.face_atom(bounty_ai_target_for(threat))
	return AI_BEHAVIOR_DELAY

/**
 * Walks to the turf in the blackboard key, with planning going on meanwhile. If the key changes
 * on the way (a new hiding place, a new seat), the walk ends so the new one starts at once. A walk
 * that ends stuck (the pathing failed) counts toward giving up on where they were going
 * (ai_travel_failed()).
 */
/datum/ai_behavior/travel_towards/bounty
	action_cooldown = 0.5 SECONDS
	behavior_flags = AI_BEHAVIOR_REQUIRE_MOVEMENT | AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION | AI_BEHAVIOR_MOVE_AND_PERFORM

/datum/ai_behavior/travel_towards/bounty/perform(seconds_per_tick, datum/ai_controller/controller, target_key)
	var/atom/target = controller.blackboard[target_key]
	if(QDELETED(target) || controller.current_movement_target != target)
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_FAILED
	if(get_dist(controller.pawn, target) <= required_distance)
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED
	return AI_BEHAVIOR_DELAY

/datum/ai_behavior/travel_towards/bounty/finish_action(datum/ai_controller/controller, succeeded, target_key)
	var/atom/target = controller.blackboard[target_key]
	var/stuck = !succeeded && controller.consecutive_pathing_attempts > 0 && target && controller.current_movement_target == target
	. = ..()
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(!istype(criminal))
		return
	if(succeeded)
		criminal.ai_travel_failures = 0
	else if(stuck)
		criminal.ai_travel_failed()

/// The same, stopping beside the target: a closet, a table, a stall, a container to go through
/datum/ai_behavior/travel_towards/bounty/adjacent
	required_distance = 1

// ===== CONTROLLERS =====

/**
 * What every bounty fighter's controller shares, criminals and companions alike: who they may
 * fight, smart pathing on the leash, and the signal hooks for styles and for being attacked. The
 * hooks are registered by the controller, never by the mob on itself, so they never collide with
 * the body's own registrations (a second RegisterSignal from the same datum replaces the first).
 *
 * Attacks are read from the attack signals themselves (items, hands, mobs, shots that landed,
 * thrown things) rather than relay_attackers, whose projectile hook fires even for a shot that
 * passes through a blended patron.
 *
 * Who they fight comes from their grudge list and retaliation only, filtered by the body's
 * may_attack() and their own gang, so faction is ignored in targeting: a criminal shares
 * FACTION_NEUTRAL with players until the placement sets otherwise, and would never hit back.
 */
/datum/ai_controller/basic_controller/bounty
	blackboard = list(
		BB_TARGETING_STRATEGY = /datum/targeting_strategy/basic/bounty,
		BB_TARGET_MINIMUM_STAT = CONSCIOUS,
		BB_BASIC_MOB_FLEE_DISTANCE = BOUNTY_FLEE_DISTANCE,
		BB_ALWAYS_IGNORE_FACTION = TRUE,
	)
	ai_movement = /datum/ai_movement/jps/bounty
	idle_behavior = /datum/idle_behavior/bounty_wander
	/// Whether the mob carries a ranged_attacks component, for a ranged style or the holdout. A tree with a ranged subtree needs it at init.
	var/armed = TRUE

/datum/ai_controller/basic_controller/bounty/TryPossessPawn(atom/new_pawn)
	if(!isbasicmob(new_pawn))
		return AI_CONTROLLER_INCOMPATIBLE
	var/mob/living/basic/fighter = new_pawn
	if(armed)
		fighter.AddComponent(/datum/component/ranged_attacks, projectile_type = /obj/projectile/bullet/bounty)
	RegisterSignal(fighter, COMSIG_HOSTILE_PRE_ATTACKINGTARGET, PROC_REF(on_pre_melee))
	RegisterSignal(fighter, COMSIG_HOSTILE_POST_ATTACKINGTARGET, PROC_REF(on_post_melee))
	RegisterSignal(fighter, COMSIG_BASICMOB_PRE_ATTACK_RANGED, PROC_REF(on_pre_ranged))
	RegisterSignal(fighter, COMSIG_BASICMOB_POST_ATTACK_RANGED, PROC_REF(on_post_ranged))
	RegisterSignal(fighter, COMSIG_PROJECTILE_FIRER_BEFORE_FIRE, PROC_REF(on_fire))
	RegisterSignal(fighter, COMSIG_ATOM_DIR_CHANGE, PROC_REF(on_turned))
	RegisterSignal(fighter, COMSIG_ATOM_AFTER_ATTACKEDBY, PROC_REF(on_attacked_by_item))
	RegisterSignal(fighter, COMSIG_ATOM_ATTACK_HAND, PROC_REF(on_touched))
	// A basic mob's blow reaches attack_animal() too, so this one signal covers both kinds of mob
	RegisterSignal(fighter, COMSIG_ATOM_ATTACK_ANIMAL, PROC_REF(on_attacked_by_mob))
	RegisterSignal(fighter, COMSIG_ATOM_ATTACK_MECH, PROC_REF(on_attacked_by_mech))
	RegisterSignal(fighter, COMSIG_ATOM_BULLET_ACT, PROC_REF(on_shot))
	RegisterSignal(fighter, COMSIG_ATOM_HITBY, PROC_REF(on_hit_by_thrown))
	RegisterSignal(fighter, COMSIG_MOB_APPLY_DAMAGE, PROC_REF(on_damage))
	RegisterSignal(fighter, SIGNAL_ADDTRAIT(TRAIT_FLOORED), PROC_REF(on_floored))
	return ..()

/datum/ai_controller/basic_controller/bounty/UnpossessPawn(destroy)
	if(pawn)
		UnregisterSignal(pawn, list(
			COMSIG_HOSTILE_PRE_ATTACKINGTARGET,
			COMSIG_HOSTILE_POST_ATTACKINGTARGET,
			COMSIG_BASICMOB_PRE_ATTACK_RANGED,
			COMSIG_BASICMOB_POST_ATTACK_RANGED,
			COMSIG_PROJECTILE_FIRER_BEFORE_FIRE,
			COMSIG_ATOM_DIR_CHANGE,
			COMSIG_ATOM_AFTER_ATTACKEDBY,
			COMSIG_ATOM_ATTACK_HAND,
			COMSIG_ATOM_ATTACK_ANIMAL,
			COMSIG_ATOM_ATTACK_MECH,
			COMSIG_ATOM_BULLET_ACT,
			COMSIG_ATOM_HITBY,
			COMSIG_MOB_APPLY_DAMAGE,
			SIGNAL_ADDTRAIT(TRAIT_FLOORED),
		))
	return ..()

/// Whether the pawn may land a blow or a shot on `target` (a companion fights on when its criminal is down, H3)
/datum/ai_controller/basic_controller/bounty/proc/may_strike(atom/target)
	return bounty_ai_may_hit(pawn, target)

/// Whether the pawn may shoot at `target` now at all. Subtypes add their rules.
/datum/ai_controller/basic_controller/bounty/proc/may_shoot(atom/target)
	return may_strike(target)

/// Someone attacked the pawn. Called outside the signal handler's stack.
/datum/ai_controller/basic_controller/bounty/proc/pawn_attacked(mob/living/attacker)
	return

/// Someone touched the pawn without attacking. Called outside the signal handler's stack.
/datum/ai_controller/basic_controller/bounty/proc/pawn_touched(mob/living/toucher)
	return

/// The pawn is about to take `damage` of `damagetype`. Called inside the signal handler: must not sleep.
/datum/ai_controller/basic_controller/bounty/proc/pawn_damaged(damage, damagetype)
	return

/// Moves what the pawn holds to the hand on the side it is turning to (`facing`)
/datum/ai_controller/basic_controller/bounty/proc/place_held(facing)
	return

/datum/ai_controller/basic_controller/bounty/proc/on_pre_melee(mob/living/basic/source, atom/target, proximity, list/modifiers)
	SIGNAL_HANDLER
	if(!may_strike(target))
		return COMPONENT_HOSTILE_NO_ATTACK
	// Each swing picks one of the weapon's own verbs, as a player's does
	bounty_ai_real_weapon(source)?.pick_verb(source)
	return NONE

/datum/ai_controller/basic_controller/bounty/proc/on_post_melee(mob/living/basic/source, atom/target, result)
	SIGNAL_HANDLER
	if(!result || !isliving(target))
		return
	var/datum/bounty_style/style = bounty_ai_style(source)
	if(style)
		INVOKE_ASYNC(style, TYPE_PROC_REF(/datum/bounty_style, on_melee_hit), source, target)

/datum/ai_controller/basic_controller/bounty/proc/on_pre_ranged(mob/living/basic/source, atom/target, list/modifiers)
	SIGNAL_HANDLER
	return may_shoot(target) ? NONE : COMPONENT_CANCEL_RANGED_ATTACK

/datum/ai_controller/basic_controller/bounty/proc/on_post_ranged(mob/living/basic/source, atom/target, list/modifiers)
	SIGNAL_HANDLER
	var/datum/bounty_style/style = bounty_ai_style(source)
	style?.after_shot(source)

/datum/ai_controller/basic_controller/bounty/proc/on_fire(mob/living/basic/source, obj/projectile/shot, atom/fired_from, atom/original)
	SIGNAL_HANDLER
	var/datum/bounty_style/style = bounty_ai_style(source)
	style?.prepare_projectile(source, shot)

/// Sent before the turn lands, so the new direction is passed on rather than read off the mob
/datum/ai_controller/basic_controller/bounty/proc/on_turned(atom/source, old_dir, new_dir)
	SIGNAL_HANDLER
	if(old_dir != new_dir)
		place_held(new_dir)

/datum/ai_controller/basic_controller/bounty/proc/on_attacked_by_item(atom/source, obj/item/weapon, mob/living/attacker, list/modifiers)
	SIGNAL_HANDLER
	if(weapon?.force && isliving(attacker))
		INVOKE_ASYNC(src, PROC_REF(pawn_attacked), attacker)

/datum/ai_controller/basic_controller/bounty/proc/on_touched(atom/source, mob/living/user, list/modifiers)
	SIGNAL_HANDLER
	if(!isliving(user) || user == source)
		return
	if(user.combat_mode || LAZYACCESS(modifiers, RIGHT_CLICK))
		INVOKE_ASYNC(src, PROC_REF(pawn_attacked), user)
	else
		INVOKE_ASYNC(src, PROC_REF(pawn_touched), user)

/datum/ai_controller/basic_controller/bounty/proc/on_attacked_by_mob(atom/source, mob/living/attacker)
	SIGNAL_HANDLER
	if(!isliving(attacker))
		return
	if(isbasicmob(attacker))
		var/mob/living/basic/basic_attacker = attacker
		if(basic_attacker.melee_damage_upper <= 0)
			return
	INVOKE_ASYNC(src, PROC_REF(pawn_attacked), attacker)

/// A mech's blow is its pilot's (H4)
/datum/ai_controller/basic_controller/bounty/proc/on_attacked_by_mech(atom/source, obj/vehicle/sealed/mecha/mecha_attacker, mob/living/pilot)
	SIGNAL_HANDLER
	var/mob/living/attacker = isliving(pilot) ? pilot : bounty_ai_pilot_of(mecha_attacker)
	if(attacker)
		INVOKE_ASYNC(src, PROC_REF(pawn_attacked), attacker)

/// Only a shot that actually hit: one that passed through a blended patron never gets here. A mech's gunfire is its pilot's (H4).
/datum/ai_controller/basic_controller/bounty/proc/on_shot(atom/source, obj/projectile/shot, def_zone, piercing_hit, blocked)
	SIGNAL_HANDLER
	if(!shot.is_hostile_projectile())
		return
	var/mob/living/attacker = shot.firer
	if(ismecha(attacker))
		attacker = bounty_ai_pilot_of(attacker)
	if(isliving(attacker))
		INVOKE_ASYNC(src, PROC_REF(pawn_attacked), attacker)

/// Knocked down: whatever they were doing stops now, a volley or a wind-up included (H2)
/datum/ai_controller/basic_controller/bounty/proc/on_floored(atom/source)
	SIGNAL_HANDLER
	CancelActions()

/datum/ai_controller/basic_controller/bounty/proc/on_hit_by_thrown(atom/source, atom/movable/thrown, skipcatch, hitpush, blocked, datum/thrownthing/throwingdatum)
	SIGNAL_HANDLER
	if(!isitem(thrown))
		return
	var/obj/item/thrown_item = thrown
	if(!thrown_item.throwforce)
		return
	var/mob/thrower = throwingdatum?.get_thrower()
	if(isliving(thrower))
		INVOKE_ASYNC(src, PROC_REF(pawn_attacked), thrower)

/datum/ai_controller/basic_controller/bounty/proc/on_damage(atom/source, damage, damagetype, def_zone, blocked, wound_bonus, exposed_wound_bonus, sharpness, attack_direction, attacking_item)
	SIGNAL_HANDLER
	pawn_damaged(damage, damagetype)

/**
 * A wanted criminal's controller: the base type's tree is the gate and their activity. Meek,
 * normal and decoy controllers add to it (bounty_ai_meek.dm, bounty_ai_normal.dm,
 * bounty_activities.dm). can_idle stays TRUE, as for every basic mob.
 */
/datum/ai_controller/basic_controller/bounty/criminal
	armed = FALSE
	planning_subtrees = list(
		/datum/ai_planning_subtree/bounty_gate,
		/datum/ai_planning_subtree/bounty_activity,
	)

/datum/ai_controller/basic_controller/bounty/criminal/TryPossessPawn(atom/new_pawn)
	if(!istype(new_pawn, /mob/living/basic/bounty_criminal))
		return AI_CONTROLLER_INCOMPATIBLE
	var/mob/living/basic/bounty_criminal/criminal = new_pawn
	RegisterSignal(criminal, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_prehit))
	RegisterSignal(criminal, COMSIG_ATOM_CAN_BE_PULLED, PROC_REF(on_pull_check))
	RegisterSignal(criminal, COMSIG_ATOM_BUMPED, PROC_REF(on_bumped))
	RegisterSignal(criminal, COMSIG_BOUNTY_CRIMINAL_DOWNED, PROC_REF(on_downed))
	RegisterSignal(criminal, COMSIG_BOUNTY_CRIMINAL_RECOVERED, PROC_REF(on_recovered))
	RegisterSignal(criminal, COMSIG_BOUNTY_CRIMINAL_RESTRAINED, PROC_REF(on_restrained))
	RegisterSignal(criminal, COMSIG_BOUNTY_CRIMINAL_UNRESTRAINED, PROC_REF(on_unrestrained))
	criminal.ai_set_pace(BOUNTY_CALM_SPEED)
	// Spec section 3: they don't fight the hostiles native to their site. The placement adds the
	// site's own factions (pirates) on top.
	var/list/sides = criminal.faction.Copy()
	sides -= FACTION_NEUTRAL
	sides |= FACTION_HOSTILE
	criminal.faction = sides
	return ..()

/datum/ai_controller/basic_controller/bounty/criminal/UnpossessPawn(destroy)
	var/mob/living/basic/bounty_criminal/criminal = pawn
	if(istype(criminal))
		UnregisterSignal(criminal, list(
			COMSIG_PROJECTILE_PREHIT,
			COMSIG_ATOM_CAN_BE_PULLED,
			COMSIG_ATOM_BUMPED,
			COMSIG_BOUNTY_CRIMINAL_DOWNED,
			COMSIG_BOUNTY_CRIMINAL_RECOVERED,
			COMSIG_BOUNTY_CRIMINAL_RESTRAINED,
			COMSIG_BOUNTY_CRIMINAL_UNRESTRAINED,
		))
		// Anything they hold goes, and a disguise comes off: this runs before the mob's contents are deleted.
		criminal.ai_let_go()
		criminal.ai_over_head = bounty_ai_update_held(criminal, criminal.ai_over_head, null)
		// Their camp stays as it is, but the fire burns down
		criminal.ai_put_out_camp()
	return ..()

/datum/ai_controller/basic_controller/bounty/criminal/on_stat_changed(mob/living/source, new_stat)
	. = ..()
	var/mob/living/basic/bounty_criminal/criminal = pawn
	if(istype(criminal) && criminal.stat == DEAD)
		criminal.ai_on_death()

/// No blow from someone giving up, cuffed, down, hidden or passing as a patron
/datum/ai_controller/basic_controller/bounty/criminal/may_strike(atom/target)
	var/mob/living/basic/bounty_criminal/criminal = pawn
	if(!istype(criminal) || !criminal.ai_can_act() || criminal.hidden || criminal.blended)
		return FALSE
	return ..()

/datum/ai_controller/basic_controller/bounty/criminal/may_shoot(atom/target)
	var/mob/living/basic/bounty_criminal/criminal = pawn
	if(!istype(criminal) || !criminal.ai_may_shoot(target))
		return FALSE
	return ..()

