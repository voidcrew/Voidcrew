/mob/living/basic/bounty_lair_boss/mafia_mech/Initialize(mapload)
	. = ..()
	add_traits(list(TRAIT_NOFIRE, TRAIT_NOBREATH, TRAIT_RESISTHIGHPRESSURE, TRAIT_RESISTLOWPRESSURE, TRAIT_NO_FLOATING_ANIM), INNATE_TRAIT)
	AddElement(/datum/element/footstep, FOOTSTEP_MOB_HEAVY)
	AddElement(/datum/element/relay_attackers)
	RegisterSignal(src, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(mech_on_attacked))
	RegisterSignal(src, COMSIG_ATOM_BULLET_ACT, PROC_REF(mech_on_bullet_act))
	RegisterSignal(src, COMSIG_MOVABLE_PRE_MOVE, PROC_REF(mech_on_pre_move))
	RegisterSignal(src, COMSIG_LIVING_PRE_WABBAJACKED, PROC_REF(mech_refuse_polymorph))
	RegisterSignal(src, COMSIG_PRE_MOB_CHANGED_TYPE, PROC_REF(mech_refuse_type_change))
	ban_from_containment()
	mech_home_turf = get_turf(src)
	var/area/home = get_area(src)
	if(home)
		mech_home_ref = WEAKREF(home)

/mob/living/basic/bounty_lair_boss/mafia_mech/Destroy()
	mech_interrupt()
	deltimer(mech_busy_timer)
	mech_busy_timer = null
	mech_engaged = null
	mech_grudge = null
	mech_home_ref = null
	mech_home_turf = null
	return ..()

/mob/living/basic/bounty_lair_boss/mafia_mech/Life(seconds_per_tick = SSMOBS_DT, times_fired)
	. = ..()
	if(stat == DEAD)
		return
	mech_check_home()
	mech_check_reset()

/mob/living/basic/bounty_lair_boss/mafia_mech/examine(mob/user)
	. = ..()
	if(stat == DEAD)
		return
	if(mech_busy == "stall")
		. += span_notice("It's locked up and sparking.")
	else if(health < maxHealth / 3)
		. += span_warning("Its plating is buckled and smoking.")

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_refuse_polymorph(datum/source, what_to_randomize)
	SIGNAL_HANDLER
	return STOP_WABBAJACK

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_refuse_type_change(datum/source)
	SIGNAL_HANDLER
	return COMPONENT_BLOCK_MOB_CHANGE

/// Says a line for "mech_<context>" unless it spoke recently or `force`
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_bark(context, force = FALSE)
	if(stat != CONSCIOUS || (!force && world.time < mech_next_bark_at))
		return FALSE
	if(!bounty_mafia_say(src, "mech_[context]"))
		return FALSE
	mech_next_bark_at = world.time + BOUNTY_MAFIA_BARK_COOLDOWN
	return TRUE

// ----- its arena -----

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_on_pre_move(datum/source, atom/new_loc)
	SIGNAL_HANDLER
	if(!bounty_mafia_leash_allows(src, mech_home_ref?.resolve(), new_loc))
		return COMPONENT_MOVABLE_BLOCK_PRE_MOVE
	return NONE

/// Dragged or thrown out of its arena somehow: it's put back where it started
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_check_home()
	var/area/arena = mech_home_ref?.resolve()
	if(!arena || !mech_home_turf || get_area(src) == arena)
		return FALSE
	new /obj/effect/temp_visual/small_smoke/halfsecond(get_turf(src))
	forceMove(mech_home_turf)
	new /obj/effect/temp_visual/small_smoke/halfsecond(mech_home_turf)
	return TRUE

// ----- state -----

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_can_act()
	return !QDELETED(src) && stat == CONSCIOUS && isturf(loc) && !HAS_TRAIT(src, TRAIT_INCAPACITATED)

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_can_start_ability()
	return mech_can_act() && !mech_busy && world.time >= mech_next_ability_at

/// Busy with `state`, standing still with its AI quiet, for `duration`. Returns the serial its timers check.
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_set_busy(state, duration)
	mech_busy = state
	mech_busy_serial++
	deltimer(mech_busy_timer)
	mech_busy_timer = null
	ADD_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_MAFIA_BUSY_TRAIT)
	ai_controller?.CancelActions()
	if(duration)
		mech_busy_timer = addtimer(CALLBACK(src, PROC_REF(mech_clear_busy), mech_busy_serial), duration, TIMER_STOPPABLE | TIMER_DELETE_ME)
	return mech_busy_serial

/// Free again, unless `serial` is stale
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_clear_busy(serial)
	if(serial && serial != mech_busy_serial)
		return FALSE
	mech_busy = null
	deltimer(mech_busy_timer)
	mech_busy_timer = null
	REMOVE_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_MAFIA_BUSY_TRAIT)
	return TRUE

/// Whether it's still busy with `state` under `serial`
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_still(state, serial)
	return !QDELETED(src) && stat == CONSCIOUS && mech_busy == state && mech_busy_serial == serial

/// Cut short whatever it was doing: its telegraphs go and nothing more fires
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_interrupt()
	mech_clear_telegraphs()
	mech_rocket_turfs = null
	mech_lmg_aim = null
	if(mech_busy)
		mech_clear_busy()

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_add_telegraph(atom/thing)
	if(thing)
		LAZYADD(mech_telegraphs, WEAKREF(thing))
	return thing

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_clear_telegraphs()
	for(var/datum/weakref/ref as anything in mech_telegraphs)
		var/atom/thing = ref.resolve()
		if(!QDELETED(thing))
			qdel(thing)
	mech_telegraphs = null

// ----- the posse -----

/// Health for 1, 2, 3 and 4+ hunters engaged
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_health_table()
	return list(BOUNTY_MECH_HEALTH_1, BOUNTY_MECH_HEALTH_2, BOUNTY_MECH_HEALTH_3, BOUNTY_MECH_HEALTH_4)

/**
 * Turns hostile, with `instigator` (seen or shooting) in its posse. The first time, every hunter it can see
 * joins too, and its guns come up after a beat.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_turn_hostile(mob/living/instigator)
	if(stat == DEAD)
		return FALSE
	mech_note_hunter()
	if(mech_hostile)
		if(instigator)
			mech_engage(instigator)
		return FALSE
	mech_hostile = TRUE
	if(instigator)
		mech_engage(instigator, announce = FALSE)
	for(var/mob/living/hunter as anything in mech_hunters_nearby())
		if(can_see(src, hunter, BOUNTY_MECH_SIGHT))
			mech_engage(hunter, announce = FALSE)
	mech_next_ability_at = max(mech_next_ability_at, world.time + 2 SECONDS)
	mech_lmg_ready_at = max(mech_lmg_ready_at, world.time + 2 SECONDS)
	mech_rockets_ready_at = max(mech_rockets_ready_at, world.time + 5 SECONDS)
	mech_bark("intro", force = TRUE)
	return TRUE

/// Adds `hunter` to its posse, raising its health for the bigger posse. TRUE if they're new.
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_engage(mob/living/hunter, announce = TRUE)
	if(stat == DEAD || !bounty_mafia_is_hunter(hunter))
		return FALSE
	var/key = REF(hunter)
	if(mech_engaged[key])
		return FALSE
	mech_engaged[key] = TRUE
	mech_apply_posse_health(announce)
	return TRUE

/**
 * Health for the posse it has, from mech_health_table(): raised, never lowered. Basic mobs keep damage apart
 * from max health, so its current health rises by the same amount. TRUE if it rose.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_apply_posse_health(announce = TRUE)
	var/count = length(mech_engaged)
	if(stat == DEAD || !count)
		return FALSE
	var/list/table = mech_health_table()
	var/wanted = table[clamp(count, 1, length(table))]
	if(wanted <= maxHealth)
		return FALSE
	setMaxHealth(wanted)
	updatehealth()
	if(announce && count > 1)
		mech_bark("posse")
	return TRUE

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_on_attacked(datum/source, atom/attacker, attack_flags)
	SIGNAL_HANDLER
	if(!(attack_flags & (ATTACKER_DAMAGING_ATTACK | ATTACKER_STAMINA_ATTACK)))
		return
	mech_answer_attack(attacker)

// Every shot that hits it, the ones relay_attackers skips too: a harmless ion bolt, an exosuit's guns (fired as the suit)
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_on_bullet_act(datum/source, obj/projectile/shot, def_zone, piercing_hit, blocked)
	SIGNAL_HANDLER
	mech_answer_attack(shot?.firer)

/**
 * `attacker` (a player, or an exosuit's pilots) went for it, from any range: they join its posse, it holds a grudge
 * (fair game at any range until the reset), the reset clock starts over, and it turns on them if it has no one else.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_answer_attack(atom/attacker)
	if(stat == DEAD || !attacker)
		return
	for(var/mob/living/hunter as anything in bounty_mafia_attackers(attacker))
		mech_grudge |= WEAKREF(hunter)
		mech_turn_hostile(hunter)
		if(ai_controller && !ai_controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET) && mech_target_ok(hunter))
			ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)

/// Whether `hunter` has hurt it since the last reset
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_holds_grudge(mob/living/hunter)
	return !isnull(hunter?.weak_reference) && (hunter.weak_reference in mech_grudge)

// ----- the reset -----

/// A hunter is about: in the arena, in its sight, or shooting at it
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_note_hunter()
	mech_last_hunter_at = world.time

/// Whether a player is in its arena (anywhere in its sight, with no arena)
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_hunter_in_arena()
	var/turf/here = get_turf(src)
	if(!here || here.z > length(SSmobs.clients_by_zlevel))
		return FALSE
	var/area/arena = mech_home_ref?.resolve()
	for(var/mob/living/person in SSmobs.clients_by_zlevel[here.z])
		if(!bounty_mafia_is_hunter(person))
			continue
		if(arena ? get_area(person) == arena : get_dist(src, person) <= BOUNTY_MECH_SIGHT)
			return TRUE
	return FALSE

/**
 * After BOUNTY_MECH_RESET_AFTER with nobody in its arena, in sight or shooting at it, a fight it was in resets:
 * full health, the one-hunter table and an empty posse, so a second crew never finishes a wounded mech (lairs.md
 * 9.5). Its Life() calls this. TRUE if it reset.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_check_reset()
	if(stat == DEAD)
		return FALSE
	if(!mech_hostile && !length(mech_engaged) && health >= maxHealth)
		return FALSE
	if(mech_hunter_in_arena())
		mech_note_hunter()
		return FALSE
	if(world.time < mech_last_hunter_at + BOUNTY_MECH_RESET_AFTER)
		return FALSE
	mech_reset()
	return TRUE

/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_reset()
	mech_interrupt()
	mech_hostile = FALSE
	mech_engaged = list()
	mech_grudge = list()
	adjust_health(-getBruteLoss())
	setMaxHealth(BOUNTY_MECH_HEALTH_1)
	updatehealth()
	ai_controller?.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	visible_message(span_notice("[src] vents steam as its repair arms fold away. It looks as good as new."))

// ----- targets -----

/**
 * Whether it may go after `target`: a hunter on their feet who is in its arena, in its sight, or has hurt it. One who
 * hurt it counts at any range up to BOUNTY_MECH_GRUDGE_RANGE, seen or not: it closes in on a sniper as far as its
 * arena lets it, and answers from there.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_target_ok(mob/living/target)
	if(!bounty_mafia_may_hurt(target) || faction_check_atom(target))
		return FALSE
	var/turf/spot = get_turf(target)
	if(!spot || spot.z != z)
		return FALSE
	var/distance = get_dist(src, spot)
	if(distance <= BOUNTY_MECH_GRUDGE_RANGE && mech_holds_grudge(target))
		return TRUE
	if(distance > BOUNTY_MECH_SIGHT)
		return FALSE
	var/area/arena = mech_home_ref?.resolve()
	return (arena && get_area(spot) == arena) || can_see(src, target, BOUNTY_MECH_SIGHT)

/// Every hunter it may go after: the players on its level (SSmobs' list), and anyone it holds a grudge against
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_hunters_nearby()
	. = list()
	var/turf/here = get_turf(src)
	if(!here || here.z > length(SSmobs.clients_by_zlevel))
		return
	for(var/mob/living/person in SSmobs.clients_by_zlevel[here.z])
		if(mech_target_ok(person))
			. |= person
	for(var/datum/weakref/ref as anything in mech_grudge)
		var/mob/living/person = ref.resolve()
		if(person && mech_target_ok(person))
			. |= person

/**
 * Its target: the one it has while they're fair game and in sight, else the nearest in sight, else the nearest in its
 * arena or holding its grudge.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_find_target()
	var/datum/ai_controller/controller = ai_controller
	if(!controller)
		return null
	var/mob/living/current = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!mech_target_ok(current))
		current = null
	if(!current || !can_see(src, current, BOUNTY_MECH_SIGHT))
		var/best_seen = FALSE
		var/best_distance = INFINITY
		for(var/mob/living/hunter as anything in mech_hunters_nearby())
			var/seen = can_see(src, hunter, BOUNTY_MECH_SIGHT)
			var/distance = get_dist(src, hunter)
			if((seen && !best_seen) || (seen == best_seen && distance < best_distance))
				current = hunter
				best_seen = seen
				best_distance = distance
	if(!current)
		if(controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
			controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		return null
	if(controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET] != current)
		controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, current)
	mech_note_hunter()
	if(!mech_hostile)
		mech_turn_hostile(current)
	return current

// ----- abilities -----

/// Everyone it can put a lock-on marker under: each hunter it can see
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_rocket_targets()
	. = list()
	for(var/mob/living/hunter as anything in mech_hunters_nearby())
		if(can_see(src, hunter, BOUNTY_MECH_SIGHT))
			. += hunter

/// Whether it would start an ability on `target` now
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_ability_ready(mob/living/target)
	if(!mech_can_start_ability())
		return FALSE
	if(world.time >= mech_rockets_ready_at && length(mech_rocket_targets()))
		return TRUE
	return world.time >= mech_lmg_ready_at && bounty_mafia_may_hurt(target) && can_see(src, target, BOUNTY_MECH_SIGHT)

/// Starts the volley if it's ready and has anyone to lock on to, else the machine gun on `target`. TRUE if one started.
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_try_ability(mob/living/target)
	if(!mech_can_start_ability())
		return FALSE
	if(world.time >= mech_rockets_ready_at && mech_start_rockets())
		return TRUE
	if(world.time >= mech_lmg_ready_at && mech_start_lmg(target))
		return TRUE
	return FALSE

/**
 * The rocket volley's lock-on: a red marker under each of `targets` (by default each hunter it can see), a
 * rising tone, and BOUNTY_MECH_ROCKET_LOCK later one rocket per marker (mech_fire_rockets()). Nothing is hurt
 * before then. Returns the serial the launch checks, or 0 if it didn't start.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_start_rockets(list/targets)
	if(!mech_can_start_ability())
		return 0
	if(isnull(targets))
		targets = mech_rocket_targets()
	var/turf/here = get_turf(src)
	var/list/spots = list()
	for(var/mob/living/hunter as anything in targets)
		if(!bounty_mafia_may_hurt(hunter))
			continue
		var/turf/spot = get_turf(hunter)
		if(spot && spot != here)
			spots |= spot
	if(!length(spots))
		return 0
	var/serial = mech_set_busy("rockets", BOUNTY_MECH_ROCKET_LOCK + 1 SECONDS)
	mech_rocket_turfs = spots
	for(var/turf/spot as anything in spots)
		mech_add_telegraph(new /obj/effect/temp_visual/bounty_mafia_mark(spot, BOUNTY_MECH_ROCKET_LOCK, COLOR_RED, 'icons/mob/telegraphing/telegraph.dmi', "target_circle"))
	face_atom(spots[1])
	mech_rockets_ready_at = world.time + BOUNTY_MECH_ROCKET_COOLDOWN
	mech_next_ability_at = world.time + BOUNTY_MECH_ROCKET_LOCK + BOUNTY_MECH_ABILITY_GAP
	playsound(src, 'sound/vehicles/mecha/skyfall_power_up.ogg', 80, FALSE)
	visible_message(span_danger("The rocket pods on [src]'s shoulders swing open with a rising beep. Red dots settle on the floor!"))
	mech_bark("rockets")
	addtimer(CALLBACK(src, PROC_REF(mech_fire_rockets), serial), BOUNTY_MECH_ROCKET_LOCK, TIMER_DELETE_ME)
	return serial

/// The lock-on under `serial` is over: one rocket at each marker. Returns the rockets fired.
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_fire_rockets(serial)
	. = list()
	if(!mech_still("rockets", serial))
		return
	mech_clear_telegraphs()
	var/list/spots = mech_rocket_turfs
	mech_rocket_turfs = null
	mech_clear_busy(serial)
	playsound(src, 'sound/items/weapons/gun/general/rocket_launch.ogg', 80, TRUE)
	var/list/volley = list()
	for(var/turf/spot as anything in spots)
		var/obj/projectile/bullet/bounty_mafia_rocket/rocket = mech_launch_rocket(spot, volley)
		if(rocket)
			. += rocket

/// Fires one rocket at the marker on `spot`, sharing `volley`'s list of who's been hit
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_launch_rocket(turf/spot, list/volley)
	var/turf/start = get_turf(src)
	if(!start || !spot || start == spot)
		return null
	var/obj/projectile/bullet/bounty_mafia_rocket/rocket = new mech_rocket_type(start)
	rocket.rocket_target = spot
	rocket.rocket_volley = volley
	rocket.rocket_area_ref = mech_home_ref
	rocket.firer = src
	rocket.fired_from = src
	rocket.ignored_factions = faction.Copy()
	rocket.range = get_dist(start, spot) + 3
	rocket.maximum_range = rocket.range
	rocket.aim_projectile(spot, src)
	if(QDELETED(rocket))
		return null
	rocket.fire()
	return QDELETED(rocket) ? null : rocket

/**
 * The machine gun's spin-up: a whirr and a red cone toward `target` for BOUNTY_MECH_LMG_WINDUP, then
 * BOUNTY_MECH_LMG_ROUNDS rounds sprayed over the cone (mech_fire_lmg()). The cone reaches as far as the target (at
 * least BOUNTY_MECH_LMG_RANGE), stays on the floor until the burst ends, and no round flies past it. Nothing is hurt
 * before the spin-up ends. Returns the serial the burst checks, or 0 if it didn't start.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_start_lmg(mob/living/target)
	if(!mech_can_start_ability() || !bounty_mafia_may_hurt(target) || !can_see(src, target, BOUNTY_MECH_SIGHT))
		return 0
	var/turf/origin = get_turf(src)
	var/turf/aim = get_turf(target)
	if(!origin || !aim || origin == aim)
		return 0
	var/serial = mech_set_busy("lmg_windup", BOUNTY_MECH_LMG_WINDUP + 1 SECONDS)
	mech_lmg_aim = aim
	mech_lmg_range = clamp(get_dist(origin, aim), BOUNTY_MECH_LMG_RANGE, BOUNTY_MECH_SIGHT)
	face_atom(target)
	for(var/turf/spot as anything in bounty_mafia_cone_turfs(origin, aim, mech_lmg_range, BOUNTY_MECH_LMG_ARC))
		mech_add_telegraph(new /obj/effect/temp_visual/bounty_mafia_mark(spot, BOUNTY_MECH_LMG_WINDUP + BOUNTY_MECH_LMG_FIRE_TIME, COLOR_RED))
	mech_lmg_ready_at = world.time + BOUNTY_MECH_LMG_COOLDOWN
	mech_next_ability_at = world.time + BOUNTY_MECH_LMG_WINDUP + BOUNTY_MECH_LMG_FIRE_TIME + BOUNTY_MECH_ABILITY_GAP
	playsound(src, 'sound/items/weapons/gun/l6/l6_rack.ogg', 80, TRUE)
	visible_message(span_danger("[src]'s machine gun whirs up and swings toward [target]!"))
	mech_bark("lmg")
	addtimer(CALLBACK(src, PROC_REF(mech_fire_lmg), serial), BOUNTY_MECH_LMG_WINDUP, TIMER_DELETE_ME)
	return serial

/// The spin-up under `serial` is over: the rounds go out across the cone, which stays marked. Returns the burst's serial, or 0.
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_fire_lmg(serial)
	if(!mech_still("lmg_windup", serial))
		return 0
	var/fire_serial = mech_set_busy("lmg_fire", BOUNTY_MECH_LMG_FIRE_TIME)
	var/interval = BOUNTY_MECH_LMG_FIRE_TIME / BOUNTY_MECH_LMG_ROUNDS
	mech_lmg_round(fire_serial)
	for(var/i in 2 to BOUNTY_MECH_LMG_ROUNDS)
		addtimer(CALLBACK(src, PROC_REF(mech_lmg_round), fire_serial), (i - 1) * interval, TIMER_DELETE_ME)
	return fire_serial

/// One round of the burst under `serial`, somewhere in the cone
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_lmg_round(serial)
	if(!mech_still("lmg_fire", serial) || !mech_lmg_aim)
		return null
	return bounty_mafia_shoot(src, mech_lmg_type, mech_lmg_aim, bounty_real_weapon(BOUNTY_MECH_LMG_GUN), BOUNTY_MECH_LMG_ARC, mech_lmg_range + 1)

/**
 * A stomp on someone right next to it, which throws them (their exosuit and all) BOUNTY_MECH_STOMP_THROW tiles
 * straight back, never out of its arena. TRUE if it landed.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_stomp(mob/living/target)
	if(!mech_can_act() || mech_busy || !Adjacent(target) || !mech_target_ok(target) || world.time < next_move)
		return FALSE
	. = melee_attack(target)
	if(!. || QDELETED(target))
		return
	var/atom/movable/thrown = ismecha(target.loc) ? target.loc : target
	bounty_throw_back(src, thrown, BOUNTY_MECH_STOMP_THROW, BOUNTY_MECH_STOMP_THROW_SPEED, keep_in = mech_home_ref?.resolve())

// ----- EMPs -----

// tg hands a robotic basic mob its whole max health on a heavy EMP; this stalls it instead (lairs.md 4)
/mob/living/basic/bounty_lair_boss/mafia_mech/emp_reaction(severity)
	mech_emp_stall()

/**
 * A BOUNTY_MECH_EMP_STALL stall and BOUNTY_MECH_EMP_DAMAGE_PERCENT of its max health, cutting off whatever it was
 * winding up. What it cut off is ready again the moment the stall ends, so an EMP buys a pause, never a free cancel
 * of the volley's or the gun's cooldown. Another EMP in the next BOUNTY_MECH_EMP_IMMUNITY after the stall does
 * nothing, so an ion gun can't hold it still. TRUE if it stalled.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_emp_stall()
	if(stat == DEAD || world.time < mech_emp_immune_until)
		return FALSE
	mech_emp_immune_until = world.time + BOUNTY_MECH_EMP_STALL + BOUNTY_MECH_EMP_IMMUNITY
	var/stall_ends = world.time + BOUNTY_MECH_EMP_STALL
	switch(mech_busy)
		if("rockets")
			mech_rockets_ready_at = stall_ends
		if("lmg_windup", "lmg_fire")
			mech_lmg_ready_at = stall_ends
	if(mech_busy)
		mech_next_ability_at = stall_ends
	mech_interrupt()
	mech_set_busy("stall", BOUNTY_MECH_EMP_STALL)
	adjust_health(maxHealth * BOUNTY_MECH_EMP_DAMAGE_PERCENT / 100)
	visible_message(span_boldwarning("[src] locks up in a shower of sparks, servos whining!"))
	playsound(src, 'sound/effects/empulse.ogg', 60, TRUE)
	do_sparks(4, FALSE, src)
	return TRUE

// ----- the don climbs out -----

/mob/living/basic/bounty_lair_boss/mafia_mech/death(gibbed)
	if(stat != DEAD && !mech_ejected)
		mech_interrupt()
		mech_eject()
	return ..()

/**
 * The mech breaks: a burnt-out wreck where it stood (decoration and cover, nothing to salvage) and the don
 * climbing out beside it, on the side away from the hunters, with the mech's posting. Returns the don.
 */
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_eject()
	if(mech_ejected)
		return null
	mech_ejected = TRUE
	var/turf/spot = get_turf(src)
	if(!spot)
		return null
	new /obj/effect/temp_visual/explosion/fast(spot)
	playsound(spot, 'sound/vehicles/mecha/critdestr.ogg', 100, TRUE)
	do_sparks(5, FALSE, spot)
	var/obj/structure/bounty_mafia_wreck/wreck = new(spot)
	wreck.setDir(dir)
	var/turf/exit = mech_exit_turf(spot)
	var/mob/living/basic/bounty_lair_boss/mafia_don/don = new(exit || spot)
	don.posting_ref = posting_ref
	don.don_wreck_ref = WEAKREF(wreck)
	// Whoever broke his machine, he knows
	don.don_grudge = mech_grudge.Copy()
	if(mech_home_ref)
		don.don_home_ref = mech_home_ref
		don.don_home_turf = mech_home_turf
	var/datum/criminal_bounty/posting = posting_ref?.resolve()
	if(posting?.record?.name)
		don.name = posting.record.name
		don.real_name = posting.record.name
	SEND_SIGNAL(src, COMSIG_BOUNTY_MAFIA_DON_EJECTED, don)
	don.don_on_eject()
	return don

/// The open tile beside `wreck_spot`, in its arena, farthest from the hunters
/mob/living/basic/bounty_lair_boss/mafia_mech/proc/mech_exit_turf(turf/wreck_spot)
	var/area/arena = mech_home_ref?.resolve()
	var/list/hunters = mech_hunters_nearby()
	var/turf/best
	var/best_score = -INFINITY
	for(var/turf/spot as anything in RANGE_TURFS(1, wreck_spot))
		if(spot == wreck_spot || isclosedturf(spot) || spot.is_blocked_turf(exclude_mobs = TRUE))
			continue
		if(arena && get_area(spot) != arena)
			continue
		var/score = 0
		for(var/mob/living/hunter as anything in hunters)
			score += get_dist(spot, hunter)
		if(score > best_score)
			best = spot
			best_score = score
	return best

