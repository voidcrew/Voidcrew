// Cuffs and soft crit don't stop a person's AI (human_npc_soft_crit.dm)
/datum/ai_controller/basic_controller/bounty_mafia/get_able_to_run()
	return human_npc_ai_able_to_run(src)

/datum/ai_controller/basic_controller/bounty_mafia/on_stat_changed(mob/living/source, new_stat)
	. = ..()
	human_npc_ai_stat_changed(src, new_stat)

/**
 * A goon's whole mind: its target; nothing until its room's shout is over; then reload, shoot with a line (or stab
 * or punch when next to them), else close in as far as its room lets it; with nobody to fight, back into its room.
 */
/datum/ai_planning_subtree/bounty_mafia_goon

/datum/ai_planning_subtree/bounty_mafia_goon/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_mafia/goon = controller.pawn
	if(!istype(goon) || goon.stat != CONSCIOUS)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(!goon.mafia_can_act())
		return SUBTREE_RETURN_FINISH_PLANNING
	var/at_home = goon.mafia_at_home()
	// It fights wherever it is; out of its room it only walks back once there's nobody to fight
	var/mob/living/target = goon.mafia_find_target()
	if(target && !goon.mafia_is_ready())
		goon.face_atom(target)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(target)
		if(goon.mafia_plan_attack(controller, target))
			goon.mafia_away_since = 0
			return SUBTREE_RETURN_FINISH_PLANNING
		if(at_home)
			if(goon.mafia_step_ok(target))
				controller.queue_behavior(/datum/ai_behavior/bounty_mafia_approach, BB_BASIC_MOB_CURRENT_TARGET)
				return SUBTREE_RETURN_FINISH_PLANNING
			// A wall between it and them: to the room's door nearest them
			var/turf/exit = goon.mafia_exit_toward(target)
			if(exit && exit != get_turf(goon))
				controller.set_blackboard_key(BB_BOUNTY_MAFIA_MOVE_TO, exit)
				controller.queue_behavior(/datum/ai_behavior/bounty_mafia_approach/onto, BB_BOUNTY_MAFIA_MOVE_TO)
			return SUBTREE_RETURN_FINISH_PLANNING
	// Nobody it can get at from here: out of its room, it walks back
	var/turf/home = goon.mafia_head_home()
	if(home)
		controller.set_blackboard_key(BB_BOUNTY_MAFIA_MOVE_TO, home)
		controller.queue_behavior(/datum/ai_behavior/bounty_mafia_approach/onto, BB_BOUNTY_MAFIA_MOVE_TO)
	return SUBTREE_RETURN_FINISH_PLANNING

// ----- the mech -----

/datum/ai_controller/basic_controller/bounty_mafia_mech
	blackboard = list()
	ai_movement = /datum/ai_movement/basic_avoidance
	idle_behavior = null
	planning_subtrees = list(
		/datum/ai_planning_subtree/bounty_mafia_mech,
	)

/// The mech's mind: nothing while it's busy; its target; an ability if one is ready; a stomp up close; else closer
/datum/ai_planning_subtree/bounty_mafia_mech

/datum/ai_planning_subtree/bounty_mafia_mech/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = controller.pawn
	if(!istype(mech) || mech.mech_busy || !mech.mech_can_act())
		return SUBTREE_RETURN_FINISH_PLANNING
	var/mob/living/target = mech.mech_find_target()
	if(!target)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(mech.mech_ability_ready(target))
		controller.queue_behavior(/datum/ai_behavior/bounty_mafia_mech_ability, BB_BASIC_MOB_CURRENT_TARGET)
	else if(mech.Adjacent(target))
		controller.queue_behavior(/datum/ai_behavior/bounty_mafia_mech_stomp, BB_BASIC_MOB_CURRENT_TARGET)
	else
		controller.queue_behavior(/datum/ai_behavior/bounty_mafia_approach, BB_BASIC_MOB_CURRENT_TARGET)
	return SUBTREE_RETURN_FINISH_PLANNING

/datum/ai_behavior/bounty_mafia_mech_ability

/datum/ai_behavior/bounty_mafia_mech_ability/perform(seconds_per_tick, datum/ai_controller/controller, target_key)
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = controller.pawn
	var/mob/living/target = controller.blackboard[target_key]
	if(!istype(mech) || QDELETED(target))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	return mech.mech_try_ability(target) ? (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED) : (AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED)

/datum/ai_behavior/bounty_mafia_mech_stomp

/datum/ai_behavior/bounty_mafia_mech_stomp/perform(seconds_per_tick, datum/ai_controller/controller, target_key)
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = controller.pawn
	var/mob/living/target = controller.blackboard[target_key]
	if(!istype(mech) || QDELETED(target))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	mech.mech_stomp(target)
	return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED

