	if(damage <= 0 || stat != CONSCIOUS)
		return
	if(mafia_gun?.fumbles && mafia_gun.winding)
		mafia_gun.fumble(BOUNTY_MOBSTER_FUMBLE)
		visible_message(span_notice("[src] flinches and loses [p_their()] aim."))
	if(prob(20))
		mafia_bark("hurt")

