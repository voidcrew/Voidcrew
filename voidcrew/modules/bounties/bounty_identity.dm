/**
 * # Bounty hunting: who a criminal is
 *
 * Owner: P1 identity. Owns this file, bounty_looks.dm, strings/bounty_criminals.json,
 * voidcrew/_DEFINES/bounty_identity.dm and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_identity.dm. Do not edit this file outside P1.
 *
 * What it owns: making a criminal's record (name and alias, species, gender, look, crime, style or
 * kit, distinguishing features, prison traits), decoy records that share some features, the examine
 * lines for features, and what criminals say: bounty_say() and its dialogue file (spec sections
 * 2 and 9).
 *
 * Nothing here builds a mob or sleeps: a record is data. The look builder and the mugshot are in
 * bounty_looks.dm.
 *
 * Distinguishing features are stored as key and text (BOUNTY_FEATURE_* = "across the left cheek"),
 * so a decoy shares a feature by copying the pair, and feature_lines() prints every record in the
 * same layout. Glasses and a scarf are also worn by the look builder when the outfit leaves the eyes
 * or neck free; hair comes from the look itself. The rest only show on examine.
 *
 * The record's vars are declared in bounty_types.dm and nowhere else; a var only P1 uses goes here
 * with an `identity_` prefix.
 */

/// The species a criminal can be, weighted: humans most common, flypeople rare. Every one was test-rendered on the look dummy (bounty_looks.dm).
GLOBAL_LIST_INIT(bounty_species_weights, list(
	/datum/species/human = 40,
	/datum/species/lizard = 12,
	/datum/species/moth = 10,
	/datum/species/human/felinid = 10,
	/datum/species/ethereal = 7,
	/datum/species/pod = 6,
	/datum/species/jelly = 6,
	/datum/species/plasmaman = 5,
	/datum/species/fly = 2,
))

/datum/bounty_record
	/// Their mugshot has been asked for and is being built on a timer (bounty_mugshot_asset())
	var/identity_mugshot_queued = FALSE

// ===== THE RECORD =====

/**
 * A new record for a criminal of `tier` (BOUNTY_TIER_*) and `archetype` (BOUNTY_ARCHETYPE_*),
 * wanted at a `placement_kind` (BOUNTY_PLACEMENT_*) site: everything filled in but base_value (P5).
 *
 * - No archetype: rolled from the tier (spec section 2).
 * - A mini-boss is never placed at a trader outpost (D-A8): there it becomes a normal criminal.
 * - At a trader outpost the record also gets an old look for its mugshot (make_old_look(), AR-C1).
 * - `species` forces a species (tests, admins); otherwise it is rolled from the pool.
 *
 * Doesn't sleep.
 */
/proc/generate_bounty_record(tier, archetype, placement_kind, species)
	var/datum/bounty_record/record = new
	if(!(tier in list(BOUNTY_TIER_PETTY, BOUNTY_TIER_WANTED, BOUNTY_TIER_MOST_WANTED)))
		tier = BOUNTY_TIER_PETTY
	record.tier = tier
	if(!(archetype in list(BOUNTY_ARCHETYPE_MEEK, BOUNTY_ARCHETYPE_NORMAL, BOUNTY_ARCHETYPE_BOSS)))
		archetype = bounty_roll_archetype(tier)
	if(archetype == BOUNTY_ARCHETYPE_BOSS && placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST)
		archetype = BOUNTY_ARCHETYPE_NORMAL
	record.archetype = archetype
	record.species = ispath(species, /datum/species) ? species : pick_weight(GLOB.bounty_species_weights)
	record.gender = pick(MALE, FEMALE)
	record.name = generate_random_name_species_based(record.gender, TRUE, record.species)
	record.look = bounty_roll_look(record.species, record.gender)
	switch(archetype)
		if(BOUNTY_ARCHETYPE_MEEK)
			record.style = BOUNTY_STYLE_HOLDOUT
		if(BOUNTY_ARCHETYPE_NORMAL)
			record.style = bounty_roll_style()
		if(BOUNTY_ARCHETYPE_BOSS)
			record.kit = bounty_roll_kit()
	record.alias = bounty_roll_alias(record)
	record.crime = bounty_roll_crime(tier)
	record.features = bounty_roll_features(record)
	record.prison_traits = list()
	if(placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST)
		make_old_look(record)
	return record

/// An archetype for a criminal of `tier`: Petty mostly meek, Wanted mostly normal, Most Wanted a mini-boss
/proc/bounty_roll_archetype(tier)
	switch(tier)
		if(BOUNTY_TIER_MOST_WANTED)
			return BOUNTY_ARCHETYPE_BOSS
		if(BOUNTY_TIER_WANTED)
			return prob(BOUNTY_WANTED_MEEK_CHANCE) ? BOUNTY_ARCHETYPE_MEEK : BOUNTY_ARCHETYPE_NORMAL
	return prob(BOUNTY_PETTY_MEEK_CHANCE) ? BOUNTY_ARCHETYPE_MEEK : BOUNTY_ARCHETYPE_NORMAL

/// A fighting style for a normal criminal, weighted
/proc/bounty_roll_style()
	var/static/list/weights = list(
		BOUNTY_STYLE_BRAWLER = 20,
		BOUNTY_STYLE_PISTOL = 20,
		BOUNTY_STYLE_KNIFE = 18,
		BOUNTY_STYLE_CLUB = 15,
		BOUNTY_STYLE_BOTTLE = 15,
		BOUNTY_STYLE_SHOTGUN = 12,
	)
	return pick_weight(weights)

/// A mini-boss kit, weighted
/proc/bounty_roll_kit()
	var/static/list/weights = list(
		BOUNTY_KIT_JUGGERNAUT = 22,
		BOUNTY_KIT_HEAVY = 22,
		BOUNTY_KIT_PYROMANIAC = 20,
		BOUNTY_KIT_DEMOLITIONIST = 18,
		BOUNTY_KIT_GHOST = 18,
	)
	return pick_weight(weights)

/// The dialogue file's key for `tier`'s crimes
/proc/bounty_tier_key(tier)
	switch(tier)
		if(BOUNTY_TIER_WANTED)
			return "wanted"
		if(BOUNTY_TIER_MOST_WANTED)
			return "most_wanted"
	return "petty"

/// What someone of `tier` is wanted for, a lower-case phrase
/proc/bounty_roll_crime(tier)
	var/list/crimes = bounty_identity_strings("crimes")
	var/list/pool = crimes[bounty_tier_key(tier)]
	return length(pool) ? pick(pool) : "skipping out on docking fees"

/// A short nickname: half the time one that fits their archetype or kit, else any
/proc/bounty_roll_alias(datum/bounty_record/record)
	var/list/aliases = bounty_identity_strings("aliases")
	var/voice = record.kit || record.archetype
	var/list/own = voice ? aliases[voice] : null
	var/list/shared = aliases["any"]
	var/list/pool = (length(own) && (prob(50) || !length(shared))) ? own : shared
	return length(pool) ? pick(pool) : "Slim"

/// A plain species name for cards and warrants: "Lizard", "Moth"
/proc/bounty_species_name(species)
	var/static/list/names = list(
		/datum/species/human = "Human",
		/datum/species/lizard = "Lizard",
		/datum/species/moth = "Moth",
		/datum/species/human/felinid = "Felinid",
		/datum/species/ethereal = "Ethereal",
		/datum/species/pod = "Podperson",
		/datum/species/jelly = "Jellyperson",
		/datum/species/plasmaman = "Plasmaman",
		/datum/species/fly = "Flyperson",
	)
	if(!ispath(species, /datum/species))
		return "Unknown"
	if(names[species])
		return names[species]
	var/datum/species/species_type = species
	return trim(replacetext(initial(species_type.name), "\improper", ""))

/// A top-level entry of the dialogue file, or an empty list; loaded once and cached
/proc/bounty_identity_strings(key)
	var/list/entry = strings(BOUNTY_IDENTITY_STRINGS_FILE, key, BOUNTY_IDENTITY_STRINGS_DIR)
	return islist(entry) ? entry : list()

// ===== SPECIES QUESTIONS =====

/// The head bodypart `species` gives its people
/proc/bounty_species_head(species)
	var/datum/species/prototype = ispath(species, /datum/species) ? GLOB.species_prototypes[species] : null
	var/head_type = prototype?.bodypart_overrides?[BODY_ZONE_HEAD]
	return ispath(head_type, /obj/item/bodypart/head) ? head_type : /obj/item/bodypart/head

/// Whether `species` grows hair on its head
/proc/bounty_species_has_hair(species)
	var/obj/item/bodypart/head/head_type = bounty_species_head(species)
	return !!(initial(head_type.head_flags) & HEAD_HAIR)

/// Whether `species` grows a beard
/proc/bounty_species_has_facial_hair(species)
	var/obj/item/bodypart/head/head_type = bounty_species_head(species)
	return !!(initial(head_type.head_flags) & HEAD_FACIAL_HAIR)

/// Whether `species` has hair in a colour of its own (not tied to its body colour, as an ethereal's or a jellyperson's is)
/proc/bounty_species_own_hair_colour(species)
	var/datum/species/prototype = ispath(species, /datum/species) ? GLOB.species_prototypes[species] : null
	return prototype && bounty_species_has_hair(species) && isnull(prototype.hair_color_mode)

/// Whether `species` has a skin tone rather than a body colour
/proc/bounty_species_uses_skin_tones(species)
	var/datum/species/prototype = ispath(species, /datum/species) ? GLOB.species_prototypes[species] : null
	return prototype && (TRAIT_USES_SKINTONES in prototype.inherent_traits)

// ===== LOOKS AS DATA =====

/// A new look for someone of `species` and `gender`, rolled the way tg rolls a new character, with natural hair
/proc/bounty_roll_look(species, gender)
	var/datum/bounty_look/look = new
	look.species = species || /datum/species/human
	look.physique = gender == FEMALE ? FEMALE : MALE
	if(bounty_species_uses_skin_tones(look.species))
		look.skin_tone = pick(GLOB.skin_tones)
	look.eye_color = random_eye_color()
	bounty_roll_hair(look)
	look.features = bounty_roll_species_features(look.species)
	return look

/// New hair (and beard) for `look`, as randomize_human_normie() would pick; bald for species without hair
/proc/bounty_roll_hair(datum/bounty_look/look)
	look.hair_color = random_hair_color()
	look.facial_hair_color = look.hair_color
	look.hairstyle = "Bald"
	look.facial_hairstyle = "Shaved"
	if(!bounty_species_has_hair(look.species))
		return
	look.hairstyle = outpost_npc_hairstyle(look.physique) || "Bald"
	if(look.physique == MALE && bounty_species_has_facial_hair(look.species) && prob(BOUNTY_FACIAL_HAIR_CHANCE))
		look.facial_hairstyle = outpost_npc_facial_hairstyle() || "Shaved"

/// Species features (dna.features) for `species`, rolled the way tg rolls a new character's, in colours that look natural
/proc/bounty_roll_species_features(species)
	var/datum/species/prototype = ispath(species, /datum/species) ? GLOB.species_prototypes[species] : null
	var/list/features = prototype ? prototype.randomize_features() : list()
	features[FEATURE_MUTANT_COLOR] = bounty_roll_body_colour(species)
	// Plain legs: every outfit's shoes and trousers fit them.
	features[FEATURE_LEGS] = NORMAL_LEGS
	// A felinid gets cat ears and a cat tail as the species goes in; store what they'll have.
	if(ispath(species, /datum/species/human/felinid))
		features[FEATURE_EARS] = "Cat"
		features[FEATURE_TAIL] = "Cat"
	return features

/// A body colour for species that have one: natural scales for lizards, leaf greens for podpeople, soft colours for the rest
/proc/bounty_roll_body_colour(species)
	var/static/list/scales = list("#4f8a3c", "#3d6b2f", "#7a9a3a", "#2f7a6a", "#8a6a3a", "#a07a4a", "#6a8a8a", "#9a4a2a", "#5a5a3a", "#3a5a7a", "#b08850")
	var/static/list/leaves = list("#886600", "#5f8f2a", "#3e7a2e", "#7a8f2a", "#4f9a4a", "#6b7a1f")
	if(ispath(species, /datum/species/lizard))
		return pick(scales)
	if(ispath(species, /datum/species/pod))
		return pick(leaves)
	return sanitize_hexcolor("[pick("7F", "FF")][pick("7F", "FF")][pick("7F", "FF")]")

/// A copy of `look` that can change without changing the original
/proc/bounty_copy_look(datum/bounty_look/look)
	var/datum/bounty_look/copy = new
	if(!look)
		return copy
	copy.species = look.species
	copy.physique = look.physique
	copy.skin_tone = look.skin_tone
	copy.hairstyle = look.hairstyle
	copy.hair_color = look.hair_color
	copy.facial_hairstyle = look.facial_hairstyle
	copy.facial_hair_color = look.facial_hair_color
	copy.eye_color = look.eye_color
	copy.features = look.features?.Copy()
	return copy

/// Makes sure `record` has a look (a bare record gets one rolled for its species and gender) and returns it
/proc/bounty_ensure_look(datum/bounty_record/record)
	if(!record.look)
		if(!ispath(record.species, /datum/species))
			record.species = /datum/species/human
		record.look = bounty_roll_look(record.species, record.gender)
	return record.look

// ===== HAIR IN WORDS =====

/// The shape of a hairstyle in plain words ("ponytail", "cropped short"), or null for none (bald, shaved)
/proc/bounty_hair_shape(hairstyle)
	var/style = lowertext("[hairstyle]")
	if(!length(style))
		return null
	if(findtext(style, "mohawk"))
		return "mohawk"
	if(findtext(style, "undercut") || findtext(style, "sidecut") || findtext(style, "half-shaved") || findtext(style, "shaved part"))
		return "undercut"
	if(findtext(style, "balding") || findtext(style, "thinning"))
		return "thinning"
	if(findtext(style, "bald") || findtext(style, "shaved") || findtext(style, "skinhead") || findtext(style, "fade (none)"))
		return null
	if(findtext(style, "afro") || findtext(style, "fuzz"))
		return "afro"
	if(findtext(style, "dread"))
		return "dreadlocks"
	if(findtext(style, "cornrow"))
		return "cornrows"
	if(findtext(style, "braid"))
		return "braided"
	// Before "tail": pigtails and twintails aren't ponytails.
	if(findtext(style, "pigtail") || findtext(style, "twintail") || findtext(style, "odango") || findtext(style, "drill"))
		return "pigtails"
	if(findtext(style, "ponytail") || findtext(style, "tail"))
		return "ponytail"
	if(findtext(style, "bun") || findtext(style, "updo") || findtext(style, "beehive") || findtext(style, "topknot"))
		return "tied up in a bun"
	if(findtext(style, "bob"))
		return "bob cut"
	if(findtext(style, "curl") || findtext(style, "poofy"))
		return "curly"
	if(findtext(style, "spiky") || findtext(style, "hedgehog") || findtext(style, "hitop"))
		return "spiky"
	if(findtext(style, "bowlcut"))
		return "bowl cut"
	if(findtext(style, "buzz") || findtext(style, "crewcut") || findtext(style, "flat top") || findtext(style, "fade") || findtext(style, "trim") || findtext(style, "cut hair"))
		return "cropped short"
	if(findtext(style, "pompadour") || findtext(style, "quiff") || findtext(style, "gelled") || findtext(style, "swept back") || findtext(style, "business") || findtext(style, "combover") || findtext(style, "parted"))
		return "slicked back"
	if(findtext(style, "bedhead") || findtext(style, "messy") || findtext(style, "unkept"))
		return "messy"
	// Before "long", "bangs" and "over eye": short bangs and a short hime cut are short.
	if(findtext(style, "short") || findtext(style, "pixie"))
		return "short"
	if(findtext(style, "long") || findtext(style, "shoulder") || findtext(style, "hime") || findtext(style, "tress"))
		return "long"
	if(findtext(style, "emo") || findtext(style, "over eye") || findtext(style, "fringe") || findtext(style, "bangs"))
		return "long fringe"
	return "medium length"

/// The nearest plain name for a hair colour: "black", "auburn", "platinum blonde"
/proc/bounty_hair_colour_name(hex)
	var/static/list/named = list(
		"black" = "#15120f",
		"dark brown" = "#3a2a1f",
		"brown" = "#6a4a30",
		"auburn" = "#8e3a1e",
		"ginger" = "#d8641c",
		"light brown" = "#a8805a",
		"blonde" = "#dcb679",
		"platinum blonde" = "#f6ecd2",
		"grey" = "#9b9591",
		"white" = "#eeeeee",
	)
	if(!istext(hex) || !length(hex))
		return "black"
	var/list/colour = rgb2num(hex)
	if(length(colour) < 3)
		return "black"
	var/best_name = "black"
	var/best_distance = INFINITY
	for(var/name in named)
		var/list/sample = rgb2num(named[name])
		var/distance = (colour[1] - sample[1]) ** 2 + (colour[2] - sample[2]) ** 2 + (colour[3] - sample[3]) ** 2
		if(distance < best_distance)
			best_distance = distance
			best_name = name
	return best_name

/// Their hair as a feature reads ("long, black"), or null when it can't be one: no hair, or hair coloured by the body
/proc/bounty_hair_words(datum/bounty_look/look)
	if(!look || !bounty_species_own_hair_colour(look.species))
		return null
	var/shape = bounty_hair_shape(look.hairstyle)
	if(!shape)
		return null
	return "[shape], [bounty_hair_colour_name(look.hair_color)]"

/// How their hair reads to someone comparing faces: its shape, and its colour when the colour is its own
/proc/bounty_hair_key(datum/bounty_look/look)
	if(!look)
		return null
	var/shape = bounty_hair_shape(look.hairstyle) || "none"
	if(!bounty_species_own_hair_colour(look.species))
		return shape
	return "[shape]|[bounty_hair_colour_name(look.hair_color)]"

/**
 * Whether `one` and `other` (the same species and sex) have nothing in their hair in common that
 * anyone could match on: another shape (so another style), another colour where the colour is the
 * hair's own, and another beard where the sex and species grow one. Traits nobody of that species
 * and sex can differ in (no hair at all, body-coloured hair, no beard) count as different: everyone
 * shares them, so they tell nobody apart.
 */
/proc/bounty_hair_nothing_alike(datum/bounty_look/one, datum/bounty_look/other)
	if(!one || !other)
		return FALSE
	var/species = one.species
	if(bounty_species_has_hair(species))
		if((bounty_hair_shape(one.hairstyle) || "none") == (bounty_hair_shape(other.hairstyle) || "none"))
			return FALSE
		if(bounty_species_own_hair_colour(species) && bounty_hair_colour_name(one.hair_color) == bounty_hair_colour_name(other.hair_color))
			return FALSE
	if(one.physique == MALE && bounty_species_has_facial_hair(species) && (one.facial_hairstyle || "Shaved") == (other.facial_hairstyle || "Shaved"))
		return FALSE
	return TRUE

// ===== DISTINGUISHING FEATURES =====

/// Every feature kind, in the order examine prints them, with its label
/proc/bounty_feature_labels()
	var/static/list/labels = list(
		BOUNTY_FEATURE_HAIR = "Hair",
		BOUNTY_FEATURE_SCAR = "Scar",
		BOUNTY_FEATURE_TATTOO = "Tattoo",
		BOUNTY_FEATURE_EAR = "Ears",
		BOUNTY_FEATURE_GLASSES = "Eyewear",
		BOUNTY_FEATURE_CLOTHING = "Clothing",
		BOUNTY_FEATURE_LIMP = "Walk",
	)
	return labels

/// Eyewear a feature can name, and the item the look builder puts on for it
/proc/bounty_glasses_items()
	var/static/list/items = list(
		"thin glasses" = /obj/item/clothing/glasses/regular/thin,
		"round glasses" = /obj/item/clothing/glasses/regular/circle,
		"thick glasses" = /obj/item/clothing/glasses/regular/jamjar,
		"sunglasses" = /obj/item/clothing/glasses/sunglasses,
		"an eyepatch" = /obj/item/clothing/glasses/eyepatch,
	)
	return items

/// Scarves a feature can name, and the item the look builder puts on for it
/proc/bounty_scarf_items()
	var/static/list/items = list(
		"a red scarf" = /obj/item/clothing/neck/scarf/red,
		"a green scarf" = /obj/item/clothing/neck/scarf/green,
		"a dark blue scarf" = /obj/item/clothing/neck/scarf/darkblue,
		"a purple scarf" = /obj/item/clothing/neck/scarf/purple,
		"a yellow scarf" = /obj/item/clothing/neck/scarf/yellow,
		"an orange scarf" = /obj/item/clothing/neck/scarf/orange,
		"a cyan scarf" = /obj/item/clothing/neck/scarf/cyan,
		"a black scarf" = /obj/item/clothing/neck/scarf/black,
		"a pink scarf" = /obj/item/clothing/neck/scarf/pink,
	)
	return items

/// Whether someone of `species` can have a feature of `kind`: no tattoos on gel or bone, no ears to lose without a person's head
/proc/bounty_feature_allowed(kind, species)
	var/static/list/no_scars = typecacheof(list(/datum/species/jelly, /datum/species/plasmaman))
	var/static/list/no_tattoos = typecacheof(list(/datum/species/jelly, /datum/species/plasmaman, /datum/species/ethereal))
	if(!ispath(species, /datum/species))
		return FALSE
	switch(kind)
		if(BOUNTY_FEATURE_HAIR)
			return bounty_species_own_hair_colour(species)
		if(BOUNTY_FEATURE_EAR)
			return bounty_species_has_hair(species)
		if(BOUNTY_FEATURE_SCAR)
			return !no_scars[species]
		if(BOUNTY_FEATURE_TATTOO)
			return !no_tattoos[species]
	return TRUE

/// The feature kinds someone of `species` can have, with their weights
/proc/bounty_feature_kinds(species)
	var/static/list/weights = list(
		BOUNTY_FEATURE_HAIR = 3,
		BOUNTY_FEATURE_SCAR = 3,
		BOUNTY_FEATURE_TATTOO = 3,
		BOUNTY_FEATURE_CLOTHING = 2,
		BOUNTY_FEATURE_GLASSES = 2,
		BOUNTY_FEATURE_LIMP = 1,
		BOUNTY_FEATURE_EAR = 1,
	)
	var/list/kinds = list()
	for(var/kind in weights)
		if(bounty_feature_allowed(kind, species))
			kinds[kind] = weights[kind]
	return kinds

/**
 * A value for a feature of `kind` that isn't `exclude`, or null if there is none. Hair isn't rolled
 * here: it comes from the look (bounty_hair_words()).
 */
/proc/bounty_roll_feature_value(kind, exclude)
	var/list/options
	switch(kind)
		if(BOUNTY_FEATURE_HAIR)
			return null
		if(BOUNTY_FEATURE_GLASSES)
			options = bounty_glasses_items()
		if(BOUNTY_FEATURE_CLOTHING)
			options = bounty_scarf_items()
		else
			var/list/wording = bounty_identity_strings("features")
			options = wording[kind]
	var/list/choices = list()
	for(var/option in options)
		if(istext(option) && option != exclude)
			choices += option
	return length(choices) ? pick(choices) : null

/// 2-3 distinguishing features for `record`, from what its species can have; hair only when its hair has a shape
/proc/bounty_roll_features(datum/bounty_record/record)
	var/list/features = list()
	var/count = rand(BOUNTY_FEATURES_MIN, BOUNTY_FEATURES_MAX)
	var/list/kinds = bounty_feature_kinds(record.species)
	var/hair = bounty_hair_words(record.look)
	if(!hair)
		kinds -= BOUNTY_FEATURE_HAIR
	while(length(features) < count && length(kinds))
		var/kind = pick_weight(kinds)
		kinds -= kind
		var/value = kind == BOUNTY_FEATURE_HAIR ? hair : bounty_roll_feature_value(kind)
		if(value)
			features[kind] = value
	return features

/**
 * Their distinguishing features as examine lines, one per feature, always in the same order and
 * layout ("Scar: across the left cheek."), so a fugitive and its decoys read alike (AR-C2). Plain
 * text: the caller adds any span.
 */
/datum/bounty_record/proc/feature_lines()
	var/list/lines = list()
	if(!length(features))
		return lines
	var/list/labels = bounty_feature_labels()
	for(var/kind in labels)
		var/value = features[kind]
		if(istext(value) && length(value))
			lines += "[labels[kind]]: [value]."
	return lines

// ===== DECOYS =====

/**
 * A record for a decoy at a trader outpost who looks like `wanted` in exactly `shared` of its
 * features, and never in all of them (`shared` is capped one below their count).
 *
 * The decoy is rolled against the wanted person's CURRENT look (AR-C1): the same species, sex,
 * skin, eyes and body features, so the old mugshot can't pick them out. Their hair reads
 * differently from the wanted person's (now and in the mugshot) unless hair is a shared feature.
 * They have as many features as the wanted person, and every one they don't share differs. They
 * speak and fight as the same archetype, so their lines come from the same pool.
 *
 * Doesn't sleep.
 */
/proc/make_decoy_record(datum/bounty_record/wanted, shared)
	if(!wanted)
		return generate_bounty_record(BOUNTY_TIER_PETTY, BOUNTY_ARCHETYPE_MEEK)
	bounty_ensure_look(wanted)
	var/list/wanted_features = wanted.features || list()
	var/count = length(wanted_features) || rand(BOUNTY_FEATURES_MIN, BOUNTY_FEATURES_MAX)
	shared = clamp(round(isnum(shared) ? shared : 0), 0, max(length(wanted_features) - 1, 0))

	var/datum/bounty_record/decoy = new
	decoy.tier = wanted.tier
	decoy.archetype = wanted.archetype
	decoy.style = wanted.style
	decoy.kit = wanted.kit
	decoy.species = wanted.look.species
	decoy.gender = wanted.gender
	decoy.name = generate_random_name_species_based(decoy.gender == FEMALE ? FEMALE : MALE, TRUE, decoy.species)
	decoy.alias = bounty_roll_alias(decoy)
	decoy.crime = bounty_roll_crime(BOUNTY_TIER_PETTY)
	decoy.prison_traits = list()
	decoy.look = bounty_copy_look(wanted.look)

	var/list/kinds_in_common = list()
	for(var/kind in wanted_features)
		kinds_in_common += kind
	kinds_in_common = shuffle(kinds_in_common)
	kinds_in_common.Cut(shared + 1)
	decoy.features = list()
	for(var/kind in kinds_in_common)
		decoy.features[kind] = wanted_features[kind]

	// Hair in common copies the hair; otherwise it reads differently from theirs.
	if(!(BOUNTY_FEATURE_HAIR in kinds_in_common))
		bounty_reroll_decoy_hair(decoy.look, wanted)

	var/list/kinds = bounty_feature_kinds(decoy.species)
	for(var/kind in kinds_in_common)
		kinds -= kind
	var/decoy_hair = bounty_hair_words(decoy.look)
	if(!decoy_hair)
		kinds -= BOUNTY_FEATURE_HAIR
	while(length(decoy.features) < count && length(kinds))
		var/kind = pick_weight(kinds)
		kinds -= kind
		var/value = kind == BOUNTY_FEATURE_HAIR ? decoy_hair : bounty_roll_feature_value(kind, wanted_features[kind])
		if(value && value != wanted_features[kind])
			decoy.features[kind] = value
	return decoy

/**
 * New hair for a decoy's `look`: it reads differently from `wanted`'s current hair (they don't share
 * the Hair feature), and has nothing in common with the hair in `wanted`'s old-look mugshot, just as
 * the fugitive's own current hair has nothing in common with it (make_old_look()). So the mugshot's
 * hair matches no patron and picks out nobody.
 */
/proc/bounty_reroll_decoy_hair(datum/bounty_look/look, datum/bounty_record/wanted)
	if(!bounty_species_has_hair(look.species))
		return
	var/current_hair = bounty_hair_key(wanted.look)
	for(var/attempt in 1 to BOUNTY_HAIR_ROLL_ATTEMPTS)
		bounty_roll_hair(look)
		if(bounty_hair_key(look) == current_hair)
			continue
		if(wanted.old_look && !bounty_hair_nothing_alike(look, wanted.old_look))
			continue
		return

// ===== WHAT THEY SAY =====

/**
 * What a mob remembers of its own bounty lines: when it may speak again and what it said lately.
 * Added the first time it speaks through bounty_say().
 */
/datum/component/bounty_identity_voice
	/// Lines said lately (as written in the file, before placeholders) -> world.time said
	var/list/recent_lines = list()
	/// The last thing said, filled in
	var/last_line
	/// Running until the mob may say another unforced line
	COOLDOWN_DECLARE(line_cooldown)

/datum/component/bounty_identity_voice/Initialize()
	if(!isliving(parent))
		return COMPONENT_INCOMPATIBLE

/// Forgets lines said longer ago than the no-repeat window
/datum/component/bounty_identity_voice/proc/forget_old_lines()
	for(var/line in recent_lines.Copy())
		if(world.time - recent_lines[line] >= BOUNTY_SAY_NO_REPEAT)
			recent_lines -= line

/// `line` with `values`' placeholders filled in ("{crime}" = "smuggling")
/datum/component/bounty_identity_voice/proc/fill_line(line, list/values)
	for(var/placeholder in values)
		line = replacetext(line, placeholder, "[values[placeholder]]")
	return line

/// The lines of `pool` that can be said now: every placeholder filled, and (when `fresh`) none said lately
/datum/component/bounty_identity_voice/proc/usable_lines(list/pool, list/values, fresh)
	var/list/usable = list()
	for(var/line in pool)
		if(!istext(line) || (fresh && (line in recent_lines)))
			continue
		if(findtext(fill_line(line, values), "{"))
			continue
		usable += line
	return usable

/**
 * A line for `context` in `voice` (an archetype, or null for the shared lines only), as
 * list(line as written, line filled in), or null. A forced line may repeat a recent one when
 * nothing fresh is left.
 */
/datum/component/bounty_identity_voice/proc/pick_line(context, voice, list/values, force)
	var/list/all_lines = bounty_identity_strings("lines")
	var/list/by_voice = all_lines[context]
	if(!islist(by_voice))
		return null
	forget_old_lines()
	var/list/own = voice ? by_voice[voice] : null
	var/list/shared = by_voice["any"]
	var/list/first = (length(own) && prob(BOUNTY_SAY_VOICE_CHANCE)) ? own : shared
	var/list/second = first == own ? shared : own
	var/list/usable = usable_lines(first, values, TRUE)
	if(!length(usable))
		usable = usable_lines(second, values, TRUE)
	if(!length(usable) && force)
		usable = usable_lines(first, values, FALSE) + usable_lines(second, values, FALSE)
	if(!length(usable))
		return null
	var/line = pick(usable)
	return list(line, fill_line(line, values))

/**
 * Says a line for `context` (the contexts in strings/bounty_criminals.json) through a per-mob
 * cooldown (BOUNTY_SAY_COOLDOWN) and a no-repeat window per line (BOUNTY_SAY_NO_REPEAT). Returns
 * TRUE only if they said something; when they can't speak (dead, unconscious, mute) or no line
 * fits, it returns FALSE and neither uses a line nor starts the cooldown, so callers can fall back.
 *
 * - `values`: placeholders for the line, list("{other}" = "Sal"). A line naming a placeholder with
 *   no value is skipped. A criminal fills "{crime}" itself, below Most Wanted only.
 * - `force`: skips the cooldown, and may repeat a recent line when nothing fresh is left. For
 *   answers that must come (a warrant shown, the beam out).
 *
 * Criminals pick from their archetype's own lines first (identity_voice()); a blended fugitive and
 * every decoy use the shared lines only, so nothing they say tells them apart.
 *
 * The line goes out as forced speech (no chat filter or prompt, even for a possessed mob), so it
 * doesn't wait on anyone; say() is still marked as able to sleep, so a signal handler calls this
 * through INVOKE_ASYNC.
 */
/mob/living/proc/bounty_say(context, list/values, force = FALSE)
	if(QDELETED(src) || !istext(context) || !identity_can_bark())
		return FALSE
	var/datum/component/bounty_identity_voice/voice = LoadComponent(/datum/component/bounty_identity_voice)
	if(!voice)
		return FALSE
	if(!force && !COOLDOWN_FINISHED(voice, line_cooldown))
		return FALSE
	var/list/line_values = identity_line_values() || list()
	for(var/placeholder in values)
		line_values[placeholder] = values[placeholder]
	var/list/picked = voice.pick_line(context, identity_voice(), line_values, force)
	if(!picked)
		return FALSE
	voice.recent_lines[picked[1]] = world.time
	voice.last_line = picked[2]
	COOLDOWN_START(voice, line_cooldown, BOUNTY_SAY_COOLDOWN)
	say(picked[2], forced = "bounty line")
	return TRUE

/// Whether say() would let them speak out loud now: awake enough, and not mute
/mob/living/proc/identity_can_bark()
	if(stat == DEAD || stat == UNCONSCIOUS || stat == HARD_CRIT)
		return FALSE
	return can_speak()

/// Whose lines they pick first in bounty_say(): an archetype, or null for the shared lines only
/mob/living/proc/identity_voice()
	return null

/// Placeholder values they fill themselves in bounty_say(), or null
/mob/living/proc/identity_line_values()
	return null

/mob/living/basic/bounty_criminal/identity_voice()
	// Blended in at a trader outpost, the fugitive talks exactly like its decoys (AR-C6).
	if(blended)
		return null
	return record?.archetype

/mob/living/basic/bounty_criminal/identity_line_values()
	// A Most Wanted crime is no line to toss off ("All this over the Corvina Station massacre?").
	if(!record?.crime || record.tier == BOUNTY_TIER_MOST_WANTED)
		return null
	return list("{crime}" = record.crime)

/// A decoy is an innocent patron: always the shared, neutral lines, whether or not it is blended in
/mob/living/basic/bounty_criminal/decoy/identity_voice()
	return null

/// A decoy has no crime to own up to
/mob/living/basic/bounty_criminal/decoy/identity_line_values()
	return null
