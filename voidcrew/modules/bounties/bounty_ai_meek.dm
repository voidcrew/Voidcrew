/**
 * # Bounty hunting: the meek criminal's AI
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * What it owns: the meek archetype (spec section 3, C6):
 * - sprinting faster than a runner, getting winded, and getting the sprint back by resting or
 *   hiding (TRAIT_BOUNTY_SPRINTING while running flat out, for the body's dodge);
 * - noticing hunters, and choosing the best hiding place ONCE per flight within
 *   BOUNTY_MEEK_HIDE_RADIUS, on their site: a locker or crate (in, and shut), a potted plant (they
 *   take it and pass as it), a dark tile (they stand still, faded);
 * - being found (the container opened; bumped, touched, pulled, hit or examined up close; a light
 *   coming near), which shoves the finder back a tile and sends them running again;
 * - a restless tell while hidden a long time, so a search can end;
 * - cornered: a shout, a short aim with the holdout (the telegraph), a quick volley, then
 *   running again. A stamina hit during the aim makes them fumble it; each shot checks they can
 *   still shoot.
 * It never loots and never attacks first.
 *
 * The shared vars (`hidden` and the rest) are declared in bounty_types.dm and nowhere else; a var
 * only P3 uses has an `ai_` prefix. The hiding procs sit on the base type so the shared hooks
 * (attacked, touched, pulled, dead, deleted) can undo them for anyone.
 */

/mob/living/basic/bounty_criminal
	/// How they are hidden while `hidden`: BOUNTY_HIDE_CONTAINER, _PLANT or _DARK
	var/ai_hide_mode
	/// Weakref to what they hide in or as: the closet, the plant or the turf
	var/datum/weakref/ai_hide_ref
	/// Weakref to where they last hid, so someone found picks somewhere new
	var/datum/weakref/ai_last_hide_ref
	/// The tile on their side of the closet picked for this flight, to climb in from (H1)
	var/turf/ai_hide_stand
	/// world.time they hid
	var/ai_hidden_since = 0
	/// world.time of the next restless tell
	var/ai_next_restless = 0
	/// world.time they next check whether it is quiet enough to come out
	var/ai_next_quiet_check = 0
	/// Their own look, kept while they pass as a plant or stand faded in the dark
	var/list/ai_disguise_saved
	/// Deciseconds of sprint left
	var/ai_sprint_left = BOUNTY_MEEK_SPRINT_TIME
	/// Out of breath: slow until the sprint is all back
	var/ai_winded = FALSE
	/// world.time the sprint was last worked out
	var/ai_sprint_checked_at = 0
	/// world.time this cornering began, or 0
	var/ai_cornered_since = 0
	/// world.time running away last failed, or 0
	var/ai_run_failed_at = 0
	/// world.time the holdout may come out again
	var/ai_holdout_ready_at = 0
	/// Aiming the holdout: world.time the shots go off, or 0
	var/ai_aim_until = 0
	/// Their stamina loss when the aim began: any more at the shot and they fumble it
	var/ai_aim_stamina = 0
	/// Weakref to who they aim at
	var/datum/weakref/ai_aim_ref
	/// Shots of the volley still to fire, and when the next goes
	var/ai_volley_left = 0
	var/ai_next_volley_shot = 0
	/// Weakref to who the volley is at
	var/datum/weakref/ai_volley_ref
	/// Set only while a volley shot is being fired, so no other shot gets out
	var/ai_firing = FALSE

#ifdef UNIT_TESTS
/// Unit tests only: turfs that read as dark. The test room is fullbright, so nothing is dark there otherwise.
GLOBAL_LIST_EMPTY(bounty_ai_test_dark_turfs)
#endif

/mob/living/basic/bounty_criminal/meek
	ai_controller = /datum/ai_controller/basic_controller/bounty/criminal/meek

/datum/ai_controller/basic_controller/bounty/criminal/meek
	armed = TRUE
	planning_subtrees = list(
		/datum/ai_planning_subtree/bounty_gate,
		/datum/ai_planning_subtree/bounty_meek_volley,
		/datum/ai_planning_subtree/bounty_notice,
		/datum/ai_planning_subtree/bounty_meek_flee,
		// For a decoy on this tree (P6 gives decoys their fugitive's controller): run, then calm down (M3, L6)
		/datum/ai_planning_subtree/bounty_flee_and_calm,
		/datum/ai_planning_subtree/bounty_activity,
	)

/mob/living/basic/bounty_criminal/meek/ai_notice_range()
	return BOUNTY_MEEK_NOTICE_RANGE

/mob/living/basic/bounty_criminal/meek/ai_wanted_style()
	return BOUNTY_STYLE_HOLDOUT

/// The holdout is the same little gun whatever the tier
/mob/living/basic/bounty_criminal/meek/ai_heavy_weapon()
	return FALSE

/mob/living/basic/bounty_criminal/meek/ai_sprints()
	return TRUE

/mob/living/basic/bounty_criminal/meek/ai_notice(mob/living/hunter)
	ai_flee_event(hunter, "noticed")

/mob/living/basic/bounty_criminal/meek/ai_react(mob/living/threat, bark)
	ai_flee_event(threat, bark)

/// Hit while running: they run from whoever is closer
/mob/living/basic/bounty_criminal/meek/ai_attacked_again(mob/living/attacker)
	var/mob/living/threat = ai_threat()
	if(!threat || bounty_ai_dist(src, attacker) < bounty_ai_dist(src, threat))
		ai_set_threat(attacker)
		ai_controller?.set_blackboard_key(BB_BASIC_MOB_FLEE_TARGET, bounty_ai_target_for(attacker))
	ai_bark("hurt")

/// Anything that hurts a hider finds them
/mob/living/basic/bounty_criminal/meek/ai_took_damage(damage, damagetype)
	if(hidden && damage > 0)
		INVOKE_ASYNC(src, PROC_REF(ai_reveal), null, "hurt")

/// Only the cornered volley gets a shot out: they never attack first
/mob/living/basic/bounty_criminal/meek/ai_may_shoot(atom/target)
	return ai_firing

/// Passing as a plant, they look and read like the plant; up close, looking at them gives them away
/mob/living/basic/bounty_criminal/meek/examine(mob/user)
	if(!hidden || ai_hide_mode == BOUNTY_HIDE_CONTAINER)
		return ..()
	if(user && get_dist(user, src) <= 1 && bounty_ai_is_hunter(user))
		INVOKE_ASYNC(src, PROC_REF(ai_reveal), user, "examined")
	if(ai_hide_mode == BOUNTY_HIDE_PLANT)
		var/obj/item/kirbyplants/plant = ai_hide_ref?.resolve()
		if(plant)
			return plant.examine(user)
	return ..()

// ===== RUNNING =====

/// Whether they sprint and tire (only the meek)
/mob/living/basic/bounty_criminal/proc/ai_sprints()
	return FALSE

/**
 * Starts running from `threat`: gets up, drops what they are doing, and (if `seek_hiding`) picks
 * the best hiding place in reach, once for this whole flight. `bark` is the line to shout, or
 * null for the usual one on a fresh flight (none if `quiet`).
 */
/mob/living/basic/bounty_criminal/proc/ai_flee_event(mob/living/threat, bark, seek_hiding = TRUE, quiet = FALSE)
	if(!ai_can_act() || hidden)
		return FALSE
	var/fresh = ai_mode != BOUNTY_AI_FLEEING
	ai_suspend_activity()
	ai_stand_up()
	ai_set_mode(BOUNTY_AI_FLEEING)
	if(threat)
		ai_set_threat(threat)
	else
		ai_threat_seen_at = world.time
	ai_cornered_since = 0
	ai_run_failed_at = 0
	ai_travel_failures = 0
	if(!QDELETED(ai_controller))
		var/atom/spot = seek_hiding ? ai_pick_hide_spot(ai_threat()) : null
		if(spot)
			ai_controller.set_blackboard_key(BB_BOUNTY_HIDE_SPOT, spot)
		else
			ai_controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
		var/mob/living/current = ai_threat()
		if(current)
			ai_controller.set_blackboard_key(BB_BASIC_MOB_FLEE_TARGET, bounty_ai_target_for(current))
	if(bark)
		ai_bark(bark)
	else if(fresh && !quiet)
		ai_bark("flee")
	if(ai_sprints())
		ai_update_sprint()
	return TRUE

/// Their sprint speed: a lizard's is a little quicker
/mob/living/basic/bounty_criminal/proc/ai_sprint_speed()
	if(ispath(record?.species, /datum/species/lizard))
		return BOUNTY_MEEK_SPRINT_SPEED - BOUNTY_MEEK_LIZARD_SPRINT_BONUS
	return BOUNTY_MEEK_SPRINT_SPEED

/**
 * Works out their sprint since the last time: running in sight of the hunter uses it up, and then
 * they are winded (slow) until it is all back. It comes back fastest hidden, slowly while out of
 * sight but still on the run, and at a rest in BOUNTY_MEEK_REST_TIME. Sets their pace and
 * TRAIT_BOUNTY_SPRINTING while running flat out (never winded, cornered or shooting).
 */
/mob/living/basic/bounty_criminal/proc/ai_update_sprint()
	var/now = world.time
	var/elapsed = ai_sprint_checked_at ? min(now - ai_sprint_checked_at, 5 SECONDS) : 0
	ai_sprint_checked_at = now
	var/running = ai_mode == BOUNTY_AI_FLEEING && !hidden && !ai_aim_until && !ai_volley_left && !ai_cornered_since && (now - ai_threat_seen_at) <= 1 SECONDS
	if(running)
		if(!ai_winded)
			ai_sprint_left -= elapsed
	else if(hidden)
		ai_sprint_left += elapsed * BOUNTY_MEEK_RECOVER_HIDDEN
	else if(ai_mode == BOUNTY_AI_FLEEING)
		ai_sprint_left += elapsed * BOUNTY_MEEK_RECOVER_WALKING
	else
		ai_sprint_left += elapsed * (BOUNTY_MEEK_SPRINT_TIME / BOUNTY_MEEK_REST_TIME)
	ai_sprint_left = clamp(ai_sprint_left, 0, BOUNTY_MEEK_SPRINT_TIME)
	if(!ai_winded && ai_sprint_left <= 0)
		ai_winded = TRUE
		visible_message(span_notice("[src] is out of breath."))
		ai_bark("winded")
	else if(ai_winded && ai_sprint_left >= BOUNTY_MEEK_SPRINT_TIME)
		ai_winded = FALSE
	if(running && !ai_winded)
		ADD_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	else
		REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	if(ai_mode == BOUNTY_AI_FLEEING)
		ai_set_pace(ai_winded ? BOUNTY_MEEK_WINDED_SPEED : ai_sprint_speed())

/**
 * The run: to the hiding place chosen for this flight if there is one and it is still good, else
 * away from the hunter while they can see them, else still and catching their breath. Cornered,
 * the holdout comes out. Out of sight long enough, they calm down.
 */
/datum/ai_planning_subtree/bounty_meek_flee

/datum/ai_planning_subtree/bounty_meek_flee/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	// A decoy given this tree (P6 gives decoys their fugitive's controller) never sprints, hides or
	// draws: bounty_flee_and_calm, next in the tree, runs it (L6).
	if(!criminal.ai_sprints())
		return
	var/seen = criminal.ai_mode == BOUNTY_AI_FLEEING && criminal.ai_sees_threat(BOUNTY_MEEK_HIDE_RADIUS)
	criminal.ai_update_sprint()
	if(criminal.ai_mode != BOUNTY_AI_FLEEING)
		return
	var/mob/living/threat = criminal.ai_threat()
	if(!threat || world.time - criminal.ai_threat_seen_at > BOUNTY_MEEK_CALM_AFTER)
		criminal.ai_calm_down()
		return
	if(seen && criminal.ai_check_cornered(threat))
		controller.queue_behavior(/datum/ai_behavior/bounty_holdout_volley)
		return SUBTREE_RETURN_FINISH_PLANNING
	var/atom/spot = controller.blackboard[BB_BOUNTY_HIDE_SPOT]
	if(spot && !criminal.ai_hide_spot_usable(spot))
		controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		spot = null
	if(spot)
		if(criminal.ai_at_hide_spot(spot))
			controller.queue_behavior(/datum/ai_behavior/bounty_hide, BB_BOUNTY_HIDE_SPOT)
			return SUBTREE_RETURN_FINISH_PLANNING
		var/turf/approach = criminal.ai_hide_approach(spot)
		if(approach)
			controller.set_blackboard_key(BB_BOUNTY_DESTINATION, approach)
			controller.queue_behavior(/datum/ai_behavior/travel_towards/bounty, BB_BOUNTY_DESTINATION)
			return SUBTREE_RETURN_FINISH_PLANNING
		controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
	if(seen)
		controller.set_blackboard_key(BB_BASIC_MOB_FLEE_TARGET, bounty_ai_target_for(threat))
		controller.queue_behavior(/datum/ai_behavior/run_away_from_target/bounty, BB_BASIC_MOB_FLEE_TARGET, BB_BASIC_MOB_FLEE_TARGET_HIDING_LOCATION)
		if(controller.current_behaviors[GET_AI_BEHAVIOR(/datum/ai_behavior/run_away_from_target/bounty)])
			return SUBTREE_RETURN_FINISH_PLANNING
	// Out of their sight with nowhere to hide, or nowhere to run: keep still, facing them, and plan on
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * tg's run away, staying on the site: a leg never goes off the leash, into lava or into a chasm
 * (D-A9). When no leg works, the criminal is cornered (ai_run_failed_at).
 */
/datum/ai_behavior/run_away_from_target/bounty
	clear_failed_targets = FALSE

/datum/ai_behavior/run_away_from_target/bounty/setup(datum/ai_controller/controller, target_key, hiding_location_key)
	. = ..()
	if(!.)
		var/mob/living/basic/bounty_criminal/criminal = controller.pawn
		if(istype(criminal))
			criminal.ai_run_failed_at = world.time

/datum/ai_behavior/run_away_from_target/bounty/perform(seconds_per_tick, datum/ai_controller/controller, target_key, hiding_location_key)
	. = ..()
	if(. & AI_BEHAVIOR_FAILED)
		var/mob/living/basic/bounty_criminal/criminal = controller.pawn
		if(istype(criminal))
			criminal.ai_run_failed_at = world.time

/datum/ai_behavior/run_away_from_target/bounty/get_furthest_turf(atom/source, angle, atom/target)
	var/turf/return_turf
	var/list/airlocks = SSmachines.get_machines_by_type_and_subtypes(/obj/machinery/door/airlock)
	var/mob/living/basic/bounty_criminal/leash_holder = bounty_ai_side_of(source)
	for(var/i in 1 to run_distance)
		var/turf/test_destination = get_ranged_target_turf_direct(source, target, range = i, offset = angle)
		if(test_destination.is_blocked_turf(source_atom = source, ignore_atoms = airlocks))
			break
		if(islava(test_destination) || ischasm(test_destination))
			break
		if(leash_holder && !leash_holder.leash_ok(test_destination))
			break
		return_turf = test_destination
	return return_turf

/// A tg flee subtree that runs with the leash-keeping run above: for companions that break
/datum/ai_planning_subtree/flee_target/bounty
	flee_behaviour = /datum/ai_behavior/run_away_from_target/bounty
	target_key = BB_BASIC_MOB_FLEE_TARGET
	hiding_place_key = BB_BASIC_MOB_FLEE_TARGET_HIDING_LOCATION

// ===== CORNERED =====

/// How many ways out lead away from `threat`: free, on the leash, and further from them
/mob/living/basic/bounty_criminal/proc/ai_ways_out(mob/living/threat)
	. = 0
	var/turf/here = get_turf(src)
	if(!here || !threat)
		return
	var/here_distance = bounty_ai_dist(here, threat)
	for(var/direction in GLOB.alldirs)
		var/turf/next = get_step(here, direction)
		if(!next || next.is_blocked_turf(source_atom = src) || bounty_ai_dist(next, threat) <= here_distance || !leash_ok(next))
			continue
		.++

/**
 * Whether they are cornered by `threat`, and have been for BOUNTY_MEEK_CORNERED_TIME: the hunter
 * close, with running away failing or fewer than two ways out. Once it has lasted, and the holdout
 * is ready, the aim starts. Returns TRUE when it did. Being held no longer counts: a free criminal
 * pulls away from any hand (P2), so a grab only happens while it is stunned and can't act (H2).
 */
/mob/living/basic/bounty_criminal/proc/ai_check_cornered(mob/living/threat)
	if(!ai_sprints() || world.time < ai_holdout_ready_at || !threat || !ai_can_act())
		ai_cornered_since = 0
		return FALSE
	var/cornered = FALSE
	if(bounty_ai_dist(src, threat) <= BOUNTY_MEEK_CORNER_RANGE)
		cornered = (ai_run_failed_at && world.time - ai_run_failed_at < BOUNTY_MEEK_RUN_FAIL_WINDOW) || ai_ways_out(threat) < 2
	if(!cornered)
		ai_cornered_since = 0
		return FALSE
	if(!ai_cornered_since)
		// The warning, before the gun comes out
		ai_cornered_since = world.time
		ai_bark("cornered")
		return FALSE
	if(world.time - ai_cornered_since < BOUNTY_MEEK_CORNERED_TIME)
		return FALSE
	if(threat.stat != CONSCIOUS || !bounty_ai_can_see(src, threat, BOUNTY_MEEK_PISTOL_RANGE))
		return FALSE
	return ai_start_aim(threat)

/// The aim: the holdout in hand, a mark where it points, a shout. The shots start BOUNTY_MEEK_PISTOL_WINDUP later. Never from the floor (H2).
/mob/living/basic/bounty_criminal/proc/ai_start_aim(mob/living/target)
	if(!ai_sprints() || ai_aim_until || ai_volley_left || !ai_can_act() || !isturf(loc) || !isliving(target))
		return FALSE
	ai_update_style()
	ai_aim_ref = WEAKREF(target)
	ai_aim_until = world.time + BOUNTY_MEEK_PISTOL_WINDUP
	ai_aim_stamina = staminaloss
	ai_cornered_since = 0
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	face_atom(bounty_ai_target_for(target))
	ai_hand = bounty_ai_update_held(src, ai_hand, bounty_ai_held_look(src) || /obj/item/gun/ballistic/automatic/pistol)
	new /obj/effect/temp_visual/telegraphing/bounty_aim(get_turf(target))
	visible_message(span_danger("[src] pulls out a small pistol and aims it at [target]!"))
	to_chat(target, span_userdanger("[src] is aiming a pistol at you!"))
	playsound(src, 'sound/items/weapons/gun/pistol/rack_small.ogg', 50, TRUE)
	// Forced: the draw is a one-second warning, and a meek criminal has just said "cornered" or "hurt"
	ai_bark("draw_gun", TRUE)
	return TRUE

/**
 * The aim is up: the volley starts, BOUNTY_MEEK_PISTOL_SHOTS shots (never more than the holdout's
 * magazine) BOUNTY_MEEK_PISTOL_GAP apart, the first one now. A stamina hit or a stun during the aim
 * makes them fumble it instead. Returns TRUE if the first shot went.
 */
/mob/living/basic/bounty_criminal/proc/ai_fire_holdout()
	var/mob/living/target = ai_aim_ref?.resolve()
	var/stunned = !ai_can_act() || staminaloss > ai_aim_stamina + 1 || HAS_TRAIT(src, TRAIT_INCAPACITATED)
	ai_aim_until = 0
	ai_aim_ref = null
	ai_holdout_ready_at = world.time + BOUNTY_MEEK_PISTOL_COOLDOWN
	ai_run_failed_at = 0
	if(stunned)
		ai_fumble()
		return FALSE
	if(!ai_volley_target_ok(target))
		ai_put_gun_away()
		return FALSE
	var/datum/bounty_real_weapon/holdout = bounty_ai_real_weapon(src)
	ai_volley_left = holdout?.magazine ? min(BOUNTY_MEEK_PISTOL_SHOTS, holdout.magazine) : BOUNTY_MEEK_PISTOL_SHOTS
	ai_volley_ref = WEAKREF(target)
	return ai_volley_shot()

/// Whether the volley may go on at `target`: awake (downed hunters are left alone, C4), close and in sight
/mob/living/basic/bounty_criminal/proc/ai_volley_target_ok(mob/living/target)
	return !QDELETED(target) && target.stat == CONSCIOUS && bounty_ai_can_see(src, target, BOUNTY_MEEK_PISTOL_RANGE)

/**
 * One shot of the volley, if they can still shoot (on their feet, not hidden) and the target is
 * still there. Returns TRUE if a shot left the gun; a shot the gun refused ends the volley.
 */
/mob/living/basic/bounty_criminal/proc/ai_volley_shot()
	var/mob/living/target = ai_volley_ref?.resolve()
	if(!ai_volley_left || !ai_can_act() || hidden || !isturf(loc) || !ai_volley_target_ok(target))
		ai_end_volley()
		return FALSE
	var/datum/component/ranged_attacks/gun = GetComponent(/datum/component/ranged_attacks)
	if(!gun)
		ai_end_volley()
		return FALSE
	face_atom(bounty_ai_target_for(target))
	var/cooldown_before = gun.fire_cooldown
	ai_firing = TRUE
	RangedAttack(bounty_ai_target_for(target))
	ai_firing = FALSE
	// The gun starts its cooldown only when it fires: a refused shot leaves it as it was
	if(gun.fire_cooldown == cooldown_before || gun.fire_cooldown <= world.time)
		ai_end_volley()
		return FALSE
	ai_volley_left--
	ai_next_volley_shot = world.time + BOUNTY_MEEK_PISTOL_GAP
	if(!ai_volley_left)
		ai_end_volley()
	return TRUE

/// The volley is over (or cut short): the gun goes away a moment later
/mob/living/basic/bounty_criminal/proc/ai_end_volley()
	ai_volley_left = 0
	ai_volley_ref = null
	addtimer(CALLBACK(src, PROC_REF(ai_put_gun_away)), 0.5 SECONDS, TIMER_DELETE_ME)

/// A stamina hit or a stun during the aim: the volley never happens and they run
/mob/living/basic/bounty_criminal/proc/ai_fumble()
	ai_aim_until = 0
	ai_aim_ref = null
	ai_volley_left = 0
	ai_volley_ref = null
	ai_holdout_ready_at = max(ai_holdout_ready_at, world.time + BOUNTY_MEEK_PISTOL_COOLDOWN)
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	if(stat != DEAD)
		visible_message(span_notice("[src] fumbles the pistol!"))

/// Puts the holdout away after the volley
/mob/living/basic/bounty_criminal/proc/ai_put_gun_away()
	if(ai_aim_until || ai_volley_left || ai_mode == BOUNTY_AI_FIGHTING)
		return
	ai_hand = bounty_ai_update_held(src, ai_hand, null)

/// Drops the aim and the volley without a word: they calmed down, hid, were cuffed, died
/mob/living/basic/bounty_criminal/proc/ai_stop_aiming()
	if(!ai_aim_until && !ai_volley_left)
		return
	ai_aim_until = 0
	ai_aim_ref = null
	ai_volley_left = 0
	ai_volley_ref = null
	ai_hand = bounty_ai_update_held(src, ai_hand, null)

/// The mark where a cornered criminal aims, for the length of the aim
/obj/effect/temp_visual/telegraphing/bounty_aim
	duration = BOUNTY_MEEK_PISTOL_WINDUP

/// The volley: first in a meek criminal's tree while an aim or a volley is on
/datum/ai_planning_subtree/bounty_meek_volley
	operational_datums = list(/datum/component/ranged_attacks)

/datum/ai_planning_subtree/bounty_meek_volley/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(!criminal.ai_aim_until && !criminal.ai_volley_left)
		return
	controller.queue_behavior(/datum/ai_behavior/bounty_holdout_volley)
	return SUBTREE_RETURN_FINISH_PLANNING

/// Holds the aim, then fires the volley shot by shot. Cancelled (a stun stops the AI), the aim is fumbled or the volley cut short.
/datum/ai_behavior/bounty_holdout_volley
	action_cooldown = 0.2 SECONDS

/datum/ai_behavior/bounty_holdout_volley/setup(datum/ai_controller/controller)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	return istype(criminal) && (criminal.ai_aim_until || criminal.ai_volley_left)

/datum/ai_behavior/bounty_holdout_volley/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_aim_until)
		if(world.time < criminal.ai_aim_until)
			var/mob/living/target = criminal.ai_aim_ref?.resolve()
			if(target)
				criminal.face_atom(bounty_ai_target_for(target))
			return AI_BEHAVIOR_DELAY
		if(!criminal.ai_fire_holdout())
			return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED
		return criminal.ai_volley_left ? AI_BEHAVIOR_DELAY : (AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED)
	if(criminal.ai_volley_left)
		if(world.time >= criminal.ai_next_volley_shot)
			criminal.ai_volley_shot()
		return criminal.ai_volley_left ? AI_BEHAVIOR_DELAY : (AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED)
	return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED

/datum/ai_behavior/bounty_holdout_volley/finish_action(datum/ai_controller/controller, succeeded)
	. = ..()
	if(succeeded)
		return
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(!istype(criminal))
		return
	if(criminal.ai_aim_until)
		criminal.ai_fumble()
	else if(criminal.ai_volley_left)
		criminal.ai_end_volley()

// ===== CHOOSING A HIDING PLACE =====

/**
 * The best hiding place within BOUNTY_MEEK_HIDE_RADIUS, looked for once per flight: lockers,
 * crates and potted plants in range, and up to BOUNTY_MEEK_DARK_SAMPLES dark tiles. Only places
 * they can walk to from where they stand (one flood of the floor on their side of any wall, window
 * or locked door: H1). Places the hunter is closer to are out; further from the hunter, nearer to
 * them and out of the hunter's sight is better. Never where they were just found, never off their
 * site. Null if nothing will do.
 */
/mob/living/basic/bounty_criminal/proc/ai_pick_hide_spot(mob/living/threat)
	var/turf/center = get_turf(src)
	if(!center)
		return null
	var/list/reachable = ai_reachable_turfs(BOUNTY_MEEK_HIDE_RADIUS)
	var/atom/last = ai_last_hide_ref?.resolve()
	var/atom/best
	var/best_score
	var/turf/best_stand
	ai_hide_stand = null
	for(var/obj/thing in range(BOUNTY_MEEK_HIDE_RADIUS, center))
		if(thing == last)
			continue
		var/bonus
		var/turf/stand
		if(istype(thing, /obj/structure/closet))
			if(!ai_container_usable(thing))
				continue
			stand = ai_container_approach(thing, reachable)
			if(!stand)
				continue
			bonus = istype(thing, /obj/structure/closet/crate) ? BOUNTY_HIDE_SCORE_CRATE : BOUNTY_HIDE_SCORE_LOCKER
		else if(istype(thing, /obj/item/kirbyplants))
			if(!ai_plant_usable(thing) || !reachable[thing.loc])
				continue
			bonus = BOUNTY_HIDE_SCORE_PLANT
		else
			continue
		var/score = ai_score_hide_spot(thing, threat)
		if(isnull(score))
			continue
		score += bonus
		if(isnull(best_score) || score > best_score)
			best = thing
			best_score = score
			best_stand = stand
	var/dark_bonus = BOUNTY_HIDE_SCORE_DARK + (ispath(record?.species, /datum/species/moth) ? BOUNTY_HIDE_SCORE_MOTH_DARK : 0)
	for(var/turf/tile as anything in ai_dark_candidates(reachable))
		if(tile == last)
			continue
		var/score = ai_score_hide_spot(tile, threat)
		if(isnull(score))
			continue
		score += dark_bonus
		if(isnull(best_score) || score > best_score)
			best = tile
			best_score = score
			best_stand = null
	ai_hide_stand = best_stand
	return best

/// How good `spot` is to hide from `threat`, or null if it is no good at all
/mob/living/basic/bounty_criminal/proc/ai_score_hide_spot(atom/spot, mob/living/threat)
	var/turf/spot_turf = get_turf(spot)
	if(!spot_turf || spot_turf.z != z)
		return null
	var/own_distance = get_dist(src, spot_turf)
	. = -own_distance
	// By their turf: a pilot inside a mech has no map position of their own (H4)
	var/turf/threat_turf = get_turf(threat)
	if(!threat_turf || threat_turf.z != spot_turf.z)
		return
	var/their_distance = get_dist(threat_turf, spot_turf)
	if(their_distance < own_distance)
		return null
	. += their_distance * 2
	if(!can_see(threat_turf, spot_turf, BOUNTY_MEEK_HIDE_RADIUS + 2))
		. += BOUNTY_HIDE_SCORE_UNSEEN

/// Up to `samples` dark tiles they could stand in, sampled once from `reachable` (turf = TRUE, the floor they can walk to)
/mob/living/basic/bounty_criminal/proc/ai_dark_candidates(list/reachable, samples = BOUNTY_MEEK_DARK_SAMPLES)
	. = list()
	var/list/pool = list()
	for(var/turf/tile as anything in reachable)
		pool += tile
	while(samples > 0 && length(pool))
		samples--
		var/turf/tile = pick_n_take(pool)
		if(ai_dark_usable(tile))
			. += tile

/**
 * Whether `tile` is dark enough to hide in. A turf with no lighting object (planet ground, lit by
 * its area's ambient light) reads its area's base light instead, which tg's lumcount skips (L2).
 */
/mob/living/basic/bounty_criminal/proc/ai_tile_is_dark(turf/tile)
	if(!isturf(tile))
		return FALSE
#ifdef UNIT_TESTS
	if(tile in GLOB.bounty_ai_test_dark_turfs)
		return TRUE
#endif
	if(!tile.lighting_object)
		var/area/tile_area = tile.loc
		return (tile_area.base_lighting_alpha / 255) + tile.dynamic_lumcount < BOUNTY_MEEK_DARK_LUMCOUNT
	return tile.get_lumcount() < BOUNTY_MEEK_DARK_LUMCOUNT

/mob/living/basic/bounty_criminal/proc/ai_hide_spot_usable(atom/spot)
	if(QDELETED(spot))
		return FALSE
	if(istype(spot, /obj/structure/closet))
		return ai_container_usable(spot)
	if(istype(spot, /obj/item/kirbyplants))
		return ai_plant_usable(spot)
	if(isturf(spot))
		return ai_dark_usable(spot)
	return FALSE

/**
 * A locker or crate they fit in: on the floor, unlocked, not welded, not full, not outpost property,
 * not a body bag, and nobody standing in it (shutting it would take them along).
 */
/mob/living/basic/bounty_criminal/proc/ai_container_usable(obj/structure/closet/container)
	if(QDELETED(container) || !isturf(container.loc) || container.locked || container.welded)
		return FALSE
	if(istype(container, /obj/structure/closet/body_bag) || container.wall_mounted || (container.resistance_flags & INDESTRUCTIBLE))
		return FALSE
	if(mob_size > container.max_mob_size || length(container.contents) >= container.storage_capacity)
		return FALSE
	for(var/mob/living/standing in container.loc)
		if(standing != src)
			return FALSE
	var/mobs_inside = 0
	for(var/mob/living/inside in container)
		mobs_inside++
	if(mobs_inside >= container.mob_storage_capacity)
		return FALSE
	return leash_ok(get_turf(container))

/// A potted plant on the floor, loose, with nobody standing on it
/mob/living/basic/bounty_criminal/proc/ai_plant_usable(obj/item/kirbyplants/plant)
	if(QDELETED(plant) || !isturf(plant.loc) || plant.anchored)
		return FALSE
	var/turf/plant_turf = plant.loc
	if(plant_turf.density)
		return FALSE
	for(var/mob/living/other in plant_turf)
		if(other != src && other.density)
			return FALSE
	return leash_ok(plant_turf)

/// A dark floor tile they can stand on: not space, lava or a chasm, free, on their site
/mob/living/basic/bounty_criminal/proc/ai_dark_usable(turf/tile)
	if(!isopenturf(tile) || isspaceturf(tile) || isgroundlessturf(tile) || islava(tile) || ischasm(tile))
		return FALSE
	if(tile != loc && tile.is_blocked_turf(source_atom = src))
		return FALSE
	return leash_ok(tile) && ai_tile_is_dark(tile)

/// Whether they can hide in or as `spot` from where they stand: on the dark tile, or right beside the closet or plant with nothing between (H1)
/mob/living/basic/bounty_criminal/proc/ai_at_hide_spot(atom/spot)
	if(!isturf(loc))
		return FALSE
	if(isturf(spot))
		return loc == spot
	if(istype(spot, /obj/item/kirbyplants) && loc == spot.loc)
		return TRUE
	return Adjacent(spot)

/// Where they walk to to hide at `spot`: beside a closet on their side of it (the tile picked with it), onto a plant or a dark tile. Null if there is nowhere.
/mob/living/basic/bounty_criminal/proc/ai_hide_approach(atom/spot)
	if(istype(spot, /obj/structure/closet))
		if(ai_hide_stand && (ai_hide_stand == loc || ai_standable(ai_hide_stand)) && ai_hide_stand.Adjacent(spot))
			return ai_hide_stand
		return ai_container_approach(spot)
	return get_turf(spot)

/**
 * The tile to stand on to climb into `container`: beside it, free, with no wall, window or rail
 * between (so Adjacent() holds from it), and in `reachable` when that is given. Nearest to them.
 */
/mob/living/basic/bounty_criminal/proc/ai_container_approach(obj/structure/closet/container, list/reachable)
	var/turf/container_turf = get_turf(container)
	if(!container_turf)
		return null
	var/turf/best
	var/best_distance = INFINITY
	for(var/turf/tile as anything in RANGE_TURFS(1, container_turf))
		if(tile == container_turf || (reachable && !reachable[tile]) || !ai_standable(tile) || !tile.Adjacent(container))
			continue
		var/distance = get_dist(src, tile)
		if(distance < best_distance)
			best = tile
			best_distance = distance
	return best

// ===== HIDING =====

/// Hides now, in or as `spot`, from where they stand
/datum/ai_behavior/bounty_hide
	action_cooldown = 0.5 SECONDS

/datum/ai_behavior/bounty_hide/perform(seconds_per_tick, datum/ai_controller/controller, spot_key)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	var/atom/spot = controller.blackboard[spot_key]
	if(QDELETED(spot) || !criminal.ai_hide_in(spot))
		controller.clear_blackboard_key(spot_key)
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_FAILED
	return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_SUCCEEDED

/**
 * Hides in or as `spot`, from beside it: a closet (in, and shut), a potted plant (theirs now, and
 * so is its look) or a dark turf (still and faded). Returns TRUE if they are hidden.
 */
/mob/living/basic/bounty_criminal/proc/ai_hide_in(atom/spot)
	// Never from the floor: a knockdown is a cuff window (H2)
	if(hidden || !ai_can_act() || QDELETED(spot) || !isturf(loc))
		return FALSE
	ai_suspend_activity()
	ai_stop_aiming()
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	ai_over_head = bounty_ai_update_held(src, ai_over_head, null)
	var/done = FALSE
	if(istype(spot, /obj/structure/closet))
		done = ai_hide_in_container(spot)
	else if(istype(spot, /obj/item/kirbyplants))
		done = ai_hide_as_plant(spot)
	else if(isturf(spot))
		done = ai_hide_in_dark(spot)
	if(!done)
		return FALSE
	hidden = TRUE
	ai_hidden_since = world.time
	ai_next_restless = world.time + BOUNTY_MEEK_RESTLESS_AFTER
	ai_next_quiet_check = world.time + BOUNTY_MEEK_COME_OUT_AFTER
	ai_cornered_since = 0
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	if(!QDELETED(ai_controller))
		ai_controller.clear_blackboard_key(BB_BOUNTY_HIDE_SPOT)
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
		ai_controller.ai_movement?.stop_moving_towards(ai_controller)
	ai_hide_stand = null
	return TRUE

/**
 * In a locker or a crate: opens it if shut, gets in, and shuts it from inside. A crate won't take
 * a standing person the ordinary way, so it is straight insertion for both, then close(). Only
 * from right beside it, with no wall or window between (H1).
 */
/mob/living/basic/bounty_criminal/proc/ai_hide_in_container(obj/structure/closet/container)
	if(!ai_container_usable(container) || !Adjacent(container))
		return FALSE
	ai_stand_up()
	if(!container.opened && !container.open())
		return FALSE
	var/turf/was_at = loc
	container.visible_message(span_notice("[src] climbs into [container] and pulls it shut."))
	forceMove(container)
	if(!container.close())
		forceMove(was_at)
		return FALSE
	if(loc != container)
		return FALSE
	RegisterSignal(container, COMSIG_CLOSET_POST_OPEN, PROC_REF(ai_on_container_opened))
	RegisterSignal(container, COMSIG_QDELETING, PROC_REF(ai_on_container_gone))
	ai_hide_mode = BOUNTY_HIDE_CONTAINER
	ai_hide_ref = WEAKREF(container)
	return TRUE

/**
 * As a potted plant: they step onto its tile (a real step, from right beside it: H1), take it, keep
 * their own look aside, and wear the plant's: name, description, icon, overlays and layer.
 */
/mob/living/basic/bounty_criminal/proc/ai_hide_as_plant(obj/item/kirbyplants/plant)
	if(!ai_plant_usable(plant))
		return FALSE
	var/turf/plant_turf = plant.loc
	if(loc != plant_turf)
		if(!Adjacent(plant))
			return FALSE
		ai_stand_up()
		Move(plant_turf, get_dir(src, plant_turf))
		if(loc != plant_turf)
			return FALSE
	ai_stand_up()
	ai_disguise_saved = list(
		"plant_turf" = plant_turf,
		"name" = name,
		"desc" = desc,
		"icon" = icon,
		"icon_state" = icon_state,
		"overlays" = overlays.Copy(),
		"underlays" = underlays.Copy(),
		"layer" = layer,
		"alpha" = alpha,
	)
	plant.forceMove(src)
	if(plant.loc != src)
		ai_disguise_saved = null
		return FALSE
	name = plant.name
	desc = plant.desc
	icon = plant.icon
	icon_state = plant.icon_state
	overlays = plant.overlays.Copy()
	underlays = null
	layer = plant.layer
	ai_hide_mode = BOUNTY_HIDE_PLANT
	ai_hide_ref = WEAKREF(plant)
	return TRUE

/// In the dark: on the tile, still, faded
/mob/living/basic/bounty_criminal/proc/ai_hide_in_dark(turf/tile)
	if(loc != tile || !ai_dark_usable(tile))
		return FALSE
	ai_stand_up()
	ai_disguise_saved = list("alpha" = alpha)
	alpha = BOUNTY_MEEK_DARK_ALPHA
	setDir(pick(GLOB.cardinals))
	ai_hide_mode = BOUNTY_HIDE_DARK
	ai_hide_ref = WEAKREF(tile)
	return TRUE

/**
 * Stops hiding: out of the closet if it opens, the plant put back where it stood and their own look
 * back, the fade gone. Welded or locked in, they stay in (and hidden, so opening it later finds
 * them) and it returns FALSE.
 */
/mob/living/basic/bounty_criminal/proc/ai_unhide()
	var/atom/spot = ai_hide_ref?.resolve()
	switch(ai_hide_mode)
		if(BOUNTY_HIDE_CONTAINER)
			var/obj/structure/closet/container = spot
			if(istype(container))
				// Off first, so opening it here does not find them a second time
				UnregisterSignal(container, list(COMSIG_CLOSET_POST_OPEN, COMSIG_QDELETING))
				if(loc == container && !container.opened)
					container.open()
				if(loc == container)
					RegisterSignal(container, COMSIG_CLOSET_POST_OPEN, PROC_REF(ai_on_container_opened))
					RegisterSignal(container, COMSIG_QDELETING, PROC_REF(ai_on_container_gone))
					return FALSE
		if(BOUNTY_HIDE_PLANT)
			// Back where it stood (L8): the outpost's decor stays where the outpost put it
			var/turf/plant_turf = ai_disguise_saved?["plant_turf"]
			ai_restore_look()
			var/obj/item/kirbyplants/plant = spot
			if(istype(plant) && plant.loc == src)
				var/atom/put_down = isturf(plant_turf) ? plant_turf : drop_location()
				if(put_down)
					plant.forceMove(put_down)
				else
					qdel(plant)
		if(BOUNTY_HIDE_DARK)
			ai_restore_look()
	hidden = FALSE
	ai_hide_mode = null
	ai_hide_ref = null
	ai_sprint_checked_at = world.time
	return TRUE

/// Their own look back after passing as a plant or standing faded
/mob/living/basic/bounty_criminal/proc/ai_restore_look()
	var/list/saved = ai_disguise_saved
	ai_disguise_saved = null
	if(!saved)
		return
	if("icon" in saved)
		name = saved["name"]
		desc = saved["desc"]
		icon = saved["icon"]
		icon_state = saved["icon_state"]
		overlays = saved["overlays"]
		underlays = saved["underlays"]
		layer = saved["layer"]
	alpha = saved["alpha"]

/mob/living/basic/bounty_criminal/proc/ai_on_container_opened(obj/structure/closet/source, mob/living/user, force)
	SIGNAL_HANDLER
	INVOKE_ASYNC(src, PROC_REF(ai_reveal), isliving(user) ? user : null, "opened")

/mob/living/basic/bounty_criminal/proc/ai_on_container_gone(obj/structure/closet/source)
	SIGNAL_HANDLER
	INVOKE_ASYNC(src, PROC_REF(ai_reveal), null, "opened")

/**
 * Found: out of hiding, a word, the finder shoved back a tile if they are right there (M4), and
 * off again, to a new hiding place. `finder` may be null (a light came, the closet broke). Welded
 * or locked in, they can't get out and stay hidden. Returns TRUE if they came out.
 */
/mob/living/basic/bounty_criminal/proc/ai_reveal(mob/living/finder, reason)
	if(!hidden)
		return FALSE
	var/mode = ai_hide_mode
	var/atom/spot = ai_hide_ref?.resolve()
	if(!ai_unhide())
		return FALSE
	ai_last_hide_ref = spot ? WEAKREF(spot) : null
	if(stat == DEAD || !isturf(loc))
		return TRUE
	switch(mode)
		if(BOUNTY_HIDE_CONTAINER)
			visible_message(span_warning("[src] was hiding in [spot || "there"]!"))
		if(BOUNTY_HIDE_PLANT)
			visible_message(span_warning("[src] puts down the potted plant [p_they()] [p_were()] hiding behind!"))
		if(BOUNTY_HIDE_DARK)
			visible_message(span_warning("[src] was hiding in the dark!"))
	if(isliving(finder))
		ai_add_grudge(finder)
		if(get_dist(src, finder) <= 1 && isturf(finder.loc))
			ai_shove_away(finder)
	if(!QDELETED(ai_controller))
		// Out of the keep-still behaviour at once, so they bolt now rather than next second
		ai_controller.CancelActions()
	if(ai_can_act())
		ai_flee_event(isliving(finder) ? finder : ai_threat(), "found")
	return TRUE

/// Shoves `finder` back a tile, without a stun, to get a head start; never onto lava, into a chasm or out into space (M5)
/mob/living/basic/bounty_criminal/proc/ai_shove_away(mob/living/finder)
	bounty_ai_shove_back(src, finder)
	visible_message(span_warning("[src] shoves [finder] back and bolts!"))
	playsound(finder, 'sound/items/weapons/shove.ogg', 50, TRUE)

/// Pushes `victim` a tile away from `shover`, if the tile behind them is safe to stand on (M5). Returns TRUE if they moved.
/proc/bounty_ai_shove_back(atom/shover, mob/living/victim)
	var/shove_dir = get_dir(shover, victim)
	var/turf/behind = shove_dir && get_step(victim, shove_dir)
	if(!behind || behind.is_blocked_turf(source_atom = victim))
		return FALSE
	if(isspaceturf(behind) || isopenspaceturf(behind) || isgroundlessturf(behind) || islava(behind) || ischasm(behind) || !behind.can_cross_safely(victim))
		return FALSE
	return victim.Move(behind, shove_dir)

/**
 * About once a second while hidden: whether they have been found out (let out of the closet, a
 * light on them), the restless tell, and coming out when it has been quiet for long enough.
 */
/mob/living/basic/bounty_criminal/proc/ai_hidden_tick()
	if(!hidden)
		return
	ai_update_sprint()
	var/atom/spot = ai_hide_ref?.resolve()
	switch(ai_hide_mode)
		if(BOUNTY_HIDE_CONTAINER)
			var/obj/structure/closet/container = spot
			if(!istype(container) || loc != container || container.opened)
				ai_reveal(null, "opened")
				return
		if(BOUNTY_HIDE_DARK)
			if(!ai_tile_is_dark(get_turf(src)))
				ai_reveal(null, "light")
				return
	if(world.time >= ai_next_restless)
		ai_next_restless = world.time + BOUNTY_MEEK_RESTLESS_GAP
		ai_restless_tell()
	if(world.time >= ai_next_quiet_check)
		ai_next_quiet_check = world.time + BOUNTY_MEEK_RESTLESS_GAP
		if(!bounty_ai_hunters_around(src, BOUNTY_MEEK_HIDE_RADIUS + 2))
			ai_come_out()

/**
 * The restless tell (M2): after a while hidden, a noise and a shake of the hiding place every
 * BOUNTY_MEEK_RESTLESS_GAP, heard within BOUNTY_MEEK_RESTLESS_RANGE, and now and then a mutter.
 */
/mob/living/basic/bounty_criminal/proc/ai_restless_tell()
	var/atom/shaken = src
	var/message
	switch(ai_hide_mode)
		if(BOUNTY_HIDE_CONTAINER)
			shaken = ai_hide_ref?.resolve() || src
			message = "Something shifts inside [shaken]."
		if(BOUNTY_HIDE_PLANT)
			message = "[src] rustles."
		else
			message = "Something shuffles in the dark."
	shaken.Shake(1, 0, 0.5 SECONDS)
	playsound(get_turf(src), SFX_RUSTLE, 40, TRUE, BOUNTY_MEEK_RESTLESS_RANGE - SOUND_RANGE)
	shaken.visible_message(span_notice(message), blind_message = span_hear("You hear something shift nearby."), vision_distance = BOUNTY_MEEK_RESTLESS_RANGE)
	if(prob(40))
		ai_bark("hide")

/// Quiet for long enough: they come out and carry on with what they were doing
/mob/living/basic/bounty_criminal/proc/ai_come_out()
	var/mode = ai_hide_mode
	var/atom/spot = ai_hide_ref?.resolve()
	if(!ai_unhide() || !isturf(loc))
		return
	if(mode == BOUNTY_HIDE_CONTAINER && spot)
		visible_message(span_notice("[src] climbs out of [spot]."))
	ai_calm_down()

/// Whether any hunter is within `range` of `center`, seen or not: a spatial grid lookup
/proc/bounty_ai_hunters_around(atom/center, range)
	var/turf/here = get_turf(center)
	if(!here)
		return FALSE
	for(var/mob/living/person in SSspatial_grid.orthogonal_range_search(here, SPATIAL_GRID_CONTENTS_TYPE_CLIENTS, range))
		if(bounty_ai_is_hunter(person) && get_dist(here, person) <= range)
			return TRUE
	return FALSE
