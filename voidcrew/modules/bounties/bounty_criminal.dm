// ===== EXAMINE =====

/**
 * How hurt it looks, its distinguishing features, and whether it is restrained, down or has given up.
 * Blending in, the fugitive and its decoys show one layout: how hurt, then the features. Hidden (a
 * disguise, a locker), it adds nothing.
 */
/mob/living/basic/bounty_criminal/examine(mob/user)
	. = ..()
	if(hidden)
		return
	if(stat != DEAD)
		. += body_health_line()
	for(var/line in record?.feature_lines())
		. += span_notice(line)
	if(blended || stat == DEAD)
		return
	if(is_restrained())
		. += span_warning("[p_They()] [p_are()] restrained with [restraints].")
	if(downed)
		if(body_stirring)
			. += span_warning("[p_They()] [p_are()] trying to get up.")
		else
			. += span_notice("[p_They()] [p_are()] down.")
	else if(HAS_TRAIT(src, TRAIT_BOUNTY_SURRENDERED))
		. += span_notice("[p_They()] [p_have()] given up.")

/// One line on how hurt it looks
/mob/living/basic/bounty_criminal/proc/body_health_line()
	var/fraction = maxHealth > 0 ? health / maxHealth : 0
	if(fraction >= 0.9)
		return span_notice("[p_They()] look[p_s()] unhurt.")
	if(fraction >= 0.6)
		return span_warning("[p_They()] [p_have()] a few cuts and bruises.")
	if(fraction > BOUNTY_DOWNED_BELOW / 100)
		return span_warning("[p_They()] [p_are()] badly hurt.")
	return span_danger("[p_They()] [p_are()] barely conscious.")

// ===== THE LEDGER AND THE BODY'S SIGNALS =====

/**
 * Who has been hurting a criminal, and the rest of the body's signal hooks, kept on a component so the
 * AI packages can register the same signals on the mob without clashing. The ledger (in the style of
 * experiment_damage_ledger) tells a hit with someone's mind behind it from one without, so turrets,
 * traps, fire and fauna can't finish off a criminal on its site (AR-D3), and puts attackers on its
 * grudge list. Damage and the attack report arrive in the same tick: a projectile's pre-hit and an item
 * attack's attackby come before the damage, so the tick's attacker is known when the damage lands.
 * It also refuses teleports, polymorph and type changes, lets a sprinting meek criminal duck shots,
 * holds ranged attacks to may_attack(), and stops a free criminal being dragged onto things.
 */
/datum/component/bounty_body
	dupe_mode = COMPONENT_DUPE_UNIQUE
	/// world.time someone with a mind behind them last attacked it
	var/player_hit_at = -1
	/// world.time another criminal or a companion last attacked it
	var/own_side_hit_at = -1

/datum/component/bounty_body/Initialize()
	if(!istype(parent, /mob/living/basic/bounty_criminal))
		return COMPONENT_INCOMPATIBLE

/datum/component/bounty_body/RegisterWithParent()
	var/mob/living/basic/bounty_criminal/criminal = parent
	criminal.AddElement(/datum/element/relay_attackers)
	RegisterSignal(criminal, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(on_attacked))
	RegisterSignal(criminal, COMSIG_ATOM_ATTACKBY, PROC_REF(on_attackby))
	RegisterSignal(criminal, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_projectile_prehit))
	RegisterSignal(criminal, COMSIG_MOVABLE_TELEPORTING, PROC_REF(refuse_teleport))
	RegisterSignal(criminal, COMSIG_LIVING_PRE_WABBAJACKED, PROC_REF(refuse_polymorph))
	RegisterSignal(criminal, COMSIG_PRE_MOB_CHANGED_TYPE, PROC_REF(refuse_type_change))
	RegisterSignal(criminal, COMSIG_BASICMOB_PRE_ATTACK_RANGED, PROC_REF(on_pre_ranged_attack))
	RegisterSignal(criminal, COMSIG_MOUSEDROP_ONTO, PROC_REF(on_mousedrop))
	RegisterSignals(criminal, list(SIGNAL_ADDTRAIT(TRAIT_BOUNTY_SURRENDERED), SIGNAL_REMOVETRAIT(TRAIT_BOUNTY_SURRENDERED)), PROC_REF(on_state_signal))
	// A stun's traits land before the stun is on its list, so the trait handlers alone would miss it.
	RegisterSignals(criminal, list(COMSIG_LIVING_STATUS_APPLIED, COMSIG_LIVING_STATUS_REMOVED), PROC_REF(on_state_signal))

/datum/component/bounty_body/UnregisterFromParent()
	UnregisterSignal(parent, list(
		COMSIG_ATOM_WAS_ATTACKED,
		COMSIG_ATOM_ATTACKBY,
		COMSIG_PROJECTILE_PREHIT,
		COMSIG_MOVABLE_TELEPORTING,
		COMSIG_LIVING_PRE_WABBAJACKED,
		COMSIG_PRE_MOB_CHANGED_TYPE,
		COMSIG_BASICMOB_PRE_ATTACK_RANGED,
		COMSIG_MOUSEDROP_ONTO,
		SIGNAL_ADDTRAIT(TRAIT_BOUNTY_SURRENDERED),
		SIGNAL_REMOVETRAIT(TRAIT_BOUNTY_SURRENDERED),
		COMSIG_LIVING_STATUS_APPLIED,
		COMSIG_LIVING_STATUS_REMOVED,
	))

/// Whether someone with a mind behind them attacked it this tick
/datum/component/bounty_body/proc/player_hit_now()
	return player_hit_at == world.time

/// Whether its own side (another criminal, a companion) attacked it this tick
/datum/component/bounty_body/proc/own_side_hit_now()
	return own_side_hit_at == world.time

/// `attacker` went for it: noted for the ledger, and they go on its grudge list
/datum/component/bounty_body/proc/note_attacker(atom/attacker)
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(bounty_player_behind(attacker))
		player_hit_at = world.time
	if(istype(attacker, /mob/living/basic/bounty_criminal) || istype(attacker, /mob/living/basic/bounty_companion))
		own_side_hit_at = world.time
	if(istype(attacker, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = attacker
		for(var/mob/living/pilot in vehicle.occupants)
			criminal.body_add_grudge(pilot)
	else if(isliving(attacker))
		criminal.body_add_grudge(attacker)

/**
 * An explosion is about to hit it (M1). ex_act() carries no attacker, so the blast counts as a
 * player's when the explosive was last handled by one (`origin`'s last fingerprints: a grenade
 * someone threw or set), or when someone with a mind stands within BOUNTY_EXPLOSION_WITNESS_RANGE
 * tiles. Anything else is automated, like fire.
 */
/datum/component/bounty_body/proc/note_explosion(atom/origin)
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(isatom(origin) && origin.fingerprintslast)
		player_hit_at = world.time
		return
	var/turf/here = get_turf(criminal)
	if(!here)
		return
	for(var/mob/living/person in range(BOUNTY_EXPLOSION_WITNESS_RANGE, here))
		if(bounty_player_behind(person))
			player_hit_at = world.time
			return

/datum/component/bounty_body/proc/on_attacked(datum/source, atom/attacker, attack_flags)
	SIGNAL_HANDLER
	if(!(attack_flags & (ATTACKER_DAMAGING_ATTACK | ATTACKER_STAMINA_ATTACK | ATTACKER_SHOVING)))
		return
	note_attacker(attacker)

// Before an item's damage lands (relay_attackers only reports it after), so the ledger knows whose it is.
/datum/component/bounty_body/proc/on_attackby(datum/source, obj/item/attacking_item, mob/living/user, list/modifiers, list/attack_modifiers)
	SIGNAL_HANDLER
	if(attacking_item?.force > 0 || user?.combat_mode)
		note_attacker(user)

/// Whose shot it is, even a mech's or a vehicle's (relay_attackers only reports mobs, M1); and a sprinting meek criminal ducks some shots (C5), though one that gets through spoils the next second's dodging
/datum/component/bounty_body/proc/on_projectile_prehit(datum/source, obj/projectile/shot)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(shot?.firer && shot.is_hostile_projectile())
		note_attacker(shot.firer)
	if(prob(criminal.body_dodge_chance()))
		criminal.visible_message(span_warning("[criminal] ducks out of the way of [shot]!"))
		return PROJECTILE_INTERRUPT_HIT_PHASE
	criminal.body_last_shot_at = world.time
	return NONE

/// The pad deletes a criminal; nothing teleports one (D-A10)
/datum/component/bounty_body/proc/refuse_teleport(datum/source, atom/destination, channel)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(isturf(criminal.loc))
		criminal.visible_message(span_notice("[criminal] flickers for a moment, but stays where [criminal.p_they()] [criminal.p_are()]."))
	return TRUE

/datum/component/bounty_body/proc/refuse_polymorph(datum/source, what_to_randomize)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	criminal.visible_message(span_notice("[criminal] shimmers for a moment, then looks the same as before."))
	return STOP_WABBAJACK

/datum/component/bounty_body/proc/refuse_type_change(datum/source)
	SIGNAL_HANDLER
	return COMPONENT_BLOCK_MOB_CHANGE

/datum/component/bounty_body/proc/on_pre_ranged_attack(datum/source, atom/target, modifiers)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(!criminal.may_attack(target))
		return COMPONENT_CANCEL_RANGED_ATTACK

/datum/component/bounty_body/proc/on_mousedrop(datum/source, atom/over, mob/user)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	if(!criminal.body_can_be_dragged())
		return COMPONENT_CANCEL_MOUSEDROP_ONTO

/// It surrendered or stopped, or a stun, knockdown or stamina crit came or went: its capture state may have changed
/datum/component/bounty_body/proc/on_state_signal(datum/source)
	SIGNAL_HANDLER
	var/mob/living/basic/bounty_criminal/criminal = parent
	criminal.body_state_changed()

/// The chance, in percent, that it ducks a shot now: a meek criminal sprinting freely (TRAIT_BOUNTY_SPRINTING, from P3), not shot in the last second
/mob/living/basic/bounty_criminal/proc/body_dodge_chance()
	if(!istype(src, /mob/living/basic/bounty_criminal/meek) || !HAS_TRAIT(src, TRAIT_BOUNTY_SPRINTING))
		return 0
	if(stat != CONSCIOUS || downed || is_restrained() || !isturf(loc) || pulledby || buckled)
		return 0
	if(HAS_TRAIT(src, TRAIT_INCAPACITATED) || HAS_TRAIT(src, TRAIT_IMMOBILIZED) || HAS_TRAIT(src, TRAIT_FLOORED))
		return 0
	if(world.time - body_last_shot_at < BOUNTY_MEEK_DODGE_AFTER_HIT)
		return 0
	return BOUNTY_MEEK_DODGE

/**
 * Whether a turret leaves `creature` alone for being part of a bounty (L2; hostile_creatures.dm).
 * `at_trader_outpost`: it stands in a trader outpost's concourse. There, criminals, decoys and
 * companions are left to the hunters (spec 4). Anywhere else a criminal is left alone only once it is
 * down, stunned, restrained or dead, so a crew's own turrets don't finish off their catch; a free one,
 * and any companion, is judged like any other creature.
 */
/proc/bounty_turret_ignores(mob/living/creature, at_trader_outpost)
	var/mob/living/basic/bounty_criminal/criminal = creature
	if(istype(criminal))
		// At a trader outpost, turrets leave it alone unless an exposed fugitive hurt someone outside its grudge list (AR-C8, P6's outpost_turret_target()).
		if(at_trader_outpost)
			return !criminal.outpost_turret_target()
		return criminal.capture_state() != BOUNTY_STATE_FREE
	return at_trader_outpost && istype(creature, /mob/living/basic/bounty_companion)

/// Whether someone with a mind is behind `attacker`: a person, a borg, or the pilot of a mech or other vehicle. Criminals and their companions never count.
/proc/bounty_player_behind(atom/attacker)
	if(istype(attacker, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = attacker
		for(var/mob/living/pilot in vehicle.occupants)
			if(pilot.mind || pilot.ckey)
				return TRUE
		return FALSE
	var/mob/living/person = attacker
	if(!istype(person) || istype(person, /mob/living/basic/bounty_criminal) || istype(person, /mob/living/basic/bounty_companion))
		return FALSE
	return !isnull(person.mind) || !isnull(person.ckey)
