/**
 * # Bounty hunting: the criminal's body
 *
 * Owner: P2 body. Owns this file, bounty_restraints.dm, voidcrew/_DEFINES/bounty_criminals.dm, the
 * bounty exemption line in voidcrew/_HELPERS/hostile_creatures.dm and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_criminal.dm. Do not edit this file outside P2.
 *
 * A criminal is a real human (/mob/living/carbon/human/npc, voidcrew/modules/human_npcs/), so its body
 * is a player's: tg's soft and hard crit, stamina and stamcrit, stuns, wounds, bleeding, cuffs, grabs,
 * fireman carries, fire, cold, suffocation, death and revival (owner decision D5, no stand-ins). What
 * this file adds on top is the bounty's own rules:
 * - Who it is (record, posting) and its look: its record's face (the human NPC base applies it), in the
 *   outfit its archetype and tier give it (bounty_outfits.dm). Toughness is the armour it wears and
 *   npc_damage_taken by tier (body_toughness()), never health.
 * - capture_state(), read from tg at the moment it is asked: dead; in crit (soft or hard, even
 *   cuffed); restrained (tg's TRAIT_RESTRAINED: handcuffs, cable, zipties, a straitjacket); stunned
 *   (stamcrit, knockdown, stun, paralysis including tg's *surrender, unconscious, asleep); free. The pad
 *   pays on the state at the press (owner ruling 2026-11-08: no worst-state ratchet).
 * - What it says: npc_bark() speaks through bounty_say() and strings/bounty_criminals.json, so the human
 *   NPC base's reactions (crit, getting up, cuffs, working the cuffs, breaking a grab, giving up) use the
 *   criminal lines.
 * - Its site and leash (AR-D2, H1, M3): the site's rectangle, or the pirate ship it is wanted aboard,
 *   less every ship, hangar, player outpost and dock strip inside it. Its AI's movement keeps to it
 *   (/datum/ai_movement/jps/bounty); anyone can drag, carry or shove it anywhere. Off its site, and
 *   anywhere at a trader outpost, it fights only those on its grudge list and never structures.
 * - No teleports (the pad deletes it), and a container it is in can't be teleported either; no fultons,
 *   no polymorph, no type change (M2). Turrets read its tg state (bounty_turret_ignores()).
 * - Its body is the proof (AR-A5): a corpse is turned in for the dead share; a body destroyed with its
 *   posting open (gibbed, dusted, lost in a chasm or lava) leaves an evidence tag through P5's
 *   bounty_drop_proof(), unless it was removed on purpose (TRAIT_BOUNTY_REMOVED, or body_mark_removed()).
 *   A live body deleted never does. It can be revived like anyone; it pays by its condition when it
 *   reaches the pad.
 * Cuffs and the reaction to a reach for its wrists are in bounty_restraints.dm.
 *
 * What differs from a player's body is only the human NPC base's documented list (dormancy off-z, no
 * mood or hunger, locked gear). The shared vars are declared in bounty_types.dm and nowhere else; a var
 * only P2 uses goes here with a `body_` prefix.
 */

// ===== BUILT-IN VALUES =====

/mob/living/carbon/human/npc/bounty_criminal
	name = "criminal"
	faction = list(FACTION_HOSTILE)
	// Criminals stop once their target is down (spec C4, defaults 1.13). Their area effects still hit whoever stands there.
	npc_target_stat = HUMAN_NPC_SPARES_DOWNED
	// The body is the proof: its posting decides when it goes (bounty_posting.dm), never the corpse sweep.
	npc_corpse_lifetime = 0
	npc_outfit_table = /datum/human_npc_outfit_table/bounty
	/// Removed on purpose (beamed out by the pad, cleaned up by its posting, its site unloading): being deleted is not a death, so it leaves no proof
	var/body_removed = FALSE
	/// Its proof of death is down already
	var/body_proof_dropped = FALSE
	/// Weakref to the overmap object of its site: the planet, ruin, pirate ship or trader outpost
	var/datum/weakref/body_site_ref
	/// The top row of its planet's dock strip, or null
	var/body_dock_top_y
	/// Weakref to the container holding it (a locker, a crate, a body bag), kept from being teleported while it is inside
	var/datum/weakref/body_holder_ref
	/// The last balloon floated over it for hunters (body_alert_hunters()): "worn out"
	var/body_last_alert
	/// Its toughness comes from its record's tier (body_toughness()). A subtype with a fixed toughness of its own (a mini-boss, the kingpin) turns this off.
	var/body_tier_toughness = TRUE

/mob/living/carbon/human/npc/bounty_criminal/Initialize(mapload, datum/human_npc_order/order)
	// Who it is must be known before the base dresses it: the outfit table reads the record (bounty_outfits.dm).
	if(istype(order?.look, /datum/bounty_record))
		record = order.look
	. = ..()
	add_traits(list(TRAIT_NO_TELEPORT, TRAIT_NOMOBSWAP), BOUNTY_BODY_TRAIT)
	AddComponent(/datum/component/bounty_body)
	body_hook_cuffs()
	body_toughness()

/mob/living/carbon/human/npc/bounty_criminal/Destroy()
	if(body_leaves_proof())
		body_drop_proof()
	body_set_holder(null)
	grudge?.Cut()
	body_site_ref = null
	return ..()

// ===== SPAWNING =====

/**
 * Spawns the criminal for `record` at `where`, wanted on `posting` (or on nothing, for an admin
 * spawn): a real human of the subtype for its archetype and kit, built now (one body, so it doesn't
 * wait in the human NPC queue), in its record's face and name, dressed for its archetype, tier and
 * site, leashed to the posting's site and protected from the planet sweep. Returns the mob. Decoys are
 * made by P6 directly.
 */
/proc/spawn_bounty_criminal(datum/bounty_record/record, turf/where, datum/criminal_bounty/posting)
	where = get_turf(where)
	if(!where)
		return null
	var/criminal_type = bounty_criminal_type(record, posting)
	var/atom/site = posting?.site_ref?.resolve()
	var/datum/npc_spawn_context/context = new(site || where, null, "ordinary", source_turf = site ? get_turf(site) : where)
	var/datum/human_npc_order/order = spawn_human_npc(criminal_type, where, look = record, name = record?.name, context = context, immediate = TRUE)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = order?.spawned_ref?.resolve()
	qdel(order)
	if(QDELETED(criminal))
		return null
	criminal.body_setup(record, posting)
	return criminal

/// The criminal type for `record` wanted on `posting`: meek, normal, or the mini-boss of its kit. A mini-boss never goes to a trader outpost; a normal criminal stands in (D-A8).
/proc/bounty_criminal_type(datum/bounty_record/record, datum/criminal_bounty/posting)
	var/archetype = record?.archetype
	if(archetype == BOUNTY_ARCHETYPE_BOSS && posting?.placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST)
		archetype = BOUNTY_ARCHETYPE_NORMAL
	switch(archetype)
		if(BOUNTY_ARCHETYPE_MEEK)
			return /mob/living/carbon/human/npc/bounty_criminal/meek
		if(BOUNTY_ARCHETYPE_BOSS)
			switch(record.kit)
				if(BOUNTY_KIT_JUGGERNAUT)
					return /mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut
				if(BOUNTY_KIT_PYROMANIAC)
					return /mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac
				if(BOUNTY_KIT_DEMOLITIONIST)
					return /mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist
				if(BOUNTY_KIT_GHOST)
					return /mob/living/carbon/human/npc/bounty_criminal/boss/ghost
				if(BOUNTY_KIT_HEAVY)
					return /mob/living/carbon/human/npc/bounty_criminal/boss/heavy
			return pick(
				/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut,
				/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac,
				/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist,
				/mob/living/carbon/human/npc/bounty_criminal/boss/ghost,
				/mob/living/carbon/human/npc/bounty_criminal/boss/heavy,
			)
	return /mob/living/carbon/human/npc/bounty_criminal/normal

/**
 * Makes it the person in `new_record`, wanted on `new_posting` (either may be null): name, toughness
 * for its tier, the leash to the posting's site and the planet-sweep protection. spawn_bounty_criminal()
 * calls it once, right after making the mob; its face and clothes are already on (the human NPC base
 * dresses it from the record as it is made).
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_setup(datum/bounty_record/new_record, datum/criminal_bounty/new_posting)
	record = new_record
	posting_ref = new_posting ? WEAKREF(new_posting) : null
	if(record?.name && real_name != record.name)
		fully_replace_character_name(real_name, record.name)
	body_toughness()
	body_set_site(new_posting?.site_ref?.resolve())
	if(new_posting)
		// The planet's fauna sweep leaves it be while it is wanted (missions/objectives/combat.dm). P5 takes it off when the posting ends.
		ADD_TRAIT(src, TRAIT_MISSION_FIELD_MOB, BOUNTY_TRAIT)

/**
 * How much brute and burn it takes, as a multiple of a person's, through its physiology (the human
 * NPC base's npc_damage_taken): by its record's tier, meek criminals at a person's. A subtype with a
 * fixed value of its own sets body_tier_toughness = FALSE. Its armour does the rest.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_toughness()
	if(!body_tier_toughness)
		return
	var/wanted = BOUNTY_TOUGHNESS_PETTY
	switch(record?.tier)
		if(BOUNTY_TIER_WANTED)
			wanted = BOUNTY_TOUGHNESS_WANTED
		if(BOUNTY_TIER_MOST_WANTED)
			wanted = BOUNTY_TOUGHNESS_MOST_WANTED
	if(istype(src, /mob/living/carbon/human/npc/bounty_criminal/meek))
		wanted = BOUNTY_TOUGHNESS_PETTY
	if(wanted != npc_damage_taken)
		set_npc_toughness(wanted)

/**
 * Gives it the same toughness and pace as `other`: a trader-outpost decoy (P6) must be as hard to put
 * down and as quick as the fugitive it stands in for (AR-C6). Its armour comes from its own clothes.
 * The fugitive's chrome is part of its pace (a meek criminal's Slipwire), so the same pieces go into
 * this body too, real chrome that an EMP stops and that burns out when it dies.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_match(mob/living/carbon/human/npc/bounty_criminal/other)
	if(QDELETED(other) || other == src)
		return
	if(npc_damage_taken != other.npc_damage_taken)
		set_npc_toughness(other.npc_damage_taken)
	if(move_intent != other.move_intent)
		toggle_move_intent()
	for(var/obj/item/organ/ware as anything in other.organs)
		if(!ware.GetComponent(/datum/component/cyberware) || (locate(ware.type) in organs))
			continue
		npc_install_cyberware(ware.type)

// ===== THE SITE =====

/**
 * Leashes it to `site`, the overmap object of its planet, ruin, pirate ship or trader outpost: the
 * site's rectangle, or for a pirate ship the hull itself. A site with no rectangle to read gets a box
 * around where it stands. With no site at all (an admin spawn) it has no leash.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_set_site(atom/site)
	body_site_ref = site ? WEAKREF(site) : null
	site_bounds = bounty_site_bounds(site)
	body_dock_top_y = bounty_site_dock_top(site)
	if(!site || site_bounds || istype(site, /obj/structure/overmap/ship))
		return
	var/turf/here = get_turf(src)
	if(here)
		site_bounds = list(here.x - BOUNTY_BODY_FALLBACK_LEASH, here.y - BOUNTY_BODY_FALLBACK_LEASH, here.x + BOUNTY_BODY_FALLBACK_LEASH, here.y + BOUNTY_BODY_FALLBACK_LEASH, here.z)

/// The rectangle of an overmap site's interior, list(min_x, min_y, max_x, max_y, z), or null: a trader outpost's reservation, anything else's footprint. A ship has none (it moves).
/proc/bounty_site_bounds(atom/site)
	if(istype(site, /obj/structure/overmap/trader_outpost))
		var/obj/structure/overmap/trader_outpost/outpost = site
		var/datum/turf_reservation/reservation = outpost.reservation
		if(!length(reservation?.bottom_left_turfs) || !length(reservation.top_right_turfs))
			return null
		var/turf/low = reservation.bottom_left_turfs[1]
		var/turf/high = reservation.top_right_turfs[1]
		if(!low || !high)
			return null
		return list(low.x, low.y, high.x, high.y, low.z)
	if(!istype(site, /obj/structure/overmap) || istype(site, /obj/structure/overmap/ship))
		return null
	var/obj/structure/overmap/overmap_site = site
	var/datum/map_footprint/footprint = overmap_site.get_interior_footprint()
	if(!footprint || isnull(footprint.low_x) || !footprint.z_value)
		return null
	return list(footprint.low_x, footprint.low_y, footprint.high_x, footprint.high_y, footprint.z_value)

/// The top row of a planet's dock strip, where ships land, or null for anything else
/proc/bounty_site_dock_top(atom/site)
	var/obj/structure/overmap/planet/planet = site
	if(!istype(planet))
		return null
	var/datum/space_level/level = length(planet.mapzone?.z_levels) ? planet.mapzone.z_levels[1] : null
	return planet.get_dock_strip_top_y(level)

/// The overmap object of its site: the one it was spawned for, else its posting's
/mob/living/carbon/human/npc/bounty_criminal/proc/body_site()
	var/obj/structure/overmap/site = body_site_ref?.resolve() || posting()?.site_ref?.resolve()
	return (istype(site) && !QDELETED(site)) ? site : null

/// The pirate ship that is its site, if it is wanted aboard one
/mob/living/carbon/human/npc/bounty_criminal/proc/body_site_ship()
	var/obj/structure/overmap/ship/site_ship = body_site()
	return istype(site_ship) ? site_ship : null

/// Whether it has a site to be leashed to
/mob/living/carbon/human/npc/bounty_criminal/proc/body_has_site()
	return !!site_bounds || !!body_site_ship()

/**
 * Whether `place` is on its site: inside the site's rectangle (or aboard the pirate ship it is wanted
 * on), and not part of a ship, a hangar, a player outpost or a planet's dock strip that happens to lie
 * inside that rectangle (H1). With no site, anywhere but those is.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_site(turf/place)
	place = get_turf(place)
	if(!place || body_forbidden_turf(place))
		return FALSE
	if(site_bounds)
		return place.z == site_bounds[5] && place.x >= site_bounds[1] && place.x <= site_bounds[3] && place.y >= site_bounds[2] && place.y <= site_bounds[4]
	var/obj/structure/overmap/ship/site_ship = body_site_ship()
	if(site_ship)
		return site_ship.is_aboard(place)
	return TRUE

/// Whether `place` is never its ground: a ship (other than the pirate ship it is wanted aboard), a hangar, a player outpost, or its planet's dock strip
/mob/living/carbon/human/npc/bounty_criminal/proc/body_forbidden_turf(turf/place)
	return !!body_hold(place) || body_on_dock_strip(place)

/**
 * The ship, hangar or player outpost `place` is part of, or null: the pirate ship it is wanted aboard
 * is its site, not a hold. A ship is known by its docking port, so every room aboard is one hold.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_hold(turf/place)
	var/area/place_area = get_area(place)
	if(istype(place_area, /area/shuttle))
		var/obj/structure/overmap/ship/site_ship = body_site_ship()
		if(site_ship?.is_aboard(place))
			return null
		var/area/shuttle/voidcrew/ship_area = place_area
		return (istype(ship_area) && ship_area.shuttle_port) || place_area
	if(istype(place_area, /area/voidcrew/outpost_hangar) || istype(place_area, /area/voidcrew/player_outpost))
		return place_area
	return null

/// Whether `place` is on its planet's dock strip, where ships land (L1)
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_dock_strip(turf/place)
	if(isnull(body_dock_top_y) || !place)
		return FALSE
	return (!site_bounds || place.z == site_bounds[5]) && place.y <= body_dock_top_y

/// Whether it is at a trader outpost, wanted there or standing in one: there it fights only its grudge list (AR-C8)
/mob/living/carbon/human/npc/bounty_criminal/proc/body_at_trader_outpost()
	return posting()?.placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST || istype(get_area(src), /area/voidcrew/trader_outpost)

/**
 * Whether it may go onto `destination` by itself (AR-D2, AR-E1, L1): on its site (so never a ship, a
 * hangar, a player outpost or a dock strip), never a lift alcove that would carry it off, and never
 * lava, a chasm or open space. P3 checks hiding spots and flight paths with it, and its AI's movement
 * holds its own steps to it (body_move_allowed()).
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/leash_ok(turf/destination)
	destination = get_turf(destination)
	if(!destination || !body_on_site(destination))
		return FALSE
	var/obj/structure/overmap/site = body_site()
	if(site && (destination in site.lobby_alcove_turfs))
		return FALSE
	return destination.can_cross_safely(src)

/// Whether a script is walking it on purpose (TRAIT_BOUNTY_SCRIPTED_MOVE), or it is walking out (the human NPC base's npc_walk_out())
/mob/living/carbon/human/npc/bounty_criminal/proc/body_scripted()
	return HAS_TRAIT(src, TRAIT_BOUNTY_SCRIPTED_MOVE) || !isnull(npc_exit)

/**
 * Whether a step of its own onto `newloc` is allowed: the leash its AI's movement keeps to
 * (/datum/ai_movement/jps/bounty, and any step the AI takes by hand). Onto its leash, always. Off it
 * from on it, never. Already off it (woken aboard a ship, dragged off its site, carried somewhere), it
 * may walk about and back toward its site, but never into a hazard and never on into a ship, hangar or
 * player outpost other than the one it is already in (M3). Its body is never held back: anyone can drag,
 * carry, throw or shove it anywhere.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_move_allowed(atom/newloc)
	if(!isturf(newloc) || !isturf(loc) || pulledby || buckled || throwing || stat == DEAD || body_scripted())
		return TRUE
	var/turf/destination = newloc
	if(leash_ok(destination))
		return TRUE
	if(leash_ok(loc) || !destination.can_cross_safely(src))
		return FALSE
	var/destination_hold = body_hold(destination)
	return !destination_hold || destination_hold == body_hold(loc)

/**
 * Whether environment damage aimed at `target_turf` is allowed (AR-D2), for P4's abilities that
 * break walls, windows and floors: only on its own site, never at a trader outpost, and never within
 * BOUNTY_ENV_SAFE_RANGE tiles of a ship (other than the pirate ship it is aboard), a hangar, a player
 * outpost or a planet's dock strip.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/environment_damage_allowed(turf/target_turf)
	target_turf = get_turf(target_turf)
	if(!target_turf || !body_on_site(target_turf) || body_at_trader_outpost())
		return FALSE
	if(!isnull(body_dock_top_y) && (!site_bounds || target_turf.z == site_bounds[5]) && target_turf.y <= body_dock_top_y + BOUNTY_ENV_SAFE_RANGE)
		return FALSE
	var/list/checked_areas = list()
	for(var/turf/nearby as anything in RANGE_TURFS(BOUNTY_ENV_SAFE_RANGE, target_turf))
		var/area/nearby_area = nearby.loc
		if(checked_areas[nearby_area])
			continue
		checked_areas[nearby_area] = TRUE
		if(body_hold(nearby))
			return FALSE
	return TRUE

// ===== WHO IT FIGHTS =====

/**
 * Whether it may attack `target` (AR-D1, AR-C8, C4). Never while it can't fight (dead, in crit,
 * restrained, lying there with its hands on its head after giving up), and never someone who is down,
 * or its own side. Off its site, and anywhere at a trader outpost, only those on its grudge list, and no
 * structures. On its site it may break structures that are on its site and not part of a ship, a hangar
 * or an outpost. Its AI's targeting is held to it.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/may_attack(atom/target)
	if(QDELETED(target) || target == src)
		return FALSE
	if(stat != CONSCIOUS || is_downed() || is_restrained() || npc_surrendering)
		return FALSE
	return may_attack_scope(target)

/**
 * P3 REVIEW ROUND (H3): may_attack() split in two. This half is only who and what is fair game on
 * its side, whatever state it is in itself: never someone who is down, never its own side, only its
 * grudge list off its site and at a trader outpost, structures only on its own ground. Its
 * companions go by this alone, so they fight on when it is down, cuffed, dead or has given up.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/may_attack_scope(atom/target)
	if(QDELETED(target) || target == src)
		return FALSE
	// A ship, hangar, outpost or dock strip inside the site's rectangle is not its site (H1)
	var/limited = !body_on_site(get_turf(src)) || body_at_trader_outpost()
	var/list/people
	if(isliving(target))
		people = list(target)
	else if(istype(target, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = target
		people = list()
		for(var/mob/living/pilot in vehicle.occupants)
			people += pilot
	else
		// A structure, a machine, a wall: only on its own ground, and never part of a ship, a hangar or an outpost.
		if(limited)
			return FALSE
		var/turf/target_turf = get_turf(target)
		return body_on_site(target_turf) && !body_forbidden_turf(target_turf)
	for(var/mob/living/person as anything in people)
		if(person.stat != CONSCIOUS || bounty_is_gang_body(person))
			continue
		if(!limited || body_has_grudge(person))
			return TRUE
	return FALSE

/// Whether `thing` is a bounty criminal or a companion: never on anyone's grudge list, never counted as a player
/proc/bounty_is_gang_body(atom/thing)
	return istype(thing, /mob/living/carbon/human/npc/bounty_criminal) || istype(thing, /mob/living/carbon/human/npc/bounty_companion)

/// Remembers `who` as someone it may fight anywhere: they attacked it, confronted it or cuffed it. P3 calls it when someone confronts it.
/mob/living/carbon/human/npc/bounty_criminal/proc/body_add_grudge(mob/living/who)
	if(!isliving(who) || who == src || bounty_is_gang_body(who))
		return
	var/datum/weakref/who_ref = WEAKREF(who)
	if(who_ref in grudge)
		return
	grudge += who_ref
	if(length(grudge) > BOUNTY_GRUDGE_MAX)
		grudge.Cut(1, 2)

/// Whether `who` is on its grudge list
/mob/living/carbon/human/npc/bounty_criminal/proc/body_has_grudge(mob/living/who)
	return !isnull(who?.weak_reference) && (who.weak_reference in grudge)

// Bounty NPCs never land a gun execution this phase: a boss's deliberate, telegraphed execution (OC-9)
// isn't built yet, and an accidental point-blank head shot must not stand in for it. Aimed crits still
// follow npc_rank (D4).
/mob/living/carbon/human/npc/bounty_criminal/hv_can_execute()
	return !!client

// ===== CAPTURE STATE =====

/**
 * What the pad pays on (BOUNTY_STATE_*), read from tg in this order (AR-A3): dead; in crit, soft or hard,
 * even if cuffed; restrained; stunned; free. The pad reads it once, at the press.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/capture_state()
	if(stat == DEAD)
		return BOUNTY_STATE_DEAD
	if(is_downed())
		return BOUNTY_STATE_DOWNED
	if(is_restrained())
		return BOUNTY_STATE_RESTRAINED
	if(body_is_stunned())
		return BOUNTY_STATE_STUNNED
	return BOUNTY_STATE_FREE

/// Whether it is alive and in crit (tg's TRAIT_CRITICAL_CONDITION: soft or hard crit)
/mob/living/carbon/human/npc/bounty_criminal/proc/is_downed()
	return stat != DEAD && HAS_TRAIT(src, TRAIT_CRITICAL_CONDITION)

/// Whether it is restrained: tg's handcuffs, cable or zipties, or a straitjacket
/mob/living/carbon/human/npc/bounty_criminal/proc/is_restrained()
	return HAS_TRAIT(src, TRAIT_RESTRAINED)

/**
 * Whether it is stunned: stamina crit, knocked down, stunned, paralysed (tg's *surrender is a 20 second
 * paralysis), unconscious or asleep (a sedative dart counts).
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_is_stunned()
	if(stat == UNCONSCIOUS || has_status_effect(/datum/status_effect/incapacitating/stamcrit))
		return TRUE
	return IsKnockdown() || IsStun() || IsParalyzed() || IsUnconscious() || IsSleeping()

/// How bad a capture state is: lower is worse. Restrained and stunned pay the same.
/proc/bounty_state_rank(state)
	switch(state)
		if(BOUNTY_STATE_DEAD)
			return 1
		if(BOUNTY_STATE_DOWNED)
			return 2
		if(BOUNTY_STATE_RESTRAINED, BOUNTY_STATE_STUNNED)
			return 3
	return 4

/**
 * Something about its state may have changed (stat, crit, cuffs, a stun): the first catch or death
 * binds the zone the bounty's reputation counts in. Nothing else is remembered; the pad reads the
 * body when it is pressed.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_state_changed()
	if(capture_state() != BOUNTY_STATE_FREE)
		posting()?.board_note_work_zone(src)

// ===== WHAT IT SAYS =====

// The human NPC base's reactions (human_npc_barks.dm) speak the criminal's own lines (strings/bounty_criminals.json).
/mob/living/carbon/human/npc/bounty_criminal/npc_bark(kind, force = FALSE)
	if(QDELETED(src) || !istext(kind))
		return FALSE
	// Crawling in soft crit it pleads with its downed lines.
	if(kind == HUMAN_NPC_BARK_PLEAD)
		kind = HUMAN_NPC_BARK_DOWNED
	// The capture's moments are always heard, past the line cooldown (BUG-1): the cuffs go on moments after a fall.
	if(kind == HUMAN_NPC_BARK_CUFFED)
		force = TRUE
	npc_last_bark = kind
	INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), kind, null, force)
	return TRUE

/mob/living/carbon/human/npc/bounty_criminal/npc_on_downed()
	visible_message(span_danger("[src] collapses."))
	. = ..()
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_DOWNED)

/mob/living/carbon/human/npc/bounty_criminal/npc_on_recovered()
	if(stat == CONSCIOUS && !is_restrained())
		visible_message(span_warning("[src] gets back up."))
	. = ..()
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_RECOVERED)

/**
 * Floats `text` over it for every hunter who can see it (bounty_ai_is_hunter()), and nobody else.
 * Kept in body_last_alert. Returns how many hunters saw it.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_alert_hunters(text)
	. = 0
	body_last_alert = text
	for(var/mob/living/viewer in get_hearers_in_view(DEFAULT_MESSAGE_RANGE, src, RECURSIVE_CONTENTS_CLIENT_MOBS))
		if(viewer.is_blind() || !bounty_ai_is_hunter(viewer))
			continue
		balloon_alert(viewer, text)
		.++

// ===== DEATH AND PROOF =====

// The body stays as proof. Fallen into a chasm, it is in the chasm's depths for good: P5 puts the proof on
// safe ground beside the chasm (get_turf() here is the chasm itself).
/mob/living/carbon/human/npc/bounty_criminal/death(gibbed)
	. = ..()
	if(QDELETED(src) || stat != DEAD)
		return
	body_state_changed()
	if(istype(loc, /obj/effect/abstract/chasm_storage) && body_leaves_proof())
		body_drop_proof()

/mob/living/carbon/human/npc/bounty_criminal/Moved(atom/old_loc, movement_dir, forced, list/old_locs, momentum_change = TRUE)
	. = ..()
	body_set_holder(isturf(loc) ? null : loc)
	// A body dragged into a chasm is gone for good too; P5 puts the proof beside it.
	if(stat == DEAD && istype(loc, /obj/effect/abstract/chasm_storage) && body_leaves_proof())
		body_drop_proof()

/**
 * Keeps whatever holds it (`holder`, the outermost thing it is inside, or null on a turf) from being
 * teleported while it is inside (M2): a ship's transporter can't beam up a locker, crate or body bag
 * with a criminal in it, any more than the criminal itself, and a person carrying a folded body bag
 * with one inside can't teleport with it. Moves the block when it changes hands. (Carried over the
 * shoulders it isn't inside anyone: it stands on the carrier's tile.)
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_set_holder(atom/movable/holder)
	while(ismovable(holder?.loc))
		holder = holder.loc
	var/atom/movable/old_holder = body_holder_ref?.resolve()
	if(old_holder == holder)
		return
	if(old_holder)
		REMOVE_TRAIT(old_holder, TRAIT_NO_TELEPORT, REF(src))
	body_holder_ref = null
	if(!ismovable(holder) || QDELETED(holder))
		return
	ADD_TRAIT(holder, TRAIT_NO_TELEPORT, REF(src))
	body_holder_ref = WEAKREF(holder)

/**
 * Marks it as removed on purpose, before it is deleted: its deletion is then not a death and leaves
 * no proof. P5 marks removals with TRAIT_BOUNTY_REMOVED instead (the pad, closing, relisting, a site
 * unloading); this is for anything else that takes a criminal away on purpose.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_mark_removed()
	body_removed = TRUE

/**
 * Whether destroying its body now should ask for proof of death: dead (gibs, dust and chasms all kill
 * first; a live one deleted is never a death, M5), not removed on purpose, and its posting still open.
 * P5's bounty_drop_proof() makes the final call (a site unloading, a relist) and places the proof.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_leaves_proof()
	if(stat != DEAD || body_removed || body_proof_dropped || HAS_TRAIT(src, TRAIT_BOUNTY_REMOVED))
		return FALSE
	var/datum/criminal_bounty/wanted_on = posting()
	return wanted_on?.status == BOUNTY_POSTING_OPEN

/// Leaves proof of death through P5's bounty_drop_proof(), once
/mob/living/carbon/human/npc/bounty_criminal/proc/body_drop_proof()
	body_proof_dropped = TRUE
	bounty_drop_proof(src)

// ===== EXAMINE =====

/**
 * Its distinguishing features, and whether it has given up. How hurt it is, whether it is restrained
 * and whether it is down are tg's own human examine. Hidden (a disguise, a locker), it adds nothing.
 */
/mob/living/carbon/human/npc/bounty_criminal/examine(mob/user)
	. = ..()
	if(hidden)
		return
	for(var/line in record?.feature_lines())
		. += span_notice(line)
	if(blended || stat != CONSCIOUS)
		return
	if(npc_surrendering && IsParalyzed())
		. += span_notice("[p_They()] [p_have()] given up.")

// ===== THE BODY'S SIGNALS =====

/**
 * The body's own signal hooks, kept on a component so the AI packages can register the same signals on
 * the mob without clashing:
 * - who has been attacking it (tg's relay_attackers, an item's attackby, a projectile's firer, a mech's
 *   or a vehicle's pilot) goes on its grudge list;
 * - teleports, polymorph and type changes are refused;
 * - any change of tg state that capture_state() reads tells the body (body_state_changed()).
 */
/datum/component/bounty_body
	dupe_mode = COMPONENT_DUPE_UNIQUE

/datum/component/bounty_body/Initialize()
	if(!istype(parent, /mob/living/carbon/human/npc/bounty_criminal))
		return COMPONENT_INCOMPATIBLE

/datum/component/bounty_body/RegisterWithParent()
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = parent
	criminal.AddElement(/datum/element/relay_attackers)
	RegisterSignal(criminal, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(on_attacked))
	RegisterSignal(criminal, COMSIG_ATOM_ATTACKBY, PROC_REF(on_attackby))
	RegisterSignal(criminal, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_projectile_prehit))
	RegisterSignal(criminal, COMSIG_MOVABLE_TELEPORTING, PROC_REF(refuse_teleport))
	RegisterSignal(criminal, COMSIG_LIVING_PRE_WABBAJACKED, PROC_REF(refuse_polymorph))
	RegisterSignal(criminal, COMSIG_PRE_MOB_CHANGED_TYPE, PROC_REF(refuse_type_change))
	RegisterSignal(criminal, COMSIG_MOB_STATCHANGE, PROC_REF(on_state_signal))
	RegisterSignals(criminal, list(
		SIGNAL_ADDTRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_REMOVETRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_ADDTRAIT(TRAIT_FLOORED),
		SIGNAL_REMOVETRAIT(TRAIT_FLOORED),
		SIGNAL_ADDTRAIT(TRAIT_INCAPACITATED),
		SIGNAL_REMOVETRAIT(TRAIT_INCAPACITATED),
	), PROC_REF(on_state_signal))
	// A stun's traits land before the stun is on its list, so the trait handlers alone would miss it.
	RegisterSignals(criminal, list(COMSIG_LIVING_STATUS_APPLIED, COMSIG_LIVING_STATUS_REMOVED), PROC_REF(on_state_signal))

/datum/component/bounty_body/UnregisterFromParent()
	UnregisterSignal(parent, list(
		COMSIG_ATOM_WAS_ATTACKED,
		COMSIG_ATOM_ATTACKBY,
		COMSIG_PROJECTILE_PREHIT,
		COMSIG_MOVABLE_TELEPORTING,
		COMSIG_LIVING_PRE_WABBAJACKED,
		COMSIG_PRE_MOB_CHANGED_TYPE,
		COMSIG_MOB_STATCHANGE,
		SIGNAL_ADDTRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_REMOVETRAIT(TRAIT_CRITICAL_CONDITION),
		SIGNAL_ADDTRAIT(TRAIT_FLOORED),
		SIGNAL_REMOVETRAIT(TRAIT_FLOORED),
		SIGNAL_ADDTRAIT(TRAIT_INCAPACITATED),
		SIGNAL_REMOVETRAIT(TRAIT_INCAPACITATED),
		COMSIG_LIVING_STATUS_APPLIED,
		COMSIG_LIVING_STATUS_REMOVED,
	))

/// `attacker` went for it: they go on its grudge list (a vehicle's pilots for a vehicle)
/datum/component/bounty_body/proc/note_attacker(atom/attacker)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = parent
	if(istype(attacker, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = attacker
		for(var/mob/living/pilot in vehicle.occupants)
			criminal.body_add_grudge(pilot)
	else if(isliving(attacker))
		criminal.body_add_grudge(attacker)

/datum/component/bounty_body/proc/on_attacked(datum/source, atom/attacker, attack_flags)
	SIGNAL_HANDLER
	if(!(attack_flags & (ATTACKER_DAMAGING_ATTACK | ATTACKER_STAMINA_ATTACK | ATTACKER_SHOVING)))
		return
	note_attacker(attacker)

/datum/component/bounty_body/proc/on_attackby(datum/source, obj/item/attacking_item, mob/living/user, list/modifiers, list/attack_modifiers)
	SIGNAL_HANDLER
	if(attacking_item?.force > 0 || user?.combat_mode)
		note_attacker(user)

/// Whose shot it is, even a mech's or a vehicle's (relay_attackers only reports mobs, M1)
/datum/component/bounty_body/proc/on_projectile_prehit(datum/source, obj/projectile/shot)
	SIGNAL_HANDLER
	if(shot?.firer && shot.is_hostile_projectile())
		note_attacker(shot.firer)
	return NONE

/// The pad deletes a criminal; nothing teleports one (D-A10)
/datum/component/bounty_body/proc/refuse_teleport(datum/source, atom/destination, channel)
	SIGNAL_HANDLER
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = parent
	if(isturf(criminal.loc))
		criminal.visible_message(span_notice("[criminal] flickers for a moment, but stays where [criminal.p_they()] [criminal.p_are()]."))
	return TRUE

/datum/component/bounty_body/proc/refuse_polymorph(datum/source, what_to_randomize)
	SIGNAL_HANDLER
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = parent
	criminal.visible_message(span_notice("[criminal] shimmers for a moment, then looks the same as before."))
	return STOP_WABBAJACK

/datum/component/bounty_body/proc/refuse_type_change(datum/source)
	SIGNAL_HANDLER
	return COMPONENT_BLOCK_MOB_CHANGE

/// Its stat, crit, a stun, a knockdown or stamina crit came or went: its capture state may have changed
/datum/component/bounty_body/proc/on_state_signal(datum/source)
	SIGNAL_HANDLER
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = parent
	if(!QDELING(criminal))
		criminal.body_state_changed()

// ===== TURRETS AND PLAYERS =====

/**
 * Whether a turret leaves `creature` alone for being part of a bounty (L2, AM-11; hostile_creatures.dm).
 * `at_trader_outpost`: it stands in a trader outpost's concourse. There, criminals, decoys and
 * companions are left to the hunters (spec 4), unless an exposed fugitive hurt a bystander (P6's
 * outpost_turret_target()). Anywhere else a criminal is left alone once it is in crit, stunned,
 * restrained or dead (tg's states), so a crew's own turrets don't finish off their catch; a free one, and
 * any companion, is judged like any other creature.
 */
/proc/bounty_turret_ignores(mob/living/creature, at_trader_outpost)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = creature
	if(istype(criminal))
		if(at_trader_outpost)
			return !criminal.outpost_turret_target()
		return criminal.capture_state() != BOUNTY_STATE_FREE
	return at_trader_outpost && istype(creature, /mob/living/carbon/human/npc/bounty_companion)

/// Whether someone with a mind is behind `attacker`: a person, a borg, or the pilot of a mech or other vehicle. Criminals and their companions never count.
/proc/bounty_player_behind(atom/attacker)
	if(istype(attacker, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = attacker
		for(var/mob/living/pilot in vehicle.occupants)
			if(pilot.mind || pilot.ckey)
				return TRUE
		return FALSE
	var/mob/living/person = attacker
	if(!istype(person) || bounty_is_gang_body(person))
		return FALSE
	return !isnull(person.mind) || !isnull(person.ckey)
