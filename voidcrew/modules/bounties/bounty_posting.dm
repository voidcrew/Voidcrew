/**
 * # Bounty hunting: a posting
 *
 * Owner: P5 board. Do not edit this file outside P5.
 *
 * What it owns: /datum/criminal_bounty's life: hunting and abandoning, claimants, its clock,
 * closing (with notices to every hunter and cleanup of the criminal, its companions and its
 * decoys), relisting a bounty at a new site, the warrant it prints, and the card the mission board
 * shows for it (spec sections 1 and 6, 12.1 and 12.2).
 *
 * A posting is one global datum per bounty (AR-A7), public or offered privately to one ship. Mobs
 * and ships are held by weakref. The posting's shared vars are declared in bounty_types.dm; the
 * ones only P5 uses are below with a `board_` prefix. Where criminals are placed is in
 * bounty_placement.dm, and the pad in bounty_turn_in.dm.
 */

/datum/criminal_bounty
	/// Zone band (ZONE_*) its value was fixed for when it was posted (AR-A9). A relist keeps it.
	var/board_zone = ZONE_GREEN
	/// Trade vouchers it pays on a full-share turn-in
	var/board_vouchers = 0
	/// world.time it was posted
	var/board_posted_at = 0
	/// A private offer its ship has taken: hunted, and on a contract's clock
	var/board_accepted = FALSE
	/// Weakref of a hunting ship (as in `claimants`) -> world.time its hunt began. Each hunt holds a public bounty's clock for BOUNTY_HUNT_PAUSE_LIMIT.
	var/list/board_hunt_started = list()
	/// Weakrefs to ships that abandoned it; they may not hunt it again (D-A11)
	var/list/board_abandoned_by = list()
	/// Its criminal was lost and it waits to list at a new site (AR-A6), or it slipped away (P6)
	var/board_relisting = FALSE
	/// world.time it lists again
	var/board_relist_at = 0
	/// Weakref to the site it last left, which the relist does not pick again
	var/datum/weakref/board_left_site
	/// The site's name when it was placed, kept for the card after the site is gone
	var/board_site_name
	/// Weakref to the site whose signals it listens to
	var/datum/weakref/board_hooked_site
	/// Board ticks its loaded site has failed to give a spawn turf
	var/board_spawn_failures = 0
	/// A spawn is under way (dressing the criminal's look can sleep)
	var/board_spawning = FALSE
	/// Weakref to the proof of death (/obj/item/bounty_proof) left when the body was destroyed
	var/datum/weakref/board_proof_ref
	/// Weakrefs to GPS units (/datum/component/gps/item) its sighting beacon was uploaded to -> weakref of the ship that linked them
	var/list/board_gps_units = list()
	/// The worst capture state (BOUNTY_STATE_*) any body of its criminal reached. A criminal that comes back when its site loads again starts from here: once downed, never full pay; once dead, only proof (12.1).
	var/board_worst_state = BOUNTY_STATE_FREE
	/// The sighting beacon's tag on those units
	var/board_gps_tag
	/// world.time the sighting marker moves next
	var/board_next_sighting = 0
	/// "[REF(ship)]" -> warrants that ship printed for it (AR-G2)
	var/list/board_warrants = list()
	/// Timer deciding, a moment after its criminal was deleted, whether anything is left to turn in
	var/board_lost_timer

/datum/criminal_bounty/Destroy()
	// close() is the way out; this catches an admin qdel that skipped it
	if(status != BOUNTY_POSTING_CLOSED)
		close(BOUNTY_CLOSE_ADMIN)
	GLOB.criminal_bounties -= src
	if(board_lost_timer)
		deltimer(board_lost_timer)
		board_lost_timer = null
	board_unhook_site()
	board_drop_marker()
	claimants.Cut()
	board_hunt_started.Cut()
	board_abandoned_by.Cut()
	board_gps_units.Cut()
	companions.Cut()
	decoys.Cut()
	board_warrants.Cut()
	criminal_ref = null
	board_proof_ref = null
	last_seen = null
	// Not ours to delete: a live catch goes on to the prisoner pool
	record = null
	return ..()

// ===== WHO SEES IT =====

/// Whether it is still on the board
/datum/criminal_bounty/proc/is_open()
	return status == BOUNTY_POSTING_OPEN && !QDELETED(src)

/// The ship a private offer is for, if it still exists
/datum/criminal_bounty/proc/offered_to()
	var/obj/structure/overmap/ship/ship = private_to?.resolve()
	return QDELETED(ship) ? null : ship

/// Whether `ship`'s mission board lists it: every public bounty, and only its own private offers
/datum/criminal_bounty/proc/board_visible_to(obj/structure/overmap/ship/ship)
	if(!ship)
		return FALSE
	if(!private_to)
		return TRUE
	return offered_to() == ship

/// Where the criminal is: the planet, ruin, pirate ship or trader outpost, if it still exists
/datum/criminal_bounty/proc/site()
	var/obj/structure/overmap/where = site_ref?.resolve()
	return QDELETED(where) ? null : where

/// The proof of death, if its body was destroyed and the proof still exists
/datum/criminal_bounty/proc/board_proof()
	var/obj/item/bounty_proof/proof = board_proof_ref?.resolve()
	return QDELETED(proof) ? null : proof

// ===== HUNTING =====

/// Whether `ship` is hunting it (for a private offer: has taken it)
/datum/criminal_bounty/proc/is_hunting(obj/structure/overmap/ship/ship)
	if(!ship)
		return FALSE
	for(var/datum/weakref/ref as anything in claimants)
		if(ref?.resolve() == ship)
			return TRUE
	return FALSE

/// Whether `ship` abandoned it, and so may not hunt it again
/datum/criminal_bounty/proc/has_abandoned(obj/structure/overmap/ship/ship)
	if(!ship)
		return FALSE
	for(var/datum/weakref/ref as anything in board_abandoned_by)
		if(ref?.resolve() == ship)
			return TRUE
	return FALSE

/// The ships hunting it that still exist
/datum/criminal_bounty/proc/hunter_ships()
	var/list/hunters = list()
	for(var/datum/weakref/ref as anything in claimants.Copy())
		var/obj/structure/overmap/ship/ship = ref?.resolve()
		if(QDELETED(ship))
			claimants -= ref
			board_hunt_started -= ref
			continue
		hunters += ship
	return hunters

/// Why `ship` can't hunt it now, or null if it can. `forced` (an admin giving it to the crew) skips the one-hunt limit and an earlier abandon.
/datum/criminal_bounty/proc/hunt_refusal(obj/structure/overmap/ship/ship, forced = FALSE)
	if(!is_open())
		return "that bounty is closed"
	if(QDELETED(ship))
		return "no ship"
	if(private_to)
		if(offered_to() != ship)
			return "that offer is for another crew"
		if(board_accepted)
			return "already taken"
		return null
	if(is_hunting(ship))
		return "already hunting it"
	if(forced)
		return null
	if(has_abandoned(ship))
		return "you abandoned this one"
	if(SScriminal_bounties.board_public_hunts(ship) >= BOUNTY_MAX_HUNTS_PER_SHIP)
		return "already hunting a bounty"
	return null

/**
 * `ship` starts hunting it: the helm waypoint to its site (tracking a pirate ship), notices about
 * it, and its sighting for the crew's GPS units. A private offer is taken this way and starts its
 * contract clock; it waits to place its criminal until then. No mission slot is used. `forced` (the
 * admin panel) skips the one-hunt limit and lets a ship that abandoned it hunt it again. Returns TRUE,
 * or why not.
 */
/datum/criminal_bounty/proc/hunt(obj/structure/overmap/ship/ship, forced = FALSE)
	var/refusal = hunt_refusal(ship, forced)
	if(refusal)
		return refusal
	var/datum/weakref/ship_ref = WEAKREF(ship)
	board_abandoned_by -= ship_ref
	claimants |= ship_ref
	board_hunt_started[ship_ref] = world.time
	if(private_to)
		board_accepted = TRUE
		expires_at = world.time + BOUNTY_PRIVATE_DURATION
		// Its mugshot is normally built already, from being listed. If not, the boards resend their static
		// data once it's ready (board_on_mugshot_ready()), not first with an empty picture and again with it.
		if(record && !record.mugshot)
			bounty_queue_mugshot(record)
	board_push_waypoint(ship)
	ship.ship_notify("WANTED: now hunting [record?.name]. [board_place_text()].", "MISSION CONTROL", SHIP_NOTIFY_NOTICE, 'voidcrew/sound/notify.ogg', 50)
	log_game("BOUNTY: [ship.name] is hunting the [board_log_name()]")
	board_arm()
	return TRUE

/**
 * `ship` stops hunting it and may not hunt it again. A private offer dropped this way closes, and
 * the ship's next offer waits BOUNTY_PRIVATE_GAP. Returns TRUE, or why not.
 */
/datum/criminal_bounty/proc/abandon(obj/structure/overmap/ship/ship)
	if(!is_open())
		return "that bounty is closed"
	if(!is_hunting(ship))
		return "not hunting it"
	var/datum/weakref/ship_ref = WEAKREF(ship)
	claimants -= ship_ref
	board_hunt_started -= ship_ref
	board_abandoned_by |= ship_ref
	ship.remove_waypoint(board_waypoint_key())
	board_unlink_gps(ship)
	log_game("BOUNTY: [ship.name] abandoned the [board_log_name()]")
	if(private_to)
		close(BOUNTY_CLOSE_ABANDONED)
	else
		ship.ship_notify("WANTED: stopped hunting [record?.name].", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
	return TRUE

// ===== THE CLOCK =====

/// Whether a hunt holds a public bounty's clock at `now`: some ship began hunting it less than BOUNTY_HUNT_PAUSE_LIMIT ago
/datum/criminal_bounty/proc/board_clock_held(now = world.time)
	if(private_to)
		return FALSE
	for(var/datum/weakref/ref as anything in claimants)
		if(!ref?.resolve())
			continue
		var/started = board_hunt_started[ref]
		if(!isnull(started) && now - started < BOUNTY_HUNT_PAUSE_LIMIT)
			return TRUE
	return FALSE

/**
 * The board's tick for this posting, `elapsed` deciseconds after the last: the clock (held while
 * hunted), expiry, a relist that is due, placing a criminal whose site is loaded, and the sighting.
 */
/datum/criminal_bounty/proc/board_process(elapsed)
	if(!is_open())
		return
	if(private_to && !offered_to())
		close(BOUNTY_CLOSE_EXPIRED)
		return
	if(elapsed > 0 && board_clock_held())
		expires_at += elapsed
	if(world.time >= expires_at)
		close(BOUNTY_CLOSE_EXPIRED)
		return
	if(board_relisting)
		if(world.time >= board_relist_at)
			board_finish_relist()
		return
	// A criminal nobody can reach any more (a chasm's depths, nullspace) must not hold the bounty
	if(board_check_unreachable())
		return
	board_arm()
	board_move_sighting()

/// Seconds left on its clock
/datum/criminal_bounty/proc/board_time_left()
	return max(0, round((expires_at - world.time) / (1 SECONDS)))

// ===== CLOSING =====

/**
 * Closes the posting for `reason` (BOUNTY_CLOSE_*), won by `winner` when a ship turned it in:
 * tells every hunter, frees every hunt, sends COMSIG_BOUNTY_POSTING_CLOSED (while its criminal and
 * decoys are still there, so P6 can walk them out of a trader outpost), then removes whatever of
 * the criminal, its companions, its decoys and its sighting marker is left (their field protection
 * goes with them) and deletes the posting. Safe to call twice: the second call does nothing and
 * returns FALSE.
 */
/datum/criminal_bounty/proc/close(reason, obj/structure/overmap/ship/winner)
	if(status == BOUNTY_POSTING_CLOSED)
		return FALSE
	status = BOUNTY_POSTING_CLOSED
	board_relisting = FALSE
	if(board_lost_timer)
		deltimer(board_lost_timer)
		board_lost_timer = null

	// Told while the hunters are still listed
	board_notify_closed(reason, winner)
	for(var/obj/structure/overmap/ship/hunter as anything in hunter_ships())
		hunter.remove_waypoint(board_waypoint_key())
	claimants.Cut()
	board_hunt_started.Cut()
	board_clear_gps()

	// Listeners get the criminal and decoys first: P6 detaches the ones at a trader outpost and walks them out
	SEND_SIGNAL(src, COMSIG_BOUNTY_POSTING_CLOSED, reason, winner)
	board_remove_mobs(reason)
	board_drop_marker()
	// Proof nobody brought in is proof of nothing now
	var/obj/item/bounty_proof/proof = board_proof()
	board_proof_ref = null
	if(proof && reason != BOUNTY_CLOSE_CLAIMED)
		UnregisterSignal(proof, COMSIG_QDELETING)
		qdel(proof)
	board_unhook_site()

	if(reason != BOUNTY_CLOSE_CLAIMED && record)
		if(record.status == BOUNTY_RECORD_WANTED)
			record.status = BOUNTY_RECORD_CLOSED
		// Nobody will wear this face again (P1's look cache)
		bounty_forget_looks(record)
	// Its ship's next offer waits, so dropping one never rerolls it at once
	var/obj/structure/overmap/ship/offered = offered_to()
	if(offered)
		SScriminal_bounties.board_private_next[WEAKREF(offered)] = world.time + BOUNTY_PRIVATE_GAP

	GLOB.criminal_bounties -= src
	SScriminal_bounties.board_changed()
	log_game("BOUNTY: the [board_log_name()] closed ([reason])[winner ? ", won by [winner.name]" : ""]")
	// Called from Destroy() (an admin deleting it) it is already on its way out
	if(!QDELETED(src))
		qdel(src)
	return TRUE

/// The notices a closing sends: "claimed by <ship>" to every other hunter, and why it ended to the rest
/datum/criminal_bounty/proc/board_notify_closed(reason, obj/structure/overmap/ship/winner)
	var/wanted_name = record?.name || "the fugitive"
	var/message
	switch(reason)
		if(BOUNTY_CLOSE_CLAIMED)
			message = "[wanted_name] was claimed by the [winner?.name || "another crew"]. The bounty is closed."
		if(BOUNTY_CLOSE_EXPIRED)
			message = private_to ? "The offer on [wanted_name] ran out." : "The bounty on [wanted_name] has expired."
		if(BOUNTY_CLOSE_NO_BODY)
			message = "[wanted_name] can't be found anywhere. The bounty is closed."
		if(BOUNTY_CLOSE_LOST)
			message = "[wanted_name] was lost with the [board_site_name || "ship"]. The bounty is closed."
		if(BOUNTY_CLOSE_ABANDONED)
			message = "Dropped the offer on [wanted_name]."
		else
			message = "The bounty on [wanted_name] was withdrawn."
	var/list/told = list()
	for(var/obj/structure/overmap/ship/hunter as anything in hunter_ships())
		if(hunter == winner)
			continue
		told += hunter
		hunter.ship_notify("WANTED: [message]", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
	// A dropped private offer tells its ship, which is no longer listed as hunting it
	var/obj/structure/overmap/ship/offered = offered_to()
	if(offered && !(offered in told) && offered != winner && (board_accepted || reason == BOUNTY_CLOSE_ABANDONED))
		offered.ship_notify("WANTED: [message]", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)

/**
 * Removes the criminal, its companions and its decoys, wherever they are, taking their field
 * protection off first (AR-G3). A ship holding the criminal is told who collected them, and whether
 * the bounty is closed or `relisting`. The pad detaches its criminal before it closes the bounty,
 * so this never touches one being beamed out.
 */
/datum/criminal_bounty/proc/board_remove_mobs(reason, relisting = FALSE)
	var/mob/living/basic/bounty_criminal/criminal = criminal()
	board_detach_criminal()
	var/list/extras = list()
	for(var/datum/weakref/ref as anything in companions + decoys)
		var/mob/living/extra = ref?.resolve()
		if(!QDELETED(extra))
			extras |= extra
	if(criminal)
		for(var/datum/weakref/ref as anything in criminal.companions)
			var/mob/living/extra = ref?.resolve()
			if(!QDELETED(extra))
				extras |= extra
		var/obj/structure/overmap/ship/holder = get_ship_from_atom(criminal)
		if(holder && !istype(holder, /obj/structure/overmap/ship/npc) && reason != BOUNTY_CLOSE_CLAIMED)
			if(relisting)
				holder.ship_notify("WANTED: the corrections service took [record?.name || "your prisoner"] off your ship.","MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
			else
				holder.ship_notify("WANTED: the corrections service collected [record?.name || "your prisoner"]. The bounty on them is closed.", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
		board_dispose_mob(criminal)
	companions.Cut()
	decoys.Cut()
	for(var/mob/living/extra as anything in extras)
		board_dispose_mob(extra)

/// Takes a bounty mob out of the world: its field protection off, a departure flash, gone
/datum/criminal_bounty/proc/board_dispose_mob(mob/living/leaving)
	if(QDELETED(leaving))
		return
	REMOVE_TRAIT(leaving, TRAIT_MISSION_FIELD_MOB, BOUNTY_TRAIT)
	// Taken away, not destroyed: nothing it leaves behind is proof of death
	ADD_TRAIT(leaving, TRAIT_BOUNTY_REMOVED, BOUNTY_PAD_TRAIT)
	var/turf/spot = get_turf(leaving)
	if(spot && leaving.stat != DEAD)
		new /obj/effect/temp_visual/transporter_flash/departure(spot)
	qdel(leaving)

// ===== RELISTING =====

/**
 * Takes the bounty off its site and lists it again somewhere else after BOUNTY_RELIST_DELAY, for
 * `reason` (the end of the sentence hunters are told after the name: "slipped away from ...", "has
 * vanished"). The criminal, companions, decoys and marker go now; hunters keep hunting it
 * and get the new waypoint when it lists. The clock is held for the delay. Returns TRUE if it
 * started relisting.
 */
/datum/criminal_bounty/proc/relist(reason)
	if(!is_open() || board_relisting)
		return FALSE
	board_relisting = TRUE
	board_relist_at = world.time + BOUNTY_RELIST_DELAY
	expires_at += BOUNTY_RELIST_DELAY
	board_spawn_failures = 0
	if(board_lost_timer)
		deltimer(board_lost_timer)
		board_lost_timer = null
	var/obj/structure/overmap/old_site = site()
	board_left_site = old_site ? WEAKREF(old_site) : null
	// At a trader outpost, P6 walks the fugitive (if it is still there) and its decoys out first
	if(placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST)
		outpost_release_site()
	board_remove_mobs(null, TRUE)
	board_drop_marker()
	board_unhook_site()
	site_ref = null
	// Whoever turns up at the next site is a fresh sighting
	board_worst_state = BOUNTY_STATE_FREE
	for(var/obj/structure/overmap/ship/hunter as anything in hunter_ships())
		hunter.remove_waypoint(board_waypoint_key())
		hunter.ship_notify("WANTED: [record?.name] [reason || "slipped away"].","MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
	log_game("BOUNTY: the [board_log_name()] is relisting: [reason]")
	return TRUE

/**
 * The relist delay is over: a new site in the zone band its value was fixed for first, never the
 * one it left. A trader-outpost fugitive goes to a different trader outpost, where it blends in
 * again (the card's mugshot is its old look); a criminal from anywhere else never goes to one (the
 * hunters have seen its true face, AR-C1), but may go to another kind its tier allows. With nowhere
 * to go it tries again a minute later, until its clock runs out.
 */
/datum/criminal_bounty/proc/board_finish_relist()
	var/obj/structure/overmap/exclude = board_left_site?.resolve()
	var/at_outpost = placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST
	var/list/placement = SScriminal_bounties.board_pick_placement(record?.tier, record?.archetype, placement_kind, board_zone, exclude, only_kind = at_outpost, avoid_kinds = at_outpost ? null : list(BOUNTY_PLACEMENT_TRADER_OUTPOST))
	if(!placement)
		board_relist_at = world.time + BOUNTY_PUBLIC_POST_RETRY
		return FALSE
	board_relisting = FALSE
	board_left_site = null
	placement_kind = placement[1]
	board_set_site(placement[2])
	// Its card is shown again with the new place, and its mugshot rebuilt if the look changed
	static_data_serial++
	SScriminal_bounties.board_changed()
	for(var/obj/structure/overmap/ship/hunter as anything in hunter_ships())
		board_push_waypoint(hunter)
		hunter.ship_notify("WANTED: new sighting of [record?.name]. [board_place_text()].", "MISSION CONTROL", SHIP_NOTIFY_NOTICE, 'voidcrew/sound/notify.ogg', 50)
	log_game("BOUNTY: the [board_log_name()] relisted")
	board_arm()
	return TRUE

// ===== WAYPOINTS =====

/// The key its helm waypoint is pushed under
/datum/criminal_bounty/proc/board_waypoint_key()
	return "wanted_[REF(src)]"

/// Charts its site on `ship`'s helm, following the site if it moves (a pirate ship, a planet that relocated)
/datum/criminal_bounty/proc/board_push_waypoint(obj/structure/overmap/ship/ship)
	var/obj/structure/overmap/where = site()
	if(!ship || !where || board_relisting)
		return FALSE
	var/list/coords = where.get_relative_overmap_coords()
	if(!coords)
		return FALSE
	ship.add_waypoint(board_waypoint_key(), "Wanted: [record?.name || "fugitive"]", coords[1], coords[2], "Bounties", where)
	return TRUE

// ===== PAY =====

/// Percent a capture state pays on its own (BOUNTY_SHARE_*); FREE pays nothing and is refused
/proc/bounty_state_share(state)
	switch(state)
		if(BOUNTY_STATE_DEAD)
			return BOUNTY_SHARE_DEAD
		if(BOUNTY_STATE_DOWNED)
			return BOUNTY_SHARE_DOWNED
		if(BOUNTY_STATE_RESTRAINED)
			return BOUNTY_SHARE_RESTRAINED
		if(BOUNTY_STATE_STUNNED)
			return BOUNTY_SHARE_STUNNED
	return 0

/**
 * Percent paid for a criminal in `state` at the pad that has at some point been as bad as
 * `worst_state` (12.1: once downed, at most the downed share; once dead, the dead share). 0 for a
 * free criminal, which the pad refuses.
 */
/datum/criminal_bounty/proc/board_share_for(state, worst_state)
	var/share = bounty_state_share(state)
	if(!share)
		return 0
	if(worst_state && worst_state != BOUNTY_STATE_FREE)
		var/worst_share = bounty_state_share(worst_state)
		if(worst_share)
			share = min(share, worst_share)
	return share

/**
 * What a turn-in at `share` percent pays: list(credits, vouchers). Vouchers come only with the
 * full share; below it each voucher's worth joins the credits before the share is taken (12.1).
 */
/datum/criminal_bounty/proc/board_payout(share)
	if(share >= 100)
		return list(value, board_vouchers)
	var/whole = value + board_vouchers * VOUCHER_CREDIT_VALUE
	return list(round(whole * share / 100), 0)

// ===== THE CARD =====

/// Its zone band's name ("Neutral Zone" ...)
/datum/criminal_bounty/proc/board_zone_name()
	switch(board_zone)
		if(ZONE_YELLOW)
			return ZONE_NAME_YELLOW
		if(ZONE_RED)
			return ZONE_NAME_RED
	return ZONE_NAME_GREEN

/// Its zone band's colour on the card, on the mission board's scale
/datum/criminal_bounty/proc/board_zone_color()
	switch(board_zone)
		if(ZONE_YELLOW)
			return "average"
		if(ZONE_RED)
			return "bad"
	return "good"

/**
 * Where it was last seen, as the card says it. The site's name is read again while the site is
 * there, so a ruin surveyed after posting shows its real name (BUG-9); an unsurveyed ruin says so
 * rather than naming "unknown signal".
 */
/datum/criminal_bounty/proc/board_place_text()
	if(board_relisting)
		return "Last seen: unknown"
	var/obj/structure/overmap/where = site()
	if(where)
		board_site_name = board_describe_site(where) || board_site_name
	var/site_name = board_site_name || "an unknown site"
	switch(placement_kind)
		if(BOUNTY_PLACEMENT_NPC_SHIP)
			return "Somewhere aboard the [site_name]"
		if(BOUNTY_PLACEMENT_TRADER_OUTPOST)
			return "Seen at [site_name]"
		if(BOUNTY_PLACEMENT_RUIN)
			var/obj/structure/overmap/space_ruin/ruin = where
			if(istype(ruin) && !ruin.surveyed)
				return "Seen at an unsurveyed signal"
			return "Seen at the [site_name]"
	return "Seen on [site_name]"

/// How the poster says they're wanted: alive, dead or alive, or dead
/datum/criminal_bounty/proc/board_terms()
	return "Wanted alive"

/// The card's state: offered (a private offer not taken yet), open, or relisting
/datum/criminal_bounty/proc/board_status()
	if(board_relisting)
		return BOUNTY_BOARD_RELISTING
	if(private_to && !board_accepted)
		return BOUNTY_BOARD_OFFERED
	return BOUNTY_BOARD_OPEN

/// Its species' name, for the card
/datum/criminal_bounty/proc/board_species_name()
	return bounty_species_name(record?.species)

/// Its sex, for the card
/datum/criminal_bounty/proc/board_sex_name()
	switch(record?.gender)
		if(MALE)
			return "Male"
		if(FEMALE)
			return "Female"
	return "Unknown"

/**
 * What the mission board of `ship`, with its linked `pad`, shows for it: what a wanted poster
 * says, and whether Turn In works. No image goes in here (AR-G1): the mugshot is in the board's
 * ui_static_data(), under `mugshot_id`.
 */
/datum/criminal_bounty/proc/board_ui_entry(obj/structure/overmap/ship/ship, obj/machinery/mission_pad/pad)
	var/list/preview = board_pad_preview(ship, pad)
	return list(
		"ref" = REF(src),
		"name" = record?.name || "Unknown",
		"alias" = record?.alias,
		"species" = board_species_name(),
		"sex" = board_sex_name(),
		"tier" = record?.tier || BOUNTY_TIER_PETTY,
		"terms" = board_terms(),
		"crime" = record?.crime,
		"place" = board_place_text(),
		"zone" = board_zone_name(),
		"zone_color" = board_zone_color(),
		"mugshot_id" = record?.id,
		"value" = value,
		"vouchers" = board_vouchers,
		"time_left" = board_time_left(),
		"private" = !!private_to,
		"hunting_by_us" = is_hunting(ship),
		"hunt_refusal" = hunt_refusal(ship),
		"photo_old" = !!record?.old_look,
		"can_turn_in" = preview[1],
		"turn_in_refusal" = board_preview_refusal(preview, ship),
	)

/// What the log calls it
/datum/criminal_bounty/proc/board_log_name()
	return "[bounty_tier_name(record?.tier)] bounty on [record?.name || "nobody"] ([placement_kind], [board_site_name || "no site"][private_to ? ", private" : ""])"

// ===== THE WARRANT =====

/// Prints a warrant for it at `where`: the mugshot, the listing and the distinguishing features, bound to it. P6 owns what the warrant does.
/datum/criminal_bounty/proc/print_warrant(turf/where)
	if(!where)
		return null
	var/obj/item/paper/bounty_warrant/warrant = new(where)
	warrant.posting_ref = WEAKREF(src)
	warrant.name = "warrant ([record?.name || "unknown"])"
	warrant.add_raw_text(board_warrant_text(), advanced_html = TRUE)
	warrant.update_appearance()
	return warrant

/// The reward as a poster says it: "1000 cr and 1 trade voucher"
/datum/criminal_bounty/proc/board_reward_text()
	return "[value] cr[board_vouchers ? " and [board_vouchers] trade voucher[board_vouchers > 1 ? "s" : ""]" : ""]"

/// The warrant's text
/datum/criminal_bounty/proc/board_warrant_text()
	var/list/lines = list()
	// One heading: the tier's name under it said Wanted twice
	lines += "<center><h2>[record?.tier == BOUNTY_TIER_MOST_WANTED ? "MOST WANTED" : "WANTED"]</h2></center>"
	// Never builds here (ui_act mustn't sleep): the board asked for it when its card was first shown
	var/mugshot = record ? bounty_mugshot_asset(record) : ""
	if(mugshot)
		lines += "<center><img src='data:image/png;base64,[mugshot]' width='96' height='96'></center>"
	if(record?.old_look)
		lines += "<center><i>Old photo.</i></center>"
	lines += "<b>Name:</b> [record?.name || "Unknown"]<br>"
	if(record?.alias && record.alias != record.name)
		lines += "<b>Also known as:</b> [record.alias]<br>"
	lines += "<b>Species:</b> [board_species_name()]. <b>Sex:</b> [board_sex_name()].<br>"
	if(record?.crime)
		lines += "<b>Wanted for:</b> [record.crime].<br>"
	lines += "<b>[board_terms()]</b>.<br>"
	lines += "[board_place_text()], [board_zone_name()].<br>"
	// One feature is left off, so what the traders say about them still tells a hunter something new
	var/list/features = record?.feature_lines()
	if(length(features))
		features = features.Copy(1, length(features))
	if(length(features))
		lines += "<b>Distinguishing features:</b><ul>"
		for(var/feature in features)
			lines += "<li>[feature]</li>"
		lines += "</ul>"
	lines += "<b>Reward:</b> [board_reward_text()].<br>"
	return lines.Join("\n")

/**
 * The CAPTURED poster's text for a full-share catch brought in by `ship`: the mugshot (already
 * built, never built here), name, crime, a CAPTURED line and who brought them in. Read before the
 * posting closes, since closing lets go of the record.
 */
/datum/criminal_bounty/proc/board_poster_text(obj/structure/overmap/ship/ship)
	var/list/lines = list()
	lines += "<center><h2>CAPTURED</h2><b>[bounty_tier_name(record?.tier)]</b></center>"
	if(record?.mugshot)
		lines += "<center><img src='data:image/png;base64,[record.mugshot]' width='96' height='96'></center>"
	lines += "<center><h3>[record?.name || "Unknown"]</h3></center>"
	if(record?.crime)
		lines += "<center>Wanted for [record.crime].</center>"
	lines += "<center>Brought in alive by the crew of the [ship?.name || "unknown ship"].</center>"
	return lines.Join("\n")
