/datum/bounty_admin_panel/proc/activity_choices()
	return list(
		"At a bar" = BOUNTY_ACTIVITY_BAR,
		"Chatting" = BOUNTY_ACTIVITY_CHAT,
		"Trading" = BOUNTY_ACTIVITY_TRADE,
		"Exploring" = BOUNTY_ACTIVITY_EXPLORE,
