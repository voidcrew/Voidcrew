/**
 * # Bounty hunting: the admin panel
 *
 * Owner: P8 admin. Owns this file and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_admin.dm. Do not edit this file outside P8.
 *
 * What it owns: the "Bounty Panel" admin verb, with tgui input lists and no .tsx (spec section 11):
 * spawn any archetype, kit or tier at your feet; spawn a decoy beside a criminal; post a bounty now;
 * give a bounty to a player (their ship hunts it, and they get its warrant); list, close, relist, jump
 * to and fetch bounties; force capture states; list the prisoner pool, admit a record into a chosen
 * prison, drop or clear records or add a test one; run the board forward.
 *
 * It changes other packages' state only through their procs:
 * - P1: generate_bounty_record(), make_decoy_record();
 * - P2: spawn_bounty_criminal(), body_apply_cuffs(), body_remove_cuffs(), body_downed_line(),
 *   body_stand_up(), capture_state();
 * - P3: start_activity();
 * - P5: post_criminal_bounty(), close(), relist(), hunt() (forced), print_warrant(),
 *   SScriminal_bounties.board_fast_forward() and
 *   admin_skip_post_gap(), board_site_zone(), board_kind_allowed(), board_postings_at();
 * - P6: the decoy's outpost_become() and the outpost's display name, description and outfit;
 * - P7: bounty_pool_add(), bounty_pool_remove(), bounty_pool_clear(), the prison's
 *   bounty_admit_record().
 * The one direct write is a criminal's worst_state back to free (force_free()): no package has a
 * proc that makes a worst state better, and the admin's "Free" exists to try a full-pay turn-in again.
 *
 * Everything goes through /datum/bounty_admin_panel. The menu procs (menu_*) ask the questions; the
 * action procs (admin_*) take plain arguments, check the admin again, act and log, so a unit test can
 * call either with no admin client (voidcrew_bounty_admin.dm overrides authorized(), log_action(),
 * tell() and the ask_* prompts). An action that is refused returns null or FALSE and leaves the reason
 * in `error`. Nothing is held across a prompt but weakrefs.
 *
 * EXTENSION POINT for the kingpin and the lairs (P9, P10, P12): /datum/bounty_admin_post_action at
 * the end of this file. A subtype with a name in your own file adds an entry to "Post a bounty now";
 * this file doesn't change.
 */

/// Most minutes one fast-forward runs the board on
#define BOUNTY_ADMIN_MAX_MINUTES 120
/// Most board ticks (10 s of board time each) one fast-forward runs
#define BOUNTY_ADMIN_MAX_TICKS 60
/// Board time one tick stands for, in seconds (SScriminal_bounties' wait)
#define BOUNTY_ADMIN_TICK_SECONDS 10
/// How long a forced stun lasts
#define BOUNTY_ADMIN_STUN_TIME (30 SECONDS)
/// Most questions one opening of the panel asks before it closes itself: a guard, never reached by hand
#define BOUNTY_ADMIN_MAX_STEPS 200
/// Who the pool's test records say brought them in
#define BOUNTY_ADMIN_TEST_CAPTOR "Admin test"
/// The reason hunters are told when an admin relists a bounty: "WANTED: <name> has moved on."
#define BOUNTY_ADMIN_RELIST_REASON "has moved on"

// The main menu, in the order it shows
#define BOUNTY_ADMIN_MENU_SPAWN "Spawn a criminal at my feet"
#define BOUNTY_ADMIN_MENU_DECOY "Spawn a decoy next to a criminal"
#define BOUNTY_ADMIN_MENU_POST "Post a bounty now"
#define BOUNTY_ADMIN_MENU_GIVE "Give a bounty to a player"
#define BOUNTY_ADMIN_MENU_POSTINGS "Live postings"
#define BOUNTY_ADMIN_MENU_FORCE "Force a capture state"
#define BOUNTY_ADMIN_MENU_POOL "Prisoner pool"
#define BOUNTY_ADMIN_MENU_BOARD "Fast-forward the board"

/// "Post a bounty now"'s first entry when there are extra post actions: an ordinary criminal
#define BOUNTY_ADMIN_POST_CRIMINAL "A criminal (pick the tier and place)"
/// "Give a bounty to a player"'s first entry: a new criminal, posted as a private offer to their ship
#define BOUNTY_ADMIN_GIVE_NEW "A new criminal, just for them (pick the tier and place)"

ADMIN_VERB(bounty_panel, R_ADMIN, "Bounty Panel", "Spawn, post, give out, list and force bounty criminals, manage the prisoner pool and run the bounty board forward.", ADMIN_CATEGORY_SHUTTLE)
	var/datum/bounty_admin_panel/panel = new(user.mob)
	BLACKBOX_LOG_ADMIN_VERB("Bounty Panel")
	panel.run_menu(user.mob)
	qdel(panel)

/**
 * One opening of the Bounty Panel by one admin. Holds nothing between actions but the admin and the
 * last refusal; it is deleted when the admin closes the menu.
 */
/datum/bounty_admin_panel
	/// The admin who opened it
	var/mob/admin
	/// Why the last action was refused, or null
	var/error

/datum/bounty_admin_panel/New(mob/user)
	. = ..()
	admin = user

/datum/bounty_admin_panel/Destroy()
	admin = null
	return ..()

// ===== CHECKS, LOGS AND PROMPTS =====
// A unit test overrides these to act without an admin client.

/// Whether `user` may use it now: the admin who opened it, still holding R_ADMIN. Checked again after every prompt.
/datum/bounty_admin_panel/proc/authorized(mob/user)
	return !QDELETED(src) && !isnull(user) && user == admin && check_rights_for(user.client, R_ADMIN)

/// Logs a done action, as the prison admin tools do
/datum/bounty_admin_panel/proc/log_action(mob/user, operation)
	log_admin("[key_name(user)] used the Bounty Panel to [operation].")
	message_admins("[key_name_admin(user)] used the Bounty Panel to [operation].")

/// Tells the admin something in chat
/datum/bounty_admin_panel/proc/tell(mob/user, message)
	to_chat(user, message)

/// A choice from `options` (the keys of an assoc list, or plain entries), or null if cancelled
/datum/bounty_admin_panel/proc/ask_list(mob/user, message, title, list/options)
	if(!length(options))
		return null
	return tgui_input_list(user, message, title || "Bounty Panel", options)

/// A whole number from `min_value` to `max_value`, or null if cancelled
/datum/bounty_admin_panel/proc/ask_number(mob/user, message, title, default, max_value, min_value)
	return tgui_input_number(user, message, title || "Bounty Panel", default, max_value, min_value)

/// Keeps `text` as the reason in `error` and tells the admin. Returns null, for `return refuse(...)`.
/datum/bounty_admin_panel/proc/refuse(mob/user, text)
	error = text
	tell(user, span_warning(text))
	return null

// ===== THE MENU =====

/// Asks what to do, does it and asks again, until the admin cancels
/datum/bounty_admin_panel/proc/run_menu(mob/user)
	var/static/list/menu = list(
		BOUNTY_ADMIN_MENU_SPAWN,
		BOUNTY_ADMIN_MENU_DECOY,
		BOUNTY_ADMIN_MENU_POST,
		BOUNTY_ADMIN_MENU_GIVE,
		BOUNTY_ADMIN_MENU_POSTINGS,
		BOUNTY_ADMIN_MENU_FORCE,
		BOUNTY_ADMIN_MENU_POOL,
		BOUNTY_ADMIN_MENU_BOARD,
	)
	for(var/asked in 1 to BOUNTY_ADMIN_MAX_STEPS)
		if(!authorized(user))
			return
		var/choice = ask_list(user, summary_text(), "Bounty Panel", menu)
		if(!choice || !authorized(user))
			return
		error = null
		switch(choice)
			if(BOUNTY_ADMIN_MENU_SPAWN)
				menu_spawn(user)
			if(BOUNTY_ADMIN_MENU_DECOY)
				menu_decoy(user)
			if(BOUNTY_ADMIN_MENU_POST)
				menu_post(user)
			if(BOUNTY_ADMIN_MENU_GIVE)
				menu_give(user)
			if(BOUNTY_ADMIN_MENU_POSTINGS)
				menu_postings(user)
			if(BOUNTY_ADMIN_MENU_FORCE)
				menu_force(user)
			if(BOUNTY_ADMIN_MENU_POOL)
				menu_pool(user)
			if(BOUNTY_ADMIN_MENU_BOARD)
				menu_board(user)

/// The menu's heading: how much is going on
/datum/bounty_admin_panel/proc/summary_text()
	var/open = 0
	for(var/datum/criminal_bounty/posting in GLOB.criminal_bounties)
		if(!QDELETED(posting) && posting.status == BOUNTY_POSTING_OPEN)
			open++
	var/about = length(live_criminals())
	return "[open] open bount[open == 1 ? "y" : "ies"], [about] criminal\s about, [length(GLOB.bounty_prisoner_pool)] record\s in the prisoner pool."

/datum/bounty_admin_panel/proc/menu_spawn(mob/user)
	var/list/archetypes = archetype_choices()
	var/archetype_choice = ask_list(user, "Which archetype?", "Spawn a criminal", archetypes)
	if(!archetype_choice || !authorized(user))
		return
	var/archetype = archetypes[archetype_choice]
	var/tier = ask_tier(user, "Spawn a criminal")
	if(!tier)
		return
	var/variant
	if(archetype == BOUNTY_ARCHETYPE_BOSS)
		var/list/kits = list("Random" = null) + kit_choices()
		var/kit_choice = ask_list(user, "Which kit?", "Spawn a criminal", kits)
		if(!kit_choice || !authorized(user))
			return
		variant = kits[kit_choice]
	else if(archetype == BOUNTY_ARCHETYPE_NORMAL)
		var/list/styles = list("Let the record pick" = null) + style_choices()
		var/style_choice = ask_list(user, "Which fighting style?", "Spawn a criminal", styles)
		if(!style_choice || !authorized(user))
			return
		variant = styles[style_choice]
	var/list/activities = list("None" = null) + activity_choices()
	var/activity_choice = ask_list(user, "Doing what?", "Spawn a criminal", activities)
	if(!activity_choice || !authorized(user))
		return
	admin_spawn_criminal(user, tier, archetype, variant, activities[activity_choice], get_turf(user))

/datum/bounty_admin_panel/proc/menu_decoy(mob/user)
	var/datum/weakref/wanted_ref = WEAKREF(pick_criminal(user, "Spawn a decoy next to whom?"))
	if(!wanted_ref)
		return
	var/static/list/shares = list("One of their features" = 1, "Two of their features" = 2)
	var/share_choice = ask_list(user, "The decoy shares how much of their look?", "Spawn a decoy", shares)
	if(!share_choice || !authorized(user))
		return
	var/mob/living/basic/bounty_criminal/wanted = wanted_ref.resolve()
	if(QDELETED(wanted))
		refuse(user, "That criminal is gone.")
		return
	admin_spawn_decoy(user, wanted, shares[share_choice])

/datum/bounty_admin_panel/proc/menu_post(mob/user)
	// Extra kinds of posting (the kingpin, the lairs) come first when there are any
	var/list/extras = post_actions()
	if(length(extras))
		var/list/kinds_of_bounty = list(BOUNTY_ADMIN_POST_CRIMINAL)
		for(var/datum/bounty_admin_post_action/action as anything in extras)
			kinds_of_bounty[unique_label(kinds_of_bounty, action.name)] = action
		var/bounty_choice = ask_list(user, "What kind of bounty?", "Post a bounty", kinds_of_bounty)
		if(!bounty_choice || !authorized(user))
			return
		if(bounty_choice != BOUNTY_ADMIN_POST_CRIMINAL)
			admin_run_post_action(user, kinds_of_bounty[bounty_choice])
			return
	menu_post_criminal(user)

/**
 * Asks for an ordinary criminal's tier, placement and site, and whether it is public or a private
 * offer to a ship, then posts it. With `for_ship` it is a private offer to that ship, and that
 * question is skipped. Returns the posting, or null.
 */
/datum/bounty_admin_panel/proc/menu_post_criminal(mob/user, obj/structure/overmap/ship/for_ship)
	var/datum/weakref/ship_ref = for_ship ? WEAKREF(for_ship) : null
	var/tier = ask_tier(user, "Post a bounty")
	if(!tier)
		return null
	var/list/kinds = list()
	var/list/all_kinds = placement_choices()
	for(var/label in all_kinds)
		if(SScriminal_bounties.board_kind_allowed(all_kinds[label], tier, null))
			kinds[label] = all_kinds[label]
	var/kind_choice = ask_list(user, "Where? Only the places a [bounty_tier_name(tier)] bounty may go.", "Post a bounty", kinds)
	if(!kind_choice || !authorized(user))
		return null
	var/kind = kinds[kind_choice]
	var/list/sites = list("Let the board pick" = null) + site_choices(kind)
	var/site_choice = ask_list(user, "Which site? Only those the board would pick are listed.", "Post a bounty", sites)
	if(!site_choice || !authorized(user))
		return null
	if(!ship_ref)
		var/list/audiences = list("Public" = null) + ship_choices()
		var/audience_choice = ask_list(user, "Public, or a private offer to one ship?", "Post a bounty", audiences)
		if(!audience_choice || !authorized(user))
			return null
		ship_ref = audiences[audience_choice]
	var/datum/weakref/site_ref = sites[site_choice]
	var/obj/structure/overmap/site = site_ref?.resolve()
	if(site_ref && QDELETED(site))
		return refuse(user, "That site is gone.")
	var/obj/structure/overmap/ship/private_to = ship_ref?.resolve()
	if(ship_ref && QDELETED(private_to))
		return refuse(user, "That ship is gone.")
	return admin_post_bounty(user, tier, kind, site, private_to)

/**
 * Gives a bounty to a player: asks whom (anyone alive crewing a ship), then which bounty (a new one
 * posted as a private offer to their ship, or any open one they may hunt), unless `given` is the
 * bounty already. See admin_give_bounty().
 */
/datum/bounty_admin_panel/proc/menu_give(mob/user, datum/criminal_bounty/given)
	var/datum/weakref/given_ref = given ? WEAKREF(given) : null
	var/list/players = player_choices()
	if(!length(players))
		refuse(user, "Nobody alive is crewing a ship.")
		return
	var/player_choice = ask_list(user, "Give a bounty to whom? Their ship hunts it, and they get the warrant.", "Give a bounty", players)
	if(!player_choice || !authorized(user))
		return
	var/datum/weakref/player_ref = players[player_choice]
	var/mob/living/player = player_ref.resolve()
	var/obj/structure/overmap/ship/ship = get_crew_ship(player)
	if(QDELETED(player) || QDELETED(ship))
		refuse(user, "That player is gone, or no longer crews a ship.")
		return
	if(!given_ref)
		var/list/bounties = list()
		bounties[BOUNTY_ADMIN_GIVE_NEW] = null
		bounties += give_choices(ship)
		var/bounty_choice = ask_list(user, "Which bounty?", "Give a bounty", bounties)
		if(!bounty_choice || !authorized(user))
			return
		given_ref = bounties[bounty_choice]
		if(!given_ref)
			ship = get_crew_ship(player_ref.resolve())
			if(QDELETED(ship))
				refuse(user, "That player no longer crews a ship.")
				return
			var/datum/criminal_bounty/posted = menu_post_criminal(user, ship)
			if(!posted)
				return
			given_ref = WEAKREF(posted)
	var/datum/criminal_bounty/posting = given_ref.resolve()
	if(QDELETED(posting))
		refuse(user, "That bounty is gone.")
		return
	admin_give_bounty(user, posting, player_ref.resolve())

/datum/bounty_admin_panel/proc/menu_postings(mob/user)
	var/list/choices = list()
	var/list/lines = list()
	for(var/datum/criminal_bounty/posting in GLOB.criminal_bounties)
		if(QDELETED(posting))
			continue
		var/list/row = posting_row(posting)
		lines += posting_line(row)
		choices[unique_label(choices, "[row["tier"]] [row["name"]] at [row["place"]] ([row["status"]])")] = WEAKREF(posting)
	if(!length(choices))
		tell(user, span_notice("No bounties are posted."))
		return
	tell(user, boxed_message("<b>Bounty postings</b><br>[jointext(lines, "<br>")]"))
	var/posting_choice = ask_list(user, "Which bounty?", "Live postings", choices)
	if(!posting_choice || !authorized(user))
		return
	var/datum/weakref/posting_ref = choices[posting_choice]
	var/static/list/actions = list("Give it to a player", "Close it", "Relist it", "Jump to the criminal", "Bring the criminal here")
	var/action = ask_list(user, "Do what with it?", "Live postings", actions)
	if(!action || !authorized(user))
		return
	var/datum/criminal_bounty/posting = posting_ref?.resolve()
	if(QDELETED(posting))
		refuse(user, "That bounty is gone.")
		return
	switch(action)
		if("Give it to a player")
			menu_give(user, posting)
		if("Close it")
			admin_close_posting(user, posting)
		if("Relist it")
			admin_relist_posting(user, posting)
		if("Jump to the criminal")
			admin_jump(user, posting.criminal(), posting)
		if("Bring the criminal here")
			admin_bring(user, posting.criminal(), posting)

/datum/bounty_admin_panel/proc/menu_force(mob/user)
	var/datum/weakref/criminal_ref = WEAKREF(pick_criminal(user, "Force a capture state on whom?"))
	if(!criminal_ref)
		return
	var/static/list/states = list(
		"Downed" = BOUNTY_STATE_DOWNED,
		"Stunned" = BOUNTY_STATE_STUNNED,
		"Restrained (cuffs on)" = BOUNTY_STATE_RESTRAINED,
		"Dead" = BOUNTY_STATE_DEAD,
		"Free (up, healed, uncuffed, worst state cleared)" = BOUNTY_STATE_FREE,
	)
	var/state_choice = ask_list(user, "Which state?", "Force a capture state", states)
	if(!state_choice || !authorized(user))
		return
	var/mob/living/basic/bounty_criminal/criminal = criminal_ref.resolve()
	if(QDELETED(criminal))
		refuse(user, "That criminal is gone.")
		return
	admin_force_state(user, criminal, states[state_choice])

/datum/bounty_admin_panel/proc/menu_pool(mob/user)
	var/static/list/actions = list("List the records", "Admit a record into a prison now", "Drop a record", "Add a test record", "Clear the whole pool")
	var/action = ask_list(user, "The pool holds [length(GLOB.bounty_prisoner_pool)] record\s.", "Prisoner pool", actions)
	if(!action || !authorized(user))
		return
	switch(action)
		if("List the records")
			var/list/lines = list()
			for(var/list/row as anything in pool_rows())
				lines += "<b>[row["name"]]</b>: [row["tier"]] [row["archetype"]], [row["status"]], for [row["prison"]][row["reserved"] ? "" : " (not reserved)"], [row["age"]]"
			if(!length(lines))
				tell(user, span_notice("The prisoner pool is empty."))
				return
			tell(user, boxed_message("<b>Prisoner pool</b><br>[jointext(lines, "<br>")]"))
		if("Admit a record into a prison now")
			var/datum/weakref/record_ref = WEAKREF(pick_record(user, "Admit which record?"))
			if(!record_ref)
				return
			var/datum/outpost_prison/prison = pick_prison(user, "Into which prison?")
			if(!prison)
				return
			var/datum/bounty_record/record = record_ref.resolve()
			if(!record)
				refuse(user, "That record is gone.")
				return
			admin_pool_admit(user, record, prison)
		if("Drop a record")
			var/datum/bounty_record/record = pick_record(user, "Drop which record?")
			if(!record)
				return
			admin_pool_drop(user, record)
		if("Add a test record")
			var/list/archetypes = archetype_choices()
			var/archetype_choice = ask_list(user, "Which archetype?", "Add a test record", archetypes)
			if(!archetype_choice || !authorized(user))
				return
			var/tier = ask_tier(user, "Add a test record")
			if(!tier)
				return
			var/list/prisons = list("Any prison" = null) + prison_choices()
			var/prison_choice = ask_list(user, "Reserved for which prison?", "Add a test record", prisons)
			if(!prison_choice || !authorized(user))
				return
			var/datum/weakref/prison_ref = prisons[prison_choice]
			var/datum/outpost_prison/prison = prison_ref?.resolve()
			if(prison_ref && QDELETED(prison))
				refuse(user, "That prison is gone.")
				return
			admin_pool_add(user, tier, archetypes[archetype_choice], prison)
		if("Clear the whole pool")
			admin_pool_clear(user)

/datum/bounty_admin_panel/proc/menu_board(mob/user)
	var/static/list/actions = list("Run the board forward by ticks", "Run the board forward by minutes", "Skip the post gap: post a public bounty now")
	var/action = ask_list(user, "The board ticks every [BOUNTY_ADMIN_TICK_SECONDS] seconds of the round. Running it forward brings every clock on it that much closer.", "Fast-forward the board", actions)
	if(!action || !authorized(user))
		return
	switch(action)
		if("Run the board forward by ticks")
			var/count = ask_number(user, "How many ticks, [BOUNTY_ADMIN_TICK_SECONDS] seconds each?", "Fast-forward the board", 1, BOUNTY_ADMIN_MAX_TICKS, 1)
			if(isnull(count) || !authorized(user))
				return
			if(!isnum(count) || count != round(count) || count < 1 || count > BOUNTY_ADMIN_MAX_TICKS)
				refuse(user, "Run 1 to [BOUNTY_ADMIN_MAX_TICKS] whole ticks.")
				return
			admin_fast_forward(user, count * BOUNTY_ADMIN_TICK_SECONDS)
		if("Run the board forward by minutes")
			var/minutes = ask_number(user, "How many minutes?", "Fast-forward the board", 5, BOUNTY_ADMIN_MAX_MINUTES, 1)
			if(isnull(minutes) || !authorized(user))
				return
			if(!isnum(minutes) || minutes != round(minutes) || minutes < 1 || minutes > BOUNTY_ADMIN_MAX_MINUTES)
				refuse(user, "Run 1 to [BOUNTY_ADMIN_MAX_MINUTES] whole minutes.")
				return
			admin_fast_forward(user, minutes * 60)
		if("Skip the post gap: post a public bounty now")
			admin_skip_post_gap(user)

// ===== PICKERS =====

/// The tier the admin picks, or null
/datum/bounty_admin_panel/proc/ask_tier(mob/user, title)
	var/list/tiers = tier_choices()
	var/tier_choice = ask_list(user, "Which tier?", title, tiers)
	if(!tier_choice || !authorized(user))
		return null
	return tiers[tier_choice]

/// The live criminal the admin picks (never a decoy), or null
/datum/bounty_admin_panel/proc/pick_criminal(mob/user, message)
	var/list/choices = list()
	for(var/mob/living/basic/bounty_criminal/criminal as anything in live_criminals())
		choices[unique_label(choices, criminal_label(criminal))] = WEAKREF(criminal)
	if(!length(choices))
		return refuse(user, "No bounty criminals are about. Spawn one first.")
	var/choice = ask_list(user, message, "Bounty Panel", choices)
	if(!choice || !authorized(user))
		return null
	var/datum/weakref/criminal_ref = choices[choice]
	var/mob/living/basic/bounty_criminal/criminal = criminal_ref?.resolve()
	if(QDELETED(criminal))
		return refuse(user, "That criminal is gone.")
	return criminal

/// The pool record the admin picks, or null
/datum/bounty_admin_panel/proc/pick_record(mob/user, message)
	var/list/choices = list()
	for(var/datum/bounty_record/record in GLOB.bounty_prisoner_pool)
		choices[unique_label(choices, record_label(record))] = WEAKREF(record)
	if(!length(choices))
		return refuse(user, "The prisoner pool is empty.")
	var/choice = ask_list(user, message, "Prisoner pool", choices)
	if(!choice || !authorized(user))
		return null
	var/datum/weakref/record_ref = choices[choice]
	var/datum/bounty_record/record = record_ref?.resolve()
	if(QDELETED(record))
		return refuse(user, "That record is gone.")
	return record

/// The running prison the admin picks, or null
/datum/bounty_admin_panel/proc/pick_prison(mob/user, message)
	var/list/choices = prison_choices()
	if(!length(choices))
		return refuse(user, "No outpost runs a prison.")
	var/choice = ask_list(user, message, "Prisoner pool", choices)
	if(!choice || !authorized(user))
		return null
	var/datum/weakref/prison_ref = choices[choice]
	var/datum/outpost_prison/prison = prison_ref?.resolve()
	if(QDELETED(prison))
		return refuse(user, "That prison is gone.")
	return prison

/// Every live bounty criminal in the world, decoys only if asked for
/datum/bounty_admin_panel/proc/live_criminals(include_decoys = FALSE)
	var/list/found = list()
	for(var/mob/living/basic/bounty_criminal/criminal in GLOB.mob_living_list)
		if(QDELETED(criminal))
			continue
		if(!include_decoys && istype(criminal, /mob/living/basic/bounty_criminal/decoy))
			continue
		found += criminal
	return found

/// `label`, or `label (2)` and on if the list already has it: a tgui list needs unique entries
/datum/bounty_admin_panel/proc/unique_label(list/choices, label)
	if(!(label in choices))
		return label
	var/number = 2
	while("[label] ([number])" in choices)
		number++
	return "[label] ([number])"

/// The values of an assoc list of choices
/datum/bounty_admin_panel/proc/choice_values(list/choices)
	var/list/values = list()
	for(var/label in choices)
		values += choices[label]
	return values

/datum/bounty_admin_panel/proc/tier_choices()
	return list("Petty" = BOUNTY_TIER_PETTY, "Wanted" = BOUNTY_TIER_WANTED, "Most Wanted" = BOUNTY_TIER_MOST_WANTED)

/datum/bounty_admin_panel/proc/archetype_choices()
	return list("Meek" = BOUNTY_ARCHETYPE_MEEK, "Normal" = BOUNTY_ARCHETYPE_NORMAL, "Mini-boss" = BOUNTY_ARCHETYPE_BOSS)

/datum/bounty_admin_panel/proc/kit_choices()
	return list(
		"Juggernaut" = BOUNTY_KIT_JUGGERNAUT,
		"Pyromaniac" = BOUNTY_KIT_PYROMANIAC,
		"Demolitionist" = BOUNTY_KIT_DEMOLITIONIST,
		"Ghost" = BOUNTY_KIT_GHOST,
		"Heavy" = BOUNTY_KIT_HEAVY,
	)

/// A normal criminal's styles; the meek always carry the holdout, so the menu doesn't offer it
/datum/bounty_admin_panel/proc/style_choices()
	return list(
		"Brawler" = BOUNTY_STYLE_BRAWLER,
		"Knife" = BOUNTY_STYLE_KNIFE,
		"Pistol" = BOUNTY_STYLE_PISTOL,
