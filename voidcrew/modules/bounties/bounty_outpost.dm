/**
 * # Bounty hunting: fugitives at trader outposts
 *
 * Owner: P6 outposts. Owns this file, voidcrew/_DEFINES/bounty_outpost.dm, the "Ask about" hook in
 * voidcrew/modules/trade/trader_npc.dm, the wanted board on the trader outpost maps
 * (trader_outpost_black_market.dmm, trader_outpost_general.dmm, trader_outpost_outfitter.dmm),
 * tgui/packages/tgui/interfaces/WantedBoard.tsx and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_outpost.dm. Do not edit this file outside P6.
 *
 * What it owns: identifying the fugitive (decision 16, spec section 7, abuse review section C).
 * The fugitive and its decoys are real humans (/mob/living/carbon/human/npc, voidcrew/modules/human_npcs/):
 * - Blending in. The fugitive and BOUNTY_DECOY_COUNT decoys wear the zone's patron clothes and go
 *   by the same generic name ("patron", "dockhand", "spacer"); the alias is never shown. While
 *   they blend in the turrets leave them alone and a hit on one is judged by who it was meant for
 *   (/datum/component/bounty_outpost_blend). They are people like any other: they can be grabbed,
 *   shot, knocked down and cuffed the way anyone can, and what they do about it is their AI's.
 * - Decoys (/mob/living/carbon/human/npc/bounty_criminal/decoy): look-alikes with the fugitive's
 *   face (a record that shares one or two of its features), the zone's clothes, its bag and belt
 *   (outpost_match_kit(), emptied), and its toughness and pace (body_match()). Showing one the
 *   warrant, hitting one on purpose or reaching for its wrists raises the posting's alert; a hit is
 *   also an outpost strike for the hitter.
 * - Traders' clues: any trader, the barkeep included, gives a ship hunting a fugitive there one
 *   true clue, a different one per trader.
 * - The warrant (/obj/item/paper/bounty_warrant): shown to the fugitive it exposes them (P3's
 *   on_confronted()); shown to anyone else they protest. A ship can show one every
 *   BOUNTY_WARRANT_COOLDOWN.
 * - The alert: at BOUNTY_OUTPOST_ALERT_SLIP the decoys leave and the fugitive walks out to the
 *   hangar lift; the bounty relists at another trader outpost once it has gone (P5's relist()). A
 *   fugitive caught on the way is still the posting's.
 * - The walk out: when the posting closes, the decoys and an uncaught fugitive walk to the hangar
 *   lift through the human NPC base's npc_walk_out(). They can be shot, downed and cuffed on the way
 *   and are deleted only on the lift or out of every player's sight (bounty_outpost_walk_out()).
 * - The wanted board (/obj/structure/bounty_wanted_board): a locked board on each concourse
 *   listing the public bounties.
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; the vars below that only P6
 * uses carry an `outpost_` prefix.
 */

// =========================================================================
// THE ZONE'S LOOK
// =========================================================================
// Everyone blending in wears the same clothes, so faces, hair and the features are what tell them
// apart. None of the outfits has a hat: hair is a clue.

/// Halcyon (green): a customer in their good shirt
/datum/outfit/bounty_outpost_patron
	name = "Outpost patron"
	uniform = /obj/item/clothing/under/costume/buttondown/slacks
	suit = /obj/item/clothing/suit/jacket/bomber
	shoes = /obj/item/clothing/shoes/laceup

/// The Quartermain (yellow): a day hand from the loading bays, dressed like the depot's own
/datum/outfit/bounty_outpost_dockhand
	name = "Outpost dockhand"
	uniform = /obj/item/clothing/under/rank/cargo/tech
	suit = /obj/item/clothing/suit/hazardvest
	gloves = /obj/item/clothing/gloves/fingerless
	shoes = /obj/item/clothing/shoes/workboots

/// The Undertow (red): a spacer between ships
/datum/outfit/bounty_outpost_spacer
	name = "Outpost spacer"
	uniform = /obj/item/clothing/under/pants/jeans
	suit = /obj/item/clothing/suit/jacket/leather
	gloves = /obj/item/clothing/gloves/fingerless
	shoes = /obj/item/clothing/shoes/jackboots

/// What everyone blending in at `outpost` is called (AR-C2): never a name, never the alias
/proc/bounty_outpost_display_name(obj/structure/overmap/trader_outpost/outpost)
	if(istype(outpost, /obj/structure/overmap/trader_outpost/general))
		return "patron"
	if(istype(outpost, /obj/structure/overmap/trader_outpost/outfitter))
		return "dockhand"
	return "spacer"

/// Their description at `outpost`: the same for everyone blending in there
/proc/bounty_outpost_display_desc(obj/structure/overmap/trader_outpost/outpost)
	if(istype(outpost, /obj/structure/overmap/trader_outpost/general))
		return "Another customer passing through."
	if(istype(outpost, /obj/structure/overmap/trader_outpost/outfitter))
		return "Works the loading bays, or dresses like they do."
	return "Keeps to themselves. Most people here do."

/// What everyone blending in at `outpost` wears
/proc/bounty_outpost_outfit(obj/structure/overmap/trader_outpost/outpost)
	if(istype(outpost, /obj/structure/overmap/trader_outpost/general))
		return /datum/outfit/bounty_outpost_patron
	if(istype(outpost, /obj/structure/overmap/trader_outpost/outfitter))
		return /datum/outfit/bounty_outpost_dockhand
	return /datum/outfit/bounty_outpost_spacer

/// What a decoy says when shown a warrant, if the dialogue file has nothing for it
GLOBAL_LIST_INIT(bounty_decoy_protest_lines, list(
	"Not me, pal.",
	"Wrong person. Here, look.",
	"You've got the wrong one.",
))

/// What a decoy says when someone hits it, if the dialogue file has nothing for it
GLOBAL_LIST_INIT(bounty_decoy_hurt_lines, list(
	"Hey! What's your problem?",
	"Get off me!",
	"I didn't do anything!",
))

/// What the nearest trader calls out when a warrant exposes a fugitive in front of them
GLOBAL_LIST_INIT(bounty_outpost_trader_react_lines, list(
	"Hey! Not in here!",
	"Take it outside!",
	"Watch the stock!",
))

/// A trader's answer when they know nothing the others haven't said
#define BOUNTY_OUTPOST_NO_CLUE "Can't help you there."
/// How far a trader can be from an exposed fugitive and still call out
#define BOUNTY_OUTPOST_REACT_RANGE 7

// =========================================================================
// THE POSTING'S TRADER-OUTPOST STATE
// =========================================================================

/datum/criminal_bounty
	/// The trader outpost this posting is set up at, as a weakref (/obj/structure/overmap/trader_outpost)
	var/datum/weakref/outpost_site
	/// When each ship may show a warrant again: REF of the ship (or of the person, without one) -> world.time
	var/list/outpost_warrant_ready_at = list()
	/// Clues no trader has given yet at this site, each list(BOUNTY_CLUE_*, index); built on the first question
	var/list/outpost_clue_pool
	/// The clue each trader gives: REF of the trader -> list(BOUNTY_CLUE_*, index)
	var/list/outpost_trader_clues = list()
	/// What each trader told each ship: "trader REF|ship REF" -> list(the clue kind, the place it named then or null). Facts, never words: the words are made on each ask.
	var/list/outpost_clues_told = list()
	/// How many of the fugitive's features each decoy was made to share, in spawn order
	var/list/outpost_decoy_shares = list()
	/// The decoys' human NPC orders (/datum/human_npc_order), kept so the ones not built yet can be cancelled
	var/list/outpost_decoy_orders = list()

/**
 * Sets a trader-outpost bounty up to blend in, once P5 has spawned the criminal at the outpost
 * (site_ref and criminal_ref set):
 * - the record gets its old look, so the listing's mugshot shows how they used to look (AR-C1);
 * - the fugitive wears the zone's clothes and the zone's generic name, and blends in;
 * - BOUNTY_DECOY_COUNT decoys spawn out of sight, each sharing one or two of its features. They are
 *   human NPCs, so they wait their turn in the spawn queue and join `decoys` as they are built; with
 *   `immediate` they are built now (tests, and callers that need them at once);
 * - the alert and the traders' clues start over.
 *
 * Refuses (FALSE) a mini-boss (AR-C9), an outpost that already has BOUNTY_MAX_FUGITIVES_PER_OUTPOST,
 * and a posting whose site is not a loaded trader outpost. Returns TRUE when set up.
 */
/datum/criminal_bounty/proc/setup_outpost_blend(immediate = FALSE)
	var/obj/structure/overmap/trader_outpost/outpost = site_ref?.resolve()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = criminal()
	if(!istype(outpost) || !outpost.template_bottom_left || !outpost.outpost_template || !fugitive || !record)
		return FALSE
	if(istype(fugitive, /mob/living/carbon/human/npc/bounty_criminal/boss) || record.archetype == BOUNTY_ARCHETYPE_BOSS)
		log_game("BOUNTY: a mini-boss ([record.name]) was refused at [outpost]. Mini-bosses never go to trader outposts.")
		return FALSE
	if(!bounty_outpost_has_room(outpost, src))
		log_game("BOUNTY: [record.name] was refused at [outpost], which already has [BOUNTY_MAX_FUGITIVES_PER_OUTPOST] fugitives.")
		return FALSE

	// A fresh start: decoys from an earlier site leave, and the alert and the clues start over.
	outpost_dismiss_decoys()
	outpost_site = WEAKREF(outpost)
	alert = 0
	outpost_clue_pool = null
	outpost_trader_clues = list()
	outpost_clues_told = list()
	outpost_decoy_shares = list()
	outpost_warrant_ready_at = list()

	// The listing's mugshot shows them before they changed their hair or clothes (AR-C1), but only
	// for a face nobody has seen yet. A record whose mugshot is already out (relisted here from
	// somewhere else) keeps the face everyone has seen: no past face is invented for it.
	if(!record.old_look && !record.mugshot && make_old_look(record))
		static_data_serial++

	var/display_name = bounty_outpost_display_name(outpost)
	var/display_desc = bounty_outpost_display_desc(outpost)
	var/outfit = bounty_outpost_outfit(outpost)

	// Nobody travels with them here: a companion standing by one patron would give them away.
	for(var/datum/weakref/companion_ref as anything in fugitive.companions | companions)
		var/mob/living/companion = companion_ref?.resolve()
		if(!QDELETED(companion))
			bounty_outpost_walk_out(companion, outpost)
	fugitive.companions.Cut()
	companions.Cut()

	// Only where customers walk (M5): a fugitive placed behind glass, a counter or a staff door
	// moves to the concourse before anyone sees it, and the decoys come from the same floor.
	var/list/spots = bounty_outpost_spawn_spots(outpost, BOUNTY_DECOY_COUNT + 1)
	var/list/public_floor = bounty_outpost_public_floor(outpost)
	if(!(get_turf(fugitive) in public_floor) && length(spots))
		fugitive.forceMove(spots[1])
	spots -= get_turf(fugitive)

	if(!fugitive.site_bounds)
		fugitive.site_bounds = bounty_outpost_bounds(outpost)
	// Dressed in the zone's clothes by the component, which also gives it the generic name
	fugitive.AddComponent(/datum/component/bounty_outpost_blend, src, FALSE, display_name, display_desc, outfit)
	// Everyone blending in has the same even chance of heading for a bar stool, the fugitive included
	var/list/free_stools = bounty_outpost_free_stools(public_floor)
	fugitive.start_activity(BOUNTY_ACTIVITY_BLEND, (length(free_stools) && prob(50)) ? pick_n_take(free_stools) : null)

	var/feature_count = length(record.features)
	for(var/turf/spot as anything in spots)
		if(length(outpost_decoy_orders) >= BOUNTY_DECOY_COUNT)
			break
		// One or two of its features each, and never all of them (make_decoy_record() holds to that too)
		var/shared = rand(1, 2)
		if(feature_count)
			shared = clamp(shared, 1, max(1, feature_count - 1))
		outpost_decoy_shares += shared
		var/datum/bounty_record/decoy_record = make_decoy_record(record, shared)
		// If a line ever names a crime, it names the same one for everybody
		if(decoy_record)
			decoy_record.crime = record.crime
		var/atom/anchor = (length(free_stools) && prob(50)) ? pick_n_take(free_stools) : null
		var/datum/human_npc_order/order = bounty_outpost_spawn_decoy(fugitive, decoy_record, spot, src, outpost, display_name, display_desc, outfit, anchor, CALLBACK(src, PROC_REF(outpost_decoy_built)), immediate)
		outpost_decoy_orders += order

	RegisterSignal(src, COMSIG_BOUNTY_POSTING_CLOSED, PROC_REF(outpost_on_closed), override = TRUE)
	log_game("BOUNTY: [record.name] is blending in at [outpost] as a [display_name], with [length(outpost_decoy_orders)] decoys on the way.")
	return TRUE

/// One of this posting's decoys has been built and made a look-alike: it is the posting's from now on
/datum/criminal_bounty/proc/outpost_decoy_built(mob/living/carbon/human/npc/bounty_criminal/decoy/decoy)
	if(!QDELETED(decoy))
		decoys += WEAKREF(decoy)

/**
 * Raises the fugitive's alert for `reason` (BOUNTY_ALERT_*): a wrong warrant, or a hit on a decoy,
 * whoever did it. At BOUNTY_OUTPOST_ALERT_SLIP a fugitive still blending in slips away: it walks
 * out to the hangar with its decoys, and the bounty relists at another trader outpost (P5's
 * relist()). Returns TRUE if the alert went up.
 */
/datum/criminal_bounty/proc/raise_alert(reason)
	if(status != BOUNTY_POSTING_OPEN || placement_kind != BOUNTY_PLACEMENT_TRADER_OUTPOST)
		return FALSE
	alert++
	log_game("BOUNTY: [record?.name]'s alert rose to [alert] after [reason].")
	if(alert >= BOUNTY_OUTPOST_ALERT_SLIP)
		outpost_slip_away()
	return TRUE

/**
 * The fugitive has noticed too much fuss: while it is still blending in and free, the decoys leave
 * and it walks out to the hangar lift for real (bounty_outpost_walk_out()). The bounty relists at
 * another trader outpost once it has gone (outpost_fugitive_left()); until then it is still this
 * posting's, so a fugitive downed or cuffed on the way is as good a catch as any. An exposed
 * fugitive is already running or fighting and stays. Returns TRUE if it set off.
 */
/datum/criminal_bounty/proc/outpost_slip_away()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = criminal()
	if(!fugitive || !fugitive.blended || fugitive.capture_state() != BOUNTY_STATE_FREE)
		return FALSE
	var/datum/component/bounty_outpost_blend/blend = fugitive.GetComponent(/datum/component/bounty_outpost_blend)
	if(blend?.leaving)
		return FALSE
	var/obj/structure/overmap/trader_outpost/outpost = outpost_site?.resolve() || site_ref?.resolve()
	var/where = outpost ? format_text(outpost.name) : "the outpost"
	log_game("BOUNTY: [record?.name] is slipping away from [where].")
	outpost_dismiss_decoys()
	// P5 shows the reason as "WANTED: <name> <reason>."
	return bounty_outpost_walk_out(fugitive, outpost, CALLBACK(src, PROC_REF(outpost_fugitive_left), "slipped away from [where]"))

/**
 * The slipping fugitive reached the lift (or went where no player could see): the bounty relists.
 * Its body goes with it, so the posting lets go of it first and its going is not read as a loss.
 * Nothing happens if it stopped being the posting's meanwhile (the posting closed or relisted).
 */
/datum/criminal_bounty/proc/outpost_fugitive_left(reason, mob/living/carbon/human/npc/bounty_criminal/leaver)
	if(!is_open() || board_relisting || QDELETED(leaver) || criminal() != leaver)
		return
	board_detach_criminal()
	leaver.posting_ref = null
	log_game("BOUNTY: [record?.name] slipped away.")
	relist(reason)

/**
 * The decoys not built yet are cancelled and the built ones set walking out, and the posting forgets
 * them all. The walk itself starts asynchronously: closing a posting must not wait on anyone's AI.
 */
/datum/criminal_bounty/proc/outpost_dismiss_decoys()
	var/list/leaving = outpost_forget_decoys()
	if(length(leaving))
		INVOKE_ASYNC(GLOBAL_PROC, GLOBAL_PROC_REF(bounty_outpost_walk_out_all), leaving, outpost_site?.resolve())

/// Cancels the decoys still waiting to be built and lets go of the built ones. Returns the built ones, living or dead.
/datum/criminal_bounty/proc/outpost_forget_decoys()
	for(var/datum/human_npc_order/order as anything in outpost_decoy_orders)
		qdel(order)
	outpost_decoy_orders.Cut()
	. = list()
	for(var/datum/weakref/decoy_ref as anything in decoys)
		var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoy_ref?.resolve()
		if(!QDELETED(decoy))
			. += decoy
	decoys.Cut()

/**
 * Everyone this posting put at its trader outpost leaves: the decoys, and the fugitive if it is
 * still at the outpost. The posting lets go of them first, so closing or relisting it never
 * deletes them mid-walk, and the fugitive's own link to the posting is cut, so its body going away
 * is not read as a death. A fugitive already taken off the outpost (on a ship, say) stays with the
 * posting for P5 to deal with.
 */
/datum/criminal_bounty/proc/outpost_release_site()
	var/obj/structure/overmap/trader_outpost/outpost = outpost_site?.resolve()
	var/list/leaving = outpost_forget_decoys()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = criminal()
	if(fugitive && outpost && get_trader_outpost_for_turf(get_turf(fugitive)) == outpost)
		// P5's own detach, so its deletion watch comes off too and the walk isn't read as a loss
		board_detach_criminal()
		fugitive.posting_ref = null
		leaving += fugitive
	if(length(leaving))
		INVOKE_ASYNC(GLOBAL_PROC, GLOBAL_PROC_REF(bounty_outpost_walk_out_all), leaving, outpost)

/// The posting closed (P5's close()): the decoys and an uncaught fugitive walk out
/datum/criminal_bounty/proc/outpost_on_closed(datum/source, reason, obj/structure/overmap/ship/winner)
	SIGNAL_HANDLER
	UnregisterSignal(src, COMSIG_BOUNTY_POSTING_CLOSED)
	outpost_release_site()

/**
 * Whether `outpost` can take another fugitive (AR-C9): fewer than BOUNTY_MAX_FUGITIVES_PER_OUTPOST open
 * postings set up to blend in there, not counting `except`. A posting refused at setup (a
 * mini-boss, say) never counts. P5 asks before it places a bounty at a trader outpost.
 */
/proc/bounty_outpost_has_room(obj/structure/overmap/trader_outpost/outpost, datum/criminal_bounty/except)
	var/count = 0
	for(var/datum/criminal_bounty/posting as anything in GLOB.criminal_bounties)
		if(QDELETED(posting) || posting == except || posting.status != BOUNTY_POSTING_OPEN)
			continue
		if(posting.placement_kind != BOUNTY_PLACEMENT_TRADER_OUTPOST || posting.site_ref?.resolve() != outpost)
			continue
		if(posting.outpost_site?.resolve() != outpost)
			continue
		count++
	return count < BOUNTY_MAX_FUGITIVES_PER_OUTPOST

/// The concourse as a leash, list(min_x, min_y, max_x, max_y, z) (the shape of site_bounds)
/proc/bounty_outpost_bounds(obj/structure/overmap/trader_outpost/outpost)
	var/turf/bottom_left = outpost?.template_bottom_left
	if(!bottom_left || !outpost.outpost_template)
		return null
	return list(
		bottom_left.x,
		bottom_left.y,
		bottom_left.x + outpost.outpost_template.width - 1,
		bottom_left.y + outpost.outpost_template.height - 1,
		bottom_left.z,
	)

/**
 * THE spawn picker for anyone blending in at `outpost` (P5 places its fugitive with it, P6 its
 * decoys): up to `count` different free tiles of the public concourse floor
 * (bounty_outpost_public_floor(): never behind glass, a counter or a staff door, never on the hangar
 * lift), out of every player's view, so nobody watches a patron appear (AR-C10). When too few are
 * out of view, the rest are the free tiles nearest the lift, as if they had just come up from the
 * hangar. Never the tile `near` stands on, if given. Doesn't sleep. P5 calls it as
 * bounty_outpost_spawn_spots(outpost, 1, null).
 */
/proc/bounty_outpost_spawn_spots(obj/structure/overmap/trader_outpost/outpost, count = 1, atom/near)
	var/list/bounds = bounty_outpost_bounds(outpost)
	if(!bounds || count <= 0)
		return list()
	var/list/floor = bounty_outpost_public_floor(outpost)
	floor -= outpost.lobby_alcove_turfs
	// Nobody blends in at the checkpoint (outpost_checkpoint.dm): the hunt is past it
	for(var/turf/checkpoint_tile as anything in floor.Copy())
		if(istype(checkpoint_tile.loc, /area/voidcrew/trader_outpost/checkpoint))
			floor -= checkpoint_tile
	var/turf/near_turf = get_turf(near)
	if(near_turf)
		floor -= near_turf
	var/list/watched = list()
	for(var/mob/player as anything in GLOB.player_list)
		var/turf/player_turf = get_turf(player)
		if(!player_turf || player_turf.z != bounds[5])
			continue
		for(var/turf/seen in view(world.view, player))
			watched[seen] = TRUE
	var/list/unseen = list()
	var/list/seen = list()
	for(var/turf/candidate as anything in floor)
		if(candidate.is_blocked_turf(exclude_mobs = FALSE))
			continue
		if(watched[candidate])
			seen += candidate
		else
			unseen += candidate
	var/list/spots = list()
	while(length(spots) < count && length(unseen))
		spots += pick_n_take(unseen)
	// The floor is in reach order from the lift, so the first seen tiles are the ones by the lift
	for(var/turf/arriving as anything in seen)
		if(length(spots) >= count)
			break
		spots += arriving
	return spots

/// The one spawn tile P5 asks for: bounty_outpost_spawn_spots() with a count of one, or null
/proc/bounty_outpost_spawn_spot(obj/structure/overmap/trader_outpost/outpost)
	var/list/spots = bounty_outpost_spawn_spots(outpost, 1)
	return length(spots) ? spots[1] : null

/// The bar stools on `floor` nobody is sitting on
/proc/bounty_outpost_free_stools(list/floor)
	. = list()
	for(var/turf/spot as anything in floor)
		for(var/obj/structure/chair/stool/bar/stool in spot)
			if(!stool.has_buckled_mobs() && !(locate(/mob/living) in spot))
				. += stool

/**
 * The concourse floor customers can walk, in reach order from the hangar lift: every open tile
 * reachable from the lift's alcove without climbing a counter or passing a door that wants an ID.
 * An outpost with no lift (a broken load) starts from `fallback_seeds` instead.
 */
/proc/bounty_outpost_public_floor(obj/structure/overmap/trader_outpost/outpost, list/fallback_seeds)
	var/list/bounds = bounty_outpost_bounds(outpost)
	if(!bounds)
		return list()
	var/list/seeds = length(outpost.lobby_alcove_turfs) ? outpost.lobby_alcove_turfs : fallback_seeds
	var/list/reached = list()
	var/list/floor = list()
	for(var/turf/seed as anything in seeds)
		if(!reached[seed] && bounty_outpost_turf_in_bounds(seed, bounds))
			reached[seed] = TRUE
			floor += seed
	// A customer on foot with no ID: the pathfinder's own step check, so railings block only across
	// their edge, counters and glass block, and a door that wants an ID is a wall.
	var/datum/can_pass_info/customer = new(null, list())
	customer.is_living = TRUE
	customer.mob_size = MOB_SIZE_HUMAN
	var/index = 1
	while(index <= length(floor))
		var/turf/current = floor[index++]
		for(var/direction in GLOB.cardinals)
			var/turf/next = get_step(current, direction)
			if(!next || reached[next] || !bounty_outpost_turf_in_bounds(next, bounds))
				continue
			if(!isopenturf(next) || isspaceturf(next) || next.density)
				reached[next] = TRUE
				continue
			var/area/place = next.loc
			if(istype(place, /area/space) || istype(place, /area/template_noop))
				reached[next] = TRUE
				continue
			// Blocked from this side only: another side may still reach it (a railing's open end)
			if(current.LinkBlockedWithAccess(next, customer))
				continue
			reached[next] = TRUE
			floor += next
	return floor

/// Whether `spot` is inside `bounds` (the shape bounty_outpost_bounds() returns)
/proc/bounty_outpost_turf_in_bounds(turf/spot, list/bounds)
	return spot && spot.z == bounds[5] && spot.x >= bounds[1] && spot.x <= bounds[3] && spot.y >= bounds[2] && spot.y <= bounds[4]

// =========================================================================
// CONFRONTING
// =========================================================================

/// Who a warrant cooldown belongs to: the user's ship, or the user without one
/proc/bounty_outpost_hunter_key(mob/living/user)
	return get_crew_ship(user) || user?.mind || user

/// Seconds until `user`'s ship may show a warrant for this posting again (0: now)
/datum/criminal_bounty/proc/outpost_warrant_wait(mob/living/user)
	var/ready_at = outpost_warrant_ready_at[REF(bounty_outpost_hunter_key(user))]
	return ready_at ? max(0, ready_at - world.time) : 0

/// Starts `user`'s ship's warrant cooldown
/datum/criminal_bounty/proc/outpost_start_warrant_cooldown(mob/living/user)
	outpost_warrant_ready_at[REF(bounty_outpost_hunter_key(user))] = world.time + BOUNTY_WARRANT_COOLDOWN

/**
 * `user` showed this posting's warrant to its fugitive: it stops blending in, remembers who, and
 * reacts as its kind does (P3's on_confronted(): a meek one bolts, a normal one fights).
 */
/datum/criminal_bounty/proc/outpost_confront(mob/living/carbon/human/npc/bounty_criminal/fugitive, mob/living/user)
	fugitive.body_add_grudge(user)
	var/datum/component/bounty_outpost_blend/blend = fugitive.GetComponent(/datum/component/bounty_outpost_blend)
	blend?.stop_blending()
	fugitive.blended = FALSE
	log_game("BOUNTY: [key_name(user)] confronted [record?.name] with the warrant at [AREACOORD(fugitive)].")
	// A clear yes, as the wrong warrant gets a clear no
	to_chat(user, span_notice("That's them."))
	fugitive.on_confronted(user)
	fugitive.bounty_say("accused_rightly")
	outpost_trader_reacts(fugitive)

/**
 * The room notices an exposed fugitive: the nearest trader who can see them, within
 * BOUNTY_OUTPOST_REACT_RANGE, calls out. Returns the trader, or null.
 */
/datum/criminal_bounty/proc/outpost_trader_reacts(mob/living/carbon/human/npc/bounty_criminal/fugitive)
	var/mob/living/carbon/human/npc/ambient_npc/outpost/trader/nearest
	var/nearest_distance = INFINITY
	for(var/mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader in view(BOUNTY_OUTPOST_REACT_RANGE, fugitive))
		if(trader.stat != CONSCIOUS)
			continue
		var/distance = get_dist(trader, fugitive)
		if(distance < nearest_distance)
			nearest = trader
			nearest_distance = distance
	if(nearest)
		INVOKE_ASYNC(nearest, TYPE_PROC_REF(/atom/movable, say), pick(GLOB.bounty_outpost_trader_react_lines))
	return nearest

/**
 * `user` showed this posting's warrant to the wrong person, `target`: they protest and show their
 * papers. At this posting's trader outpost, it raises the alert.
 */
/datum/criminal_bounty/proc/outpost_wrong_accusation(mob/living/carbon/human/npc/bounty_criminal/target, mob/living/user)
	target.outpost_protest(user)
	to_chat(user, span_notice("Their papers are in order. Not who you're after."))
	var/obj/structure/overmap/trader_outpost/outpost = outpost_site?.resolve()
	if(!outpost || get_trader_outpost_for_turf(get_turf(target)) != outpost)
		return
	log_game("BOUNTY: [key_name(user)] showed [record?.name]'s warrant to the wrong person at [AREACOORD(target)].")
	if(raise_alert(BOUNTY_ALERT_WRONG_WARRANT) && alert < BOUNTY_OUTPOST_ALERT_SLIP && status == BOUNTY_POSTING_OPEN)
		to_chat(user, span_warning("Heads turn your way."))

/**
 * Someone showed them a warrant that isn't theirs: they protest, and show a docking pass that
 * checks out. Nothing else happens to them.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/outpost_protest(mob/user)
	if(stat != CONSCIOUS)
		return
	// Forced: a protest always comes out, whatever was said a moment ago (P1's third argument)
	if(!bounty_say("accused_wrongly", null, TRUE))
		say(pick(GLOB.bounty_decoy_protest_lines), forced = "bounty protest")
	if(user)
		visible_message(span_notice("[src] holds up a docking pass for [user] to read."), vision_distance = COMBAT_MESSAGE_RANGE)

// =========================================================================
// DECOYS
// =========================================================================

// Built-in values, P6's. A decoy is a person like the fugitive: the same species, build and face but
// for the features it was made not to share, the zone's clothes, the fugitive's bag and belt
// (outpost_match_kit()), and its toughness and pace (body_match()). It carries no weapon and never fights.
/mob/living/carbon/human/npc/bounty_criminal/decoy
	name = "patron"
	desc = "Another customer passing through."
	/// Its fixed toughness is its fugitive's (body_match()), never its own record's tier
	body_tier_toughness = FALSE
	/// Nobody's posting cleans a dead decoy up: the corpse sweep does
	npc_corpse_lifetime = HUMAN_NPC_CORPSE_LIFETIME
	/// Barks when hit are rate-limited on their own, beside bounty_say()'s cooldown
	COOLDOWN_DECLARE(outpost_bark_cooldown)

/**
 * A decoy made any other way than bounty_outpost_spawn_decoy() still dresses as a customer of the zone
 * it was made in, never as a criminal: no gun, no armour.
 */
/mob/living/carbon/human/npc/bounty_criminal/decoy/bounty_build_outfit(zone)
	switch(zone)
		if(ZONE_YELLOW)
			return /datum/outfit/bounty_outpost_dockhand
		if(ZONE_RED)
			return /datum/outfit/bounty_outpost_spacer
	return /datum/outfit/bounty_outpost_patron

/**
 * Builds a decoy for `fugitive` at `spot`: a human NPC with `decoy_record`'s face in the zone's
 * `outfit` and generic name, in its fugitive's faction, in the spawn queue (SShuman_npcs) unless
 * `immediate`. Once built it is made a look-alike (outpost_become()) and `on_built` is called with it.
 * Returns the order; qdel() it to cancel a decoy not built yet. A decoy built for a posting that has
 * closed, moved on or lost its fugitive in the meantime is deleted unseen.
 */
/proc/bounty_outpost_spawn_decoy(mob/living/carbon/human/npc/bounty_criminal/fugitive, datum/bounty_record/decoy_record, turf/spot, datum/criminal_bounty/posting, obj/structure/overmap/trader_outpost/outpost, display_name, display_desc, outfit, atom/anchor, datum/callback/on_built, immediate = FALSE)
	var/datum/npc_spawn_context/context = new(outpost || spot, null, "ordinary", source_turf = get_turf(outpost || spot))
	var/datum/callback/finish = CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(bounty_outpost_finish_decoy), WEAKREF(fugitive), decoy_record, posting ? WEAKREF(posting) : null, outpost ? WEAKREF(outpost) : null, display_name, display_desc, outfit, anchor ? WEAKREF(anchor) : null, on_built)
	return spawn_human_npc(/mob/living/carbon/human/npc/bounty_criminal/decoy, spot, finish, look = decoy_record, outfit = outfit, name = display_name, faction = fugitive?.faction, context = context, immediate = immediate)

/// A decoy has just been built (bounty_outpost_spawn_decoy()): checks it is still wanted, then makes it a look-alike
/proc/bounty_outpost_finish_decoy(datum/weakref/fugitive_ref, datum/bounty_record/decoy_record, datum/weakref/posting_ref, datum/weakref/outpost_ref, display_name, display_desc, outfit, datum/weakref/anchor_ref, datum/callback/on_built, mob/living/carbon/human/npc/bounty_criminal/decoy/decoy)
	if(QDELETED(decoy))
		return
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = fugitive_ref?.resolve()
	var/datum/criminal_bounty/posting = posting_ref?.resolve()
	var/obj/structure/overmap/trader_outpost/outpost = outpost_ref?.resolve()
	if(QDELETED(fugitive) || (posting_ref && (QDELETED(posting) || !posting.is_open() || posting.outpost_site?.resolve() != outpost)))
		qdel(decoy)
		return
	decoy.outpost_become(fugitive, decoy_record, posting, outpost, display_name, display_desc, outfit, anchor_ref?.resolve())
	on_built?.Invoke(decoy)

/**
 * Makes this decoy, already built in the zone's clothes with its record's face, a look-alike of
 * `fugitive` wanted on `posting` at `outpost`: the fugitive's toughness and pace (body_match()), the
 * zone's generic name and description, blending in like the fugitive and doing what it does (at
 * `anchor`, a bar stool, or nothing). The decoy is NOT linked to the posting through posting_ref: it
 * is not the criminal, and nothing the pad, the proof of death or the board does may treat it as
 * one. `outfit` is the zone's clothes: a decoy built another way has its own put right.
 */
/mob/living/carbon/human/npc/bounty_criminal/decoy/proc/outpost_become(mob/living/carbon/human/npc/bounty_criminal/fugitive, datum/bounty_record/decoy_record, datum/criminal_bounty/posting, obj/structure/overmap/trader_outpost/outpost, display_name, display_desc, outfit, atom/anchor)
	record = decoy_record
	body_set_site(outpost)
	// The concourse itself, whatever the site gave it
	var/list/bounds = bounty_outpost_bounds(outpost)
	if(bounds)
		site_bounds = bounds
	body_match(fugitive)
	outpost_match_kit(fugitive)
	AddComponent(/datum/component/bounty_outpost_blend, posting, TRUE, display_name, display_desc, outfit)
	start_activity(BOUNTY_ACTIVITY_BLEND, anchor)

/**
 * Wears the same bag and belt as `fugitive` (a meek criminal's fanny pack, a holster, a satchel), which
 * show at a glance and which the patron clothes leave on the fugitive. Each is a new one of its type,
 * emptied: a decoy carries no weapon, so a gun slung on the fugitive's back has no match here. Locked
 * to its body like the rest of its kit (D3).
 */
/mob/living/carbon/human/npc/bounty_criminal/decoy/proc/outpost_match_kit(mob/living/carbon/human/npc/bounty_criminal/fugitive)
	if(QDELETED(fugitive))
		return
	for(var/slot in list(ITEM_SLOT_BACK, ITEM_SLOT_BELT))
		var/obj/item/theirs = fugitive.get_item_by_slot(slot)
		var/obj/item/mine = get_item_by_slot(slot)
		if(mine?.type == theirs?.type)
			continue
		if(mine)
			temporarilyRemoveItemFromInventory(mine, force = TRUE)
			qdel(mine)
		if(!istype(theirs, /obj/item/storage))
			continue
		var/obj/item/storage/copy = new theirs.type(src)
		for(var/atom/movable/inside as anything in copy.contents)
			qdel(inside)
		if(equip_to_slot_or_del(copy, slot, initial = TRUE))
			npc_lock_item(copy)

/// A decoy never fights anyone (P2's gate on attacks)
/mob/living/carbon/human/npc/bounty_criminal/decoy/may_attack(atom/target)
	return FALSE

/**
 * Confronting a decoy, whoever does it (a wrong warrant, any other package): a wrong accusation,
 * with its cost. It protests, and at its outpost the posting's alert rises (C1).
 */
/mob/living/carbon/human/npc/bounty_criminal/decoy/on_confronted(mob/user)
	var/datum/component/bounty_outpost_blend/blend = GetComponent(/datum/component/bounty_outpost_blend)
	var/datum/criminal_bounty/posting = blend?.posting_ref?.resolve()
	if(blend?.leaving || QDELETED(posting) || !isliving(user) || !user.mind)
		outpost_protest(user)
		return
	posting.outpost_wrong_accusation(src, user)

/// Someone hit it on purpose: a bark, then it backs off from them for a few seconds (not while it is walking out)
/mob/living/carbon/human/npc/bounty_criminal/decoy/proc/outpost_react_to_hit(mob/living/attacker)
	if(stat != CONSCIOUS || is_downed() || is_restrained())
		return
	if(COOLDOWN_FINISHED(src, outpost_bark_cooldown))
		COOLDOWN_START(src, outpost_bark_cooldown, 8 SECONDS)
		if(!bounty_say("hurt"))
			say(pick(GLOB.bounty_decoy_hurt_lines), forced = "bounty decoy")
	var/datum/component/bounty_outpost_blend/blend = GetComponent(/datum/component/bounty_outpost_blend)
	if(blend?.leaving || QDELETED(attacker) || !isturf(loc) || HAS_TRAIT(src, TRAIT_IMMOBILIZED))
		return
	GLOB.move_manager.move_away(src, attacker, BOUNTY_DECOY_FLEE_DISTANCE, max(cached_multiplicative_slowdown, 1), BOUNTY_DECOY_FLEE_TIME, priority = MOVEMENT_ABOVE_SPACE_PRIORITY)

// =========================================================================
// BLENDING IN
// =========================================================================

/**
 * # Blending in at a trader outpost
 *
 * On the fugitive and on each decoy, so the two behave the same way (AR-C6, C7, C8):
 * - the zone's generic name and description (set once, and kept);
 * - the fugitive wears the zone's clothes (redress()); a decoy is built in them;
 * - the outpost's turrets leave them alone;
 * - they never step onto the hangar lift by themselves;
 * - a deliberate hit by a person counts: on a decoy it raises the alert and is an outpost strike,
 *   on the fugitive it ends the act. So does a reach for their wrists with cuffs.
 *
 * Nothing else is special about them: a hand on them, a shot, a shove or a thrown bottle goes through
 * tg like it would for anyone, and they answer it the way their AI does. A shot hits whoever it hits;
 * only one aimed at them counts as a deliberate hit.
 *
 * The fugitive stops blending in when exposed (the warrant, or a hit); a decoy never does. The
 * component stays on an exposed fugitive for the rest of its time at the outpost: if it hurts a
 * bystander there, the turrets are let loose on it (AR-C8).
 */
/datum/component/bounty_outpost_blend
	/// The posting they are part of, as a weakref (/datum/criminal_bounty)
	var/datum/weakref/posting_ref
	/// The trader outpost they are at, as a weakref, for its hangar lift
	var/datum/weakref/outpost_ref
	/// A decoy, not the fugitive
	var/decoy = FALSE
	/// Still blending in
	var/blending = TRUE
	/// Walking out to the hangar (bounty_outpost_walk_out()): hits and warrants no longer count
	var/leaving = FALSE
	/// The zone's clothes they wear while blending in
	var/outfit
	/// Whether blending in added FACTION_TURRET
	var/added_turret_faction = FALSE
	/// Exposed, the fugitive hurt someone not on its grudge list here: the turrets' leave to fight it is over (AR-C8)
	var/hurt_bystander = FALSE
	/// Blows closer together than BOUNTY_OUTPOST_HIT_GRACE are one scuffle
	COOLDOWN_DECLARE(hit_grace)

/datum/component/bounty_outpost_blend/Initialize(datum/criminal_bounty/posting, decoy = FALSE, display_name, display_desc, outfit)
	if(!istype(parent, /mob/living/carbon/human/npc/bounty_criminal))
		return COMPONENT_INCOMPATIBLE
	posting_ref = posting ? WEAKREF(posting) : null
	var/atom/outpost = posting?.outpost_site?.resolve() || posting?.site_ref?.resolve()
	outpost_ref = outpost ? WEAKREF(outpost) : null
	src.decoy = decoy
	src.outfit = outfit
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	owner.blended = TRUE
	if(display_name)
		owner.name = display_name
		owner.real_name = display_name
		owner.dna?.real_name = display_name
	if(display_desc)
		owner.desc = display_desc
	ADD_TRAIT(owner, TRAIT_NO_CONTAINMENT, BOUNTY_OUTPOST_TRAIT)
	ADD_TRAIT(owner, TRAIT_NO_STORAGE_INSERT, BOUNTY_OUTPOST_TRAIT)
	// Belt and braces beside P2's turret rule for criminals: turrets skip faction-mates before
	// anything else, so a patron minding their own business is never a target.
	if(!(FACTION_TURRET in owner.faction))
		var/list/new_faction = LAZYCOPY(owner.faction)
		new_faction += FACTION_TURRET
		owner.faction = new_faction
		added_turret_faction = TRUE
	// A decoy was built in the zone's clothes already, which changes nothing; the fugitive was dressed as the criminal it is
	if(outfit)
		redress()

/datum/component/bounty_outpost_blend/Destroy(force)
	stop_blending()
	return ..()

/datum/component/bounty_outpost_blend/RegisterWithParent()
	RegisterSignal(parent, COMSIG_MOVABLE_PRE_MOVE, PROC_REF(on_pre_move))
	RegisterSignal(parent, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_projectile_prehit))
	RegisterSignal(parent, COMSIG_BOUNTY_CUFF_REACHED, PROC_REF(on_cuff_reached))
	RegisterSignal(parent, COMSIG_ATOM_AFTER_ATTACKEDBY, PROC_REF(on_item_attack))
	RegisterSignal(parent, COMSIG_ATOM_ATTACK_HAND, PROC_REF(on_hand_attack))
	RegisterSignal(parent, COMSIG_ATOM_ATTACK_HAND_SECONDARY, PROC_REF(on_shoved))
	RegisterSignal(parent, COMSIG_MOB_BATONED, PROC_REF(on_batoned))
	RegisterSignal(parent, COMSIG_ATOM_HULK_ATTACK, PROC_REF(on_hulk_attack))
	RegisterSignal(parent, COMSIG_ATOM_ATTACK_MECH, PROC_REF(on_mech_attack))
	RegisterSignal(parent, COMSIG_ATOM_PREHITBY, PROC_REF(on_thrown_hit))
	RegisterSignals(parent, list(COMSIG_ATOM_ATTACK_BASIC_MOB, COMSIG_ATOM_ATTACK_ANIMAL), PROC_REF(on_creature_attack))
	RegisterSignal(parent, COMSIG_PROJECTILE_FIRER_BEFORE_FIRE, PROC_REF(on_firing))
	RegisterSignals(parent, list(COMSIG_MOB_ITEM_ATTACK, COMSIG_LIVING_UNARMED_ATTACK), PROC_REF(on_own_melee_attack))

/datum/component/bounty_outpost_blend/UnregisterFromParent()
	UnregisterSignal(parent, list(
		COMSIG_MOVABLE_PRE_MOVE,
		COMSIG_PROJECTILE_PREHIT,
		COMSIG_BOUNTY_CUFF_REACHED,
		COMSIG_ATOM_AFTER_ATTACKEDBY,
		COMSIG_ATOM_ATTACK_HAND,
		COMSIG_ATOM_ATTACK_HAND_SECONDARY,
		COMSIG_MOB_BATONED,
		COMSIG_ATOM_HULK_ATTACK,
		COMSIG_ATOM_ATTACK_MECH,
		COMSIG_ATOM_PREHITBY,
		COMSIG_ATOM_ATTACK_BASIC_MOB,
		COMSIG_ATOM_ATTACK_ANIMAL,
		COMSIG_PROJECTILE_FIRER_BEFORE_FIRE,
		COMSIG_MOB_ITEM_ATTACK,
		COMSIG_LIVING_UNARMED_ATTACK,
	))

/**
 * Changes the fugitive into the zone's clothes while it blends in. It was dressed as the criminal it
 * is; decoys are built in the zone's, so the two must end up looking the same. See
 * outpost_wear_patron_clothes().
 */
/datum/component/bounty_outpost_blend/proc/redress()
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	if(!blending || leaving || !outfit || QDELETED(owner))
		return
	owner.outpost_wear_patron_clothes(outfit)

/**
 * Changes into `outfit_type`'s clothes: the uniform, the coat, the gloves and the shoes it names, and
 * nothing on the head or the face (the zone's patrons wear no hats: hair is a clue). What it wore
 * there is taken away and deleted. Everything else it carries stays where it is, pockets and belt
 * included. The new clothes are locked to the body like the rest of its kit (D3).
 * What its species can't live without stays on (a plasmaman's envirosuit, helmet and gloves, its
 * species' outfit_important_for_life): its decoys, of its species, are dressed over the same.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/outpost_wear_patron_clothes(outfit_type)
	var/datum/outfit/patron = new outfit_type()
	var/list/swaps = list(
		list(w_uniform, patron.uniform, ITEM_SLOT_ICLOTHING),
		list(wear_suit, patron.suit, ITEM_SLOT_OCLOTHING),
		list(gloves, patron.gloves, ITEM_SLOT_GLOVES),
		list(shoes, patron.shoes, ITEM_SLOT_FEET),
		list(head, patron.head, ITEM_SLOT_HEAD),
		list(wear_mask, patron.mask, ITEM_SLOT_MASK),
	)
	qdel(patron)
	var/datum/outfit/life = dna?.species?.outfit_important_for_life
	for(var/list/swap as anything in swaps)
		var/obj/item/worn = swap[1]
		var/new_type = swap[2]
		if(worn && ispath(new_type) && worn.type == new_type)
			continue
		if(bounty_outpost_kept_for_life(worn, life, swap[3]))
			continue
		if(worn)
			// idrop off: the pockets, belt and suit storage are meant to stay when the clothes over them are swapped
			temporarilyRemoveItemFromInventory(worn, force = TRUE, idrop = FALSE)
			qdel(worn)
		if(!ispath(new_type))
			continue
		var/obj/item/clothes = new new_type(src)
		equip_to_slot_or_del(clothes, swap[3], initial = TRUE)
		npc_lock_item(clothes)

/// Whether `worn`, in `slot`, is what `life` (a species' outfit_important_for_life) puts there: kept on when blending in
/proc/bounty_outpost_kept_for_life(obj/item/worn, datum/outfit/life, slot)
	if(isnull(worn) || !ispath(life, /datum/outfit))
		return FALSE
	var/life_type
	switch(slot)
		if(ITEM_SLOT_ICLOTHING)
			life_type = initial(life.uniform)
		if(ITEM_SLOT_OCLOTHING)
			life_type = initial(life.suit)
		if(ITEM_SLOT_GLOVES)
			life_type = initial(life.gloves)
		if(ITEM_SLOT_FEET)
			life_type = initial(life.shoes)
		if(ITEM_SLOT_HEAD)
			life_type = initial(life.head)
		if(ITEM_SLOT_MASK)
			life_type = initial(life.mask)
	return ispath(life_type) && istype(worn, life_type)

/// Ends the act: containable again, and no longer in the turrets' faction. The name stays.
/datum/component/bounty_outpost_blend/proc/stop_blending()
	if(!blending)
		return
	blending = FALSE
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	if(QDELETED(owner))
		return
	owner.blended = FALSE
	// Out of the act, the coat over its chrome comes off and the chrome shows (C0, bounty_chrome.dm). Decoys never drop the act.
	if(!decoy && !leaving)
		bounty_chrome_bare(owner)
	REMOVE_TRAIT(owner, TRAIT_NO_CONTAINMENT, BOUNTY_OUTPOST_TRAIT)
	REMOVE_TRAIT(owner, TRAIT_NO_STORAGE_INSERT, BOUNTY_OUTPOST_TRAIT)
	if(added_turret_faction)
		var/list/new_faction = LAZYCOPY(owner.faction)
		new_faction -= FACTION_TURRET
		owner.faction = new_faction
		added_turret_faction = FALSE

/**
 * They never step onto the hangar lift by themselves: the lift carries everyone standing on it, and
 * a patron riding it down would leave the outpost. Dragged or thrown, they go where they are taken
 * (hunters bring a caught fugitive home that way); walking out, they head for the lift on purpose.
 */
/datum/component/bounty_outpost_blend/proc/on_pre_move(atom/movable/source, atom/new_loc)
	SIGNAL_HANDLER
	var/mob/living/owner = parent
	if(leaving || owner.pulledby || owner.throwing || owner.buckled || !isturf(new_loc))
		return NONE
	var/obj/structure/overmap/trader_outpost/outpost = outpost_ref?.resolve()
	if(outpost && (new_loc in outpost.lobby_alcove_turfs))
		return COMPONENT_MOVABLE_BLOCK_PRE_MOVE
	return NONE

/**
 * A shot hits whoever it hits. One aimed at someone blending in is a deliberate hit by whoever fired
 * it; a stray one that lands on them is not (nobody is framed with it).
 */
/datum/component/bounty_outpost_blend/proc/on_projectile_prehit(datum/source, obj/projectile/projectile)
	SIGNAL_HANDLER
	if(projectile.original == parent && projectile.is_hostile_projectile() && isliving(projectile.firer))
		deliberate_hit(projectile.firer)
	return NONE

/**
 * Someone is putting restraints on them (COMSIG_BOUNTY_CUFF_REACHED, from the criminal body before its
 * own reaction), exactly the cost of a punch (C1):
 * - A decoy's wrists are an outpost strike and the alert, and it backs away (which breaks the cuffer's
 *   try). Handled here, so it isn't also taken for a wrong warrant.
 * - The fugitive's end its act. The body's own reaction then steps it away and runs or fights, as for
 *   anyone who is reached for while free.
 * Down, stunned or held, they can't do anything about it: the cuffs go on. Nobody without a mind
 * counts. Walking out, the fugitive just takes it like any other free criminal; a decoy's wrists are
 * still the hitter's strike (handle_hit()).
 */
/datum/component/bounty_outpost_blend/proc/on_cuff_reached(datum/source, mob/living/user)
	SIGNAL_HANDLER
	if(!isliving(user) || !user.mind)
		return NONE
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	if(decoy)
		deliberate_hit(user)
		return owner.body_can_answer_cuffs() ? COMPONENT_BOUNTY_CUFF_HANDLED : NONE
	if(!blending || leaving)
		return NONE
	owner.body_add_grudge(user)
	stop_blending()
	return NONE

/datum/component/bounty_outpost_blend/proc/on_item_attack(datum/source, obj/item/weapon, mob/living/attacker, list/modifiers, list/attack_modifiers)
	SIGNAL_HANDLER
	if(weapon?.force)
		deliberate_hit(attacker)

/datum/component/bounty_outpost_blend/proc/on_hand_attack(datum/source, mob/living/user, list/modifiers)
	SIGNAL_HANDLER
	if(isliving(user) && (user.combat_mode || LAZYACCESS(modifiers, RIGHT_CLICK)))
		deliberate_hit(user)

/datum/component/bounty_outpost_blend/proc/on_shoved(datum/source, mob/living/user, list/modifiers)
	SIGNAL_HANDLER
	deliberate_hit(user)

/datum/component/bounty_outpost_blend/proc/on_batoned(datum/source, mob/living/user, obj/item/baton)
	SIGNAL_HANDLER
	deliberate_hit(user)

/datum/component/bounty_outpost_blend/proc/on_hulk_attack(datum/source, mob/living/user)
	SIGNAL_HANDLER
	deliberate_hit(user)

/// A mech's fist is its pilot's
/datum/component/bounty_outpost_blend/proc/on_mech_attack(datum/source, obj/vehicle/sealed/mecha/mecha_attacker, mob/living/pilot)
	SIGNAL_HANDLER
	deliberate_hit(pilot)

/**
 * Something thrown at them on purpose (H1): an item with some heft, thrown at them by a person.
 * One thrown at someone else that lands on them does not count, so nobody can be framed with it.
 */
/datum/component/bounty_outpost_blend/proc/on_thrown_hit(datum/source, atom/movable/thrown, datum/thrownthing/throwingdatum)
	SIGNAL_HANDLER
	if(!isitem(thrown) || !throwingdatum)
		return
	var/obj/item/thrown_item = thrown
	if(!thrown_item.throwforce || throwingdatum.initial_target?.resolve() != parent)
		return
	deliberate_hit(throwingdatum.get_thrower())

/datum/component/bounty_outpost_blend/proc/on_creature_attack(datum/source, mob/living/user)
	SIGNAL_HANDLER
	if(isliving(user) && user.melee_damage_upper > 0)
		deliberate_hit(user)

/// Someone hit them on purpose. Only a person counts: stray shots, stray throws, explosions and NPCs never do.
/datum/component/bounty_outpost_blend/proc/deliberate_hit(mob/living/attacker)
	if(!istype(attacker) || !attacker.mind || attacker == parent)
		return
	INVOKE_ASYNC(src, PROC_REF(handle_hit), attacker)

/**
 * A person hit them on purpose.
 * - The fugitive: the act is over (it remembers who, and reacts as its kind does). Walking out, it
 *   just takes the blow.
 * - A decoy (AR-C5): one outpost strike for the hitter, as for hitting a trader, and the bounty's
 *   alert rises once per scuffle, whoever swung. The decoy barks and backs off. Walking out, the
 *   alert has gone up already, so only the strike and the bark are left.
 */
/datum/component/bounty_outpost_blend/proc/handle_hit(mob/living/attacker)
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	if(QDELETED(owner) || QDELETED(attacker))
		return
	if(!decoy)
		if(!blending || leaving)
			return
		owner.body_add_grudge(attacker)
		stop_blending()
		owner.on_confronted(attacker)
		return
	var/obj/structure/overmap/trader_outpost/outpost = get_trader_outpost_for_turf(get_turf(owner))
	outpost?.register_aggression(attacker, OUTPOST_CRIME_ASSAULT_CIVILIAN, owner)
	if(!leaving && COOLDOWN_FINISHED(src, hit_grace))
		COOLDOWN_START(src, hit_grace, BOUNTY_OUTPOST_HIT_GRACE)
		var/datum/criminal_bounty/posting = posting_ref?.resolve()
		if(posting && !QDELETED(posting))
			log_game("BOUNTY: [key_name(attacker)] hit a decoy of [posting.record?.name] at [AREACOORD(owner)].")
			posting.raise_alert(BOUNTY_ALERT_DECOY_HIT)
	// The alert may have sent everyone out already
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy_mob = owner
	if(istype(decoy_mob))
		decoy_mob.outpost_react_to_hit(attacker)

/// Its own fists, or what it swung, landed on `target`
/datum/component/bounty_outpost_blend/proc/on_own_melee_attack(datum/source, atom/target)
	SIGNAL_HANDLER
	note_victim(target)

/**
 * The fugitive hurt `victim`. At a trader outpost, anyone not on its grudge list is a bystander, and
 * hurting one ends the turrets' leave to let the hunters handle it (AR-C8). P2's may_attack() and
 * its AI's line-of-fire check keep that from happening on purpose; a bullet that hits one anyway
 * lands here too (on_firing()).
 */
/datum/component/bounty_outpost_blend/proc/note_victim(atom/victim)
	if(decoy || !isliving(victim) || victim == parent)
		return
	var/mob/living/carbon/human/npc/bounty_criminal/owner = parent
	if(owner.body_has_grudge(victim) || istype(victim, /mob/living/carbon/human/npc/bounty_criminal) || istype(victim, /mob/living/carbon/human/npc/bounty_companion))
		return
	if(!is_trader_outpost_protected(owner))
		return
	if(!hurt_bystander)
		log_game("BOUNTY: [owner.record?.name] hurt a bystander ([key_name(victim)]) at [AREACOORD(owner)]; the outpost turrets may fire on it now.")
	hurt_bystander = TRUE

/**
 * Whether a trader outpost's turrets may fire on them (AR-C8): only a fugitive, exposed, that has
 * hurt someone who never crossed it. Blending in, or fighting only those who came for it, never.
 * Nor one the hunters already have: dead, in crit, cuffed or stunned (tg's own states). P2's line in
 * is_hostile_creature() asks this for bounty criminals.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/outpost_turret_target()
	if(capture_state() != BOUNTY_STATE_FREE)
		return FALSE
	var/datum/component/bounty_outpost_blend/blend = GetComponent(/datum/component/bounty_outpost_blend)
	return !!blend && !blend.blending && !blend.leaving && blend.hurt_bystander

/// The fugitive fired: a shot of its that hits someone at a trader outpost is judged by who it hit (note_victim())
/datum/component/bounty_outpost_blend/proc/on_firing(datum/source, obj/projectile/projectile, atom/fired_from, atom/original)
	SIGNAL_HANDLER
	if(decoy || !is_trader_outpost_protected(parent))
		return
	RegisterSignal(projectile, COMSIG_PROJECTILE_SELF_ON_HIT, PROC_REF(on_own_projectile_hit))

/datum/component/bounty_outpost_blend/proc/on_own_projectile_hit(obj/projectile/source, atom/movable/firer, atom/target, angle, hit_limb, blocked, pierce_hit)
	SIGNAL_HANDLER
	note_victim(target)

// =========================================================================
// WALKING OUT
// =========================================================================

/// Sends each of `walkers` (human NPCs) out to `outpost`'s hangar lift: bounty_outpost_walk_out()
/proc/bounty_outpost_walk_out_all(list/walkers, obj/structure/overmap/trader_outpost/outpost)
	for(var/mob/living/carbon/human/npc/walker as anything in walkers)
		bounty_outpost_walk_out(walker, outpost)

/**
 * `walker` is done at `outpost`: it walks to the nearest hangar lift the way a person would
 * (npc_walk_out(), human_npc_states.dm). It can be shot, downed, cuffed or grabbed on the way and then
 * stays where it is; it is deleted only when it stands on the lift, or when no player can see it and
 * it is on its feet and free. `on_left` is called with it just before that. A lift behind a counter it
 * can't get round just means it goes when nobody is looking. Someone who is dead stays for the
 * corpse sweep; someone sitting at a table or hiding gets up first. Returns TRUE if it set off.
 */
/proc/bounty_outpost_walk_out(mob/living/carbon/human/npc/walker, obj/structure/overmap/trader_outpost/outpost, datum/callback/on_left)
	if(QDELETED(walker) || walker.stat == DEAD || !isnull(walker.npc_exit))
		return FALSE
	var/datum/component/bounty_outpost_blend/blend = walker.GetComponent(/datum/component/bounty_outpost_blend)
	blend?.leaving = TRUE
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = walker
	if(istype(criminal))
		// Out of the closet or from behind the plant, and up from its seat, its drink put down
		if(criminal.hidden)
			criminal.ai_unhide()
		criminal.ai_end_activity()
		criminal.ai_stand_up()
	else if(walker.buckled && !ismob(walker.buckled) && !human_npc_out_of_fight(walker))
		walker.buckled.unbuckle_mob(walker, force = TRUE)
	// The lift if there is one on its level; else where it stands, which it leaves once nobody can see it
	var/turf/exit_turf = bounty_outpost_exit_turf(walker, outpost) || get_turf(walker)
	return walker.npc_walk_out(exit_turf, on_left)

/// The hangar lift alcove tile nearest `from`, on its level, or null
/proc/bounty_outpost_exit_turf(atom/from, obj/structure/overmap/trader_outpost/outpost)
	var/turf/start = get_turf(from)
	if(!start || !outpost)
		return null
	var/turf/nearest
	var/nearest_distance = INFINITY
	for(var/turf/alcove as anything in outpost.lobby_alcove_turfs)
		if(alcove.z != start.z)
			continue
		var/distance = get_dist(start, alcove)
		if(distance < nearest_distance)
			nearest = alcove
			nearest_distance = distance
	return nearest

// =========================================================================
// ASKING TRADERS
// =========================================================================

/**
 * The trader-outpost posting `user`'s ship is hunting at `trader`'s outpost, if any: what the
 * "Ask about the wanted person" option on the trader's radial asks about. Only a ship hunting it
 * (a claimant) asks.
 */
/proc/bounty_outpost_ask_posting(mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader, mob/living/user)
	var/obj/structure/overmap/trader_outpost/outpost = trader?.outpost
	var/obj/structure/overmap/ship/ship = outpost ? get_crew_ship(user) : null
	if(!ship)
		return null
	var/datum/weakref/ship_ref = WEAKREF(ship)
	for(var/datum/criminal_bounty/posting as anything in GLOB.criminal_bounties)
		if(QDELETED(posting) || posting.status != BOUNTY_POSTING_OPEN || posting.placement_kind != BOUNTY_PLACEMENT_TRADER_OUTPOST)
			continue
		if(posting.site_ref?.resolve() != outpost || !(ship_ref in posting.claimants))
			continue
		return posting
	return null

/**
 * `user` asked `trader` about the fugitive their ship is hunting there: the trader leans in and
 * tells them their one clue, quietly. Returns TRUE if there was anything to ask about.
 */
/proc/bounty_outpost_ask(mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader, mob/living/user)
	var/datum/criminal_bounty/posting = bounty_outpost_ask_posting(trader, user)
	if(!posting)
		return FALSE
	var/words
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	if(!fugitive || get_trader_outpost_for_turf(get_turf(fugitive)) != trader.outpost)
		words = "They're not here any more." // slipped away, or someone already dragged them off
	else
		words = posting.outpost_clue_for(trader, bounty_outpost_hunter_key(user))
	trader.visible_message(span_notice("[trader] leans in and says something quietly to [user]."), vision_distance = COMBAT_MESSAGE_RANGE, ignored_mobs = list(user))
	to_chat(user, span_notice("<b>[trader]</b> says quietly, \"[words]\""))
	log_game("BOUNTY: [key_name(user)] asked [trader] about [posting.record?.name]: \"[words]\"")
	return TRUE

/**
 * What `trader` tells the ship `hunter_key` about this fugitive: one clue per trader per ship, and
 * each trader a different one. The words are made fresh on every ask, from what the trader knows
 * (M4): a place is told in the present only if it is true now, and retold in the past
 * ("earlier") once it may not be.
 */
/datum/criminal_bounty/proc/outpost_clue_for(mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader, hunter_key)
	var/told_key = "[REF(trader)]|[REF(hunter_key)]"
	var/list/told = outpost_clues_told[told_key]
	if(told)
		var/again = outpost_clue_words(told[1], told[2])
		return again ? "I told you what I know. [again]" : "I told you what I know."
	var/list/kind = outpost_trader_kind(trader)
	if(!kind)
		return BOUNTY_OUTPOST_NO_CLUE
	outpost_clues_told[told_key] = list(kind, outpost_clue_place(kind))
	return outpost_clue_words(kind)

/**
 * The clue `trader` gives now (list(BOUNTY_CLUE_*, index)): the kind they were given, if it can be
 * said truthfully now, or the next kind nobody here has given yet that can. Null if none can.
 */
/datum/criminal_bounty/proc/outpost_trader_kind(mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader)
	var/trader_key = REF(trader)
	var/list/kind = outpost_trader_clues[trader_key]
	if(kind && outpost_clue_words(kind))
		return kind
	if(isnull(outpost_clue_pool))
		outpost_clue_pool = outpost_build_clue_pool()
	for(var/list/candidate as anything in outpost_clue_pool)
		if(!outpost_clue_words(candidate))
			continue
		outpost_clue_pool -= list(candidate)
		outpost_trader_clues[trader_key] = candidate
		return candidate
	return null

/**
 * Every clue the traders here could give, shuffled: where they were seen, their hair, the feature the
 * printed warrant leaves off (the last: P5's board_warrant_text()), and each decoy ruled out. The
 * features the warrant already lists are never a clue, so a feature clue is always news (BUG-10).
 */
/datum/criminal_bounty/proc/outpost_build_clue_pool()
	var/list/pool = list(list(BOUNTY_CLUE_SEEN, 0))
	if(bounty_outpost_hair_clue(record))
		pool += list(list(BOUNTY_CLUE_HAIR, 0))
	var/list/lines = record?.feature_lines()
	if(length(lines))
		pool += list(list(BOUNTY_CLUE_FEATURE, length(lines)))
	for(var/index in 1 to length(decoys))
		pool += list(list(BOUNTY_CLUE_RULED_OUT, index))
	shuffle_inplace(pool)
	return pool

/**
 * Where clue `kind` puts someone now, or null: where the fugitive is (BOUNTY_CLUE_SEEN), or where
 * a decoy is, if that place picks out nobody else (BOUNTY_CLUE_RULED_OUT). Other kinds have no place.
 */
/datum/criminal_bounty/proc/outpost_clue_place(list/kind)
	var/obj/structure/overmap/trader_outpost/outpost = outpost_site?.resolve()
	switch(kind[1])
		if(BOUNTY_CLUE_SEEN)
			var/mob/living/carbon/human/npc/bounty_criminal/fugitive = criminal()
			return fugitive ? bounty_outpost_where(fugitive, outpost) : null
		if(BOUNTY_CLUE_RULED_OUT)
			var/index = kind[2]
			if(index < 1 || index > length(decoys))
				return null
			var/datum/weakref/decoy_ref = decoys[index]
			var/mob/living/carbon/human/npc/bounty_criminal/decoy = decoy_ref?.resolve()
			if(QDELETED(decoy) || decoy.stat == DEAD)
				return null
			var/where = bounty_outpost_where(decoy, outpost)
			if(!where)
				return null
			// Only if the place picks out one person: never a hint that could fit the fugitive
			for(var/mob/living/carbon/human/npc/bounty_criminal/other as anything in outpost_candidates())
				if(other != decoy && bounty_outpost_where(other, outpost) == where)
					return null
			return where
	return null

/**
 * The words for clue `kind` (list(BOUNTY_CLUE_*, index)), made now and true now, or null if it
 * can't be said truthfully. `where_then` is the place it named when first told: given, a place
 * that may have changed is retold in the past.
 */
/datum/criminal_bounty/proc/outpost_clue_words(list/kind, where_then)
	switch(kind[1])
		if(BOUNTY_CLUE_SEEN)
			if(where_then)
				return "I saw someone like that [where_then] earlier."
			var/where = outpost_clue_place(kind)
			return where ? "Saw someone like that [where], not long ago." : null
		if(BOUNTY_CLUE_HAIR)
			return bounty_outpost_hair_clue(record)
		if(BOUNTY_CLUE_FEATURE)
			var/line = bounty_outpost_feature_clue(record, kind[2])
			return line ? "I remember one thing about them. [line]" : null
		if(BOUNTY_CLUE_RULED_OUT)
			var/where = outpost_clue_place(kind)
			if(where)
				return "The one [where]? Not who you're after."
			return where_then ? "Whoever was [where_then] earlier wasn't who you're after." : null
	return null

/// The fugitive and its decoys, whoever of them still exists
/datum/criminal_bounty/proc/outpost_candidates()
	. = list()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = criminal()
	if(fugitive)
		. += fugitive
	for(var/datum/weakref/decoy_ref as anything in decoys)
		var/mob/living/carbon/human/npc/bounty_criminal/decoy = decoy_ref?.resolve()
		if(!QDELETED(decoy))
			. += decoy

/**
 * Where `thing` is at `outpost`, as a trader would put it: "by the bar", "near the docks", "near
 * Dram's counter", "by the pond", "at one of the tables", or which side of the concourse. Null if
 * it isn't at the outpost.
 */
/proc/bounty_outpost_where(atom/thing, obj/structure/overmap/trader_outpost/outpost)
	var/turf/spot = get_turf(thing)
	var/list/bounds = bounty_outpost_bounds(outpost)
	if(!spot || !bounds)
		return null
	if(!bounty_outpost_turf_in_bounds(spot, bounds))
		return get_trader_outpost_for_turf(spot) == outpost ? "down in the hangars" : null
	if(locate(/obj/structure/chair/stool/bar) in range(2, spot))
		return "by the bar"
	for(var/turf/alcove as anything in outpost.lobby_alcove_turfs)
		if(alcove.z == spot.z && get_dist(alcove, spot) <= 4)
			return "near the docks"
	for(var/mob/living/carbon/human/npc/ambient_npc/outpost/trader/trader as anything in outpost.traders)
		if(!QDELETED(trader) && trader.z == spot.z && get_dist(trader, spot) <= 3)
			return "near [trader.name]'s counter"
	if(locate(/turf/open/water/outpost_pond) in range(2, spot))
		return "by the pond"
	if(locate(/obj/structure/table) in range(1, spot))
		return "at one of the tables"
	var/turf/middle = locate(round((bounds[1] + bounds[3]) / 2), round((bounds[2] + bounds[4]) / 2), bounds[5])
	if(get_dist(middle, spot) <= max(1, round(min(bounds[3] - bounds[1], bounds[4] - bounds[2]) / 8)))
		return "in the middle of the concourse"
	return "on the [dir2text(get_dir(middle, spot))] side of the concourse"

/**
 * The feature at `index` in `record`'s examine order (P1's feature_lines()), as a trader would say it:
 * "They've got a scar across the left cheek.", never the examine label. Null past the end.
 */
/proc/bounty_outpost_feature_clue(datum/bounty_record/record, index)
	var/list/features = record?.features
	if(!length(features) || index < 1)
		return null
	var/count = 0
	for(var/kind in bounty_feature_labels())
		var/value = features[kind]
		if(!istext(value) || !length(value))
			continue
		count++
		if(count != index)
			continue
		value = trim(STRIP_HTML_FULL(value, MAX_MESSAGE_LEN))
		if(!length(value))
			return null
		switch(kind)
			if(BOUNTY_FEATURE_SCAR)
				return "They've got a scar [value]."
			if(BOUNTY_FEATURE_TATTOO)
				return "They've got a tattoo, [value]."
			if(BOUNTY_FEATURE_GLASSES, BOUNTY_FEATURE_CLOTHING)
				return "They wear [value]."
			if(BOUNTY_FEATURE_LIMP)
				return "The one you want [value]."
			if(BOUNTY_FEATURE_HAIR)
				return "Their hair's [value]."
		return "[capitalize(value)]."
	return null

/// How the fugitive's hair differs from the mugshot, as a trader would say it, or null if it doesn't
/proc/bounty_outpost_hair_clue(datum/bounty_record/record)
	var/datum/bounty_look/now = record?.look
	var/datum/bounty_look/then = record?.old_look
	if(!now || !then)
		return null
	var/style_changed = now.hairstyle && now.hairstyle != then.hairstyle
	var/colour_changed = now.hair_color && then.hair_color && lowertext(now.hair_color) != lowertext(then.hair_color)
	if(!style_changed && !colour_changed)
		return null
	if(style_changed && findtext(now.hairstyle, "Bald"))
		return "They've shaved their head since that picture was taken."
	var/style = style_changed ? bounty_outpost_hairstyle_words(now.hairstyle) : null
	var/colour = colour_changed ? bounty_outpost_colour_word(now.hair_color) : null
	if(style && colour)
		return "Their hair's not like that picture any more. [capitalize(style)], dyed [colour], last I saw."
	if(colour)
		return "Their hair's not like that picture any more. Dyed [colour], last I saw."
	return "Their hair's not like that picture any more. [capitalize(style)], last I saw."

/// A hairstyle's name as someone would say it: "Long Hair 2 (Alt)" is "long hair"
/proc/bounty_outpost_hairstyle_words(hairstyle)
	var/words = lowertext("[hairstyle]")
	var/bracket = findtext(words, "(")
	if(bracket)
		words = copytext(words, 1, bracket)
	var/static/regex/digits = regex(@"[0-9]+", "g")
	words = digits.Replace(words, "")
	return trim(words) || "different"

/// A "#rrggbb" hair colour in a word or two
/proc/bounty_outpost_colour_word(colour)
	if(!istext(colour) || length(colour) < 7 || colour[1] != "#")
		return "a different colour"
	var/list/hsv = rgb2num(colour, COLORSPACE_HSV)
	if(length(hsv) < 3)
		return "a different colour"
	var/hue = hsv[1] || 0
	var/saturation = hsv[2]
	var/value = hsv[3]
	if(value < 18)
		return "black"
	if(saturation < 15)
		if(value > 85)
			return "white"
		return value > 55 ? "grey" : "dark grey"
	if(hue < 15 || hue >= 340)
		return value < 45 ? "dark red" : "red"
	if(hue < 45)
		if(value < 55)
			return "brown"
		return saturation > 60 ? "ginger" : "light brown"
	if(hue < 70)
		return value > 60 ? "blond" : "dark blond"
	if(hue < 170)
		return "green"
	if(hue < 255)
		return "blue"
	if(hue < 290)
		return "purple"
	return "pink"

// =========================================================================
// THE WARRANT
// =========================================================================

// P6's values. P5 prints it on the pad and writes the listing on it.
/obj/item/paper/bounty_warrant
	name = "bounty warrant"
	desc = "A printed warrant: a mugshot, the charges and a description."

/obj/item/paper/bounty_warrant/Initialize(mapload)
	. = ..()
	register_item_context()

/obj/item/paper/bounty_warrant/add_item_context(obj/item/source, list/context, atom/target, mob/living/user)
	if(isliving(target) && target != user)
		context[SCREENTIP_CONTEXT_LMB] = "Show warrant"
		return CONTEXTUAL_SCREENTIP_SET
	return NONE

/obj/item/paper/bounty_warrant/interact_with_atom(atom/interacting_with, mob/living/user, list/modifiers)
	if(!isliving(interacting_with) || interacting_with == user)
		return ..()
	show_warrant(interacting_with, user)
	return ITEM_INTERACT_SUCCESS

/// Its bounty closed: it burns away, wherever it is. Whoever carries it is told; on the floor, the room sees it.
/obj/item/paper/bounty_warrant/proc/burn_up()
	var/mob/living/holder = get(src, /mob/living)
	if(holder)
		to_chat(holder, span_notice("[src] curls up and burns away."))
	else if(isturf(loc))
		visible_message(span_notice("[src] curls up and burns away."), vision_distance = COMBAT_MESSAGE_RANGE)
	qdel(src)

/**
 * `user` holds the warrant up to `target`.
 * - The fugitive it is for: exposed (outpost_confront()).
 * - Any other criminal or decoy: they protest; at the fugitive's outpost that raises the alert.
 * - Anyone else (a person, a trader, an outpost regular): a look, and nothing else.
 * Showing it to a criminal or decoy starts the ship's BOUNTY_WARRANT_COOLDOWN.
 */
/obj/item/paper/bounty_warrant/proc/show_warrant(mob/living/target, mob/living/user)
	var/datum/criminal_bounty/posting = posting_ref?.resolve()
	if(QDELETED(posting) || posting.status != BOUNTY_POSTING_OPEN)
		to_chat(user, span_warning("This warrant is out of date."))
		return
	if(!istype(target, /mob/living/carbon/human/npc/bounty_criminal))
		user.visible_message(span_notice("[user] holds up a warrant for [target] to see."), span_notice("You hold up the warrant for [target] to see."), vision_distance = COMBAT_MESSAGE_RANGE)
		if(target.client)
			to_chat(target, span_notice("[user] shows you a bounty warrant. It isn't for you."))
		return
	if(target.stat != CONSCIOUS)
		to_chat(user, span_warning("[target] is in no state to look at anything."))
		return
	var/wait = posting.outpost_warrant_wait(user)
	if(wait)
		balloon_alert(user, "too soon!")
		return
	posting.outpost_start_warrant_cooldown(user)
	user.visible_message(span_notice("[user] holds up a warrant for [target] to see."), span_notice("You hold up the warrant for [target] to see."), vision_distance = COMBAT_MESSAGE_RANGE)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = target
	if(criminal == posting.criminal())
		posting.outpost_confront(criminal, user)
	else
		posting.outpost_wrong_accusation(criminal, user)

// =========================================================================
// THE WANTED BOARD
// =========================================================================

/**
 * # Wanted board
 *
 * A locked board on each trader outpost's concourse: the public bounties with their mugshots,
 * tier, reward and where they were last seen. Read-only; hunts start from a ship's mission
 * console. Outpost property. Mugshots go through ui_static_data(), never ui_data() (AR-G1).
 */
/obj/structure/bounty_wanted_board
	name = "wanted board"
	desc = "A locked board of wanted notices."
	icon = 'icons/obj/wallmounts.dmi'
	icon_state = "noticeboard"
	density = FALSE
	anchored = TRUE
	resistance_flags = INDESTRUCTIBLE | LAVA_PROOF | FIRE_PROOF | UNACIDABLE | ACID_PROOF
	/// The public postings (record id and serial) the viewers' static data was last built from
	var/outpost_static_signature

MAPPING_DIRECTIONAL_HELPERS(/obj/structure/bounty_wanted_board, 32)

/obj/structure/bounty_wanted_board/Initialize(mapload)
	. = ..()
	AddElement(/datum/element/outpost_property)
	update_appearance(UPDATE_OVERLAYS)

/obj/structure/bounty_wanted_board/update_overlays()
	. = ..()
	. += "notices_4"

/obj/structure/bounty_wanted_board/examine(mob/user)
	. = ..()
	var/count = length(bounty_public_postings())
	. += span_notice((count ? "[count] wanted notice\s posted." : "No wanted notices posted right now."))

/obj/structure/bounty_wanted_board/item_interaction(mob/living/user, obj/item/tool, list/modifiers)
	if(istype(tool, /obj/item/paper) || istype(tool, /obj/item/photo))
		balloon_alert(user, "it's locked!")
		return ITEM_INTERACT_BLOCKING
	return ..()

/obj/structure/bounty_wanted_board/ui_interact(mob/user, datum/tgui/ui)
	ui = SStgui.try_update_ui(user, src, ui)
	if(!ui)
		ui = new(user, src, "WantedBoard", name)
		ui.open()

// Never builds a picture here (L4): P1's cached getter gives what is ready and queues the rest,
// and the board sends everyone the pictures again when one is ready.
/obj/structure/bounty_wanted_board/ui_static_data(mob/user)
	var/list/mugshots = list()
	for(var/datum/criminal_bounty/posting as anything in bounty_public_postings())
		var/datum/bounty_record/record = posting.record
		var/mugshot = bounty_mugshot_cached(record)
		if(mugshot)
			mugshots[record.id] = "data:image/png;base64,[mugshot]"
		else
			RegisterSignal(record, COMSIG_BOUNTY_RECORD_MUGSHOT_READY, PROC_REF(outpost_on_mugshot_ready), override = TRUE)
	return list("mugshots" = mugshots)

/obj/structure/bounty_wanted_board/ui_data(mob/user)
	// A posting came or went, or its picture changed: every viewer gets the pictures again, next
	// tick (L7). Only this check moves the signature, so one viewer opening the board can't hide
	// the change from another.
	var/signature = bounty_public_board_signature()
	if(signature != outpost_static_signature)
		outpost_static_signature = signature
		outpost_refresh_viewers()
	return list("entries" = outpost_board_entries(user))

/// Sends every viewer the board's pictures again, next tick
/obj/structure/bounty_wanted_board/proc/outpost_refresh_viewers()
	addtimer(CALLBACK(src, TYPE_PROC_REF(/datum, update_static_data_for_all_viewers)), 1, TIMER_UNIQUE | TIMER_DELETE_ME)

/// A mugshot the board was waiting for is ready
/obj/structure/bounty_wanted_board/proc/outpost_on_mugshot_ready(datum/bounty_record/source)
	SIGNAL_HANDLER
	UnregisterSignal(source, COMSIG_BOUNTY_RECORD_MUGSHOT_READY)
	outpost_refresh_viewers()

/**
 * The public postings as the board lists them, as wanted posters: the ship card's terms ("Wanted
 * alive", "Wanted dead") and place words (a lair's real name, never "encrypted signal": BUG-5), with
 * the vouchers beside the credits (BUG-13). A fugitive blending in on this very concourse is "Seen on
 * this concourse" (P11).
 */
/obj/structure/bounty_wanted_board/proc/outpost_board_entries(mob/user)
	var/list/entries = list()
	var/obj/structure/overmap/trader_outpost/this_outpost = get_trader_outpost_for_turf(get_turf(src))
	var/datum/voidcrew_crew_record/viewer_crew = user?.mind?.get_reputation_crew()
	for(var/datum/criminal_bounty/posting as anything in bounty_public_postings())
		var/datum/bounty_record/record = posting.record
		var/here = !!this_outpost && posting.placement_kind == BOUNTY_PLACEMENT_TRADER_OUTPOST && posting.site() == this_outpost && !istype(posting, /datum/criminal_bounty/kingpin)
		entries += list(list(
			"id" = record.id,
			"name" = record.name,
			"alias" = (record.alias && record.alias != record.name) ? record.alias : null,
			"tier_level" = record.tier,
			"terms" = posting.board_terms(),
			"crime" = record.crime,
			"reward" = posting.value,
			"vouchers" = posting.board_vouchers,
			"place" = here ? "Seen on this concourse" : posting.board_place_text(),
			"reputation_gain" = posting.board_reputation_worth(viewer_crew),
		))
	return entries

/// The open public postings, every ship's to hunt
/proc/bounty_public_postings()
	. = list()
	for(var/datum/criminal_bounty/posting as anything in GLOB.criminal_bounties)
		if(QDELETED(posting) || posting.status != BOUNTY_POSTING_OPEN || posting.private_to || !posting.record)
			continue
		. += posting

/// Changes whenever the board's pictures need sending again: a posting added or gone, or its picture changed
/proc/bounty_public_board_signature()
	var/list/parts = list()
	for(var/datum/criminal_bounty/posting as anything in bounty_public_postings())
		parts += "[posting.record.id]:[posting.static_data_serial]"
	return parts.Join(",")

#undef BOUNTY_OUTPOST_NO_CLUE
