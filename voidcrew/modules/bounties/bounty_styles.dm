 * hand, or a fist (the human NPC base's melee). A brawler now and then shoves instead.
 */
/datum/ai_planning_subtree/bounty_melee

/datum/ai_planning_subtree/bounty_melee/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/fighter = controller.pawn
	if(!bounty_ai_fighting(fighter) || !controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(style?.ranged && style.ready_in_hand(fighter))
		return
	controller.queue_behavior(/datum/ai_behavior/basic_melee_attack/human_npc/bounty, BB_BASIC_MOB_CURRENT_TARGET, BB_TARGETING_STRATEGY, BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION)
	return SUBTREE_RETURN_FINISH_PLANNING

/// The human NPC base's melee (tg's, through a click), with the brawler's shove: a real right click with an empty hand
/datum/ai_behavior/basic_melee_attack/human_npc/bounty

/datum/ai_behavior/basic_melee_attack/human_npc/bounty/perform(seconds_per_tick, datum/ai_controller/controller, target_key, targeting_strategy_key, hiding_location_key)
	var/mob/living/carbon/fighter = controller.pawn
	var/mob/living/target = controller.blackboard[target_key]
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style?.shove_chance || !isliving(target) || !fighter.CanReach(target) || world.time < fighter.next_move)
		return ..()
	var/attack_at = controller.blackboard[BB_BASIC_MOB_MELEE_COOLDOWN_TIMER]
	if(isnull(attack_at) || attack_at > world.time || !prob(style.shove_chance))
		return ..()
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[targeting_strategy_key])
	if(!strategy?.can_attack(fighter, target) || !human_npc_ready_empty_hand(fighter))
		return ..()
	fighter.zone_selected = BODY_ZONE_CHEST
	controller.ai_interact(target = target, combat_mode = TRUE, modifiers = list(RIGHT_CLICK = TRUE))
	return AI_BEHAVIOR_DELAY
