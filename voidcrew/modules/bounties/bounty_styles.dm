/**
 * Puts `item_type` somewhere `outfit` carries it: a free pocket, else the belt's pouch, else the bag.
 * Returns TRUE if it found a place.
 */
/proc/bounty_outfit_carry(datum/outfit/outfit, item_type)
	if(!istype(outfit) || !ispath(item_type))
		return FALSE
	if(!outfit.r_pocket)
		outfit.r_pocket = item_type
		return TRUE
	if(!outfit.l_pocket)
		outfit.l_pocket = item_type
		return TRUE
	if(outfit.belt && ispath(outfit.belt, /obj/item/storage))
		LAZYADDASSOC(outfit.belt_contents, item_type, 1)
		return TRUE
	if(outfit.back && ispath(outfit.back, /obj/item/storage))
		LAZYADDASSOC(outfit.backpack_contents, item_type, 1)
		return TRUE
	return FALSE

/**
 * The outfit a bounty fighter wears: plain clothes for `archetype` in `zone`, its tier's armour, its
 * style's weapon and spares, and `treatment` (a bruise pack, a stimpack) in a pocket.
 */
/proc/bounty_fighter_outfit(archetype, zone, tier, style_key, heavy = FALSE, treatment)
	var/datum/outfit/outfit = bounty_outfit_instance(bounty_plain_clothes(archetype, zone))
	if(!outfit)
		return null
	bounty_add_tier_armour(outfit, tier)
	var/datum/bounty_style/style = GLOB.bounty_styles[style_key]
	style?.equip(outfit, heavy)
	if(treatment)
		bounty_outfit_carry(outfit, treatment)
	return outfit

