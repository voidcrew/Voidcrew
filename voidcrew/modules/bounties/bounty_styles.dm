/**
 * # Bounty hunting: fighting styles, with real weapons
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * How a criminal or a companion fights (combat.md 6.2, defaults CR-13). Every style is a real item the
 * fighter carries, puts in its hand when the fight starts, and uses the way a player does, through
 * controller.ai_interact() (a click):
 * - brawler: fists, and now and then a real shove (a right click);
 * - knife: a knife from a pocket (Wanted and above: a combat knife). Its cuts and bleeding are the
 *   knife's own;
 * - club: a baseball bat in hand (Wanted and above: the metal bat). It knocks people back as tg's bat does;
 * - pistol: a Stechkin from a shoulder holster, set to single shots with its own fire selector, a spare
 *   magazine in a pocket, reloaded the player's way. Strings of BOUNTY_PISTOL_STRING_SHOTS, then a pause;
 * - shotgun: a pump shotgun on the back with buckshot (Wanted and above: a semi-automatic combat
 *   shotgun), shells on a bandolier, loaded into the tube shell by shell;
 * - SMG: a WT-550 worn on the belt at every tier, a spare magazine in a pocket. A burst is
 *   BOUNTY_SMG_BURST separate trigger pulls at the gun's own full-auto rate, so it stops the moment
 *   they can't shoot or the target is gone;
 * - revolver: a .38 in a shoulder holster, a speedloader in a pocket. A dry cylinder is reloaded the
 *   player's way: the speedloader clicked into it pushes the spent casings out;
 * - bottle: beer bottles from a satchel, thrown one at a time with a real throw (tg's bottle smashes on
 *   whoever it hits); out of bottles, they fight with their fists;
 * - holdout: a meek criminal's little Makarov, a pocket gun, and a spare magazine in a fanny pack (the
 *   cornered volley in bounty_ai_meek.dm).
 * Nothing is spawned for the fight, no projectile comes from the body, and nothing passes through
 * anyone: before a shot or a throw the fighter checks its line and steps aside for anyone it may not
 * hit (bounty_ai_line_blocked()), one step at a time at the body's own pace (bounty_ai_step()). The
 * style sets only the timing: how often they pull the trigger or throw, the telegraph before it (a hit
 * during it fumbles the attack), the reload, and the distance they keep. A gun fires at anyone it sees
 * within BOUNTY_GUN_FIRE_RANGE while its holder walks in to BOUNTY_PISTOL_RANGE; the shotgun and the
 * bottle keep to their own distance. A companion's gun is backup: shorter pistol strings and SMG bursts
 * (companion_string, companion_burst). Gear is locked to the body (D3): it never drops and is never
 * loot; bottles are consumables, so a thrown one leaves the hand and breaks.
 *
 * A gun that comes out of its holster, off their back or out of a bag at the start of a fight comes
 * with a line and the holster's sound, and the draw is the telegraph for the first shot: at least
 * BOUNTY_DRAW_TIME after it, fumbled by a hit in between (/datum/ai_behavior/human_npc_draw/bounty).
 */

/// Every fighting style by key (BOUNTY_STYLE_*), one datum each
GLOBAL_LIST_INIT(bounty_styles, init_bounty_styles())

/proc/init_bounty_styles()
	var/list/styles = list()
	for(var/datum/bounty_style/style_type as anything in subtypesof(/datum/bounty_style))
		var/datum/bounty_style/style = new style_type
		if(style.key)
			styles[style.key] = style
	return styles

/// A fighter's style: from its controller's blackboard
/proc/bounty_ai_style(mob/living/fighter)
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(QDELETED(controller))
		return null
	return GLOB.bounty_styles[controller.blackboard[BB_BOUNTY_STYLE]]

/// Puts style `key` on `fighter`'s AI. Its weapon is whatever it was dressed with (bounty_build_outfit()).
/proc/bounty_ai_apply_style(mob/living/fighter, key)
	var/datum/bounty_style/style = GLOB.bounty_styles[key]
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(!style || QDELETED(controller))
		return FALSE
	controller.set_blackboard_key(BB_BOUNTY_STYLE, key)
	bounty_ai_clear_windup(controller)
	controller.clear_blackboard_key(BB_BOUNTY_BURST_LEFT)
	return TRUE

/// Whether style `key` (BOUNTY_STYLE_*) fights with a gun
/proc/bounty_style_is_gun(key)
	var/datum/bounty_style/style = GLOB.bounty_styles[key]
	return !!style && ispath(style.weapon, /obj/item/gun)

/// Whether a pawn is in a fight it can take part in: a criminal fighting, or a companion that has not broken
/proc/bounty_ai_fighting(mob/living/fighter)
	if(istype(fighter, /mob/living/carbon/human/npc/bounty_criminal))
		var/mob/living/carbon/human/npc/bounty_criminal/criminal = fighter
		return criminal.ai_mode == BOUNTY_AI_FIGHTING && criminal.ai_can_act()
	if(istype(fighter, /mob/living/carbon/human/npc/bounty_companion))
		var/mob/living/carbon/human/npc/bounty_companion/companion = fighter
		return companion.ai_can_fight()
	return FALSE

/// Puts the weapons in `body`'s hands away on its body (the human NPC base's npc_stow_weapons()): a holster, a pocket, a back. What has nowhere to go stays in hand.
/proc/bounty_ai_holster(mob/living/carbon/human/npc/body)
	if(!ishumannpc(body) || HAS_TRAIT(body, TRAIT_HANDS_BLOCKED))
		return
	body.npc_stow_weapons()

/// The first `item_type` that `body` carries and can take in hand in a moment (held, worn, in a bag or pouch it wears), or null
/proc/bounty_ai_carried(mob/living/carbon/body, item_type)
	if(!ispath(item_type))
		return null
	for(var/obj/item/thing as anything in body.get_all_contents_type(item_type))
		if(body.is_holding(thing) || human_npc_can_draw(body, thing))
			return thing
	return null

/// Whether `gun` fires on the next pull, or would after the pump its style's telegraph works (`pumps`)
/proc/bounty_ai_gun_ready(obj/item/gun/gun, pumps = FALSE)
	if(!istype(gun))
		return FALSE
	if(gun.can_shoot())
		return TRUE
	var/obj/item/gun/ballistic/ballistic = gun
	return pumps && istype(ballistic) && human_npc_gun_needs_rack(ballistic)

/// Live rounds in a ballistic gun: its magazine (a revolver's cylinder holds its chamber) and a chambered round. Null for anything else.
/proc/bounty_gun_live_rounds(obj/item/gun/ballistic/gun)
	if(!istype(gun))
		return null
	. = gun.magazine ? human_npc_live_rounds(gun.magazine) : 0
	if(gun.chambered?.loaded_projectile && (!gun.magazine || !(gun.chambered in gun.magazine.stored_ammo)))
		.++

/**
 * Sets `gun` to single shots with its own fire selector, the way `user` would: their fire-mode button
 * on the gun, or the selector itself while the button isn't theirs. A Stechkin fires three-round
 * bursts until it is switched. Returns TRUE if the gun fires one round a pull now.
 */
/proc/bounty_gun_single_fire(mob/living/user, obj/item/gun/ballistic/gun)
	if(!istype(gun))
		return FALSE
	if(gun.burst_size <= 1)
		return TRUE
	// A gun with no selector only fires its burst
	if(!gun.burst_fire_selection)
		return FALSE
	// The selector's click and its note go to whoever flips it, not to whoever's turn it is
	var/mob/old_usr = usr
	usr = user
	for(var/datum/action/item_action/toggle_firemode/selector in gun.actions)
		if(selector.owner == user)
			selector.Trigger(user)
			break
	if(gun.burst_size > 1 && gun.burst_fire_selection)
		gun.burst_select()
	usr = old_usr
	return gun.burst_size <= 1

/**
 * Counts a shot just fired from `gun` towards a string of `string_length` on `controller`'s blackboard. A
 * new magazine (a reload) starts the count again. TRUE when the shot ends a string with rounds still in
 * the gun; an empty one is reloaded instead.
 */
/proc/bounty_ai_string_done(datum/ai_controller/controller, obj/item/gun/ballistic/gun, string_length)
	if(!istype(gun) || string_length <= 0 || !gun.magazine)
		return FALSE
	var/shots = 1
	if(controller.blackboard[BB_BOUNTY_STRING_MAGAZINE] == gun.magazine)
		shots += controller.blackboard[BB_BOUNTY_STRING_SHOTS]
	else
		controller.set_blackboard_key(BB_BOUNTY_STRING_MAGAZINE, gun.magazine)
	if(shots >= string_length && bounty_gun_live_rounds(gun) > 0)
		controller.set_blackboard_key(BB_BOUNTY_STRING_SHOTS, 0)
		return TRUE
	controller.set_blackboard_key(BB_BOUNTY_STRING_SHOTS, shots)
	return FALSE

/// Empties the hand that isn't holding `keep`, for a gun that needs both: puts what's there away, and lets go of a spent shell or a spent magazine
/proc/bounty_ai_free_other_hand(mob/living/carbon/body, obj/item/keep)
	for(var/obj/item/held in body.held_items)
		if(held == keep)
			continue
		if((isammocasing(held) || istype(held, /obj/item/ammo_box)) && !human_npc_live_rounds(held))
			body.dropItemToGround(held)
			continue
		if(!held.equip_to_best_slot(body))
			body.dropItemToGround(held)
	return length(body.get_empty_held_indexes()) > 0

/**
 * Whether someone `shooter` may not hit stands in its line of fire to `target`: one of its own gang, its
 * own side of the site (the crew it is aboard with), or a bystander it has no quarrel with. Shots and
 * throws pass over anyone lying down. This is the whole of friendly fire: nothing it fires passes
 * through anyone.
 */
/proc/bounty_ai_line_blocked(mob/living/shooter, atom/target)
	var/turf/start = get_turf(shooter)
	var/turf/end = get_turf(target)
	if(!start || !end)
		return FALSE
	for(var/turf/line_turf as anything in get_line(start, end))
		if(line_turf == start || line_turf == end)
			continue
		for(var/mob/living/other in line_turf)
			if(other == shooter || other.stat == DEAD || other.body_position == LYING_DOWN)
				continue
			if(shooter.faction_check_atom(other) || !bounty_ai_may_hit(shooter, other))
				return TRUE
	return FALSE

/// One step sideways for a clear line to `target`, no further from them, on the leash, and no sooner than the body's own next step (a person can't dart about faster than they walk)
/proc/bounty_ai_sidestep(mob/living/fighter, atom/target)
	var/turf/here = get_turf(fighter)
	if(!here || !isturf(fighter.loc) || !bounty_ai_step_ready(fighter))
		return FALSE
	var/list/options = list()
	for(var/direction in GLOB.alldirs)
		var/turf/next = get_step(here, direction)
		if(!next || get_dist(next, target) > get_dist(here, target) || !next.can_cross_safely(fighter))
			continue
		options += next
	shuffle_inplace(options)
	for(var/turf/next as anything in options)
		if(bounty_ai_step(fighter, next, paced = TRUE))
			return TRUE
	return FALSE

/// A step straight back from `target`, now and then, on the leash, and no sooner than the body's own next step
/proc/bounty_ai_back_off(datum/ai_controller/controller, mob/living/fighter, atom/target)
	if(world.time < controller.blackboard[BB_BOUNTY_BACKSTEP_AT] || !isturf(fighter.loc) || !bounty_ai_step_ready(fighter))
		return FALSE
	controller.set_blackboard_key(BB_BOUNTY_BACKSTEP_AT, world.time + BOUNTY_BACKSTEP_GAP)
	var/away_dir = get_dir(target, fighter)
	var/turf/away = away_dir && get_step(fighter, away_dir)
	if(!away || !bounty_ai_step(fighter, away, paced = TRUE))
		return FALSE
	fighter.face_atom(target)
	return TRUE

/// Forgets a wind-up in progress
/proc/bounty_ai_clear_windup(datum/ai_controller/controller)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_FROM)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_STAMINA)

// ===== THE STYLES =====

/**
 * How someone fights. Criminals, companions and the meek's holdout share these. The style puts a real
 * weapon (and its spares) on the outfit they are dressed in, and sets how they use it; what the weapon
 * does is the weapon's.
 */
/datum/bounty_style
	/// BOUNTY_STYLE_*
	var/key
	/// Fights at range: a gun, or something thrown
	var/ranged = FALSE
	/// What they carry, by tier: Petty, and Wanted or above (null for bare fists)
	var/weapon
	var/heavy_weapon
	/// What counts as their style's weapon when they look for it on themselves
	var/weapon_type
	/// The behaviour that keeps this style's distance while it shoots or throws
	var/ranged_behavior = /datum/ai_behavior/bounty_shoot
	/// Anyone closer than this and they step back (0: never)
	var/min_range = 0
	/// Between trigger pulls or throws
	var/interval = 1 SECONDS
	/// The telegraph before a shot or a throw, and what it says and sounds like
	var/windup = 0
	var/windup_message
	var/windup_sound
	/// The telegraph works a pump: a spent shell in the chamber doesn't need a reload
	var/pumps = FALSE
	/// Only the first shot of a string needs the telegraph (the gun raised, the hammer back); the draw counts as one
	var/windup_per_string = FALSE
	/// Chance a blow is a shove instead
	var/shove_chance = 0
	/// A gun kept in a holster, on the back or in a bag until a fight: what people see as it comes out (on_drawn())
	var/draw_message
	/// The gun is set to single shots with its own fire selector before it fires
	var/single_fire = FALSE
	/// Trigger pulls in one burst, burst_gap apart (1: a pull at a time). Each pull is its own step of bounty_shoot.
	var/burst = 1
	var/burst_gap = 0
	/// Shots in a string, then string_pause on top of the interval before the next (0: no strings)
	var/string_shots = 0
	var/string_pause = 0
	/// Its weapon goes where nobody sees it while they pass as a customer: a pocket, a holster or a bag under
	/// a coat (decoys wear the same holster or bag, outpost_match_kit()). A gun on the belt or the back, or
	/// a bat in hand, gives them away, so a trader-outpost fugitive never fights this way (bounty_roll_style()).
	var/concealable = TRUE
	/// A companion's burst and string, shorter: their gun is backup (null: the same as burst and string_shots)
	var/companion_burst
	var/companion_string

/**
 * Puts this style's weapon and spares on `outfit` (an instance), the heavier weapon if `heavy`. The
 * weapon is carried (a holster, a pocket, the back, a bag) unless it has nowhere to go on a body.
 */
/datum/bounty_style/proc/equip(datum/outfit/outfit, heavy = FALSE)
	return

/// The weapon this style carries at `heavy`
/datum/bounty_style/proc/weapon_for(heavy)
	return (heavy && heavy_weapon) || weapon

/// Trigger pulls in one burst for `fighter`: a companion's is companion_burst, if the style has one
/datum/bounty_style/proc/burst_length(mob/living/carbon/fighter)
	if(!isnull(companion_burst) && istype(fighter, /mob/living/carbon/human/npc/bounty_companion))
		return companion_burst
	return burst

/// Shots in one string for `fighter`, 0 for none: a companion's is companion_string, if the style has one
/datum/bounty_style/proc/string_length(mob/living/carbon/fighter)
	if(!isnull(companion_string) && istype(fighter, /mob/living/carbon/human/npc/bounty_companion))
		return companion_string
	return string_shots

/// Whether a burst is under way. One whose next pull is long overdue was cut off (the AI stopped meanwhile), and is forgotten.
/datum/bounty_style/proc/burst_under_way(datum/ai_controller/controller)
	if(!controller.blackboard[BB_BOUNTY_BURST_LEFT])
		return FALSE
	if(world.time > controller.blackboard[BB_BOUNTY_NEXT_SHOT] + BOUNTY_BURST_STALE)
		end_burst(controller)
		return FALSE
	return TRUE

/// Whatever is left of a burst never fires: the next one starts with its own telegraph
/datum/bounty_style/proc/end_burst(datum/ai_controller/controller)
	controller.clear_blackboard_key(BB_BOUNTY_BURST_LEFT)

/**
 * `weapon`, this style's own, just came into `fighter`'s hand out of `drawn_from` (a holster, a bag, or
 * the body itself for a slot). The selector is set, and a gun that was put away comes out with the
 * line and the holster's sound: the draw is the telegraph for the first shot, BOUNTY_DRAW_TIME later,
 * and a hit in between fumbles it.
 */
/datum/bounty_style/proc/on_drawn(mob/living/carbon/fighter, datum/ai_controller/controller, obj/item/weapon, atom/drawn_from)
	if(single_fire)
		bounty_gun_single_fire(fighter, weapon)
	if(!draw_message)
		return
	var/now = world.time
	end_burst(controller)
	controller.set_blackboard_key(BB_BOUNTY_DRAWN_AT, now)
	controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, now + BOUNTY_DRAW_TIME)
	controller.set_blackboard_key(BB_BOUNTY_WINDUP_UNTIL, now + BOUNTY_DRAW_TIME)
	controller.set_blackboard_key(BB_BOUNTY_WINDUP_FROM, now)
	controller.set_blackboard_key(BB_BOUNTY_WINDUP_STAMINA, fighter.getStaminaLoss())
	var/atom/target = controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(target)
		fighter.face_atom(target)
	fighter.visible_message(span_warning(replacetext(draw_message, "%USER", "[fighter]")), vision_distance = COMBAT_MESSAGE_RANGE)
	var/obj/item/container = drawn_from
	var/open_sound = istype(container) ? container.atom_storage?.open_sound : null
	if(open_sound)
		playsound(fighter, open_sound, 50, TRUE)

/// The ranged weapon in `fighter`'s hand that is ready to use, or null: a loaded (or pumpable) gun, a bottle
/datum/bounty_style/proc/ready_in_hand(mob/living/carbon/fighter)
	if(!ranged)
		return null
	for(var/obj/item/gun/gun in fighter.held_items)
		if(bounty_ai_gun_ready(gun, pumps))
			return gun
	return null

/// A ranged weapon of this style `fighter` carries that is worth drawing (one that fires, or that it can load), or null
/datum/bounty_style/proc/carried_ranged(mob/living/carbon/fighter)
	if(!ranged || !weapon_type)
		return null
	for(var/obj/item/gun/gun in fighter.get_all_contents_type(weapon_type))
		if(fighter.is_holding(gun) || !human_npc_can_draw(fighter, gun))
			continue
		if(bounty_ai_gun_ready(gun, pumps) || human_npc_can_reload(fighter, gun))
			return gun
	return null

/// Whether this shot needs the telegraph first
/datum/bounty_style/proc/needs_windup(datum/ai_controller/controller)
	if(windup <= 0)
		return FALSE
	if(!windup_per_string)
		return TRUE
	// Raised by the last shot, or by the draw, recently enough: the string goes on
	var/raised_at = max(controller.blackboard[BB_BOUNTY_LAST_SHOT], controller.blackboard[BB_BOUNTY_DRAWN_AT])
	return !raised_at || world.time - raised_at > BOUNTY_PISTOL_STRING_GAP

/// The telegraph: what they say, show and sound like before the shot
/datum/bounty_style/proc/telegraph(mob/living/carbon/fighter, atom/target, obj/item/weapon)
	fighter.face_atom(target)
	if(windup_message)
		fighter.visible_message(span_warning(replacetext(windup_message, "%USER", "[fighter]")))
	if(windup_sound)
		playsound(fighter, windup_sound, 50, TRUE)

/**
 * One step of a telegraphed attack. Returns TRUE when the attack goes now. Otherwise it is winding
 * up (the telegraph is shown at the start), or the wind-up just ended in a fumble: any hit taken during
 * it (damage, or more stamina loss) spoils the attack, and they try again a moment later.
 */
/datum/bounty_style/proc/windup_step(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	var/now = world.time
	var/until = controller.blackboard[BB_BOUNTY_WINDUP_UNTIL]
	if(until && now > until + BOUNTY_WINDUP_STALE)
		// Left over from an interrupted fight: it has to be done again
		bounty_ai_clear_windup(controller)
		until = null
	if(!until)
		if(!needs_windup(controller))
			return TRUE
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_UNTIL, now + windup)
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_FROM, now)
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_STAMINA, fighter.getStaminaLoss())
		telegraph(fighter, target, weapon)
		return FALSE
	if(now < until)
		fighter.face_atom(target)
		return FALSE
	var/hit_at = controller.blackboard[BB_BOUNTY_HIT_AT]
	var/fumbled = (hit_at && hit_at >= controller.blackboard[BB_BOUNTY_WINDUP_FROM]) || fighter.getStaminaLoss() > controller.blackboard[BB_BOUNTY_WINDUP_STAMINA] + 1
	bounty_ai_clear_windup(controller)
	if(fumbled)
		fighter.visible_message(span_notice("[fighter] fumbles [weapon]!"))
		controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, now + BOUNTY_FUMBLE_PAUSE)
		return FALSE
	return TRUE

/**
 * The attack itself, with `weapon` in hand: a trigger pull at `target`, the player's way. Returns TRUE
 * if it went.
 */
/datum/bounty_style/proc/attack(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	var/obj/item/gun/gun = weapon
	if(!istype(gun))
		return FALSE
	if(gun.weapon_weight == WEAPON_HEAVY)
		bounty_ai_free_other_hand(fighter, gun)
	if(!human_npc_ready_item(fighter, gun))
		return FALSE
	if(single_fire)
		bounty_gun_single_fire(fighter, gun)
	fighter.zone_selected = human_npc_pick_aim_zone()
	var/rounds = bounty_gun_live_rounds(gun)
	if(!controller.ai_interact(target = target, combat_mode = TRUE))
		return FALSE
	// Only a round that went counts: a click the gun refused (its fire delay, an empty chamber) is no shot
	return isnull(rounds) || bounty_gun_live_rounds(gun) < rounds

/**
 * One pull of the trigger (or one throw) at `target`, then the clock for the next: the burst's next
 * pull burst_gap away while one is under way, else the style's interval, with string_pause on top after
 * the last shot of a string. Returns TRUE if a round went.
 */
/datum/bounty_style/proc/pull(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	var/fired = attack(fighter, controller, target, weapon)
	var/now = world.time
	if(fired)
		controller.set_blackboard_key(BB_BOUNTY_LAST_SHOT, now)
	var/pulls = burst_length(fighter)
	if(fired && pulls > 1)
		var/left = (controller.blackboard[BB_BOUNTY_BURST_LEFT] || pulls) - 1
		if(left > 0 && ready_in_hand(fighter))
			controller.set_blackboard_key(BB_BOUNTY_BURST_LEFT, left)
			controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, now + burst_gap)
			return TRUE
	end_burst(controller)
	var/next = now + interval
	if(fired && bounty_ai_string_done(controller, weapon, string_length(fighter)))
		next += string_pause
	controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, next)
	return fired

/// Bare fists: a person's punch, and now and then a shove
/datum/bounty_style/brawler
	key = BOUNTY_STYLE_BRAWLER
	shove_chance = BOUNTY_BRAWLER_SHOVE_CHANCE

/// A knife in a pocket. Its cuts bleed, as a real one's do.
/datum/bounty_style/knife
	key = BOUNTY_STYLE_KNIFE
	weapon = /obj/item/knife
	heavy_weapon = /obj/item/knife/combat
	weapon_type = /obj/item/knife

/datum/bounty_style/knife/equip(datum/outfit/outfit, heavy = FALSE)
	bounty_outfit_carry(outfit, weapon_for(heavy))

/// A baseball bat. A bat has no slot to go in on a body, so it is in hand from the start.
/datum/bounty_style/club
	key = BOUNTY_STYLE_CLUB
	weapon = /obj/item/melee/baseball_bat
	heavy_weapon = /obj/item/melee/baseball_bat/ablative
	weapon_type = /obj/item/melee/baseball_bat
	concealable = FALSE

/datum/bounty_style/club/equip(datum/outfit/outfit, heavy = FALSE)
	outfit.r_hand = weapon_for(heavy)

/// A Stechkin in a shoulder holster, a spare magazine in a pocket: single shots twice a second, in strings
