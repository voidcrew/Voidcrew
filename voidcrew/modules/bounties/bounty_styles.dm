/**
 * # Bounty hunting: fighting styles, with real weapons
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * How a criminal or a companion fights (combat.md 6.2, defaults CR-13). Every style is a real item the
 * fighter carries, puts in its hand when the fight starts, and uses the way a player does, through
 * controller.ai_interact() (a click):
 * - brawler: fists, and now and then a real shove (a right click);
 * - knife: a knife from a pocket (Wanted and above: a combat knife). Its cuts and bleeding are the
 *   knife's own;
 * - club: a baseball bat in hand (Wanted and above: the metal bat). It knocks people back as tg's bat does;
 * - pistol: a Stechkin from a shoulder holster, a spare magazine in a pocket, reloaded the player's way;
 * - shotgun: a pump shotgun on the back with buckshot (Wanted and above: a semi-automatic combat
 *   shotgun), shells on a bandolier, loaded into the tube shell by shell;
 * - bottle: beer bottles from a satchel, thrown one at a time with a real throw (tg's bottle smashes on
 *   whoever it hits); out of bottles, they fight with their fists;
 * - holdout: a meek criminal's little Makarov, a pocket gun, and a spare magazine in a fanny pack (the
 *   cornered volley in bounty_ai_meek.dm).
 * Nothing is spawned for the fight, no projectile comes from the body, and nothing passes through
 * anyone: before a shot or a throw the fighter checks its line and steps aside for anyone it may not
 * hit (bounty_ai_line_blocked()). The style sets only the timing: how often they pull the trigger or
 * throw, the telegraph before it (a hit during it fumbles the attack), the reload, and the distance they
 * keep. Gear is locked to the body (D3): it never drops and is never loot; bottles are consumables, so a
 * thrown one leaves the hand and breaks.
 */

/// Every fighting style by key (BOUNTY_STYLE_*), one datum each
GLOBAL_LIST_INIT(bounty_styles, init_bounty_styles())

/proc/init_bounty_styles()
	var/list/styles = list()
	for(var/datum/bounty_style/style_type as anything in subtypesof(/datum/bounty_style))
		var/datum/bounty_style/style = new style_type
		if(style.key)
			styles[style.key] = style
	return styles

/// A fighter's style: from its controller's blackboard
/proc/bounty_ai_style(mob/living/fighter)
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(QDELETED(controller))
		return null
	return GLOB.bounty_styles[controller.blackboard[BB_BOUNTY_STYLE]]

/// Puts style `key` on `fighter`'s AI. Its weapon is whatever it was dressed with (bounty_build_outfit()).
/proc/bounty_ai_apply_style(mob/living/fighter, key)
	var/datum/bounty_style/style = GLOB.bounty_styles[key]
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(!style || QDELETED(controller))
		return FALSE
	controller.set_blackboard_key(BB_BOUNTY_STYLE, key)
	bounty_ai_clear_windup(controller)
	return TRUE

/// Whether a pawn is in a fight it can take part in: a criminal fighting, or a companion that has not broken
/proc/bounty_ai_fighting(mob/living/fighter)
	if(istype(fighter, /mob/living/carbon/human/npc/bounty_criminal))
		var/mob/living/carbon/human/npc/bounty_criminal/criminal = fighter
		return criminal.ai_mode == BOUNTY_AI_FIGHTING && criminal.ai_can_act()
	if(istype(fighter, /mob/living/carbon/human/npc/bounty_companion))
		var/mob/living/carbon/human/npc/bounty_companion/companion = fighter
		return companion.ai_can_fight()
	return FALSE

/// Puts the weapons in `body`'s hands away on its body (the human NPC base's npc_stow_weapons()): a holster, a pocket, a back. What has nowhere to go stays in hand.
/proc/bounty_ai_holster(mob/living/carbon/human/npc/body)
	if(!ishumannpc(body) || HAS_TRAIT(body, TRAIT_HANDS_BLOCKED))
		return
	body.npc_stow_weapons()

/// The first `item_type` that `body` carries and can take in hand in a moment (held, worn, in a bag or pouch it wears), or null
/proc/bounty_ai_carried(mob/living/carbon/body, item_type)
	if(!ispath(item_type))
		return null
	for(var/obj/item/thing as anything in body.get_all_contents_type(item_type))
		if(body.is_holding(thing) || human_npc_can_draw(body, thing))
			return thing
	return null

/// Whether `gun` fires on the next pull, or would after the pump its style's telegraph works (`pumps`)
/proc/bounty_ai_gun_ready(obj/item/gun/gun, pumps = FALSE)
	if(!istype(gun))
		return FALSE
	if(gun.can_shoot())
		return TRUE
	var/obj/item/gun/ballistic/ballistic = gun
	return pumps && istype(ballistic) && human_npc_gun_needs_rack(ballistic)

/// Empties the hand that isn't holding `keep`, for a gun that needs both: puts what's there away, and lets go of a spent shell or a spent magazine
/proc/bounty_ai_free_other_hand(mob/living/carbon/body, obj/item/keep)
	for(var/obj/item/held in body.held_items)
		if(held == keep)
			continue
		if((isammocasing(held) || istype(held, /obj/item/ammo_box)) && !human_npc_live_rounds(held))
			body.dropItemToGround(held)
			continue
		if(!held.equip_to_best_slot(body))
			body.dropItemToGround(held)
	return length(body.get_empty_held_indexes()) > 0

/**
 * Whether someone `shooter` may not hit stands in its line of fire to `target`: one of its own gang, its
 * own side of the site (the crew it is aboard with), or a bystander it has no quarrel with. Shots and
 * throws pass over anyone lying down. This is the whole of friendly fire: nothing it fires passes
 * through anyone.
 */
/proc/bounty_ai_line_blocked(mob/living/shooter, atom/target)
	var/turf/start = get_turf(shooter)
	var/turf/end = get_turf(target)
	if(!start || !end)
		return FALSE
	for(var/turf/line_turf as anything in get_line(start, end))
		if(line_turf == start || line_turf == end)
			continue
		for(var/mob/living/other in line_turf)
			if(other == shooter || other.stat == DEAD || other.body_position == LYING_DOWN)
				continue
			if(shooter.faction_check_atom(other) || !bounty_ai_may_hit(shooter, other))
				return TRUE
	return FALSE

/// One step sideways for a clear line to `target`, no further from them, on the leash
/proc/bounty_ai_sidestep(mob/living/fighter, atom/target)
	var/turf/here = get_turf(fighter)
	if(!here || !isturf(fighter.loc))
		return FALSE
	var/list/options = list()
	for(var/direction in GLOB.alldirs)
		var/turf/next = get_step(here, direction)
		if(!next || get_dist(next, target) > get_dist(here, target) || !next.can_cross_safely(fighter))
			continue
		options += next
	shuffle_inplace(options)
	for(var/turf/next as anything in options)
		if(bounty_ai_step(fighter, next))
			return TRUE
	return FALSE

/// A step straight back from `target`, now and then, on the leash
/proc/bounty_ai_back_off(datum/ai_controller/controller, mob/living/fighter, atom/target)
	if(world.time < controller.blackboard[BB_BOUNTY_BACKSTEP_AT] || !isturf(fighter.loc))
		return FALSE
	controller.set_blackboard_key(BB_BOUNTY_BACKSTEP_AT, world.time + BOUNTY_BACKSTEP_GAP)
	var/away_dir = get_dir(target, fighter)
	var/turf/away = away_dir && get_step(fighter, away_dir)
	if(!away || !bounty_ai_step(fighter, away))
		return FALSE
	fighter.face_atom(target)
	return TRUE

/// Forgets a wind-up in progress
/proc/bounty_ai_clear_windup(datum/ai_controller/controller)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_FROM)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_STAMINA)

// ===== THE STYLES =====

/**
 * How someone fights. Criminals, companions and the meek's holdout share these. The style puts a real
 * weapon (and its spares) on the outfit they are dressed in, and sets how they use it; what the weapon
 * does is the weapon's.
 */
/datum/bounty_style
	/// BOUNTY_STYLE_*
	var/key
	/// Fights at range: a gun, or something thrown
	var/ranged = FALSE
	/// What they carry, by tier: Petty, and Wanted or above (null for bare fists)
	var/weapon
	var/heavy_weapon
	/// What counts as their style's weapon when they look for it on themselves
	var/weapon_type
	/// The behaviour that keeps this style's distance while it shoots or throws
	var/ranged_behavior = /datum/ai_behavior/bounty_shoot
	/// Anyone closer than this and they step back (0: never)
	var/min_range = 0
	/// Between trigger pulls or throws
	var/interval = 1 SECONDS
	/// The telegraph before a shot or a throw, and what it says and sounds like
	var/windup = 0
	var/windup_message
	var/windup_sound
	/// The telegraph works a pump: a spent shell in the chamber doesn't need a reload
	var/pumps = FALSE
	/// Chance a blow is a shove instead
	var/shove_chance = 0

/**
 * Puts this style's weapon and spares on `outfit` (an instance), the heavier weapon if `heavy`. The
 * weapon is carried (a holster, a pocket, the back, a bag) unless it has nowhere to go on a body.
 */
/datum/bounty_style/proc/equip(datum/outfit/outfit, heavy = FALSE)
	return

/// The weapon this style carries at `heavy`
/datum/bounty_style/proc/weapon_for(heavy)
	return (heavy && heavy_weapon) || weapon

/// The ranged weapon in `fighter`'s hand that is ready to use, or null: a loaded (or pumpable) gun, a bottle
/datum/bounty_style/proc/ready_in_hand(mob/living/carbon/fighter)
	if(!ranged)
		return null
	for(var/obj/item/gun/gun in fighter.held_items)
		if(bounty_ai_gun_ready(gun, pumps))
			return gun
	return null

/// A ranged weapon of this style `fighter` carries that is worth drawing (one that fires, or that it can load), or null
/datum/bounty_style/proc/carried_ranged(mob/living/carbon/fighter)
	if(!ranged || !weapon_type)
		return null
	for(var/obj/item/gun/gun in fighter.get_all_contents_type(weapon_type))
		if(fighter.is_holding(gun) || !human_npc_can_draw(fighter, gun))
			continue
		if(bounty_ai_gun_ready(gun, pumps) || human_npc_can_reload(fighter, gun))
			return gun
	return null

/// Whether this shot needs the telegraph first
/datum/bounty_style/proc/needs_windup(datum/ai_controller/controller)
	return windup > 0

/// The telegraph: what they say, show and sound like before the shot
/datum/bounty_style/proc/telegraph(mob/living/carbon/fighter, atom/target, obj/item/weapon)
	fighter.face_atom(target)
	if(windup_message)
		fighter.visible_message(span_warning(replacetext(windup_message, "%USER", "[fighter]")))
	if(windup_sound)
		playsound(fighter, windup_sound, 50, TRUE)

/**
 * One step of a telegraphed attack. Returns TRUE when the attack goes now. Otherwise it is winding
 * up (the telegraph is shown at the start), or the wind-up just ended in a fumble: any hit taken during
 * it (damage, or more stamina loss) spoils the attack, and they try again a moment later.
 */
/datum/bounty_style/proc/windup_step(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	var/now = world.time
	var/until = controller.blackboard[BB_BOUNTY_WINDUP_UNTIL]
	if(until && now > until + BOUNTY_WINDUP_STALE)
		// Left over from an interrupted fight: it has to be done again
		bounty_ai_clear_windup(controller)
		until = null
	if(!until)
		if(!needs_windup(controller))
			return TRUE
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_UNTIL, now + windup)
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_FROM, now)
		controller.set_blackboard_key(BB_BOUNTY_WINDUP_STAMINA, fighter.getStaminaLoss())
		telegraph(fighter, target, weapon)
		return FALSE
	if(now < until)
		fighter.face_atom(target)
		return FALSE
	var/hit_at = controller.blackboard[BB_BOUNTY_HIT_AT]
	var/fumbled = (hit_at && hit_at >= controller.blackboard[BB_BOUNTY_WINDUP_FROM]) || fighter.getStaminaLoss() > controller.blackboard[BB_BOUNTY_WINDUP_STAMINA] + 1
	bounty_ai_clear_windup(controller)
	if(fumbled)
		fighter.visible_message(span_notice("[fighter] fumbles [weapon]!"))
		controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, now + BOUNTY_FUMBLE_PAUSE)
		return FALSE
	return TRUE

/**
 * The attack itself, with `weapon` in hand: a trigger pull at `target`, the player's way. Returns TRUE
 * if it went.
 */
/datum/bounty_style/proc/attack(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	var/obj/item/gun/gun = weapon
	if(!istype(gun))
		return FALSE
	if(gun.weapon_weight == WEAPON_HEAVY)
		bounty_ai_free_other_hand(fighter, gun)
	if(!human_npc_ready_item(fighter, gun))
		return FALSE
	fighter.zone_selected = human_npc_pick_aim_zone()
	return controller.ai_interact(target = target, combat_mode = TRUE)

/// Bare fists: a person's punch, and now and then a shove
/datum/bounty_style/brawler
	key = BOUNTY_STYLE_BRAWLER
	shove_chance = BOUNTY_BRAWLER_SHOVE_CHANCE

/// A knife in a pocket. Its cuts bleed, as a real one's do.
/datum/bounty_style/knife
	key = BOUNTY_STYLE_KNIFE
	weapon = /obj/item/knife
	heavy_weapon = /obj/item/knife/combat
	weapon_type = /obj/item/knife

/datum/bounty_style/knife/equip(datum/outfit/outfit, heavy = FALSE)
	bounty_outfit_carry(outfit, weapon_for(heavy))

/// A baseball bat. A bat has no slot to go in on a body, so it is in hand from the start.
/datum/bounty_style/club
	key = BOUNTY_STYLE_CLUB
	weapon = /obj/item/melee/baseball_bat
	heavy_weapon = /obj/item/melee/baseball_bat/ablative
	weapon_type = /obj/item/melee/baseball_bat

/datum/bounty_style/club/equip(datum/outfit/outfit, heavy = FALSE)
	outfit.r_hand = weapon_for(heavy)

/// A Stechkin in a shoulder holster, a spare magazine in a pocket
/datum/bounty_style/pistol
	key = BOUNTY_STYLE_PISTOL
	ranged = TRUE
	weapon = /obj/item/gun/ballistic/automatic/pistol/aps
	weapon_type = /obj/item/gun/ballistic/automatic/pistol/aps
	interval = BOUNTY_PISTOL_INTERVAL
	min_range = BOUNTY_PISTOL_MIN_RANGE
	windup = BOUNTY_PISTOL_WINDUP
	windup_message = "%USER raises a pistol."
	windup_sound = 'sound/items/weapons/gun/pistol/rack_small.ogg'

/datum/bounty_style/pistol/equip(datum/outfit/outfit, heavy = FALSE)
	var/obj/item/gun/ballistic/gun_type = weapon_for(heavy)
	outfit.belt = /obj/item/storage/belt/holster
	outfit.belt_contents = null
	LAZYADDASSOC(outfit.belt_contents, gun_type, 1)
	bounty_outfit_carry(outfit, initial(gun_type.accepted_magazine_type))

/// Only the first shot of a string needs the gun raised
/datum/bounty_style/pistol/needs_windup(datum/ai_controller/controller)
	var/last_shot = controller.blackboard[BB_BOUNTY_LAST_SHOT]
	return !last_shot || world.time - last_shot > BOUNTY_PISTOL_STRING_GAP

/// Buckshot: a pump shotgun on the back, shells on a bandolier. The pump is the telegraph before each blast.
/datum/bounty_style/shotgun
	key = BOUNTY_STYLE_SHOTGUN
	ranged = TRUE
	weapon = /obj/item/gun/ballistic/shotgun/lethal
	heavy_weapon = /obj/item/gun/ballistic/shotgun/automatic/combat/bounty
	weapon_type = /obj/item/gun/ballistic/shotgun
	ranged_behavior = /datum/ai_behavior/bounty_shoot/close
	interval = BOUNTY_SHOTGUN_INTERVAL
	windup = BOUNTY_SHOTGUN_WINDUP
	windup_message = "%USER pumps the shotgun."
	windup_sound = 'sound/items/weapons/gun/shotgun/rack.ogg'
	pumps = TRUE

/datum/bounty_style/shotgun/equip(datum/outfit/outfit, heavy = FALSE)
	outfit.back = weapon_for(heavy)
	outfit.belt = /obj/item/storage/belt/bandolier
	outfit.belt_contents = null
	LAZYADDASSOC(outfit.belt_contents, /obj/item/ammo_casing/shotgun/buckshot, BOUNTY_SHOTGUN_SHELLS)

/// The pump is real: a spent shell in the chamber is worked out by hand, which makes the rack's own sound
/datum/bounty_style/shotgun/telegraph(mob/living/carbon/fighter, atom/target, obj/item/weapon)
	fighter.face_atom(target)
	if(windup_message)
		fighter.visible_message(span_warning(replacetext(windup_message, "%USER", "[fighter]")))
	var/obj/item/gun/ballistic/gun = weapon
	if(istype(gun) && human_npc_gun_needs_rack(gun) && human_npc_ready_item(fighter, gun))
		gun.attack_self(fighter)
	else if(windup_sound)
		playsound(fighter, windup_sound, 50, TRUE)

/// Beer bottles from a satchel, thrown one at a time
/datum/bounty_style/bottle
	key = BOUNTY_STYLE_BOTTLE
	ranged = TRUE
	weapon = /obj/item/reagent_containers/cup/glass/bottle/beer
	weapon_type = /obj/item/reagent_containers/cup/glass/bottle
	ranged_behavior = /datum/ai_behavior/bounty_shoot/throw
	interval = BOUNTY_BOTTLE_INTERVAL
	min_range = BOUNTY_BOTTLE_MIN_RANGE
	windup = BOUNTY_BOTTLE_WINDUP
	windup_message = "%USER winds up to throw a bottle."

/datum/bounty_style/bottle/equip(datum/outfit/outfit, heavy = FALSE)
	if(!outfit.back)
		outfit.back = /obj/item/storage/backpack/satchel
	LAZYADDASSOC(outfit.backpack_contents, weapon, heavy ? BOUNTY_BOTTLES_WANTED : BOUNTY_BOTTLES_PETTY)

/datum/bounty_style/bottle/ready_in_hand(mob/living/carbon/fighter)
	for(var/obj/item/reagent_containers/cup/glass/bottle/bottle in fighter.held_items)
		if(bottle.isGlass)
			return bottle
	return null

/datum/bounty_style/bottle/carried_ranged(mob/living/carbon/fighter)
	for(var/obj/item/reagent_containers/cup/glass/bottle/bottle in fighter.get_all_contents_type(weapon_type))
		if(bottle.isGlass && !fighter.is_holding(bottle) && human_npc_can_draw(fighter, bottle))
			return bottle
	return null

/// A real throw: the bottle leaves the hand and flies, as a player's does. tg's bottle breaks on whoever it hits.
/datum/bounty_style/bottle/attack(mob/living/carbon/fighter, datum/ai_controller/controller, atom/target, obj/item/weapon)
	if(!human_npc_ready_item(fighter, weapon))
		return FALSE
	fighter.zone_selected = human_npc_pick_aim_zone()
	fighter.throw_mode_on(THROW_MODE_TOGGLE)
	controller.ai_interact(target = target, combat_mode = TRUE)
	// A click that didn't go through leaves throw mode on: the next click must not be a throw
	if(fighter.throw_mode)
		fighter.throw_mode_off(THROW_MODE_TOGGLE)
		return FALSE
	return !fighter.is_holding(weapon)

/**
 * The meek's little gun: a Makarov in a pocket and a spare magazine in a fanny pack. The volley is fired
 * one trigger pull at a time by the meek AI (bounty_ai_meek.dm).
 */
/datum/bounty_style/holdout
	key = BOUNTY_STYLE_HOLDOUT
	ranged = TRUE
	weapon = /obj/item/gun/ballistic/automatic/pistol
	weapon_type = /obj/item/gun/ballistic/automatic/pistol
	interval = BOUNTY_MEEK_PISTOL_GAP

/datum/bounty_style/holdout/equip(datum/outfit/outfit, heavy = FALSE)
	var/obj/item/gun/ballistic/gun_type = weapon
	bounty_outfit_carry(outfit, gun_type)
	outfit.belt = /obj/item/storage/belt/fannypack
	outfit.belt_contents = null
	LAZYADDASSOC(outfit.belt_contents, initial(gun_type.accepted_magazine_type), 1)

/**
 * Puts `item_type` somewhere `outfit` carries it: a free pocket, else the belt's pouch, else the bag.
 * Returns TRUE if it found a place.
 */
/proc/bounty_outfit_carry(datum/outfit/outfit, item_type)
	if(!istype(outfit) || !ispath(item_type))
		return FALSE
	if(!outfit.r_pocket)
		outfit.r_pocket = item_type
		return TRUE
	if(!outfit.l_pocket)
		outfit.l_pocket = item_type
		return TRUE
	if(outfit.belt && ispath(outfit.belt, /obj/item/storage))
		LAZYADDASSOC(outfit.belt_contents, item_type, 1)
		return TRUE
	if(outfit.back && ispath(outfit.back, /obj/item/storage))
		LAZYADDASSOC(outfit.backpack_contents, item_type, 1)
		return TRUE
	return FALSE

/**
 * The outfit a bounty fighter wears: plain clothes for `archetype` in `zone`, its tier's armour, its
 * style's weapon and spares, and `treatment` (a bruise pack, a stimpack) in a pocket.
 */
/proc/bounty_fighter_outfit(archetype, zone, tier, style_key, heavy = FALSE, treatment)
	var/datum/outfit/outfit = bounty_outfit_instance(bounty_plain_clothes(archetype, zone))
	if(!outfit)
		return null
	bounty_add_tier_armour(outfit, tier)
	var/datum/bounty_style/style = GLOB.bounty_styles[style_key]
	style?.equip(outfit, heavy)
	if(treatment)
		bounty_outfit_carry(outfit, treatment)
	return outfit

/// A Wanted criminal's combat shotgun, loaded with buckshot (tg's comes with rubber shot)
/obj/item/gun/ballistic/shotgun/automatic/combat/bounty
	accepted_magazine_type = /obj/item/ammo_box/magazine/internal/shot/com/bounty

/obj/item/ammo_box/magazine/internal/shot/com/bounty
	ammo_type = /obj/item/ammo_casing/shotgun/buckshot

// ===== ARMING =====

/**
 * In a fight with a target: keeps their style's weapon in hand. Draws it when the fight starts (a
 * holster, a pocket, the back, a bag), reloads a gun the player's way when it runs dry (the human NPC
 * base's reload; a shotgun shell by shell), or draws something else, or nothing and uses fists.
 */
/datum/ai_planning_subtree/bounty_arm

/datum/ai_planning_subtree/bounty_arm/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/fighter = controller.pawn
	if(!ishumannpc(fighter) || !bounty_ai_fighting(fighter) || !controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	if(HAS_TRAIT(fighter, TRAIT_HANDS_BLOCKED) || LAZYLEN(fighter.do_afters) || world.time < controller.blackboard[BB_HUMAN_NPC_ARMING_RETRY_AT])
		return
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style)
		return
	var/obj/item/to_draw
	if(style.ranged)
		if(style.ready_in_hand(fighter))
			return
		var/obj/item/gun/ballistic/gun = human_npc_held_gun(fighter)
		if(istype(gun) && human_npc_can_reload(fighter, gun))
			controller.queue_behavior(gun.internal_magazine ? /datum/ai_behavior/human_npc_reload/bounty_tube : /datum/ai_behavior/human_npc_reload)
			return SUBTREE_RETURN_FINISH_PLANNING
		to_draw = style.carried_ranged(fighter)
	else if(style.weapon_type)
		if(human_npc_held_melee_weapon(fighter))
			return
		to_draw = bounty_ai_carried(fighter, style.weapon_type)
		if(fighter.is_holding(to_draw))
			return
	else
		return
	if(!to_draw && !human_npc_held_melee_weapon(fighter))
		to_draw = human_npc_backup_weapon(fighter)
	if(!to_draw)
		return
	controller.set_blackboard_key(BB_HUMAN_NPC_DRAW_ITEM, to_draw)
	controller.queue_behavior(/datum/ai_behavior/human_npc_draw, BB_HUMAN_NPC_DRAW_ITEM)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * The human NPC base's reload, for a gun loaded through its tube (a shotgun): every shell it can fit,
 * one at a time, then the pump.
 */
/datum/ai_behavior/human_npc_reload/bounty_tube
	give_up_after = 15 SECONDS

/datum/ai_behavior/human_npc_reload/bounty_tube/perform(seconds_per_tick, datum/ai_controller/controller)
	var/mob/living/carbon/npc = controller.pawn
	var/obj/item/gun/ballistic/gun = human_npc_held_gun(npc)
	if(!istype(gun) || !gun.internal_magazine || world.time >= controller.blackboard[BB_HUMAN_NPC_RELOAD_UNTIL])
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	var/obj/item/spent = human_npc_spent_ammo_in_hand(npc, gun)
	if(spent)
		npc.dropItemToGround(spent, force = TRUE)
		return AI_BEHAVIOR_DELAY
	var/obj/item/ammo_box/magazine/tube = gun.magazine
	if(tube && tube.ammo_count(FALSE) < tube.max_ammo)
		var/obj/item/ammo = human_npc_find_ammo(npc, gun)
		if(ammo)
			if(!npc.is_holding(ammo))
				if(!human_npc_take_in_hand(npc, ammo))
					return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
				return AI_BEHAVIOR_DELAY
			if(!human_npc_ready_item(npc, ammo))
				return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
			controller.ai_interact(target = gun, combat_mode = FALSE)
			return AI_BEHAVIOR_DELAY
	if(human_npc_gun_needs_rack(gun))
		if(!human_npc_ready_item(npc, gun))
			return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
		controller.ai_interact(target = gun, combat_mode = FALSE)
		return AI_BEHAVIOR_DELAY
	if(gun.can_shoot())
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED
	return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED

// ===== SHOOTING AND THROWING =====

/// In a fight with a ranged style and its weapon ready in hand: shoots or throws, at the style's distance
/datum/ai_planning_subtree/bounty_ranged

/datum/ai_planning_subtree/bounty_ranged/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/fighter = controller.pawn
	if(!bounty_ai_fighting(fighter) || !controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style?.ranged || HAS_TRAIT(fighter, TRAIT_HANDS_BLOCKED) || !style.ready_in_hand(fighter))
		return
	controller.queue_behavior(style.ranged_behavior, BB_BASIC_MOB_CURRENT_TARGET, BB_TARGETING_STRATEGY)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * Shoots (or throws) at the target from the style's distance: closes in while it can't see them, steps
 * back from anyone inside the style's min_range, steps aside for anyone it may not hit in its line,
 * telegraphs, then pulls the trigger (or throws) once per the style's interval. Planning carries on
 * meanwhile, so a new target, a retreat or a call for help is picked up mid-fight.
 */
/datum/ai_behavior/bounty_shoot
	// Often enough that a style fires at its own pace and its wind-up is never stretched
	action_cooldown = 0.1 SECONDS
	behavior_flags = AI_BEHAVIOR_REQUIRE_MOVEMENT | AI_BEHAVIOR_MOVE_AND_PERFORM | AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION
	required_distance = BOUNTY_PISTOL_RANGE

/datum/ai_behavior/bounty_shoot/setup(datum/ai_controller/controller, target_key, targeting_strategy_key)
	. = ..()
	var/atom/target = controller.blackboard[target_key]
	if(QDELETED(target))
		return FALSE
	set_movement_target(controller, target)

/datum/ai_behavior/bounty_shoot/perform(seconds_per_tick, datum/ai_controller/controller, target_key, targeting_strategy_key)
	var/mob/living/carbon/fighter = controller.pawn
	var/atom/target = controller.blackboard[target_key]
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[targeting_strategy_key])
	if(QDELETED(target) || !strategy?.can_attack(fighter, target, BOUNTY_FIGHT_VISION))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	var/datum/ai_controller/basic_controller/bounty/brain = controller
	if(istype(brain) && !brain.may_shoot(target))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	var/obj/item/weapon = style?.ready_in_hand(fighter)
	if(!weapon || HAS_TRAIT(fighter, TRAIT_HANDS_BLOCKED))
		// Dry or empty-handed: the arm subtree reloads or draws, or they fight with their fists
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_SUCCEEDED
	if(!can_see(fighter, target, required_distance))
		return AI_BEHAVIOR_INSTANT
	var/winding = !!controller.blackboard[BB_BOUNTY_WINDUP_UNTIL]
	if(style.min_range && get_dist(fighter, target) < style.min_range && !winding)
		bounty_ai_back_off(controller, fighter, target)
	if(bounty_ai_line_blocked(fighter, target))
		bounty_ai_sidestep(fighter, target)
		return AI_BEHAVIOR_DELAY
	if(!winding && world.time < controller.blackboard[BB_BOUNTY_NEXT_SHOT])
		return AI_BEHAVIOR_DELAY
	if(!style.windup_step(fighter, controller, target, weapon))
		return AI_BEHAVIOR_DELAY
	if(style.attack(fighter, controller, target, weapon))
		controller.set_blackboard_key(BB_BOUNTY_LAST_SHOT, world.time)
	controller.set_blackboard_key(BB_BOUNTY_NEXT_SHOT, world.time + style.interval)
	return AI_BEHAVIOR_DELAY

/// A wind-up cut short never carries over: the next shot telegraphs again
/datum/ai_behavior/bounty_shoot/finish_action(datum/ai_controller/controller, succeeded, target_key, targeting_strategy_key)
	. = ..()
	bounty_ai_clear_windup(controller)

/// The shotgun closes in to BOUNTY_SHOTGUN_RANGE
/datum/ai_behavior/bounty_shoot/close
	required_distance = BOUNTY_SHOTGUN_RANGE

/// The bottle thrower stays BOUNTY_BOTTLE_RANGE off
/datum/ai_behavior/bounty_shoot/throw
	required_distance = BOUNTY_BOTTLE_RANGE

// ===== MELEE =====

/**
 * In a fight with a target and no ranged weapon ready: walks up and hits with the best melee weapon in
 * hand, or a fist (the human NPC base's melee). A brawler now and then shoves instead.
 */
/datum/ai_planning_subtree/bounty_melee

/datum/ai_planning_subtree/bounty_melee/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/fighter = controller.pawn
	if(!bounty_ai_fighting(fighter) || !controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(style?.ranged && style.ready_in_hand(fighter))
		return
	controller.queue_behavior(/datum/ai_behavior/basic_melee_attack/human_npc/bounty, BB_BASIC_MOB_CURRENT_TARGET, BB_TARGETING_STRATEGY, BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION)
	return SUBTREE_RETURN_FINISH_PLANNING

/// The human NPC base's melee (tg's, through a click), with the brawler's shove: a real right click with an empty hand
/datum/ai_behavior/basic_melee_attack/human_npc/bounty

/datum/ai_behavior/basic_melee_attack/human_npc/bounty/perform(seconds_per_tick, datum/ai_controller/controller, target_key, targeting_strategy_key, hiding_location_key)
	var/mob/living/carbon/fighter = controller.pawn
	var/mob/living/target = controller.blackboard[target_key]
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style?.shove_chance || !isliving(target) || !fighter.CanReach(target) || world.time < fighter.next_move)
		return ..()
	var/attack_at = controller.blackboard[BB_BASIC_MOB_MELEE_COOLDOWN_TIMER]
	if(isnull(attack_at) || attack_at > world.time || !prob(style.shove_chance))
		return ..()
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[targeting_strategy_key])
	if(!strategy?.can_attack(fighter, target) || !human_npc_ready_empty_hand(fighter))
		return ..()
	fighter.zone_selected = BODY_ZONE_CHEST
	controller.ai_interact(target = target, combat_mode = TRUE, modifiers = list(RIGHT_CLICK = TRUE))
	return AI_BEHAVIOR_DELAY
