// =========================================================================
// THE KINGPIN
// =========================================================================

/**
 * The kingpin: P2's criminal body with his own numbers. He sits on the sofa and never leaves it,
 * talks across the table, and in a shootout fires a revolver after a visible aim. His crew
 * (kingpin_crew) runs the goons, the room and his business. He may be on a posting or on none.
 */
/mob/living/basic/bounty_criminal/kingpin
	name = "kingpin"
	desc = "Sharp suit, cold eyes. He runs this lounge, and his people are never far away."
	maxHealth = BOUNTY_KINGPIN_HEALTH
	health = BOUNTY_KINGPIN_HEALTH
	// His crew drives him; no criminal AI (P3) is ever put on him.
	ai_controller = null
	/// His goons, the shootout, the room and the job he holds (/datum/bounty_kingpin_crew). He deletes it.
	var/datum/bounty_kingpin_crew/kingpin_crew
	/// Rounds left in his revolver (a full cylinder at Initialize)
	var/kingpin_rounds = 0
	/// world.time he may start his next aim
	var/kingpin_next_aim_at = 0
	/// The timer that fires the aimed shot, while he aims
	var/kingpin_aim_timer
	/// The aim line (/datum/beam), while he aims
	var/datum/beam/kingpin_aim_beam
	/// Weakref to who he is aiming at
	var/datum/weakref/kingpin_aim_target
	/// Weakref of anyone who hit him -> how many times: he shoots whoever hurt him most
	var/list/kingpin_hits = list()
	/// world.time of his next surrender roll
	var/kingpin_next_surrender_roll = 0
	/// The timer fading his body out, when no posting holds it (kingpin_start_fade())
	var/kingpin_fade_timer
	/// Between two of his lines
	COOLDOWN_DECLARE(kingpin_say_cooldown)

/mob/living/basic/bounty_criminal/kingpin/Initialize(mapload)
	. = ..()
	kingpin_rounds = bounty_kingpin_revolver().magazine

/mob/living/basic/bounty_criminal/kingpin/Destroy()
	kingpin_cancel_aim()
	deltimer(kingpin_fade_timer)
	kingpin_fade_timer = null
	QDEL_NULL(kingpin_crew)
	kingpin_hits.Cut()
	// Deleted for any reason (the pad, a posting's cleanup, an admin): he is gone for the round
	SSbounty_kingpin.kingpin_removed(src)
	return ..()

// Dead is gone for the round. On the board, his body is there to bring in; killed off it, there is nothing to claim and it fades.
/mob/living/basic/bounty_criminal/kingpin/death(gibbed)
	. = ..()
	SSbounty_kingpin.kingpin_died(src)
	if(QDELETED(src))
		return
	// A chair holds a body upright: he slumps off his sofa
	if(istype(buckled, /obj/structure/chair))
		buckled.unbuckle_mob(src, force = TRUE)
	if(!kingpin_posting())
		kingpin_start_fade()

// His numbers on P2's body
/mob/living/basic/bounty_criminal/kingpin/body_recovery_time()
	return BOUNTY_KINGPIN_RECOVERY

/mob/living/basic/bounty_criminal/kingpin/body_rally_time()
	return BOUNTY_KINGPIN_RALLY

/mob/living/basic/bounty_criminal/kingpin/body_stamina_pool()
	return BOUNTY_KINGPIN_STAMINA

/mob/living/basic/bounty_criminal/kingpin/bounty_outfit()
	return kingpin_crew?.crew_armed ? /datum/outfit/bounty_kingpin/armed : /datum/outfit/bounty_kingpin

// He is always at the sofa; nothing else sets what he is doing.
/mob/living/basic/bounty_criminal/kingpin/start_activity(kind, atom/anchor)
	return

// Shown a warrant, or someone reached for his wrists: his confront line, and nothing more (P6, P2)
/mob/living/basic/bounty_criminal/kingpin/on_confronted(mob/user)
	INVOKE_ASYNC(src, PROC_REF(kingpin_confronted), user)

/mob/living/basic/bounty_criminal/kingpin/identity_voice()
	return BOUNTY_ARCHETYPE_KINGPIN

/// His lines come from his own dialogue file first; anything it has no lines for goes to P1's
/mob/living/basic/bounty_criminal/kingpin/bounty_say(context, list/values, force = FALSE)
	if(QDELETED(src) || stat == DEAD || !istext(context))
		return FALSE
	if(!length(bounty_kingpin_lines("kingpin", context)))
		return ..()
	if(!force && !COOLDOWN_FINISHED(src, kingpin_say_cooldown))
		return FALSE
	var/list/line_values = list("{name}" = record?.alias || name)
	for(var/placeholder in values)
		line_values[placeholder] = values[placeholder]
	var/line = bounty_kingpin_line("kingpin", context, line_values)
	if(!line)
		return FALSE
	COOLDOWN_START(src, kingpin_say_cooldown, BOUNTY_KINGPIN_SAY_COOLDOWN)
	say(line, forced = "bounty kingpin")
	return TRUE

/mob/living/basic/bounty_criminal/kingpin/examine(mob/user)
	. = ..()
	if(kingpin_can_talk())
		. += span_notice("[p_They()] look[p_s()] ready to talk business.")

// Every hit that gets through: with his crew down, he may give up
/mob/living/basic/bounty_criminal/kingpin/adjust_health(amount, updating_health = TRUE, forced = FALSE)
	var/health_before = health
	. = ..()
	if(amount > 0 && !forced)
		kingpin_consider_surrender(health_before)
		// Hurt while his crew is at ease, by anything at all: they find out who
		kingpin_crew?.member_hurt(src)

// An open hand in reach of him starts the talk
/mob/living/basic/bounty_criminal/kingpin/attack_hand(mob/living/carbon/human/user, list/modifiers)
	if(istype(user) && !user.combat_mode && !LAZYACCESS(modifiers, RIGHT_CLICK) && !is_restrained() && kingpin_can_talk())
		INVOKE_ASYNC(src, PROC_REF(kingpin_open_talk), user)
		return TRUE
	return ..()

/mob/living/basic/bounty_criminal/kingpin/ranged_attack_hand(mob/living/user, list/modifiers)
	if(!kingpin_in_talk_range(user))
		return FALSE
	if(!kingpin_can_talk())
		balloon_alert(user, "not talking now!")
		return TRUE
	INVOKE_ASYNC(src, PROC_REF(kingpin_open_talk), user)
	return TRUE

/// His posting, if he is on one (/datum/criminal_bounty/kingpin): none while he just sits in his lounge
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_posting()
	RETURN_TYPE(/datum/criminal_bounty/kingpin)
	var/datum/criminal_bounty/kingpin/posting = posting()
	return istype(posting) ? posting : null

/// Whether he is in his lounge: on a turf (not in a locker or a bag) within his goons' leash of his seat
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_on_leash()
	var/turf/seat = kingpin_crew?.crew_seat
	var/turf/here = get_turf(src)
	if(!seat || !here || !isturf(loc))
		return FALSE
	return here.z == seat.z && get_dist(here, seat) <= BOUNTY_GOON_LEASH

/// A posting let go of him in his lounge: his people see to him. The cuffs come off (onto the floor) and he stops giving up; a downed one gets up in his own time.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_back_to_business()
	if(is_restrained())
		body_remove_cuffs()
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SURRENDERED, BOUNTY_TRAIT)

/// His body, with no posting to bring it in for, fades after BOUNTY_GOON_FADE as a goon's does (once)
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_start_fade()
	if(kingpin_fade_timer || stat != DEAD || QDELETED(src))
		return
	kingpin_fade_timer = addtimer(CALLBACK(src, PROC_REF(kingpin_fade_out)), BOUNTY_GOON_FADE, TIMER_STOPPABLE | TIMER_DELETE_ME)

/// The body fades away, unless a posting holds it for the pad. Taken away, not destroyed: no proof of death.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_fade_out()
	kingpin_fade_timer = null
	if(QDELETED(src) || kingpin_posting())
		return
	ADD_TRAIT(src, TRAIT_BOUNTY_REMOVED, BOUNTY_KINGPIN_TRAIT)
	pulledby?.stop_pulling()
	animate(src, alpha = 0, time = BOUNTY_GOON_FADE_OUT)
	QDEL_IN(src, BOUNTY_GOON_FADE_OUT)

/**
 * Takes him back to his sofa when he's been moved off it and is free again: a step at a time within
 * his crew's leash, a walk from further off, and put straight back from another level or too far to
 * walk, when nobody is watching him (L5).
 */
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_go_home()
	var/turf/seat = kingpin_crew?.crew_seat
	var/turf/here = get_turf(src)
	if(!seat || !here || here == seat || buckled || !kingpin_able() || !isturf(loc) || pulledby)
		return FALSE
	if(here.z == seat.z && get_dist(here, seat) <= BOUNTY_GOON_LEASH)
		var/turf/next = get_step_to(src, seat)
		if(next)
			Move(next, get_dir(src, next))
		return TRUE
	if(here.z == seat.z && get_dist(here, seat) <= BOUNTY_KINGPIN_WALK_HOME_MAX)
		if(world.time >= kingpin_crew.crew_next_home_walk)
			kingpin_crew.crew_next_home_walk = world.time + BOUNTY_KINGPIN_WALK_HOME_GAP
			GLOB.move_manager.jps_move(src, seat, delay = 3, timeout = BOUNTY_KINGPIN_WALK_HOME_GAP, repath_delay = 2 SECONDS, max_path_length = BOUNTY_KINGPIN_WALK_HOME_MAX * 2, simulated_only = TRUE, priority = MOVEMENT_ABOVE_SPACE_PRIORITY)
		return TRUE
	for(var/mob/living/watcher in viewers(world.view, src))
		if(watcher.client && watcher != src)
			return FALSE
	forceMove(seat)
	return kingpin_sit()

/// Sits him on the sofa at his seat, facing the way it faces. TRUE if he is sitting there now.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_sit()
	if(buckled)
		return istype(buckled, /obj/structure/chair)
	if(stat != CONSCIOUS || downed || is_restrained() || body_is_stunned())
		return FALSE
	var/turf/seat = kingpin_crew?.crew_seat || get_turf(src)
	if(get_turf(src) != seat)
		return FALSE
	var/obj/structure/chair/sofa = locate(/obj/structure/chair) in seat
	if(!sofa || sofa.has_buckled_mobs())
		return FALSE
	if(!sofa.buckle_mob(src, force = TRUE))
		return FALSE
	setDir(sofa.dir)
	return TRUE

// ===== TALKING =====

/// Whether he'll talk now: awake, free, on his feet, and no shootout on
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_can_talk()
	if(stat != CONSCIOUS || downed || is_restrained() || body_is_stunned())
		return FALSE
	return kingpin_crew?.crew_state == BOUNTY_KINGPIN_CALM

/// Whether `user` is close enough to talk to him: across the table, in sight, awake
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_in_talk_range(mob/living/user)
	if(!isliving(user) || QDELETED(user) || user.stat != CONSCIOUS || user.z != z)
		return FALSE
	return get_dist(src, user) <= BOUNTY_KINGPIN_TALK_RANGE && can_see(user, src, BOUNTY_KINGPIN_TALK_RANGE)

/// The radial's validity check
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_talk_check(mob/living/user)
	return kingpin_can_talk() && kingpin_in_talk_range(user)

/// Whether `user`'s crew has a live reason to confront him: his posting is up and open, and their ship took it from the board
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_confrontable(mob/living/user)
	var/datum/criminal_bounty/kingpin/posting = kingpin_posting()
	if(!posting?.is_open())
		return FALSE
	return posting.is_hunting(get_crew_ship(user))

/// The talk radial for `user`. "We're here for you" and "Walk away" only while their crew is hunting him; "I'll take it" only while he has offered their crew his job. Sleeps.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_open_talk(mob/living/user)
	if(!kingpin_talk_check(user))
		return
	var/list/options = list()
	var/confrontable = kingpin_confrontable(user)
	if(confrontable)
		options[BOUNTY_KINGPIN_TALK_HERE] = image(icon = 'voidcrew/icons/hud/radial.dmi', icon_state = "radial_crime")
	options[BOUNTY_KINGPIN_TALK_WORK] = image(icon = 'icons/hud/radial.dmi', icon_state = "radial_talk")
	if(kingpin_crew?.job_offered_to(get_crew_ship(user)))
		options[BOUNTY_KINGPIN_TALK_TAKE_JOB] = image(icon = 'icons/hud/radial.dmi', icon_state = "radial_yes")
	// Walking away only means something while there's a price on him
	if(confrontable)
		options[BOUNTY_KINGPIN_TALK_WALK] = image(icon = 'voidcrew/icons/hud/radial.dmi', icon_state = "radial_home")
	var/choice = show_radial_menu(user, src, options, custom_check = CALLBACK(src, PROC_REF(kingpin_talk_check), user), tooltips = TRUE)
	if(!choice || !kingpin_talk_check(user))
		return
	// The bounty could have closed or moved to another crew while the radial was open
	if(choice == BOUNTY_KINGPIN_TALK_HERE && !kingpin_confrontable(user))
		return
	kingpin_talk(user, choice)

/**
 * `user` picks `option` (BOUNTY_KINGPIN_TALK_*): they say their line and he answers. The shootout
 * starts, his job is offered or taken, or nothing happens. Returns TRUE if he listened. Making a job
 * can sleep.
 */
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_talk(mob/living/user, option)
	if(!kingpin_can_talk() || QDELETED(user))
		return FALSE
	bounty_kingpin_hunter_says(user, option)
	switch(option)
		if(BOUNTY_KINGPIN_TALK_HERE)
			// He says his confront line as the goons reach for their guns
			if(!kingpin_crew?.start_shootout(user, TRUE))
				bounty_say("confront", force = TRUE)
		if(BOUNTY_KINGPIN_TALK_WORK)
			kingpin_offer_work(user)
		if(BOUNTY_KINGPIN_TALK_TAKE_JOB)
			kingpin_take_job(user)
		if(BOUNTY_KINGPIN_TALK_WALK)
			bounty_say("walk_away", force = TRUE)
		else
			return FALSE
	log_game("BOUNTY: [key_name(user)] told [src] \"[option]\" at [AREACOORD(src)]")
	return TRUE

/// Shown a warrant or reached for: his confront line, and no fight
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_confronted(mob/living/user)
	if(!kingpin_can_talk() || QDELETED(user))
		return
	bounty_say("confront", force = TRUE)

// ===== HIS BUSINESS =====

/// The name he goes by on his jobs: his alias, else his name ("The Accountant")
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_job_name()
	return capitalize(record?.alias || record?.name || name)

/**
 * Why he has no work for `user`, as the dialogue context he answers with, or null if he has (he
 * holds a job, or has just made one): they shot at his people, they fly with no crew, their crew
 * fought his people, someone is already running his job, or he has none to give. May make his job,
 * which can sleep.
 */
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_work_refusal(mob/living/user)
	var/datum/bounty_kingpin_crew/crew = kingpin_crew
	if(!crew)
		return "no_work"
	if(crew.is_hunter(user))
		return "no_work_hostile"
	var/obj/structure/overmap/ship/ship = get_crew_ship(user)
	if(!ship)
		return "no_work_drifter"
	// Anyone whose crew shot at his people: nobody on that ship works for him
	if(crew.ship_fought(ship))
		return "no_work_hostile"
	if(crew.job())
		return null
	if(!mission_type_within_limit(BOUNTY_KINGPIN_JOB))
		return "no_work_taken"
	if(!crew.make_job())
		return "no_work"
	return null

/// "Got any work?": he offers `user`'s crew the job he holds, for BOUNTY_KINGPIN_OFFER_TIME, or says why not. Returns TRUE if he offered it. Sleeps.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_offer_work(mob/living/user)
	var/refusal = kingpin_work_refusal(user)
	var/datum/bounty_kingpin_crew/crew = kingpin_crew
	if(QDELETED(src) || !crew)
		return FALSE
	if(refusal)
		bounty_say(refusal, force = TRUE)
		return FALSE
	var/obj/structure/overmap/ship/ship = get_crew_ship(user)
	var/again = crew.job_offered_to(ship)
	crew.offer_job(ship)
	bounty_say(again ? "work_repeat" : "work_offer", list("{job}" = crew.job_words()), force = TRUE)
	return TRUE

/**
 * "I'll take it": `user`'s crew takes the job he offered them, through the ship's own accept, as the
 * trader's board does (ship.accept_mission()). Their ship and everyone on it then work for him
 * (SSbounty_kingpin.kingpin_bind()): none of them can hunt him or turn him in. He makes another job
 * if the round's limit allows. Returns the job, or null. Sleeps.
 */
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_take_job(mob/living/user)
	var/datum/bounty_kingpin_crew/crew = kingpin_crew
	var/obj/structure/overmap/ship/ship = get_crew_ship(user)
	var/datum/mission/job = crew?.job()
	if(!job || !crew.job_offered_to(ship))
		// Beaten to it by another crew he offered it to: it's spoken for
		bounty_say((!job && !mission_type_within_limit(BOUNTY_KINGPIN_JOB)) ? "no_work_taken" : "no_work_yet", force = TRUE)
		return null
	var/refusal = kingpin_work_refusal(user)
	if(refusal)
		bounty_say(refusal, force = TRUE)
		return null
	if(!mission_type_within_limit(job.type, job))
		bounty_say("no_work_taken", force = TRUE)
		return null
	if(length(ship.active_missions) >= ship.max_missions)
		bounty_say("no_work_busy", force = TRUE)
		return null
	// The trader's accept path, so the limits and the bookkeeping all apply
	ship.available_missions += job
	var/result = ship.accept_mission(job)
	if(result != TRUE)
		ship.available_missions -= job
		// It couldn't start (its site went bad): he makes a fresh one next time he's asked
		crew.drop_job()
		balloon_alert(user, "[result]")
		bounty_say("no_work", force = TRUE)
		return null
	crew.job_taken(job)
	SSbounty_kingpin.kingpin_bind(ship, user)
	bounty_say("job_taken", force = TRUE)
	crew.goons_relax()
	log_game("BOUNTY: [key_name(user)] of the [ship.name] took [src]'s job ([job.name]) at [AREACOORD(src)]")
	// Another only when the round's limit allows it (one Drug Run at a time)
	crew.make_job()
	return job

// ===== HIS REVOLVER =====

/// His revolver: the one in his hand, whose rounds and cylinder are his (bounty_real_weapon())
/proc/bounty_kingpin_revolver()
	return bounty_real_weapon(BOUNTY_KINGPIN_REVOLVER)

/// Whether he can shoot now: awake, not down, not cuffed, not stunned, not given up
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_able()
	if(stat != CONSCIOUS || downed || is_restrained() || body_is_stunned())
		return FALSE
	return !HAS_TRAIT(src, TRAIT_INCAPACITATED)

/// He thumbs the hammer back and aims at `target`: a visible line for BOUNTY_KINGPIN_REVOLVER_AIM, then the shot
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_start_aim(mob/living/target)
	kingpin_cancel_aim()
	kingpin_next_aim_at = world.time + BOUNTY_KINGPIN_REVOLVER_COOLDOWN
	kingpin_aim_target = WEAKREF(target)
	var/atom/aim_at = kingpin_crew?.shot_target(target) || target
	kingpin_aim_beam = Beam(aim_at, icon_state = "infrared", time = BOUNTY_KINGPIN_REVOLVER_AIM, beam_color = COLOR_RED)
	visible_message(span_danger("[src] thumbs the hammer back and aims at [target]!"), vision_distance = BOUNTY_KINGPIN_SIGHT)
	playsound(src, 'sound/items/weapons/gun/general/ballistic_click.ogg', 60, TRUE)
	kingpin_aim_timer = addtimer(CALLBACK(src, PROC_REF(kingpin_fire)), BOUNTY_KINGPIN_REVOLVER_AIM, TIMER_STOPPABLE | TIMER_DELETE_ME)

/// The aim is done: he fires if he still can and still sees them. A stun in the meantime spoils it.
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_fire()
	kingpin_aim_timer = null
	var/mob/living/target = kingpin_aim_target?.resolve()
	kingpin_aim_target = null
	QDEL_NULL(kingpin_aim_beam)
	var/datum/bounty_kingpin_crew/crew = kingpin_crew
	if(!crew || crew.crew_state != BOUNTY_KINGPIN_FIGHTING)
		return FALSE
	if(!kingpin_able())
		if(stat == CONSCIOUS)
			visible_message(span_notice("[src] fumbles the shot."), vision_distance = COMBAT_MESSAGE_RANGE)
		return FALSE
	if(!crew.valid_target(target) || !bounty_kingpin_clear_shot(src, target))
		return FALSE
	kingpin_rounds--
	bounty_kingpin_shoot(src, crew.shot_target(target), bounty_kingpin_revolver(), crew)
	return TRUE

/// Drops his aim, if he has one
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_cancel_aim()
	if(kingpin_aim_timer)
		deltimer(kingpin_aim_timer)
		kingpin_aim_timer = null
	kingpin_aim_target = null
	QDEL_NULL(kingpin_aim_beam)

/// He reloads: BOUNTY_KINGPIN_REVOLVER_RELOAD with nothing fired, a window for the hunters
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_reload()
	kingpin_rounds = bounty_kingpin_revolver().magazine
	kingpin_next_aim_at = world.time + BOUNTY_KINGPIN_REVOLVER_RELOAD
	visible_message(span_notice("[src] breaks open [p_their()] revolver and reloads."), vision_distance = COMBAT_MESSAGE_RANGE)
	playsound(src, 'sound/items/weapons/gun/revolver/load_bullet.ogg', 50, TRUE)
	INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), "reload")

/// He picks who to shoot among `visible`: whoever hit him most, else the nearest
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_choose_target(list/visible)
	var/mob/living/best
	var/best_hits = -1
	var/best_dist = INFINITY
	for(var/mob/living/candidate as anything in visible)
		var/hits = kingpin_hits[candidate.weak_reference] || 0
		var/dist = get_dist(src, candidate)
		if(hits > best_hits || (hits == best_hits && dist < best_dist))
			best = candidate
			best_hits = hits
			best_dist = dist
	return best

/// Someone hit him: they count toward who he shoots first
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_note_hit(mob/living/attacker)
	if(!isliving(attacker))
		return
	var/datum/weakref/ref = WEAKREF(attacker)
	kingpin_hits[ref] = (kingpin_hits[ref] || 0) + 1

// ===== GIVING UP =====

/**
 * After a hit that got through: with his crew down and his health at or below
 * BOUNTY_KINGPIN_SURRENDER_BELOW percent, he may give up. BOUNTY_KINGPIN_SURRENDER_FIRST on the hit
 * that crosses the line, BOUNTY_KINGPIN_SURRENDER_LATER on later hits, one roll per
 * BOUNTY_KINGPIN_SURRENDER_GAP. Never while rallying. Doesn't sleep.
 */
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_consider_surrender(health_before)
	if(stat != CONSCIOUS || downed || is_restrained() || HAS_TRAIT(src, TRAIT_BOUNTY_SURRENDERED) || body_is_rallying())
		return FALSE
	if(!kingpin_crew?.crew_down())
		return FALSE
	var/line = maxHealth * BOUNTY_KINGPIN_SURRENDER_BELOW / 100
	if(health > line)
		return FALSE
	var/chance = BOUNTY_KINGPIN_SURRENDER_FIRST
	if(health_before <= line)
		if(world.time < kingpin_next_surrender_roll)
			return FALSE
		chance = BOUNTY_KINGPIN_SURRENDER_LATER
	kingpin_next_surrender_roll = world.time + BOUNTY_KINGPIN_SURRENDER_GAP
	if(!prob(chance))
		return FALSE
	kingpin_surrender()
	return TRUE

/// He gives up: P2 reads it as stunned, so he can be cuffed, and he fires no more
/mob/living/basic/bounty_criminal/kingpin/proc/kingpin_surrender()
	if(HAS_TRAIT(src, TRAIT_BOUNTY_SURRENDERED))
		return
	kingpin_cancel_aim()
	ADD_TRAIT(src, TRAIT_BOUNTY_SURRENDERED, BOUNTY_TRAIT)
	visible_message(span_notice("[src] puts [p_their()] hands up."), vision_distance = BOUNTY_KINGPIN_SIGHT)
	INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), "surrender", null, TRUE)

// =========================================================================
// THE GOONS
// =========================================================================

/**
 * # Kingpin goon
 *
 * One of the kingpin's crew: not a bounty, pays nothing, carries nothing. Before a shootout they
 * idle at their posts (smoke, drink, murmur, watch the room); in one, their crew
 * (/datum/bounty_kingpin_crew) moves them and fires their simulated guns. Turrets leave them alone
 * (FACTION_TURRET). Their bodies fade after BOUNTY_GOON_FADE.
 */
/mob/living/basic/bounty_kingpin_goon
	name = "goon"
	desc = "One of the kingpin's people. Good suit, bad attitude."
	icon = 'icons/mob/simple/simple_human.dmi'
	unique_name = FALSE
	maxHealth = BOUNTY_GOON_HEALTH
	health = BOUNTY_GOON_HEALTH
	speed = 1
	mob_biotypes = MOB_ORGANIC | MOB_HUMANOID
	mob_size = MOB_SIZE_HUMAN
	sentience_type = SENTIENCE_BOSS
	faction = list(FACTION_BOUNTY_KINGPIN, FACTION_TURRET)
	density = TRUE
	move_resist = MOVE_FORCE_VERY_STRONG
	// The body stays until it fades; nothing drops
	basic_mob_flags = NONE
	status_flags = CANPUSH | CANSTUN | CANKNOCKDOWN
	// P2's pattern: a pool of 100 and a coefficient, or the stamcrit ends the moment it starts (M1)
	max_stamina = BOUNTY_GOON_MAX_STAMINA
	stamina_crit_threshold = BOUNTY_GOON_STAMCRIT_AT
	mobility_flags = MOBILITY_FLAGS_REST_CAPABLE_DEFAULT
	rotate_on_lying = TRUE
	blood_volume = BLOOD_VOLUME_NORMAL
	unsuitable_atmos_damage = 0
	unsuitable_cold_damage = 0
	unsuitable_heat_damage = 0
	death_message = "seizes up and falls limp, their eyes dead and lifeless..."
	response_help_continuous = "taps"
	response_help_simple = "tap"
	ai_controller = null
	/// BOUNTY_GOON_WEAPON_*
	var/goon_weapon = BOUNTY_GOON_WEAPON_PISTOL
	/// Where they stand, or sit, when there is no fight
	var/turf/goon_post
	/// The way they face at their post
	var/goon_post_dir = SOUTH
	/// Weakref to their crew (/datum/bounty_kingpin_crew)
	var/datum/weakref/goon_crew_ref
	/// Weakref to who they are shooting at
	var/datum/weakref/goon_target_ref
	/// Rounds (or shells) left before a reload
	var/goon_rounds = 0
	/// world.time they may fire next
	var/goon_next_fire_at = 0
	/// world.time a fumble ends
	var/goon_fumbled_until = 0
	/// The wind-up timer for a burst or a blast, while it runs
	var/goon_windup_timer
	/// world.time of their next step
	var/goon_next_move_at = 0
	/// Running away: he fell and they don't want to die for him
	var/goon_fleeing = FALSE
	/// Walking out: their crew is gone
	var/goon_leaving = FALSE
	/// Their gun is out (their worn look)
	var/goon_armed = FALSE
	/// Which of the look pool's faces they have
	var/goon_look_number = 1
	/// The timer fading their body out
	var/goon_fade_timer
	/// Weakref to the chair at their post, if they sit
	var/datum/weakref/goon_chair_ref

/mob/living/basic/bounty_kingpin_goon/Initialize(mapload)
	. = ..()
	// Their own copy: 5 disabler hits (30 each) fill the pool of BOUNTY_GOON_MAX_STAMINA
	damage_coeff = damage_coeff.Copy()
	damage_coeff[STAMINA] = BOUNTY_GOON_MAX_STAMINA / BOUNTY_GOON_HEALTH
	gender = prob(75) ? MALE : FEMALE
	goon_look_number = random_outpost_npc_look_number()
	add_traits(list(TRAIT_NO_TELEPORT, TRAIT_NOMOBSWAP), BOUNTY_KINGPIN_TRAIT)
	AddElement(/datum/element/relay_attackers)
	AddElement(/datum/element/footstep, footstep_type = FOOTSTEP_MOB_SHOE)
	INVOKE_ASYNC(src, PROC_REF(goon_dress))

/mob/living/basic/bounty_kingpin_goon/Destroy()
	goon_cancel_windup()
	deltimer(goon_fade_timer)
	goon_fade_timer = null
	goon_post = null
	goon_crew_ref = null
	goon_target_ref = null
	goon_chair_ref = null
	return ..()

/// Their crew, if it still exists
/mob/living/basic/bounty_kingpin_goon/proc/goon_crew()
	var/datum/bounty_kingpin_crew/crew = goon_crew_ref?.resolve()
	return QDELETED(crew) ? null : crew

/// Puts their look on: at ease, or with their gun out. Sleeps.
/mob/living/basic/bounty_kingpin_goon/proc/goon_dress()
	var/outfit = /datum/outfit/bounty_kingpin_goon
	if(goon_armed)
		switch(goon_weapon)
			if(BOUNTY_GOON_WEAPON_SMG)
				outfit = /datum/outfit/bounty_kingpin_goon/smg
			if(BOUNTY_GOON_WEAPON_SHOTGUN)
				outfit = /datum/outfit/bounty_kingpin_goon/shotgun
			else
				outfit = /datum/outfit/bounty_kingpin_goon/pistol
	set_outpost_npc_look(src, outfit, gender, goon_look_number)
	if(!QDELETED(src))
		update_appearance(UPDATE_OVERLAYS)

/// Their gun comes out, or goes away
/mob/living/basic/bounty_kingpin_goon/proc/goon_arm(armed)
	if(goon_armed == armed)
		return
	goon_armed = armed
	INVOKE_ASYNC(src, PROC_REF(goon_dress))

/// Says a line from the goons' dialogue, out loud or under their breath
/mob/living/basic/bounty_kingpin_goon/proc/goon_say(context, whisper = FALSE)
	if(stat != CONSCIOUS)
		return FALSE
	var/line = bounty_kingpin_line("goon", context)
	if(!line)
		return FALSE
	if(whisper)
		say(line, forced = "bounty kingpin goon", message_mods = list(WHISPER_MODE = MODE_WHISPER))
	else
		say(line, forced = "bounty kingpin goon")
	return TRUE

/// Whether they can fight now: awake, on their feet, not stunned, not leaving
/mob/living/basic/bounty_kingpin_goon/proc/goon_able()
	if(stat != CONSCIOUS || goon_fleeing || goon_leaving)
		return FALSE
	return !HAS_TRAIT(src, TRAIT_INCAPACITATED) && !HAS_TRAIT(src, TRAIT_FLOORED)

/// Drops a burst or a blast that was winding up
/mob/living/basic/bounty_kingpin_goon/proc/goon_cancel_windup()
	if(goon_windup_timer)
		deltimer(goon_windup_timer)
		goon_windup_timer = null

/// A goon's gun by BOUNTY_GOON_WEAPON_*: the one in his hand, loaded as it is (bounty_real_weapon())
/proc/bounty_kingpin_goon_gun(weapon)
	switch(weapon)
		if(BOUNTY_GOON_WEAPON_SMG)
			return bounty_real_weapon(BOUNTY_GOON_SMG_GUN)
		if(BOUNTY_GOON_WEAPON_SHOTGUN)
			return bounty_real_weapon(BOUNTY_GOON_SHOTGUN_GUN, BOUNTY_GOON_SHOTGUN_AMMO)
	return bounty_real_weapon(BOUNTY_GOON_PISTOL_GUN)

/// A full magazine (or tube) for their gun
/proc/bounty_kingpin_goon_mag(weapon)
	var/datum/bounty_real_weapon/gun = bounty_kingpin_goon_gun(weapon)
	return gun.magazine

/// How long their gun takes to reload
/proc/bounty_kingpin_goon_reload(weapon)
	switch(weapon)
		if(BOUNTY_GOON_WEAPON_SMG)
			return BOUNTY_GOON_SMG_RELOAD
		if(BOUNTY_GOON_WEAPON_SHOTGUN)
			return BOUNTY_GOON_SHOTGUN_RELOAD
	return BOUNTY_GOON_PISTOL_RELOAD

/mob/living/basic/bounty_kingpin_goon/examine(mob/user)
	. = ..()
	if(stat == DEAD)
		return
	if(goon_armed)
		. += span_warning("[p_They()] [p_have()] a gun out.")
	else
		. += span_notice("[p_They()] keep[p_s()] a hand near [p_their()] jacket.")

// Hurt while their crew is at ease, by anything at all: the crew finds out who (H1)
/mob/living/basic/bounty_kingpin_goon/adjust_health(amount, updating_health = TRUE, forced = FALSE)
	. = ..()
	if(amount > 0 && !forced)
		goon_crew()?.member_hurt(src)

// Alive, they don't get dragged off anywhere; a body can be.
/mob/living/basic/bounty_kingpin_goon/can_be_pulled(user, force)
	if(stat != DEAD)
		if(ismob(user))
			balloon_alert(user, "[p_they()] shove[p_s()] you off!")
		return FALSE
	return ..()

// Out of a chair while down or dead, they lie flat as the criminals do
/mob/living/basic/bounty_kingpin_goon/set_lying_down(new_lying_angle)
	. = ..()
	bounty_body_lie_flat(src, new_lying_angle)

// A goon's body stays for BOUNTY_GOON_FADE, then fades. Nothing drops.
/mob/living/basic/bounty_kingpin_goon/death(gibbed)
	goon_cancel_windup()
	. = ..()
	if(QDELETED(src))
		return
	// A chair holds a body upright: they slump out of it
	if(istype(buckled, /obj/structure/chair))
		buckled.unbuckle_mob(src, force = TRUE)
	// A body can be dragged about
	move_resist = MOVE_RESIST_DEFAULT
	deltimer(goon_fade_timer)
	goon_fade_timer = addtimer(CALLBACK(src, PROC_REF(goon_fade_out)), BOUNTY_GOON_FADE, TIMER_STOPPABLE | TIMER_DELETE_ME)

/// Their body fades away
/mob/living/basic/bounty_kingpin_goon/proc/goon_fade_out()
	goon_fade_timer = null
	if(QDELETED(src))
		return
	pulledby?.stop_pulling()
	animate(src, alpha = 0, time = BOUNTY_GOON_FADE_OUT)
	addtimer(CALLBACK(src, PROC_REF(goon_gone)), BOUNTY_GOON_FADE_OUT, TIMER_DELETE_ME)

/mob/living/basic/bounty_kingpin_goon/proc/goon_gone()
	qdel(src)

/**
 * They leave: their crew is gone (the posting closed), or they ran. They walk toward `exit` and fade
 * out after `time`. Nobody can hurt them on the way out. A body is left to fade on its own.
 */
/mob/living/basic/bounty_kingpin_goon/proc/goon_leave(turf/exit, time = BOUNTY_GOON_LEAVE_TIME)
	if(goon_leaving || stat == DEAD || QDELETED(src))
		return
	goon_leaving = TRUE
	goon_cancel_windup()
	goon_target_ref = null
	ADD_TRAIT(src, TRAIT_GODMODE, BOUNTY_KINGPIN_TRAIT)
	buckled?.unbuckle_mob(src, force = TRUE)
	if(exit && isturf(loc))
		GLOB.move_manager.jps_move(src, exit, delay = BOUNTY_GOON_STEP, timeout = time, repath_delay = 2 SECONDS, max_path_length = 60, simulated_only = TRUE, priority = MOVEMENT_ABOVE_SPACE_PRIORITY)
	addtimer(CALLBACK(src, PROC_REF(goon_fade_out)), time, TIMER_DELETE_ME)

// =========================================================================
// HIS CREW: THE ROOM AND THE SHOOTOUT
// =========================================================================

/**
 * # Kingpin crew
 *
 * Everything around the kingpin: his goons and their posts, the lounge's tables, the barkeep, the
 * shootout, and the job he holds for a crew. Owned by the kingpin and deleted with
 * him: it lives as long as he does, posting or none. Holds its mobs by weakref. Processes on
 * SSfastprocess: at ease it keeps the room lively and watches for known hunters; in a shootout it
 * moves the goons and fires their guns and his.
 */
/datum/bounty_kingpin_crew
	/// Weakref to the kingpin
	var/datum/weakref/kingpin_ref
	/// The turf of his seat on the sofa
	var/turf/crew_seat
	/// The goon posts he sat down with, list(list(turf, BOUNTY_GOON_WEAPON_*), ...): an empty one is filled again when he goes on the board
	var/list/crew_posts = list()
	/// The job he holds for a crew (a BOUNTY_KINGPIN_JOB mission, not yet taken), or null
	var/datum/mission/crew_job
	/// Weakref of a ship he offered crew_job to -> world.time the offer lapses
	var/list/crew_job_offers = list()
	/// world.time he may try to make a job again, after one couldn't be made
	var/crew_job_retry_at = 0
	/// The way the sofa faces: the coffee table is that way
	var/crew_facing = NORTH
	/// Where bystanders and leaving goons go: the lounge's refuge mark, out of the room and away from the lift
	var/turf/crew_refuge
	/// Weakrefs to the goons (/mob/living/basic/bounty_kingpin_goon)
	var/list/crew_goons = list()
	/// Weakrefs to everyone the crew is fighting: whoever confronted him, attacked any of them, or came with them
	var/list/crew_hunters = list()
	/// Weakrefs to the ships those hunters fly with: none of their crew gets his work
	var/list/crew_hostile_ships = list()
	/// Weakref of a hunter -> world.time they last fired at or hit his crew
	var/list/crew_engaged = list()
	/// BOUNTY_KINGPIN_CALM, _DRAWING or _FIGHTING
	var/crew_state = BOUNTY_KINGPIN_CALM
	/// world.time the draw ends and the first shots may come
	var/crew_draw_ends_at = 0
	/// world.time anyone in the crew last saw a hunter
	var/crew_last_contact_at = 0
	/// Where a hunter was last seen, and when: goons with no line go looking there, within their leash
	var/turf/crew_lead
	var/crew_lead_at = 0
	/// He has fallen this fight, and half the goons left have run
	var/crew_boss_fell = FALSE
	/// Their guns are out
	var/crew_armed = FALSE
	/// Weakrefs to the coffee table's pieces (/obj/structure/table)
	var/list/crew_coffee_table = list()
	/// Weakrefs to every lounge table the crew minds: the coffee table and the tables at the goons' posts
	var/list/crew_tables = list()
	/// Where each of those stands and what it is, list(turf, type): a table shot to pieces is put back
	var/list/crew_table_spots = list()
	/// The turfs where one of them was shot to pieces, waiting for a new one
	var/list/crew_broken_spots = list()
	/// Weakrefs to the tables the crew flipped this fight, the coffee table's too
	var/list/crew_flipped = list()
	/// Weakref to the barkeep who shouts when the shooting starts
	var/datum/weakref/crew_barkeep_ref
	/// Weakref of a visitor -> world.time he last greeted them
	var/list/crew_greeted = list()
	/// world.time of the next goon idle action, his next idle line, the next calm second, his next walk home and his next warning about the tables
	var/crew_next_idle_at = 0
	var/crew_next_boss_idle_at = 0
	var/crew_next_calm_at = 0
	var/crew_next_home_walk = 0
	var/crew_next_table_warning = 0
	/// Shots the crew has fired (the unit tests read it)
	var/crew_shots = 0

/datum/bounty_kingpin_crew/New(mob/living/basic/bounty_criminal/kingpin/kingpin, turf/seat)
	. = ..()
	kingpin_ref = WEAKREF(kingpin)
	crew_seat = seat || get_turf(kingpin)
	var/obj/structure/chair/sofa = locate(/obj/structure/chair) in crew_seat
	if(sofa)
		crew_facing = sofa.dir
	GLOB.bounty_kingpin_crews += src
	RegisterSignal(kingpin, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(on_member_attacked))
	RegisterSignal(kingpin, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_member_shot))
	RegisterSignals(kingpin, list(COMSIG_BOUNTY_CRIMINAL_DOWNED, COMSIG_LIVING_DEATH, SIGNAL_ADDTRAIT(TRAIT_BOUNTY_SURRENDERED)), PROC_REF(on_boss_fell))
	RegisterSignal(kingpin, COMSIG_BOUNTY_CRIMINAL_RESTRAINED, PROC_REF(on_boss_restrained))
	crew_next_idle_at = world.time + rand(BOUNTY_GOON_IDLE_MIN, BOUNTY_GOON_IDLE_MAX)
	crew_next_boss_idle_at = world.time + rand(BOUNTY_KINGPIN_IDLE_MIN, BOUNTY_KINGPIN_IDLE_MAX)
	START_PROCESSING(SSfastprocess, src)

/datum/bounty_kingpin_crew/Destroy()
	STOP_PROCESSING(SSfastprocess, src)
	GLOB.bounty_kingpin_crews -= src
	// The job he held goes with him
	drop_job()
	restore_room(TRUE)
	// Whoever is still standing leaves; bodies fade on their own
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in goons())
		goon.goon_crew_ref = null
		if(goon.stat != DEAD)
			goon.goon_leave(exit_turf(goon))
	crew_goons.Cut()
	crew_hunters.Cut()
	crew_hostile_ships.Cut()
	crew_engaged.Cut()
	crew_greeted.Cut()
	crew_coffee_table.Cut()
	crew_tables.Cut()
	crew_table_spots.Cut()
	crew_broken_spots.Cut()
	crew_posts.Cut()
	crew_job_offers.Cut()
	crew_seat = null
	crew_refuge = null
	crew_lead = null
	kingpin_ref = null
	crew_barkeep_ref = null
	return ..()

// ===== WHO IS WHO =====

/// The kingpin, if he still exists
/datum/bounty_kingpin_crew/proc/kingpin()
	RETURN_TYPE(/mob/living/basic/bounty_criminal/kingpin)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin_ref?.resolve()
	return QDELETED(kingpin) ? null : kingpin

/// The goons that still exist, dead or alive
/datum/bounty_kingpin_crew/proc/goons()
	. = list()
	for(var/datum/weakref/ref as anything in crew_goons.Copy())
		var/mob/living/basic/bounty_kingpin_goon/goon = ref?.resolve()
		if(QDELETED(goon))
			crew_goons -= ref
			continue
		. += goon

/// The goons still in the fight: alive, not running, not leaving
/datum/bounty_kingpin_crew/proc/standing_goons()
	. = list()
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in goons())
		if(goon.stat != DEAD && !goon.goon_fleeing && !goon.goon_leaving)
			. += goon

/// His crew is down: no goon still in the fight
/datum/bounty_kingpin_crew/proc/crew_down()
	return !length(standing_goons())

/// Whether `thing` is the kingpin or one of his goons
/datum/bounty_kingpin_crew/proc/is_member(atom/thing)
	if(!thing)
		return FALSE
	if(thing == kingpin())
		return TRUE
	var/mob/living/basic/bounty_kingpin_goon/goon = thing
	return istype(goon) && goon.goon_crew_ref?.resolve() == src

/// Whether the crew is fighting `who`
/datum/bounty_kingpin_crew/proc/is_hunter(mob/living/who)
	if(!isliving(who) || isnull(who.weak_reference) || is_member(who))
		return FALSE
	return who.weak_reference in crew_hunters

/// Whether a shootout is on: the draw or the fight
/datum/bounty_kingpin_crew/proc/is_fighting()
	return crew_state != BOUNTY_KINGPIN_CALM

/**
 * The crew fights `who` from now on: the kingpin holds a grudge (P2), their ship gets no work, and
 * the crew notes when they fire at it. Returns TRUE if they are new.
 */
/datum/bounty_kingpin_crew/proc/add_hunter(mob/living/who)
	if(!isliving(who) || QDELETED(who) || is_member(who))
		return FALSE
	if(istype(who, /mob/living/basic/bounty_criminal) || istype(who, /mob/living/basic/bounty_companion))
		return FALSE
	var/datum/weakref/ref = WEAKREF(who)
	if(ref in crew_hunters)
		return FALSE
	crew_hunters += ref
	var/obj/structure/overmap/ship/ship = bounty_kingpin_user_ship(who)
	if(ship)
		crew_hostile_ships |= WEAKREF(ship)
	RegisterSignal(who, COMSIG_PROJECTILE_FIRER_BEFORE_FIRE, PROC_REF(on_hunter_fired), override = TRUE)
	kingpin()?.body_add_grudge(who)
	return TRUE

/// Whether anyone who flies with `ship` has fought his crew
/datum/bounty_kingpin_crew/proc/ship_fought(obj/structure/overmap/ship/ship)
	return !isnull(ship?.weak_reference) && (ship.weak_reference in crew_hostile_ships)

/// Whether `hunter` fired at or hit his crew in the last BOUNTY_KINGPIN_EXCUSE_WINDOW
/datum/bounty_kingpin_crew/proc/engaged(mob/living/hunter)
	if(isnull(hunter?.weak_reference))
		return FALSE
	var/at = crew_engaged[hunter.weak_reference]
	return !isnull(at) && world.time - at <= BOUNTY_KINGPIN_EXCUSE_WINDOW

/// Whether `thing` is in the lounge: within BOUNTY_KINGPIN_SIGHT of his sofa, on its level
/datum/bounty_kingpin_crew/proc/in_lounge(atom/thing)
	var/turf/spot = get_turf(thing)
	return spot && crew_seat && spot.z == crew_seat.z && get_dist(spot, crew_seat) <= BOUNTY_KINGPIN_SIGHT

/**
 * Whoever came with `instigator`: their shipmates within sight of the sofa join the fight. Anyone
 * who works for him is left out unless they attack.
 */
/datum/bounty_kingpin_crew/proc/add_party(mob/living/instigator)
	var/obj/structure/overmap/ship/ship = bounty_kingpin_user_ship(instigator)
	if(!ship || !crew_seat)
		return
	for(var/datum/mind/member as anything in ship.ship_team?.members)
		var/mob/living/body = member?.current
		var/turf/spot = get_turf(body)
		if(!isliving(body) || body.stat == DEAD || !spot || spot.z != crew_seat.z || get_dist(spot, crew_seat) > BOUNTY_KINGPIN_SIGHT)
			continue
		if(SSbounty_kingpin.kingpin_mind_bound(member))
			continue
		add_hunter(body)

/**
 * Whether his crew would shoot `target` now: someone they fight, awake (never anyone down), standing
 * on the floor or at the controls of a mech (never inside a locker or a crate: L2), near the lounge.
 */
/datum/bounty_kingpin_crew/proc/valid_target(mob/living/target)
	if(!isliving(target) || QDELETED(target) || target.stat != CONSCIOUS || !crew_seat)
		return FALSE
	if(!isturf(target.loc) && !istype(target.loc, /obj/vehicle/sealed))
		return FALSE
	var/turf/spot = get_turf(target)
	if(!spot || spot.z != crew_seat.z || get_dist(spot, crew_seat) > BOUNTY_KINGPIN_SIGHT + BOUNTY_GOON_LEASH)
		return FALSE
	return is_hunter(target)

/// What a shot at `hunter` is aimed at: the mech they drive, or them
/datum/bounty_kingpin_crew/proc/shot_target(mob/living/hunter)
	return istype(hunter?.loc, /obj/vehicle/sealed) ? hunter.loc : hunter

/// The hunters the crew could shoot now
/datum/bounty_kingpin_crew/proc/live_hunters()
	. = list()
	for(var/datum/weakref/ref as anything in crew_hunters.Copy())
		var/mob/living/hunter = ref?.resolve()
		if(QDELETED(hunter))
			crew_hunters -= ref
			crew_engaged -= ref
			continue
		if(valid_target(hunter))
			. += hunter

/// Whether `hunter` is in cover: out of the kingpin's sight from the sofa (the corridor, the doorways)
/datum/bounty_kingpin_crew/proc/in_cover(mob/living/hunter)
	return !bounty_kingpin_clear_shot(crew_seat, hunter)

/// The living people behind whatever fired a shot, threw a grenade or drives a mech: the mob, a vehicle's occupants, or whoever last handled the thing (a grenade's shrapnel, a player's turret)
/proc/bounty_kingpin_people_behind(atom/source)
	. = list()
	if(isliving(source))
		. += source
		return
	if(istype(source, /obj/vehicle/sealed))
		var/obj/vehicle/sealed/vehicle = source
		for(var/mob/living/occupant in vehicle.occupants)
			. += occupant
		return
	if(isatom(source) && source.fingerprintslast)
		var/mob/living/owner = get_mob_by_ckey(source.fingerprintslast)
		if(isliving(owner))
			. += owner

// ===== THE GOONS =====

/// A goon with `weapon` at `post`, sitting if there is a chair there, facing the talk spot
/datum/bounty_kingpin_crew/proc/spawn_goon(turf/post, weapon = BOUNTY_GOON_WEAPON_PISTOL)
	if(!post)
		return null
	var/mob/living/basic/bounty_kingpin_goon/goon = new(post)
	goon.goon_weapon = weapon
	goon.goon_post = post
	goon.goon_rounds = bounty_kingpin_goon_mag(weapon)
	if(crew_seat && get_dist(post, crew_seat) <= 3)
		goon.name = "bodyguard"
	var/obj/structure/chair/chair = locate(/obj/structure/chair) in post
	if(chair && !chair.has_buckled_mobs() && chair.buckle_mob(goon, force = TRUE))
		goon.goon_chair_ref = WEAKREF(chair)
		goon.goon_post_dir = chair.dir
	else
		var/turf/talk_spot = talk_spot()
		var/facing = talk_spot ? get_dir(post, talk_spot) : SOUTH
		// A diagonal faces its east or west half: the sprites have four directions
		if((facing & (NORTH|SOUTH)) && (facing & (EAST|WEST)))
			facing &= (EAST|WEST)
		goon.goon_post_dir = facing || SOUTH
		goon.setDir(goon.goon_post_dir)
	add_goon(goon)
	return goon

/// Makes `goon` one of the crew
/datum/bounty_kingpin_crew/proc/add_goon(mob/living/basic/bounty_kingpin_goon/goon)
	goon.goon_crew_ref = WEAKREF(src)
	crew_goons |= WEAKREF(goon)
	RegisterSignal(goon, COMSIG_ATOM_WAS_ATTACKED, PROC_REF(on_member_attacked))
	RegisterSignal(goon, COMSIG_PROJECTILE_PREHIT, PROC_REF(on_member_shot))

/// Where hunters stand to talk to him: two tiles out from the sofa, across the table
/datum/bounty_kingpin_crew/proc/talk_spot()
	if(!crew_seat)
		return null
	var/turf/front = get_step(crew_seat, crew_facing)
	return front ? (get_step(front, crew_facing) || front) : crew_seat

// ===== THE ROOM =====

/**
 * Finds the room around the sofa: the coffee table in front of it and the tables at the goons' posts
 * (breakable while he is here, and put back if missing), the barkeep who can see the
 * sofa, and the refuge.
 */
/datum/bounty_kingpin_crew/proc/find_room()
	if(!crew_seat)
		return
	crew_refuge = bounty_kingpin_find_refuge(crew_seat)
	var/list/coffee_spots = list()
	var/turf/front = get_step(crew_seat, crew_facing)
	if(front)
		for(var/turf/spot as anything in list(front, get_step(front, turn(crew_facing, 90)), get_step(front, turn(crew_facing, -90))))
			if(spot)
				coffee_spots += spot
	var/list/table_spots = coffee_spots.Copy()
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in goons())
		for(var/direction in GLOB.cardinals)
			var/turf/spot = get_step(goon.goon_post, direction)
			if(spot && !(spot in table_spots))
				table_spots += spot
	for(var/turf/spot as anything in table_spots)
		var/obj/structure/table/table = locate(/obj/structure/table) in spot
		if(!table?.can_flip)
			continue
		var/datum/weakref/ref = WEAKREF(table)
		crew_tables |= ref
		crew_table_spots += list(list(spot, table.type))
		if(spot in coffee_spots)
			crew_coffee_table |= ref
		make_table_breakable(table)
	// The barkeep is the trader in this room: the nearest one with a clear line to the sofa, never one behind a wall or a window (M4)
	crew_barkeep_ref = null
	var/mob/living/basic/outpost_trader/nearest_trader
	for(var/mob/living/basic/outpost_trader/trader in range(BOUNTY_KINGPIN_SIGHT, crew_seat))
		if(!bounty_kingpin_clear_shot(crew_seat, trader))
			continue
		if(!nearest_trader || get_dist(trader, crew_seat) < get_dist(nearest_trader, crew_seat))
			nearest_trader = trader
	if(nearest_trader)
		crew_barkeep_ref = WEAKREF(nearest_trader)
	// Whatever anyone did to the tables since the last kingpin, he sits down to a tidy room
	restore_tables()

/// A lounge table that bullets can break while he is here (kingpin.md: three lasers); it leaves nothing behind when it goes (M3)
/datum/bounty_kingpin_crew/proc/make_table_breakable(obj/structure/table/table)
	table.resistance_flags &= ~INDESTRUCTIBLE
	table.obj_flags |= NO_DEBRIS_AFTER_DECONSTRUCTION
	RegisterSignal(table, COMSIG_ATOM_DESTRUCTION, PROC_REF(on_table_broken), override = TRUE)

/// One of the lounge's tables was shot to pieces: a new one goes there later
/datum/bounty_kingpin_crew/proc/on_table_broken(obj/structure/table/source)
	SIGNAL_HANDLER
	var/turf/spot = get_turf(source)
	if(spot)
		crew_broken_spots |= spot

/**
 * Every lounge table the crew minds stands upright and whole: flipped ones set back, damaged ones
 * mended, broken ones replaced. `final`, when the crew is done: they are outpost property again.
 */
/datum/bounty_kingpin_crew/proc/restore_tables(final = FALSE)
	var/list/standing = list()
	for(var/datum/weakref/ref as anything in crew_tables.Copy())
		var/obj/structure/table/table = ref?.resolve()
		if(QDELETED(table))
			crew_tables -= ref
			crew_coffee_table -= ref
			continue
		standing += table
	for(var/list/spot_info as anything in crew_table_spots)
		var/turf/spot = spot_info[1]
		var/obj/structure/table/present = locate(/obj/structure/table) in spot
		if(present)
			if(!(present in standing))
				standing += present
				crew_tables |= WEAKREF(present)
			continue
		// Only a table that was shot to pieces comes back: one taken away on purpose stays gone
		if(!(spot in crew_broken_spots))
			continue
		crew_broken_spots -= spot
		var/table_type = spot_info[2]
		var/obj/structure/table/table = new table_type(spot)
		table.AddElement(/datum/element/outpost_property)
		standing += table
		var/datum/weakref/ref = WEAKREF(table)
		crew_tables |= ref
		if(crew_seat && get_dist(spot, crew_seat) == 1 && (get_dir(crew_seat, spot) & crew_facing))
			crew_coffee_table |= ref
	for(var/obj/structure/table/table as anything in standing)
		if(table.is_flipped)
			table.unflip_table()
		table.repair_damage(table.max_integrity - table.get_integrity())
		if(final)
			table.resistance_flags |= INDESTRUCTIBLE
			table.obj_flags &= ~NO_DEBRIS_AFTER_DECONSTRUCTION
		else
			make_table_breakable(table)

/// Somewhere out of the lounge for `mover` to walk to: the refuge mark, never the hangar lift (M5)
/datum/bounty_kingpin_crew/proc/exit_turf(atom/mover)
	if(crew_refuge)
		return crew_refuge
	return null

// ===== HIS BUSINESS =====

/// The trader outpost his lounge is in (the black market), or null (a test room)
/datum/bounty_kingpin_crew/proc/crew_outpost()
	RETURN_TYPE(/obj/structure/overmap/trader_outpost)
	return crew_seat ? get_trader_outpost_for_turf(crew_seat) : null

/// The shop his jobs are posted with: his outpost's, else the black market's. Its counter is the only one that takes the goods.
/datum/bounty_kingpin_crew/proc/crew_shop()
	RETURN_TYPE(/datum/outpost_shop)
	var/obj/structure/overmap/trader_outpost/outpost = crew_outpost() || bounty_kingpin_black_market()
	return outpost?.shop

/// The job he holds, if it is still his to give: not deleted, not taken
/datum/bounty_kingpin_crew/proc/job()
	RETURN_TYPE(/datum/mission)
	if(QDELETED(crew_job) || crew_job.active || crew_job.failed || crew_job.completed)
		crew_job = null
		return null
	return crew_job

/**
 * His job for a crew: the one he holds, or a new BOUNTY_KINGPIN_JOB made with his outpost's shop and
 * his name on it. The one place his jobs are made. None while the round's limit for it is reached
 * (counting the one he holds), or for BOUNTY_KINGPIN_JOB_RETRY after one couldn't be made. Returns
 * the job, or null. Making one can sleep.
 */
/datum/bounty_kingpin_crew/proc/make_job()
	RETURN_TYPE(/datum/mission)
	var/datum/mission/held = job()
	if(held)
		return held
	if(world.time < crew_job_retry_at || !mission_type_within_limit(BOUNTY_KINGPIN_JOB))
		return null
	var/job_type = BOUNTY_KINGPIN_JOB
	var/datum/mission/job = new job_type(crew_shop())
	if(QDELETED(src))
		qdel(job)
		return null
	if(job.generation_failed)
		qdel(job)
		crew_job_retry_at = world.time + BOUNTY_KINGPIN_JOB_RETRY
		return null
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin)
		job.author = kingpin.kingpin_job_name()
		job.update_text()
	hold_job(job)
	return job

/// Makes `job` the one he holds, for crews to take
/datum/bounty_kingpin_crew/proc/hold_job(datum/mission/job)
	drop_job()
	crew_job = job
	RegisterSignal(job, COMSIG_QDELETING, PROC_REF(on_job_deleted))

/// A crew took the job: it is theirs now, and every offer of it is off
/datum/bounty_kingpin_crew/proc/job_taken(datum/mission/job)
	if(job && job == crew_job)
		UnregisterSignal(job, COMSIG_QDELETING)
		crew_job = null
	crew_job_offers.Cut()

/// He gives up the job he holds (deleted with him, or it couldn't start)
/datum/bounty_kingpin_crew/proc/drop_job()
	crew_job_offers.Cut()
	var/datum/mission/job = crew_job
	crew_job = null
	if(!job)
		return
	UnregisterSignal(job, COMSIG_QDELETING)
	if(!QDELETED(job) && !job.active)
		qdel(job)

/// The job he held was deleted (its planet went, say): he has none until he is asked again
/datum/bounty_kingpin_crew/proc/on_job_deleted(datum/source)
	SIGNAL_HANDLER
	if(source == crew_job)
		crew_job = null
		crew_job_offers.Cut()

/// What he calls the job he holds: its objective ("batch of Blue Sky"), or "job"
/datum/bounty_kingpin_crew/proc/job_words()
	return job()?.objective_name || "job"

/// He offers the job he holds to `ship`'s crew, for BOUNTY_KINGPIN_OFFER_TIME
/datum/bounty_kingpin_crew/proc/offer_job(obj/structure/overmap/ship/ship)
	if(!ship || !job())
		return
	crew_job_offers[WEAKREF(ship)] = world.time + BOUNTY_KINGPIN_OFFER_TIME

/// Whether he has offered `ship`'s crew the job he holds, and the offer still stands
/datum/bounty_kingpin_crew/proc/job_offered_to(obj/structure/overmap/ship/ship)
	if(!ship || isnull(ship.weak_reference) || !job())
		return FALSE
	var/until = crew_job_offers[ship.weak_reference]
	return !isnull(until) && world.time < until

/// Drops the offers that have lapsed or whose ship is gone
/datum/bounty_kingpin_crew/proc/prune_job_offers()
	for(var/datum/weakref/ref as anything in crew_job_offers.Copy())
		if(!ref?.resolve() || world.time >= crew_job_offers[ref])
			crew_job_offers -= ref

/// After a crew takes his job: the goons ease off
/datum/bounty_kingpin_crew/proc/goons_relax()
	if(crew_seat && length(standing_goons()))
		crew_seat.visible_message(span_notice("The goons ease off."), vision_distance = BOUNTY_KINGPIN_SIGHT)

/**
 * He goes on the board with his crew at ease: every post he sat down with whose goon is dead or gone
 * (fled, walked out) gets a new goon. Nothing mid-fight. Returns the goons it placed.
 */
/datum/bounty_kingpin_crew/proc/restaff()
	. = list()
	if(crew_state != BOUNTY_KINGPIN_CALM)
		return
	var/list/manned = list()
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		manned |= goon.goon_post
	for(var/list/post as anything in crew_posts)
		var/turf/spot = post[1]
		if(!spot || (spot in manned))
			continue
		var/mob/living/basic/bounty_kingpin_goon/goon = spawn_goon(spot, post[2])
		if(goon)
			manned |= spot
			. += goon

// ===== SIGNALS =====

/// Someone went for the kingpin or a goon: any damaging or stamina attack starts the shootout
/datum/bounty_kingpin_crew/proc/on_member_attacked(datum/source, atom/attacker, attack_flags)
	SIGNAL_HANDLER
	var/list/people = bounty_kingpin_people_behind(attacker)
	if(!length(people))
		return
	if(!(attack_flags & (ATTACKER_DAMAGING_ATTACK | ATTACKER_STAMINA_ATTACK)))
		if((attack_flags & ATTACKER_SHOVING) && istype(source, /mob/living/basic/bounty_kingpin_goon))
			var/mob/living/basic/bounty_kingpin_goon/goon = source
			INVOKE_ASYNC(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_say), "shoved")
		return
	member_attacked(source, people)

/**
 * A projectile is about to hit him or a goon. relay_attackers only reports shots fired by a mob, so
 * a mech's guns, a grenade's shrapnel and a player's turret are caught here, and whoever is behind
 * them is found (H1).
 */
/datum/bounty_kingpin_crew/proc/on_member_shot(datum/source, obj/projectile/shot)
	SIGNAL_HANDLER
	if(!shot?.is_hostile_projectile() || ismob(shot.firer))
		return
	var/list/people = bounty_kingpin_people_behind(shot.firer)
	if(length(people))
		member_attacked(source, people)

/// A hunter fired: at his crew, it's part of the fight (their stray shots take no outpost strike)
/datum/bounty_kingpin_crew/proc/on_hunter_fired(mob/living/source, obj/projectile/shot, atom/fired_from, atom/original)
	SIGNAL_HANDLER
	if(crew_state == BOUNTY_KINGPIN_CALM)
		return
	var/aimed_at_crew = is_member(original)
	if(!aimed_at_crew && isturf(original))
		for(var/mob/living/thing in original)
			if(is_member(thing))
				aimed_at_crew = TRUE
				break
	if(aimed_at_crew)
		crew_engaged[source.weak_reference] = world.time

/**
 * `member` (him or a goon) was attacked by `people`: they are hunters now, a goon drawing or
 * winding up fumbles, and if all was calm the shootout starts. Someone the crew won't fight (another
 * criminal) sets nothing off (L6). Doesn't sleep.
 */
/datum/bounty_kingpin_crew/proc/member_attacked(atom/member, list/people)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	var/mob/living/first
	for(var/mob/living/person as anything in people)
		if(QDELETED(person) || is_member(person))
			continue
		if(!add_hunter(person) && !is_hunter(person))
			continue
		first ||= person
		crew_engaged[person.weak_reference] = world.time
		if(member == kingpin)
			kingpin.kingpin_note_hit(person)
	if(!first)
		return
	if(istype(member, /mob/living/basic/bounty_kingpin_goon))
		goon_hit(member)
	if(crew_state == BOUNTY_KINGPIN_CALM)
		start_shootout(first, FALSE)

/**
 * Him or a goon took damage. While the crew is at ease, any damage is an attack: a moment later
 * (once the attack itself has been reported), if nobody has been named, the crew picks the nearest
 * person in sight who isn't a guest (H1).
 */
/datum/bounty_kingpin_crew/proc/member_hurt(mob/living/member)
	if(crew_state != BOUNTY_KINGPIN_CALM || QDELETED(member))
		return
	addtimer(CALLBACK(src, PROC_REF(member_hurt_check), WEAKREF(member)), 1, TIMER_DELETE_ME)

/datum/bounty_kingpin_crew/proc/member_hurt_check(datum/weakref/member_ref)
	var/mob/living/member = member_ref?.resolve()
	if(crew_state != BOUNTY_KINGPIN_CALM || QDELETED(member))
		return
	var/mob/living/suspect
	for(var/mob/living/person in range(BOUNTY_GOON_LEASH, member))
		if(person.stat != CONSCIOUS || !(person.mind || person.client) || is_member(person))
			continue
		if(istype(person, /mob/living/basic/bounty_criminal) || istype(person, /mob/living/basic/bounty_companion))
			continue
		if(SSbounty_kingpin.kingpin_mind_bound(person.mind) && !is_hunter(person))
			continue
		if(!bounty_kingpin_clear_shot(person, member, BOUNTY_GOON_LEASH))
			continue
		if(!suspect || get_dist(person, member) < get_dist(suspect, member))
			suspect = person
	if(suspect)
		member_attacked(member, list(suspect))

/// He fell (downed, gave up, died): his aim drops, and half the goons left run (once a fight)
/datum/bounty_kingpin_crew/proc/on_boss_fell(datum/source)
	SIGNAL_HANDLER
	kingpin()?.kingpin_cancel_aim()
	boss_fell()

/// He was cuffed. While his crew is at ease, that's an attack on him by whoever did it (M2).
/datum/bounty_kingpin_crew/proc/on_boss_restrained(datum/source, mob/living/user)
	SIGNAL_HANDLER
	kingpin()?.kingpin_cancel_aim()
	if(crew_state == BOUNTY_KINGPIN_CALM && isliving(user))
		member_attacked(kingpin(), list(user))
	boss_fell()

/// Half the goons still in the fight run, the most hurt first. Once a fight; never while calm. Returns the goons who ran.
/datum/bounty_kingpin_crew/proc/boss_fell()
	. = list()
	if(crew_state == BOUNTY_KINGPIN_CALM || crew_boss_fell)
		return
	crew_boss_fell = TRUE
	var/list/standing = sortTim(standing_goons(), GLOBAL_PROC_REF(cmp_bounty_kingpin_goon_health))
	var/fleeing = floor(length(standing) * BOUNTY_GOON_FLEE_ON_BOSS / 100)
	for(var/i in 1 to fleeing)
		var/mob/living/basic/bounty_kingpin_goon/goon = standing[i]
		goon_flee(goon)
		. += goon

/// Sorts goons most hurt first
/proc/cmp_bounty_kingpin_goon_health(mob/living/first, mob/living/second)
	return first.health - second.health

/// `goon` runs for it: away from the nearest hunter, and gone after BOUNTY_GOON_FLEE_TIME
/datum/bounty_kingpin_crew/proc/goon_flee(mob/living/basic/bounty_kingpin_goon/goon)
	if(goon.goon_fleeing || goon.stat == DEAD)
		return
	goon.goon_fleeing = TRUE
	goon.goon_cancel_windup()
	goon.goon_target_ref = null
	INVOKE_ASYNC(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_say), "flee")
	var/mob/living/nearest
	for(var/mob/living/hunter as anything in live_hunters())
		if(!nearest || get_dist(goon, hunter) < get_dist(goon, nearest))
			nearest = hunter
	if(nearest && isturf(goon.loc))
		GLOB.move_manager.move_away(goon, nearest, BOUNTY_KINGPIN_SIGHT + BOUNTY_GOON_LEASH, BOUNTY_GOON_STEP, BOUNTY_GOON_FLEE_TIME, priority = MOVEMENT_ABOVE_SPACE_PRIORITY)
	else
		goon.goon_leave(exit_turf(goon), BOUNTY_GOON_FLEE_TIME)
		return
	addtimer(CALLBACK(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_leave), null, 1), BOUNTY_GOON_FLEE_TIME, TIMER_DELETE_ME)

/// A goon was hit: drawing, he fumbles his first shot; winding up, he loses the burst or the blast
/datum/bounty_kingpin_crew/proc/goon_hit(mob/living/basic/bounty_kingpin_goon/goon)
	if(goon.stat != CONSCIOUS)
		return
	if(crew_state == BOUNTY_KINGPIN_DRAWING)
		goon.goon_fumbled_until = crew_draw_ends_at + BOUNTY_KINGPIN_FUMBLE
		goon.visible_message(span_notice("[goon] fumbles for [goon.p_their()] gun."), vision_distance = COMBAT_MESSAGE_RANGE)
	else if(goon.goon_windup_timer)
		goon.goon_cancel_windup()
		goon.goon_fumbled_until = world.time + BOUNTY_KINGPIN_FUMBLE
		goon.visible_message(span_notice("[goon] loses [goon.p_their()] aim."), vision_distance = COMBAT_MESSAGE_RANGE)

// ===== THE SHOOTOUT =====

/// Whether anyone in the crew can still shoot
/datum/bounty_kingpin_crew/proc/can_fight()
	if(kingpin()?.kingpin_able())
		return TRUE
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		if(goon.stat == CONSCIOUS)
			return TRUE
	return FALSE

/**
 * The shootout starts, set off by `instigator` ("We're here for you" when `confronted`, else an
 * attack): the telegraph. For BOUNTY_KINGPIN_TELEGRAPH nobody in the crew fires: the goons reach
 * for their guns, the table goons flip their tables, he kicks the coffee table over and the
 * barkeep shouts. The instigator and their shipmates nearby are hunters now. It
 * puts nobody on the board. Nothing starts when the crew won't fight the instigator (L6) or nobody
 * can shoot. Doesn't sleep. Returns TRUE if it started.
 */
/datum/bounty_kingpin_crew/proc/start_shootout(mob/living/instigator, confronted = FALSE)
	add_hunter(instigator)
	if(crew_state != BOUNTY_KINGPIN_CALM || !is_hunter(instigator) || !can_fight())
		return FALSE
	add_party(instigator)
	crew_state = BOUNTY_KINGPIN_DRAWING
	crew_draw_ends_at = world.time + BOUNTY_KINGPIN_TELEGRAPH
	crew_last_contact_at = world.time
	crew_lead = null
	crew_boss_fell = FALSE
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin?.stat == CONSCIOUS)
		kingpin.kingpin_cancel_aim()
		INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living, bounty_say), confronted ? "confront" : "attacked", null, TRUE)
	crew_seat?.visible_message(span_userdanger("The goons reach for their guns!"), vision_distance = BOUNTY_KINGPIN_SIGHT)
	crew_armed = TRUE
	if(kingpin)
		INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living/basic/bounty_criminal, body_dress))
		kingpin.kingpin_next_aim_at = crew_draw_ends_at
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		goon_draw(goon)
	kick_table()
	clear_room()
	log_game("BOUNTY: [key_name(instigator)] started a shootout with [kingpin || "the kingpin's crew"] at [AREACOORD(crew_seat)] ([confronted ? "a confrontation" : "an attack"])")
	return TRUE

/// `goon` reaches for his gun: the telegraph box, the sound, out of his chair, his table over
/datum/bounty_kingpin_crew/proc/goon_draw(mob/living/basic/bounty_kingpin_goon/goon)
	goon.goon_arm(TRUE)
	goon.goon_cancel_windup()
	goon.goon_target_ref = null
	goon.goon_rounds = bounty_kingpin_goon_mag(goon.goon_weapon)
	goon.goon_next_fire_at = crew_draw_ends_at
	var/turf/spot = get_turf(goon)
	if(spot)
		new /obj/effect/temp_visual/telegraphing/bounty_kingpin(spot)
	playsound(goon, 'sound/items/weapons/gun/pistol/rack.ogg', 50, TRUE)
	if(goon.buckled)
		goon.buckled.unbuckle_mob(goon, force = TRUE)
	goon_flip_table(goon)
	if(prob(40))
		INVOKE_ASYNC(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_say), "draw")

/// Flips `table` toward `direction`: a table someone else knocked over the wrong way is set up first (H2)
/datum/bounty_kingpin_crew/proc/flip_our_way(obj/structure/table/table, direction)
	if(QDELETED(table) || !table.can_flip)
		return FALSE
	if(table.is_flipped)
		if(table.dir == direction)
			return TRUE
		table.unflip_table()
	table.flip_table(direction)
	// A smooth still queued from the table's build or unflip this tick would runtime on a flipped table
	SSicon_smooth.remove_from_queues(table)
	return TRUE

/// A goon at a table kicks it over for cover, away from himself. Never the coffee table: that's his.
/datum/bounty_kingpin_crew/proc/goon_flip_table(mob/living/basic/bounty_kingpin_goon/goon)
	for(var/direction in GLOB.cardinals)
		var/turf/spot = get_step(goon, direction)
		var/obj/structure/table/table = locate(/obj/structure/table) in spot
		if(!table?.can_flip || (WEAKREF(table) in crew_coffee_table))
			continue
		if(!flip_our_way(table, direction))
			continue
		crew_flipped |= WEAKREF(table)
		return table
	return null

/// He kicks the coffee table over, toward the hunters: his shots go over it, theirs hit it
/datum/bounty_kingpin_crew/proc/kick_table()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(!kingpin?.kingpin_able())
		return FALSE
	var/kicked = FALSE
	for(var/datum/weakref/ref as anything in crew_coffee_table)
		var/obj/structure/table/table = ref?.resolve()
		if(QDELETED(table) || (table.is_flipped && table.dir == crew_facing))
			continue
		flip_our_way(table, crew_facing)
		crew_flipped |= ref
		kicked = TRUE
	if(kicked)
		kingpin.visible_message(span_danger("[kingpin] kicks the table over!"), vision_distance = BOUNTY_KINGPIN_SIGHT)
	return kicked

/// The barkeep shouts from behind his counter
/datum/bounty_kingpin_crew/proc/clear_room()
	var/mob/living/basic/outpost_trader/barkeep = crew_barkeep_ref?.resolve()
	if(QDELETED(barkeep))
		return
	var/line = bounty_kingpin_line("room", "barkeep_duck")
	if(line)
		INVOKE_ASYNC(barkeep, TYPE_PROC_REF(/atom/movable, say), line)

/// The room goes back to how it was: every lounge table upright and whole (restore_tables()). `final` when the crew is done.
/datum/bounty_kingpin_crew/proc/restore_room(final = FALSE)
	restore_tables(final)
	crew_flipped.Cut()

/// The draw is over: the fight. First shots spread over BOUNTY_KINGPIN_FIRST_SHOT_SPREAD, never before the draw ends.
/datum/bounty_kingpin_crew/proc/begin_fight()
	crew_state = BOUNTY_KINGPIN_FIGHTING
	crew_last_contact_at = world.time
	var/list/goons = shuffle(standing_goons())
	var/count = length(goons)
	for(var/i in 1 to count)
		var/mob/living/basic/bounty_kingpin_goon/goon = goons[i]
		var/offset = count > 1 ? round(BOUNTY_KINGPIN_FIRST_SHOT_SPREAD * (i - 1) / (count - 1), 1) : 0
		goon.goon_next_fire_at = max(crew_draw_ends_at + offset, goon.goon_fumbled_until)
		goon.goon_target_ref = null

/// Nobody has seen a hunter for BOUNTY_KINGPIN_STAND_DOWN: guns away, back to the posts, the room back to normal
/datum/bounty_kingpin_crew/proc/stand_down()
	crew_state = BOUNTY_KINGPIN_CALM
	crew_lead = null
	crew_armed = FALSE
	crew_engaged.Cut()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin)
		kingpin.kingpin_cancel_aim()
		INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living/basic/bounty_criminal, body_dress))
		if(kingpin.kingpin_able())
			INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living, bounty_say), "stand_down", null, TRUE)
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		goon.goon_cancel_windup()
		goon.goon_target_ref = null
		goon.goon_arm(FALSE)
	restore_room()
	log_game("BOUNTY: [kingpin || "the kingpin's crew"] stood down at [AREACOORD(crew_seat)]")

/**
 * With him gone (padded or deleted) or carried off his leash, there is nobody left to guard: the
 * goons still standing walk out. Cuffed or dead on his sofa, they stay with him (M2). Returns TRUE if
 * they left.
 */
/datum/bounty_kingpin_crew/proc/dismiss_if_boss_gone()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin)
		var/turf/here = get_turf(kingpin)
		var/on_leash = here && crew_seat && here.z == crew_seat.z && get_dist(here, crew_seat) <= BOUNTY_GOON_LEASH
		if(on_leash || kingpin.kingpin_able())
			return FALSE
	var/list/leaving = standing_goons()
	if(!length(leaving))
		return FALSE
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in leaving)
		goon.goon_leave(exit_turf(goon))
	return TRUE

// ===== THE TICK =====

/datum/bounty_kingpin_crew/process(seconds_per_tick)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(!kingpin)
		return PROCESS_KILL
	if(!kingpin.kingpin_posting())
		// With no posting to answer for him (L10): nowhere at all (nullspace) is gone for good
		if(!get_turf(kingpin))
			log_game("BOUNTY: [kingpin] was cleared away from nowhere")
			qdel(kingpin)
			return PROCESS_KILL
		// A body nobody can bring in (killed off the board, or its proof went up at a chasm's edge) fades
		if(kingpin.stat == DEAD)
			kingpin.kingpin_start_fade()
	// The pad is taking him, or a posting is clearing him away
	if(HAS_TRAIT(kingpin, TRAIT_BOUNTY_REMOVED))
		return
	switch(crew_state)
		if(BOUNTY_KINGPIN_DRAWING)
			if(world.time >= crew_draw_ends_at)
				begin_fight()
		if(BOUNTY_KINGPIN_FIGHTING)
			fight_tick()
		else
			if(world.time >= crew_next_calm_at)
				crew_next_calm_at = world.time + 1 SECONDS
				calm_tick()

/// A tick of the fight: each goon and the kingpin look, move and shoot. With no hunter in anyone's sight for long enough, the crew stands down.
/datum/bounty_kingpin_crew/proc/fight_tick()
	var/list/hunters = live_hunters()
	var/contact = FALSE
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		if(goon_tick(goon, hunters))
			contact = TRUE
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin && boss_tick(kingpin, hunters))
		contact = TRUE
	if(contact)
		crew_last_contact_at = world.time
	else if(world.time - crew_last_contact_at >= BOUNTY_KINGPIN_STAND_DOWN)
		stand_down()
		return
	if(crew_lead && world.time - crew_lead_at > BOUNTY_KINGPIN_STAND_DOWN / 2)
		crew_lead = null

/// Who in `hunters` `looker` has a clear shot at; notes where they were seen
/datum/bounty_kingpin_crew/proc/visible_hunters(mob/living/looker, list/hunters)
	. = list()
	for(var/mob/living/hunter as anything in hunters)
		if(!bounty_kingpin_clear_shot(looker, hunter))
			continue
		. += hunter
		crew_lead = get_turf(hunter)
		crew_lead_at = world.time

/// One goon's turn: pick a target, close in or shoot, or go looking. Returns TRUE if he sees a hunter.
/datum/bounty_kingpin_crew/proc/goon_tick(mob/living/basic/bounty_kingpin_goon/goon, list/hunters)
	if(goon.stat != CONSCIOUS)
		goon.goon_cancel_windup()
		return FALSE
	var/list/visible = visible_hunters(goon, hunters)
	if(!goon.goon_able())
		goon.goon_cancel_windup()
		return length(visible) > 0
	var/mob/living/target = goon_choose_target(goon, visible)
	goon.goon_target_ref = target ? WEAKREF(target) : null
	if(target)
		goon.face_atom(shot_target(target))
		if(goon.goon_weapon == BOUNTY_GOON_WEAPON_SHOTGUN && get_dist(goon, target) > BOUNTY_GOON_SHOTGUN_RANGE)
			goon_step_toward(goon, get_turf(target))
		else
			goon_try_attack(goon, target)
	else if(!length(visible))
		// No line on anyone: the nearest two go looking where a hunter was last seen; the rest hold, or go back to their posts
		if(crew_lead && goon_is_seeker(goon))
			goon_step_toward(goon, crew_lead)
		else if(!crew_lead)
			goon_step_toward(goon, goon.goon_post)
	return length(visible) > 0

/// Whether `goon` is one of the BOUNTY_KINGPIN_MAX_ON_ONE goons nearest the lead, the ones who go looking
/datum/bounty_kingpin_crew/proc/goon_is_seeker(mob/living/basic/bounty_kingpin_goon/goon)
	var/my_dist = get_dist(goon, crew_lead)
	var/closer = 0
	for(var/mob/living/basic/bounty_kingpin_goon/other as anything in standing_goons())
		if(other == goon || !other.goon_able())
			continue
		if(get_dist(other, crew_lead) < my_dist)
			closer++
	return closer < BOUNTY_KINGPIN_MAX_ON_ONE

/**
 * Who `goon` shoots among `visible`: his current target if he still can, else the nearest. In the
 * opening volley, and whenever a hunter is in cover, at most BOUNTY_KINGPIN_MAX_ON_ONE goons draw
 * on one hunter.
 */
/datum/bounty_kingpin_crew/proc/goon_choose_target(mob/living/basic/bounty_kingpin_goon/goon, list/visible)
	if(!length(visible))
		return null
	var/opening = world.time < crew_draw_ends_at + BOUNTY_KINGPIN_FIRST_SHOT_SPREAD
	var/mob/living/current = goon.goon_target_ref?.resolve()
	if(current && (current in visible) && !target_full(current, goon, opening))
		return current
	var/mob/living/best
	var/best_dist = INFINITY
	for(var/mob/living/hunter as anything in visible)
		if(target_full(hunter, goon, opening))
			continue
		var/dist = get_dist(goon, hunter)
		if(dist < best_dist)
			best = hunter
			best_dist = dist
	return best

/// Whether enough other goons are drawing on `hunter` already that `goon` should pick someone else
/datum/bounty_kingpin_crew/proc/target_full(mob/living/hunter, mob/living/basic/bounty_kingpin_goon/goon, opening)
	if(!opening && !in_cover(hunter))
		return FALSE
	return goons_on(hunter, goon) >= BOUNTY_KINGPIN_MAX_ON_ONE

/// How many goons other than `except` are drawing on `hunter`
/datum/bounty_kingpin_crew/proc/goons_on(mob/living/hunter, mob/living/basic/bounty_kingpin_goon/except)
	var/count = 0
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		if(goon != except && goon.goon_target_ref?.resolve() == hunter)
			count++
	return count

/// One step for `goon` toward `destination`, never past his leash from the sofa. Returns TRUE if he moved.
/datum/bounty_kingpin_crew/proc/goon_step_toward(mob/living/basic/bounty_kingpin_goon/goon, turf/destination)
	if(!destination || !crew_seat || world.time < goon.goon_next_move_at || goon.buckled || !isturf(goon.loc))
		return FALSE
	if(get_turf(goon) == destination)
		return FALSE
	var/turf/next = get_step_to(goon, destination)
	if(!next)
		return FALSE
	if(next.z != crew_seat.z || get_dist(next, crew_seat) > BOUNTY_GOON_LEASH)
		return FALSE
	goon.goon_next_move_at = world.time + BOUNTY_GOON_STEP
	return goon.Move(next, get_dir(goon, next))

/**
 * `goon` tries to shoot `target`. Nobody fires while the crew is drawing. A pistol fires at once; an
 * SMG spins up (BOUNTY_GOON_SMG_WINDUP) and a shotgun pumps (BOUNTY_GOON_SHOTGUN_WINDUP) first, and
 * a hit in the meantime spoils it. An empty gun reloads. Returns TRUE if a shot or a wind-up started.
 */
/datum/bounty_kingpin_crew/proc/goon_try_attack(mob/living/basic/bounty_kingpin_goon/goon, mob/living/target)
	if(crew_state != BOUNTY_KINGPIN_FIGHTING || !goon.goon_able() || !valid_target(target))
		return FALSE
	if(goon.goon_windup_timer || world.time < goon.goon_next_fire_at || world.time < goon.goon_fumbled_until)
		return FALSE
	if(goon.goon_rounds <= 0)
		goon.goon_rounds = bounty_kingpin_goon_mag(goon.goon_weapon)
		goon.goon_next_fire_at = world.time + bounty_kingpin_goon_reload(goon.goon_weapon)
		goon.visible_message(span_notice("[goon] reloads."), vision_distance = COMBAT_MESSAGE_RANGE)
		playsound(goon, 'sound/items/weapons/gun/general/magazine_insert_full.ogg', 40, TRUE)
		return FALSE
	switch(goon.goon_weapon)
		if(BOUNTY_GOON_WEAPON_SMG)
			goon.goon_next_fire_at = world.time + BOUNTY_GOON_SMG_COOLDOWN
			playsound(goon, 'sound/items/weapons/gun/smg/smgrack.ogg', 50, TRUE)
			goon.visible_message(span_warning("[goon] brings [goon.p_their()] SMG up level."), vision_distance = COMBAT_MESSAGE_RANGE)
			goon.goon_windup_timer = addtimer(CALLBACK(src, PROC_REF(goon_finish_windup), WEAKREF(goon), WEAKREF(target)), BOUNTY_GOON_SMG_WINDUP, TIMER_STOPPABLE | TIMER_DELETE_ME)
		if(BOUNTY_GOON_WEAPON_SHOTGUN)
			goon.goon_next_fire_at = world.time + BOUNTY_GOON_SHOTGUN_COOLDOWN
			playsound(goon, 'sound/items/weapons/gun/shotgun/rack.ogg', 50, TRUE)
			goon.visible_message(span_warning("[goon] pumps [goon.p_their()] shotgun."), vision_distance = COMBAT_MESSAGE_RANGE)
			goon.goon_windup_timer = addtimer(CALLBACK(src, PROC_REF(goon_finish_windup), WEAKREF(goon), WEAKREF(target)), BOUNTY_GOON_SHOTGUN_WINDUP, TIMER_STOPPABLE | TIMER_DELETE_ME)
		else
			goon.goon_next_fire_at = world.time + BOUNTY_GOON_PISTOL_COOLDOWN
			goon_fire(goon, target)
	return TRUE

/// The wind-up is done: the SMG's burst or the shotgun's blast, if he still can and still sees them
/datum/bounty_kingpin_crew/proc/goon_finish_windup(datum/weakref/goon_ref, datum/weakref/target_ref)
	var/mob/living/basic/bounty_kingpin_goon/goon = goon_ref?.resolve()
	if(QDELETED(goon))
		return
	goon.goon_windup_timer = null
	var/mob/living/target = target_ref?.resolve()
	if(crew_state != BOUNTY_KINGPIN_FIGHTING || !goon.goon_able() || !valid_target(target) || !bounty_kingpin_clear_shot(goon, target))
		return
	if(goon.goon_weapon == BOUNTY_GOON_WEAPON_SHOTGUN)
		if(get_dist(goon, target) <= BOUNTY_GOON_SHOTGUN_RANGE)
			goon_fire(goon, target)
		return
	goon_fire(goon, target)
	for(var/shot in 2 to BOUNTY_GOON_SMG_BURST)
		addtimer(CALLBACK(src, PROC_REF(goon_burst_shot), goon_ref, target_ref), (shot - 1) * BOUNTY_GOON_SMG_BURST_GAP, TIMER_DELETE_ME)

/// The rest of an SMG burst, one shot at a time
/datum/bounty_kingpin_crew/proc/goon_burst_shot(datum/weakref/goon_ref, datum/weakref/target_ref)
	var/mob/living/basic/bounty_kingpin_goon/goon = goon_ref?.resolve()
	var/mob/living/target = target_ref?.resolve()
	if(QDELETED(goon) || crew_state != BOUNTY_KINGPIN_FIGHTING || !goon.goon_able() || !valid_target(target) || !bounty_kingpin_clear_shot(goon, target))
		return
	goon_fire(goon, target)

/// One round from `goon`'s gun at `target` (at the mech they drive, if they drive one), if one is left: every pellet of a shell
/datum/bounty_kingpin_crew/proc/goon_fire(mob/living/basic/bounty_kingpin_goon/goon, mob/living/target)
	if(goon.goon_rounds <= 0)
		return null
	goon.goon_rounds--
	return bounty_kingpin_shoot(goon, shot_target(target), bounty_kingpin_goon_gun(goon.goon_weapon), src)

/// The kingpin's turn: aim at whoever hurt him most, or reload. Never while drawing. Returns TRUE if he sees a hunter.
/datum/bounty_kingpin_crew/proc/boss_tick(mob/living/basic/bounty_criminal/kingpin/kingpin, list/hunters)
	if(kingpin.stat != CONSCIOUS)
		kingpin.kingpin_cancel_aim()
		return FALSE
	var/list/visible = visible_hunters(kingpin, hunters)
	if(!kingpin.kingpin_able())
		kingpin.kingpin_cancel_aim()
		return length(visible) > 0
	if(crew_state != BOUNTY_KINGPIN_FIGHTING || kingpin.kingpin_aim_timer || world.time < kingpin.kingpin_next_aim_at)
		return length(visible) > 0
	if(kingpin.kingpin_rounds <= 0)
		kingpin.kingpin_reload()
		return length(visible) > 0
	var/mob/living/target = kingpin.kingpin_choose_target(visible)
	if(target)
		kingpin.kingpin_start_aim(target)
	return length(visible) > 0

// ===== AT EASE =====

/**
 * A calm second: he gets back on his sofa, goons drift back to their posts and set knocked-over
 * tables back up, he greets whoever comes up to the table, lapsed job offers are forgotten, and now
 * and then someone does something: a smoke, a drink, a word, a hand of cards. The crew still
 * watches: a known hunter in sight, or anyone dragging him off, starts it all again (M2).
 */
/datum/bounty_kingpin_crew/proc/calm_tick()
	if(dismiss_if_boss_gone())
		return
	if(watch_for_trouble())
		return
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin && !kingpin.buckled && kingpin.kingpin_able() && !kingpin.kingpin_sit())
		kingpin.kingpin_go_home()
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		goon_calm_tick(goon)
	right_the_tables()
	prune_job_offers()
	greet_visitors()
	if(world.time >= crew_next_idle_at)
		crew_next_idle_at = world.time + rand(BOUNTY_GOON_IDLE_MIN, BOUNTY_GOON_IDLE_MAX)
		goon_idle()
	if(world.time >= crew_next_boss_idle_at)
		crew_next_boss_idle_at = world.time + rand(BOUNTY_KINGPIN_IDLE_MIN, BOUNTY_KINGPIN_IDLE_MAX)
		boss_idle()

/**
 * At ease, the crew still watches (M2): someone dragging the kingpin (or his body) is an attack, and
 * a known hunter any of them can see starts the fight again, through the draw. Returns TRUE if it
 * started.
 */
/datum/bounty_kingpin_crew/proc/watch_for_trouble()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	var/mob/living/puller = kingpin?.pulledby
	if(isliving(puller) && !is_member(puller))
		member_attacked(kingpin, list(puller))
		if(crew_state != BOUNTY_KINGPIN_CALM)
			return TRUE
	var/list/hunters = live_hunters()
	if(!length(hunters))
		return FALSE
	var/list/lookers = standing_goons()
	if(kingpin && kingpin.stat == CONSCIOUS)
		lookers += kingpin
	for(var/mob/living/looker as anything in lookers)
		if(looker.stat != CONSCIOUS)
			continue
		for(var/mob/living/hunter as anything in hunters)
			if(bounty_kingpin_clear_shot(looker, hunter) && start_shootout(hunter, FALSE))
				return TRUE
	return FALSE

/**
 * The lounge's tables stay on their legs while he's at ease: a goon sets a knocked-over one back
 * up, and a broken one is replaced, with a word from him now and then (H2).
 */
/datum/bounty_kingpin_crew/proc/right_the_tables()
	var/list/goons = standing_goons()
	if(!length(goons))
		return
	var/righted = FALSE
	for(var/datum/weakref/ref as anything in crew_tables.Copy())
		var/obj/structure/table/table = ref?.resolve()
		if(QDELETED(table) || !table.is_flipped)
			continue
		var/mob/living/basic/bounty_kingpin_goon/nearest
		for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in goons)
			if(goon.goon_able() && (!nearest || get_dist(goon, table) < get_dist(nearest, table)))
				nearest = goon
		if(!nearest)
			return
		table.unflip_table()
		nearest.visible_message(span_notice("[nearest] sets [table] back on its legs."), vision_distance = COMBAT_MESSAGE_RANGE)
		righted = TRUE
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(righted && world.time >= crew_next_table_warning && kingpin?.kingpin_can_talk())
		crew_next_table_warning = world.time + BOUNTY_KINGPIN_TABLE_WARN_GAP
		INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living, bounty_say), "furniture", null, TRUE)

/// A goon at ease: back to his post and into his chair, and watching whoever is closest
/datum/bounty_kingpin_crew/proc/goon_calm_tick(mob/living/basic/bounty_kingpin_goon/goon)
	if(!goon.goon_able())
		return
	if(goon.goon_post && get_turf(goon) != goon.goon_post)
		goon.goon_next_move_at = 0
		if(!goon_step_toward(goon, goon.goon_post) && isturf(goon.loc))
			step_towards(goon, goon.goon_post)
		return
	var/obj/structure/chair/chair = goon.goon_chair_ref?.resolve()
	if(chair && !goon.buckled && chair.loc == goon.loc && !chair.has_buckled_mobs())
		chair.buckle_mob(goon, force = TRUE)
		return
	if(goon.buckled)
		return
	var/mob/living/carbon/human/watched
	for(var/mob/living/carbon/human/person in view(4, goon))
		if(person.client && person.stat == CONSCIOUS)
			watched = person
			break
	if(watched && prob(40))
		goon.face_atom(watched)
	else
		goon.setDir(goon.goon_post_dir)

/// Someone came up to the table: a goon warns him, he says hello. Each visitor once per BOUNTY_KINGPIN_GREET_GAP.
/datum/bounty_kingpin_crew/proc/greet_visitors()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(!kingpin?.kingpin_can_talk() || !crew_seat)
		return
	for(var/mob/living/carbon/human/visitor in range(3, crew_seat))
		if(!visitor.client || visitor.stat != CONSCIOUS)
			continue
		var/datum/weakref/ref = WEAKREF(visitor)
		var/last = crew_greeted[ref]
		if(last && world.time - last < BOUNTY_KINGPIN_GREET_GAP)
			continue
		crew_greeted[ref] = world.time
		var/list/goons = standing_goons()
		if(length(goons))
			var/mob/living/basic/bounty_kingpin_goon/goon = pick(goons)
			INVOKE_ASYNC(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_say), "company")
		var/context = "greet"
		if(is_hunter(visitor))
			context = "greet_hostile"
		else if(SSbounty_kingpin.kingpin_bound_refusal(bounty_kingpin_user_ship(visitor), visitor))
			context = "greet_guest"
		addtimer(CALLBACK(kingpin, TYPE_PROC_REF(/mob/living, bounty_say), context, null, TRUE), 1.5 SECONDS, TIMER_DELETE_ME)
		return

/// One goon does something: a quiet word, a smoke, a drink, the cards
/datum/bounty_kingpin_crew/proc/goon_idle()
	var/list/at_ease = list()
	for(var/mob/living/basic/bounty_kingpin_goon/goon as anything in standing_goons())
		if(goon.goon_able())
			at_ease += goon
	if(!length(at_ease))
		return
	var/mob/living/basic/bounty_kingpin_goon/goon = pick(at_ease)
	if(prob(40))
		INVOKE_ASYNC(goon, TYPE_PROC_REF(/mob/living/basic/bounty_kingpin_goon, goon_say), "idle", TRUE)
		return
	var/context = "actions"
	var/turf/spot = get_turf(goon)
	if(locate(/obj/structure/table/wood/poker) in range(1, goon))
		context = prob(60) ? "actions_cards" : "actions"
	else if(locate(/obj/structure/table) in range(1, goon))
		context = prob(50) ? "actions_drink" : "actions"
	else if(prob(40))
		context = "actions_smoke"
	var/action = bounty_kingpin_line("goon", context)
	if(!action)
		return
	goon.manual_emote(action)
	if(context == "actions_smoke" && spot)
		new /obj/effect/temp_visual/small_smoke/halfsecond(spot)

/// He says something to nobody in particular, or puffs his cigar
/datum/bounty_kingpin_crew/proc/boss_idle()
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(!kingpin?.kingpin_can_talk())
		return
	if(prob(50))
		INVOKE_ASYNC(kingpin, TYPE_PROC_REF(/mob/living, bounty_say), "idle")
		return
	var/action = bounty_kingpin_line("kingpin", "actions")
	if(action)
		kingpin.manual_emote(action)
		var/turf/spot = get_turf(kingpin)
		if(spot)
			new /obj/effect/temp_visual/small_smoke/halfsecond(spot)

// =========================================================================
// SHOTS
// =========================================================================

/// The telegraph box on a goon reaching for his gun: as long as the draw
/obj/effect/temp_visual/telegraphing/bounty_kingpin
	duration = BOUNTY_KINGPIN_TELEGRAPH

/**
 * # A shot from the kingpin's crew
 *
 * The real round of the gun that fires it (bounty_kingpin_shoot()). It passes through anyone the
 * crew isn't fighting (bystanders, the crew itself, those who work for him): only a hunter it
 * reaches can be hit.
 */
/obj/projectile/bullet/bounty_kingpin
	name = "bullet"
	/// Weakref to the crew whose shot it is (/datum/bounty_kingpin_crew)
	var/datum/weakref/kingpin_crew_ref

/obj/projectile/bullet/bounty_kingpin/can_hit_target(atom/target, direct_target = FALSE, ignore_loc = FALSE, cross_failed = FALSE)
	if(isliving(target) && !direct_target)
		var/datum/bounty_kingpin_crew/crew = kingpin_crew_ref?.resolve()
		if(!crew?.is_hunter(target))
			return FALSE
	return ..()

/**
 * `shooter` fires one round of `weapon` (a /datum/bounty_real_weapon) at `target` for `crew`: every
 * pellet of a shell, each with the real round's numbers and spread. Returns the first projectile.
 */
/proc/bounty_kingpin_shoot(mob/living/shooter, atom/target, datum/bounty_real_weapon/weapon, datum/bounty_kingpin_crew/crew)
	var/turf/start = get_turf(shooter)
	if(!start || !target || !weapon)
		return null
	var/obj/projectile/bullet/bounty_kingpin/first
	for(var/pellet in 1 to weapon.pellets)
		var/obj/projectile/bullet/bounty_kingpin/bullet = new(start)
		weapon.load(bullet)
		bullet.kingpin_crew_ref = crew ? WEAKREF(crew) : null
		bullet.starting = start
		bullet.firer = shooter
		bullet.fired_from = shooter
		bullet.yo = target.y - start.y
		bullet.xo = target.x - start.x
		bullet.original = target
		bullet.aim_projectile(target, shooter, null, weapon.shot_spread())
		if(QDELETED(bullet))
			continue
		first ||= bullet
		INVOKE_ASYNC(bullet, TYPE_PROC_REF(/obj/projectile, fire))
	if(weapon.fire_sound)
		playsound(shooter, weapon.fire_sound, 60, TRUE)
	if(crew)
		crew.crew_shots++
	return first

/**
 * Whether a shot from `from` would reach `target`: in range, on the same level, and nothing in the
 * way that stops a bullet (walls, windows, closed doors, machines; tables only when flipped toward
 * the shot). People in the way don't count: the crew's shots pass through anyone but a hunter.
 */
/proc/bounty_kingpin_clear_shot(atom/from, atom/target, range = BOUNTY_KINGPIN_SIGHT)
	var/turf/start = get_turf(from)
	var/turf/end = get_turf(target)
	if(!start || !end || start.z != end.z || get_dist(start, end) > range)
		return FALSE
	if(start == end)
		return TRUE
	var/shot_dir = angle2dir_cardinal(get_angle(start, end))
	var/turf/current = get_step_towards(start, end)
	var/steps = 0
	while(current)
		if(++steps > range + 1)
			return FALSE
		if(current != end && (current.density || IS_OPAQUE_TURF(current)))
			return FALSE
		for(var/obj/thing in current)
			if(!thing.density)
				continue
			if(istype(thing, /obj/structure/table))
				var/obj/structure/table/table = thing
				if(table.is_flipped && table.dir != shot_dir)
					return FALSE
				continue
			if(current == end)
				continue
			if(thing.pass_flags_self & PASSTABLE)
				continue
			return FALSE
		if(current == end)
			return TRUE
		current = get_step_towards(current, end)
	return FALSE

// =========================================================================
// HIS POSTING
// =========================================================================

/**
 * # The kingpin's posting
 *
 * P5's posting with his rules: "wanted dead or alive" (alive 100% however he got there, dead 80%),
 * a clock that stops during a shootout, no relisting (he is only ever on his sofa), and no place
 * under the board's live-criminal cap. It never spawns him: it adopts the seated kingpin wherever he
 * is (bounty_kingpin_post()). Nobody who works for him (SSbounty_kingpin's bindings) can hunt him or
 * turn him in. Closed unclaimed, it leaves him in his lounge when he is alive there
 * (kingpin_stays()); otherwise P5 removes him, and he is gone for the round.
 */
/datum/criminal_bounty/kingpin
	/// Every crew has been told he is wanted: once, when it went up (L7)
	var/kingpin_announced = FALSE

// Wanted dead or alive: restrained, stunned or downed is alive and pays in full; dead pays 80%
/datum/criminal_bounty/kingpin/board_share_for(state, worst_state)
	if(!bounty_state_share(state))
		return 0
	if(state == BOUNTY_STATE_DEAD || worst_state == BOUNTY_STATE_DEAD)
		return BOUNTY_KINGPIN_PAY_DEAD
	return BOUNTY_KINGPIN_PAY_ALIVE

/datum/criminal_bounty/kingpin/board_terms()
	return "Wanted dead or alive"

/datum/criminal_bounty/kingpin/board_place_text()
	if(board_relisting)
		return ..()
	return "In the lounge at [board_site_name || "the black market"]"

// The clock stops while his crew is fighting; a hunt doesn't stop it
/datum/criminal_bounty/kingpin/board_clock_held(now = world.time)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = criminal()
	if(!kingpin)
		return !board_proof() && !board_relisting
	return istype(kingpin) && !!kingpin.kingpin_crew?.is_fighting()

// He is already in his lounge: the posting adopts him when it goes up (bounty_kingpin_post()) and never spawns anyone
/datum/criminal_bounty/kingpin/board_arm()
	return FALSE

/// Tells every crew he is wanted, once (L7)
/datum/criminal_bounty/kingpin/proc/kingpin_announce()
	if(kingpin_announced || !is_open())
		return
	kingpin_announced = TRUE
	var/who = record?.alias ? "[record.name], \"[record.alias]\"" : record?.name
	for(var/obj/structure/overmap/ship/ship as anything in SSovermap.simulated_ships)
		if(QDELETED(ship) || ship.abandoned || istype(ship, /obj/structure/overmap/ship/npc))
			continue
		ship.ship_notify("WANTED DEAD OR ALIVE: [who], in the lounge at [board_site_name || "the black market"]. Reward: [board_reward_text()].","MISSION CONTROL", SHIP_NOTIFY_NOTICE, 'voidcrew/sound/notify.ogg', 50)

// Even an admin can't give him to a crew that works for him: they could never turn him in
/datum/criminal_bounty/kingpin/hunt_refusal(obj/structure/overmap/ship/ship, forced = FALSE)
	var/refusal = SSbounty_kingpin.kingpin_bound_refusal(ship)
	if(refusal)
		return refusal
	return ..()

// A ship that works for him can't turn him in, at any pad
/datum/criminal_bounty/kingpin/turn_in(obj/machinery/mission_pad/pad, obj/structure/overmap/ship/ship, mob/user)
	if(is_open())
		var/refusal = SSbounty_kingpin.kingpin_bound_refusal(ship, user)
		if(refusal)
			return refusal
	return ..()

/datum/criminal_bounty/kingpin/board_pad_preview(obj/structure/overmap/ship/ship, obj/machinery/mission_pad/pad)
	var/list/preview = ..()
	if(length(preview) && SSbounty_kingpin.kingpin_bound_refusal(ship))
		preview[1] = FALSE
	return preview

// He is only ever on his sofa: lost, the posting closes rather than listing somewhere else
/datum/criminal_bounty/kingpin/relist(reason)
	if(is_open())
		close(BOUNTY_CLOSE_NO_BODY)
	return FALSE

/**
 * Claimed, he is gone for the round. Closed any other way (run out, withdrawn), a kingpin alive in
 * his lounge stays there, let go of (kingpin_let_go()), and P5's cleanup doesn't touch him; a dead
 * one, or one held away from the lounge, is removed as any criminal is.
 */
/datum/criminal_bounty/kingpin/close(reason, obj/structure/overmap/ship/winner)
	if(status == BOUNTY_POSTING_CLOSED)
		return FALSE
	if(reason == BOUNTY_CLOSE_CLAIMED)
		SSbounty_kingpin.kingpin_set_gone("claimed")
	else
		var/mob/living/basic/bounty_criminal/kingpin/kingpin = criminal()
		if(kingpin_stays(kingpin))
			kingpin_let_go(kingpin)
	. = ..()
	if(.)
		SSbounty_kingpin.kingpin_resolved()

/// Whether `kingpin` stays when it closes unclaimed: alive, with his crew, in his lounge (within his goons' leash of the sofa)
/datum/criminal_bounty/kingpin/proc/kingpin_stays(mob/living/basic/bounty_criminal/kingpin/kingpin)
	if(!istype(kingpin) || QDELETED(kingpin) || kingpin.stat == DEAD || !kingpin.kingpin_crew || HAS_TRAIT(kingpin, TRAIT_BOUNTY_REMOVED))
		return FALSE
	return kingpin.kingpin_on_leash()

/// Lets go of `kingpin`, who stays in his lounge: no longer its criminal, on no posting, and back to business
/datum/criminal_bounty/kingpin/proc/kingpin_let_go(mob/living/basic/bounty_criminal/kingpin/kingpin)
	board_detach_criminal()
	kingpin.posting_ref = null
	REMOVE_TRAIT(kingpin, TRAIT_MISSION_FIELD_MOB, BOUNTY_TRAIT)
	kingpin.kingpin_back_to_business()
	log_game("BOUNTY: [kingpin] stays in the lounge at [AREACOORD(kingpin)] as the [board_log_name()] closes")

// =========================================================================
// SEATING HIM
// =========================================================================

/// The ship `user` belongs to: the crew they fly with, else the ship they stand on
/proc/bounty_kingpin_user_ship(mob/user)
	if(!user)
		return null
	return get_crew_ship(user) || get_ship_from_atom(user)

/// Him in `record`'s face, with his crew, in `outpost`'s lounge, found by its map marks. Returns him, or null.
/proc/bounty_kingpin_seat_at(obj/structure/overmap/trader_outpost/outpost, datum/bounty_record/record)
	var/obj/effect/landmark/bounty_kingpin/seat/seat = bounty_kingpin_find_seat(outpost)
	if(!seat)
		return null
	return bounty_kingpin_setup(get_turf(seat), bounty_kingpin_find_posts(seat), record)

/**
 * The kingpin in `record`'s face at `seat` (on its sofa), on no posting, with a goon at each of
 * `posts` (list(list(turf, BOUNTY_GOON_WEAPON_*), ...)), and his crew knowing the room. Leashed to
 * the trader outpost the seat is in, if it is in one. Returns him.
 */
/proc/bounty_kingpin_setup(turf/seat, list/posts, datum/bounty_record/record)
	if(!seat)
		return null
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = new(seat)
	kingpin.kingpin_crew = new /datum/bounty_kingpin_crew(kingpin, seat)
	kingpin.body_setup(record, null)
	var/obj/structure/overmap/trader_outpost/outpost = get_trader_outpost_for_turf(seat)
	if(outpost)
		kingpin.body_set_site(outpost)
	kingpin.kingpin_sit()
	for(var/list/post as anything in posts)
		kingpin.kingpin_crew.crew_posts += list(post.Copy())
		kingpin.kingpin_crew.spawn_goon(post[1], post[2])
	kingpin.kingpin_crew.find_room()
	return kingpin

/// A new record for a kingpin: Most Wanted, his own archetype, a boss's alias and crime, a base value from his band
/proc/bounty_kingpin_make_record()
	var/datum/bounty_record/record = generate_bounty_record(BOUNTY_TIER_MOST_WANTED, BOUNTY_ARCHETYPE_NORMAL, BOUNTY_PLACEMENT_KINGPIN)
	if(!record)
		return null
	record.tier = BOUNTY_TIER_MOST_WANTED
	record.archetype = BOUNTY_ARCHETYPE_KINGPIN
	record.style = null
	record.kit = null
	var/alias = bounty_kingpin_line("record", "aliases")
	if(alias)
		record.alias = alias
	var/crime = bounty_kingpin_line("record", "crimes")
	if(crime)
		record.crime = crime
	record.base_value = rand(BOUNTY_KINGPIN_PAY_MIN, BOUNTY_KINGPIN_PAY_MAX)
	record.status = BOUNTY_RECORD_WANTED
	return record

/**
 * A kingpin posting on the board for `site` (the black market; null in tests, which takes red
 * space) on `record` (a new one when null): his band times the zone's multiplier, his vouchers (red
 * adds one), 60 minutes on the clock. It holds nobody yet; bounty_kingpin_post() adopts him.
 */
/proc/bounty_kingpin_new_posting(obj/structure/overmap/site, datum/bounty_record/record)
	record ||= bounty_kingpin_make_record()
	if(!record)
		return null
	// A record an earlier posting closed unclaimed is wanted again
	record.status = BOUNTY_RECORD_WANTED
	var/zone = site ? SScriminal_bounties.board_site_zone(site) : ZONE_RED
	var/datum/criminal_bounty/kingpin/posting = new
	posting.record = record
	posting.placement_kind = BOUNTY_PLACEMENT_KINGPIN
	posting.board_zone = zone
	posting.value = SScriminal_bounties.board_value_for(record.base_value, zone)
	posting.board_vouchers = BOUNTY_KINGPIN_VOUCHERS + (zone == ZONE_RED ? BOUNTY_RED_VOUCHER_BONUS : 0)
	posting.board_posted_at = world.time
	posting.expires_at = world.time + BOUNTY_KINGPIN_EXPIRY
	posting.board_gps_tag = "[BOUNTY_GPS_TAG_PREFIX]-[record.id]"
	posting.RegisterSignal(record, COMSIG_BOUNTY_RECORD_MUGSHOT_READY, TYPE_PROC_REF(/datum/criminal_bounty, board_on_mugshot_ready))
	GLOB.criminal_bounties += posting
	if(site)
		posting.board_set_site(site)
	SScriminal_bounties.board_changed()
	log_game("BOUNTY: posted the [posting.board_log_name()] in zone [zone], worth [posting.value] cr and [posting.board_vouchers] voucher(s)")
	return posting

/**
 * Puts `kingpin` on the board as wanted dead or alive: a posting on his own record at the outpost his
 * lounge is in adopts him wherever he is, never a second body, and every crew is told. One at a time.
 * SSbounty_kingpin.kingpin_post() is the way in (the clock and the admin panel). Doesn't sleep.
 * Returns the posting, or null.
 */
/proc/bounty_kingpin_post(mob/living/basic/bounty_criminal/kingpin/kingpin)
	if(!istype(kingpin) || QDELETED(kingpin) || HAS_TRAIT(kingpin, TRAIT_BOUNTY_REMOVED) || kingpin.kingpin_posting() || bounty_kingpin_open_posting())
		return null
	var/obj/structure/overmap/trader_outpost/outpost = kingpin.kingpin_crew?.crew_outpost()
	var/datum/criminal_bounty/kingpin/posting = bounty_kingpin_new_posting(outpost, kingpin.record)
	if(!posting)
		return null
	if(!kingpin.record)
		kingpin.record = posting.record
	if(!posting.board_adopt_criminal(kingpin, outpost, null, null))
		posting.close(BOUNTY_CLOSE_ADMIN)
		return null
	posting.kingpin_announce()
	return posting

/// The open kingpin posting, if there is one
/proc/bounty_kingpin_open_posting()
	for(var/datum/criminal_bounty/kingpin/posting in GLOB.criminal_bounties)
		if(posting.is_open())
			return posting
	return null

/// The black market (the Undertow Exchange), if there is one
/proc/bounty_kingpin_black_market()
	for(var/obj/structure/overmap/trader_outpost/black_market/outpost in GLOB.trader_outposts)
		if(!QDELETED(outpost))
			return outpost
	return null

// =========================================================================
// THE ROUND'S KINGPIN
// =========================================================================

/**
 * # The round's kingpin
 *
 * Seats him in the black market's lounge as soon as it has loaded (checked on each fire), and puts
 * him on the board now and then: the first no earlier than BOUNTY_KINGPIN_FIRST into the round and
 * only with BOUNTY_KINGPIN_MIN_SHIPS active ships, one at a time, the next BOUNTY_KINGPIN_GAP_MIN to
 * _MAX after the last one resolves (economy_v2.md 5.4). That clock and the admin panel are the only
 * ways onto the board. Holds the round's state: who he is, whether he is gone for the round, and who
 * works for him.
 *
 * Working for him binds the crew that took his job, the taker and its roster (by mind and by
 * player, so a new character is still bound): none of them can hunt him or turn him in, at any pad,
 * and no ship with any of them on its roster can. Anyone else aboard that ship at the time is bound
 * too, but only for themselves: they can't press the button or be aboard the ship that turns him
 * in, while their own ship's crew stays free (L4).
 */
SUBSYSTEM_DEF(bounty_kingpin)
	name = "Bounty Kingpin"
	wait = 30 SECONDS
	flags = SS_BACKGROUND | SS_NO_INIT
	runlevels = RUNLEVEL_GAME
	/// world.time he may be posted next: after the last posting resolved, or after a failed try
	var/kingpin_next_at = 0
#ifdef UNIT_TESTS
	/// Whether it seats and posts him on its own. Off in tests, which seat and post their own.
	var/kingpin_auto_post = FALSE
#else
	/// Whether it seats and posts him on its own. Off in tests, which seat and post their own.
	var/kingpin_auto_post = TRUE
#endif
	/// Weakref to the round's kingpin (/mob/living/basic/bounty_criminal/kingpin), once seated
	var/datum/weakref/kingpin_ref
	/// He died, was deleted or was claimed at a pad: nobody seats or posts him again this round
	var/kingpin_gone = FALSE
	/// Weakrefs to the ships that took his work
	var/list/kingpin_bound_ships = list()
	/// Weakrefs to the minds bound with their crew (the taker and their ship's roster)
	var/list/kingpin_bound_minds = list()
	/// The ckeys of those players
	var/list/kingpin_bound_keys = list()
	/// Weakrefs to the minds of others aboard a ship when it took his work, and their ckeys: bound for themselves only
	var/list/kingpin_aboard_minds = list()
	var/list/kingpin_aboard_keys = list()

/datum/controller/subsystem/bounty_kingpin/fire(resumed)
	if(!kingpin_auto_post)
		return
	kingpin_seat_if_needed()
	kingpin_post_if_due()

/datum/controller/subsystem/bounty_kingpin/stat_entry(msg)
	msg = "K:[kingpin() ? 1 : 0]|P:[bounty_kingpin_open_posting() ? 1 : 0]|[kingpin_gone ? "gone" : "next:[max(0, round((kingpin_next_at - world.time) / (1 MINUTES)))]m"]"
	return ..()

/// This round's kingpin, if he is seated and his mob still exists (dead or alive)
/datum/controller/subsystem/bounty_kingpin/proc/kingpin()
	RETURN_TYPE(/mob/living/basic/bounty_criminal/kingpin)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin_ref?.resolve()
	return QDELETED(kingpin) ? null : kingpin

/// Makes `kingpin` this round's kingpin
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_track(mob/living/basic/bounty_criminal/kingpin/kingpin)
	kingpin_ref = (istype(kingpin) && !QDELETED(kingpin)) ? WEAKREF(kingpin) : null

/// Seats him at the black market once it has loaded, unless he sits there already or is gone for the round. Returns him, or null.
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_seat_if_needed()
	if(kingpin_gone || kingpin())
		return null
	var/obj/structure/overmap/trader_outpost/outpost = bounty_kingpin_black_market()
	if(!outpost?.loaded)
		return null
	return kingpin_seat(outpost)

/**
 * Seats the round's kingpin and his crew in `outpost`'s lounge, on a new record and no posting.
 * Never a second one: a kingpin already in the world is taken for him. Nothing once he is gone.
 * Returns him, or null (no lounge to seat him in).
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_seat(obj/structure/overmap/trader_outpost/outpost)
	if(kingpin_gone)
		return null
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(kingpin)
		return kingpin
	for(var/datum/bounty_kingpin_crew/crew as anything in GLOB.bounty_kingpin_crews)
		kingpin = crew.kingpin()
		if(kingpin)
			kingpin_track(kingpin)
			return kingpin
	if(QDELETED(outpost) || !outpost.loaded || !bounty_kingpin_find_seat(outpost))
		return null
	var/datum/bounty_record/record = bounty_kingpin_make_record()
	if(!record)
		return null
	kingpin = bounty_kingpin_seat_at(outpost, record)
	if(!kingpin)
		return null
	kingpin_track(kingpin)
	log_game("BOUNTY: the kingpin [record.name] sat down in the lounge at [outpost.name]")
	return kingpin

/**
 * Why he doesn't go on the board now on the clock, or null if he may: `round_time` into the round,
 * with `active_ships` crewed ships, at world.time `now`.
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_post_refusal(round_time, active_ships, now = world.time)
	if(kingpin_gone)
		return "he's gone for the round"
	if(round_time < BOUNTY_KINGPIN_FIRST)
		return "too early in the round"
	if(active_ships < BOUNTY_KINGPIN_MIN_SHIPS)
		return "not enough ships about"
	if(bounty_kingpin_open_posting())
		return "one is up already"
	if(now < kingpin_next_at)
		return "too soon after the last"
	return null

/// Puts him on the board if he is due. Returns the posting, or null.
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_post_if_due()
	if(kingpin_post_refusal(world.time - SSticker.round_start_time, SScriminal_bounties.board_active_ships()))
		return null
	var/datum/criminal_bounty/kingpin/posting = kingpin_post()
	if(!posting)
		kingpin_next_at = world.time + BOUNTY_KINGPIN_RETRY
	return posting

/**
 * Puts the seated kingpin on the board now (the clock, or an admin; nothing else does): his posting
 * adopts him wherever he is, so a crew that grabbed him early can turn him in once he is posted, and
 * with his crew at ease every empty goon post gets a new goon. Nothing while one is up, or once he is
 * dead or gone. Returns the posting, or null.
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_post()
	if(kingpin_gone)
		return null
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = kingpin()
	if(!kingpin || kingpin.stat == DEAD)
		return null
	var/datum/criminal_bounty/kingpin/posting = bounty_kingpin_post(kingpin)
	if(posting)
		kingpin.kingpin_crew?.restaff()
	return posting

/// `kingpin` died: he is gone for the round. A posting already up holds his body for the dead share; none goes up for it.
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_died(mob/living/basic/bounty_criminal/kingpin/kingpin)
	kingpin_set_gone(kingpin?.kingpin_posting() ? "died on the board" : "died off the board, nothing to claim")

/// `kingpin`'s mob is being deleted: he is gone for the round
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_removed(mob/living/basic/bounty_criminal/kingpin/kingpin)
	if(kingpin_ref && kingpin_ref == kingpin?.weak_reference)
		kingpin_ref = null
	kingpin_set_gone("deleted")

/// He is gone for the round (`reason`): never seated or posted again
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_set_gone(reason)
	if(kingpin_gone)
		return
	kingpin_gone = TRUE
	log_game("BOUNTY: the kingpin is gone for the round ([reason])")

/// A kingpin posting resolved (claimed, expired, closed): the next waits BOUNTY_KINGPIN_GAP_MIN to _MAX
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_resolved()
	kingpin_next_at = world.time + rand(BOUNTY_KINGPIN_GAP_MIN, BOUNTY_KINGPIN_GAP_MAX)

/// Forgets the round's kingpin, whether he is gone and who works for him (the unit tests, between tests)
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_reset()
	kingpin_ref = null
	kingpin_gone = FALSE
	kingpin_bound_ships.Cut()
	kingpin_bound_minds.Cut()
	kingpin_bound_keys.Cut()
	kingpin_aboard_minds.Cut()
	kingpin_aboard_keys.Cut()

// ===== WHO WORKS FOR HIM =====

/// The ckey of `mind`'s player, or null
/proc/bounty_kingpin_mind_key(datum/mind/mind)
	return mind?.key ? ckey(mind.key) : null

/// Whether `ship` took his work
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_ship_bound(obj/structure/overmap/ship/ship)
	return !isnull(ship?.weak_reference) && (ship.weak_reference in kingpin_bound_ships)

/// Whether `mind` (or its player, as any character) is bound with its crew
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_crew_bound(datum/mind/mind)
	if(!mind)
		return FALSE
	if(!isnull(mind.weak_reference) && (mind.weak_reference in kingpin_bound_minds))
		return TRUE
	var/key = bounty_kingpin_mind_key(mind)
	return !isnull(key) && (key in kingpin_bound_keys)

/// Whether `mind` (or its player) works for him in any way: with its crew, or for themselves
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_mind_bound(datum/mind/mind)
	if(!mind)
		return FALSE
	if(kingpin_crew_bound(mind))
		return TRUE
	if(!isnull(mind.weak_reference) && (mind.weak_reference in kingpin_aboard_minds))
		return TRUE
	var/key = bounty_kingpin_mind_key(mind)
	return !isnull(key) && (key in kingpin_aboard_keys)

/// Whether `person` works for him in any way, by their mind or by their ckey
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_person_bound(mob/person)
	if(!person)
		return FALSE
	if(kingpin_mind_bound(person.mind))
		return TRUE
	return !isnull(person.ckey) && ((person.ckey in kingpin_bound_keys) || (person.ckey in kingpin_aboard_keys))

/**
 * Why `ship` (and `user`, pressing the button) can't hunt or turn him in, or null: the ship took
 * his work, `user` works for him, someone on its roster works for him, or someone who does is aboard.
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_bound_refusal(obj/structure/overmap/ship/ship, mob/user)
	if(kingpin_ship_bound(ship))
		return "your crew works for him"
	if(kingpin_person_bound(user))
		return "you work for him"
	if(!ship || (!length(kingpin_bound_minds) && !length(kingpin_aboard_minds) && !length(kingpin_bound_keys) && !length(kingpin_aboard_keys)))
		return null
	for(var/datum/mind/member as anything in ship.ship_team?.members)
		if(kingpin_crew_bound(member))
			return "someone on your crew works for him"
	for(var/datum/weakref/ref as anything in kingpin_bound_minds | kingpin_aboard_minds)
		var/datum/mind/bound = ref?.resolve()
		var/mob/living/body = bound?.current
		if(isliving(body) && body.stat != DEAD && get_ship_from_atom(body) == ship)
			return "someone aboard works for him"
	for(var/mob/living/aboard as anything in GLOB.alive_player_list)
		if(aboard.ckey && get_ship_from_atom(aboard) == ship && kingpin_person_bound(aboard))
			return "someone aboard works for him"
	return null

/**
 * `taker` of `ship` took his work: the ship, the taker and its roster are bound with their crew for
 * the round; anyone else aboard now is bound for themselves; its hunt on him ends.
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_bind(obj/structure/overmap/ship/ship, mob/living/taker)
	var/list/crew_minds = list()
	var/list/aboard_minds = list()
	if(taker?.mind)
		crew_minds |= taker.mind
	if(taker?.ckey)
		kingpin_bound_keys |= taker.ckey
	if(ship)
		kingpin_bound_ships |= WEAKREF(ship)
		for(var/datum/mind/member as anything in ship.ship_team?.members)
			if(member)
				crew_minds |= member
		for(var/mob/living/aboard as anything in GLOB.alive_player_list)
			if(aboard.mind && get_ship_from_atom(aboard) == ship && !(aboard.mind in crew_minds))
				aboard_minds |= aboard.mind
		// Whoever works for him isn't hunting him
		var/datum/criminal_bounty/kingpin/posting = bounty_kingpin_open_posting()
		var/datum/weakref/ship_ref = WEAKREF(ship)
		if(posting && (ship_ref in posting.claimants))
			posting.claimants -= ship_ref
			posting.board_hunt_started -= ship_ref
			ship.remove_waypoint(posting.board_waypoint_key())
			posting.board_unlink_gps(ship)
			ship.ship_notify("WANTED: your crew works for [posting.record?.name || "the kingpin"] now. The hunt is off.", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
	for(var/datum/mind/mind as anything in crew_minds)
		kingpin_bound_minds |= WEAKREF(mind)
		var/key = bounty_kingpin_mind_key(mind)
		if(key)
			kingpin_bound_keys |= key
	for(var/datum/mind/mind as anything in aboard_minds)
		kingpin_aboard_minds |= WEAKREF(mind)
		var/key = bounty_kingpin_mind_key(mind)
		if(key)
			kingpin_aboard_keys |= key
	SScriminal_bounties.board_changed()

// =========================================================================
// OUTPOST SECURITY
// =========================================================================

/**
 * Called from the trader outpost's register_aggression() (one marked line in
 * voidcrew/modules/trade/outpost.dm): TRUE excuses `offender` a strike at `outpost`, because a
 * kingpin shootout is on there and it is a stray from that fight (spec 13: hunters fighting his crew
 * get no property strikes). Only a hunter standing in the lounge who fired at or hit his crew in the
 * last BOUNTY_KINGPIN_EXCUSE_WINDOW is excused, so a crew can't keep a fight going as cover for
 * hitting traders or patrons (L1). PvP enforcement stays: a hit on a person reaches
 * register_aggression() through register_pvp_aggression(), which has just opened the victim's
 * self-defence window this tick, and that is never excused.
 */
/proc/bounty_kingpin_excuses_aggression(obj/structure/overmap/trader_outpost/outpost, mob/living/offender)
	if(!outpost || !offender?.mind || !length(GLOB.bounty_kingpin_crews))
		return FALSE
	for(var/datum/bounty_kingpin_crew/crew as anything in GLOB.bounty_kingpin_crews)
		if(!crew.is_fighting() || !crew.is_hunter(offender))
			continue
		if(get_trader_outpost_for_turf(crew.crew_seat) != outpost)
			continue
		// Only a stray from the fight itself (L1): in the lounge, just after firing at or hitting his crew
		if(!crew.in_lounge(offender) || !crew.engaged(offender))
			continue
		if(bounty_kingpin_pvp_strike_now(outpost, offender))
			return FALSE
		return TRUE
	return FALSE

/// Whether `offender` hit a person at `outpost` this very tick (register_pvp_aggression() has just set that victim's self-defence window)
/proc/bounty_kingpin_pvp_strike_now(obj/structure/overmap/trader_outpost/outpost, mob/living/offender)
	var/due = world.time + OUTPOST_SELF_DEFENSE_DURATION
	for(var/datum/mind/victim as anything in outpost.self_defense_targets)
		var/list/targets = outpost.self_defense_targets[victim]
		if(LAZYACCESS(targets, offender.mind) == due)
			return TRUE
	return FALSE

// =========================================================================
// WHAT THE HUNTERS SAY
// =========================================================================

/// `user` says their line for talk option `option`
/proc/bounty_kingpin_hunter_says(mob/living/user, option)
	var/context
	switch(option)
		if(BOUNTY_KINGPIN_TALK_HERE)
			context = "here"
		if(BOUNTY_KINGPIN_TALK_WORK)
			context = "work"
		if(BOUNTY_KINGPIN_TALK_TAKE_JOB)
			context = "take"
		if(BOUNTY_KINGPIN_TALK_WALK)
			context = "walk"
	var/line = context ? bounty_kingpin_line("hunter", context) : null
	if(line && user.stat == CONSCIOUS)
		user.say(line, forced = "bounty kingpin talk")

// =========================================================================
// THE BOUNTY PANEL
// =========================================================================

// "Post a bounty now" in P8's Bounty Panel gets a kingpin entry through its extension point,
// /datum/bounty_admin_post_action (bounty_admin.dm).
/**
 * The admin's "Post a bounty now" entry for the kingpin: now, whatever the clock says, but still one
 * at a time and never once he is gone for the round. Seats him first if he isn't seated yet.
 */
/datum/bounty_admin_post_action/kingpin
	name = "Kingpin (black market)"

/datum/bounty_admin_post_action/kingpin/post(datum/bounty_admin_panel/panel, mob/user)
	if(SSbounty_kingpin.kingpin_gone)
		return panel.refuse(user, "The kingpin is gone for this round.")
	var/datum/criminal_bounty/kingpin/open = bounty_kingpin_open_posting()
	if(open)
		return panel.refuse(user, "The kingpin is already on the board: [open.record?.name || "someone"].")
	if(!SSbounty_kingpin.kingpin())
		var/obj/structure/overmap/trader_outpost/outpost = bounty_kingpin_black_market()
		if(!outpost?.loaded)
			return panel.refuse(user, "There is no black market to seat him in.")
		if(!SSbounty_kingpin.kingpin_seat(outpost))
			return panel.refuse(user, "The kingpin couldn't be seated.")
	var/datum/criminal_bounty/kingpin/posting = SSbounty_kingpin.kingpin_post()
	if(!posting)
		return panel.refuse(user, "The kingpin couldn't be posted.")
	return "post the kingpin bounty on [posting.record?.name || "nobody"] at [posting.board_site_name || "the black market"]"
