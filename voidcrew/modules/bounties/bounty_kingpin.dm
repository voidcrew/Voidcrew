/**
 * # Bounty hunting: the kingpin
 *
 * Owner: P9 kingpin. Owns this file, voidcrew/_DEFINES/bounty_kingpin.dm,
 * voidcrew/modules/bounties/strings/bounty_kingpin.json, the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_kingpin.dm and the lounge marks on
 * trader_outpost_black_market.dmm. Do not edit this file outside P9.
 *
 * Decision 19 and spec sections 13 and 15: a mob boss holding court on the corp sofa in the black
 * market's lounge, with six goons around the room. He is a fixture of the round, one per round, with
 * a small business; later he is "wanted dead or alive".
 * - Seated (SSbounty_kingpin): from the start of the round, as soon as the black market has loaded
 *   and has his seat mark. His record is made then (Most Wanted, an alias and a crime) and no
 *   posting holds him. Once he dies, his mob is deleted for any reason, or he is claimed at a pad,
 *   he is gone for the round: never seated or posted again. The round-level state (him, gone, and
 *   who works for him) is on the subsystem.
 * - His business: "Got any work?" gets a Drug Run he holds on his crew (BOUNTY_KINGPIN_JOB, made
 *   with the black market's shop so only Vex's counter takes the product; the only place it is given
 *   out). "I'll take it", for 3 minutes after he offered it to that crew, accepts it the way the
 *   trader's board does. Taking it binds the crew: the ship, the taker and its roster (by mind and
 *   ckey), and anyone aboard for themselves, can never hunt him or turn him in, and his goons treat
 *   them as guests. One run at a time (the job's mission_limit, counting the one he holds). He won't
 *   hire drifters or crews who fought his people.
 * - His posting (/datum/criminal_bounty/kingpin): P5's posting with his own shares (alive 100%
 *   however he is brought in, dead 80%), his own card lines and a clock that pauses during a shootout.
 *   It goes up only on the clock (no earlier than 45 minutes in with 3+ active ships, the next 60-90
 *   minutes after the last resolves) or from the admin panel; a shootout never puts him on the
 *   board. It adopts him wherever he is, alive (never a second body), so a crew that grabbed him
 *   early can turn him in once he is posted; with his crew at ease every empty goon post gets a new
 *   goon. Killed before any posting, he is gone with nothing to claim: his body is an ordinary corpse
 *   that the human NPC corpse sweep takes in time. Closed unclaimed (run out, withdrawn), it leaves
 *   him in the lounge, alive, uncuffed and in business, when he is alive within his goons' leash of
 *   the sofa; otherwise he is removed as any criminal is, and gone.
 * - Talking: a radial on him. "We're here for you" and "Walk away" only show once that crew's
 *   ship has taken his open posting from the board; the first gets his confront line and starts the
 *   shootout. Any attack on him or a goon starts it too. A warrant shown to him only gets the
 *   confront line; a reach for his wrists while he can still move gets the line and a shove.
 * - The shootout (/datum/bounty_kingpin_crew): a 0.6 s telegraph where nobody fires ("the goons
 *   reach for their guns", and they really draw them), then first shots spread over half a second,
 *   at most two goons on one hunter in cover. Every shot is a real trigger pull of the real gun in a
 *   hand, through that body's AI controller (ai_interact(), a player's click), and every reload is
 *   the player's reload from the spares they carry. Nobody in his crew fires through someone they
 *   aren't fighting: a bystander, a guest or one of their own in the line holds the shot. He never
 *   leaves the sofa and fires his revolver after a visible 0.5 s aim that a hit spoils. Goons stay
 *   within 7 tiles of the sofa, never shoot anyone who is down, and half of those left walk out once
 *   he falls. The barkeep shouts, the turret ignores both sides, and hunters fighting his crew take
 *   no outpost property strikes (one marked hook in outpost.dm). His crew lives as long as he does.
 * - His body is P2's (/mob/living/carbon/human/npc/bounty_criminal), a real human with or without a
 *   posting: tg's crit, stamina, cuffs and death, P2's capture rules and P5's pad. A boss (aimed crits),
 *   tougher by physiology (BOUNTY_KINGPIN_DAMAGE_TAKEN) and an armoured coat. He gives up (tg's
 *   *surrender) only once his crew is down and he is badly hurt.
 * - Goons (/mob/living/carbon/human/npc/bounty_kingpin_goon) are not bounties: real humans in armour
 *   vests with real pistols, SMGs and shotguns and real spare magazines and shells. Their gear is
 *   locked to them (D3), so nothing they carry is loot; their bodies go with the human NPC corpse sweep.
 *
 * A var this file adds to a shared type carries a `kingpin_` prefix.
 */

/// Every kingpin crew in the world (/datum/bounty_kingpin_crew): the outpost's strike rule asks them who is fighting
GLOBAL_LIST_EMPTY(bounty_kingpin_crews)
/// The lounge marks the map placed (/obj/effect/landmark/bounty_kingpin)
GLOBAL_LIST_EMPTY(bounty_kingpin_marks)

// =========================================================================
// DIALOGUE
// =========================================================================

/// The lines for `context` in `section` of the kingpin's dialogue file ("kingpin", "goon", "hunter", "room", "record"), or an empty list
/proc/bounty_kingpin_lines(section, context)
	var/list/entry = strings(BOUNTY_KINGPIN_STRINGS_FILE, section, BOUNTY_KINGPIN_STRINGS_DIR)
	if(!islist(entry))
		return list()
	var/list/lines = entry[context]
	return islist(lines) ? lines : list()

/// One line for `context` in `section`, with `values`' placeholders filled in ("{job}" = "batch of Blue Sky"); null if there is none that fits
/proc/bounty_kingpin_line(section, context, list/values)
	var/list/usable = list()
	for(var/line in bounty_kingpin_lines(section, context))
		if(!istext(line))
			continue
		for(var/placeholder in values)
			line = replacetext(line, placeholder, "[values[placeholder]]")
		if(findtext(line, "{"))
			continue
		usable += line
	return length(usable) ? pick(usable) : null

// =========================================================================
// THE MAP MARKS
// =========================================================================

/**
 * # Kingpin lounge marks
 *
 * Mapped in the black market's lounge: the seat on the corp sofa, and one post per goon. The
 * kingpin's placement finds them at runtime (bounty_kingpin_find_seat()), never by coordinates.
 */
/obj/effect/landmark/bounty_kingpin
	name = "kingpin mark"

/obj/effect/landmark/bounty_kingpin/Initialize(mapload)
	. = ..()
	GLOB.bounty_kingpin_marks += src

/obj/effect/landmark/bounty_kingpin/Destroy()
	GLOB.bounty_kingpin_marks -= src
	return ..()

/// Where he sits: on the sofa
/obj/effect/landmark/bounty_kingpin/seat
	name = "kingpin seat"

/// A goon's post; the subtype is the goon's gun
/obj/effect/landmark/bounty_kingpin/goon
	name = "kingpin goon post"
	/// BOUNTY_GOON_WEAPON_*
	var/goon_weapon = BOUNTY_GOON_WEAPON_PISTOL

/obj/effect/landmark/bounty_kingpin/goon/pistol

/obj/effect/landmark/bounty_kingpin/goon/smg
	goon_weapon = BOUNTY_GOON_WEAPON_SMG

/obj/effect/landmark/bounty_kingpin/goon/shotgun
	goon_weapon = BOUNTY_GOON_WEAPON_SHOTGUN

/// Where the lounge's bystanders go when the guns come out, and where leaving goons walk to: out of the lounge, and never the hangar lift
/obj/effect/landmark/bounty_kingpin/refuge
	name = "kingpin refuge"

/// The seat mark in `outpost`'s lounge that has a sofa under it, or null
/proc/bounty_kingpin_find_seat(obj/structure/overmap/trader_outpost/outpost)
	if(QDELETED(outpost))
		return null
	for(var/obj/effect/landmark/bounty_kingpin/seat/seat as anything in GLOB.bounty_kingpin_marks)
		if(!istype(seat))
			continue
		var/turf/spot = get_turf(seat)
		// A mark left on a released reservation is not in the lounge any more
		if(!spot || !istype(spot.loc, /area/voidcrew/trader_outpost) || get_trader_outpost_for_turf(spot) != outpost)
			continue
		if(!(locate(/obj/structure/chair/sofa) in spot))
			continue
		return seat
	return null

/// The refuge mark nearest `seat`, on its outpost, or null
/proc/bounty_kingpin_find_refuge(turf/seat)
	if(!seat)
		return null
	var/obj/structure/overmap/trader_outpost/outpost = get_trader_outpost_for_turf(seat)
	var/turf/nearest
	for(var/obj/effect/landmark/bounty_kingpin/refuge/refuge as anything in GLOB.bounty_kingpin_marks)
		if(!istype(refuge))
			continue
		var/turf/spot = get_turf(refuge)
		if(!spot || spot.z != seat.z || get_trader_outpost_for_turf(spot) != outpost)
			continue
		if(!nearest || get_dist(spot, seat) < get_dist(nearest, seat))
			nearest = spot
	return nearest

/// The goon posts around `seat`, on its outpost: list(list(turf, BOUNTY_GOON_WEAPON_*), ...)
/proc/bounty_kingpin_find_posts(obj/effect/landmark/bounty_kingpin/seat/seat)
	var/list/posts = list()
	var/turf/seat_turf = get_turf(seat)
	if(!seat_turf)
		return posts
	var/obj/structure/overmap/trader_outpost/outpost = get_trader_outpost_for_turf(seat_turf)
	var/list/taken = list()
	for(var/obj/effect/landmark/bounty_kingpin/goon/post as anything in GLOB.bounty_kingpin_marks)
		if(!istype(post))
			continue
		var/turf/spot = get_turf(post)
		if(!spot || spot.z != seat_turf.z || get_dist(spot, seat_turf) > BOUNTY_KINGPIN_SIGHT || (spot in taken))
			continue
		if(!istype(spot.loc, /area/voidcrew/trader_outpost) || get_trader_outpost_for_turf(spot) != outpost)
			continue
		taken += spot
		posts += list(list(spot, post.goon_weapon))
		if(length(posts) >= BOUNTY_KINGPIN_GOONS)
			break
	return posts

