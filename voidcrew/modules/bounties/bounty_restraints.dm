/**
 * # Bounty hunting: restraints on a criminal
 *
 * Owner: P2 body. Do not edit this file outside P2.
 *
 * What it owns: cuffing bounty criminals, a port of the prisoner's cuff pattern
 * (outpost_prison_capture.dm) as procs on the criminal (spec sections 4 and 12.3, C1 and C2):
 * - Any tg handcuffs, cable restraints or zipties, used on it by anyone with hands. Only on a criminal
 *   that is downed, stunned or has surrendered, over BOUNTY_CUFF_TIME. On one standing free the cuffs
 *   are refused, and the try alerts it (P3's on_confronted()).
 * - Restrained, it is held still, throws no punches and fires no shots (may_attack()), plans nothing
 *   (TRAIT_BOUNTY_HELD and TRAIT_AI_PAUSED), and can be dragged. A downed one stays down until the
 *   cuffs come off.
 * - Anyone takes them off with an empty hand over BOUNTY_UNCUFF_TIME: handcuffs to their hand, cable
 *   and zipties cut away.
 * - Cable restraints slip after BOUNTY_CABLE_SLIP and zipties after BOUNTY_ZIPTIE_SLIP (a mini-boss in
 *   half the time, and it snaps them), with a visible struggle for the last BOUNTY_SLIP_WARNING.
 *   Handcuffs never slip.
 * - The cuffs show as tg's handcuff overlay, stay in its contents, and drop when it dies or is deleted.
 * Cuffing a criminal gives no claim on it: whoever gets it onto their own pad is paid (decision 18).
 *
 * The shared vars (`restraints` and the rest) are declared in bounty_types.dm and nowhere else; a
 * var only P2 uses goes here, or in bounty_criminal.dm, with a `body_` prefix.
 */

// ===== CUFFING =====

// Restraints go on from the item interaction, ahead of anything else that item might do to it. A
// fulton never goes on: the pad is the only way off its site bar the carry (M2, owner question 10).
/mob/living/basic/bounty_criminal/item_interaction(mob/living/user, obj/item/tool, list/modifiers)
	if(istype(tool, /obj/item/restraints/handcuffs))
		return body_on_cuffs_used(user, tool)
	if(istype(tool, /obj/item/extraction_pack))
		balloon_alert(user, "won't hold [p_them()]!")
		return ITEM_INTERACT_BLOCKING
	return ..()

/// Why `user` can't put `cuffs` on it now, as a balloon alert, or null if they can
/mob/living/basic/bounty_criminal/proc/body_cuff_refusal(mob/living/user, obj/item/restraints/handcuffs/cuffs)
	if(stat == DEAD)
		return "can't cuff [p_them()]"
	if(is_restrained())
		return "already cuffed"
	if(istype(cuffs, /obj/item/restraints/handcuffs/cable/zipties/used) || istype(cuffs, /obj/item/restraints/handcuffs/cable/zipties/fake/used))
		return "used up"
	if(user && !iscyborg(user) && user.usable_hands <= 0)
		return "no hands free"
	// Standing and free, it fights or runs; it has to be put down, stunned or talked into giving up first (C2).
	if(capture_state() == BOUNTY_STATE_FREE)
		return "[p_they()] pull[p_s()] away!"
	return null

/// Restraints used on it: refused with a balloon alert (and a free one is alerted), or put on in the background
/mob/living/basic/bounty_criminal/proc/body_on_cuffs_used(mob/living/user, obj/item/restraints/handcuffs/cuffs)
	var/refusal = body_cuff_work ? "already busy" : body_cuff_refusal(user, cuffs)
	if(refusal)
		balloon_alert(user, refusal)
		// Reaching for its wrists is a confrontation: a meek one bolts, a normal one fights (P3). Blending
		// in, P6's blend component answers for it, the same for the fugitive and its decoys.
		if(!body_cuff_work && !blended && capture_state() == BOUNTY_STATE_FREE)
			body_add_grudge(user)
			INVOKE_ASYNC(src, PROC_REF(on_confronted), user)
		return ITEM_INTERACT_BLOCKING
	INVOKE_ASYNC(src, PROC_REF(body_cuff_by), user, cuffs)
	return ITEM_INTERACT_SUCCESS

/**
 * `user` puts `cuffs` on it over BOUNTY_CUFF_TIME, with tg's cuff sounds. Fails if it gets up or
 * breaks free meanwhile, or moves away. Returns TRUE if it is restrained. Sleeps.
 */
/mob/living/basic/bounty_criminal/proc/body_cuff_by(mob/living/user, obj/item/restraints/handcuffs/cuffs)
	if(body_cuff_work || body_cuff_refusal(user, cuffs))
		return FALSE
	body_cuff_work = TRUE
	user.visible_message(span_danger("[user] is trying to put [cuffs] on [src]!"), span_danger("You try to put [cuffs] on [src]."))
	playsound(src, cuffs.cuffsound, 30, TRUE, -2)
	var/done = do_after(user, BOUNTY_CUFF_TIME, target = src, timed_action_flags = IGNORE_SLOWDOWNS)
	body_cuff_work = FALSE
	if(QDELETED(src))
		return FALSE
	// A borg's cuffs are part of its module: it puts on a new pair of the same kind, as tg's cuffs do for borgs.
	var/dispense = iscyborg(user)
	if(!done || QDELETED(cuffs) || (cuffs.loc != user && !dispense) || body_cuff_refusal(user, cuffs))
		balloon_alert(user, "failed to cuff!")
		return FALSE
	var/success_sound = cuffs.cuffsuccesssound
	if(!body_apply_cuffs(cuffs, user, dispense))
		balloon_alert(user, "failed to cuff!")
		return FALSE
	playsound(src, success_sound, 30, TRUE, -2)
	user.visible_message(span_notice("[user] restrains [src] with [restraints]."), span_notice("You restrain [src] with [restraints]."))
	log_combat(user, src, "restrained")
	return TRUE

/// What `cuffs` turn into once worn: zipties their used pair, fake zipties their fake used pair (tg gives both the real one), anything else stays itself (null)
/proc/bounty_worn_cuffs_type(obj/item/restraints/handcuffs/cuffs)
	if(istype(cuffs, /obj/item/restraints/handcuffs/cable/zipties/fake) && !istype(cuffs, /obj/item/restraints/handcuffs/cable/zipties/fake/used))
		return /obj/item/restraints/handcuffs/cable/zipties/fake/used
	return cuffs?.trashtype

/**
 * Puts `cuffs` on it at once; zipties become their used pair, as on people. `user`, if any, gives
 * them up from their hands, unless `dispense` (a borg), which puts on a new pair of the same kind
 * instead. Returns TRUE if it is restrained.
 */
/mob/living/basic/bounty_criminal/proc/body_apply_cuffs(obj/item/restraints/handcuffs/cuffs, mob/living/user, dispense = FALSE)
	if(is_restrained() || QDELETED(cuffs) || stat == DEAD)
		return FALSE
	var/obj/item/restraints/handcuffs/worn = cuffs
	var/used_path = bounty_worn_cuffs_type(cuffs)
	if(dispense)
		var/dispensed_path = used_path || cuffs.type
		worn = new dispensed_path(src)
	else
		if(user && !user.temporarilyRemoveItemFromInventory(cuffs))
			return FALSE
		if(used_path)
			worn = new used_path(src)
			qdel(cuffs)
		else
			cuffs.forceMove(src)
	if(QDELETED(worn) || worn.loc != src)
		return FALSE
	restraints = worn
	ADD_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_BODY_CUFFS_TRAIT)
	if(pulling)
		stop_pulling()
	ai_controller?.CancelActions()
	body_update_held()
	if(user)
		body_add_grudge(user)
	body_start_slip()
	update_appearance(UPDATE_OVERLAYS)
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_RESTRAINED, user)
	// Forced: the cuffs go on 2 s after a downing or a stun, well inside the cooldown of what they said then (BUG-1).
	if(stat == CONSCIOUS)
		INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), "cuffed", null, TRUE)
	return TRUE

// ===== UNCUFFING =====

// An empty, open hand on a restrained criminal starts taking the restraints off.
/mob/living/basic/bounty_criminal/attack_hand(mob/living/carbon/human/user, list/modifiers)
	if(is_restrained() && stat != DEAD && !user.combat_mode && !LAZYACCESS(modifiers, RIGHT_CLICK))
		INVOKE_ASYNC(src, PROC_REF(body_uncuff_by), user)
		return TRUE
	return ..()

/// `user` takes its restraints off over BOUNTY_UNCUFF_TIME. Returns TRUE if they came off. Sleeps.
/mob/living/basic/bounty_criminal/proc/body_uncuff_by(mob/living/user)
	if(!is_restrained() || body_cuff_work)
		return FALSE
	body_cuff_work = TRUE
	user.visible_message(span_notice("[user] starts taking [restraints] off [src]."), span_notice("You start taking [restraints] off [src]."))
	var/done = do_after(user, BOUNTY_UNCUFF_TIME, target = src)
	body_cuff_work = FALSE
	if(!done || QDELETED(src) || !is_restrained())
		return FALSE
	var/cut = istype(restraints, /obj/item/restraints/handcuffs/cable)
	user.visible_message(span_notice("[user] [cut ? "cuts" : "takes"] [restraints] off [src]."), span_notice("You [cut ? "cut" : "take"] [restraints] off [src]."))
	body_remove_cuffs(user)
	return TRUE

/**
 * Takes its restraints off. With `user`, handcuffs go to their hands (or the floor) and cable and
 * zipties are cut away; without, the restraints drop where it is. Returns the restraints still about,
 * or null.
 */
/mob/living/basic/bounty_criminal/proc/body_remove_cuffs(mob/living/user)
	var/obj/item/restraints/handcuffs/worn = restraints
	if(!worn)
		return null
	// Cleared first, so Exited() leaves the rest to this proc.
	restraints = null
	var/atom/drop_spot = drop_location()
	if(QDELETED(worn))
		worn = null
	else if((user && istype(worn, /obj/item/restraints/handcuffs/cable)) || !drop_spot)
		qdel(worn)
		worn = null
	else
		worn.forceMove(drop_spot)
		if(user)
			user.put_in_hands(worn)
	body_uncuffed(user)
	return worn

/// Its restraints are off, however they came off: it can move and act again, and a downed one whose recovery came due starts getting up
/mob/living/basic/bounty_criminal/proc/body_uncuffed(mob/living/user)
	REMOVE_TRAIT(src, TRAIT_IMMOBILIZED, BOUNTY_BODY_CUFFS_TRAIT)
	body_stop_slip()
	if(QDELETED(src))
		return
	body_update_held()
	update_appearance(UPDATE_OVERLAYS)
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_UNRESTRAINED, user)
	if(downed && body_recovery_due && stat != DEAD)
		body_recovery_due = FALSE
		deltimer(body_recovery_timer)
		body_stir()

/mob/living/basic/bounty_criminal/Exited(atom/movable/gone, direction)
	. = ..()
	if(gone == restraints)
		// Taken or destroyed some other way than body_remove_cuffs()
		restraints = null
		body_uncuffed(null)

// ===== SLIPPING =====

/// How long its restraints hold before it slips them: cable, zipties or joke cuffs; a mini-boss in half the time; 0 for handcuffs, which never slip
/mob/living/basic/bounty_criminal/proc/body_slip_time()
	if(!is_restrained())
		return 0
	var/time
	if(istype(restraints, /obj/item/restraints/handcuffs/fake) || istype(restraints, /obj/item/restraints/handcuffs/cable/zipties/fake))
		time = BOUNTY_FAKE_CUFF_SLIP
	else if(istype(restraints, /obj/item/restraints/handcuffs/cable/zipties))
		time = BOUNTY_ZIPTIE_SLIP
	else if(istype(restraints, /obj/item/restraints/handcuffs/cable))
		time = BOUNTY_CABLE_SLIP
	else
		return 0
	if(istype(src, /mob/living/basic/bounty_criminal/boss))
		time *= BOUNTY_BOSS_SLIP_MULT
	return time

/// Starts the clock on its restraints slipping, if they ever do
/mob/living/basic/bounty_criminal/proc/body_start_slip()
	body_stop_slip()
	var/time = body_slip_time()
	if(time <= 0)
		return
	body_slip_warn_timer = addtimer(CALLBACK(src, PROC_REF(body_slip_warning)), max(0, time - BOUNTY_SLIP_WARNING), TIMER_STOPPABLE | TIMER_DELETE_ME)
	body_slip_timer = addtimer(CALLBACK(src, PROC_REF(body_slip_cuffs)), time, TIMER_STOPPABLE | TIMER_DELETE_ME)

/// Stops the slipping clock
/mob/living/basic/bounty_criminal/proc/body_stop_slip()
	deltimer(body_slip_warn_timer)
	deltimer(body_slip_timer)
	body_slip_warn_timer = null
	body_slip_timer = null

/// The visible struggle before it slips its restraints
/mob/living/basic/bounty_criminal/proc/body_slip_warning()
	body_slip_warn_timer = null
	if(!is_restrained() || stat == DEAD)
		return
	if(istype(src, /mob/living/basic/bounty_criminal/boss))
		visible_message(span_warning("[src] strains against [restraints]."))
	else
		visible_message(span_warning("[src] is working at [restraints]."))
	INVOKE_ASYNC(src, TYPE_PROC_REF(/mob/living, bounty_say), "slipping_cuffs")

/// Out of its restraints: a mini-boss snaps them, anyone else slips them and they drop. Returns TRUE if they came off.
/mob/living/basic/bounty_criminal/proc/body_slip_cuffs()
	body_slip_timer = null
	if(!is_restrained() || stat == DEAD)
		return FALSE
	var/snapped = istype(src, /mob/living/basic/bounty_criminal/boss)
	var/message = snapped ? "[src] snaps [restraints]!" : "[src] slips out of [restraints]!"
	visible_message(span_danger(message))
	var/obj/item/restraints/handcuffs/worn = body_remove_cuffs()
	if(snapped && worn)
		qdel(worn)
	return TRUE
