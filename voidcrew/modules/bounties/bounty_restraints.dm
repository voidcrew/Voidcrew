/**
 * # Bounty hunting: cuffs on a criminal
 *
 * Owner: P2 body. Do not edit this file outside P2.
 *
 * A criminal is cuffed the way a person is: tg's attempt_to_cuff() (4 seconds, anyone with hands, any
 * tg handcuffs, cable restraints or zipties), worn in tg's handcuff slot, and taken off the way anyone's
 * are. A cuffed criminal can walk, as players can; it works at its cuffs through tg's resist (its AI's
 * escape captivity): a minute for handcuffs, 45 s for zipties, 30 s for cable, and dragging it breaks the
 * try (defaults 1.4). Its AI plans nothing else while cuffed.
 *
 * What this file adds:
 * - The reaction to a reach for its wrists (defaults 1.4, CR-7): while it can still move on its own it
 *   steps away a moment after the cuffing starts, which breaks the cuffer's do_after, and then runs or
 *   fights (on_confronted()). Paralysed after giving up, stamcritted, knocked down or in crit, it can't,
 *   and the cuffs go on. A subtype changes it in body_on_cuff_attempt(); the trader-outpost blend takes
 *   it over through COMSIG_BOUNTY_CUFF_REACHED.
 * - COMSIG_BOUNTY_CRIMINAL_RESTRAINED and _UNRESTRAINED for the AI packages, from tg's TRAIT_RESTRAINED.
 * - Fultons never go on (M2, owner question 10): the pad is the only way off its site bar the carry.
 * Cuffing gives no claim on it: whoever gets it onto their own pad is paid (decision 18).
 */

/mob/living/carbon/human/npc/bounty_criminal
	/// Weakref to whoever last reached for its wrists, and when
	var/datum/weakref/body_cuffer_ref
	var/body_cuffed_at = 0
	/// world.time it last started working at its cuffs (tg's cuff_resist())
	var/body_working_cuffs_at = 0

/// Hooks tg's cuffing on it. Called once from Initialize(). Cuffs going on and off come through tg's
/// own TRAIT_RESTRAINED handlers below: a second registration of that signal on itself would replace
/// tg's, and its hands would stay free in cuffs.
/mob/living/carbon/human/npc/bounty_criminal/proc/body_hook_cuffs()
	RegisterSignal(src, COMSIG_CARBON_CUFF_ATTEMPTED, PROC_REF(body_on_cuff_signal))
	RegisterSignal(src, COMSIG_MOB_REMOVING_CUFFS, PROC_REF(body_on_working_cuffs))

/mob/living/carbon/human/npc/bounty_criminal/on_restrained_trait_gain(datum/source)
	. = ..()
	body_on_restrained(source)

/mob/living/carbon/human/npc/bounty_criminal/on_restrained_trait_loss(datum/source)
	. = ..()
	body_on_unrestrained(source)

// A fulton never goes on a criminal (M2).
/mob/living/carbon/human/npc/bounty_criminal/item_interaction(mob/living/user, obj/item/tool, list/modifiers)
	if(istype(tool, /obj/item/extraction_pack))
		balloon_alert(user, "won't hold [p_them()]!")
		return ITEM_INTERACT_BLOCKING
	return ..()

// ===== A REACH FOR ITS WRISTS =====

/// tg's attempt_to_cuff() is about to start on it. Never refuses the cuffs: the body answers the way a person would.
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_cuff_signal(datum/source, mob/living/user)
	SIGNAL_HANDLER
	if(!isliving(user) || user == src || stat == DEAD)
		return NONE
	body_cuffer_ref = WEAKREF(user)
	body_cuffed_at = world.time
	if(SEND_SIGNAL(src, COMSIG_BOUNTY_CUFF_REACHED, user) & COMPONENT_BOUNTY_CUFF_HANDLED)
		return NONE
	body_on_cuff_attempt(user)
	return NONE

/**
 * `user` started cuffing it. While it can still move on its own it puts them on its grudge list and,
 * a moment into their cuffing, steps away from them (breaking the try) and runs or fights. Override
 * for a body that answers differently (a man on his sofa, a don who won't be taken alive). Inside the
 * cuff signal's stack: must not sleep.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_cuff_attempt(mob/living/user)
	if(!body_can_answer_cuffs())
		return
	body_add_grudge(user)
	addtimer(CALLBACK(src, PROC_REF(body_answer_cuffs), WEAKREF(user)), BOUNTY_CUFF_REACTION_DELAY, TIMER_DELETE_ME)

/// Whether it can do anything about a reach for its wrists: awake, on its feet and free to move, not already cuffed, not held or hidden
/mob/living/carbon/human/npc/bounty_criminal/proc/body_can_answer_cuffs()
	if(stat != CONSCIOUS || is_restrained() || buckled || hidden || !isturf(loc))
		return FALSE
	if(HAS_TRAIT(src, TRAIT_INCAPACITATED) || HAS_TRAIT(src, TRAIT_IMMOBILIZED) || HAS_TRAIT(src, TRAIT_FLOORED))
		return FALSE
	return !(pulledby && pulledby.grab_state >= GRAB_AGGRESSIVE)

/// A moment after the reach: a step away from `user_ref`'s owner, then its fight or flight (on_confronted()).
/mob/living/carbon/human/npc/bounty_criminal/proc/body_answer_cuffs(datum/weakref/user_ref)
	var/mob/living/user = user_ref?.resolve()
	if(QDELETED(src) || QDELETED(user) || !body_can_answer_cuffs())
		return
	body_step_away_from(user)
	on_confronted(user)

/// One real step directly or diagonally away from `threat`, onto ground its leash allows. Returns TRUE if it moved.
/mob/living/carbon/human/npc/bounty_criminal/proc/body_step_away_from(atom/threat)
	var/turf/here = get_turf(src)
	if(!here || !threat)
		return FALSE
	var/away = get_dir(threat, src) || pick(GLOB.alldirs)
	for(var/direction in list(away, turn(away, 45), turn(away, -45), turn(away, 90), turn(away, -90)))
		var/turf/step_turf = get_step(here, direction)
		if(!step_turf || step_turf.is_blocked_turf(exclude_mobs = FALSE) || !body_move_allowed(step_turf))
			continue
		if(Move(step_turf, direction))
			return TRUE
	return FALSE

// ===== CUFFS ON AND OFF =====

/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_working_cuffs(datum/source, obj/item/cuffs)
	SIGNAL_HANDLER
	body_working_cuffs_at = world.time

/// Cuffed: the AI packages hear who did it (whoever last reached for its wrists, if it was lately)
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_restrained(datum/source)
	SIGNAL_HANDLER
	if(stat == DEAD || QDELING(src))
		return
	var/mob/living/user = body_cuffer_ref?.resolve()
	if(world.time > body_cuffed_at + 30 SECONDS)
		user = null
	if(user)
		body_add_grudge(user)
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_RESTRAINED, user)

/// Out of its cuffs: the AI packages hear whether it got itself out (null) or someone took them off (src: who isn't known)
/mob/living/carbon/human/npc/bounty_criminal/proc/body_on_unrestrained(datum/source)
	SIGNAL_HANDLER
	if(stat == DEAD || QDELING(src))
		return
	var/self_freed = body_working_cuffs_at && world.time <= body_working_cuffs_at + BOUNTY_SELF_FREED_WINDOW
	body_working_cuffs_at = 0
	body_state_changed()
	SEND_SIGNAL(src, COMSIG_BOUNTY_CRIMINAL_UNRESTRAINED, self_freed ? null : src)
