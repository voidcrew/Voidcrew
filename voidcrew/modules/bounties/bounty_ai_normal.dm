/**
 * # Bounty hunting: the normal criminal's AI
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * What it owns: the normal archetype (spec section 3, C7):
 * - noticing someone armed (aware: up from what they were doing, watching them), and fighting when
 *   attacked, confronted, or when someone with a weapon drawn comes within
 *   BOUNTY_NORMAL_THREAT_RANGE while they are aware;
 * - fighting by style, with its companions called in;
 * - surrendering (TRAIT_BOUNTY_SURRENDERED, source BOUNTY_TRAIT, which P2's capture_state() reads):
 *   rolled on the hit that crosses BOUNTY_SURRENDER_BELOW and on later hits, with two hunters near;
 * - breaking off and retreating when badly hurt with nobody near. They never regenerate.
 * It also owns the fighting styles every bounty fighter uses (criminals, companions, the meek's
 * holdout): /datum/bounty_style and their projectiles. Every blow and shot is the real weapon's
 * (bounty_weapons.dm).
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P3 uses has an
 * `ai_` prefix.
 */

/mob/living/basic/bounty_criminal
	/// Whether the roll on the hit that crosses the surrender line has been made
	var/ai_surrender_rolled = FALSE
	/// world.time the next surrender roll on a later hit may be made
	var/ai_next_surrender_roll = 0

/mob/living/basic/bounty_criminal/normal
	ai_controller = /datum/ai_controller/basic_controller/bounty/criminal/normal

/datum/ai_controller/basic_controller/bounty/criminal/normal
	armed = TRUE
	planning_subtrees = list(
		/datum/ai_planning_subtree/bounty_gate,
		/datum/ai_planning_subtree/bounty_notice,
		/datum/ai_planning_subtree/bounty_fight_target,
		/datum/ai_planning_subtree/basic_ranged_attack_subtree/bounty,
		/datum/ai_planning_subtree/basic_melee_attack_subtree/bounty,
		/datum/ai_planning_subtree/bounty_retreat,
		/datum/ai_planning_subtree/bounty_aware,
		// For a decoy on this tree (P6 gives decoys their fugitive's controller): run, then calm down (M3)
		/datum/ai_planning_subtree/bounty_flee_and_calm,
		/datum/ai_planning_subtree/bounty_activity,
	)

/mob/living/basic/bounty_criminal/normal/ai_wanted_style()
	var/key = record?.style
	if(key && key != BOUNTY_STYLE_HOLDOUT && GLOB.bounty_styles[key])
		return key
	return BOUNTY_STYLE_BRAWLER

/mob/living/basic/bounty_criminal/normal/ai_notice(mob/living/hunter)
	var/mob/living/watched = ai_threat()
	if(ai_mode == BOUNTY_AI_CALM || ai_mode == BOUNTY_AI_RETREATING)
		ai_become_aware(hunter)
	else if(ai_mode == BOUNTY_AI_AWARE && (!watched || bounty_ai_dist(src, hunter) < bounty_ai_dist(src, watched)))
		ai_set_threat(hunter)
	if(ai_mode == BOUNTY_AI_AWARE && bounty_ai_dist(src, hunter) <= BOUNTY_NORMAL_THREAT_RANGE && bounty_ai_is_armed(hunter, weapons_only = TRUE))
		ai_start_fight(hunter)

/mob/living/basic/bounty_criminal/normal/ai_react(mob/living/threat, bark)
	if(!ai_can_act())
		return
	threat = threat || ai_nearest_grudge()
	if(!threat)
		if(ai_should_retreat())
			ai_start_retreat(null)
		return
	ai_start_fight(threat, bark)

/// Hit in a fight by someone new: they turn on whoever is closer (a pilot through their mech, H4)
/mob/living/basic/bounty_criminal/normal/ai_attacked_again(mob/living/attacker)
	if(ai_mode == BOUNTY_AI_FIGHTING)
		ai_rally_companions(attacker)
		var/mob/living/threat = ai_threat()
		if(!threat || bounty_ai_dist(src, attacker) < bounty_ai_dist(src, threat))
			ai_set_threat(attacker)
			ai_controller?.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, bounty_ai_target_for(attacker))
		if(prob(30))
			ai_bark("hurt")
		return
	ai_start_fight(attacker)

/mob/living/basic/bounty_criminal/normal/ai_took_damage(damage, damagetype)
	ai_check_surrender(damage, damagetype)

// ===== AWARE =====

/// Someone armed caught their eye: they stop what they are doing and keep an eye on them
/mob/living/basic/bounty_criminal/proc/ai_become_aware(mob/living/hunter)
	if(!ai_can_act())
		return
	ai_suspend_activity()
	ai_stand_up()
	ai_set_mode(BOUNTY_AI_AWARE)
	ai_set_threat(hunter)
	face_atom(hunter)
	ai_bark("noticed")

/// Watching someone: facing them, back to what they were doing once they have been gone a while
/datum/ai_planning_subtree/bounty_aware

/datum/ai_planning_subtree/bounty_aware/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_AWARE)
		return
	criminal.ai_sees_threat(BOUNTY_FIGHT_VISION)
	if(!criminal.ai_threat() || world.time - criminal.ai_threat_seen_at > BOUNTY_NORMAL_AWARE_FORGET)
		criminal.ai_calm_down()
		return
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

// ===== FIGHTING =====

/// Starts (or keeps) fighting `target`: up, weapon out, companions called in, a line for it. A pilot is fought through their mech (H4).
/mob/living/basic/bounty_criminal/proc/ai_start_fight(mob/living/target, bark)
	if(!ai_can_act() || !isliving(target) || QDELETED(ai_controller))
		return FALSE
	ai_update_style()
	var/fresh = ai_mode != BOUNTY_AI_FIGHTING
	ai_suspend_activity()
	ai_stand_up()
	ai_set_mode(BOUNTY_AI_FIGHTING)
	ai_set_threat(target)
	ai_add_grudge(target)
	var/datum/bounty_style/style = bounty_ai_style(src)
	ai_set_pace(style?.speed || BOUNTY_NORMAL_SPEED_MELEE)
	ai_hand = bounty_ai_update_held(src, ai_hand, bounty_ai_held_look(src))
	if(fresh)
		ai_bark(bark || "fight_start")
	ai_rally_companions(target)
	ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, bounty_ai_target_for(target))
	return TRUE

/**
 * The nearest valid target on their grudge list, keeping the current one while it is still good.
 * Someone in a mech is fought through the mech (H4): tg's melee can't reach a pilot inside.
 */
/mob/living/basic/bounty_criminal/proc/ai_pick_fight_target()
	if(QDELETED(ai_controller))
		return null
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(ai_controller.blackboard[BB_TARGETING_STRATEGY])
	var/atom/current = ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!QDELETED(current) && strategy.can_attack(src, current, BOUNTY_FIGHT_VISION))
		return current
	var/atom/best
	var/best_distance = INFINITY
	for(var/datum/weakref/ref as anything in grudge)
		var/mob/living/enemy = ref?.resolve()
		if(QDELETED(enemy))
			continue
		var/atom/target = bounty_ai_target_for(enemy)
		if(!strategy.can_attack(src, target, BOUNTY_FIGHT_VISION))
			continue
		var/distance = get_dist(src, target)
		if(distance < best_distance)
			best = target
			best_distance = distance
	return best

/// The fight is over: nobody on their grudge list seen for a while
/mob/living/basic/bounty_criminal/proc/ai_fight_over()
	if(ai_should_retreat())
		ai_start_retreat(ai_threat())
		return
	ai_calm_down()

/**
 * In a fight: keeps the target up to date for the attack subtrees below. With nobody to fight they
 * look around where they lost them, then break off (retreating if badly hurt).
 */
/datum/ai_planning_subtree/bounty_fight_target

/datum/ai_planning_subtree/bounty_fight_target/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_FIGHTING)
		return
	var/atom/target = criminal.ai_pick_fight_target()
	if(target)
		// The threat is the person: a mech's pilot
		criminal.ai_set_threat(ismecha(target) ? (bounty_ai_pilot_of(target) || target) : target)
		controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, target)
		return
	controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	var/lost_for = world.time - criminal.ai_threat_seen_at
	if(lost_for > BOUNTY_NORMAL_CALM_AFTER || (lost_for > BOUNTY_NOTICE_INTERVAL * 5 && criminal.ai_should_retreat()))
		criminal.ai_fight_over()
		return
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

/// Whether a pawn is in a fight it can take part in: a criminal fighting, or a companion that has not broken
/proc/bounty_ai_fighting(mob/living/basic/fighter)
	if(istype(fighter, /mob/living/basic/bounty_criminal))
		var/mob/living/basic/bounty_criminal/criminal = fighter
		return criminal.ai_mode == BOUNTY_AI_FIGHTING && criminal.ai_can_act()
	if(istype(fighter, /mob/living/basic/bounty_companion))
		var/mob/living/basic/bounty_companion/companion = fighter
		return companion.ai_can_fight()
	return FALSE

/// tg's melee subtree, for melee styles only, and only in a fight
/datum/ai_planning_subtree/basic_melee_attack_subtree/bounty

/datum/ai_planning_subtree/basic_melee_attack_subtree/bounty/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/datum/bounty_style/style = GLOB.bounty_styles[controller.blackboard[BB_BOUNTY_STYLE]]
	if(!style || style.ranged || !bounty_ai_fighting(controller.pawn))
		return
	return ..()

/// tg's ranged subtree, for ranged styles only, and only in a fight: each style keeps its own distance
/datum/ai_planning_subtree/basic_ranged_attack_subtree/bounty
	ranged_attack_behavior = /datum/ai_behavior/basic_ranged_attack/bounty

/datum/ai_planning_subtree/basic_ranged_attack_subtree/bounty/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/datum/bounty_style/style = GLOB.bounty_styles[controller.blackboard[BB_BOUNTY_STYLE]]
	if(!style?.ranged || !bounty_ai_fighting(controller.pawn))
		return
	if(!controller.blackboard_key_exists(BB_BASIC_MOB_CURRENT_TARGET))
		return
	controller.queue_behavior(style.ranged_behavior, BB_BASIC_MOB_CURRENT_TARGET, BB_TARGETING_STRATEGY, BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION)
	return SUBTREE_RETURN_FINISH_PLANNING

/**
 * tg's ranged attack, with the style doing the shooting: its wind-up telegraph, its magazine and
 * reload, through the mob's ranged_attacks component. The pistol keeps BOUNTY_PISTOL_RANGE off and
 * backs off a step when someone gets inside its style's min_range. Planning carries on meanwhile,
 * so a new target, a retreat or a call for help is picked up mid-fight.
 */
/datum/ai_behavior/basic_ranged_attack/bounty
	// Often enough that the pistol fires at its own pace, and its wind-up is never stretched; each tick walks the line of fire (L10)
	action_cooldown = 0.1 SECONDS
	behavior_flags = AI_BEHAVIOR_REQUIRE_MOVEMENT | AI_BEHAVIOR_MOVE_AND_PERFORM | AI_BEHAVIOR_CAN_PLAN_DURING_EXECUTION
	required_distance = BOUNTY_PISTOL_RANGE
	chase_range = BOUNTY_FIGHT_VISION
	avoid_friendly_fire = TRUE

/datum/ai_behavior/basic_ranged_attack/bounty/perform(seconds_per_tick, datum/ai_controller/controller, target_key, targeting_strategy_key, hiding_location_key)
	var/mob/living/basic/fighter = controller.pawn
	var/atom/target = controller.blackboard[target_key]
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(controller.blackboard[targeting_strategy_key])
	if(!strategy.can_attack(fighter, target, chase_range))
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style?.ranged)
		return AI_BEHAVIOR_INSTANT | AI_BEHAVIOR_FAILED
	if(!can_see(fighter, target, required_distance))
		return AI_BEHAVIOR_INSTANT
	if(style.min_range && get_dist(fighter, target) < style.min_range && !controller.blackboard[BB_BOUNTY_WINDUP_UNTIL])
		back_off(controller, fighter, target)
	if(avoid_friendly_fire && check_friendly_in_path(fighter, target, strategy))
		adjust_position(fighter, target)
		return AI_BEHAVIOR_DELAY
	return style.ranged_tick(fighter, target)

/// tg's sidestep out of a friend's line of fire, never off the leash, into lava or into a chasm (L11)
/datum/ai_behavior/basic_ranged_attack/bounty/adjust_position(mob/living/living_pawn, atom/target)
	var/turf/our_turf = get_turf(living_pawn)
	if(!our_turf)
		return
	var/mob/living/basic/bounty_criminal/leash_holder = bounty_ai_side_of(living_pawn)
	var/list/possible_turfs = list()
	for(var/direction in GLOB.alldirs)
		var/turf/target_turf = get_step(our_turf, direction)
		if(isnull(target_turf) || target_turf.is_blocked_turf() || get_dist(target_turf, target) > get_dist(living_pawn, target))
			continue
		if(islava(target_turf) || ischasm(target_turf) || !target_turf.can_cross_safely(living_pawn))
			continue
		if(leash_holder && !leash_holder.leash_ok(target_turf))
			continue
		possible_turfs += target_turf
	if(!length(possible_turfs))
		return
	var/turf/picked_turf = get_closest_atom(/turf, possible_turfs, target)
	living_pawn.Move(picked_turf, get_dir(living_pawn, picked_turf))

/// A wind-up cut short never carries over: the next shot telegraphs again
/datum/ai_behavior/basic_ranged_attack/bounty/finish_action(datum/ai_controller/controller, succeeded, target_key, targeting_strategy_key, hiding_location_key)
	. = ..()
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)

/// A step back from `target`, now and then, never off the leash
/datum/ai_behavior/basic_ranged_attack/bounty/proc/back_off(datum/ai_controller/controller, mob/living/basic/fighter, atom/target)
	if(world.time < controller.blackboard[BB_BOUNTY_BACKSTEP_AT] || !isturf(fighter.loc))
		return
	controller.set_blackboard_key(BB_BOUNTY_BACKSTEP_AT, world.time + BOUNTY_BACKSTEP_GAP)
	var/away_dir = get_dir(target, fighter)
	var/turf/away = get_step(fighter, away_dir)
	if(!away_dir || !away || away.is_blocked_turf(source_atom = fighter) || islava(away) || ischasm(away))
		return
	var/mob/living/basic/bounty_criminal/leash_holder = bounty_ai_side_of(fighter)
	if(leash_holder && !leash_holder.leash_ok(away))
		return
	fighter.Move(away, away_dir)
	fighter.face_atom(target)

/// The shotgun closes in to BOUNTY_SHOTGUN_RANGE
/datum/ai_behavior/basic_ranged_attack/bounty/close
	required_distance = BOUNTY_SHOTGUN_RANGE

/// The bottle thrower stays BOUNTY_BOTTLE_RANGE off
/datum/ai_behavior/basic_ranged_attack/bounty/throw
	required_distance = BOUNTY_BOTTLE_RANGE

// ===== SURRENDER =====

/**
 * Rolls to give up as a hit is about to land (combat.md N2): BOUNTY_SURRENDER_CHANCE on the hit that
 * crosses BOUNTY_SURRENDER_BELOW, less BOUNTY_SURRENDER_PER_COMPANION for each companion still up,
 * then BOUNTY_SURRENDER_RETRY on later hits at most every BOUNTY_SURRENDER_RETRY_GAP. Only with
 * BOUNTY_SURRENDER_HUNTERS hunters near. Rolled before the damage lands, so the body's mercy rule
 * can see TRAIT_BOUNTY_SURRENDERED on that same hit. Must not sleep: it runs in a signal handler.
 */
/mob/living/basic/bounty_criminal/proc/ai_check_surrender(damage, damagetype)
	if(damage <= 0 || blended || !(damagetype in list(BRUTE, BURN)) || !ai_can_act())
		return FALSE
	var/line = maxHealth * BOUNTY_SURRENDER_BELOW
	var/coeff = damage_coeff?[damagetype]
	var/after = health - damage * (isnull(coeff) ? 1 : coeff)
	var/chance
	if(health > line && after <= line && !ai_surrender_rolled)
		ai_surrender_rolled = TRUE
		chance = ai_surrender_chance()
	else if(health <= line && world.time >= ai_next_surrender_roll)
		chance = BOUNTY_SURRENDER_RETRY
	else
		return FALSE
	ai_next_surrender_roll = world.time + BOUNTY_SURRENDER_RETRY_GAP
	if(bounty_ai_hunters_near(src, BOUNTY_SURRENDER_HUNTER_RANGE) < BOUNTY_SURRENDER_HUNTERS || !prob(chance))
		return FALSE
	ai_surrender()
	return TRUE

/// The chance on the crossing hit: less for each companion still standing with them
/mob/living/basic/bounty_criminal/proc/ai_surrender_chance()
	var/standing = 0
	for(var/mob/living/basic/bounty_companion/buddy as anything in ai_companions())
		if(buddy.ai_can_fight())
			standing++
	return max(0, BOUNTY_SURRENDER_CHANCE - standing * BOUNTY_SURRENDER_PER_COMPANION)

/**
 * They give up: hands up (an overhead mark), no more attacks, cuffable in 2 s, and a full share at
 * the pad until cuffed (P2's capture_state() reads the trait as STUNNED). Hitting them afterwards
 * does not undo it. Their companions may lose heart.
 */
/mob/living/basic/bounty_criminal/proc/ai_surrender()
	if(HAS_TRAIT(src, TRAIT_BOUNTY_SURRENDERED) || stat == DEAD)
		return
	ADD_TRAIT(src, TRAIT_BOUNTY_SURRENDERED, BOUNTY_TRAIT)
	ai_stop_aiming()
	ai_suspend_activity()
	ai_set_mode(BOUNTY_AI_CALM)
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	ai_over_head = bounty_ai_update_held(src, ai_over_head, /obj/effect/abstract/bounty_surrender_mark, over_head = TRUE)
	REMOVE_TRAIT(src, TRAIT_BOUNTY_SPRINTING, BOUNTY_AI_TRAIT)
	if(!QDELETED(ai_controller))
		ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
		ai_controller.ai_movement?.stop_moving_towards(ai_controller)
		ai_controller.CancelActions()
	visible_message(span_notice("[src] raises [p_their()] hands and gives up."))
	// Forced: it usually comes right after a "hurt" line, inside that line's cooldown (BUG-1)
	ai_bark("surrender", TRUE)
	ai_companions_lose_heart()

/// Only its look is used: the hands-up mark over a surrendered criminal's head
/obj/effect/abstract/bounty_surrender_mark
	icon = 'icons/hud/screen_alert.dmi'
	icon_state = "surrender"

// ===== RETREAT =====

/// Badly hurt with no hunter near: they break off rather than wait to be found
/mob/living/basic/bounty_criminal/proc/ai_should_retreat()
	if(!ai_can_act() || health > maxHealth * BOUNTY_NORMAL_RETREAT_BELOW)
		return FALSE
	return !bounty_ai_hunters_near(src, BOUNTY_SURRENDER_HUNTER_RANGE)

/**
 * Gets away from `from` (or where they stand) to somewhere about BOUNTY_NORMAL_RETREAT_DISTANCE
 * off on their site, picked from a handful of random tiles once, and sits it out there. They do not
 * heal; a hunter coming close starts the fight again.
 */
/mob/living/basic/bounty_criminal/proc/ai_start_retreat(mob/living/from)
	if(!ai_can_act() || QDELETED(ai_controller))
		return FALSE
	var/turf/here = get_turf(src)
	var/turf/danger = get_turf(from) || here
	var/turf/best
	var/best_distance = -1
	for(var/attempt in 1 to 12)
		var/turf/tile = locate(here.x + rand(-BOUNTY_NORMAL_RETREAT_DISTANCE, BOUNTY_NORMAL_RETREAT_DISTANCE), here.y + rand(-BOUNTY_NORMAL_RETREAT_DISTANCE, BOUNTY_NORMAL_RETREAT_DISTANCE), here.z)
		if(!isopenturf(tile) || isspaceturf(tile) || islava(tile) || ischasm(tile) || tile.is_blocked_turf(source_atom = src) || !leash_ok(tile))
			continue
		var/distance = get_dist(tile, danger)
		if(distance > best_distance)
			best = tile
			best_distance = distance
	ai_suspend_activity()
	ai_set_mode(BOUNTY_AI_RETREATING)
	ai_hand = bounty_ai_update_held(src, ai_hand, null)
	ai_set_pace(BOUNTY_NORMAL_SPEED_RANGED)
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	if(best)
		ai_controller.set_blackboard_key(BB_BOUNTY_DESTINATION, best)
	else
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
	ai_bark("hurt")
	return TRUE

/// Walks to where they retreat to, then sits down there, winded and hurt
/datum/ai_planning_subtree/bounty_retreat

/datum/ai_planning_subtree/bounty_retreat/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/basic/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_RETREATING)
		return
	var/turf/destination = controller.blackboard[BB_BOUNTY_DESTINATION]
	if(destination && criminal.loc != destination)
		controller.queue_behavior(/datum/ai_behavior/travel_towards/bounty, BB_BOUNTY_DESTINATION)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(destination)
		controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
		criminal.ai_set_pace(BOUNTY_CALM_SPEED)
		criminal.ai_crouch()
		criminal.visible_message(span_notice("[criminal] sits down heavily, catching [criminal.p_their()] breath."))
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

// ===== STYLES =====

/// Every fighting style by key (BOUNTY_STYLE_*), one datum each
GLOBAL_LIST_INIT(bounty_styles, init_bounty_styles())

/proc/init_bounty_styles()
	var/list/styles = list()
	for(var/datum/bounty_style/style_type as anything in subtypesof(/datum/bounty_style))
		var/datum/bounty_style/style = new style_type
		if(style.key)
			styles[style.key] = style
	return styles

/// A fighter's style: from its controller's blackboard
/proc/bounty_ai_style(mob/living/basic/fighter)
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(QDELETED(controller))
		return null
	return GLOB.bounty_styles[controller.blackboard[BB_BOUNTY_STYLE]]

/// The item a fighter fights with and shows in their hand (a typepath), or null for bare fists
/proc/bounty_ai_held_look(mob/living/basic/fighter)
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(QDELETED(controller))
		return null
	return controller.blackboard[BB_BOUNTY_WEAPON]

/// The real weapon a fighter fights with: the item in their hand, loaded as their style loads it. Null with no style.
/proc/bounty_ai_real_weapon(mob/living/basic/fighter)
	var/datum/bounty_style/style = bounty_ai_style(fighter)
	if(!style)
		return null
	return bounty_real_weapon(bounty_ai_held_look(fighter), style.ammo_type)

// A style's health multiplier is P2's bounty_style_health_mult() (bounty_criminal.dm), from the combat.md defines.

/// Stamina damage multiplier of a style (the brawler shrugs off some): P2 folds it into damage_coeff[STAMINA]
/proc/bounty_style_stamina_mult(style_key)
	var/datum/bounty_style/style = GLOB.bounty_styles[style_key]
	return style ? style.stamina_mult : 1

/**
 * Puts style `key` on `fighter`: its weapon (the style's heavy_look if `heavy` and it has one), a
 * full magazine, and the blow and the gun that weapon gives.
 */
/proc/bounty_ai_apply_style(mob/living/basic/fighter, key, heavy = FALSE)
	var/datum/bounty_style/style = GLOB.bounty_styles[key]
	var/datum/ai_controller/controller = fighter?.ai_controller
	if(!style || QDELETED(controller))
		return FALSE
	var/weapon_type = (heavy && style.heavy_look) || style.held_look
	var/datum/bounty_real_weapon/weapon = bounty_real_weapon(weapon_type, style.ammo_type)
	controller.set_blackboard_key(BB_BOUNTY_STYLE, key)
	if(weapon_type)
		controller.set_blackboard_key(BB_BOUNTY_WEAPON, weapon_type)
	else
		controller.clear_blackboard_key(BB_BOUNTY_WEAPON)
	controller.set_blackboard_key(BB_BOUNTY_AMMO, weapon.magazine)
	controller.clear_blackboard_key(BB_BOUNTY_RELOAD_UNTIL)
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)
	style.apply(fighter, weapon)
	return TRUE

/**
 * How someone fights (combat.md 6.2). Criminals, companions and the meek's holdout share these.
 * Every blow and shot is the real weapon's (bounty_weapons.dm): the item the style puts in their
 * hand gives its damage, wounds, armour penetration, rounds and magazine, so a 9mm is a 9mm
 * whoever fires it. The style only sets the timing: how fast they swing or fire, the telegraph, the
 * reload and the distance they keep. Melee styles hit through the mob's own melee attack; ranged
 * ones shoot through its ranged_attacks component. Nothing is spawned for the fight, and nothing
 * drops.
 */
/datum/bounty_style
	/// BOUNTY_STYLE_*
	var/key
	/// Fights at range
	var/ranged = FALSE
	/// Health multiplier (P2 applies it to a criminal; companions apply it themselves)
	var/health_mult = 1
	/// Stamina damage multiplier (P2 applies it to a criminal)
	var/stamina_mult = 1
	/// Between attacks
	var/interval = 1.4 SECONDS
	/// Speed in a fight
	var/speed = BOUNTY_NORMAL_SPEED_MELEE
	/// The real item they fight with, shown in their hand (a typepath; null for bare fists)
	var/held_look
	/// The heavier real item a Wanted criminal carries instead, if the style has one
	var/heavy_look
	/// What a gun is loaded with instead of what it comes with (a shotgun's buckshot)
	var/ammo_type
	/// Ranged: the NPCs' own projectile a round flies as, and the sound of a throw (a gun sounds like itself)
	var/projectile_type
	var/projectile_sound
	/// The ranged behavior that keeps this style's distance
	var/ranged_behavior = /datum/ai_behavior/basic_ranged_attack/bounty
	/// Anyone closer than this and they step back (0: never)
	var/min_range = 0
	/// The telegraph before a shot or throw, and what it says and sounds like
	var/windup = 0
	var/windup_message
	var/windup_sound
	/// How long a reload takes once the magazine is spent, and what it sounds like
	var/reload_time = 0
	var/reload_sound

/// Sets `weapon`'s blow and gun on `fighter`, at this style's pace
/datum/bounty_style/proc/apply(mob/living/basic/fighter, datum/bounty_real_weapon/weapon)
	fighter.melee_attack_cooldown = interval
	weapon.apply_melee(fighter)
	var/datum/component/ranged_attacks/gun = fighter.GetComponent(/datum/component/ranged_attacks)
	if(!gun || !projectile_type)
		return
	gun.casing_type = null
	gun.projectile_type = projectile_type
	gun.projectile_sound = weapon.fire_sound || projectile_sound
	gun.cooldown_time = interval
	gun.burst_shots = null
	gun.burst_intervals = 0

/// Anything extra a melee hit does
/datum/bounty_style/proc/on_melee_hit(mob/living/basic/fighter, mob/living/target)
	return

/// Whether this shot needs the telegraph first
/datum/bounty_style/proc/needs_windup(datum/ai_controller/controller)
	return windup > 0

/// The telegraph: what they say, show and sound like before the shot
/datum/bounty_style/proc/telegraph(mob/living/basic/fighter, atom/target)
	fighter.face_atom(target)
	var/look = bounty_ai_held_look(fighter)
	if(look)
		bounty_ai_hold(fighter, look)
	if(windup_message)
		fighter.visible_message(span_warning(replacetext(windup_message, "%USER", "[fighter]")))
	if(windup_sound)
		playsound(fighter, windup_sound, 50, TRUE)

/**
 * One tick of a ranged fight: reloading, winding up, or firing through the ranged_attacks
 * component when it is ready. Returns the AI behavior flags.
 */
/datum/bounty_style/proc/ranged_tick(mob/living/basic/fighter, atom/target)
	var/datum/ai_controller/controller = fighter.ai_controller
	var/datum/bounty_real_weapon/weapon = bounty_ai_real_weapon(fighter)
	var/magazine = weapon?.magazine
	var/now = world.time
	var/reload_until = controller.blackboard[BB_BOUNTY_RELOAD_UNTIL]
	if(reload_until)
		if(now < reload_until)
			return AI_BEHAVIOR_DELAY
		controller.clear_blackboard_key(BB_BOUNTY_RELOAD_UNTIL)
		controller.set_blackboard_key(BB_BOUNTY_AMMO, magazine)
	if(magazine && controller.blackboard[BB_BOUNTY_AMMO] <= 0)
		controller.set_blackboard_key(BB_BOUNTY_RELOAD_UNTIL, now + reload_time)
		fighter.visible_message(span_notice("[fighter] reloads."))
		if(reload_sound)
			playsound(fighter, reload_sound, 50, TRUE)
		return AI_BEHAVIOR_DELAY
	var/datum/component/ranged_attacks/gun = fighter.GetComponent(/datum/component/ranged_attacks)
	if(!gun)
		return AI_BEHAVIOR_DELAY | AI_BEHAVIOR_FAILED
	var/windup_until = controller.blackboard[BB_BOUNTY_WINDUP_UNTIL]
	if(windup_until && now > windup_until + 1 SECONDS)
		// A wind-up left over from an interrupted fight: it has to be done again
		controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)
		windup_until = null
	if(!windup_until)
		if(gun.fire_cooldown > now + windup)
			return AI_BEHAVIOR_DELAY
		if(needs_windup(controller))
			controller.set_blackboard_key(BB_BOUNTY_WINDUP_UNTIL, now + windup)
			telegraph(fighter, target)
			return AI_BEHAVIOR_DELAY
	else if(now < windup_until)
		fighter.face_atom(target)
		return AI_BEHAVIOR_DELAY
	controller.clear_blackboard_key(BB_BOUNTY_WINDUP_UNTIL)
	fighter.RangedAttack(target)
	return AI_BEHAVIOR_DELAY

/// After each shot: the magazine and the clock for the next string
/datum/bounty_style/proc/after_shot(mob/living/basic/fighter)
	var/datum/ai_controller/controller = fighter.ai_controller
	if(QDELETED(controller))
		return
	controller.set_blackboard_key(BB_BOUNTY_LAST_SHOT, world.time)
	var/datum/bounty_real_weapon/weapon = bounty_ai_real_weapon(fighter)
	if(weapon?.magazine)
		controller.set_blackboard_key(BB_BOUNTY_AMMO, max(0, controller.blackboard[BB_BOUNTY_AMMO] - 1))

/**
 * Loads a shot as it leaves the gun: the real round's numbers and its spread, and the rest of a
 * shell's pellets fired alongside it (one shell, one shot from the magazine). A thrown bottle
 * takes the bottle's throw. Called inside the projectile's fire(): must not sleep.
 */
/datum/bounty_style/proc/prepare_projectile(mob/living/basic/fighter, obj/projectile/shot)
	var/datum/bounty_real_weapon/weapon = bounty_ai_real_weapon(fighter)
	if(!weapon)
		return
	if(istype(shot, /obj/projectile/bounty_bottle))
		weapon.load_thrown(shot)
		return
	var/obj/projectile/bullet/bounty/bullet = shot
	if(!istype(bullet) || bullet.round_loaded)
		return
	bullet.round_loaded = TRUE
	if(!weapon.load(bullet))
		return
	bullet.set_angle(bullet.angle + weapon.shot_spread())
	for(var/pellet in 2 to weapon.pellets)
		INVOKE_ASYNC(GLOBAL_PROC, GLOBAL_PROC_REF(bounty_ai_fire_pellet), fighter, weapon, bullet.type, bullet.original)

/// Another pellet of the shell `fighter` just fired at `target`, with its own spread
/proc/bounty_ai_fire_pellet(mob/living/basic/fighter, datum/bounty_real_weapon/weapon, shot_type, atom/target)
	var/turf/start = get_turf(fighter)
	if(!start || QDELETED(fighter) || QDELETED(target))
		return null
	var/obj/projectile/bullet/bounty/pellet = new shot_type(start)
	pellet.round_loaded = TRUE
	weapon.load(pellet)
	pellet.firer = fighter
	pellet.fired_from = fighter
	pellet.aim_projectile(target, fighter, null, weapon.shot_spread())
	if(QDELETED(pellet))
		return null
	pellet.fire()
	return pellet

/// Bare fists: a human's punch
/datum/bounty_style/brawler
	key = BOUNTY_STYLE_BRAWLER
	health_mult = BOUNTY_BRAWLER_HEALTH
	stamina_mult = BOUNTY_BRAWLER_STAMINA
	interval = BOUNTY_BRAWLER_INTERVAL

/// Now and then a punch shoves them back a tile (never onto lava, into a chasm or out into space, M5) and staggers them; no stun
/datum/bounty_style/brawler/on_melee_hit(mob/living/basic/fighter, mob/living/target)
	if(target.stat != CONSCIOUS || !prob(BOUNTY_BRAWLER_SHOVE_CHANCE))
		return
	bounty_ai_shove_back(fighter, target)
	target.apply_status_effect(/datum/status_effect/staggered, BOUNTY_BRAWLER_STAGGER)
	fighter.visible_message(span_warning("[fighter] shoves [target] back!"))
	playsound(target, 'sound/items/weapons/shove.ogg', 50, TRUE)

/// The blade's own cuts bleed, as a real one's do
/datum/bounty_style/knife
	key = BOUNTY_STYLE_KNIFE
	health_mult = BOUNTY_KNIFE_HEALTH
	interval = BOUNTY_KNIFE_INTERVAL
	held_look = /obj/item/knife/kitchen
	heavy_look = /obj/item/knife/combat

/datum/bounty_style/club
	key = BOUNTY_STYLE_CLUB
	health_mult = BOUNTY_CLUB_HEALTH
	interval = BOUNTY_CLUB_INTERVAL
	held_look = /obj/item/melee/baseball_bat
	heavy_look = /obj/item/melee/baseball_bat/ablative

/// A bat knocks them back a tile or two, gently, as tg's bat does; never onto lava, into a chasm or out into space
/datum/bounty_style/club/on_melee_hit(mob/living/basic/fighter, mob/living/target)
	if(QDELETED(target) || target.stat == DEAD)
		return
	bounty_throw_back(fighter, target, rand(1, 2), prob(60) ? 1 : 4, gentle = TRUE)

/datum/bounty_style/pistol
	key = BOUNTY_STYLE_PISTOL
	ranged = TRUE
	health_mult = BOUNTY_PISTOL_HEALTH
	interval = BOUNTY_PISTOL_INTERVAL
	speed = BOUNTY_NORMAL_SPEED_RANGED
	held_look = /obj/item/gun/ballistic/automatic/pistol/aps
	projectile_type = /obj/projectile/bullet/bounty
	windup = BOUNTY_PISTOL_WINDUP
	windup_message = "%USER raises a pistol."
	windup_sound = 'sound/items/weapons/gun/pistol/rack_small.ogg'
	min_range = BOUNTY_PISTOL_MIN_RANGE
	reload_time = BOUNTY_PISTOL_RELOAD
	reload_sound = 'sound/items/weapons/gun/pistol/mag_insert.ogg'

/// Only the first shot of a string needs the gun raised
/datum/bounty_style/pistol/needs_windup(datum/ai_controller/controller)
	var/last_shot = controller.blackboard[BB_BOUNTY_LAST_SHOT]
	return !last_shot || world.time - last_shot > BOUNTY_PISTOL_STRING_GAP

/// A reload starts a new string
/datum/bounty_style/pistol/ranged_tick(mob/living/basic/fighter, atom/target)
	var/datum/ai_controller/controller = fighter.ai_controller
	if(controller.blackboard[BB_BOUNTY_RELOAD_UNTIL] && world.time >= controller.blackboard[BB_BOUNTY_RELOAD_UNTIL])
		controller.clear_blackboard_key(BB_BOUNTY_LAST_SHOT)
	return ..()

/// Buckshot: every pellet of a shell, one shell a shot
/datum/bounty_style/shotgun
	key = BOUNTY_STYLE_SHOTGUN
	ranged = TRUE
	health_mult = BOUNTY_SHOTGUN_HEALTH
	interval = BOUNTY_SHOTGUN_INTERVAL
	speed = BOUNTY_NORMAL_SPEED_RANGED
	held_look = /obj/item/gun/ballistic/shotgun
	heavy_look = /obj/item/gun/ballistic/shotgun/automatic/combat
	ammo_type = /obj/item/ammo_casing/shotgun/buckshot
	projectile_type = /obj/projectile/bullet/bounty
	ranged_behavior = /datum/ai_behavior/basic_ranged_attack/bounty/close
	windup = BOUNTY_SHOTGUN_WINDUP
	windup_message = "%USER pumps the shotgun."
	windup_sound = 'sound/items/weapons/gun/shotgun/rack.ogg'
	reload_time = BOUNTY_SHOTGUN_RELOAD
	reload_sound = 'sound/items/weapons/gun/shotgun/insert_shell.ogg'

/// A beer bottle, thrown: it hits with the bottle's throwforce, and breaks
/datum/bounty_style/bottle
	key = BOUNTY_STYLE_BOTTLE
	ranged = TRUE
	health_mult = BOUNTY_BOTTLE_HEALTH
	interval = BOUNTY_BOTTLE_INTERVAL
	speed = BOUNTY_NORMAL_SPEED_RANGED
	held_look = /obj/item/reagent_containers/cup/glass/bottle/beer
	projectile_type = /obj/projectile/bounty_bottle
	projectile_sound = 'sound/items/weapons/punchmiss.ogg'
	ranged_behavior = /datum/ai_behavior/basic_ranged_attack/bounty/throw
	min_range = BOUNTY_BOTTLE_MIN_RANGE
	windup = BOUNTY_BOTTLE_WINDUP
	windup_message = "%USER winds up to throw a bottle."

/**
 * The meek's little gun: a quick volley when cornered, once per cornering. The volley is fired
 * one shot at a time by the meek AI (bounty_ai_meek.dm), each shot checking they can still shoot,
 * so the gun here only has to be ready again between shots.
 */
/datum/bounty_style/holdout
	key = BOUNTY_STYLE_HOLDOUT
	ranged = TRUE
	interval = BOUNTY_MEEK_PISTOL_GAP * 0.8
	speed = BOUNTY_MEEK_SPRINT_SPEED
	held_look = /obj/item/gun/ballistic/automatic/pistol
	projectile_type = /obj/projectile/bullet/bounty/holdout

// ===== WHAT THEY FIRE =====

/**
 * A criminal's bullet or pellet: the real round's numbers are put on it as it is fired
 * (/datum/bounty_style/proc/prepare_projectile()), embedding and all. It never hits the shooter's
 * own gang, and off their site or at a trader outpost it passes anyone the body's rules leave alone
 * (AR-C8, AR-D1; bounty_ai_may_hit(), so a companion's shots don't depend on its criminal being up,
 * H3): only a direct target is hit regardless.
 */
/obj/projectile/bullet/bounty
	name = "bullet"
	/// The round's numbers are on it already: a pellet fired alongside a shell's first
	var/round_loaded = FALSE

/obj/projectile/bullet/bounty/can_hit_target(atom/target, direct_target = FALSE, ignore_loc = FALSE, cross_failed = FALSE)
	. = ..()
	if(!. || direct_target || !isliving(target) || !firer)
		return
	if(!bounty_ai_may_hit(firer, target))
		return FALSE

/// The meek's holdout fires these
/obj/projectile/bullet/bounty/holdout
	name = "small bullet"

/**
 * A thrown bottle: it flies slower than a bullet, hits with the bottle's throw, and smashes where it
 * lands, leaving broken glass on the floor (a decal, never a weapon).
 */
/obj/projectile/bounty_bottle
	name = "bottle"
	icon = 'icons/obj/drinks/bottles.dmi'
	icon_state = "beer"
	damage_type = BRUTE
	armor_flag = MELEE
	speed = 0.6
	range = BOUNTY_BOTTLE_REACH
	hitsound = 'sound/effects/glass/glassbr1.ogg'
	hitsound_wall = 'sound/effects/glass/glassbr2.ogg'
	/// Smashed already, so it leaves glass once
	var/smashed = FALSE

/obj/projectile/bounty_bottle/can_hit_target(atom/target, direct_target = FALSE, ignore_loc = FALSE, cross_failed = FALSE)
	. = ..()
	if(!. || direct_target || !isliving(target) || !firer)
		return
	if(!bounty_ai_may_hit(firer, target))
		return FALSE

/obj/projectile/bounty_bottle/on_hit(atom/target, blocked = 0, pierce_hit)
	. = ..()
	smash(get_turf(target))

/obj/projectile/bounty_bottle/on_range()
	smash(get_turf(src))
	return ..()

/// Broken glass where it landed
/obj/projectile/bounty_bottle/proc/smash(turf/where)
	if(smashed || !where)
		return
	smashed = TRUE
	if(!isgroundlessturf(where) && !isspaceturf(where))
		new /obj/effect/decal/cleanable/glass(where)
	playsound(where, 'sound/effects/glass/glassbr3.ogg', 50, TRUE)
