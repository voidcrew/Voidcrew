/**
 * # Bounty hunting: the normal criminal's AI
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * What it owns: the normal archetype (spec section 3, C7):
 * - noticing someone armed (aware: up from what they were doing, watching them), and fighting when
 *   attacked, confronted, or when someone with a weapon drawn comes within
 *   BOUNTY_NORMAL_THREAT_RANGE while they are aware;
 * - fighting by style with the real weapon they carry (bounty_styles.dm), their companions called in;
 * - giving up (CR-10): an AI choice followed by tg's *surrender, through the human NPC base
 *   (/datum/human_npc_surrender/bounty below: hurt, with hunters around them, less likely for each
 *   companion still standing). tg's 20 second paralysis is the cuff window; nobody cuffs them in it and
 *   they decide again: give up again, run, or fight on;
 * - breaking off and retreating when badly hurt with nobody near: they sit down there and patch
 *   themselves up with what they carry (N6), and nothing else heals them;
 * - what they wear: plain clothes for their zone, their tier's armour, their style's weapon and spares,
 *   and a bruise pack; a stimpack when Wanted, a combat stimpack when Most Wanted, if a pocket is free;
 * - combat sense (bounty_combat_sense.dm): the stimpack when they tire, cover or a charge under stun fire.
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P3 uses has an
 * `ai_` prefix.
 */

/mob/living/carbon/human/npc/bounty_criminal/normal
	ai_controller = /datum/ai_controller/basic_controller/bounty/criminal/normal
	npc_surrender = /datum/human_npc_surrender/bounty

/datum/ai_controller/basic_controller/bounty/criminal/normal
	planning_subtrees = list(
		/datum/ai_planning_subtree/human_npc_soft_crit,
		/datum/ai_planning_subtree/bounty_escape_captivity,
		/datum/ai_planning_subtree/human_npc_walk_out,
		/datum/ai_planning_subtree/human_npc_surrender,
		/datum/ai_planning_subtree/bounty_gate,
		/datum/ai_planning_subtree/bounty_notice,
		/datum/ai_planning_subtree/bounty_fight_target,
		// Its chrome: a tell, then the implant's own action (C0, bounty_chrome.dm)
		/datum/ai_planning_subtree/bounty_chrome,
		/datum/ai_planning_subtree/npc_combat_sense,
		/datum/ai_planning_subtree/bounty_arm,
		/datum/ai_planning_subtree/bounty_ranged,
		/datum/ai_planning_subtree/bounty_melee,
		/datum/ai_planning_subtree/bounty_retreat,
		/datum/ai_planning_subtree/bounty_treat_self,
		/datum/ai_planning_subtree/bounty_aware,
		// For a decoy on this tree (P6 gives decoys their fugitive's controller): run, then calm down (M3)
		/datum/ai_planning_subtree/bounty_flee_and_calm,
		/datum/ai_planning_subtree/bounty_activity,
	)

/mob/living/carbon/human/npc/bounty_criminal/normal/ai_wanted_style()
	var/key = record?.style
	if(key && key != BOUNTY_STYLE_HOLDOUT && GLOB.bounty_styles[key])
		return key
	return BOUNTY_STYLE_BRAWLER

/**
 * Plain clothes for their zone, their tier's armour, their style's weapon and spares, a bruise pack, and a
 * stimulant for when they tire in a fight (combat sense, bounty_combat_sense.dm): a stimpack when Wanted,
 * a combat stimpack when Most Wanted. The stimulant goes in a pocket, if the style left one free: a pistol's
 * spare magazine or a knife fills the second pocket, and a holster or bandolier takes nothing else.
 */
/mob/living/carbon/human/npc/bounty_criminal/normal/bounty_build_outfit(zone)
	var/datum/outfit/outfit = bounty_fighter_outfit(BOUNTY_ARCHETYPE_NORMAL, zone, record?.tier, ai_wanted_style(), ai_heavy_weapon(), /obj/item/stack/medical/bruise_pack)
	var/stimulant
	switch(record?.tier)
		if(BOUNTY_TIER_WANTED)
			stimulant = /obj/item/reagent_containers/hypospray/medipen/stimpack
		if(BOUNTY_TIER_MOST_WANTED)
			stimulant = /obj/item/reagent_containers/hypospray/medipen/stimpack/traitor
	if(stimulant && outfit && (!outfit.r_pocket || !outfit.l_pocket))
		bounty_outfit_carry(outfit, stimulant)
	return outfit

/mob/living/carbon/human/npc/bounty_criminal/normal/ai_notice(mob/living/hunter)
	var/mob/living/watched = ai_threat()
	if(ai_mode == BOUNTY_AI_CALM || ai_mode == BOUNTY_AI_RETREATING)
		ai_become_aware(hunter)
	else if(ai_mode == BOUNTY_AI_AWARE && (!watched || bounty_ai_dist(src, hunter) < bounty_ai_dist(src, watched)))
		ai_set_threat(hunter)
	if(ai_mode == BOUNTY_AI_AWARE && bounty_ai_dist(src, hunter) <= BOUNTY_NORMAL_THREAT_RANGE && bounty_ai_is_armed(hunter, weapons_only = TRUE))
		ai_start_fight(hunter)

/mob/living/carbon/human/npc/bounty_criminal/normal/ai_react(mob/living/threat, bark)
	if(!ai_can_act())
		return
	threat = threat || ai_nearest_grudge()
	if(!threat)
		if(ai_should_retreat())
			ai_start_retreat(null)
		return
	ai_start_fight(threat, bark)

/// Hit in a fight by someone new: they turn on whoever is closer (a pilot through their mech, H4)
/mob/living/carbon/human/npc/bounty_criminal/normal/ai_attacked_again(mob/living/attacker)
	if(ai_mode == BOUNTY_AI_FIGHTING)
		ai_rally_companions(attacker)
		var/mob/living/threat = ai_threat()
		if(!threat || bounty_ai_dist(src, attacker) < bounty_ai_dist(src, threat))
			ai_set_threat(attacker)
			ai_controller?.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, bounty_ai_target_for(attacker))
		if(prob(30))
			ai_bark("hurt")
		return
	ai_start_fight(attacker)

// ===== AWARE =====

/// Someone armed caught their eye: they stop what they are doing and keep an eye on them
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_become_aware(mob/living/hunter)
	if(!ai_can_act())
		return
	ai_suspend_activity()
	ai_stand_up()
	ai_set_mode(BOUNTY_AI_AWARE)
	ai_set_threat(hunter)
	face_atom(hunter)
	ai_bark("noticed")

/// Watching someone: facing them, back to what they were doing once they have been gone a while
/datum/ai_planning_subtree/bounty_aware

/datum/ai_planning_subtree/bounty_aware/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_AWARE)
		return
	criminal.ai_sees_threat(BOUNTY_FIGHT_VISION)
	if(!criminal.ai_threat() || world.time - criminal.ai_threat_seen_at > BOUNTY_NORMAL_AWARE_FORGET)
		criminal.ai_calm_down()
		return
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

// ===== FIGHTING =====

/**
 * Starts (or keeps) fighting `target`: up, at a run, companions called in, a line for it. The weapon
 * comes out of its holster, pocket or bag through the arm subtree (bounty_styles.dm). A pilot is fought
 * through their mech (H4).
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_start_fight(mob/living/target, bark)
	if(!ai_can_act() || !isliving(target) || QDELETED(ai_controller))
		return FALSE
	ai_update_style()
	var/fresh = ai_mode != BOUNTY_AI_FIGHTING
	ai_suspend_activity()
	ai_stand_up()
	ai_set_mode(BOUNTY_AI_FIGHTING)
	ai_set_threat(target)
	ai_add_grudge(target)
	ai_set_pace(BOUNTY_RUN_SPEED)
	if(fresh)
		ai_bark(bark || "fight_start")
	ai_rally_companions(target)
	ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, bounty_ai_target_for(target))
	return TRUE

/**
 * The nearest valid target on their grudge list, keeping the current one while it is still good.
 * Someone in a mech is fought through the mech (H4): tg's melee can't reach a pilot inside.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_pick_fight_target()
	if(QDELETED(ai_controller))
		return null
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(ai_controller.blackboard[BB_TARGETING_STRATEGY])
	var/atom/current = ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET]
	if(!QDELETED(current) && strategy.can_attack(src, current, BOUNTY_FIGHT_VISION))
		return current
	var/atom/best
	var/best_distance = INFINITY
	for(var/datum/weakref/ref as anything in grudge)
		var/mob/living/enemy = ref?.resolve()
		if(QDELETED(enemy))
			continue
		var/atom/target = bounty_ai_target_for(enemy)
		if(!strategy.can_attack(src, target, BOUNTY_FIGHT_VISION))
			continue
		var/distance = get_dist(src, target)
		if(distance < best_distance)
			best = target
			best_distance = distance
	return best

/// The fight is over: nobody on their grudge list seen for a while
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_fight_over()
	if(ai_should_retreat())
		ai_start_retreat(ai_threat())
		return
	ai_calm_down()

/**
 * In a fight: keeps the target up to date for the attack subtrees below. With nobody to fight they
 * look around where they lost them, then break off (retreating if badly hurt).
 */
/datum/ai_planning_subtree/bounty_fight_target

/datum/ai_planning_subtree/bounty_fight_target/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_FIGHTING)
		return
	var/atom/target = criminal.ai_pick_fight_target()
	if(target)
		// The threat is the person: a mech's pilot
		criminal.ai_set_threat(ismecha(target) ? (bounty_ai_pilot_of(target) || target) : target)
		controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, target)
		return
	controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	var/lost_for = world.time - criminal.ai_threat_seen_at
	if(lost_for > BOUNTY_NORMAL_CALM_AFTER || (lost_for > BOUNTY_NOTICE_INTERVAL * 5 && criminal.ai_should_retreat()))
		criminal.ai_fight_over()
		return
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING

// ===== SURRENDER (CR-10) =====

/**
 * When a normal criminal or a companion gives up (defaults CR-10, 1.3): at or below 40% of its health,
 * with two hunters within seven tiles that it can see; 60% on its first roll of a fight, less 20 for
 * each companion still standing with it, then 25% every 5 seconds. Through the human NPC base's
 * human_npc_surrender subtree, which stows the weapon, says the line and runs tg's *surrender.
 */
/datum/human_npc_surrender/bounty
	chance = BOUNTY_SURRENDER_CHANCE
	retry_chance = BOUNTY_SURRENDER_RETRY
	ally_penalty = BOUNTY_SURRENDER_PER_COMPANION
	health_share = BOUNTY_SURRENDER_BELOW
	hostiles_needed = BOUNTY_SURRENDER_HUNTERS
	range = BOUNTY_SURRENDER_HUNTER_RANGE
	retry_delay = BOUNTY_SURRENDER_RETRY_GAP

/// The hunters near it that can see it: a spatial grid lookup of player mobs, as the criminal AI looks around
/datum/human_npc_surrender/bounty/hostiles_near(mob/living/carbon/human/npc/npc)
	. = list()
	var/turf/here = get_turf(npc)
	if(!here)
		return
	for(var/mob/living/person in SSspatial_grid.orthogonal_range_search(here, SPATIAL_GRID_CONTENTS_TYPE_CLIENTS, range))
		if(!bounty_ai_is_hunter(person) || get_dist(here, person) > range || !can_see(person, here, range))
			continue
		. += person

/// The companions still standing with it (a companion counts its criminal's other companions)
/datum/human_npc_surrender/bounty/allies_near(mob/living/carbon/human/npc/npc)
	. = list()
	var/mob/living/carbon/human/npc/bounty_criminal/side = bounty_ai_side_of(npc)
	if(!side)
		return
	for(var/mob/living/carbon/human/npc/bounty_companion/buddy as anything in side.ai_companions())
		if(buddy != npc && buddy.ai_can_fight() && buddy.body_position == STANDING_UP)
			. += buddy

/// Not while blended in at a trader outpost (nothing gives the fugitive away but P6's rules, C1)
/datum/human_npc_surrender/bounty/should_consider(mob/living/carbon/human/npc/npc, list/hostiles, list/allies)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = npc
	if(istype(criminal) && criminal.blended)
		return FALSE
	return ..()

/// The chance on the first roll of a fight: less for each companion still standing with them
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_surrender_chance()
	var/datum/human_npc_surrender/rules = npc_surrender_rules() || human_npc_singleton(/datum/human_npc_surrender/bounty)
	return rules.odds(src, list(src), rules.allies_near(src), TRUE)

/**
 * Gives up now: the human NPC base's npc_surrender() (the weapon stowed, the line, tg's *surrender).
 * Returns TRUE if they are lying there with their hands on their head. Its AI side
 * (ai_on_surrendered()) runs from the base's COMSIG_HUMAN_NPC_SURRENDERED.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_surrender()
	return npc_surrender()

// ===== RETREAT =====

/// Badly hurt with no hunter near: they break off rather than wait to be found
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_should_retreat()
	if(!ai_can_act() || health > maxHealth * BOUNTY_NORMAL_RETREAT_BELOW)
		return FALSE
	return !bounty_ai_hunters_near(src, BOUNTY_SURRENDER_HUNTER_RANGE)

/**
 * Gets away from `from` (or where they stand) to somewhere about BOUNTY_NORMAL_RETREAT_DISTANCE
 * off on their site, picked from a handful of random tiles once, and sits it out there, patching
 * themselves up with what they carry. A hunter coming close starts the fight again.
 */
/mob/living/carbon/human/npc/bounty_criminal/proc/ai_start_retreat(mob/living/from)
	if(!ai_can_act() || QDELETED(ai_controller))
		return FALSE
	var/turf/here = get_turf(src)
	var/turf/danger = get_turf(from) || here
	var/turf/best
	var/best_distance = -1
	for(var/attempt in 1 to 12)
		var/turf/tile = locate(here.x + rand(-BOUNTY_NORMAL_RETREAT_DISTANCE, BOUNTY_NORMAL_RETREAT_DISTANCE), here.y + rand(-BOUNTY_NORMAL_RETREAT_DISTANCE, BOUNTY_NORMAL_RETREAT_DISTANCE), here.z)
		if(!isopenturf(tile) || isspaceturf(tile) || islava(tile) || ischasm(tile) || tile.is_blocked_turf(source_atom = src) || !leash_ok(tile))
			continue
		var/distance = get_dist(tile, danger)
		if(distance > best_distance)
			best = tile
			best_distance = distance
	ai_suspend_activity()
	ai_set_mode(BOUNTY_AI_RETREATING)
	bounty_ai_holster(src)
	ai_set_pace(BOUNTY_RUN_SPEED)
	ai_controller.clear_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET)
	if(best)
		ai_controller.set_blackboard_key(BB_BOUNTY_DESTINATION, best)
	else
		ai_controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
	ai_bark("hurt")
	return TRUE

/// Walks to where they retreat to, then sits down on the floor there and treats themselves (N6)
/datum/ai_planning_subtree/bounty_retreat

/datum/ai_planning_subtree/bounty_retreat/SelectBehaviors(datum/ai_controller/controller, seconds_per_tick)
	var/mob/living/carbon/human/npc/bounty_criminal/criminal = controller.pawn
	if(criminal.ai_mode != BOUNTY_AI_RETREATING)
		return
	var/turf/destination = controller.blackboard[BB_BOUNTY_DESTINATION]
	if(destination && criminal.loc != destination)
		controller.queue_behavior(/datum/ai_behavior/travel_towards/bounty, BB_BOUNTY_DESTINATION)
		return SUBTREE_RETURN_FINISH_PLANNING
	if(destination)
		controller.clear_blackboard_key(BB_BOUNTY_DESTINATION)
		criminal.ai_set_pace(BOUNTY_CALM_SPEED)
		criminal.ai_crouch()
		criminal.visible_message(span_notice("[criminal] sits down heavily, catching [criminal.p_their()] breath."))
	if(criminal.health < criminal.maxHealth && bounty_ai_queue_treat_self(controller))
		return SUBTREE_RETURN_FINISH_PLANNING
	controller.queue_behavior(/datum/ai_behavior/bounty_watch)
	return SUBTREE_RETURN_FINISH_PLANNING
