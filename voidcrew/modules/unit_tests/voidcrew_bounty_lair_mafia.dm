/**
 * Bounty lairs: P12 mafia mobs' tests, for voidcrew/modules/bounties/bounty_lair_mafia.dm.
 *
 * Owner: P12 mafia mobs. Do not edit this file outside that package. Fork defines are included after the
 * tests, so a test uses the literal value with a comment naming the define. The tests call the mobs' procs directly
 * with them already in place. The goons, the lieutenants and the don are real human NPCs; the don's mech is a mob of
 * its own (owner call OC-5). Only rocket_flight (a rocket really flying to its marker), fire (a real gun's burst) and
 * ring_path (the lair's grace period between the mech and the don) wait; none waits on an AI walk.
 */

/// Shared helpers; not a test itself
/datum/unit_test/voidcrew_bounty_lair_mafia
	abstract_type = /datum/unit_test/voidcrew_bounty_lair_mafia
	/// Test hunters put on SSmobs' list of players, taken off again when the test ends
	var/list/fake_clients = list()

/datum/unit_test/voidcrew_bounty_lair_mafia/Destroy()
	for(var/mob/living/person as anything in fake_clients)
		var/turf/spot = get_turf(person)
		if(spot)
			SSmobs.clients_by_zlevel[spot.z] -= person
	fake_clients = null
	clear_room()
	return ..()

/// The floor `dx`, `dy` tiles from the test room's bottom-left corner (the room is 5x5)
/datum/unit_test/voidcrew_bounty_lair_mafia/proc/spot(dx, dy)
	return locate(run_loc_floor_bottom_left.x + dx, run_loc_floor_bottom_left.y + dy, run_loc_floor_bottom_left.z)

/// A turf `distance` tiles east of the test room (west if the map ends first), on its level: out of the room and out of sight
/datum/unit_test/voidcrew_bounty_lair_mafia/proc/far_spot(distance)
	var/turf/origin = run_loc_floor_bottom_left
	var/x = origin.x + distance <= world.maxx ? origin.x + distance : origin.x - distance
	return locate(x, origin.y, origin.z)

/// A hunter at `where`: a human with a mind, as a player would be. `as_client` puts them on SSmobs' list of players.
/datum/unit_test/voidcrew_bounty_lair_mafia/proc/hunter_at(turf/where, as_client = FALSE)
	var/mob/living/carbon/human/consistent/hunter = allocate(/mob/living/carbon/human/consistent, where)
	hunter.mind_initialize()
	if(as_client)
		SSmobs.clients_by_zlevel[where.z] += hunter
		fake_clients += hunter
	return hunter

/// One of the club's people at `where`, with its AI off: the test drives it
/datum/unit_test/voidcrew_bounty_lair_mafia/proc/member_at(member_type, turf/where)
	var/mob/living/carbon/human/npc/bounty_mafia/member = allocate(member_type, where)
	member.ai_controller?.set_ai_status(AI_STATUS_OFF)
	return member

/// Clears what the club leaves behind in the test room: shots in flight, corpses, wrecks, rings
/datum/unit_test/voidcrew_bounty_lair_mafia/proc/clear_room()
	for(var/turf/spot as anything in block(run_loc_floor_bottom_left, run_loc_floor_top_right))
		for(var/obj/projectile/stray in spot)
			qdel(stray)
		for(var/obj/structure/bounty_mafia_wreck/wreck in spot)
			qdel(wreck)
		for(var/obj/item/bounty_proof/proof in spot)
			qdel(proof)
		for(var/mob/living/carbon/human/corpse in spot)
			if(corpse.stat == DEAD && !(corpse in allocated))
				qdel(corpse)
		for(var/obj/item/stray_item in spot)
			if(!(stray_item in allocated))
				qdel(stray_item)

// ===== THE ROCKET VOLLEY: MARKERS FIRST, THEN TG'S LIGHT BLAST ON WHOEVER STANDS THERE, NEVER explosion() =====

/datum/unit_test/voidcrew_bounty_lair_mafia/rockets

/datum/unit_test/voidcrew_bounty_lair_mafia/rockets/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	mech.finalize_npc_zone(allocate(/datum/npc_spawn_context, src, 3, "boss"))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 2))
	TEST_ASSERT(!ispath(mech.mech_rocket_type, /obj/projectile/bullet/rocket), "The mech fires tg's rocket, which calls explosion()")
	TEST_ASSERT(ispath(mech.mech_rocket_type, /obj/projectile/bullet/bounty_mafia_rocket), "The mech doesn't fire the club's rocket")

	// The lock-on: a marker under the hunter, the mech holding still, and nobody hurt yet
	var/serial = mech.mech_start_rockets(list(hunter))
	TEST_ASSERT(serial, "The volley didn't start")
	TEST_ASSERT_EQUAL(mech.mech_busy, "rockets", "The mech isn't locking on")
	TEST_ASSERT(HAS_TRAIT(mech, TRAIT_IMMOBILIZED), "The mech can walk during the lock-on")
	TEST_ASSERT_NOTNULL(locate(/obj/effect/temp_visual/bounty_mafia_mark) in get_turf(hunter), "No lock-on marker under the hunter")
	TEST_ASSERT_EQUAL(hunter.getBruteLoss(), 0, "The volley hurt someone before the lock-on was over")
	TEST_ASSERT(!mech.mech_start_rockets(list(hunter)), "A second volley started during the lock-on")

	// The launch: one rocket per marker, the markers gone
	var/list/rockets = mech.mech_fire_rockets(serial)
	TEST_ASSERT_EQUAL(length(rockets), 1, "Not one rocket per marker")
	TEST_ASSERT_NULL(mech.mech_busy, "The mech is still busy after the launch")
	TEST_ASSERT_NULL(locate(/obj/effect/temp_visual/bounty_mafia_mark) in get_turf(hunter), "The marker outlived the lock-on")
	var/obj/projectile/bullet/bounty_mafia_rocket/rocket = rockets[1]
	TEST_ASSERT(istype(rocket, /obj/projectile/bullet/bounty_mafia_rocket), "The launch fired something else")
	TEST_ASSERT(!istype(rocket, /obj/projectile/bullet/rocket), "The launch fired tg's rocket")
	TEST_ASSERT_EQUAL(rocket.rocket_target, get_turf(hunter), "The rocket isn't aimed at the marker")

	// The burst: tg's light blast on the hunter standing on the marker (damage, and a knockdown by their bomb armour)
	var/turf/marker_turf = get_turf(hunter)
	var/list/volley = rocket.rocket_volley
	var/list/hit = rocket.rocket_detonate(marker_turf)
	TEST_ASSERT(hunter in hit, "The rocket missed the hunter standing on the marker")
	var/first = hunter.getBruteLoss()
	TEST_ASSERT(first > 0, "The rocket's blast didn't hurt the hunter on its marker")
	TEST_ASSERT(hunter.IsKnockdown(), "The rocket's blast didn't knock the hunter down")
	TEST_ASSERT(QDELETED(rocket), "The rocket outlived its burst")
	var/obj/projectile/bullet/bounty_mafia_rocket/second = new(spot(1, 2))
	second.rocket_volley = volley
	second.rocket_detonate(marker_turf)
	TEST_ASSERT_EQUAL(hunter.getBruteLoss(), first, "A second rocket of one volley hit the same hunter")

	// The blast hits whoever stands there, whatever their state: a hunter already down takes it too (CB-10, CB-11)
	var/mob/living/carbon/human/consistent/downed = hunter_at(spot(3, 4))
	// Suffocation, not brute: brute lands on one random limb, which caps it
	downed.adjustOxyLoss(150)
	TEST_ASSERT(downed.stat != CONSCIOUS, "Test fixture: the second hunter didn't go down")
	var/downed_before = downed.getBruteLoss()
	var/obj/projectile/bullet/bounty_mafia_rocket/on_the_floor = new(spot(1, 4))
	TEST_ASSERT(downed in on_the_floor.rocket_detonate(get_turf(downed)), "A rocket's burst skipped a hunter who is down")
	TEST_ASSERT(downed.getBruteLoss() > downed_before, "A rocket's burst didn't hurt a hunter who is down")

	// A burst picks no sides: one of the club standing on a marker takes it as well
	var/mob/living/carbon/human/npc/bounty_mafia/goon = member_at(/mob/living/carbon/human/npc/bounty_mafia, spot(2, 0))
	var/obj/projectile/bullet/bounty_mafia_rocket/friendly = new(spot(1, 0))
	TEST_ASSERT(goon in friendly.rocket_detonate(get_turf(goon)), "A rocket's burst skipped one of the club")

	// A marker the hunter stepped off hurts nobody
	var/obj/projectile/bullet/bounty_mafia_rocket/empty = new(spot(1, 2))
	TEST_ASSERT(!length(empty.rocket_detonate(spot(2, 3))), "A rocket on an empty marker hit someone")

// ===== A ROCKET IN FLIGHT: THROUGH PEOPLE TO ITS MARKER, NO EXPLOSION, NOTHING BROKEN OUTSIDE THE GARAGE =====

/datum/unit_test/voidcrew_bounty_lair_mafia/rocket_flight
	var/explosions = 0
	/// Every hit the target took, as "amount type to zone (blocked%) at time", for the failure messages
	var/list/target_hits = list()

/datum/unit_test/voidcrew_bounty_lair_mafia/rocket_flight/proc/on_explosion(datum/source)
	SIGNAL_HANDLER
	explosions++

/datum/unit_test/voidcrew_bounty_lair_mafia/rocket_flight/proc/on_target_hit(mob/living/source, damage_dealt, damagetype, def_zone, blocked)
	SIGNAL_HANDLER
	var/zone = def_zone
	if(isbodypart(def_zone))
		var/obj/item/bodypart/part = def_zone
		zone = part.body_zone
	target_hits += "[damage_dealt] [damagetype] to [zone || "no zone"] ([blocked]% blocked) at [world.time]"

/// Waits up to two seconds, a tenth at a time, for `rocket` to burst. Returns the target's brute the moment it was gone
/// (null if it never was) and adds "time: brute" to `timeline` for each tenth, so a failure shows what happened when.
/datum/unit_test/voidcrew_bounty_lair_mafia/rocket_flight/proc/watch_flight(obj/projectile/rocket, mob/living/target, list/timeline)
	var/landed_brute
	var/started = world.time
	for(var/tenth in 1 to 20)
		sleep(0.1 SECONDS)
		timeline += "[(world.time - started) / 10]s [target.getBruteLoss()][QDELETED(rocket) ? "" : " (in flight)"]"
		if(isnull(landed_brute) && QDELETED(rocket))
			landed_brute = target.getBruteLoss()
	return landed_brute

/datum/unit_test/voidcrew_bounty_lair_mafia/rocket_flight/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	var/mob/living/carbon/human/consistent/bystander = hunter_at(spot(2, 2))
	var/mob/living/carbon/human/consistent/target = hunter_at(spot(4, 2))
	var/obj/structure/table/wood/table = allocate(/obj/structure/table/wood, spot(4, 3))
	var/table_health = table.get_integrity()
	RegisterSignal(SSdcs, COMSIG_GLOB_EXPLOSION, PROC_REF(on_explosion))
	RegisterSignal(target, COMSIG_MOB_AFTER_APPLY_DAMAGE, PROC_REF(on_target_hit))

	var/serial = mech.mech_start_rockets(list(target))
	TEST_ASSERT(serial, "The volley didn't start")
	var/list/rockets = mech.mech_fire_rockets(serial)
	TEST_ASSERT_EQUAL(length(rockets), 1, "Not one rocket at the one marker")
	var/list/timeline = list()
	var/landed_brute = watch_flight(rockets[1], target, timeline)
	var/seen = "Hits: [length(target_hits) ? target_hits.Join("; ") : "none"]. Brute by tenth of a second: [timeline.Join(", ")]"
	TEST_ASSERT(QDELETED(rockets[1]), "The rocket never reached its marker. [seen]")
	TEST_ASSERT(landed_brute > 0, "The rocket didn't hurt the hunter on its marker. [seen]")
	TEST_ASSERT_EQUAL(target.getBruteLoss(), landed_brute, "The hunter's brute changed after the rocket burst. [seen]")
	TEST_ASSERT_EQUAL(bystander.getBruteLoss(), 0, "The rocket hit someone it flew past on the way")
	// explosion() would have gone off, and flattened the table beside the marker
	TEST_ASSERT_EQUAL(explosions, 0, "The rocket called explosion()")
	TEST_ASSERT(!QDELETED(table) && table.get_integrity() == table_health, "The rocket's burst damaged a table beside its marker")
	TEST_ASSERT(isfloorturf(get_turf(target)), "The rocket changed the floor")

	// Outside the club's garage it breaks nothing in its way: it bursts on a window and the window stands
	qdel(bystander)
	var/obj/structure/window/fulltile/window = allocate(/obj/structure/window/fulltile, spot(2, 2))
	var/window_health = window.get_integrity()
	var/second_target_health = target.getBruteLoss()
	mech.mech_next_ability_at = 0
	mech.mech_rockets_ready_at = 0
	target.SetKnockdown(0)
	serial = mech.mech_start_rockets(list(target))
	TEST_ASSERT(serial, "The second volley didn't start")
	rockets = mech.mech_fire_rockets(serial)
	TEST_ASSERT_EQUAL(length(rockets), 1, "Not one rocket at the one marker in the second volley")
	target_hits.Cut()
	timeline.Cut()
	watch_flight(rockets[1], target, timeline)
	seen = "Hits: [length(target_hits) ? target_hits.Join("; ") : "none"]. Brute by tenth of a second: [timeline.Join(", ")]"
	TEST_ASSERT(!QDELETED(window) && window.get_integrity() == window_health, "A rocket outside the garage damaged a window")
	TEST_ASSERT_EQUAL(target.getBruteLoss(), second_target_health, "A rocket went through a window to its marker. [seen]")
	TEST_ASSERT_EQUAL(explosions, 0, "The rocket called explosion()")
	UnregisterSignal(SSdcs, COMSIG_GLOB_EXPLOSION)

// ===== EXOSUITS: SANE ROCKET DAMAGE, AND THEIR PILOTS COUNT =====

/datum/unit_test/voidcrew_bounty_lair_mafia/exosuit

/datum/unit_test/voidcrew_bounty_lair_mafia/exosuit/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	var/obj/vehicle/sealed/mecha/ripley/suit = allocate(/obj/vehicle/sealed/mecha/ripley, spot(3, 2))
	var/mob/living/carbon/human/consistent/pilot = hunter_at(spot(4, 4))
	var/before = suit.get_integrity()
	var/obj/projectile/bullet/bounty_mafia_rocket/rocket = new(spot(1, 2))
	TEST_ASSERT_EQUAL(rocket.prehit_pierce(suit), PROJECTILE_DELETE_WITHOUT_HITTING, "A rocket hit an exosuit the ordinary way (8x its damage)")
	var/lost = before - suit.get_integrity()
	TEST_ASSERT(lost > 0 && lost <= 120, "A rocket took [lost] off an exosuit, not 60-120") // BOUNTY_MECH_ROCKET_EXOSUIT_DAMAGE
	qdel(rocket)

	// The pilot is behind the suit's guns and fists: they join the posse
	LAZYSET(suit.occupants, pilot, NONE)
	mech.mech_answer_attack(suit)
	TEST_ASSERT(mech.mech_engaged[REF(pilot)], "An exosuit's pilot didn't join the posse")
	TEST_ASSERT(mech.mech_holds_grudge(pilot), "The mech holds no grudge against an exosuit's pilot")
	LAZYREMOVE(suit.occupants, pilot)

// ===== THE LMG: A RED CONE FIRST, REAL ROUNDS THAT HIT WHOEVER IS IN THE WAY =====

/datum/unit_test/voidcrew_bounty_lair_mafia/lmg

/datum/unit_test/voidcrew_bounty_lair_mafia/lmg/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 2))

	var/serial = mech.mech_start_lmg(hunter)
	TEST_ASSERT(serial, "The machine gun didn't spin up")
	TEST_ASSERT_EQUAL(mech.mech_busy, "lmg_windup", "The machine gun didn't wind up first")
	TEST_ASSERT(HAS_TRAIT(mech, TRAIT_IMMOBILIZED), "The mech can walk during the spin-up")
	var/marked = 0
	for(var/dx in 1 to 4)
		if(locate(/obj/effect/temp_visual/bounty_mafia_mark) in spot(dx, 2))
			marked++
	TEST_ASSERT(marked >= 3, "The red cone doesn't cover the line to the hunter ([marked] of 4 tiles)")
	TEST_ASSERT_EQUAL(hunter.getBruteLoss(), 0, "The machine gun hurt someone during its spin-up")

	TEST_ASSERT(mech.mech_lmg_range >= get_dist(mech, hunter), "The cone stops short of its target")

	var/fire_serial = mech.mech_fire_lmg(serial)
	TEST_ASSERT(fire_serial, "The burst didn't start when the spin-up ended")
	TEST_ASSERT_EQUAL(mech.mech_busy, "lmg_fire", "The mech isn't firing")
	TEST_ASSERT(length(mech.mech_telegraphs), "The cone went before the burst was over")
	TEST_ASSERT(locate(/obj/effect/temp_visual/bounty_mafia_mark) in spot(3, 2), "The cone isn't on the floor during the burst")
	TEST_ASSERT(!mech.mech_start_rockets(list(hunter)), "A volley started during the burst")
	var/obj/projectile/round = mech.mech_lmg_round(fire_serial)
	TEST_ASSERT(round && round.range <= mech.mech_lmg_range + 1, "A machine gun round flies past its cone")
	TEST_ASSERT(round && !length(round.ignored_factions), "The machine gun's rounds pass through the club's own people")

	// Cut short: nothing more fires, and the cone goes
	mech.mech_interrupt()
	TEST_ASSERT_NULL(mech.mech_busy, "The mech is still busy after being cut short")
	TEST_ASSERT_NULL(mech.mech_telegraphs, "The cone outlived the burst it marked")
	TEST_ASSERT_NULL(mech.mech_lmg_round(fire_serial), "A round fired after the burst was cut short")
	clear_room()

	// It never picks someone who is down to aim at
	mech.mech_next_ability_at = 0
	// Suffocation, not brute: brute lands on one random limb, which caps it
	hunter.adjustOxyLoss(150)
	TEST_ASSERT(hunter.stat != CONSCIOUS, "The hunter didn't go down")
	TEST_ASSERT(!mech.mech_start_lmg(hunter), "The machine gun spun up on a downed hunter")
	TEST_ASSERT(!mech.mech_start_rockets(list(hunter)), "The volley locked on to a downed hunter")

// ===== THE STOMP THROWS YOU BACK =====

/datum/unit_test/voidcrew_bounty_lair_mafia/stomp

/datum/unit_test/voidcrew_bounty_lair_mafia/stomp/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(1, 2))
	var/distance_before = get_dist(mech, hunter)
	mech.next_move = 0
	TEST_ASSERT(mech.mech_stomp(hunter), "The stomp didn't land on a hunter beside the mech")
	TEST_ASSERT(hunter.getBruteLoss() > 0, "The stomp didn't hurt")
	TEST_ASSERT(hunter.throwing || get_dist(mech, hunter) > distance_before, "The stomp didn't throw the hunter back")
	// BOUNTY_MECH_STOMP_THROW 3 tiles, straight away from the mech
	TEST_ASSERT(!hunter.throwing || hunter.throwing.maxrange == 3, "The stomp throws [hunter.throwing?.maxrange] tiles, not 3")
	if(hunter.throwing)
		hunter.throwing.finalize()
	clear_room()

// ===== THE CLUB'S PEOPLE: REAL BODIES, REAL CLOTHES, REAL GUNS =====

/datum/unit_test/voidcrew_bounty_lair_mafia/kit

/datum/unit_test/voidcrew_bounty_lair_mafia/kit/Run()
	// type -> list(the gun in hand, its magazine, spares carried)
	var/list/gunmen = list(
		/mob/living/carbon/human/npc/bounty_mafia/pistol = list(/obj/item/gun/ballistic/automatic/pistol/aps, /obj/item/ammo_box/magazine/m9mm_aps, 2),
		/mob/living/carbon/human/npc/bounty_mafia/smg = list(/obj/item/gun/ballistic/automatic/mini_uzi, /obj/item/ammo_box/magazine/uzim9mm, 2),
		/mob/living/carbon/human/npc/bounty_mafia/lieutenant/tommy = list(/obj/item/gun/ballistic/automatic/tommygun, /obj/item/ammo_box/magazine/tommygunm45, 2),
		/mob/living/carbon/human/npc/bounty_mafia/don = list(/obj/item/gun/ballistic/automatic/pistol/deagle/gold, /obj/item/ammo_box/magazine/m50, 2),
	)
	var/dx = 0
	for(var/member_type in gunmen)
		var/list/kit = gunmen[member_type]
		var/mob/living/carbon/human/npc/bounty_mafia/member = member_at(member_type, spot(dx++, 4))
		var/obj/item/gun/ballistic/gun = locate(kit[1]) in member.held_items
		TEST_ASSERT_NOTNULL(gun, "[member_type] doesn't hold a [kit[1]]")
		TEST_ASSERT(gun?.can_shoot(), "[member_type]'s gun isn't loaded")
		TEST_ASSERT(HAS_TRAIT(gun, "human_npc_gear"), "[member_type]'s gun isn't locked to them, so it would be loot") // TRAIT_HUMAN_NPC_GEAR
		var/spares = 0
		for(var/obj/item/ammo_box/magazine/magazine in member.get_all_contents())
			if(istype(magazine, kit[2]) && magazine != gun?.magazine)
				spares++
		TEST_ASSERT_EQUAL(spares, kit[3], "[member_type] carries [spares] spare magazines, not [kit[3]]")
		TEST_ASSERT_NOTNULL(member.w_uniform, "[member_type] isn't dressed")
		TEST_ASSERT_EQUAL(member.gender, MALE, "[member_type] isn't one of the club's men")
		TEST_ASSERT("bounty_mafia" in member.faction, "[member_type] isn't of the club") // BOUNTY_MAFIA_FACTION
		TEST_ASSERT_EQUAL(member.maxHealth, 100, "[member_type]'s health isn't a person's") // MAX_LIVING_HEALTH
		TEST_ASSERT_NULL(member.npc_surrender, "[member_type] can give up")
		TEST_ASSERT_EQUAL(member.npc_target_stat, CONSCIOUS, "[member_type] would go after a hunter who is down") // HUMAN_NPC_SPARES_DOWNED

	// The knife man holds a kitchen knife; Brute holds nothing and fights with his fists, in a bulletproof vest
	var/mob/living/carbon/human/npc/bounty_mafia/knife_man = member_at(/mob/living/carbon/human/npc/bounty_mafia, spot(0, 2))
	TEST_ASSERT_NOTNULL(locate(/obj/item/knife/kitchen) in knife_man.held_items, "The knife man has no kitchen knife")
	var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/brute/brute = member_at(/mob/living/carbon/human/npc/bounty_mafia/lieutenant/brute, spot(1, 2))
	TEST_ASSERT(!length(brute.get_all_contents_type(/obj/item/gun)), "Brute carries a gun")
	TEST_ASSERT(istype(brute.wear_suit, /obj/item/clothing/suit/armor/vest/russian), "Brute has no armour on")

	// Ranks and toughness: through their bodies and what they wear, never their health
	var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/tommy/tommy = member_at(/mob/living/carbon/human/npc/bounty_mafia/lieutenant/tommy, spot(2, 2))
	TEST_ASSERT(istype(tommy.wear_suit, /obj/item/clothing/suit/toggle/jacket/det_trench/noir), "Tommy's long coat isn't his armoured one")
	for(var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/lieutenant as anything in list(tommy, brute))
		TEST_ASSERT_EQUAL(lieutenant.npc_rank, 1, "[lieutenant] isn't an elite") // HUMAN_NPC_RANK_ELITE
		TEST_ASSERT(abs(lieutenant.physiology.brute_mod - 0.8) < 0.01, "[lieutenant] takes [lieutenant.physiology.brute_mod] of brute, not 0.8") // BOUNTY_LIEUTENANT_DAMAGE_TAKEN
		TEST_ASSERT(abs(lieutenant.physiology.burn_mod - 0.8) < 0.01, "[lieutenant] takes [lieutenant.physiology.burn_mod] of burn, not 0.8")
		TEST_ASSERT_EQUAL(lieutenant.maxHealth, 100, "[lieutenant]'s health isn't a person's") // MAX_LIVING_HEALTH
	var/mob/living/carbon/human/npc/bounty_mafia/don/don = member_at(/mob/living/carbon/human/npc/bounty_mafia/don, spot(3, 2))
	TEST_ASSERT_EQUAL(don.npc_rank, 2, "The don isn't a boss") // HUMAN_NPC_RANK_BOSS
	TEST_ASSERT(abs(don.physiology.brute_mod - 0.6) < 0.01, "The don takes [don.physiology.brute_mod] of brute, not 0.6") // BOUNTY_DON_DAMAGE_TAKEN
	TEST_ASSERT_EQUAL(knife_man.npc_rank, 0, "A goon is an elite") // HUMAN_NPC_RANK_REGULAR
	// Nobody in the club executes anyone (OC-9: no deliberate executions are built yet)
	for(var/mob/living/carbon/human/npc/bounty_mafia/member as anything in list(knife_man, brute, tommy, don))
		TEST_ASSERT(!member.hv_can_execute(), "[member] can execute")

// ===== FIRING THE REAL GUN: PULLS, THE AIM, THE FLINCH, THE RELOAD =====

/datum/unit_test/voidcrew_bounty_lair_mafia/fire

/datum/unit_test/voidcrew_bounty_lair_mafia/fire/Run()
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 0))
	var/mob/living/carbon/human/npc/bounty_mafia/pistol/gunman = member_at(/mob/living/carbon/human/npc/bounty_mafia/pistol, spot(0, 0))
	var/datum/ai_controller/controller = gunman.ai_controller
	var/obj/item/gun/ballistic/gun = locate(/obj/item/gun/ballistic/automatic/pistol/aps) in gunman.held_items
	TEST_ASSERT_NOTNULL(gun, "Test fixture: the gunman holds no Stechkin")
	gun.can_misfire = FALSE
	controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	var/datum/ai_behavior/bounty_mafia_fire/fire = GET_AI_BEHAVIOR(/datum/ai_behavior/bounty_mafia_fire)

	// A pistol volley: no aim, a string of single pulls of the real gun (voidcrew_bounty_guns_club counts them), then a pause before the next
	var/rounds_before = gun.get_ammo()
	TEST_ASSERT(fire.setup(controller, BB_BASIC_MOB_CURRENT_TARGET), "The gunman's volley didn't start")
	TEST_ASSERT(!gunman.mafia_aim_until, "The pistol aims before it fires")
	var/flags = NONE
	for(var/pull in 1 to 6) // BOUNTY_MOBSTER_PISTOL_VOLLEY
		gunman.mafia_next_pull_at = 0
		flags = fire.perform(0.1, controller, BB_BASIC_MOB_CURRENT_TARGET)
	TEST_ASSERT(flags & AI_BEHAVIOR_SUCCEEDED, "The pistol volley wasn't a string of six pulls")
	fire.finish_action(controller, TRUE, BB_BASIC_MOB_CURRENT_TARGET)
	TEST_ASSERT(gunman.mafia_next_volley_at >= world.time + 20, "The gunman has no pause between volleys") // BOUNTY_MOBSTER_PISTOL_STRING_PAUSE
	TEST_ASSERT(!fire.setup(controller, BB_BASIC_MOB_CURRENT_TARGET), "The gunman started a volley before his pause was over")
	sleep(0.5 SECONDS)
	TEST_ASSERT(gun.get_ammo() < rounds_before, "The pull didn't fire the gunman's Stechkin")
	clear_room()

	// The Uzi spins up first ("aiming!"), and a hit then spoils the aim: nothing fires, and the next try waits
	var/mob/living/carbon/human/npc/bounty_mafia/smg/enforcer = member_at(/mob/living/carbon/human/npc/bounty_mafia/smg, spot(0, 2))
	var/datum/ai_controller/enforcer_ai = enforcer.ai_controller
	var/obj/item/gun/ballistic/uzi = locate(/obj/item/gun/ballistic/automatic/mini_uzi) in enforcer.held_items
	enforcer_ai.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	var/uzi_rounds = uzi.get_ammo()
	TEST_ASSERT(fire.setup(enforcer_ai, BB_BASIC_MOB_CURRENT_TARGET), "The enforcer's volley didn't start")
	TEST_ASSERT(enforcer.mafia_aim_until > world.time, "The Uzi didn't spin up first")
	TEST_ASSERT(fire.perform(0.1, enforcer_ai, BB_BASIC_MOB_CURRENT_TARGET) & AI_BEHAVIOR_DELAY, "The enforcer didn't wait out his aim")
	TEST_ASSERT_EQUAL(uzi.get_ammo(), uzi_rounds, "The Uzi fired during its spin-up")
	enforcer.apply_damage(5, BRUTE, BODY_ZONE_CHEST)
	TEST_ASSERT(enforcer.mafia_aim_spoiled, "A hit during the spin-up didn't spoil the aim")
	TEST_ASSERT(fire.perform(0.1, enforcer_ai, BB_BASIC_MOB_CURRENT_TARGET) & AI_BEHAVIOR_FAILED, "A spoiled aim still fired")
	fire.finish_action(enforcer_ai, FALSE, BB_BASIC_MOB_CURRENT_TARGET)
	TEST_ASSERT(enforcer.mafia_next_volley_at >= world.time + 9, "A spoiled aim didn't cost the enforcer a second") // BOUNTY_MOBSTER_FUMBLE
	TEST_ASSERT_EQUAL(uzi.get_ammo(), uzi_rounds, "The Uzi fired after its aim was spoiled")

	// Dry: the next move is the player's reload from his pockets, with the club's sound and maybe a line
	var/obj/item/ammo_box/magazine/spent = gun.magazine
	spent.stored_ammo.Cut()
	QDEL_NULL(gun.chambered)
	TEST_ASSERT(!gun.can_shoot(), "Test fixture: the Stechkin still fires")
	gunman.mafia_next_volley_at = 0
	TEST_ASSERT(gunman.mafia_plan_attack(controller, hunter), "A dry gunman had nothing to do")
	TEST_ASSERT(controller.current_behaviors[GET_AI_BEHAVIOR(/datum/ai_behavior/human_npc_reload/bounty_mafia)], "A dry gunman didn't reload")
	controller.CancelActions()

// ===== POSSE HEALTH =====

/datum/unit_test/voidcrew_bounty_lair_mafia/posse

/datum/unit_test/voidcrew_bounty_lair_mafia/posse/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(2, 2))
	mech.finalize_npc_zone(allocate(/datum/npc_spawn_context, src, 3, "boss"))
	TEST_ASSERT(!ispath(mech.type, /mob/living/basic/boss), "The mech is a megafauna boss")
	TEST_ASSERT_EQUAL(mech.npc_zone_role, "boss", "The mech must use the boss zone profile")
	TEST_ASSERT(abs(mech.npc_zone_health_factor - 1.3) < 0.001, "The mech must retain the red boss health factor")
	TEST_ASSERT(abs(mech.maxHealth - 455) < 0.001, "The mech doesn't start at its one-hunter health") // BOUNTY_MECH_HEALTH_1 * 1.3
	TEST_ASSERT_EQUAL(mech.damage_coeff[BRUTE], 0.6, "The mech's brute armour is wrong") // BOUNTY_MECH_BRUTE_MOD
	TEST_ASSERT_EQUAL(mech.damage_coeff[BURN], 0.8, "The mech's burn armour is wrong") // BOUNTY_MECH_BURN_MOD
	TEST_ASSERT_EQUAL(mech.damage_coeff[STAMINA], 0, "The mech takes stamina damage")
	TEST_ASSERT(HAS_TRAIT(mech, "no_containment"), "The mech can be bagged") // TRAIT_NO_CONTAINMENT

	var/list/hunters = list()
	for(var/i in 1 to 5)
		hunters += hunter_at(spot(i - 1, 0))
	TEST_ASSERT(mech.mech_engage(hunters[1]), "The first hunter didn't join the posse")
	TEST_ASSERT(abs(mech.maxHealth - 455) < 0.001, "One hunter changed the mech's health")
	mech.adjust_health(100)
	TEST_ASSERT(abs(mech.health - 355) < 0.001, "The mech didn't take the damage")
	TEST_ASSERT(mech.mech_engage(hunters[2]), "The second hunter didn't join the posse")
	TEST_ASSERT(abs(mech.maxHealth - 910) < 0.001, "Two hunters lost the selected zone factor") // BOUNTY_MECH_HEALTH_2 * 1.3
	TEST_ASSERT(abs(mech.health - 810) < 0.001, "The mech's damage didn't carry over when its health rose")
	TEST_ASSERT(!mech.mech_engage(hunters[2]), "The same hunter joined twice")
	mech.mech_engage(hunters[3])
	TEST_ASSERT(abs(mech.maxHealth - 1365) < 0.001, "Three hunters lost the selected zone factor") // BOUNTY_MECH_HEALTH_3 * 1.3
	mech.mech_engage(hunters[4])
	TEST_ASSERT(abs(mech.maxHealth - 1820) < 0.001, "Four hunters lost the selected zone factor") // BOUNTY_MECH_HEALTH_4 * 1.3
	mech.mech_engage(hunters[5])
	TEST_ASSERT(abs(mech.maxHealth - 1820) < 0.001, "A fifth hunter raised the mech past its 4+ health")

// ===== THE EMP STALL =====

/datum/unit_test/voidcrew_bounty_lair_mafia/emp

/datum/unit_test/voidcrew_bounty_lair_mafia/emp/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(0, 2))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 2))
	var/serial = mech.mech_start_rockets(list(hunter))
	TEST_ASSERT(serial, "The volley didn't start")

	mech.emp_act(EMP_HEAVY)
	TEST_ASSERT(mech.stat != DEAD, "A heavy EMP killed the mech")
	TEST_ASSERT_EQUAL(mech.mech_busy, "stall", "The EMP didn't stall the mech")
	TEST_ASSERT(abs(mech.health - 332.5) < 0.5, "The EMP didn't take 5% of the mech's health ([mech.health])") // BOUNTY_MECH_EMP_DAMAGE_PERCENT
	TEST_ASSERT_NULL(mech.mech_telegraphs, "The lock-on markers outlived the stall")
	TEST_ASSERT(!length(mech.mech_fire_rockets(serial)), "The stalled volley still fired")
	// The volley it lost is ready again as the stall ends: an EMP is a pause, not a free cancel
	TEST_ASSERT(mech.mech_rockets_ready_at <= world.time + 20, "The EMP cost the mech its volley's cooldown") // BOUNTY_MECH_EMP_STALL
	TEST_ASSERT(mech.mech_next_ability_at <= world.time + 20, "The EMP pushed the mech's next ability past the stall")

	// A second EMP straight after does nothing
	mech.emp_act(EMP_HEAVY)
	TEST_ASSERT(abs(mech.health - 332.5) < 0.5, "A second EMP straight after the stall hurt the mech ([mech.health])")

	// A harmless ion bolt still counts as an attack by whoever fired it
	var/mob/living/carbon/human/consistent/ion_shooter = hunter_at(spot(4, 0))
	var/obj/projectile/ion/bolt = allocate(/obj/projectile/ion, spot(1, 2))
	bolt.firer = ion_shooter
	SEND_SIGNAL(mech, COMSIG_ATOM_BULLET_ACT, bolt, BODY_ZONE_CHEST, FALSE, 0)
	TEST_ASSERT(mech.mech_engaged[REF(ion_shooter)], "An ion shooter didn't join the posse")
	TEST_ASSERT(mech.mech_holds_grudge(ion_shooter), "The mech holds no grudge against an ion shooter")

// ===== THE RESET: A MACHINE'S REPAIR ARMS =====

/datum/unit_test/voidcrew_bounty_lair_mafia/reset

/datum/unit_test/voidcrew_bounty_lair_mafia/reset/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(2, 2))
	TEST_ASSERT(!mech.mech_check_reset(), "A fresh mech reset")
	mech.mech_engage(hunter_at(spot(0, 0)))
	mech.mech_engage(hunter_at(spot(1, 0)))
	mech.mech_hostile = TRUE
	mech.adjust_health(200)
	TEST_ASSERT_EQUAL(mech.health, 500, "The mech's setup is wrong")

	mech.mech_last_hunter_at = world.time
	TEST_ASSERT(!mech.mech_check_reset(), "The mech reset with a hunter just seen")
	mech.mech_last_hunter_at = world.time - 610 // BOUNTY_MECH_RESET_AFTER, and a second
	TEST_ASSERT(mech.mech_check_reset(), "The mech didn't reset after 60 seconds with nobody about")
	TEST_ASSERT_EQUAL(mech.maxHealth, 350, "The reset didn't go back to the one-hunter health")
	TEST_ASSERT_EQUAL(mech.health, 350, "The reset didn't heal the mech to full")
	TEST_ASSERT(!length(mech.mech_engaged), "The reset kept the posse")
	TEST_ASSERT(!mech.mech_hostile, "The reset kept the mech hostile")

// ===== A SNIPER PAST ITS SIGHT: THE MECH AND THE DON STILL ANSWER =====

/datum/unit_test/voidcrew_bounty_lair_mafia/sniper

/datum/unit_test/voidcrew_bounty_lair_mafia/sniper/Run()
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(2, 2))
	var/mob/living/carbon/human/consistent/sniper = hunter_at(far_spot(24))
	TEST_ASSERT(get_dist(mech, sniper) > 20, "The sniper isn't past the mech's sight") // BOUNTY_MECH_SIGHT
	TEST_ASSERT(!mech.mech_target_ok(sniper), "The mech may go after someone past its sight who never hurt it")

	// A shot from out there: the mech takes the shooter on, holds a grudge, and its reset clock starts over
	mech.mech_last_hunter_at = 0
	mech.mech_on_attacked(null, sniper, 4) // ATTACKER_DAMAGING_ATTACK
	TEST_ASSERT(mech.mech_holds_grudge(sniper), "The mech holds no grudge against a sniper")
	TEST_ASSERT(mech.mech_target_ok(sniper), "A sniper who hurt the mech isn't fair game")
	TEST_ASSERT_EQUAL(mech.mech_find_target(), sniper, "The mech didn't take on a sniper out of its sight")
	TEST_ASSERT(mech.mech_engaged[REF(sniper)], "The sniper didn't join the posse")
	TEST_ASSERT(mech.mech_last_hunter_at >= world.time, "Sniping didn't hold off the mech's reset")
	// Out of its sight it closes in rather than firing blind
	mech.mech_next_ability_at = 0
	mech.mech_rockets_ready_at = 0
	mech.mech_lmg_ready_at = 0
	TEST_ASSERT(!mech.mech_ability_ready(sniper), "The mech would fire at a sniper it can't see")

	// The don out of the wreck keeps the mech's grudges, and takes on a sniper of his own
	var/mob/living/carbon/human/npc/bounty_mafia/don/don = mech.mech_eject()
	TEST_ASSERT_NOTNULL(don, "The don didn't climb out")
	allocated += don
	don.ai_controller?.set_ai_status(AI_STATUS_OFF)
	TEST_ASSERT(don.mafia_target_ok(sniper), "The don forgot who broke his mech")
	var/mob/living/carbon/human/consistent/second_sniper = hunter_at(far_spot(22))
	TEST_ASSERT(!don.mafia_target_ok(second_sniper), "The don may go after someone past his sight who never hurt him")
	SEND_SIGNAL(don, COMSIG_ATOM_WAS_ATTACKED, second_sniper, 4) // ATTACKER_DAMAGING_ATTACK
	TEST_ASSERT(don.mafia_target_ok(second_sniper), "The don doesn't answer a sniper who hurt him")
	clear_room()

// ===== PHASE TWO: THE WRECK, THE DON, HIS CUFFS AND THE RING =====

/datum/unit_test/voidcrew_bounty_lair_mafia/phase_two
	var/list/ejected = list()

/datum/unit_test/voidcrew_bounty_lair_mafia/phase_two/proc/on_ejected(datum/source, mob/living/don)
	SIGNAL_HANDLER
	ejected += don

/datum/unit_test/voidcrew_bounty_lair_mafia/phase_two/Destroy()
	ejected = null
	return ..()

/datum/unit_test/voidcrew_bounty_lair_mafia/phase_two/Run()
	var/datum/criminal_bounty/posting = new
	allocated += posting
	posting.status = "closed" // BOUNTY_POSTING_CLOSED: a bare test posting, with nothing to close when it goes
	posting.record = new /datum/bounty_record
	posting.record.name = "Viktor Sokolov"
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = allocate(/mob/living/basic/bounty_lair_boss/mafia_mech, spot(2, 2))
	mech.finalize_npc_zone(allocate(/datum/npc_spawn_context, src, 3, "boss"))
	mech.posting_ref = WEAKREF(posting)
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(0, 2))
	var/turf/where = get_turf(mech)
	RegisterSignal(mech, "bounty_mafia_don_ejected", PROC_REF(on_ejected)) // COMSIG_BOUNTY_MAFIA_DON_EJECTED

	mech.death()
	TEST_ASSERT(QDELETED(mech), "The mech outlived its death")
	var/obj/structure/bounty_mafia_wreck/wreck = locate() in where
	TEST_ASSERT_NOTNULL(wreck, "The mech left no wreck")
	TEST_ASSERT(!istype(wreck, /obj/structure/mecha_wreckage), "The wreck can be salvaged")
	TEST_ASSERT(wreck.density, "The wreck is no cover")
	var/mob/living/carbon/human/npc/bounty_mafia/don/don = locate() in range(1, where)
	TEST_ASSERT_NOTNULL(don, "The don didn't climb out")
	allocated += don
	don.ai_controller?.set_ai_status(AI_STATUS_OFF)
	TEST_ASSERT(don in ejected, "The mech didn't announce the don")
	TEST_ASSERT_EQUAL(don.posting_ref?.resolve(), posting, "The don didn't keep the mech's posting")
	TEST_ASSERT_EQUAL(don.real_name, "Viktor Sokolov", "The don isn't named for his posting")
	TEST_ASSERT(don.don_dazed_until > world.time, "The don isn't getting his bearings as he climbs out")
	TEST_ASSERT_EQUAL(don.don_wreck_ref?.resolve(), wreck, "The don doesn't know his wreck")
	TEST_ASSERT_NOTNULL(locate(/obj/item/gun/ballistic/automatic/pistol/deagle/gold) in don.held_items, "The don climbed out without his gold pistol")
	TEST_ASSERT(get_area(don) == get_area(wreck), "The don climbed out of his arena")

	// He never gives up, and the cuffs aren't refused: the cuffer is his target, and while he can move he steps away
	TEST_ASSERT_NULL(don.npc_surrender, "The don can give up")
	TEST_ASSERT(!(SEND_SIGNAL(don, COMSIG_CARBON_CUFF_ATTEMPTED, hunter) & COMSIG_CARBON_CUFF_PREVENT), "The don refused the cuffs outright")
	TEST_ASSERT_EQUAL(don.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET], hunter, "The don didn't turn on the hunter cuffing him")
	TEST_ASSERT(hunter.weak_reference && (hunter.weak_reference in don.don_grudge), "The don holds no grudge against the hunter cuffing him")
	hunter.forceMove(get_step(get_turf(don), get_dir(don, wreck) || EAST))
	var/turf/before_step = get_turf(don)
	if(don.Adjacent(hunter) && don.mafia_dodge_cuffs(WEAKREF(hunter)))
		TEST_ASSERT(get_turf(don) != before_step, "The don stepped away from the cuffs without moving")
	// Paralysed (or down), he can't, and the cuffs go on
	don.Paralyze(10 SECONDS)
	TEST_ASSERT(!don.mafia_can_answer_cuffs(), "A paralysed don can still answer the cuffs")
	var/obj/item/restraints/handcuffs/cuffs = allocate(/obj/item/restraints/handcuffs)
	TEST_ASSERT(don.equip_to_slot_if_possible(cuffs, ITEM_SLOT_HANDCUFFED), "The don can't be cuffed")
	TEST_ASSERT(HAS_TRAIT(don, TRAIT_RESTRAINED), "The cuffed don isn't restrained")
	don.SetParalyzed(0)

	// His death: he dies in place, in his clothes, and the ring drops, with the posting and its record on it
	var/turf/don_spot = get_turf(don)
	don.death()
	TEST_ASSERT(!QDELETED(don), "The don's body went with his death")
	TEST_ASSERT_NOTNULL(don.w_uniform, "The don's body isn't dressed")
	var/obj/item/bounty_proof/trophy/mafia_don/ring = locate() in don_spot
	TEST_ASSERT_NOTNULL(ring, "The don dropped no ring")
	TEST_ASSERT_EQUAL(ring.posting_ref?.resolve(), posting, "The ring doesn't carry the posting")
	TEST_ASSERT_EQUAL(ring.record, posting.record, "The ring doesn't carry the record")
	TEST_ASSERT_EQUAL(ring.icon_state, "signet_ring", "The ring doesn't look like a ring")
	for(var/obj/item/gun/gun in don_spot)
		TEST_FAIL("The don's death dropped [gun]")

	// Brought back and killed again, he drops no second ring
	don.revive(HEAL_ALL)
	TEST_ASSERT(don.stat != DEAD, "Test fixture: the don couldn't be revived")
	don.death()
	var/rings = 0
	for(var/obj/item/bounty_proof/trophy/mafia_don/dropped in range(2, don_spot))
		rings++
	TEST_ASSERT_EQUAL(rings, 1, "The don dropped [rings] rings over two deaths, not one")

	// Wanted on nothing (an admin spawn), he goes by the name on Club Volga's card
	var/mob/living/carbon/human/npc/bounty_mafia/don/stray = member_at(/mob/living/carbon/human/npc/bounty_mafia/don, spot(4, 4))
	TEST_ASSERT_EQUAL(stray.real_name, "Arkady Sokolov", "A don with no posting has no name") // BOUNTY_DON_NAME

// ===== LIEUTENANTS =====

/datum/unit_test/voidcrew_bounty_lair_mafia/lieutenants
	var/deaths = 0

/datum/unit_test/voidcrew_bounty_lair_mafia/lieutenants/proc/on_death(datum/source)
	SIGNAL_HANDLER
	deaths++

/datum/unit_test/voidcrew_bounty_lair_mafia/lieutenants/Run()
	// Two plain gatekeepers in one room: one of each
	var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/first = member_at(/mob/living/carbon/human/npc/bounty_mafia/lieutenant, spot(1, 1))
	var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/second = member_at(/mob/living/carbon/human/npc/bounty_mafia/lieutenant, spot(3, 1))
	TEST_ASSERT_EQUAL(first.mafia_lieutenant_role, "tommy", "The first lieutenant isn't Tommy") // BOUNTY_LIEUTENANT_TOMMY
	TEST_ASSERT_EQUAL(second.mafia_lieutenant_role, "brute", "The second lieutenant isn't Brute") // BOUNTY_LIEUTENANT_BRUTE
	TEST_ASSERT_EQUAL(first.real_name, "Tommy", "Tommy isn't called Tommy")
	TEST_ASSERT_EQUAL(second.real_name, "Brute", "Brute isn't called Brute")
	TEST_ASSERT_NOTNULL(locate(/obj/item/gun/ballistic/automatic/tommygun) in first.held_items, "Tommy has no Thompson")
	TEST_ASSERT(first.mafia_windup > 0, "Tommy's gun doesn't come up before it fires")
	TEST_ASSERT(!second.get_active_held_item() && !second.get_inactive_held_item(), "Brute holds something")

	// Brute's landed punch now and then knocks the hunter off their feet: tg's Knockdown, and only his own punches
	var/mob/living/carbon/human/consistent/victim = hunter_at(spot(4, 1))
	second.mafia_punch_knockdown_chance = 100
	var/mob/living/carbon/human/consistent/bystander = hunter_at(spot(4, 3))
	second.mafia_on_punch_landed(victim, bystander, 5, BRUTE, null, 0, FALSE, NONE)
	TEST_ASSERT(!victim.IsKnockdown(), "Someone else's punch knocked the hunter down for Brute")
	second.mafia_on_punch_landed(victim, second, 5, BRUTE, null, 0, FALSE, NONE)
	TEST_ASSERT(victim.IsKnockdown(), "Brute's landed punch didn't knock the hunter down")
	TEST_ASSERT(victim.AmountKnockdown() <= 10, "Brute's knockdown lasts more than a second") // BOUNTY_LIEUTENANT_BRUTE_KNOCKDOWN
	TEST_ASSERT_EQUAL(second.mafia_melee_behavior(), /datum/ai_behavior/basic_melee_attack/human_npc/bounty_mafia_brute, "Brute's fists don't listen for a landed punch")

	// Their deaths send the ordinary death signal (P10 opens the gate on it), and their bodies stay where they fell
	for(var/mob/living/carbon/human/npc/bounty_mafia/lieutenant/lieutenant as anything in list(first, second))
		RegisterSignal(lieutenant, COMSIG_LIVING_DEATH, PROC_REF(on_death))
	first.death()
	second.death()
	TEST_ASSERT_EQUAL(deaths, 2, "A lieutenant's death didn't send COMSIG_LIVING_DEATH")
	TEST_ASSERT(!QDELETED(first) && !QDELETED(second), "A lieutenant's body went with his death")
	for(var/obj/item/gun/gun in spot(1, 1))
		TEST_FAIL("Tommy's death dropped [gun]")

// ===== THE ROOM SPAWNER: A ROOM'S PEOPLE ARE QUEUED =====

/datum/unit_test/voidcrew_bounty_lair_mafia/zone_mobs

/datum/unit_test/voidcrew_bounty_lair_mafia/zone_mobs/Run()
	var/obj/effect/zone_mobs/mafia/probe = new()
	allocated += probe
	for(var/list/table in list(probe.mobs_green, probe.mobs_yellow, probe.mobs_red))
		TEST_ASSERT(length(table), "A mafia zone table is empty")
		for(var/entry in table)
			TEST_ASSERT(ispath(entry, /mob/living/carbon/human/npc/bounty_mafia), "[entry] isn't one of the club's people")
			TEST_ASSERT(!ispath(entry, /mob/living/carbon/human/npc/bounty_mafia/lieutenant), "[entry] is a lieutenant, which only the gate has")
			TEST_ASSERT(!ispath(entry, /mob/living/carbon/human/npc/bounty_mafia/don), "[entry] is the don")
	for(var/list/count_range in list(probe.count_green, probe.count_yellow, probe.count_red))
		TEST_ASSERT(count_range[1] == 1 && count_range[2] == 2, "A mafia marker spawns outside 1-2 goons")

	// P11's rooms get their own crews
	var/list/casino = bounty_mafia_room_crew("/area/ruin/space/has_grav/powered/mafia_club/casino")
	TEST_ASSERT_NOTNULL(casino, "The casino has no crew")
	TEST_ASSERT_EQUAL(casino[/mob/living/carbon/human/npc/bounty_mafia/pistol], 2, "The casino's pistols are wrong")
	TEST_ASSERT_EQUAL(casino[/mob/living/carbon/human/npc/bounty_mafia], 2, "The casino's knives are wrong")
	TEST_ASSERT_EQUAL(casino[/mob/living/carbon/human/npc/bounty_mafia/smg], 1, "The casino's SMGs are wrong")
	var/list/office = bounty_mafia_room_crew("/area/ruin/space/has_grav/powered/mafia_club/back_office")
	TEST_ASSERT_EQUAL(length(office), 1, "The back office's crew is wrong")
	TEST_ASSERT_NULL(bounty_mafia_room_crew("/area/ruin/space/has_grav/powered/mafia_club/garage"), "The arena gets goons")
	TEST_ASSERT_NULL(bounty_mafia_room_crew(/area/misc/testroom), "A room outside the club gets a club crew")

	// Anywhere else, the zone table: 1-2 goons, queued (never built in the marker's tick), then on its own floor
	probe.forceMove(spot(2, 2))
	var/area/room = get_area(probe)
	var/list/orders = probe.do_spawn(2) // ZONE_YELLOW
	TEST_ASSERT(length(orders) >= 1 && length(orders) <= 2, "The marker queued [length(orders)] goons, not 1-2")
	for(var/datum/human_npc_order/order as anything in orders)
		TEST_ASSERT(!order.done && isnull(order.spawned_ref), "The marker built a goon at once instead of queueing it")
		TEST_ASSERT(order in SShuman_npcs.queue, "A goon's order isn't in the queue")
	for(var/mob/living/carbon/human/npc/bounty_mafia/early in range(4, probe))
		TEST_FAIL("[early] was built in the marker's own tick")
	for(var/datum/human_npc_order/order as anything in orders)
		var/mob/living/carbon/human/npc/bounty_mafia/goon = order.fulfil()
		TEST_ASSERT(istype(goon, /mob/living/carbon/human/npc/bounty_mafia), "A queued goon built [goon || "nothing"]")
		if(!goon)
			continue
		allocated += goon
		goon.ai_controller?.set_ai_status(AI_STATUS_OFF)
		TEST_ASSERT(!istype(goon, /mob/living/carbon/human/npc/bounty_mafia/lieutenant), "The marker spawned a lieutenant")
		TEST_ASSERT_EQUAL(get_area(goon), room, "A goon spawned outside the marker's room")
		TEST_ASSERT_EQUAL(goon.mafia_home_ref?.resolve(), room, "A queued goon didn't take its room as home")
	qdel(probe)

// ===== GOONS: THE SHOUT, THE DOORWAY, THE DOWNED, HOLDS AND CUFFS, COVER, BODIES =====

/datum/unit_test/voidcrew_bounty_lair_mafia/goons

/datum/unit_test/voidcrew_bounty_lair_mafia/goons/Run()
	var/mob/living/carbon/human/npc/bounty_mafia/pistol/gunman = member_at(/mob/living/carbon/human/npc/bounty_mafia/pistol, spot(0, 0))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 0), as_client = TRUE)
	TEST_ASSERT(!gunman.mafia_is_ready(), "The gunman is ready before seeing anyone")

	// He spots the hunter: the room is alerted, and nobody shoots for half a second
	TEST_ASSERT_EQUAL(gunman.mafia_find_target(), hunter, "The gunman didn't spot the hunter")
	var/datum/bounty_mafia_room/room = gunman.mafia_room()
	TEST_ASSERT(room?.alerted, "Spotting a hunter didn't alert the room")
	TEST_ASSERT(gunman.mafia_ready_at >= world.time + 5, "The shout gives less than half a second") // BOUNTY_MOBSTER_ALERT
	TEST_ASSERT(!gunman.mafia_is_ready(), "The gunman may shoot before his shout is over")
	gunman.mafia_ready_at = world.time
	TEST_ASSERT(gunman.mafia_is_ready(), "The gunman may not shoot after his shout")
	TEST_ASSERT(gunman.mafia_plan_attack(gunman.ai_controller, hunter), "The gunman with a line had nothing to do")
	TEST_ASSERT(gunman.ai_controller.current_behaviors[GET_AI_BEHAVIOR(/datum/ai_behavior/bounty_mafia_fire)], "The gunman with a line didn't open fire")
	gunman.ai_controller.CancelActions()

	// Never the downed: a hunter in crit is nobody's target, however close (CB-11: only the choice spares them)
	// Suffocation, not brute: brute lands on one random limb, which caps it
	hunter.adjustOxyLoss(150)
	TEST_ASSERT(hunter.stat != CONSCIOUS, "The hunter didn't go down")
	TEST_ASSERT(!gunman.mafia_target_ok(hunter), "A goon may go after a downed hunter")
	TEST_ASSERT_NULL(gunman.mafia_find_target(), "A goon picked a downed hunter as its target")
	hunter.fully_heal(HEAL_ALL)
	TEST_ASSERT(gunman.mafia_target_ok(hunter), "The healed hunter isn't fair game again")

	// At most two of a room on one hunter in a doorway
	var/mob/living/carbon/human/npc/bounty_mafia/pistol/second = member_at(/mob/living/carbon/human/npc/bounty_mafia/pistol, spot(0, 1))
	var/mob/living/carbon/human/npc/bounty_mafia/pistol/third = member_at(/mob/living/carbon/human/npc/bounty_mafia/pistol, spot(0, 2))
	gunman.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	second.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	TEST_ASSERT(third.mafia_room_has_space(hunter), "The doorway cap applies to a hunter out in the open")
	var/obj/machinery/door/firedoor/door = allocate(/obj/machinery/door/firedoor, get_turf(hunter))
	TEST_ASSERT(third.mafia_in_doorway(hunter), "A hunter on a door tile isn't in a doorway")
	TEST_ASSERT(!third.mafia_room_has_space(hunter), "A third goon went after a hunter in a doorway")
	// Shooting the held-back goon doesn't pull it in over the cap
	SEND_SIGNAL(third, COMSIG_ATOM_WAS_ATTACKED, hunter, 4) // ATTACKER_DAMAGING_ATTACK
	TEST_ASSERT(third.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET] != hunter, "Shooting a held-back goon took it past the doorway cap")
	// And a third goon that somehow has them drops them
	third.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	TEST_ASSERT(third.mafia_find_target() != hunter, "A third goon kept a hunter in a doorway")
	TEST_ASSERT_EQUAL(gunman.mafia_find_target(), hunter, "A goon within the cap dropped its target")
	qdel(door)

	// Polymorph and type changes are refused: they'd delete a goon (or open the gate) for free
	TEST_ASSERT(SEND_SIGNAL(second, COMSIG_LIVING_PRE_WABBAJACKED, "random") & STOP_WABBAJACK, "A goon can be polymorphed")
	TEST_ASSERT(SEND_SIGNAL(second, COMSIG_PRE_MOB_CHANGED_TYPE) & COMPONENT_BLOCK_MOB_CHANGE, "A goon's type can be changed")

	// A grabbed goon fights back: its grabber is its target at once, and its AI resists the hold the tg way
	var/datum/ai_planning_subtree/bounty_escape_captivity/bounty_mafia/break_free = new
	var/datum/ai_planning_subtree/bounty_mafia_goon/mind = new
	var/mob/living/carbon/human/npc/bounty_mafia/knife = member_at(/mob/living/carbon/human/npc/bounty_mafia, spot(3, 3))
	var/mob/living/carbon/human/consistent/grabber = hunter_at(spot(4, 3))
	grabber.start_pulling(knife)
	TEST_ASSERT_EQUAL(knife.pulledby, grabber, "The test hunter couldn't grab the goon")
	TEST_ASSERT_EQUAL(knife.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET], grabber, "A grabbed goon didn't turn on its grabber")
	TEST_ASSERT_EQUAL(break_free.SelectBehaviors(knife.ai_controller, 0.5), SUBTREE_RETURN_FINISH_PLANNING, "A grabbed goon didn't put breaking free first")
	TEST_ASSERT(knife.ai_controller.current_behaviors[GET_AI_BEHAVIOR(/datum/ai_behavior/resist)], "A grabbed goon didn't try to break free")
	knife.ai_controller.CancelActions()
	// Dragged, it goes: nothing holds it in its room while someone else moves it
	TEST_ASSERT(knife.mafia_leash_allows(spot(4, 4)), "A dragged goon's room held it")
	grabber.stop_pulling()

	// Dragged out of its room, it still fights whoever it can reach, and only walks back once they're gone
	knife.mafia_ready_at = world.time
	knife.mafia_home_ref = WEAKREF(GLOB.areas_by_type[/area/space])
	TEST_ASSERT(!knife.mafia_at_home(), "The goon isn't out of its room")
	mind.SelectBehaviors(knife.ai_controller, 0.5)
	TEST_ASSERT(knife.ai_controller.current_behaviors[GET_AI_BEHAVIOR(/datum/ai_behavior/basic_melee_attack/human_npc)], "A goon out of its room didn't fight the hunter next to it")
	knife.ai_controller.CancelActions()
	knife.mafia_home_ref = WEAKREF(get_area(knife))

	// Someone starting to cuff a goon who can still move: it turns on them and steps away, a real step; paralysed, it can't
	TEST_ASSERT(!(SEND_SIGNAL(knife, COMSIG_CARBON_CUFF_ATTEMPTED, grabber) & COMSIG_CARBON_CUFF_PREVENT), "A goon refused the cuffs outright")
	TEST_ASSERT_EQUAL(knife.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET], grabber, "A goon didn't turn on the hunter cuffing it")
	var/turf/cuffed_at = get_turf(knife)
	TEST_ASSERT(knife.mafia_dodge_cuffs(WEAKREF(grabber)), "A free goon didn't step away from the cuffs")
	TEST_ASSERT(get_turf(knife) != cuffed_at, "The goon's step away from the cuffs went nowhere")
	knife.forceMove(cuffed_at)
	knife.Paralyze(10 SECONDS)
	TEST_ASSERT(!knife.mafia_dodge_cuffs(WEAKREF(grabber)), "A paralysed goon stepped away from the cuffs")
	knife.SetParalyzed(0)

	// A gunman in an alerted room kicks a table over, on its side toward the hunter
	var/mob/living/carbon/human/npc/bounty_mafia/pistol/fourth = member_at(/mob/living/carbon/human/npc/bounty_mafia/pistol, spot(1, 4))
	var/obj/structure/table/wood/table = allocate(/obj/structure/table/wood, spot(2, 4))
	var/mob/living/carbon/human/consistent/across = hunter_at(spot(4, 4))
	TEST_ASSERT_EQUAL(fourth.mafia_take_cover(across), table, "A gunman didn't take the table beside him for cover")
	sleep(1) // the flip runs off the caller's stack
	TEST_ASSERT(table.is_flipped, "The gunman's table didn't go over")
	TEST_ASSERT_EQUAL(table.dir, EAST, "The table's top doesn't face the hunter")
	TEST_ASSERT_NULL(fourth.mafia_take_cover(across), "A gunman kicked over a second table")

	// With a wall in the way it comes to the room's door nearest them
	var/obj/machinery/door/firedoor/exit_door = allocate(/obj/machinery/door/firedoor, spot(4, 0))
	var/datum/bounty_mafia_room/goon_room = knife.mafia_room()
	goon_room.room_exits = null
	TEST_ASSERT_EQUAL(knife.mafia_exit_toward(hunter), get_turf(exit_door), "A goon doesn't know its room's door")
	clear_room()

	// They die in place in their club clothes, and their guns stay locked on them: none lies on the floor
	for(var/goon_type in list(/mob/living/carbon/human/npc/bounty_mafia, /mob/living/carbon/human/npc/bounty_mafia/pistol, /mob/living/carbon/human/npc/bounty_mafia/smg, /mob/living/carbon/human/npc/bounty_mafia/lieutenant/tommy))
		var/turf/where = spot(2, 3)
		var/mob/living/carbon/human/npc/bounty_mafia/goon = member_at(goon_type, where)
		goon.death()
		TEST_ASSERT(!QDELETED(goon), "[goon_type]'s body went with its death")
		TEST_ASSERT_EQUAL(get_turf(goon), where, "[goon_type]'s body moved when it died")
		TEST_ASSERT_NOTNULL(goon.w_uniform, "[goon_type]'s body isn't dressed")
		for(var/obj/item/gun/gun in where)
			TEST_FAIL("[goon_type] dropped [gun]")
		qdel(goon)
		clear_room()

// ===== THE RING, THE REAL WAY: THROUGH P10'S LAIR AND ITS TROPHY CALL =====

/datum/unit_test/voidcrew_bounty_lair_mafia/ring_path
	/// The lair it faked: its interior is the test floor, never torn down for real
	var/obj/structure/overmap/space_ruin/bounty_lair/fake_lair
	/// The boss landmark (landmarks survive the test floor's sweep)
	var/obj/effect/landmark/bounty_lair_boss/boss_mark

/datum/unit_test/voidcrew_bounty_lair_mafia/ring_path/New()
	. = ..()
	board_test_begin()

/datum/unit_test/voidcrew_bounty_lair_mafia/ring_path/Destroy()
	// A faked interior must never reach a real teardown: drop it before the bounties close
	if(fake_lair && !QDELETED(fake_lair))
		fake_lair.cancel_despawn_timer()
		fake_lair.mapzone = null
		fake_lair.footprint = null
		fake_lair.loaded = FALSE
	board_test_end()
	if(fake_lair && !QDELETED(fake_lair))
		qdel(fake_lair)
	if(boss_mark && !QDELETED(boss_mark))
		qdel(boss_mark)
	fake_lair = null
	boss_mark = null
	return ..()

/datum/unit_test/voidcrew_bounty_lair_mafia/ring_path/Run()
	var/turf/origin = run_loc_floor_bottom_left
	var/datum/criminal_bounty/kill_only/lair/posting = new
	posting.record = bounty_kill_record("Arkady Sokolov", "racketeering", MALE, 5000, "test")
	posting.placement_kind = "ruin" // BOUNTY_PLACEMENT_RUIN
	posting.value = 5000
	posting.board_vouchers = 3
	posting.board_zone = 1 // ZONE_GREEN
	posting.expires_at = world.time + 60 MINUTES
	posting.board_gps_tag = "WANTED-[posting.record.id]"
	GLOB.criminal_bounties += posting
	fake_lair = allocate(/obj/structure/overmap/space_ruin/bounty_lair)
	fake_lair.npc_spawn_context = allocate(/datum/npc_spawn_context, src, 2, "boss")
	fake_lair.lair_bind_posting(posting)
	var/datum/map_footprint/footprint = allocate(/datum/map_footprint)
	footprint.z_value = origin.z
	footprint.set_rect(origin.x, origin.y, 5, 5)
	fake_lair.footprint = footprint
	fake_lair.loaded = TRUE
	boss_mark = new(locate(origin.x + 2, origin.y + 2, origin.z))
	boss_mark.boss_type = /mob/living/basic/bounty_lair_boss/mafia_mech
	var/obj/effect/landmark/bounty_lair_gatekeeper/keeper_mark = allocate(/obj/effect/landmark/bounty_lair_gatekeeper, origin)
	keeper_mark.gatekeeper_type = /mob/living/basic/npc_zone_test

	// The lair spawns the mech and takes it on
	SEND_SIGNAL(fake_lair, "voidcrew_planet_loaded", TRUE) // COMSIG_VOIDCREW_PLANET_LOADED
	var/deadline = world.time + 10 SECONDS
	UNTIL(fake_lair.lair_link_done || world.time >= deadline)
	TEST_ASSERT(fake_lair.lair_link_done, "The lair never finished linking")
	TEST_ASSERT_EQUAL(length(fake_lair.lair_bosses), 1, "The lair didn't spawn its boss")
	var/datum/weakref/mech_ref = fake_lair.lair_bosses[1]
	var/mob/living/basic/bounty_lair_boss/mafia_mech/mech = mech_ref.resolve()
	TEST_ASSERT(istype(mech), "The lair's boss isn't the don's mech")
	TEST_ASSERT(abs(mech.maxHealth - 350 * 1.15) < 0.001, "The lair route did not finalize its boss")
	TEST_ASSERT_EQUAL(length(fake_lair.lair_gatekeepers), 1, "Lair gatekeeper fixture did not spawn")
	var/datum/weakref/keeper_ref = fake_lair.lair_gatekeepers[1]
	var/mob/living/keeper = keeper_ref.resolve()
	allocated += keeper
	TEST_ASSERT_EQUAL(keeper.npc_zone_role, "boss", "Lair gatekeeper lost its explicit boss role")
	TEST_ASSERT(abs(keeper.maxHealth - 115) < 0.001, "Lair gatekeeper used the ordinary profile")
	TEST_ASSERT_EQUAL(mech.posting_ref?.resolve(), posting, "The mech isn't wanted on the lair's bounty")

	// The mech breaks: the lair takes the don, a person, on as he climbs out, and the fight goes on past its grace
	var/turf/wreck_spot = get_turf(mech)
	mech.death()
	var/mob/living/carbon/human/npc/bounty_mafia/don/don = locate() in range(1, wreck_spot)
	TEST_ASSERT_NOTNULL(don, "The don didn't climb out")
	allocated += don
	don.ai_controller?.set_ai_status(AI_STATUS_OFF)
	TEST_ASSERT(don.weak_reference && (don.weak_reference in fake_lair.lair_bosses), "The lair didn't take on the don")
	TEST_ASSERT_EQUAL(bounty_kill_posting_of(don), posting, "The don on foot isn't wanted on the lair's bounty")
	sleep(6 SECONDS) // BOUNTY_LAIR_TROPHY_GRACE 5 seconds
	TEST_ASSERT(!fake_lair.lair_boss_killed, "The lair called the fight over with the don standing")
	TEST_ASSERT_NULL(posting.board_proof(), "A trophy dropped with the don standing")

	// The don dies: his ring is the bounty's proof, and the lair drops no second one
	don.death()
	var/obj/item/bounty_proof/trophy/mafia_don/ring = posting.board_proof()
	TEST_ASSERT(istype(ring), "The don's death didn't bind his ring to the bounty")
	sleep(6 SECONDS) // BOUNTY_LAIR_TROPHY_GRACE 5 seconds
	TEST_ASSERT(fake_lair.lair_boss_killed, "The lair didn't call the fight over after the don died")
	TEST_ASSERT_EQUAL(posting.board_proof(), ring, "The bounty's proof changed after the don died")
	// Brought back and killed again, nothing more drops
	don.revive(HEAL_ALL)
	don.death()
	var/rings = 0
	for(var/obj/item/bounty_proof/trophy/trophy in range(6, origin))
		rings++
	TEST_ASSERT_EQUAL(rings, 1, "The kill left [rings] trophies, not one")
	TEST_ASSERT_EQUAL(posting.board_proof(), ring, "A second death changed the bounty's proof")
