/**
 * Bounty hunting: P6 outposts's tests, for voidcrew/modules/bounties/bounty_outpost.dm.
 *
 * Owner: P6 outposts. Do not edit this file outside that package. Fork defines are included after
 * the tests, so a test uses the literal value with a comment naming the define.
 *
 * The fugitive and its decoys are real human NPCs. The tests make a trader outpost out of the test room
 * (its hangar lift in the top right corner) and drive the procs directly. They pin what the other
 * packages give back where it matters (a test fugitive that records being confronted, a test posting
 * that records being relisted). Nothing here sleeps while someone is leaving: the human NPC
 * subsystem sweeps leavers on its own every second, and a test that wants a sweep makes it itself.
 */

/// What a fugitive wears before it changes into the zone's clothes: armour, a helmet, a mask, gloves,
/// boots, and a medipen in a pocket
/datum/outfit/bounty_outpost_test_criminal
	name = "Outpost test criminal"
	uniform = /obj/item/clothing/under/color/black
	suit = /obj/item/clothing/suit/armor/vest
	head = /obj/item/clothing/head/helmet
	mask = /obj/item/clothing/mask/surgical
	gloves = /obj/item/clothing/gloves/color/black
	shoes = /obj/item/clothing/shoes/jackboots
	l_pocket = /obj/item/reagent_containers/hypospray/medipen

/// A fugitive that remembers who confronted it
/mob/living/carbon/human/npc/bounty_criminal/meek/outpost_test
	/// Whoever on_confronted() was last called with
	var/confronted_by

/mob/living/carbon/human/npc/bounty_criminal/meek/outpost_test/on_confronted(mob/user)
	confronted_by = user
	return ..()

/// A posting that remembers being relisted, and doesn't go anywhere
/datum/criminal_bounty/outpost_test
	/// The reason relist() was last called with
	var/relisted_for

/datum/criminal_bounty/outpost_test/relist(reason)
	relisted_for = reason

/// A trader outpost made of the test room, and postings there
/datum/unit_test/voidcrew_bounty_outpost
	abstract_type = /datum/unit_test/voidcrew_bounty_outpost
	/// The outpost the test room stands in for
	var/obj/structure/overmap/trader_outpost/outpost
	/// The crews make_hunter() made, taken apart before the ships go (a team holds its ship)
	var/list/outpost_test_teams = list()
	/// The minds make_hunter() gave a crew, let go of their crew before the teams go
	var/list/outpost_test_minds = list()

/datum/unit_test/voidcrew_bounty_outpost/Destroy()
	// The decoys come out of the spawn queue, not out of allocate(): they go with their posting
	for(var/datum/criminal_bounty/posting in allocated)
		for(var/mob/living/decoy as anything in posting.outpost_forget_decoys())
			qdel(decoy)
	GLOB.criminal_bounties -= allocated
	// A mind or a team left pointing at an allocated ship would keep it from being deleted
	for(var/datum/mind/mind as anything in outpost_test_minds)
		mind.ship_teams = null
	for(var/datum/team/voidcrew/team as anything in outpost_test_teams)
		team.ship = null
		qdel(team)
	outpost_test_minds.Cut()
	outpost_test_teams.Cut()
	return ..()

/// A trader outpost whose concourse is the test room, with its hangar lift in the top right corner
/datum/unit_test/voidcrew_bounty_outpost/proc/make_outpost(outpost_type = /obj/structure/overmap/trader_outpost)
	var/obj/structure/overmap/trader_outpost/new_outpost = allocate(outpost_type)
	new_outpost.outpost_template = allocate(/datum/map_template/trader_outpost)
	new_outpost.outpost_template.width = run_loc_floor_top_right.x - run_loc_floor_bottom_left.x + 1
	new_outpost.outpost_template.height = run_loc_floor_top_right.y - run_loc_floor_bottom_left.y + 1
	new_outpost.template_bottom_left = run_loc_floor_bottom_left
	new_outpost.lobby_alcove_turfs = list(run_loc_floor_top_right)
	return new_outpost

/// A criminal of `fugitive_type` for `record` at `where`, built now in the test criminal's clothes, with the record's face
/datum/unit_test/voidcrew_bounty_outpost/proc/make_fugitive(fugitive_type, turf/where, datum/bounty_record/record)
	var/datum/human_npc_order/order = spawn_human_npc(fugitive_type, where || run_loc_floor_bottom_left, look = record, outfit = /datum/outfit/bounty_outpost_test_criminal, name = record.name, immediate = TRUE)
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = order?.spawned_ref?.resolve()
	qdel(order)
	if(fugitive)
		allocated += fugitive
		fugitive.record = record
	return fugitive

/// An open trader-outpost posting at `outpost` with its fugitive standing at `where`
/datum/unit_test/voidcrew_bounty_outpost/proc/make_posting(turf/where, fugitive_type = /mob/living/carbon/human/npc/bounty_criminal/meek/outpost_test)
	var/datum/bounty_record/record = generate_bounty_record(1, "meek", "trader_outpost") // BOUNTY_TIER_PETTY, BOUNTY_ARCHETYPE_MEEK, BOUNTY_PLACEMENT_TRADER_OUTPOST
	var/datum/criminal_bounty/outpost_test/posting = allocate(/datum/criminal_bounty/outpost_test)
	posting.record = record
	posting.placement_kind = "trader_outpost" // BOUNTY_PLACEMENT_TRADER_OUTPOST
	posting.site_ref = WEAKREF(outpost)
	posting.value = 1234
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = make_fugitive(fugitive_type, where, record)
	fugitive.posting_ref = WEAKREF(posting)
	posting.criminal_ref = WEAKREF(fugitive)
	GLOB.criminal_bounties += posting
	return posting

/// A person with a mind, crewing `ship` if given. The crew is taken apart when the test ends.
/datum/unit_test/voidcrew_bounty_outpost/proc/make_hunter(obj/structure/overmap/ship/ship)
	var/mob/living/carbon/human/hunter = allocate(/mob/living/carbon/human/consistent)
	hunter.mind_initialize()
	if(ship)
		if(!ship.ship_team)
			ship.ship_team = new
		var/datum/team/voidcrew/team = ship.ship_team
		team.ship = ship
		team.join_member(hunter.mind)
		outpost_test_teams |= team
		outpost_test_minds += hunter.mind
	return hunter

/// The posting's decoys, resolved
/datum/unit_test/voidcrew_bounty_outpost/proc/decoys_of(datum/criminal_bounty/posting)
	. = list()
	for(var/datum/weakref/decoy_ref as anything in posting.decoys)
		var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoy_ref?.resolve()
		if(decoy)
			. += decoy

/// A mob's examine as plain text, with its own feature lines taken out
/datum/unit_test/voidcrew_bounty_outpost/proc/plain_examine(mob/living/carbon/human/npc/bounty_criminal/patron, mob/viewer)
	var/list/features = list()
	for(var/line in patron.record?.feature_lines())
		features += trim(STRIP_HTML_FULL("[line]", MAX_MESSAGE_LEN))
	var/list/lines = list()
	for(var/line in patron.examine(viewer))
		var/plain = trim(STRIP_HTML_FULL("[line]", MAX_MESSAGE_LEN))
		if(!(plain in features))
			lines += plain
	return lines.Join(" | ")

/// How many of `wanted`'s features `decoy` has exactly: the same kind with the same value
/datum/unit_test/voidcrew_bounty_outpost/proc/shared_features(list/decoy_features, list/wanted_features)
	var/shared = 0
	for(var/kind in decoy_features)
		if((kind in wanted_features) && wanted_features[kind] == decoy_features[kind])
			shared++
	return shared

/// Whether `walker` is on its way out: tracked as a leaver, with an exit its AI knows (the key is BB_HUMAN_NPC_EXIT)
/datum/unit_test/voidcrew_bounty_outpost/proc/is_leaving(mob/living/carbon/human/npc/walker)
	return (walker in SShuman_npcs.leavers) && !isnull(walker.npc_exit) && walker.ai_controller?.blackboard["human_npc_exit"] == walker.npc_exit

/// Setting up: the fugitive blends in, three decoys share one or two of its features, and an outpost takes at most two fugitives and never a mini-boss
/datum/unit_test/voidcrew_bounty_outpost/blend

/datum/unit_test/voidcrew_bounty_outpost/blend/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "A trader-outpost posting could not be set up to blend in")
	TEST_ASSERT(fugitive.blended, "The fugitive is not blending in")

	var/list/decoys = decoys_of(posting)
	TEST_ASSERT_EQUAL(length(decoys), 3, "The fugitive did not get three decoys") // BOUNTY_DECOY_COUNT
	TEST_ASSERT_EQUAL(length(posting.outpost_decoy_shares), 3, "The decoys' shared features were not recorded")
	var/list/wanted_features = posting.record.features
	for(var/shared in posting.outpost_decoy_shares)
		TEST_ASSERT(shared >= 1 && shared <= 2, "A decoy was made to share [shared] features, not one or two")
		if(length(wanted_features))
			TEST_ASSERT(shared < length(wanted_features), "A decoy was made to share all [length(wanted_features)] of the fugitive's features")
	for(var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy as anything in decoys)
		TEST_ASSERT(ishuman(decoy), "A decoy is not a person")
		TEST_ASSERT(decoy.blended, "A decoy is not blending in")
		TEST_ASSERT(decoy.record && decoy.record != posting.record, "A decoy has no record of its own")
		TEST_ASSERT_NULL(decoy.posting_ref, "A decoy is linked to the posting as if it were the criminal")
		TEST_ASSERT(decoy.loc != fugitive.loc, "A decoy spawned on the fugitive")
		TEST_ASSERT(!(decoy.loc in outpost.lobby_alcove_turfs), "A decoy spawned on the hangar lift")
		TEST_ASSERT_EQUAL(decoy.record.crime, posting.record.crime, "A decoy's record names a different crime from the fugitive's")
		// P1's features are kind -> value; a shared feature is the same kind with the same value
		if(length(wanted_features) >= 2)
			var/shared = shared_features(decoy.record.features, wanted_features)
			TEST_ASSERT(shared >= 1 && shared <= 2 && shared < length(wanted_features), "A decoy shares [shared] of the fugitive's [length(wanted_features)] features")

	// At most two fugitives at one outpost, and never a mini-boss (AR-C9)
	var/datum/criminal_bounty/outpost_test/second = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(second.setup_outpost_blend(TRUE), "A second fugitive was refused at the outpost")
	var/datum/criminal_bounty/outpost_test/third = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(!third.setup_outpost_blend(TRUE), "A third fugitive was let into one outpost")
	var/datum/criminal_bounty/outpost_test/boss_posting = make_posting(run_loc_floor_bottom_left, /mob/living/carbon/human/npc/bounty_criminal/boss)
	boss_posting.record.archetype = "boss" // BOUNTY_ARCHETYPE_BOSS
	second.status = "closed" // BOUNTY_POSTING_CLOSED: the outpost has room again
	TEST_ASSERT(!boss_posting.setup_outpost_blend(TRUE), "A mini-boss was set up at a trader outpost")
	TEST_ASSERT(third.setup_outpost_blend(TRUE), "A closed posting still counted against the outpost's fugitives")

	// A record whose mugshot is already out keeps the face everyone has seen (M3)
	var/datum/criminal_bounty/outpost_test/published = make_posting(run_loc_floor_bottom_left)
	third.status = "closed" // BOUNTY_POSTING_CLOSED
	published.record.old_look = null
	published.record.mugshot = "published"
	TEST_ASSERT(published.setup_outpost_blend(TRUE), "A relisted posting could not be set up")
	TEST_ASSERT_NULL(published.record.old_look, "A published face was given an invented past")
	TEST_ASSERT_EQUAL(published.record.mugshot, "published", "A published mugshot was thrown away")

/// Decoys are human NPCs, so they come out of the spawn queue: the posting counts them while they wait, a closed posting cancels the ones not built, and the ones built join it
/datum/unit_test/voidcrew_bounty_outpost/queue

/datum/unit_test/voidcrew_bounty_outpost/queue/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	TEST_ASSERT(posting.setup_outpost_blend(), "A trader-outpost posting could not be set up to blend in")
	TEST_ASSERT_EQUAL(length(posting.outpost_decoy_orders), 3, "The decoys were not put in the spawn queue") // BOUNTY_DECOY_COUNT
	TEST_ASSERT_EQUAL(length(decoys_of(posting)), 0, "The decoys were built at once, not queued")
	SShuman_npcs.process_spawns(10)
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT_EQUAL(length(decoys), 3, "The queued decoys did not join the posting once built")
	for(var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy as anything in decoys)
		TEST_ASSERT(decoy.blended, "A queued decoy is not blending in")
		TEST_ASSERT_EQUAL(decoy.name, bounty_outpost_display_name(outpost), "A queued decoy does not go by the outpost's name for its crowd")

	// Closed before they are built: nobody is built
	var/datum/criminal_bounty/outpost_test/closing = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(closing.setup_outpost_blend(), "The second posting could not be set up to blend in")
	TEST_ASSERT_EQUAL(length(closing.outpost_decoy_orders), 3, "The second posting's decoys were not queued")
	var/queued_before = length(SShuman_npcs.queue)
	closing.outpost_release_site()
	TEST_ASSERT_EQUAL(length(closing.outpost_decoy_orders), 0, "A released posting kept its queued decoys")
	TEST_ASSERT_EQUAL(length(SShuman_npcs.queue), queued_before - 3, "A released posting left its decoys in the spawn queue")
	SShuman_npcs.process_spawns(10)
	TEST_ASSERT_EQUAL(length(decoys_of(closing)), 0, "Decoys were built for a posting that had let them go")

/// Only customers' floor: a fugitive placed behind a counter moves out onto the concourse, and the decoys come from the same floor (M5)
/datum/unit_test/voidcrew_bounty_outpost/public_floor

/datum/unit_test/voidcrew_bounty_outpost/public_floor/Run()
	outpost = make_outpost()
	// A counter right across the room, two rows up: the bottom two rows are behind it
	var/counter_y = run_loc_floor_bottom_left.y + 2
	for(var/x in run_loc_floor_bottom_left.x to run_loc_floor_top_right.x)
		allocate(/obj/structure/table, locate(x, counter_y, run_loc_floor_bottom_left.z))
	var/datum/criminal_bounty/outpost_test/posting = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	var/list/floor = bounty_outpost_public_floor(outpost)
	TEST_ASSERT(!(run_loc_floor_bottom_left in floor), "Floor behind the counter counts as the customers'")
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	TEST_ASSERT(fugitive.y > counter_y, "The fugitive stayed behind the counter")
	for(var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy as anything in decoys_of(posting))
		TEST_ASSERT(decoy.y > counter_y, "A decoy spawned behind the counter")
	// P5 places fugitives with the same picker
	var/turf/spot = bounty_outpost_spawn_spot(outpost)
	TEST_ASSERT(spot && (spot in floor) && !(spot in outpost.lobby_alcove_turfs), "The spawn picker gave [spot], not the customers' floor")

/// The fugitive and its decoys look alike to a player: the same species, build, skin, eyes, clothes, generic name and description, never the alias, and the same toughness and pace; and the fugitive's own armour and kit are gone from sight, not on the floor
/datum/unit_test/voidcrew_bounty_outpost/look_alikes

/datum/unit_test/voidcrew_bounty_outpost/look_alikes/Run()
	outpost = make_outpost(/obj/structure/overmap/trader_outpost/outfitter)
	outpost.lobby_alcove_turfs = list(run_loc_floor_top_right)
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	// Tougher than a person, so the decoys have something to match
	fugitive.set_npc_toughness(0.8)
	TEST_ASSERT_NOTNULL(fugitive.wear_suit, "Test fixture: the fugitive wears no armour")
	TEST_ASSERT_NOTNULL(fugitive.head, "Test fixture: the fugitive wears no helmet")
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys), "No decoys to compare with")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]

	// Names and descriptions
	TEST_ASSERT_EQUAL(fugitive.name, "dockhand", "The fugitive at the outfitter is not called a dockhand")
	TEST_ASSERT_EQUAL(decoy.name, fugitive.name, "A decoy's name differs from the fugitive's")
	TEST_ASSERT_EQUAL(decoy.real_name, fugitive.real_name, "A decoy's voice name differs from the fugitive's")
	TEST_ASSERT(fugitive.name != posting.record.name && fugitive.name != posting.record.alias, "The fugitive shows its name or alias")
	TEST_ASSERT_EQUAL(decoy.desc, fugitive.desc, "A decoy's description differs from the fugitive's")

	// The same build and face, whatever features were changed
	TEST_ASSERT_EQUAL(decoy.dna.species.type, fugitive.dna.species.type, "A decoy is another species")
	TEST_ASSERT_EQUAL(decoy.gender, fugitive.gender, "A decoy is another sex")
	TEST_ASSERT_EQUAL(decoy.physique, fugitive.physique, "A decoy has another build")
	TEST_ASSERT_EQUAL(decoy.skin_tone, fugitive.skin_tone, "A decoy has another skin tone")
	TEST_ASSERT_EQUAL(decoy.eye_color_left, fugitive.eye_color_left, "A decoy has other eyes")
	TEST_ASSERT_EQUAL(decoy.eye_color_right, fugitive.eye_color_right, "A decoy has other eyes")

	// The same clothes, and no hat or mask on either: hair is a clue
	TEST_ASSERT(istype(fugitive.w_uniform, /obj/item/clothing/under/rank/cargo/tech), "The fugitive did not change into the zone's uniform")
	TEST_ASSERT(istype(fugitive.wear_suit, /obj/item/clothing/suit/hazardvest), "The fugitive did not change into the zone's coat")
	TEST_ASSERT(istype(fugitive.gloves, /obj/item/clothing/gloves/fingerless), "The fugitive did not change into the zone's gloves")
	TEST_ASSERT(istype(fugitive.shoes, /obj/item/clothing/shoes/workboots), "The fugitive did not change into the zone's boots")
	TEST_ASSERT_NULL(fugitive.head, "The fugitive kept its helmet on")
	TEST_ASSERT_NULL(fugitive.wear_mask, "The fugitive kept its mask on")
	TEST_ASSERT_EQUAL(decoy.w_uniform?.type, fugitive.w_uniform?.type, "A decoy wears another uniform")
	TEST_ASSERT_EQUAL(decoy.wear_suit?.type, fugitive.wear_suit?.type, "A decoy wears another coat")
	TEST_ASSERT_EQUAL(decoy.gloves?.type, fugitive.gloves?.type, "A decoy wears other gloves")
	TEST_ASSERT_EQUAL(decoy.shoes?.type, fugitive.shoes?.type, "A decoy wears other boots")
	TEST_ASSERT_NULL(decoy.head, "A decoy wears a hat")
	TEST_ASSERT_NULL(decoy.wear_mask, "A decoy wears a mask")
	for(var/obj/item/clothes as anything in list(fugitive.w_uniform, fugitive.wear_suit, fugitive.gloves, fugitive.shoes))
		TEST_ASSERT(human_npc_gear_locked(clothes), "[clothes] is not locked to the body like the rest of its kit")
	// What it wore is deleted, not dropped for someone to pick up; what was in its pocket stays
	TEST_ASSERT_NULL(locate(/obj/item/clothing/suit/armor/vest) in fugitive.loc, "The fugitive's armour was left on the floor")
	TEST_ASSERT_NULL(locate(/obj/item/clothing/head/helmet) in fugitive.loc, "The fugitive's helmet was left on the floor")
	TEST_ASSERT(istype(fugitive.l_store, /obj/item/reagent_containers/hypospray/medipen), "The fugitive's pocket was emptied when it changed clothes")
	// A decoy is nobody's fighter: no weapon, nothing in its hands
	TEST_ASSERT_NULL(locate(/obj/item/gun) in decoy.get_all_contents(), "A decoy carries a gun")
	TEST_ASSERT_NULL(decoy.get_active_held_item(), "A decoy holds something")
	TEST_ASSERT_NULL(decoy.get_inactive_held_item(), "A decoy holds something")

	// The same toughness and pace, through the body and never through a stand-in
	TEST_ASSERT_EQUAL(fugitive.npc_damage_taken, 0.8, "Test fixture: the fugitive's toughness did not take")
	TEST_ASSERT_EQUAL(decoy.npc_damage_taken, fugitive.npc_damage_taken, "A decoy is not as tough as the fugitive")
	TEST_ASSERT_EQUAL(decoy.physiology.brute_mod, fugitive.physiology.brute_mod, "A decoy takes other brute damage from the fugitive")
	TEST_ASSERT_EQUAL(decoy.physiology.burn_mod, fugitive.physiology.burn_mod, "A decoy takes other burn damage from the fugitive")
	TEST_ASSERT_EQUAL(decoy.maxHealth, 100, "A decoy's max health was changed")
	TEST_ASSERT_EQUAL(decoy.move_intent, fugitive.move_intent, "A decoy walks differently from the fugitive")
	TEST_ASSERT_EQUAL(decoy.cached_multiplicative_slowdown, fugitive.cached_multiplicative_slowdown, "A decoy's speed differs from the fugitive's")
	var/mob/living/carbon/human/person = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT_EQUAL(decoy.move_resist, person.move_resist, "A decoy is harder to move than a person")
	TEST_ASSERT_EQUAL(fugitive.move_resist, person.move_resist, "A fugitive blending in is harder to move than a person")

	// Examine: the same plain text once each one's own feature lines are taken out
	var/mob/living/carbon/human/viewer = make_hunter()
	TEST_ASSERT_EQUAL(plain_examine(decoy, viewer), plain_examine(fugitive, viewer), "A decoy examines differently from the fugitive")

	// A decoy made any other way still dresses as a customer, never as a criminal
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/stray = allocate(/mob/living/carbon/human/npc/bounty_criminal/decoy)
	TEST_ASSERT(istype(stray.w_uniform, /obj/item/clothing/under/costume/buttondown/slacks) || istype(stray.w_uniform, /obj/item/clothing/under/rank/cargo/tech) || istype(stray.w_uniform, /obj/item/clothing/under/pants/jeans), "A decoy built outside the outpost's code is not dressed as a patron")
	TEST_ASSERT_NULL(locate(/obj/item/gun) in stray.get_all_contents(), "A decoy built outside the outpost's code carries a gun")
	TEST_ASSERT_NULL(stray.get_active_held_item(), "A decoy built outside the outpost's code holds something")
	TEST_ASSERT(stray.npc_corpse_lifetime > 0, "A dead decoy would lie there for good: nobody's posting cleans it up")

	// The other zones' names
	TEST_ASSERT_EQUAL(bounty_outpost_display_name(allocate(/obj/structure/overmap/trader_outpost/general)), "patron", "Halcyon's crowd is not patrons")
	TEST_ASSERT_EQUAL(bounty_outpost_display_name(allocate(/obj/structure/overmap/trader_outpost/black_market)), "spacer", "The Undertow's crowd is not spacers")

/// The warrant: on a decoy it raises the alert, on the fugitive it confronts it, and a ship waits between warrants
/datum/unit_test/voidcrew_bounty_outpost/warrant

/datum/unit_test/voidcrew_bounty_outpost/warrant/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/meek/outpost_test/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys) >= 2, "Too few decoys to test with")
	var/obj/structure/overmap/ship/ship = allocate(/obj/structure/overmap/ship)
	var/mob/living/carbon/human/hunter = make_hunter(ship)
	var/obj/item/paper/bounty_warrant/warrant = allocate(/obj/item/paper/bounty_warrant)
	warrant.posting_ref = WEAKREF(posting)

	// A shopper shown the warrant: nothing happens, and it costs no wait
	var/mob/living/carbon/human/shopper = make_hunter()
	warrant.show_warrant(shopper, hunter)
	TEST_ASSERT_EQUAL(posting.alert, 0, "Showing the warrant to a shopper raised the alert")
	TEST_ASSERT_EQUAL(posting.outpost_warrant_wait(hunter), 0, "Showing the warrant to a shopper started the wait")

	// A decoy: it protests, and the alert rises
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]
	warrant.show_warrant(decoy, hunter)
	TEST_ASSERT_EQUAL(posting.alert, 1, "A wrong warrant did not raise the alert")
	TEST_ASSERT(decoy.blended, "A decoy stopped blending in after a wrong warrant")

	// The ship waits 30 seconds (BOUNTY_WARRANT_COOLDOWN) before the next one, whoever shows it
	TEST_ASSERT(posting.outpost_warrant_wait(hunter) > 0, "A wrong warrant started no wait")
	var/mob/living/carbon/human/crewmate = make_hunter(ship)
	warrant.show_warrant(fugitive, crewmate)
	TEST_ASSERT_NULL(fugitive.confronted_by, "A crewmate got round the ship's warrant wait")
	// Another ship does not wait on this one
	var/mob/living/carbon/human/rival = make_hunter(allocate(/obj/structure/overmap/ship))
	TEST_ASSERT_EQUAL(posting.outpost_warrant_wait(rival), 0, "One ship's warrant made another ship wait")

	// The fugitive: confronted, exposed and holding a grudge
	posting.outpost_warrant_ready_at.Cut()
	warrant.show_warrant(fugitive, hunter)
	TEST_ASSERT_EQUAL(fugitive.confronted_by, hunter, "The right warrant did not confront the fugitive")
	TEST_ASSERT(!fugitive.blended, "The fugitive kept blending in after being confronted")
	TEST_ASSERT(fugitive.body_has_grudge(hunter), "The fugitive does not hold a grudge against whoever confronted it")
	TEST_ASSERT(!HAS_TRAIT_FROM(fugitive, "no_containment", "bounty_outpost"), "An exposed fugitive still can't be put in a locker") // TRAIT_NO_CONTAINMENT, BOUNTY_OUTPOST_TRAIT
	TEST_ASSERT_EQUAL(posting.alert, 1, "Confronting the right person raised the alert")

	// A closed posting's warrant does nothing
	posting.outpost_warrant_ready_at.Cut()
	posting.status = "closed" // BOUNTY_POSTING_CLOSED
	warrant.show_warrant(decoys[2], hunter)
	TEST_ASSERT_EQUAL(posting.alert, 1, "An out-of-date warrant raised the alert")

/// Restraints reached for on someone blending in cost exactly what a punch costs: the decoy's wrists are a strike and the alert and it backs away, the fugitive's end its act. Down or held, the cuffs go on. A decoy confronted any other way raises the alert too (C1)
/datum/unit_test/voidcrew_bounty_outpost/cuffs

/datum/unit_test/voidcrew_bounty_outpost/cuffs/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/meek/outpost_test/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys) >= 2, "Too few decoys to test with")

	// A decoy's wrists, the way tg's cuffs reach for them: a strike and the alert, and the cuffs don't go on
	var/mob/living/carbon/human/cuffer = make_hunter()
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]
	SEND_SIGNAL(decoy, COMSIG_CARBON_CUFF_ATTEMPTED, cuffer)
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[cuffer.mind], 1, "Cuffs on a decoy were not an outpost strike, as a punch is")
	TEST_ASSERT_EQUAL(posting.alert, 1, "Cuffs on a decoy did not raise the alert, as a punch does")
	TEST_ASSERT(!decoy.is_restrained(), "A decoy on its feet was cuffed")
	TEST_ASSERT(decoy.blended, "A decoy stopped blending in")

	// The fugitive's wrists: the act is over, as for a punch, and nothing is charged. The body then
	// steps away and runs or fights (BOUNTY_CUFF_REACTION_DELAY, half a second, later).
	var/mob/living/carbon/human/other_cuffer = make_hunter()
	SEND_SIGNAL(fugitive, COMSIG_CARBON_CUFF_ATTEMPTED, other_cuffer)
	TEST_ASSERT(!fugitive.blended, "Cuffs on the fugitive did not end its act")
	TEST_ASSERT(fugitive.body_has_grudge(other_cuffer), "The fugitive holds no grudge against whoever reached for its wrists")
	TEST_ASSERT_NULL(outpost.aggressor_strikes[other_cuffer.mind], "Reaching for the fugitive's wrists was an outpost strike")
	TEST_ASSERT_EQUAL(posting.alert, 1, "Reaching for the fugitive's wrists raised the alert")
	sleep(10)
	TEST_ASSERT_EQUAL(fugitive.confronted_by, other_cuffer, "The fugitive did not answer the reach for its wrists")

	// The component answers the body's signal: standing and free, a decoy takes the reaction over (COMSIG_BOUNTY_CUFF_REACHED, COMPONENT_BOUNTY_CUFF_HANDLED)
	var/mob/living/carbon/human/third_cuffer = make_hunter()
	var/answer = SEND_SIGNAL(decoys[2], "bounty_cuff_reached", third_cuffer)
	TEST_ASSERT(answer & 1, "A free decoy's reaction to cuffs was left to the body, which would take it for a wrong warrant")
	// An exposed fugitive has nothing left to hide: the alert may rise, but nobody slips away
	TEST_ASSERT_EQUAL(posting.alert, 2, "A second decoy's wrists did not raise the alert")
	TEST_ASSERT_NULL(posting.relisted_for, "An exposed fugitive slipped away")
	TEST_ASSERT(!is_leaving(fugitive), "An exposed fugitive set off for the lift")

	// A decoy that can't answer (knocked out, say) is cuffed as anyone is, and it still costs the same
	var/datum/criminal_bounty/outpost_test/helpless_posting = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(helpless_posting.setup_outpost_blend(TRUE), "The second posting could not be set up to blend in")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/helpless = decoys_of(helpless_posting)[1]
	helpless.Paralyze(10 SECONDS)
	var/mob/living/carbon/human/fourth_cuffer = make_hunter()
	var/helpless_answer = SEND_SIGNAL(helpless, "bounty_cuff_reached", fourth_cuffer)
	TEST_ASSERT(!(helpless_answer & 1), "A decoy that could do nothing about it took the reaction over")
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[fourth_cuffer.mind], 1, "Cuffs on a helpless decoy were free")
	TEST_ASSERT_EQUAL(helpless_posting.alert, 1, "Cuffs on a helpless decoy did not raise the alert")
	helpless_posting.status = "closed" // BOUNTY_POSTING_CLOSED: the outpost has room again

	// Someone with no mind behind them never counts
	var/datum/criminal_bounty/outpost_test/mindless_posting = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(mindless_posting.setup_outpost_blend(TRUE), "The third posting could not be set up to blend in")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/untouched = decoys_of(mindless_posting)[1]
	var/mob/living/carbon/human/robot = allocate(/mob/living/carbon/human/consistent)
	SEND_SIGNAL(untouched, "bounty_cuff_reached", robot)
	TEST_ASSERT_EQUAL(mindless_posting.alert, 0, "A mindless reach for a decoy's wrists raised the alert")
	mindless_posting.status = "closed" // BOUNTY_POSTING_CLOSED

	// Any other way of confronting a decoy is a wrong accusation
	var/datum/criminal_bounty/outpost_test/next = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(next.setup_outpost_blend(TRUE), "The fourth posting could not be set up to blend in")
	var/list/next_decoys = decoys_of(next)
	TEST_ASSERT(length(next_decoys), "No decoys at the fourth posting")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/next_decoy = next_decoys[1]
	next_decoy.on_confronted(make_hunter())
	TEST_ASSERT_EQUAL(next.alert, 1, "Confronting a decoy another way cost nothing")

/// Two alerts: the decoys leave, and the fugitive walks out for real, still the posting's until it has gone; the bounty relists when it does. A fugitive caught on the way stays the posting's. An exposed fugitive stays
/datum/unit_test/voidcrew_bounty_outpost/alert

/datum/unit_test/voidcrew_bounty_outpost/alert/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)

	TEST_ASSERT(posting.raise_alert("a test"), "The alert did not rise")
	TEST_ASSERT_EQUAL(posting.alert, 1, "The first alert did not count")
	TEST_ASSERT_NULL(posting.relisted_for, "The bounty relisted at the first alert")
	TEST_ASSERT(posting.raise_alert("a test"), "The alert did not rise a second time") // BOUNTY_OUTPOST_ALERT_SLIP
	TEST_ASSERT_EQUAL(length(posting.decoys), 0, "The posting kept its decoys")
	TEST_ASSERT(is_leaving(fugitive), "The fugitive did not set off for the lift")
	TEST_ASSERT_EQUAL(fugitive.npc_exit, run_loc_floor_top_right, "The fugitive set off for somewhere other than the hangar lift")
	for(var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy as anything in decoys)
		TEST_ASSERT(is_leaving(decoy), "A decoy did not leave with the fugitive")
	// Still the posting's, and nobody's immortal on the way
	TEST_ASSERT_NULL(posting.relisted_for, "The bounty relisted before the fugitive had gone")
	TEST_ASSERT_EQUAL(posting.criminal(), fugitive, "The posting let go of a fugitive that was still walking out")
	TEST_ASSERT_EQUAL(fugitive.posting(), posting, "A fugitive on its way out is no longer the posting's")
	TEST_ASSERT(!HAS_TRAIT(fugitive, TRAIT_GODMODE), "The fugitive can't be hurt on its way out")
	var/health_before = fugitive.health
	fugitive.adjustBruteLoss(10)
	TEST_ASSERT(fugitive.health < health_before, "A shot at the fugitive on its way out did nothing")
	// A third alert while it walks starts nothing new
	posting.raise_alert("a test")
	TEST_ASSERT_NULL(posting.relisted_for, "A third alert relisted the bounty")

	// It reaches the lift, or nobody can see it: it goes, and the bounty relists
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT(QDELETED(fugitive), "The fugitive was still there once it had left")
	TEST_ASSERT_NOTNULL(posting.relisted_for, "The bounty did not relist once the fugitive had gone")
	posting.status = "closed" // BOUNTY_POSTING_CLOSED: the outpost has room again
	TEST_ASSERT_NULL(posting.criminal(), "The posting kept hold of a fugitive that slipped away")
	for(var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy as anything in decoys)
		TEST_ASSERT(QDELETED(decoy), "A decoy was still there once it had left")

	// Caught on the way: cuffed, the fugitive stays, and it is still the posting's, so it can be turned in
	var/datum/criminal_bounty/outpost_test/caught = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/caught_fugitive = caught.criminal()
	TEST_ASSERT(caught.setup_outpost_blend(TRUE), "The second posting could not be set up to blend in")
	caught.raise_alert("a test")
	caught.raise_alert("a test")
	TEST_ASSERT(is_leaving(caught_fugitive), "The second fugitive did not set off for the lift")
	var/obj/item/restraints/handcuffs/cuffs = allocate(/obj/item/restraints/handcuffs)
	TEST_ASSERT(caught_fugitive.equip_to_slot_if_possible(cuffs, ITEM_SLOT_HANDCUFFED), "Test fixture: the fugitive could not be cuffed")
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT(!QDELETED(caught_fugitive), "A cuffed fugitive walked out of the outpost")
	TEST_ASSERT_NULL(caught.relisted_for, "The bounty relisted with its fugitive still there in cuffs")
	TEST_ASSERT_EQUAL(caught.criminal(), caught_fugitive, "The posting lost a fugitive that was caught on its way out")
	TEST_ASSERT_EQUAL(caught_fugitive.capture_state(), "restrained", "A fugitive caught on its way out does not pay as caught") // BOUNTY_STATE_RESTRAINED
	// Down, not cuffed: also stays
	caught_fugitive.uncuff()
	caught_fugitive.adjustOxyLoss(110)
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT(!QDELETED(caught_fugitive), "A fugitive in crit walked out of the outpost")
	TEST_ASSERT_EQUAL(caught_fugitive.capture_state(), "downed", "A fugitive in crit does not pay as downed") // BOUNTY_STATE_DOWNED
	// On its feet and free again, it finishes the walk and the bounty relists
	caught_fugitive.setOxyLoss(0)
	caught_fugitive.updatehealth()
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT(QDELETED(caught_fugitive), "A fugitive on its feet and free did not leave")
	TEST_ASSERT_NOTNULL(caught.relisted_for, "The bounty did not relist when the second fugitive left")
	caught.status = "closed" // BOUNTY_POSTING_CLOSED

	// Once exposed, the chase is on: no more slipping away
	var/datum/criminal_bounty/outpost_test/exposed = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/exposed_fugitive = exposed.criminal()
	TEST_ASSERT(exposed.setup_outpost_blend(TRUE), "The third posting could not be set up to blend in")
	exposed.outpost_confront(exposed_fugitive, make_hunter())
	exposed.raise_alert("a test")
	exposed.raise_alert("a test")
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT_NULL(exposed.relisted_for, "An exposed fugitive slipped away")
	TEST_ASSERT_EQUAL(exposed.criminal(), exposed_fugitive, "An exposed fugitive was let go")
	TEST_ASSERT(!is_leaving(exposed_fugitive), "An exposed fugitive set off for the lift")

	// Only trader-outpost postings have an alert
	var/datum/criminal_bounty/outpost_test/planet = make_posting(run_loc_floor_bottom_left)
	planet.placement_kind = "planet" // BOUNTY_PLACEMENT_PLANET
	TEST_ASSERT(!planet.raise_alert("a test"), "A planet bounty's alert rose")

/// A deliberate hit on a decoy is an outpost strike and raises the alert; hitting the fugitive only exposes it. A shot hits whoever it hits
/datum/unit_test/voidcrew_bounty_outpost/decoy_hit

/datum/unit_test/voidcrew_bounty_outpost/decoy_hit/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys) >= 2, "Too few decoys to test with")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]

	// Someone with no mind behind them never counts
	var/mob/living/carbon/human/npc = allocate(/mob/living/carbon/human/consistent)
	npc.combat_mode = TRUE
	decoy.attack_hand(npc, list())
	TEST_ASSERT_EQUAL(posting.alert, 0, "A mindless hit on a decoy raised the alert")

	// A friendly touch never counts
	var/mob/living/carbon/human/hunter = make_hunter()
	decoy.attack_hand(hunter, list())
	TEST_ASSERT_EQUAL(posting.alert, 0, "Patting a decoy raised the alert")
	TEST_ASSERT_NULL(outpost.aggressor_strikes[hunter.mind], "Patting a decoy was an outpost strike")

	// A punch is a strike and an alert
	hunter.combat_mode = TRUE
	decoy.attack_hand(hunter, list())
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[hunter.mind], 1, "Punching a decoy was not an outpost strike")
	TEST_ASSERT_EQUAL(posting.alert, 1, "Punching a decoy did not raise the alert")

	// A shot at someone else hits whoever it hits: it goes through nobody, and it is nobody's strike
	var/mob/living/carbon/human/shooter = make_hunter()
	var/obj/projectile/bullet/stray = allocate(/obj/projectile/bullet)
	stray.firer = shooter
	stray.original = hunter
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/other_decoy = decoys[2]
	TEST_ASSERT(!(SEND_SIGNAL(other_decoy, COMSIG_PROJECTILE_PREHIT, stray) & PROJECTILE_INTERRUPT_HIT_PHASE), "A shot at someone else passed through a decoy")
	TEST_ASSERT(!(SEND_SIGNAL(other_decoy, COMSIG_PROJECTILE_PREHIT, stray) & PROJECTILE_INTERRUPT_HIT), "A shot at someone else was stopped by a decoy")
	TEST_ASSERT_EQUAL(posting.alert, 1, "A stray shot that landed on a decoy raised the alert")
	TEST_ASSERT_NULL(outpost.aggressor_strikes[shooter.mind], "A stray shot that landed on a decoy was an outpost strike")
	// One aimed at it counts, and the second alert sends the fugitive off
	var/obj/projectile/bullet/aimed = allocate(/obj/projectile/bullet)
	aimed.firer = shooter
	aimed.original = other_decoy
	TEST_ASSERT(!(SEND_SIGNAL(other_decoy, COMSIG_PROJECTILE_PREHIT, aimed) & PROJECTILE_INTERRUPT_HIT_PHASE), "A shot aimed at a decoy passed through it")
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[shooter.mind], 1, "Shooting a decoy was not an outpost strike")
	TEST_ASSERT(is_leaving(fugitive), "Two hits on decoys did not send the fugitive off")
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT_NOTNULL(posting.relisted_for, "Two hits on decoys did not relist the bounty once the fugitive had gone")

	// Hitting the (next) fugitive exposes it: no strike, no alert
	var/datum/criminal_bounty/outpost_test/next = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/next_fugitive = next.criminal()
	TEST_ASSERT(next.setup_outpost_blend(TRUE), "The second posting could not be set up to blend in")
	var/mob/living/carbon/human/brawler = make_hunter()
	brawler.combat_mode = TRUE
	next_fugitive.attack_hand(brawler, list())
	TEST_ASSERT(!next_fugitive.blended, "Punching the fugitive did not expose it")
	TEST_ASSERT(next_fugitive.body_has_grudge(brawler), "The fugitive holds no grudge against whoever hit it")
	TEST_ASSERT_EQUAL(next.alert, 0, "Hitting the fugitive raised the alert")
	TEST_ASSERT_NULL(outpost.aggressor_strikes[brawler.mind], "Hitting the fugitive was an outpost strike")

/// Things thrown straight at a decoy and a mech's fist count as hits; a throw at someone else that lands on one doesn't (H1)
/datum/unit_test/voidcrew_bounty_outpost/thrown

/datum/unit_test/voidcrew_bounty_outpost/thrown/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys) >= 2, "Too few decoys to test with")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/other_decoy = decoys[2]
	var/obj/item/storage/toolbox/toolbox = allocate(/obj/item/storage/toolbox)
	TEST_ASSERT(toolbox.throwforce > 0, "The toolbox is too light to test with")

	// Thrown at someone else, landing on a decoy: nobody is framed with it
	var/mob/living/carbon/human/thrower = make_hunter()
	var/mob/living/carbon/human/bystander = make_hunter()
	var/datum/thrownthing/stray = new(toolbox, bystander, NORTH, 7, 1, thrower)
	SEND_SIGNAL(decoy, COMSIG_ATOM_PREHITBY, toolbox, stray)
	qdel(stray)
	TEST_ASSERT_EQUAL(posting.alert, 0, "A throw at someone else that hit a decoy raised the alert")
	TEST_ASSERT_NULL(outpost.aggressor_strikes[thrower.mind], "A throw at someone else that hit a decoy was a strike")

	// Thrown at the decoy: a strike and the alert
	var/datum/thrownthing/aimed = new(toolbox, decoy, NORTH, 7, 1, thrower)
	SEND_SIGNAL(decoy, COMSIG_ATOM_PREHITBY, toolbox, aimed)
	qdel(aimed)
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[thrower.mind], 1, "A toolbox thrown at a decoy was not a strike")
	TEST_ASSERT_EQUAL(posting.alert, 1, "A toolbox thrown at a decoy did not raise the alert")

	// A mech's fist is its pilot's
	var/mob/living/carbon/human/pilot = make_hunter()
	SEND_SIGNAL(other_decoy, COMSIG_ATOM_ATTACK_MECH, null, pilot, 0)
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[pilot.mind], 1, "A mech punching a decoy was not a strike for its pilot")
	TEST_ASSERT(is_leaving(fugitive), "Two hits on decoys did not send the fugitive off")

	// A decoy that is already walking out: a hit is still the hitter's strike, but no further alert
	var/mob/living/carbon/human/late = make_hunter()
	var/datum/thrownthing/late_throw = new(toolbox, other_decoy, NORTH, 7, 1, late)
	SEND_SIGNAL(other_decoy, COMSIG_ATOM_PREHITBY, toolbox, late_throw)
	qdel(late_throw)
	TEST_ASSERT_EQUAL(outpost.aggressor_strikes[late.mind], 1, "A hit on a decoy walking out was free")

/// While blending in the turrets leave them alone and the lift never carries them; a hand on them is a hand on a person; the fugitive's shots and blows at the outpost are judged by who they hit, and hurting a bystander ends the turrets' leave
/datum/unit_test/voidcrew_bounty_outpost/security

/datum/unit_test/voidcrew_bounty_outpost/security/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys), "No decoys to test with")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]
	var/mob/living/carbon/human/hunter = make_hunter()

	TEST_ASSERT(!decoy.may_attack(hunter), "A decoy may attack someone")

	// The hangar lift carries whoever stands on it: they never step onto it (L8)
	var/turf/lift = run_loc_floor_top_right
	var/turf/beside_lift = get_step(lift, WEST)
	decoy.forceMove(beside_lift)
	decoy.Move(lift, EAST)
	TEST_ASSERT_EQUAL(decoy.loc, beside_lift, "A decoy stepped onto the hangar lift")

	// The turrets: this one does shoot a hostile creature, and skips the patrons by faction
	var/obj/machinery/porta_turret/outpost/turret = allocate(/obj/machinery/porta_turret/outpost)
	turret.outpost = outpost
	TEST_ASSERT(turret.valid_target(allocate(/mob/living/basic/carp)), "The test turret won't shoot anything, so it proves nothing")
	TEST_ASSERT(turret.in_faction(decoy) && turret.in_faction(fugitive), "The patrons are not in the turrets' faction")
	TEST_ASSERT(!turret.valid_target(decoy), "The outpost turrets target a decoy")
	TEST_ASSERT(!turret.valid_target(fugitive), "The outpost turrets target a fugitive blending in")

	// The fugitive's shots go where they go: one that lands on a person on its grudge list is the chase, one that lands on anyone else is not
	var/mob/living/carbon/human/bystander = make_hunter()
	posting.outpost_confront(fugitive, hunter)
	TEST_ASSERT(!turret.in_faction(fugitive), "An exposed fugitive is still in the turrets' faction")
	var/obj/projectile/bullet/shot = allocate(/obj/projectile/bullet)
	SEND_SIGNAL(fugitive, COMSIG_PROJECTILE_FIRER_BEFORE_FIRE, shot, fugitive, hunter)
	TEST_ASSERT(!(SEND_SIGNAL(shot, COMSIG_PROJECTILE_SELF_PREHIT, bystander) & PROJECTILE_INTERRUPT_HIT_PHASE), "The fugitive's shot passed through a bystander")
	SEND_SIGNAL(shot, COMSIG_PROJECTILE_SELF_ON_HIT, fugitive, hunter, 0, null, 0, FALSE)
	TEST_ASSERT(!fugitive.outpost_turret_target(), "Fighting its grudge list made the fugitive a turret target")
	// Hurting someone who never crossed it ends the turrets' leave
	SEND_SIGNAL(shot, COMSIG_PROJECTILE_SELF_ON_HIT, fugitive, bystander, 0, null, 0, FALSE)
	TEST_ASSERT(fugitive.outpost_turret_target(), "The fugitive hurt a bystander with a shot and the turrets still leave it be")
	TEST_ASSERT(!decoy.outpost_turret_target(), "A decoy is a turret target")
	// But not once the hunters have it: stunned, cuffed, in crit or dead (tg's states)
	fugitive.Paralyze(10 SECONDS)
	TEST_ASSERT(!fugitive.outpost_turret_target(), "The turrets fire on a fugitive the hunters have already put down")
	fugitive.SetParalyzed(0)
	TEST_ASSERT(fugitive.outpost_turret_target(), "A fugitive on its feet again is not a turret target")

	// Its blows count the same: a punch at a bystander
	var/datum/criminal_bounty/outpost_test/next = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/next_fugitive = next.criminal()
	TEST_ASSERT(next.setup_outpost_blend(TRUE), "The second posting could not be set up to blend in")
	next.outpost_confront(next_fugitive, hunter)
	SEND_SIGNAL(next_fugitive, COMSIG_LIVING_UNARMED_ATTACK, hunter, TRUE, list())
	TEST_ASSERT(!next_fugitive.outpost_turret_target(), "Punching someone on its grudge list made the fugitive a turret target")
	SEND_SIGNAL(next_fugitive, COMSIG_LIVING_UNARMED_ATTACK, bystander, TRUE, list())
	TEST_ASSERT(next_fugitive.outpost_turret_target(), "The fugitive punched a bystander and the turrets still leave it be")

/// A hand on someone blending in is a hand on a person: they can be grabbed like anyone, and it is no hit. Standing or down, the fugitive and a decoy alike
/datum/unit_test/voidcrew_bounty_outpost/grab

/datum/unit_test/voidcrew_bounty_outpost/grab/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT(length(decoys), "No decoys to test with")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[1]
	var/mob/living/carbon/human/hunter = make_hunter()

	hunter.forceMove(get_step(decoy, EAST))
	TEST_ASSERT(hunter.start_pulling(decoy), "A decoy blending in could not be grabbed")
	TEST_ASSERT_EQUAL(decoy.pulledby, hunter, "A grabbed decoy is not pulled")
	TEST_ASSERT_EQUAL(posting.alert, 0, "Grabbing a decoy raised the alert")
	TEST_ASSERT(decoy.blended, "Grabbing a decoy ended its act")
	hunter.stop_pulling()

	hunter.forceMove(get_step(fugitive, EAST))
	TEST_ASSERT(hunter.start_pulling(fugitive), "The fugitive blending in could not be grabbed")
	TEST_ASSERT_EQUAL(fugitive.pulledby, hunter, "The grabbed fugitive is not pulled")
	TEST_ASSERT(fugitive.blended, "Grabbing the fugitive gave it away")
	hunter.stop_pulling()

	// Walking out is no different: it can be grabbed, and held, it does not get away
	posting.raise_alert("a test")
	posting.raise_alert("a test")
	TEST_ASSERT(is_leaving(decoy), "Test fixture: the decoy did not leave")
	hunter.forceMove(get_step(decoy, EAST))
	TEST_ASSERT(hunter.start_pulling(decoy), "A decoy walking out could not be grabbed")
	TEST_ASSERT(!decoy.npc_may_vanish(), "A decoy in the hunter's grip walked off the map")
	hunter.stop_pulling()

/// Traders give a different clue each, once per ship, and only to a ship hunting the fugitive there; a place is never told as true after it has changed
/datum/unit_test/voidcrew_bounty_outpost/clues

/datum/unit_test/voidcrew_bounty_outpost/clues/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	// A haircut since the mugshot, so the hair clue is in the pool whatever P1 makes. Both looks keep
	// the record's species: a look with none can't name a decoy.
	var/datum/bounty_look/now = new
	now.species = posting.record.species
	now.physique = posting.record.gender
	now.hairstyle = "Mohawk"
	now.hair_color = "#101010"
	var/datum/bounty_look/then = new
	then.species = posting.record.species
	then.physique = posting.record.gender
	then.hairstyle = "Bob Hair"
	then.hair_color = "#e0c060"
	posting.record.look = now
	posting.record.old_look = then
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT_EQUAL(length(decoys), 3, "The fugitive did not get three decoys")
	// No lift nearby for this, and one person to a corner, so where each stands picks them out
	outpost.lobby_alcove_turfs = list()
	var/list/corners = list(
		run_loc_floor_top_right,
		locate(run_loc_floor_bottom_left.x, run_loc_floor_top_right.y, run_loc_floor_bottom_left.z),
		locate(run_loc_floor_top_right.x, run_loc_floor_bottom_left.y, run_loc_floor_bottom_left.z),
	)
	for(var/index in 1 to 3)
		var/mob/living/carbon/human/npc/bounty_criminal/decoy/decoy = decoys[index]
		decoy.forceMove(corners[index])

	var/list/traders = list()
	for(var/index in 1 to 4)
		var/mob/living/basic/outpost_trader/trader = allocate(/mob/living/basic/outpost_trader)
		trader.outpost = outpost
		traders += trader

	var/obj/structure/overmap/ship/ship = allocate(/obj/structure/overmap/ship)
	var/mob/living/carbon/human/hunter = make_hunter(ship)
	TEST_ASSERT_NULL(bounty_outpost_ask_posting(traders[1], hunter), "A ship not hunting the fugitive can ask about it")
	posting.claimants += WEAKREF(ship)
	TEST_ASSERT_EQUAL(bounty_outpost_ask_posting(traders[1], hunter), posting, "A ship hunting the fugitive can't ask about it")
	TEST_ASSERT(bounty_outpost_ask(traders[1], hunter), "Asking a trader did nothing")

	var/list/answers = list()
	for(var/index in 1 to 3)
		answers += posting.outpost_clue_for(traders[index], ship)
	TEST_ASSERT_EQUAL(length(unique_list(answers)), 3, "Traders repeated each other: [answers.Join(" / ")]")
	TEST_ASSERT(!("Can't help you there." in answers), "A trader had nothing to say with clues still untold") // BOUNTY_OUTPOST_NO_CLUE

	// Asking again gets the same clue, not a new one
	var/again = posting.outpost_clue_for(traders[1], ship)
	TEST_ASSERT(findtext(again, "I told you what I know"), "Asking twice got a new clue: [again]")

	// Another ship asking the same trader hears the same kind of clue
	var/obj/structure/overmap/ship/rival = allocate(/obj/structure/overmap/ship)
	var/list/kind_before = posting.outpost_trader_clues[REF(traders[2])]
	posting.outpost_clue_for(traders[2], rival)
	TEST_ASSERT_EQUAL(posting.outpost_trader_clues[REF(traders[2])], kind_before, "A trader changed their story for another ship")

	// A decoy ruled out by where it stood, and the fugitive then standing there: never told as true (M4)
	var/mob/living/basic/outpost_trader/witness = traders[4]
	posting.outpost_trader_clues[REF(witness)] = list("ruled_out", 1) // BOUNTY_CLUE_RULED_OUT, the first decoy
	var/first = posting.outpost_clue_for(witness, ship)
	var/place = bounty_outpost_where(decoys[1], outpost)
	TEST_ASSERT(findtext(first, "The one [place]?"), "The ruled-out clue was not about the first decoy: [first]")
	fugitive.forceMove(corners[1])
	var/retold = posting.outpost_clue_for(witness, ship)
	TEST_ASSERT(!findtext(retold, "The one [place]?"), "A trader told the fugitive's place as ruled out: [retold]")
	TEST_ASSERT(findtext(retold, "earlier"), "A trader retold a place that changed without saying it was earlier: [retold]")
	var/fresh = posting.outpost_clue_for(witness, rival)
	TEST_ASSERT(!findtext(fresh, "The one [place]?"), "A trader told another ship the fugitive's place was ruled out: [fresh]")

	// The hair clue says how it changed
	var/hair = bounty_outpost_hair_clue(posting.record)
	TEST_ASSERT(findtext(hair, "mohawk") || findtext(hair, "Mohawk"), "The hair clue does not name the new style: [hair]")
	TEST_ASSERT(findtext(hair, "black"), "The hair clue does not name the new colour: [hair]")

	// A feature clue is only ever the one the printed warrant leaves off (its last), never one it already lists (BUG-10)
	var/list/lines = posting.record.feature_lines()
	var/list/feature_clues = list()
	for(var/list/clue as anything in posting.outpost_build_clue_pool())
		if(clue[1] == "feature") // BOUNTY_CLUE_FEATURE
			feature_clues += clue[2]
	if(length(lines))
		TEST_ASSERT_EQUAL(length(feature_clues), 1, "The traders could give [length(feature_clues)] feature clues, not only the one off the warrant")
		TEST_ASSERT_EQUAL(feature_clues[1], length(lines), "The traders' feature clue is one the warrant already lists")
		// Said the way a person says it, never the examine label ("Scar: ...")
		var/feature_words = posting.outpost_clue_words(list("feature", length(lines)))
		TEST_ASSERT(findtext(feature_words, "I remember one thing about them. "), "The feature clue reads: [feature_words]")
		TEST_ASSERT(!findtext(feature_words, ":"), "The feature clue reads out the examine label: [feature_words]")
	else
		TEST_ASSERT(!length(feature_clues), "A fugitive with no features has a feature clue")

/// The wanted board lists the open public postings and nothing else, never builds a picture on the spot, and is outpost property
/datum/unit_test/voidcrew_bounty_outpost/board

/datum/unit_test/voidcrew_bounty_outpost/board/Run()
	outpost = make_outpost()
	var/obj/structure/bounty_wanted_board/board = allocate(/obj/structure/bounty_wanted_board)
	TEST_ASSERT(HAS_TRAIT(board, "outpost_property"), "The wanted board is not outpost property") // TRAIT_OUTPOST_PROPERTY

	var/datum/criminal_bounty/outpost_test/public_posting = make_posting()
	var/datum/criminal_bounty/outpost_test/private_posting = make_posting()
	private_posting.private_to = WEAKREF(allocate(/obj/structure/overmap/ship))
	var/datum/criminal_bounty/outpost_test/closed_posting = make_posting()
	closed_posting.status = "closed" // BOUNTY_POSTING_CLOSED

	var/list/ids = list()
	for(var/list/entry as anything in board.outpost_board_entries())
		ids[entry["id"]] = entry
	var/list/listed = ids[public_posting.record.id]
	TEST_ASSERT_NOTNULL(listed, "The board does not list a public posting")
	TEST_ASSERT_EQUAL(listed["reward"], 1234, "The board shows the wrong reward")
	TEST_ASSERT_EQUAL(listed["tier_level"], public_posting.record.tier, "The board shows the wrong tier")
	TEST_ASSERT_EQUAL(listed["terms"], "Wanted alive", "The board doesn't say how they're wanted")
	// A poster, not the rules: no clock, no kill-only flag (2026-09-26)
	for(var/key in list("time_left", "kill_only", "here", "tier"))
		TEST_ASSERT(!(key in listed), "The board still sends [key]")
	TEST_ASSERT_EQUAL(listed["reputation_gain"], 0, "The board showed a worth with no crew viewing it")
	var/mob/living/carbon/human/viewer = make_hunter(allocate(/obj/structure/overmap/ship))
	var/expected_worth = public_posting.board_reputation_worth(viewer.mind.get_reputation_crew())
	TEST_ASSERT(expected_worth > 0, "The fixture's posting is worth nothing to a new crew")
	for(var/list/entry as anything in board.outpost_board_entries(viewer))
		if(entry["id"] == public_posting.record.id)
			TEST_ASSERT_EQUAL(entry["reputation_gain"], expected_worth, "The board did not show what the posting is worth to the viewer's crew")
	TEST_ASSERT_EQUAL(listed["place"], "Seen on this concourse", "The board does not say where they were seen: [listed["place"]]")
	TEST_ASSERT(!ids[private_posting.record.id], "The board lists a private offer")
	TEST_ASSERT(!ids[closed_posting.record.id], "The board lists a closed posting")

	// Pictures that aren't built yet are queued, never built in the click (L4)
	public_posting.record.mugshot = null
	var/mob/living/carbon/human/reader = make_hunter()
	var/builds_before = GLOB.bounty_mugshot_builds
	var/list/static_data = board.ui_static_data(reader)
	TEST_ASSERT_EQUAL(GLOB.bounty_mugshot_builds, builds_before, "Opening the board built a mugshot on the spot")
	TEST_ASSERT(islist(static_data["mugshots"]), "The board sends no mugshots")
	// Only ui_data() moves the signature, so every viewer is refreshed when it changes (L7)
	board.ui_data(reader)
	TEST_ASSERT_EQUAL(board.outpost_static_signature, bounty_public_board_signature(), "The board did not notice what it shows")

/**
 * When the posting closes the decoys and an uncaught fugitive walk out for real, through the human NPC
 * base's walk out: tracked, with an exit their AI knows and the planning step to walk it, and no godmode
 * (they can be hurt, and a shot goes through no one). Anyone down, cuffed, or dead stays where they fall;
 * the rest go when nobody can see them; a lift behind a counter just means they go when nobody is looking.
 */
/datum/unit_test/voidcrew_bounty_outpost/walk_out

/datum/unit_test/voidcrew_bounty_outpost/walk_out/Run()
	outpost = make_outpost()
	// Closing for real (P5's close() tells P6 before it removes anyone)
	var/datum/criminal_bounty/outpost_test/posting = make_posting()
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	var/list/decoys = decoys_of(posting)
	TEST_ASSERT_EQUAL(length(decoys), 3, "Expected the fugitive and three decoys")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/dead_decoy = decoys[1]
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/downed_decoy = decoys[2]
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/free_decoy = decoys[3]
	dead_decoy.death()
	TEST_ASSERT(dead_decoy in SShuman_npcs.corpses, "A dead decoy is nobody's to clean up: the corpse sweep does not know it")
	posting.close("expired") // BOUNTY_CLOSE_EXPIRED

	var/datum/ai_planning_subtree/walk_out = GLOB.ai_subtrees[/datum/ai_planning_subtree/human_npc_walk_out]
	var/mob/living/carbon/human/person = allocate(/mob/living/carbon/human/consistent)
	for(var/mob/living/carbon/human/npc/walker as anything in list(fugitive, downed_decoy, free_decoy))
		TEST_ASSERT(is_leaving(walker), "[walker] did not set off for the lift when the posting closed")
		TEST_ASSERT_EQUAL(walker.npc_exit, run_loc_floor_top_right, "[walker] set off for somewhere other than the hangar lift")
		TEST_ASSERT(!HAS_TRAIT(walker, TRAIT_GODMODE), "[walker] can't be hurt on the way out")
		TEST_ASSERT_EQUAL(walker.move_resist, person.move_resist, "[walker] can't be moved on the way out")
		TEST_ASSERT(walk_out in walker.ai_controller.planning_subtrees, "[walker]'s AI has no step that walks it out") // PHASE D CORE REQUEST: every bounty controller lists /datum/ai_planning_subtree/human_npc_walk_out, after the gate and before the activity
		var/health_before = walker.health
		walker.adjustBruteLoss(10)
		TEST_ASSERT(walker.health < health_before, "A blow to [walker] on its way out did nothing")
		// Shots hit whoever they hit, walking out or not
		var/obj/projectile/bullet/shot = allocate(/obj/projectile/bullet)
		shot.firer = make_hunter()
		shot.original = walker
		TEST_ASSERT_EQUAL(SEND_SIGNAL(walker, COMSIG_PROJECTILE_PREHIT, shot), 0, "[walker] on its way out lets shots through")
	TEST_ASSERT(!is_leaving(dead_decoy), "A dead decoy set off for the lift")
	TEST_ASSERT_NULL(dead_decoy.npc_exit, "A dead decoy has somewhere to walk to")

	// Downed and cuffed ones stay; the one on its feet goes when nobody can see it
	downed_decoy.adjustOxyLoss(110)
	var/obj/item/restraints/handcuffs/cuffs = allocate(/obj/item/restraints/handcuffs)
	TEST_ASSERT(fugitive.equip_to_slot_if_possible(cuffs, ITEM_SLOT_HANDCUFFED), "Test fixture: the fugitive could not be cuffed")
	SShuman_npcs.sweep_leavers()
	TEST_ASSERT(QDELETED(free_decoy), "A decoy on its feet and out of sight was still there after the sweep")
	TEST_ASSERT(!QDELETED(downed_decoy), "A decoy in crit was deleted on its way out")
	TEST_ASSERT(!QDELETED(fugitive), "A cuffed fugitive was deleted on its way out")
	TEST_ASSERT(!QDELETED(dead_decoy), "A dead decoy was deleted at once instead of by the corpse sweep")
	// The posting is closed: nothing relists, and the cuffed fugitive was let go of
	TEST_ASSERT_NULL(posting.relisted_for, "A closed posting relisted")
	TEST_ASSERT_NULL(fugitive.posting_ref, "A fugitive the posting closed on is still linked to it")

	// Behind a counter the lift can't be reached: they still set off for it, and go when nobody is looking
	var/counter_y = run_loc_floor_bottom_left.y + 2
	for(var/x in run_loc_floor_bottom_left.x to run_loc_floor_top_right.x)
		allocate(/obj/structure/table, locate(x, counter_y, run_loc_floor_bottom_left.z))
	var/datum/criminal_bounty/outpost_test/released = make_posting(locate(run_loc_floor_bottom_left.x, run_loc_floor_top_right.y, run_loc_floor_bottom_left.z))
	TEST_ASSERT(released.setup_outpost_blend(TRUE), "The second posting could not be set up to blend in")
	var/list/walkers = decoys_of(released) + released.criminal()
	var/mob/living/carbon/human/npc/stranded = walkers[1]
	stranded.forceMove(run_loc_floor_bottom_left)
	released.outpost_release_site()
	TEST_ASSERT_EQUAL(length(released.decoys), 0, "The posting kept its decoys")
	TEST_ASSERT_NULL(released.criminal(), "The posting kept its fugitive")
	TEST_ASSERT(is_leaving(stranded), "Someone who can't reach the lift did not set off for it")
	SShuman_npcs.sweep_leavers()
	for(var/mob/living/carbon/human/npc/walker as anything in walkers)
		TEST_ASSERT(QDELETED(walker), "[walker] was still there after walking out")

	// A decoy sitting at the bar gets up to go
	var/datum/criminal_bounty/outpost_test/seated = make_posting(run_loc_floor_bottom_left)
	TEST_ASSERT(seated.setup_outpost_blend(TRUE), "The third posting could not be set up to blend in")
	var/mob/living/carbon/human/npc/bounty_criminal/decoy/sitter = decoys_of(seated)[1]
	var/obj/structure/chair/stool/bar/stool = allocate(/obj/structure/chair/stool/bar, get_turf(sitter))
	TEST_ASSERT(sitter.ai_sit_on(stool), "Test fixture: the decoy would not sit")
	seated.outpost_release_site()
	TEST_ASSERT(!sitter.buckled, "A decoy stayed in its seat when it was meant to leave")
	TEST_ASSERT(is_leaving(sitter), "A decoy that got up did not set off")

/// Each trader outpost map has one wanted board, on a wall of its concourse
/datum/unit_test/voidcrew_bounty_outpost_maps

/datum/unit_test/voidcrew_bounty_outpost_maps/Run()
	for(var/outpost_type in list(
		/obj/structure/overmap/trader_outpost/general,
		/obj/structure/overmap/trader_outpost/outfitter,
		/obj/structure/overmap/trader_outpost/black_market,
	))
		var/obj/structure/overmap/trader_outpost/outpost = allocate(outpost_type)
		TEST_ASSERT(outpost.load_level(), "[outpost_type]'s interior failed to load")
		var/turf/bottom_left = outpost.template_bottom_left
		var/turf/top_right = locate(bottom_left.x + outpost.outpost_template.width - 1, bottom_left.y + outpost.outpost_template.height - 1, bottom_left.z)
		var/list/boards = list()
		for(var/turf/interior as anything in block(bottom_left, top_right))
			for(var/obj/structure/bounty_wanted_board/found in interior)
				boards += found
		TEST_ASSERT_EQUAL(length(boards), 1, "[outpost_type] has [length(boards)] wanted boards, not one")
		var/obj/structure/bounty_wanted_board/board = boards[1]
		TEST_ASSERT(isopenturf(board.loc), "[outpost_type]'s wanted board is not on a floor")
		TEST_ASSERT(isclosedturf(get_step(board, board.dir)), "[outpost_type]'s wanted board is not hung on a wall")
		TEST_ASSERT(HAS_TRAIT(board, "outpost_property"), "[outpost_type]'s wanted board is not outpost property") // TRAIT_OUTPOST_PROPERTY
		// The customers' floor reaches the board, and the spawn picker finds room for everyone
		TEST_ASSERT(length(bounty_outpost_public_floor(outpost)) > 50, "[outpost_type] has almost no customers' floor from its lift")
		TEST_ASSERT_EQUAL(length(bounty_outpost_spawn_spots(outpost, 4)), 4, "[outpost_type] has no room for a fugitive and three decoys")
		qdel(outpost)

/// The right warrant: the nearest trader in sight calls out
/datum/unit_test/voidcrew_bounty_outpost/room_reacts

/datum/unit_test/voidcrew_bounty_outpost/room_reacts/Run()
	outpost = make_outpost()
	var/datum/criminal_bounty/outpost_test/posting = make_posting(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/npc/bounty_criminal/fugitive = posting.criminal()
	TEST_ASSERT(posting.setup_outpost_blend(TRUE), "The posting could not be set up to blend in")
	fugitive.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT_NULL(posting.outpost_trader_reacts(fugitive), "A trader reacted with no trader there")
	var/mob/living/basic/outpost_trader/far = allocate(/mob/living/basic/outpost_trader, run_loc_floor_top_right)
	var/mob/living/basic/outpost_trader/near = allocate(/mob/living/basic/outpost_trader, locate(run_loc_floor_bottom_left.x + 1, run_loc_floor_bottom_left.y + 1, run_loc_floor_bottom_left.z))
	far.outpost = outpost
	near.outpost = outpost
	TEST_ASSERT_EQUAL(posting.outpost_trader_reacts(fugitive), near, "The nearest trader didn't react to the fugitive being exposed")

/// The wanted board: the ship card's own place words (a lair's real name, BUG-5), "Seen on this concourse" for a fugitive here (P11), and the vouchers and "Wanted dead" (BUG-13)
/datum/unit_test/voidcrew_bounty_outpost/board_card

/datum/unit_test/voidcrew_bounty_outpost/board_card/Run()
	outpost = make_outpost()
	var/obj/structure/bounty_wanted_board/board = allocate(/obj/structure/bounty_wanted_board)
	var/datum/criminal_bounty/outpost_test/here = make_posting()
	here.board_vouchers = 2
	var/datum/criminal_bounty/outpost_test/elsewhere = make_posting()
	elsewhere.site_ref = WEAKREF(allocate(/obj/structure/overmap/trader_outpost/general))
	var/datum/criminal_bounty/kill_only/lair = new
	allocated += lair
	lair.record = bounty_kill_record("Test Don", "running a test club", MALE, 5000, "mugshot")
	lair.placement_kind = "ruin" // BOUNTY_PLACEMENT_RUIN
	lair.board_site_name = "Club Test"
	lair.value = 5000
	lair.expires_at = world.time + 10 MINUTES
	GLOB.criminal_bounties += lair

	var/list/entries = list()
	for(var/list/entry as anything in board.outpost_board_entries())
		entries[entry["id"]] = entry
	var/list/here_entry = entries[here.record.id]
	var/list/elsewhere_entry = entries[elsewhere.record.id]
	var/list/lair_entry = entries[lair.record.id]
	TEST_ASSERT_EQUAL(here_entry?["place"], "Seen on this concourse", "A fugitive on this concourse isn't marked as seen here: [here_entry?["place"]]")
	TEST_ASSERT(elsewhere_entry?["place"] != "Seen on this concourse", "A fugitive at another outpost is marked as seen here")
	TEST_ASSERT_EQUAL(here_entry?["vouchers"], 2, "The board doesn't show the vouchers")
	TEST_ASSERT_EQUAL(here_entry?["terms"], "Wanted alive", "A live bounty reads as [here_entry?["terms"]]")
	TEST_ASSERT_EQUAL(lair_entry?["terms"], "Wanted dead", "A kill-only bounty reads as [lair_entry?["terms"]]")
	TEST_ASSERT(findtext(lair_entry?["place"], "Club Test"), "The board doesn't name the lair: [lair_entry?["place"]]")
	TEST_ASSERT(!findtext(lair_entry?["place"], "encrypted signal"), "The board calls a lair an encrypted signal")
	lair.close("admin") // BOUNTY_CLOSE_ADMIN
