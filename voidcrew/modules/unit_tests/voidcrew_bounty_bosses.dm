/**
 * Bounty hunting: P4 bosses's tests, for voidcrew/modules/bounties/bounty_boss.dm and bounty_boss_kits.dm.
 *
 * Owner: P4 bosses. Do not edit this file outside that package. Fork defines are included after the
 * tests, so a test uses the literal value with a comment naming the define. Every test calls the
 * boss's procs directly with the mob already in place; none waits on a timer or an AI walk.
 *
 * The bosses are real humans (phase D of the human NPC migration): these tests check that they wear
 * and carry real gear, that their fire, blasts and knife reach people through tg's own paths whatever
 * state those people are in, that their wind-ups stop for tg's states, and that their AI reads real
 * state (worn out, the stimulant, the posse's reinforcements).
 */

/// Shared helpers; not a test itself
/datum/unit_test/voidcrew_bounty_boss
	abstract_type = /datum/unit_test/voidcrew_bounty_boss
	/// Turfs a test changed, put back to plain floor when it ends
	var/list/turf/changed_turfs = list()
	/// Turf -> the area it had before a test moved it into a ship's area
	var/list/original_areas = list()
	/// Areas a test made
	var/list/test_areas = list()

/datum/unit_test/voidcrew_bounty_boss/Destroy()
	for(var/turf/changed as anything in changed_turfs)
		changed.ChangeTurf(/turf/open/floor/iron)
	changed_turfs = null
	for(var/turf/moved as anything in original_areas)
		moved.change_area(get_area(moved), original_areas[moved])
	original_areas = null
	QDEL_LIST(test_areas)
	return ..()

/// The floor `dx`, `dy` tiles from the test room's bottom-left corner (the room is 5x5)
/datum/unit_test/voidcrew_bounty_boss/proc/spot(dx, dy)
	return locate(run_loc_floor_bottom_left.x + dx, run_loc_floor_bottom_left.y + dy, run_loc_floor_bottom_left.z)

/// Changes `where` to `new_type`, to be put back when the test ends
/datum/unit_test/voidcrew_bounty_boss/proc/change_turf(turf/where, new_type)
	changed_turfs |= where
	return where.ChangeTurf(new_type)

/// Makes `where` part of a ship that isn't the boss's (a player's), to be put back when the test ends
/datum/unit_test/voidcrew_bounty_boss/proc/make_ship_tile(turf/where)
	var/area/shuttle/ship_area = new()
	test_areas += ship_area
	original_areas[where] = get_area(where)
	where.change_area(get_area(where), ship_area)
	return where

/// A hunter at `where`: a human with a mind, as a player would be
/datum/unit_test/voidcrew_bounty_boss/proc/hunter_at(turf/where)
	var/mob/living/carbon/human/consistent/hunter = allocate(/mob/living/carbon/human/consistent, where)
	hunter.mind_initialize()
	return hunter

/// Puts `person` into crit with real damage (soft crit: health 100 - 120 = -20)
/datum/unit_test/voidcrew_bounty_boss/proc/put_in_crit(mob/living/person)
	person.adjustBruteLoss(120)
	return person.stat != CONSCIOUS && person.stat != DEAD

/// A Ripley at `where` with `pilot` in it
/datum/unit_test/voidcrew_bounty_boss/proc/mech_with(turf/where, mob/living/pilot)
	var/obj/vehicle/sealed/mecha/ripley/mech = allocate(/obj/vehicle/sealed/mecha/ripley, where)
	pilot.forceMove(mech)
	mech.add_occupant(pilot, VEHICLE_CONTROL_DRIVE)
	return mech

/// `hunter` hits `boss`, as far as its posse is concerned: onto its grudge list, then into the posse
/datum/unit_test/voidcrew_bounty_boss/proc/posse_member(mob/living/carbon/human/npc/bounty_criminal/boss/boss, mob/living/hunter)
	boss.body_add_grudge(hunter)
	return boss.boss_engage(hunter)

/// The ability of `ability_type` that `boss` has
/datum/unit_test/voidcrew_bounty_boss/proc/ability_of(mob/living/carbon/human/npc/bounty_criminal/boss/boss, ability_type)
	return locate(ability_type) in boss.boss_abilities

/// Ready for another ability straight away: no gap, no cooldowns
/datum/unit_test/voidcrew_bounty_boss/proc/ready(mob/living/carbon/human/npc/bounty_criminal/boss/boss)
	boss.boss_next_ability_at = 0
	for(var/datum/action/cooldown/ability as anything in boss.boss_abilities)
		ability.next_use_time = 0

/// Ready to click again: no click or attack cooldown left
/datum/unit_test/voidcrew_bounty_boss/proc/ready_hands(mob/living/carbon/human/npc/bounty_criminal/boss/boss)
	boss.next_move = 0
	boss.next_click = 0

/// Telegraph marks on the tiles around `center`
/datum/unit_test/voidcrew_bounty_boss/proc/marks_near(atom/center, radius = 1)
	. = 0
	for(var/turf/spot as anything in RANGE_TURFS(radius, center))
		for(var/obj/effect/temp_visual/bounty_boss_mark/mark in spot)
			.++

/// Whether anything dense but mobs stands on `where`
/datum/unit_test/voidcrew_bounty_boss/proc/blocked(turf/where)
	for(var/obj/thing in where)
		if(thing.density)
			return TRUE
	return FALSE

/// How many of `item_type` `holder` carries anywhere on it
/datum/unit_test/voidcrew_bounty_boss/proc/carried(mob/living/holder, item_type)
	return length(holder.get_all_contents_type(item_type))

// ===== EACH KIT IS A REAL HUMAN IN REAL GEAR, AND GOES CLEANLY =====

/datum/unit_test/voidcrew_bounty_boss/kits

/datum/unit_test/voidcrew_bounty_boss/kits/Run()
	var/list/kits = list(
		/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut = "juggernaut", // BOUNTY_KIT_JUGGERNAUT
		/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac = "pyromaniac", // BOUNTY_KIT_PYROMANIAC
		/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist = "demolitionist", // BOUNTY_KIT_DEMOLITIONIST
		/mob/living/carbon/human/npc/bounty_criminal/boss/ghost = "ghost", // BOUNTY_KIT_GHOST
		/mob/living/carbon/human/npc/bounty_criminal/boss/heavy = "heavy", // BOUNTY_KIT_HEAVY
	)
	for(var/kit_type in kits)
		var/mob/living/carbon/human/npc/bounty_criminal/boss/boss = allocate(kit_type)
		TEST_ASSERT(ishuman(boss), "[kit_type] isn't a real human")
		TEST_ASSERT_EQUAL(boss.boss_kit, kits[kit_type], "[kit_type] has the wrong kit")
		TEST_ASSERT_EQUAL(length(boss.boss_abilities), 2, "[kit_type] doesn't have its two abilities")
		TEST_ASSERT(istype(boss.ai_controller, /datum/ai_controller/basic_controller/bounty_boss), "[kit_type] doesn't have the boss AI")
		TEST_ASSERT_EQUAL(boss.npc_rank, 2, "[kit_type] isn't ranked a boss") // HUMAN_NPC_RANK_BOSS
		// Toughness is armour and physiology, never health (defaults 1.5).
		TEST_ASSERT_EQUAL(boss.maxHealth, 100, "[kit_type] has a health pool of [boss.maxHealth]") // MAX_LIVING_HEALTH
		TEST_ASSERT(abs(boss.physiology.brute_mod - 0.6) < 0.01, "[kit_type] takes [boss.physiology.brute_mod] brute, not 0.6") // BOUNTY_BOSS_DAMAGE_TAKEN
		TEST_ASSERT(abs(boss.physiology.burn_mod - 0.6) < 0.01, "[kit_type] takes [boss.physiology.burn_mod] burn, not 0.6")
		TEST_ASSERT(boss.status_flags & CANSTUN, "[kit_type] can't be stunned")
		TEST_ASSERT(boss.status_flags & CANKNOCKDOWN, "[kit_type] can't be knocked down")
		// Its stimulants and a bruise pack, carried for real.
		TEST_ASSERT_EQUAL(carried(boss, /obj/item/reagent_containers/hypospray/medipen/stimpack), 2, "[kit_type] doesn't carry its two stimulants") // BOUNTY_BOSS_STIMULANTS
		TEST_ASSERT(carried(boss, /obj/item/stack/medical/bruise_pack) >= 1, "[kit_type] carries nothing to patch itself up with")
		TEST_ASSERT(boss.boss_gear_text(), "[kit_type] has no gear line on examine")
		var/list/abilities = boss.boss_abilities.Copy()
		qdel(boss)
		TEST_ASSERT(QDELETED(boss), "[kit_type] didn't delete")
		for(var/datum/ability as anything in abilities)
			TEST_ASSERT(QDELETED(ability), "[kit_type]'s [ability.type] outlived it")

	// The Juggernaut: riot armour, and a real gene for its size (CB-5, CB-21).
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/jugg = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut)
	TEST_ASSERT(istype(jugg.wear_suit, /obj/item/clothing/suit/armor/riot), "The Juggernaut isn't wearing riot armour")
	TEST_ASSERT(istype(jugg.head, /obj/item/clothing/head/helmet/toggleable/riot), "The Juggernaut isn't wearing a riot helmet")
	TEST_ASSERT(HAS_TRAIT(jugg, TRAIT_GIANT), "The Juggernaut isn't a giant")
	TEST_ASSERT_NOTNULL(jugg.dna.get_mutation(/datum/mutation/gigantism), "The Juggernaut's size isn't the gigantism gene")

	// The Pyromaniac: its fire suit and helmet keep fire off it, not a trait (CB-7). Its torch is a real one, lit.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/pyro = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac)
	TEST_ASSERT(!HAS_TRAIT(pyro, TRAIT_NOFIRE), "The Pyromaniac is fireproof by a trait")
	TEST_ASSERT(!HAS_TRAIT(pyro, TRAIT_RESISTHEAT), "The Pyromaniac is heat-proof by a trait")
	TEST_ASSERT(istype(pyro.wear_suit, /obj/item/clothing/suit/utility/fire/firefighter), "The Pyromaniac isn't wearing a firefighter suit")
	TEST_ASSERT(istype(pyro.head, /obj/item/clothing/head/utility/hardhat/red), "The Pyromaniac isn't wearing a firefighter helmet")
	TEST_ASSERT(pyro.get_thermal_protection() >= FIRE_SUIT_MAX_TEMP_PROTECT, "The Pyromaniac's gear doesn't keep the fire off it")
	var/obj/item/flashlight/flare/torch/torch = locate() in pyro.held_items
	TEST_ASSERT_NOTNULL(torch, "The Pyromaniac holds no torch")
	TEST_ASSERT(torch.light_on && torch.damtype == BURN, "The Pyromaniac's torch isn't lit")

	// The Demolitionist: a hard hat, and its crowbar in its bag until the fight starts.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist/demo = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist)
	TEST_ASSERT(istype(demo.head, /obj/item/clothing/head/utility/hardhat), "The Demolitionist isn't wearing a hard hat")
	TEST_ASSERT(istype(demo.belt, /obj/item/storage/belt/bandolier), "The Demolitionist has no bandolier")
	var/obj/item/crowbar/large/crowbar = locate() in demo.get_all_contents_type(/obj/item/crowbar/large)
	TEST_ASSERT_NOTNULL(crowbar, "The Demolitionist carries no crowbar")
	TEST_ASSERT(!demo.is_holding(crowbar), "The Demolitionist has its crowbar out before any fight")

	// The Ghost: its hood up, its knife in a pocket, and real chrome for its quickness (OC-6 ruling).
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/ghost = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/ghost)
	TEST_ASSERT(istype(ghost.head, /obj/item/clothing/head/hooded/chaplain_hood), "The Ghost's hood isn't up")
	var/obj/item/knife/combat/knife = locate() in ghost.get_all_contents_type(/obj/item/knife/combat)
	TEST_ASSERT_NOTNULL(knife, "The Ghost carries no combat knife")
	TEST_ASSERT(!ghost.is_holding(knife), "The Ghost has its knife out before any fight")
	TEST_ASSERT_NOTNULL(locate(/obj/item/organ/cyberimp/cyberware/slipwire) in ghost.organs, "The Ghost has no Slipwire")
	TEST_ASSERT_NOTNULL(locate(/obj/item/organ/cyberimp/cyberware/cascade) in ghost.organs, "The Ghost has no Cascade lattice")

	// The Heavy: SWAT armour, a real L6 with a belt in it, a spare box and two barrier grenades (CB-13, CB-26).
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/heavy = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/heavy)
	TEST_ASSERT(istype(heavy.wear_suit, /obj/item/clothing/suit/armor/swat), "The Heavy isn't wearing SWAT armour")
	TEST_ASSERT(istype(heavy.head, /obj/item/clothing/head/helmet/swat), "The Heavy isn't wearing a SWAT helmet")
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = heavy.boss_gun()
	TEST_ASSERT_NOTNULL(gun, "The Heavy holds no belt-fed gun")
	TEST_ASSERT(gun.can_shoot(), "The Heavy's gun isn't loaded")
	TEST_ASSERT(!heavy.get_inactive_held_item(), "The Heavy's other hand isn't free to fire")
	TEST_ASSERT_EQUAL(carried(heavy, /obj/item/ammo_box/magazine/m7mm), 2, "The Heavy has no spare box beside the one in its gun")
	TEST_ASSERT_EQUAL(carried(heavy, /obj/item/grenade/barrier/bounty_boss), 2, "The Heavy doesn't carry its two barrier grenades") // BOUNTY_HEAVY_BARRIERS

// ===== WIND-UP BEFORE DAMAGE; TG'S STATES STOP IT (CB-24) =====

/datum/unit_test/voidcrew_bounty_boss/windup

/datum/unit_test/voidcrew_bounty_boss/windup/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/mob/living/carbon/human/consistent/victim = hunter_at(spot(1, 0))
	var/datum/action/cooldown/mob_cooldown/bounty_boss/slam/slam = ability_of(boss, /datum/action/cooldown/mob_cooldown/bounty_boss/slam)
	TEST_ASSERT_NOTNULL(slam, "The Juggernaut has no slam")

	TEST_ASSERT(slam.Trigger(target = victim), "The slam didn't start")
	TEST_ASSERT_EQUAL(boss.boss_busy, "windup", "The slam didn't wind up first")
	TEST_ASSERT(HAS_TRAIT(boss, TRAIT_IMMOBILIZED), "The boss can move while winding up")
	TEST_ASSERT(length(slam.telegraphs), "The slam showed no telegraph")
	TEST_ASSERT(marks_near(boss) >= 4, "The slam didn't mark the floor around the boss")
	TEST_ASSERT_EQUAL(victim.getBruteLoss(), 0, "The slam hurt someone before its wind-up was over")
	TEST_ASSERT(slam.finish_windup(slam.pending_serial), "The slam didn't land when its wind-up ended")
	TEST_ASSERT(victim.getBruteLoss() > 0, "The slam hurt nobody next to the boss")
	TEST_ASSERT_NULL(boss.boss_busy, "The boss is still busy after the slam")
	TEST_ASSERT(!HAS_TRAIT(boss, TRAIT_IMMOBILIZED), "The boss is still stuck after the slam")
	TEST_ASSERT_EQUAL(marks_near(boss), 0, "The slam's telegraph outlived its wind-up")

	var/mob/living/carbon/human/consistent/second = hunter_at(spot(0, 1))

	// Restrained (tg's TRAIT_RESTRAINED): it can't start one.
	ready(boss)
	ADD_TRAIT(boss, TRAIT_RESTRAINED, "bounty_boss_test")
	TEST_ASSERT(!boss.boss_can_act(), "A cuffed boss can act")
	TEST_ASSERT(!slam.IsAvailable(), "A cuffed boss's ability is available")
	TEST_ASSERT(!slam.Trigger(target = second), "A cuffed boss started an ability")
	TEST_ASSERT_NULL(boss.boss_busy, "A cuffed boss began a wind-up")
	REMOVE_TRAIT(boss, TRAIT_RESTRAINED, "bounty_boss_test")

	// Knocked down (tg's Knockdown): it can't start one either.
	boss.Knockdown(5 SECONDS)
	TEST_ASSERT(!slam.IsAvailable(), "A knocked-down boss's ability is available")
	boss.SetKnockdown(0)

	// Cuffed during the wind-up: the telegraph goes and nothing lands.
	ready(boss)
	TEST_ASSERT(slam.Trigger(target = second), "The slam didn't start again")
	var/serial = slam.pending_serial
	ADD_TRAIT(boss, TRAIT_RESTRAINED, "bounty_boss_test")
	TEST_ASSERT(!length(slam.telegraphs), "The telegraph stayed after the boss was cuffed")
	TEST_ASSERT_NULL(boss.boss_busy, "The boss kept winding up after it was cuffed")
	TEST_ASSERT(!slam.finish_windup(serial), "A cancelled wind-up still landed")
	TEST_ASSERT_EQUAL(second.getBruteLoss(), 0, "A cancelled slam hurt someone")
	REMOVE_TRAIT(boss, TRAIT_RESTRAINED, "bounty_boss_test")

	// Stunned during the wind-up (tg's Stun): the same.
	ready(boss)
	TEST_ASSERT(slam.Trigger(target = second), "The slam didn't start a third time")
	serial = slam.pending_serial
	boss.Stun(5 SECONDS)
	TEST_ASSERT_NULL(boss.boss_busy, "The boss kept winding up after it was stunned")
	TEST_ASSERT(!slam.finish_windup(serial), "A stunned boss's wind-up landed")
	boss.SetStun(0)

	// Into crit during the wind-up, by real damage: the same.
	ready(boss)
	TEST_ASSERT(slam.Trigger(target = second), "The slam didn't start a fourth time")
	serial = slam.pending_serial
	TEST_ASSERT(put_in_crit(boss), "Test fixture: the boss isn't in crit")
	TEST_ASSERT(!slam.finish_windup(serial), "A downed boss's wind-up landed")
	TEST_ASSERT_EQUAL(second.getBruteLoss(), 0, "A downed boss's slam hurt someone")

// ===== WHAT IT MAY BREAK, AND HOW (H1, M1, L2) =====

/datum/unit_test/voidcrew_bounty_boss/structures

/datum/unit_test/voidcrew_bounty_boss/structures/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/turf/middle = spot(2, 2)
	change_turf(middle, /turf/closed/wall)
	TEST_ASSERT(boss.boss_may_break(middle), "The boss may not break a plain interior wall")

	// Its wall budget spent: no.
	boss.boss_walls_left = 0
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a wall with no budget left")
	boss.boss_walls_left = 2 // BOUNTY_BOSS_WALL_BUDGET

	// Off its site: no.
	boss.site_bounds = list(run_loc_floor_bottom_left.x, run_loc_floor_bottom_left.y, run_loc_floor_bottom_left.x + 1, run_loc_floor_bottom_left.y + 1, run_loc_floor_bottom_left.z)
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a wall off its site")
	TEST_ASSERT(!boss.boss_environment_allowed(middle), "The boss may damage things off its site")
	boss.site_bounds = null

	// Space on its far side: never.
	var/turf/beside = spot(3, 2)
	change_turf(beside, /turf/open/space/basic)
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a wall with space beside it")

	// An airless room on its far side: never (L2).
	change_turf(beside, /turf/open/floor/iron/airless)
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a wall into an airless room")
	change_turf(beside, /turf/open/floor/iron)

	// Reinforced: no.
	change_turf(middle, /turf/closed/wall/r_wall)
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a reinforced wall")

	// Broken outright, a plain one comes right down, and the budget is spent (M1).
	change_turf(middle, /turf/closed/wall)
	TEST_ASSERT(boss.boss_damage_structure(middle, null, list(4)), "The boss didn't break the wall") // BOUNTY_BOSS_ABILITY_STRUCTURE_CAP
	TEST_ASSERT(!isclosedturf(middle), "The wall is still standing")
	TEST_ASSERT(!blocked(middle), "The broken wall left something in the way")
	TEST_ASSERT_EQUAL(boss.boss_walls_left, 1, "Breaking a wall didn't spend the budget")

	// No budget left, and the wall stands.
	change_turf(middle, /turf/closed/wall)
	boss.boss_walls_left = 0
	TEST_ASSERT(!boss.boss_damage_structure(middle, null, list(4)), "The boss broke a wall past its budget")
	TEST_ASSERT(isclosedturf(middle), "A wall past the budget fell")
	boss.boss_walls_left = 2

	// One use of an ability breaks no more than its cap.
	var/obj/structure/table/table = allocate(/obj/structure/table, spot(0, 3))
	TEST_ASSERT(!boss.boss_damage_structure(table, null, list(0)), "An ability past its cap broke a table")
	TEST_ASSERT(!QDELETED(table), "A table past the cap broke")
	TEST_ASSERT(boss.boss_damage_structure(table, null, list(1)), "The boss didn't break the table")
	TEST_ASSERT(QDELETED(table), "The table survived being broken outright")

	// Broken outright means broken, whatever the armour: a window and a grille go (M1).
	var/obj/structure/window/fulltile/pane = allocate(/obj/structure/window/fulltile, spot(1, 3))
	var/obj/structure/grille/grille = allocate(/obj/structure/grille, spot(1, 3))
	TEST_ASSERT(boss.boss_damage_structure(pane, null, list(4)), "The boss didn't break a plain window")
	TEST_ASSERT(boss.boss_damage_structure(grille, null, list(4)), "The boss didn't break a grille")
	TEST_ASSERT(QDELETED(pane) && QDELETED(grille), "A window or grille survived being broken outright")
	TEST_ASSERT(!blocked(spot(1, 3)), "Something dense is left where the window stood")

	// A door broken outright goes with its frame, so the way really opens (M1).
	var/obj/machinery/door/airlock/door = allocate(/obj/machinery/door/airlock, spot(4, 2))
	boss.boss_walls_left = 0
	TEST_ASSERT(!boss.boss_may_break(door), "The boss may break a door with no budget left")
	boss.boss_walls_left = 1
	TEST_ASSERT(boss.boss_damage_structure(door, null, list(4)), "The boss didn't break an interior door")
	TEST_ASSERT(QDELETED(door), "The door survived being broken outright")
	TEST_ASSERT(!blocked(spot(4, 2)), "The broken door left its frame in the way")
	TEST_ASSERT_EQUAL(boss.boss_walls_left, 0, "Breaking a door didn't spend the budget")

	// Never anything indestructible, and never machines that aren't doors.
	var/obj/structure/table/tough = allocate(/obj/structure/table, spot(3, 3))
	tough.resistance_flags |= INDESTRUCTIBLE
	TEST_ASSERT(!boss.boss_may_break(tough), "The boss may break an indestructible table")
	var/obj/machinery/light/lamp = allocate(/obj/machinery/light, spot(4, 4))
	TEST_ASSERT(!boss.boss_may_break(lamp), "The boss may break a light fixture")

/// A player's ship within 7 tiles shuts down its environment damage there, and it never reaches inside (H1, M2)
/datum/unit_test/voidcrew_bounty_boss/near_ships

/datum/unit_test/voidcrew_bounty_boss/near_ships/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/turf/middle = spot(2, 2)
	change_turf(middle, /turf/closed/wall)
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(4, 4))
	TEST_ASSERT(boss.boss_may_break(middle), "The boss may not break an interior wall before any ship is near")
	TEST_ASSERT(boss.boss_landing_ok(get_turf(hunter)), "The boss may not aim at a hunter before any ship is near")
	TEST_ASSERT(boss.boss_valid_target(hunter), "The boss won't go after a hunter before any ship is near")
	TEST_ASSERT(boss.boss_effect_hits(hunter), "The boss's fire and blasts don't reach a hunter before any ship is near")

	// A ship's tile in the room, within BOUNTY_ENV_SAFE_RANGE (7) of everything here.
	var/turf/ship_floor = make_ship_tile(spot(4, 0))
	TEST_ASSERT(!boss.boss_environment_allowed(middle), "Environment damage is allowed within 7 tiles of a player ship")
	TEST_ASSERT(!boss.boss_may_break(middle), "The boss may break a wall within 7 tiles of a player ship")
	TEST_ASSERT(!boss.boss_landing_ok(get_turf(hunter)), "The boss may aim abilities within 7 tiles of a player ship")
	TEST_ASSERT(!boss.boss_indoor_turf(ship_floor), "A player ship's floor counts as the boss's interior")

	// Standing inside the ship, a hunter is out of its reach altogether.
	hunter.forceMove(ship_floor)
	TEST_ASSERT(!boss.boss_valid_target(hunter), "The boss goes after a hunter inside their ship")
	TEST_ASSERT(!boss.boss_effect_hits(hunter), "The boss's fire and blasts reach inside a ship")
	TEST_ASSERT(!boss.boss_reach_ok(ship_floor), "The boss's fire and blasts may reach inside a ship")

// ===== NEVER THE SAME ABILITY TWICE IN A ROW WHILE ANOTHER IS READY =====

/datum/unit_test/voidcrew_bounty_boss/rotation

/datum/unit_test/voidcrew_bounty_boss/rotation/Run()
	// Two abilities both worth using: they alternate.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/pyro = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac, spot(0, 0))
	var/mob/living/carbon/human/consistent/near = hunter_at(spot(2, 0))
	var/last_type
	for(var/i in 1 to 20)
		var/datum/action/cooldown/mob_cooldown/bounty_boss/picked = pyro.boss_choose_ability(near)
		TEST_ASSERT_NOTNULL(picked, "The Pyromaniac picked nothing with both its abilities ready")
		TEST_ASSERT(picked.type != last_type, "The Pyromaniac picked [picked.type] twice in a row")
		last_type = picked.type
		pyro.boss_last_ability = picked.type

	// Starting an ability is what the rotation remembers.
	var/datum/action/cooldown/mob_cooldown/bounty_boss/flamer/flamer = ability_of(pyro, /datum/action/cooldown/mob_cooldown/bounty_boss/flamer)
	TEST_ASSERT(flamer.Trigger(target = near), "The flamer didn't start")
	TEST_ASSERT_EQUAL(pyro.boss_last_ability, flamer.type, "Starting the flamer wasn't remembered")
	pyro.boss_interrupt()
	ready(pyro)
	var/datum/action/cooldown/mob_cooldown/bounty_boss/next = pyro.boss_choose_ability(near)
	TEST_ASSERT(next && next.type != flamer.type, "The flamer came up again straight after the flamer")

	// The rotation as shipped (BOUNTY_BOSS_STRICT_ROTATION FALSE): the last ability repeats only when no other is off cooldown.
	TEST_ASSERT(!pyro.boss_strict_rotation, "The shipped rotation is strict")
	var/datum/action/cooldown/mob_cooldown/bounty_boss/molotov/molotov = ability_of(pyro, /datum/action/cooldown/mob_cooldown/bounty_boss/molotov)
	ready(pyro)
	pyro.boss_last_ability = flamer.type
	molotov.next_use_time = world.time + 100 SECONDS
	var/datum/action/cooldown/mob_cooldown/bounty_boss/again = pyro.boss_choose_ability(near)
	TEST_ASSERT(again && again.type == flamer.type, "The flamer didn't repeat with the molotov on cooldown")
	molotov.next_use_time = 0
	for(var/i in 1 to 10)
		var/datum/action/cooldown/mob_cooldown/bounty_boss/other = pyro.boss_choose_ability(near)
		TEST_ASSERT(other && other.type == molotov.type, "The flamer repeated while the molotov was off cooldown")

	// Only one ability worth using: it repeats; strictly, nothing (the hoarfrost rotation).
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 3))
	var/mob/living/carbon/human/consistent/far = hunter_at(spot(3, 3))
	var/datum/action/cooldown/mob_cooldown/bounty_boss/first = boss.boss_choose_ability(far)
	TEST_ASSERT(istype(first, /datum/action/cooldown/mob_cooldown/bounty_boss/charge), "The Juggernaut didn't choose to charge someone three tiles off")
	boss.boss_last_ability = first.type
	TEST_ASSERT_NOTNULL(boss.boss_choose_ability(far), "The rotation won't reuse the only ability ready")
	boss.boss_strict_rotation = TRUE
	TEST_ASSERT_NULL(boss.boss_choose_ability(far), "The strict rotation chose the same ability twice in a row")

// ===== FIRE IS TG'S FIRE, ON ANYONE IT CATCHES (CB-8, CB-11) =====

/datum/unit_test/voidcrew_bounty_boss/fire

/datum/unit_test/voidcrew_bounty_boss/fire/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac/pyro = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/pyromaniac, spot(0, 2))
	var/mob/living/carbon/human/consistent/walker = hunter_at(spot(2, 2))
	var/mob/living/carbon/human/consistent/downed = hunter_at(spot(3, 2))
	TEST_ASSERT(put_in_crit(downed), "Test fixture: the second hunter isn't in crit")

	var/obj/effect/bounty_boss_fire_pool/pool = new(spot(2, 2), list(spot(0, 2), spot(2, 2), spot(3, 2)), 4 SECONDS, pyro, 10, 4)
	TEST_ASSERT(!QDELETED(pool), "The fire went out at once")
	TEST_ASSERT(pool in GLOB.bounty_boss_fire_pools, "The fire isn't counted")
	TEST_ASSERT(walker.getFireLoss() > 0, "The fire's landing didn't burn someone standing in it")
	TEST_ASSERT(walker.fire_stacks > 0, "The fire put no fire stacks on someone standing in it")
	TEST_ASSERT(walker.on_fire, "The fire didn't set someone standing in it alight")
	TEST_ASSERT(downed.fire_stacks > 0, "The fire put no fire stacks on someone in crit")
	TEST_ASSERT(downed.on_fire, "The fire didn't set someone in crit alight")
	TEST_ASSERT_EQUAL(pyro.getFireLoss(), 0, "The Pyromaniac's own fire burned it")
	TEST_ASSERT(!pyro.on_fire, "The Pyromaniac's own fire set it alight")

	// Every second in the flames adds to the fire, standing or not.
	var/stacks_before = downed.fire_stacks
	pool.scorch()
	TEST_ASSERT(downed.fire_stacks > stacks_before, "Lying in the flames added no fire stacks")

	// Once lit, it is tg's fire: putting it out is tg's too.
	walker.extinguish_mob()
	TEST_ASSERT(!walker.on_fire, "A boss's fire couldn't be put out the tg way")
	downed.extinguish_mob()

	pool.burn_out()
	TEST_ASSERT(QDELETED(pool), "The fire didn't go out")
	TEST_ASSERT(!(pool in GLOB.bounty_boss_fire_pools), "A fire that went out is still counted")

	// With its boss gone, it still burns anyone not on the boss's side.
	var/obj/effect/bounty_boss_fire_pool/orphan = new(spot(2, 2), list(spot(2, 2)), 4 SECONDS, pyro)
	qdel(pyro)
	walker.set_fire_stacks(0)
	orphan.scorch()
	TEST_ASSERT(walker.on_fire, "A fire whose boss is gone didn't burn anyone")
	walker.extinguish_mob()
	qdel(orphan)

	// The fire cap.
	var/list/pools = list()
	for(var/i in 1 to 17)
		pools += new /obj/effect/bounty_boss_fire_pool(spot(i % 5, 1), list(spot(i % 5, 1)), 4 SECONDS)
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_fire_pools), 16, "The fire pool cap didn't hold") // BOUNTY_BOSS_FIRE_POOL_CAP
	for(var/obj/effect/bounty_boss_fire_pool/extra_pool as anything in pools)
		if(!QDELETED(extra_pool))
			qdel(extra_pool)
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_fire_pools), 0, "Deleted fire pools are still counted")
	walker.extinguish_mob()
	downed.extinguish_mob()

// ===== BLASTS ARE TG'S LIGHT EXPLOSION, ON ANYONE THEY CATCH (CB-10, CB-11) =====

/datum/unit_test/voidcrew_bounty_boss/blasts
	/// Severity of the last explosion that reached the watched victim
	var/blast_severity = 0

/datum/unit_test/voidcrew_bounty_boss/blasts/proc/on_ex_act(datum/source, severity, target, origin)
	SIGNAL_HANDLER
	blast_severity = severity

/datum/unit_test/voidcrew_bounty_boss/blasts/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist/demo = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/demolitionist, spot(2, 4))
	var/mob/living/carbon/human/consistent/caught = hunter_at(spot(4, 4))
	TEST_ASSERT(put_in_crit(caught), "Test fixture: the hunter isn't in crit")
	RegisterSignal(caught, COMSIG_ATOM_EX_ACT, PROC_REF(on_ex_act))
	var/obj/effect/bounty_boss_explosive/grenade = new(spot(3, 4), demo)
	TEST_ASSERT(grenade in GLOB.bounty_boss_explosives, "The grenade isn't counted")
	var/before = caught.getBruteLoss()
	TEST_ASSERT_EQUAL(blast_severity, 0, "The grenade went off before its fuse ran out")
	grenade.detonate()
	TEST_ASSERT_EQUAL(blast_severity, EXPLODE_LIGHT, "The grenade's blast didn't reach someone in crit as tg's light explosion")
	TEST_ASSERT(caught.getBruteLoss() > before, "The grenade's blast didn't hurt someone in crit next to it")
	TEST_ASSERT_EQUAL(demo.getBruteLoss(), 0, "The grenade hurt the Demolitionist who threw it")
	TEST_ASSERT(QDELETED(grenade), "The grenade is still there after going off")
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_explosives), 0, "A spent grenade is still counted")
	UnregisterSignal(caught, COMSIG_ATOM_EX_ACT)

	// A blast never goes through a wall.
	var/mob/living/carbon/human/consistent/behind = hunter_at(spot(0, 0))
	change_turf(spot(1, 0), /turf/closed/wall/r_wall)
	var/obj/effect/bounty_boss_explosive/walled = new(spot(2, 0), demo)
	walled.detonate()
	TEST_ASSERT_EQUAL(behind.getBruteLoss(), 0, "A blast reached through a wall")

	// The explosive cap.
	var/list/bombs = list()
	for(var/i in 1 to 17)
		bombs += new /obj/effect/bounty_boss_explosive(spot(i % 5, 1))
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_explosives), 16, "The explosive cap didn't hold") // BOUNTY_BOSS_EXPLOSIVE_CAP
	for(var/obj/effect/bounty_boss_explosive/extra_bomb as anything in bombs)
		if(!QDELETED(extra_bomb))
			qdel(extra_bomb)
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_explosives), 0, "Deleted explosives are still counted")

	// A breaching charge opens an airlock for good (M1).
	demo.boss_walls_left = 2 // BOUNTY_BOSS_WALL_BUDGET
	var/obj/machinery/door/airlock/door = allocate(/obj/machinery/door/airlock, spot(2, 3))
	var/obj/effect/bounty_boss_explosive/breach/charge = new(spot(2, 3), demo, door)
	charge.detonate()
	TEST_ASSERT(QDELETED(door), "The breaching charge left the airlock standing")
	TEST_ASSERT(!blocked(spot(2, 3)), "The breached airlock left something in the way")
	TEST_ASSERT_EQUAL(demo.boss_walls_left, 1, "Breaching the airlock didn't spend the budget")

// ===== ITS CHOICE OF TARGET SPARES THE DOWNED; ITS EFFECTS DON'T (CB-11) =====

/datum/unit_test/voidcrew_bounty_boss/downed_hunters

/datum/unit_test/voidcrew_bounty_boss/downed_hunters/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/mob/living/carbon/human/consistent/victim = hunter_at(spot(1, 0))
	TEST_ASSERT(boss.boss_valid_target(victim), "The boss won't go after a hunter on their feet")
	TEST_ASSERT(put_in_crit(victim), "Test fixture: the hunter isn't down")
	TEST_ASSERT(!boss.boss_valid_target(victim), "The boss chooses to go after a downed hunter")
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(/datum/targeting_strategy/basic/human_npc/bounty_boss)
	TEST_ASSERT(!strategy.can_attack(boss, victim, 9), "The boss's targeting picks a downed hunter")
	// What its abilities catch is whoever is there.
	TEST_ASSERT(boss.boss_effect_hits(victim), "The boss's fire and blasts skip a downed hunter")
	TEST_ASSERT(victim in boss.boss_victims_on(list(get_turf(victim))), "Area abilities skip a downed hunter")
	var/datum/action/cooldown/mob_cooldown/bounty_boss/slam/slam = ability_of(boss, /datum/action/cooldown/mob_cooldown/bounty_boss/slam)
	var/mob/living/carbon/human/consistent/standing = hunter_at(spot(0, 1))
	var/before = victim.getBruteLoss()
	TEST_ASSERT(slam.Trigger(target = standing), "The slam didn't start")
	TEST_ASSERT(slam.finish_windup(slam.pending_serial), "The slam didn't land")
	TEST_ASSERT(victim.getBruteLoss() > before, "The slam passed over a downed hunter beside the boss")
	// Never its own side.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/friend = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(1, 1))
	TEST_ASSERT(!boss.boss_effect_hits(friend), "The boss's fire and blasts catch another criminal")

// ===== THE POSSE: ONE MORE COMPANION PER EXTRA HUNTER (OC-8, CB-1) =====

/datum/unit_test/voidcrew_bounty_boss/posse

/datum/unit_test/voidcrew_bounty_boss/posse/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/mob/living/carbon/human/consistent/first = hunter_at(spot(4, 4))
	var/mob/living/carbon/human/consistent/second = hunter_at(spot(3, 4))
	var/mob/living/carbon/human/consistent/third = hunter_at(spot(2, 4))
	var/mob/living/carbon/human/consistent/fourth = hunter_at(spot(1, 4))
	var/mob/living/carbon/human/consistent/fifth = hunter_at(spot(0, 4))
	boss.boss_hostile = TRUE

	// Only hunters on its grudge list (or hunting its bounty) count.
	TEST_ASSERT(!boss.boss_engage(first), "A hunter who never touched it joined the posse")
	TEST_ASSERT(posse_member(boss, first), "The first hunter didn't join the posse")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 0, "One hunter brought in a companion")
	TEST_ASSERT(!boss.boss_engage(first), "The same hunter joined twice")
	TEST_ASSERT_EQUAL(boss.maxHealth, 100, "The posse changed the boss's health")

	// The second hunter owes one companion, and it sizes them up in its kit's own words (BUG-2).
	var/datum/component/bounty_identity_voice/voice = boss.LoadComponent(/datum/component/bounty_identity_voice)
	voice.line_cooldown = 0
	voice.last_line = null
	TEST_ASSERT(posse_member(boss, second), "The second hunter didn't join")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 1, "Two hunters didn't call in a companion")
	TEST_ASSERT_NOTNULL(boss.boss_reinforce_timer, "The companion owed wasn't scheduled")
	TEST_ASSERT(voice.last_line in bounty_identity_strings("lines")["juggernaut_posse"]["any"], "Sizing up two hunters, the Juggernaut said [voice.last_line || "nothing"]")

	// Someone with no mind isn't a hunter.
	var/mob/living/carbon/human/consistent/bystander = allocate(/mob/living/carbon/human/consistent, spot(4, 3))
	boss.body_add_grudge(bystander)
	TEST_ASSERT(!boss.boss_engage(bystander), "A mindless bystander joined the posse")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 1, "A mindless bystander called in a companion")

	// One per hunter beyond the first, up to BOUNTY_BOSS_REINFORCEMENTS_MAX (3).
	TEST_ASSERT(posse_member(boss, third), "The third hunter didn't join")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 2, "Three hunters didn't call in two companions")
	TEST_ASSERT(posse_member(boss, fourth), "The fourth hunter didn't join")
	TEST_ASSERT(posse_member(boss, fifth), "The fifth hunter didn't join")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 3, "Five hunters called in more than three companions")

	// Each one called is a real human NPC queued through the spawn queue, joined to the boss.
	var/datum/human_npc_order/order = boss.boss_send_reinforcement(spot(4, 0))
	TEST_ASSERT(istype(order, /datum/human_npc_order), "Calling a companion in queued no human NPC")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_sent, 1, "The companion called in wasn't counted")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 2, "The companion called in is still owed")
	// Cancelled here, so no body turns up after the test.
	qdel(order)

	// Companions already sent count: a posse that shrinks and grows again owes nothing new.
	boss.boss_reinforcements_owed = 0
	boss.boss_reinforcements_sent = 3
	boss.boss_engaged.Cut()
	posse_member(boss, first)
	posse_member(boss, second)
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 0, "Companions already sent were called in again")

	// They come in a way off, on open ground (who can see the spot is read from players with clients, and tests have none).
	var/turf/arrival = boss.boss_reinforcement_spot()
	if(arrival)
		TEST_ASSERT(get_dist(arrival, boss) >= 5, "A companion would come in [get_dist(arrival, boss)] tiles from the boss") // BOUNTY_BOSS_REINFORCE_MIN_DIST
		TEST_ASSERT(!arrival.is_blocked_turf(), "A companion would come in on a blocked tile")

	// Dead, it calls nobody.
	boss.boss_reinforcements_owed = 1
	boss.boss_schedule_reinforcement()
	boss.death()
	TEST_ASSERT_NULL(boss.boss_reinforce_timer, "A dead boss still calls in companions")
	TEST_ASSERT_EQUAL(boss.boss_reinforcements_owed, 0, "A dead boss still owes companions")

	// Confronted: it turns on whoever confronted it.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/other = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 2))
	other.on_confronted(first)
	TEST_ASSERT(other.boss_hostile, "A confronted boss didn't turn hostile")
	TEST_ASSERT(other.body_has_grudge(first), "A confronted boss has no grudge against who confronted it")
	TEST_ASSERT_EQUAL(other.ai_controller?.blackboard[BB_BASIC_MOB_CURRENT_TARGET], first, "A confronted boss isn't going after who confronted it")

// ===== WORN OUT AND THE STIMULANT: REAL STATE, REAL PENS (CB-2, CB-4, CR-4) =====

/datum/unit_test/voidcrew_bounty_boss/stamina

/datum/unit_test/voidcrew_bounty_boss/stamina/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/mob/living/carbon/human/consistent/hunter = hunter_at(spot(3, 0))
	var/datum/ai_controller/controller = boss.ai_controller
	boss.body_add_grudge(hunter)
	boss.boss_turn_hostile(hunter)
	TEST_ASSERT(boss.boss_hostile, "Test fixture: the boss didn't turn hostile")

	// Stamina works on it from the first hit (CB-2): no fresh immunity.
	boss.apply_damage(30, STAMINA)
	TEST_ASSERT(boss.getStaminaLoss() >= 30, "A fresh boss shrugged off stamina damage")

	// The fight starting, it injects a real stimulant it carries.
	var/datum/ai_planning_subtree/bounty_boss_stimulant/stimulant = new
	TEST_ASSERT_EQUAL(stimulant.SelectBehaviors(controller, 1), SUBTREE_RETURN_FINISH_PLANNING, "The boss didn't reach for its stimulant as its fight started")
	TEST_ASSERT_EQUAL(boss.boss_stimulants_used, 1, "The boss didn't count its first stimulant")
	var/datum/ai_behavior/human_npc_treat_self/treat = GET_AI_BEHAVIOR(/datum/ai_behavior/human_npc_treat_self)
	TEST_ASSERT(controller.current_behaviors[treat], "The boss didn't plan to use its stimulant")
	var/finished = FALSE
	for(var/step in 1 to 10)
		ready_hands(boss)
		var/result = treat.perform(1, controller, "human_npc_treat_item") // BB_HUMAN_NPC_TREAT_ITEM
		TEST_ASSERT(!(result & AI_BEHAVIOR_FAILED), "Using the stimulant failed at step [step]")
		if(result & AI_BEHAVIOR_SUCCEEDED)
			finished = TRUE
			break
	TEST_ASSERT(finished, "The boss never finished using its stimulant")
	TEST_ASSERT(boss.reagents.has_reagent(/datum/reagent/medicine/ephedrine), "The stimulant isn't in the boss's blood")
	TEST_ASSERT_NOTNULL(bounty_ai_find_injector(boss, /obj/item/reagent_containers/hypospray/medipen/stimpack), "The boss has no second stimulant left for its second wind")
	treat.finish_action(controller, TRUE, "human_npc_treat_item")
	TEST_ASSERT(!boss.boss_wants_stimulant(), "The boss wants a second stimulant before its second wind")

	// Worn out is its real stamina (over half its pool): it says so, shows the hunters, and falls back.
	boss.setStaminaLoss(0)
	boss.reagents.clear_reagents()
	boss.adjustStaminaLoss(70)
	TEST_ASSERT(boss.boss_is_worn_out(), "A boss at [boss.getStaminaLoss()] stamina loss isn't worn out")
	controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, hunter)
	var/datum/ai_planning_subtree/bounty_boss_worn_out/worn = new
	TEST_ASSERT_EQUAL(worn.SelectBehaviors(controller, 1), SUBTREE_RETURN_FINISH_PLANNING, "A worn-out boss didn't fall back")
	TEST_ASSERT(boss.boss_worn_out, "The boss didn't wear out")
	TEST_ASSERT_EQUAL(boss.body_last_alert, "worn out", "Wearing out showed [boss.body_last_alert || "nothing"] over the boss")
	TEST_ASSERT(boss.boss_fallback_until > world.time, "A worn-out boss has no fall back")
	TEST_ASSERT(!boss.boss_can_use_ability(), "A boss falling back can still start an ability")

	// The fall back over and still worn out: its second wind is due, the second pen with its "recover" line.
	boss.boss_fallback_until = world.time - 1
	worn.SelectBehaviors(controller, 1)
	TEST_ASSERT(boss.boss_second_wind_due, "The boss's second wind isn't due after its fall back")
	TEST_ASSERT(boss.boss_wants_stimulant(), "The boss doesn't want its second stimulant")
	controller.clear_blackboard_key("human_npc_treat_item")
	TEST_ASSERT_EQUAL(stimulant.SelectBehaviors(controller, 1), SUBTREE_RETURN_FINISH_PLANNING, "The boss didn't take its second wind")
	TEST_ASSERT_EQUAL(boss.boss_stimulants_used, 2, "The boss didn't count its second stimulant")
	TEST_ASSERT(!boss.boss_second_wind_due, "The second wind is still due after it was taken")

	// Its stamina back, it is no longer worn out.
	boss.setStaminaLoss(0)
	worn.SelectBehaviors(controller, 1)
	TEST_ASSERT(!boss.boss_worn_out, "A boss with its stamina back is still worn out")

	// Real health counts too: under 40% of a person's.
	boss.adjustBruteLoss(65)
	TEST_ASSERT(boss.boss_is_worn_out(), "A boss at [boss.health] health isn't worn out")

// ===== MECHS (H2) =====

/datum/unit_test/voidcrew_bounty_boss/mechs

/datum/unit_test/voidcrew_bounty_boss/mechs/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/mob/living/carbon/human/consistent/pilot = hunter_at(spot(1, 0))
	var/obj/vehicle/sealed/mecha/ripley/mech = mech_with(spot(1, 0), pilot)

	// A mech with a hunter in it is a target; the pilot is reached through it.
	TEST_ASSERT(boss.boss_valid_target(mech), "A hunter's mech isn't a target")
	TEST_ASSERT(!boss.boss_valid_target(pilot), "The boss goes for a pilot through the mech's hull")
	TEST_ASSERT(!boss.boss_effect_hits(pilot), "The boss's fire and blasts reach a pilot through the hull")
	TEST_ASSERT(boss.boss_effect_hits(mech), "The boss's fire and blasts skip a hunter's mech")
	TEST_ASSERT_EQUAL(boss.boss_target_for(pilot), mech, "The boss doesn't go for the pilot's mech")
	var/datum/targeting_strategy/strategy = GET_TARGETING_STRATEGY(/datum/targeting_strategy/basic/human_npc/bounty_boss)
	TEST_ASSERT(strategy.can_attack(boss, mech, 9), "The boss's targeting ignores a hunter's mech")

	// The mech's blows count as the pilot's: the pilot joins the posse, and the boss turns on the mech.
	TEST_ASSERT(boss.boss_note_attacker(mech), "The mech's attack wasn't noted")
	TEST_ASSERT(boss.body_has_grudge(pilot), "The pilot of a mech that hit it isn't on its grudge list")
	TEST_ASSERT(boss.boss_engaged[REF(pilot)], "The pilot of a mech that hit it didn't join its posse")
	TEST_ASSERT_EQUAL(boss.boss_revenge_target(), mech, "The boss doesn't turn on the mech that hit it")

	// Mech gunfire counts too.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/shot_at = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 3))
	var/obj/projectile/bullet/gunfire = new(get_turf(mech))
	gunfire.firer = mech
	SEND_SIGNAL(shot_at, COMSIG_PROJECTILE_PREHIT, gunfire)
	qdel(gunfire)
	TEST_ASSERT(shot_at.boss_engaged[REF(pilot)], "Mech gunfire didn't put the pilot in the posse")

	// The slam hits a mech next to it.
	var/integrity = mech.get_integrity()
	var/datum/action/cooldown/mob_cooldown/bounty_boss/slam/slam = ability_of(boss, /datum/action/cooldown/mob_cooldown/bounty_boss/slam)
	TEST_ASSERT(slam.worth_using(mech), "The slam isn't worth using on a mech beside it")
	TEST_ASSERT(slam.Trigger(target = mech), "The slam didn't start on a mech")
	TEST_ASSERT(slam.finish_windup(slam.pending_serial), "The slam on a mech didn't land")
	TEST_ASSERT(mech.get_integrity() < integrity, "The slam didn't hurt the mech")

	// The charge slams into a mech instead of bouncing off it.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/charger = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 2))
	mech.forceMove(spot(3, 2))
	integrity = mech.get_integrity()
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/charge = ability_of(charger, /datum/action/cooldown/mob_cooldown/bounty_boss/charge)
	TEST_ASSERT(charge.worth_using(mech), "The Juggernaut won't charge a mech")
	TEST_ASSERT(charge.Trigger(target = mech), "The charge at a mech didn't start")
	TEST_ASSERT(charge.finish_windup(charge.pending_serial), "The charge at a mech didn't go")
	var/serial = charger.boss_busy_serial
	for(var/i in 1 to 8)
		if(charger.boss_busy != "charge")
			break
		charge.charge_step(serial)
	TEST_ASSERT(mech.get_integrity() < integrity, "The charge didn't hurt the mech")
	TEST_ASSERT(!charger.IsKnockdown(), "The charge bounced off a mech")

// ===== THE JUGGERNAUT'S CHARGE (M1, CB-6) =====

/datum/unit_test/voidcrew_bounty_boss/charge

/datum/unit_test/voidcrew_bounty_boss/charge/Run()
	// Through a table.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/boss = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 0))
	var/obj/structure/table/table = allocate(/obj/structure/table, spot(1, 0))
	var/mob/living/carbon/human/consistent/victim = hunter_at(spot(3, 0))
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/charge = ability_of(boss, /datum/action/cooldown/mob_cooldown/bounty_boss/charge)
	TEST_ASSERT(charge.worth_using(victim), "The Juggernaut won't charge someone three tiles off")
	TEST_ASSERT(charge.Trigger(target = victim), "The charge didn't start")
	TEST_ASSERT(length(charge.path) >= 3, "The charge's telegraph line is too short")
	TEST_ASSERT_EQUAL(victim.getBruteLoss(), 0, "The charge hit before its wind-up was over")
	TEST_ASSERT(charge.finish_windup(charge.pending_serial), "The charge didn't go when its wind-up ended")
	// Its first step runs at once; the rest are timed, so step it by hand.
	var/serial = boss.boss_busy_serial
	for(var/i in 1 to 8)
		if(boss.boss_busy != "charge")
			break
		charge.charge_step(serial)
	TEST_ASSERT(QDELETED(table), "The charge didn't smash the table in its way")
	TEST_ASSERT(victim.getBruteLoss() > 0, "The charge didn't hit its target")
	TEST_ASSERT(victim.IsKnockdown(), "The charge didn't knock its target down")
	TEST_ASSERT_NULL(boss.boss_busy, "The boss is still charging")
	TEST_ASSERT_EQUAL(get_dist(boss, victim), 1, "The charge didn't end at its target")

	// Through a plain window and its grille, without bouncing.
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/second = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 3))
	var/obj/structure/grille/grille = allocate(/obj/structure/grille, spot(1, 3))
	var/obj/structure/window/fulltile/pane = allocate(/obj/structure/window/fulltile, spot(1, 3))
	var/mob/living/carbon/human/consistent/behind = hunter_at(spot(3, 3))
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/window_charge = ability_of(second, /datum/action/cooldown/mob_cooldown/bounty_boss/charge)
	TEST_ASSERT(window_charge.Trigger(target = behind), "The charge through a window didn't start")
	TEST_ASSERT(window_charge.finish_windup(window_charge.pending_serial), "The charge through a window didn't go")
	serial = second.boss_busy_serial
	for(var/i in 1 to 8)
		if(second.boss_busy != "charge")
			break
		window_charge.charge_step(serial)
	TEST_ASSERT(QDELETED(pane), "The charge didn't smash the plain window")
	TEST_ASSERT(QDELETED(grille), "The charge didn't smash the grille under the window")
	TEST_ASSERT(!second.IsKnockdown(), "The charge bounced off a plain window")
	TEST_ASSERT(behind.getBruteLoss() > 0, "The charge through a window didn't reach its target")

	// Into a reinforced wall: it hurts, and it puts the Juggernaut down where it can be cuffed (CB-6).
	var/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut/wall_runner = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/juggernaut, spot(0, 1))
	var/mob/living/carbon/human/consistent/beyond = hunter_at(spot(4, 1))
	change_turf(spot(2, 1), /turf/closed/wall/r_wall)
	var/datum/action/cooldown/mob_cooldown/bounty_boss/charge/wall_charge = ability_of(wall_runner, /datum/action/cooldown/mob_cooldown/bounty_boss/charge)
	TEST_ASSERT(wall_charge.Trigger(target = beyond), "The charge at the wall didn't start")
	TEST_ASSERT(wall_charge.finish_windup(wall_charge.pending_serial), "The charge at the wall didn't go")
	serial = wall_runner.boss_busy_serial
	for(var/i in 1 to 8)
		if(wall_runner.boss_busy != "charge")
			break
		wall_charge.charge_step(serial)
	TEST_ASSERT(isclosedturf(spot(2, 1)), "The charge broke a reinforced wall")
	TEST_ASSERT(wall_runner.getBruteLoss() > 0, "Running into the wall didn't hurt the Juggernaut")
	TEST_ASSERT(wall_runner.IsKnockdown(), "Running into the wall didn't knock the Juggernaut down")
	TEST_ASSERT(!wall_runner.body_can_answer_cuffs(), "A Juggernaut dazed by a wall could still fight off the cuffs")
	TEST_ASSERT(!wall_runner.boss_can_act(), "A Juggernaut dazed by a wall can still act")
	TEST_ASSERT(abs(wall_runner.physiology.brute_mod - 0.6) < 0.01, "Running into the wall changed how much damage it takes")

// ===== THE HEAVY'S GUN: REAL ROUNDS, REAL BELTS, A FUMBLE (CB-13) =====

/datum/unit_test/voidcrew_bounty_boss/heavy

/datum/unit_test/voidcrew_bounty_boss/heavy/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/heavy/heavy = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/heavy, spot(0, 0))
	var/mob/living/carbon/human/consistent/target = hunter_at(spot(4, 0))
	var/obj/item/gun/ballistic/automatic/l6_saw/gun = heavy.boss_gun()
	TEST_ASSERT_NOTNULL(gun, "The Heavy holds no gun")
	var/datum/action/cooldown/mob_cooldown/bounty_boss/burst/burst = ability_of(heavy, /datum/action/cooldown/mob_cooldown/bounty_boss/burst)
	TEST_ASSERT(burst.worth_using(target), "The Heavy won't open up on someone four tiles off")

	// A hit while it aims spoils the burst.
	TEST_ASSERT(burst.Trigger(target = target), "The burst didn't start")
	var/serial = burst.pending_serial
	heavy.apply_damage(20, BRUTE)
	TEST_ASSERT_NULL(heavy.boss_busy, "A hit didn't spoil the Heavy's aim")
	TEST_ASSERT(!burst.finish_windup(serial), "A spoiled burst still fired")

	// Aimed in peace, it pulls the real gun's trigger: a real round leaves its belt.
	ready(heavy)
	ready_hands(heavy)
	var/rounds = gun.get_ammo()
	TEST_ASSERT(burst.Trigger(target = target), "The burst didn't start again")
	TEST_ASSERT(burst.finish_windup(burst.pending_serial), "The burst didn't fire when its wind-up ended")
	TEST_ASSERT(gun.get_ammo() < rounds, "The burst fired no round from the Heavy's gun")
	burst.end_burst(heavy.boss_busy_serial)

	// Its belt run dry, it changes it from its bag the way a player does.
	QDEL_NULL(gun.chambered)
	gun.magazine.stored_ammo.Cut()
	gun.update_appearance()
	TEST_ASSERT(!gun.can_shoot(), "Test fixture: the Heavy's gun still fires")
	var/datum/ai_controller/controller = heavy.ai_controller
	heavy.boss_hostile = TRUE
	TEST_ASSERT(heavy.boss_gear_plan(controller), "The Heavy didn't plan to change its belt")
	var/datum/ai_behavior/bounty_heavy_reload/reload = GET_AI_BEHAVIOR(/datum/ai_behavior/bounty_heavy_reload)
	reload.setup(controller)
	var/finished = FALSE
	for(var/step in 1 to 12)
		ready_hands(heavy)
		var/result = reload.perform(1, controller)
		TEST_ASSERT(!(result & AI_BEHAVIOR_FAILED), "Changing the belt failed at step [step]")
		if(result & AI_BEHAVIOR_SUCCEEDED)
			finished = TRUE
			break
	TEST_ASSERT(finished, "The Heavy never finished changing its belt")
	TEST_ASSERT(gun.can_shoot(), "The Heavy's gun doesn't fire after a belt change")
	TEST_ASSERT(!gun.cover_open, "The Heavy left its gun's cover open")
	TEST_ASSERT(gun.magazine?.ammo_count() > 0, "The new belt is empty")
	TEST_ASSERT_EQUAL(carried(heavy, /obj/item/ammo_box/magazine/m7mm) - (gun.magazine ? 1 : 0), 0, "The spare box wasn't the one that went in")

	// Barricade: a real barrier grenade, armed and thrown in front of it (CB-26).
	var/datum/action/cooldown/mob_cooldown/bounty_boss/barricade/barricade = ability_of(heavy, /datum/action/cooldown/mob_cooldown/bounty_boss/barricade)
	ready(heavy)
	ready_hands(heavy)
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_barricades), 0, "Barricades were standing before the test")
	TEST_ASSERT(barricade.worth_using(target), "The Heavy won't put up a barricade")
	TEST_ASSERT(barricade.Trigger(target = target), "The barricade didn't start")
	TEST_ASSERT(barricade.finish_windup(barricade.pending_serial), "The barricade wasn't thrown")
	TEST_ASSERT_EQUAL(carried(heavy, /obj/item/grenade/barrier/bounty_boss), 1, "The Heavy didn't throw one of its barrier grenades")
	var/obj/item/grenade/barrier/bounty_boss/thrown
	for(var/obj/item/grenade/barrier/bounty_boss/loose in range(2, heavy))
		if(!heavy.is_holding(loose))
			thrown = loose
	TEST_ASSERT_NOTNULL(thrown, "The thrown barrier grenade is nowhere near the Heavy")
	TEST_ASSERT(thrown.active, "The Heavy threw its barrier grenade without pulling the pin")
	thrown.forceMove(spot(1, 0))
	thrown.detonate()
	var/obj/structure/barricade/security/bounty_boss/barrier = locate() in spot(1, 0)
	TEST_ASSERT_NOTNULL(barrier, "The barrier grenade made no barrier")
	TEST_ASSERT(barrier in GLOB.bounty_boss_barricades, "The barricade isn't counted")
	TEST_ASSERT_EQUAL(length(barricade.barriers), 1, "The Heavy doesn't count the barrier it threw")
	barrier.fold_away()
	TEST_ASSERT(QDELETED(barrier), "The barricade didn't fold away")
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_barricades), 0, "A folded barricade is still counted")

	// The barricade cap.
	var/list/made = list()
	for(var/i in 1 to 9)
		made += new /obj/structure/barricade/security/bounty_boss(spot(i % 5, 4))
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_barricades), 8, "The barricade cap didn't hold") // BOUNTY_BOSS_BARRICADE_CAP
	for(var/obj/structure/barricade/security/bounty_boss/extra as anything in made)
		if(!QDELETED(extra))
			qdel(extra)
	TEST_ASSERT_EQUAL(length(GLOB.bounty_boss_barricades), 0, "Deleted barricades are still counted")

	// Barricades a boss keeps: a new one folds up its oldest.
	var/list/mine = list()
	for(var/i in 1 to 3)
		var/obj/structure/barricade/security/bounty_boss/one = new(spot(i, 3))
		mine += one
		barricade.barriers += WEAKREF(one)
	barricade.prune_barriers()
	TEST_ASSERT(QDELETED(mine[1]), "The Heavy's oldest barricade stayed past its limit") // BOUNTY_BOSS_BARRICADES_PER_BOSS
	TEST_ASSERT_EQUAL(length(barricade.barriers), 2, "The Heavy keeps the wrong number of barricades")
	for(var/obj/structure/barricade/security/bounty_boss/kept as anything in mine)
		if(!QDELETED(kept))
			qdel(kept)

// ===== THE GHOST: A REAL KNIFE, REAL CHROME, A SHIMMER THAT IS ONLY A LOOK (CB-9, CB-12) =====

/datum/unit_test/voidcrew_bounty_boss/ghost

/datum/unit_test/voidcrew_bounty_boss/ghost/Run()
	var/mob/living/carbon/human/npc/bounty_criminal/boss/ghost/ghost = allocate(/mob/living/carbon/human/npc/bounty_criminal/boss/ghost, spot(0, 0))
	TEST_ASSERT(ghost.boss_cloak(), "The Ghost didn't cloak")
	TEST_ASSERT(ghost.alpha < 255 || ghost.get_filter("bounty_ghost_shimmer"), "The Ghost's shimmer doesn't show")
	ghost.apply_damage(5, BRUTE)
	TEST_ASSERT(!ghost.boss_cloaked, "A hit didn't break the Ghost's shimmer")
	TEST_ASSERT(ghost.boss_cloak(), "The Ghost didn't cloak again")
	SEND_SIGNAL(ghost, COMSIG_MOB_FLASHED)
	TEST_ASSERT(!ghost.boss_cloaked, "A flash didn't break the Ghost's shimmer")

	// Its dash ends in a real knife attack, the knife's own damage, wounds and bleeding (CB-9).
	var/mob/living/carbon/human/consistent/victim = hunter_at(spot(1, 0))
	var/datum/action/cooldown/mob_cooldown/bounty_boss/dash/dash = ability_of(ghost, /datum/action/cooldown/mob_cooldown/bounty_boss/dash)
	TEST_ASSERT(!dash.cut_at_end(victim), "The Ghost cut with a knife it hadn't drawn")
	var/obj/item/knife/combat/knife = locate() in ghost.get_all_contents_type(/obj/item/knife/combat)
	TEST_ASSERT(human_npc_take_in_hand(ghost, knife), "The Ghost couldn't draw its knife")
	ready_hands(ghost)
	TEST_ASSERT(dash.cut_at_end(victim), "The Ghost's dash didn't end in a cut")
	TEST_ASSERT(victim.getBruteLoss() > 0, "The Ghost's knife didn't hurt the hunter")
	TEST_ASSERT_EQUAL(ghost.boss_cuts, 1, "The Ghost's cut wasn't a blow from its knife")

	// A couple of cuts and it breaks off (BOUNTY_GHOST_CUTS_BEFORE_BREAKOFF).
	ready_hands(ghost)
	TEST_ASSERT(dash.cut_at_end(victim), "The Ghost's second cut didn't land")
	TEST_ASSERT(ghost.boss_breakoff_until > world.time, "The Ghost didn't break off after two cuts")

	// The cut at the end of a dash lands on whoever it dashed at, down or not (CB-11).
	TEST_ASSERT(put_in_crit(victim), "Test fixture: the hunter isn't down")
	var/before = victim.getBruteLoss()
	ready_hands(ghost)
	TEST_ASSERT(dash.cut_at_end(victim), "The Ghost's cut skipped a downed hunter")
	TEST_ASSERT(victim.getBruteLoss() > before, "The Ghost's knife didn't hurt a downed hunter")

	// The dash fires its Cascade lattice: real chrome, with its own window and crash.
	TEST_ASSERT(ghost.boss_surge(), "The Ghost's Cascade lattice didn't fire")
	TEST_ASSERT(ghost.has_status_effect(/datum/status_effect/cyberware_cascade_window), "The Cascade window didn't open")
	TEST_ASSERT(!ghost.boss_surge(), "The Cascade lattice fired twice in one cycle")
